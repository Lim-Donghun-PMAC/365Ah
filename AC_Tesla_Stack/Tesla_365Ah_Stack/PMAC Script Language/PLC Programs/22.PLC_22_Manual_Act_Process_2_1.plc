//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.09 김성중 선임
// MSA 모듈화 프로그래밍 진행 - [ 참조 : 25.07.09 MSA 프로그램 신규 추가 ] 
// 25.07.28 김성중 선임 
// Cal, Cleaning 위치 이동, Align 탈착 모드 프로그래밍 진행 - [ 참조 : 25.07.28 Cal 프로그램 및 얼라인 탈착 모드 신규 추가 ] 

open plc 22

#define	L_System_Timer				Sys.Time			// 시스템 타이머

Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[22].ldata.L[0] 시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[22].ldata.L[1] 시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[22].ldata.L[2] 시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[22].ldata.L[3] 타이머 초기화 플래그

local L_PLC22_Sub_MSA_Program_Active;					// Plc[22].ldata.L[4] Sub 프로그램 Active 변수
local L_VISION_MSA_Seq_Command_Occurs;					// Plc[22].ldata.L[5] 시퀀스 커맨드 발생 변수 
local L_VISION_MSA_Seq_Data;							// Plc[22].ldata.L[6] MSA Seq Data 리턴 변수
local L_VISION_MSA_InterLock_Reentry;					// Plc[22].ldata.L[7] 재진입 방지 변수 추가

local L_Align_Take_Off_InterLock_Reentry;				// Plc[22].ldata.L[8] 재진입 방지 변수 추가
local L_Align_Take_Off_Seq_Command_Occurs;				// Plc[22].ldata.L[9] 시퀀스 커맨드 발생 변수 
local L_Align_Take_Off_Seq_Data;						// Plc[22].ldata.L[10] MSA Seq Data 리턴 변수

// Local Timer
local L_VISION_Interlock_Check_Timer ;					// Plc[22].ldata.L[11] 인터락 체크 타이머
local L_PLC22_Sub_Align_Take_Off_Program_Active;		// Plc[22].ldata.L[12] 얼라인 탈착 모드 프로그램 할성화
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
	
// 00.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	L_VISION_Interlock_Check_Timer = L_VISION_Interlock_Check_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//-----------------------------------------------------------------------------------------------------------------
if( P_PMAC_Current_Mode == F_Current_Manual && P_PMAC_Status == F_Status_IDLE && P_Anode_Count == 0 && P_Cathode_Count == 0 )	// IDLE 상황에서만 가능
{
	L_PLC22_Sub_MSA_Program_Active = F_Status_STARTING;																// Start 
}
else																											//아닐 경우
{
	L_PLC22_Sub_MSA_Program_Active = F_Status_STOPPING;																//Stop
}
//=======================================================================================================================================================
// 1. 얼라인 MSA 버튼 커맨드 
//=======================================================================================================================================================
if( L_PLC22_Sub_MSA_Program_Active == F_Status_STARTING )
{ //	↓ 인덱스 및 상태는 리셋팅구간에서 초기화를 하기 때문에, 한번 MSA 끝나고 바로 시작 안되게 설계
	if( N_VISION_MSA_Command_Enable_Possible == N_TRUE )	// 이중 커맨드 방지  ( 인덱스 | 상태 ) 
	{
		if( P_VISION_MSA_Anode_Align_Cmd == F_Command_Start )									// 음극 얼라인 MSA 커맨드 
		{
			P_VISION_MSA_Anode_Align_Cmd = F_Command_NonCommand;								// 커맨드 초기화
			L_VISION_Interlock_Check_Timer = 0;													// 사전 인터락 체크 타이머
			P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = F_Status_STARTING;			// MSA 상태 스타팅			
			P_VISION_MSA_MODE = N_MSA_Anode_Align;												// Anode Align MSA Mode
			P_VISION_MSA_pre_InterLock_Cmd = F_Command_Start;									// MSA 인터락 커맨드
		}
		if( P_VISION_MSA_Cathode_Align_Cmd == F_Command_Start )									// 양극 얼라인 MSA 커맨드
		{
			P_VISION_MSA_Cathode_Align_Cmd = F_Command_NonCommand;								// 커맨드 초기화
			L_VISION_Interlock_Check_Timer = 0;													// 사전 인터락 체크 타이머
			P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = F_Status_STARTING;			// MSA 상태 스타팅			
			P_VISION_MSA_MODE = N_MSA_Cathode_Align;											// Cathode Align MSA Mode
			P_VISION_MSA_pre_InterLock_Cmd = F_Command_Start;									// MSA 인터락 커맨드
		}
		
		if( P_VISION_MSA_Anode_Stack_Cmd == F_Command_Start )									// 음극 스텍 MSA 커맨드
		{
			P_VISION_MSA_Anode_Stack_Cmd = F_Command_NonCommand;								// 커맨드 초기화
			L_VISION_Interlock_Check_Timer = 0;													// 사전 인터락 체크 타이머
			P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = F_Status_STARTING;			// MSA 상태 스타팅			
			P_VISION_MSA_MODE = N_MSA_Anode_Stack;												// Anode Stack MSA Mode
			P_VISION_MSA_pre_InterLock_Cmd = F_Command_Start;									// MSA 인터락 커맨드
		}
		if( P_VISION_MSA_Cathode_Stack_Cmd == F_Command_Start )									// 양극 스텍 MSA 커맨드
		{
			P_VISION_MSA_Cathode_Stack_Cmd = F_Command_NonCommand;								// 커맨드 초기화
			L_VISION_Interlock_Check_Timer = 0;													// 사전 인터락 체크 타이머
			P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = F_Status_STARTING;			// MSA 상태 스타팅			
			P_VISION_MSA_MODE = N_MSA_Cathode_Stack;											// Cathode Stack MSA Mode
			P_VISION_MSA_pre_InterLock_Cmd = F_Command_Start;									// MSA 인터락 커맨드
		}
		L_VISION_MSA_InterLock_Reentry = 0;	
	}
	else 
	{
		P_VISION_MSA_Anode_Align_Cmd = 0;														// 커맨드 초기화 ( 이중 커맨드 방지 )
		P_VISION_MSA_Cathode_Align_Cmd = 0;														// 커맨드 초기화 ( 이중 커맨드 방지 )
		P_VISION_MSA_Anode_Stack_Cmd = 0;														// 커맨드 초기화 ( 이중 커맨드 방지 )
		P_VISION_MSA_Cathode_Stack_Cmd = 0;														// 커맨드 초기화 ( 이중 커맨드 방지 )
	}
}
else 
{
	P_VISION_MSA_Anode_Align_Cmd = 0;															// 커맨드 초기화 ( 이중 커맨드 방지 )
	P_VISION_MSA_Cathode_Align_Cmd = 0;															// 커맨드 초기화 ( 이중 커맨드 방지 )
	P_VISION_MSA_Anode_Stack_Cmd = 0;															// 커맨드 초기화 ( 이중 커맨드 방지 )
	P_VISION_MSA_Cathode_Stack_Cmd = 0;															// 커맨드 초기화 ( 이중 커맨드 방지 )
}
//=======================================================================================================================================================
// 2. 비전 반자동 오토 캘 버튼 커맨드 
//=======================================================================================================================================================
if( P_PMAC_Current_Mode == F_Current_Manual )	// 메뉴얼 상황에서만 가능
{
	L_PLC22_Sub_Align_Take_Off_Program_Active = F_Status_STARTING;												// Start 
}
else																											//아닐 경우
{
	L_PLC22_Sub_Align_Take_Off_Program_Active = F_Status_STOPPING;												//Stop
}
//-----------------------------------------------------------------------------------------------------------------
if ( L_PLC22_Sub_Align_Take_Off_Program_Active == F_Status_STARTING)
{
	if( N_Align_Take_Off_Command_Enable_Possible == N_TRUE ) 
	{	
		if ( P_Anode_Align_Take_OFF_Cmd == F_Command_Start)					// Cal 위치
		{
			P_Anode_Align_Take_OFF_Cmd = F_Command_NonCommand;
			L_VISION_Interlock_Check_Timer = 0;		
			P_Align_Take_Off_Status_Prod_Sequence(N_PLC21_Align_Take_Off) = F_Status_STARTING;		// 비전 캘 상태 스타팅	
			P_Align_Take_Off_Mode = N_Align_AN_Take_Off											// 음극 얼라인 탈착 모드 
			P_Align_Take_Off_pre_InterLock_Cmd = F_Command_Start;									// 인터락 커맨드
		}
		if ( P_Cathode_Align_Take_OFF_Cmd == F_Command_Start )				// 초기화 위치
		{
			P_Cathode_Align_Take_OFF_Cmd = F_Command_NonCommand;
			L_VISION_Interlock_Check_Timer = 0;	
			P_Align_Take_Off_Status_Prod_Sequence(N_PLC21_Align_Take_Off) = F_Status_STARTING;		// 비전 캘 상태 스타팅
			P_Align_Take_Off_Mode = N_Align_CA_Take_Off										// 양극 얼라인 탈착 모드 
			P_Align_Take_Off_pre_InterLock_Cmd = F_Command_Start;									// 인터락 커맨드
		}
		L_Align_Take_Off_InterLock_Reentry = 0	
	}
	else
	{
		P_Anode_Align_Take_OFF_Cmd = 0;																// 커맨드 초기화 ( 이중 커맨드 방지 )
		P_Cathode_Align_Take_OFF_Cmd = 0;															// 커맨드 초기화 ( 이중 커맨드 방지 )		
	}
}
else																								// 가능한 상태가 아닐때 커맨드가 저장되어있다면, 초기화 
{
	P_Anode_Align_Take_OFF_Cmd = 0;																	// 커맨드 초기화 ( 이중 커맨드 방지 )
	P_Cathode_Align_Take_OFF_Cmd = 0;																		// 커맨드 초기화 ( 이중 커맨드 방지 )	
}
//========================================================================================================================================================
// 1) MSA - InterLock Check 
//========================================================================================================================================================
// 1. 반댓열 사전 인터락 상태 확인 
if( L_VISION_Interlock_Check_Timer > 100 )																	// 인터락 결과 대기 시간
{
	if( P_Vision_MSA_Interlock_Status == F_Status_COMPLETE && L_VISION_MSA_InterLock_Reentry == 0 )			// 인터락 조건 이상 없음을 확인 하였다면,
	{
		P_VISION_MSA_Status_Flag = 1;																		// 구동 시퀀스 Flag ON
		L_VISION_MSA_Seq_Command_Occurs = 1;																// 시퀀스 커맨드 발생 변수 ON
		L_VISION_MSA_InterLock_Reentry = 1;																	// 재진입 방지 변수 
	}
	else if( P_Vision_MSA_Interlock_Status == F_Status_ABORTED && L_VISION_MSA_InterLock_Reentry == 0 )		// 사전 인터락이 감지 된다면
	{
		P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = 0;											// MSA 모듈 상태 초기화
		P_VISION_MSA_MODE = 0;																				// MSA 모드 초기화
	}
}

//========================================================================================================================================================
// 2) MSA -  READY COMMAND
//========================================================================================================================================================
if( P_VISION_MSA_Status_Flag == 1 )																				// 구동 시퀀스 Flag On 되었다면,
{
	if( L_VISION_MSA_Seq_Command_Occurs == 1 )
	{
		// MSA 인덱스 초기화
		P_VISION_MSA_Seq_Index = 0;
		P_Except_Return_Array(N_PLC21_MSA_Set_Seq_Occurs_RTN) = 0;												// 리턴변수 초기화					
		call Sub_Manual_Prod_Sequnce.Set_MSA(P_VISION_MSA_MODE,&P_Except_Return_Array(N_PLC21_MSA_Set_Seq_Occurs_RTN))		

		L_VISION_MSA_Seq_Command_Occurs = 0;																	// 시퀀스 커맨드 발생 변수 off 
		P_VISION_MSA_Align_Count_Chk_Flag = 0;																	// 재귀 플래그 초기화
		P_VISION_MSA_Stack_Count_Chk_Flag = 0;																	// 재귀 플래그 초기화	
		P_VISION_MSA_State_Machine = N_Ready_Step;																// 준비 스텝으로 이동	
	}

//========================================================================================================================================================
// 3) MSA - READY STEP
//========================================================================================================================================================
if( P_VISION_MSA_State_Machine == N_Ready_Step )																// Ready 스텝
{
	P_VISION_MSA_Status = F_Status_EXECUTE;																		// 상태 업데이트
	
	P_VISION_MSA_Seq_Index = P_VISION_MSA_Seq_Index + 1;														// 인덱스 증가

	// 재귀 플래그 감지 
	if( P_VISION_MSA_Align_Count_Chk_Flag == 1 )																// 재귀해야하는 플래그가 켜진다면
	{
		P_VISION_MSA_Align_Count_Chk_Flag = 0;																	// 플래그 초기화
		P_VISION_MSA_Seq_Index = N_SEQ_Normal_MSA_No_9;															// 재귀 인덱스로 변환 ( 1차 PNP 얼라인 이동) 
	}
	
	if( P_VISION_MSA_Stack_Count_Chk_Flag == 1 )																// 재귀해야하는 플래그가 켜진다면
	{
		P_VISION_MSA_Stack_Count_Chk_Flag = 0;																	// 플래그 초기화
		P_VISION_MSA_Seq_Index = N_SEQ_Normal_MSA_No_6;															// 재귀 인덱스로 변환 ( 2차 PNP 스텍 이동) 
	}
	
	P_Except_Return_Array(N_PLC21_MSA_Manage_Get_RTN) = 0;														// MSA 인덱스 관리 리턴변수 초기화
	call Sub_Manual_Prod_Sequnce.Management_MSA(P_VISION_MSA_MODE,P_VISION_MSA_Seq_Index,&L_VISION_MSA_Seq_Data,&P_Except_Return_Array(N_PLC21_MSA_Manage_Get_RTN))		
	
	IF ( P_Except_Return_Array(N_PLC21_MSA_Manage_Get_RTN) == N_TRUE )											// MSA 인덱스 관리 리턴변수 참 일때																											
	{
		P_Except_Return_Array(N_PLC21_VISION_MSA_Exe_Seq_RTN) = 0;												// MSA 실행함수 리턴변수 초기화
		call Sub_Manual_Prod_Sequnce.Execute_MSA(P_VISION_MSA_MODE, L_VISION_MSA_Seq_Data,&P_Except_Return_Array(N_PLC21_VISION_MSA_Exe_Seq_RTN) );
														
		IF ( P_Except_Return_Array(N_PLC21_VISION_MSA_Exe_Seq_RTN) == N_TRUE )									// 리턴변수 참 일때,																			
			P_VISION_MSA_State_Machine = N_Execute_Step;														// 전제조건 감시 스텝으로 이동																			
			
		ELSE																																		
			P_VISION_MSA_State_Machine = N_Error_Step;															// 에러 스텝으로 이동
	}
	ELSE IF ( P_Except_Return_Array(N_PLC21_MSA_Manage_Get_RTN) == N_EXCEPT )									// MSA 인덱스 관리 리턴변수 제외 값일때,															
	{
		P_VISION_MSA_State_Machine = N_Complete_Step;															// 완료 스텝으로 이동																		
	}																																																			  
	ELSE																																			
	{
		P_VISION_MSA_State_Machine = N_Error_Step;																							
	}		
}
//=======================================================================================================================================================
// 4) MSA - EXECUTE STEP
//=======================================================================================================================================================
	// 2.1.3. MSA모듈 시퀀스 _ 동작 실행중 스텝
	IF ( P_VISION_MSA_State_Machine == N_Execute_Step )															// 익스큐트 스텝으로 왔다면,																	
	{							
		P_VISION_MSA_Seq_PreCondition_Index = P_VISION_MSA_Seq_Index + 1;										// 전제조건 인덱스 대입

		P_Except_Return_Array(N_PLC21_VISION_MSA_Pre_Seq_Complete_RTN) = 0;										// 함수 리턴 변수 초기화		
		Call Sub_Manual_Prod_Sequnce.Precondition_MSA(P_VISION_MSA_MODE,P_VISION_MSA_Seq_PreCondition_Index,&P_Except_Return_Array(N_PLC21_VISION_MSA_Pre_Seq_Complete_RTN))
		
		IF ( P_Except_Return_Array(N_PLC21_VISION_MSA_Pre_Seq_Complete_RTN) == N_TRUE )							// 참으로 결과가 리턴되었다면,
		{
			call Manual_Module_Motor_Active.MSA_Cycle_Stop_Point(P_VISION_MSA_MODE,&P_MSA_CycleStop_Point_Check_Complete_RTN)
			if( P_MSA_CycleStop_Point_Check_Complete_RTN == 1)
			{
				P_MSA_CycleStop_Point_Check_Complete_RTN = 0;
				IF ( P_PMAC_Status == F_Status_STOPPING && P_VISION_MSA_Seq_Stopping_Point(P_VISION_MSA_Seq_PreCondition_Index) == N_Cycle_Stop_OK )// MSA 진행 중 Stopping 진행 및 정지 가능 할 경우.
				{	
					P_VISION_MSA_State_Machine = N_Error_Step;														// 에러스텝 이동.()
				}
				ELSE
				{
					P_VISION_MSA_State_Machine = N_Ready_Step;	
				}
			}
		}		
	}
//=======================================================================================================================================================
// 5) MSA - Complte STEP
//=======================================================================================================================================================
	// 2.1.4 배출모듈 시퀀스 _ 동작 완료 스텝
	IF ( P_VISION_MSA_State_Machine == N_Complete_Step )
	{
		P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = F_Status_COMPLETE;								// MSA모듈 상태 변경 _ 완료
		//P_Suspend_Discharge_Module_Status = F_Status_COMPLETE;												// 배출 진행 상태 업데이트.
		P_VISION_MSA_Status = F_Status_COMPLETE;				
		P_Anode_Count = 0;																						// Slave Cmd 사용하여 Cnt 증가로 인한 초기화 진행
		P_Cathode_Count = 0;																					// Slave Cmd 사용하여 Cnt 증가로 인한 초기화 진행
		
		#ifdef F_Def_Stack_A												
		P_Modbus_A_VISION_MSA_Status = F_Status_COMPLETE;														// MSA 완료를 알림
		#endif 
		#ifdef F_Def_Stack_B											
		P_Modbus_B_VISION_MSA_Status = F_Status_COMPLETE;														// MSA 완료를 알림
		#endif 
		P_VISION_MSA_Status_Flag = 0;																			// MSA FLAG RESET
		P_VISION_MSA_State_Machine = 0;																			// 스텝 초기화
	}

//=======================================================================================================================================================
// 6) MSA - Error STEP
//=======================================================================================================================================================
	// 2.1.5 모듈 시퀀스 _ 에러 처리 스텝
	IF ( P_VISION_MSA_State_Machine == N_Error_Step )															// 에러스텝이라면 
	{
		P_VISION_MSA_Status_Prod_Sequence(N_PLC21_VISION_MSA) = F_Status_ABORTED;								// 배출모듈 상태 변경 _ 어볼트
	
		P_VISION_MSA_Status = F_Status_Error;																	// 에러 상태 대입											
		P_VISION_MSA_Status_Flag = 0;																			// MSA FLAG RESET
		P_Anode_Count = 0;																						// Slave Cmd 사용하여 Cnt 증가로 인한 초기화 진행
		P_Cathode_Count = 0;																					// Slave Cmd 사용하여 Cnt 증가로 인한 초기화 진행
		#ifdef F_Def_Stack_A												
		P_Modbus_A_VISION_MSA_Status = F_Status_ABORTED;														
		#endif 
		#ifdef F_Def_Stack_B											
		P_Modbus_B_VISION_MSA_Status = F_Status_ABORTED;
		#endif 
		P_VISION_MSA_State_Machine = 0;																			// 스텝 초기화.		
	}
}
ELSE
{
	P_VISION_MSA_State_Machine = 0;																				// 시퀀스 초기화
}

//========================================================================================================================================================
// 1) 얼라인 탈착 모드 - InterLock Check 
//========================================================================================================================================================
// 1. 반댓열 사전 인터락 상태 확인 
if( L_VISION_Interlock_Check_Timer > 100 )																		// 인터락 결과 대기 시간
{
	if( P_Align_Take_Off_Interlock_Status == F_Status_COMPLETE && L_Align_Take_Off_InterLock_Reentry == 0 )		// 인터락 조건 이상 없음을 확인 하였다면,
	{
		P_Align_Take_Off_Status_Flag = 1;																		// 구동 시퀀스 Flag ON
		L_Align_Take_Off_Seq_Command_Occurs = 1;																// 시퀀스 커맨드 발생 변수 ON
		L_Align_Take_Off_InterLock_Reentry = 1;																	// 재진입 방지 변수 
	}
	else if( P_Vision_MSA_Interlock_Status == F_Status_ABORTED && L_Align_Take_Off_InterLock_Reentry == 0 )		// 사전 인터락이 감지 된다면
	{
		P_Align_Take_Off_Status_Prod_Sequence(N_PLC21_Align_Take_Off) = 0;										// 얼라인 탈착 모듈 상태 초기화
		P_Align_Take_Off_Mode = 0;																				// 얼라인 탈착 모드 초기화
	}
}
//========================================================================================================================================================
// 2) 얼라인 탈착 모드 -  READY COMMAND
//========================================================================================================================================================
if( P_Align_Take_Off_Status_Flag == 1 )																			// 구동 시퀀스 Flag On 되었다면,
{
	if( L_Align_Take_Off_Seq_Command_Occurs == 1 )
	{
		// MSA 인덱스 초기화
		P_Align_Take_Off_Seq_Index = 0;
		P_Except_Return_Array(N_PLC21_Align_Take_Off_Set_Seq_Occurs_RTN) = 0;									// 리턴변수 초기화					
		call Sub_Manual_Prod_Sequnce.Set_Align_Take_off(P_Align_Take_Off_Mode,&P_Except_Return_Array(N_PLC21_Align_Take_Off_Set_Seq_Occurs_RTN))		

		L_Align_Take_Off_Seq_Command_Occurs = 0;																// 시퀀스 커맨드 발생 변수 off 
		P_Align_Take_Off_State_Machine = N_Ready_Step;															// 준비 스텝으로 이동	
	}

//========================================================================================================================================================
// 3) 얼라인 탈착 모드 - READY STEP
//========================================================================================================================================================
if( P_Align_Take_Off_State_Machine == N_Ready_Step )																// Ready 스텝
{
	P_Align_Take_Off_Status = F_Status_EXECUTE;																		// 상태 업데이트
	
	P_Align_Take_Off_Seq_Index = P_Align_Take_Off_Seq_Index + 1;													// 인덱스 증가
	
	P_Except_Return_Array(N_PLC21_Align_Take_Off_Manage_Get_RTN) = 0;												// 얼라인 탈착 인덱스 관리 리턴변수 초기화
	call Sub_Manual_Prod_Sequnce.Management_Align_Take_Off(P_Align_Take_Off_Mode,P_Align_Take_Off_Seq_Index,&L_Align_Take_Off_Seq_Data,&P_Except_Return_Array(N_PLC21_Align_Take_Off_Manage_Get_RTN))		
	
	IF ( P_Except_Return_Array(N_PLC21_Align_Take_Off_Manage_Get_RTN) == N_TRUE )									// 얼라인 탈착 인덱스 관리 리턴변수 참 일때																											
	{
		P_Except_Return_Array(N_PLC21_Align_Take_Off_Exe_Seq_RTN) = 0;												// 얼라인 탈착 실행함수 리턴변수 초기화
		call Sub_Manual_Prod_Sequnce.Execute_Align_Take_Off(P_Align_Take_Off_Mode,L_Align_Take_Off_Seq_Data,&P_Except_Return_Array(N_PLC21_Align_Take_Off_Exe_Seq_RTN) );
														
		IF ( P_Except_Return_Array(N_PLC21_Align_Take_Off_Exe_Seq_RTN) == N_TRUE )									// 리턴변수 참 일때,	
		{																		
			P_Align_Take_Off_State_Machine = N_Execute_Step;														// 전제조건 감시 스텝으로 이동																			
		}	
		ELSE					
		{																													
			P_Align_Take_Off_State_Machine = N_Error_Step;															// 에러 스텝으로 이동
		}
	}
	ELSE IF ( P_Except_Return_Array(N_PLC21_Align_Take_Off_Manage_Get_RTN) == N_EXCEPT )							// 얼라인 탈착 인덱스 관리 리턴변수 제외 값일때,															
	{
		P_Align_Take_Off_State_Machine = N_Complete_Step;															// 완료 스텝으로 이동																		
	}																																																			  
	ELSE																																			
	{
		P_Align_Take_Off_State_Machine = N_Error_Step;																							
	}		
}
//=======================================================================================================================================================
// 4) 얼라인 탈착 모드 - EXECUTE STEP
//=======================================================================================================================================================
	// 2.1.3. 얼라인 탈착 모드 시퀀스 _ 동작 실행중 스텝
	IF ( P_Align_Take_Off_State_Machine == N_Execute_Step )															// 익스큐트 스텝으로 왔다면,																	
	{							
		P_Align_Take_Off_Seq_PreCondition_Index = P_Align_Take_Off_Seq_Index + 1;									// 전제조건 인덱스 대입

		P_Except_Return_Array(N_PLC21_Align_Take_Off_Pre_Seq_Complete_RTN) = 0;										// 함수 리턴 변수 초기화		
		Call Sub_Manual_Prod_Sequnce.Precondition_Align_Take_Off(P_Align_Take_Off_Mode,P_Align_Take_Off_Seq_PreCondition_Index,&P_Except_Return_Array(N_PLC21_Align_Take_Off_Pre_Seq_Complete_RTN))
		
		IF ( P_Except_Return_Array(N_PLC21_Align_Take_Off_Pre_Seq_Complete_RTN) == N_TRUE )							// 참으로 결과가 리턴되었다면,
		{
			IF ( P_PMAC_Status == F_Status_STOPPING )																// 얼라인 탈착 진행 중 Stopping 진행 및 정지 가능 할 경우.
			{	
				P_Align_Take_Off_State_Machine = N_Error_Step;														// 에러스텝 이동.()
			}
			ELSE
			{
				P_Align_Take_Off_State_Machine = N_Ready_Step;	
			}
		}		
		Else if ( P_Except_Return_Array(N_PLC21_Align_Take_Off_Pre_Seq_Complete_RTN) == N_FALSE )					// 참으로 결과가 리턴되었다면,
		{
			IF ( P_PMAC_Status == F_Status_STOPPING )																// 얼라인 탈착 진행 중 Stopping 진행 및 정지 가능 할 경우.
			{	
				P_Align_Take_Off_State_Machine = N_Error_Step;														// 에러스텝 이동.()
			}

		}

	}
//=======================================================================================================================================================
// 5)  얼라인 탈착 모드 - Complte STEP
//=======================================================================================================================================================
	// 2.1.4 배출모듈 시퀀스 _ 동작 완료 스텝
	IF ( P_Align_Take_Off_State_Machine == N_Complete_Step )
	{
		P_Align_Take_Off_Status_Prod_Sequence(N_PLC21_Align_Take_Off) = F_Status_COMPLETE;							// 얼라인 탈착 모듈 상태 변경 _ 완료
		P_Align_Take_Off_Status = F_Status_COMPLETE;			
		P_Align_Take_Off_Status_Flag = 0;																			// 얼라인 탈착 상태 FLAG RESET
		P_Align_Take_Off_State_Machine = 0;																			// 스텝 초기화
	}

//=======================================================================================================================================================
// 6)얼라인 탈착 모드- Error STEP
//=======================================================================================================================================================
	// 2.1.5 모듈 시퀀스 _ 에러 처리 스텝
	IF ( P_Align_Take_Off_State_Machine == N_Error_Step )															// 에러스텝이라면 
	{
		P_Align_Take_Off_Status_Prod_Sequence(N_PLC21_Align_Take_Off) = F_Status_ABORTED;							// 얼라인 탈착 모듈 상태 변경 _ 어볼트
	
		P_Align_Take_Off_Status = F_Status_Error;																	// 에러 상태 대입											
		P_Align_Take_Off_Status_Flag = 0;																			// 얼라인 탈착 FLAG RESET
		P_Align_Take_Off_State_Machine = 0;																			// 스텝 초기화.	
	}
}
ELSE
{
	P_Align_Take_Off_State_Machine = 0;																				// 시퀀스 초기화
}

//=======================================================================================================================================================
//2. 얼라인 보정 오토 캘 
//=======================================================================================================================================================
//2.1 Idle 상태
if( P_CMD_Cell_Align(P_Vision_AutoCal_Mode) == 0)			
{
	P_Vision_AutoCal_Status = F_Status_IDLE;
}	
//--------------------------------------------------------------------------------------------------------------------------------------
// 2.1) 얼라인 오토 캘 Start Mode
//--------------------------------------------------------------------------------------------------------------------------------------
if( P_CMD_Cell_Align(P_Vision_AutoCal_Mode) == 1 )				
{
	// 2.1.1 양극 얼라인 무브 시작
	IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode )	//양극 얼라인 오토 캘일 경우
	{	
		cmd "&2b2r"											//양극 얼라인 스테이지 무브 모션 활성화
		P_PMAC_AutoCal_Mode = F_Command_Start;				//비전 캘리브레이션 PMAC 모드
		P_Vision_AutoCal_Status = F_Status_STARTING;		//비전 캘리브레이션 PMAC 상태
		P_CMD_Cell_Align(P_Vision_AutoCal_Mode)++;
	}
	// 2.1.2 양극 얼라인 무브 시작
	IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	//음극 얼라인 오토 캘일 경우
	{
		cmd "&3b3r"											//음극 얼라인 스테이지 무브 모션 활성화
		P_PMAC_AutoCal_Mode = F_Command_Start;				//비전 캘리브레이션 PMAC 모드
		P_Vision_AutoCal_Status = F_Status_STARTING;		//비전 캘리브레이션 PMAC 상태
		P_CMD_Cell_Align(P_Vision_AutoCal_Mode)++;			//스텝머신 증가
	}
}
// 얼라인 무브 완료
IF ( P_CMD_Cell_Align(P_Vision_AutoCal_Mode) == 2 )			
{
	if( P_CMD_Align_Complete == 1)							//얼라인 무브 완료 시
	{	
		P_Vision_AutoCal_Status = F_Status_HOLD;			//비전 켈리브레이션 상태 Hold
	}
}
//--------------------------------------------------------------------------------------------------------------------------------------
// 2.2) 얼라인 오토 캘 Stop Mode
//--------------------------------------------------------------------------------------------------------------------------------------
if( P_CMD_Cell_Stop(P_Vision_AutoCal_Mode) == 0)
{
   
}
// 2.2.1. 극판 복귀 시작 : Start
if( P_CMD_Cell_Stop(P_Vision_AutoCal_Mode) == 1)			
{
	// 2.2.1.1. 음극 복귀 모드 시작 
	IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode )	//양극 얼라인 오토 캘일 경우
	{
		cmd "&2b2r"											//양극 얼라인 스테이지 무브 모션 활성화
		P_PMAC_AutoCal_Mode = F_Command_Stop;				//비전 캘리브레이션 PMAC 모드
		P_Vision_AutoCal_Status = F_Status_STOPPING;		//비전 캘리브레이션 PMAC 상태
		P_CMD_Cell_Stop(P_Vision_AutoCal_Mode)++;
	}
	// 2.2.1.2. 음극 복귀 모드 시작 
	IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	//음극 얼라인 오토 캘일 경우
	{
		cmd "&3b3r"											//음극 얼라인 스테이지 무브 모션 활성화
		P_PMAC_AutoCal_Mode = F_Command_Stop;				//비전 캘리브레이션 PMAC 모드
		P_Vision_AutoCal_Status = F_Status_STOPPING;		//비전 캘리브레이션 PMAC 상태
		P_CMD_Cell_Stop(P_Vision_AutoCal_Mode)++;			//스텝머신 증가
	}
}
// 2.2.2. 극판 복귀 동작 중 : Execute
if( P_CMD_Cell_Stop(P_Vision_AutoCal_Mode) == 2)			
{
	P_Vision_AutoCal_Status = F_Status_EXECUTE;				//얼라인 무브 상태 EXECUTE일 경우
	P_CMD_Cell_Stop(P_Vision_AutoCal_Mode)++				//스텝머신 증가
}													

// 2.2.3. 극판 복귀 완료 : Stopped
IF ( P_CMD_Cell_Stop(P_Vision_AutoCal_Mode) == 3 )			
{
	if( P_CMD_Align_Complete == 1)							//얼라인 무브 완료 시
	{
		P_Vision_AutoCal_Status = F_Status_STOPPED;			//비전 켈리브레이션 상태 STOPPED
	}
}
//--------------------------------------------------------------------------------------------------------------------------------------
// 2.3) 얼라인 오토 캘 Reset Mode
//-------------------------------------------------------------------------------------------------------------------------------------
// 2.3.1. 극판 리셋 모드 시퀀스
if( P_CMD_Cell_Reset(P_Vision_AutoCal_Mode) == 1 )
{
	// 2.3.1.1. 모션 프로그램 종료
	if( P_Vision_Cal_Reset_Count == 1)								
	{
		// 2.3.1.1.1. 양극 모션 종료									
		IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode )	//양극 얼라인 오토 캘일 경우	
		{															
			P_Vision_AutoCal_Status = F_Status_CLEARING;		//양극 오토 상태 
			cmd "&2a"											//양극 얼라인 스테이지 무브 모션 비활성화
			P_Vision_Cal_Reset_Count++;							//스텝 머신 증가
		}
		// 2.3.1.1.2. 음극 모션 종료
		IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	//음극 얼라인 오토 캘일 경우	
		{															
			P_Vision_AutoCal_Status = F_Status_CLEARING;		//음극 오토 상태 
			cmd "&3a"											//음극 얼라인 스테이지 무브 모션 비활성화
			P_Vision_Cal_Reset_Count++;							//스텝 머신 증가
		}
	}
	// 2.3.1.2. 모터 정지 및 서보 온
	if( P_Vision_Cal_Reset_Count == 2)							
	{
		// 2.3.1.2.1. 양극 얼라인 모터 정지 및 서보 온				
		IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode )	//양극 얼라인 오토 캘일 경우	
		{															
			cmd "#36j/ #37j/ #38j/"								//양극 얼라인 X,Y,T축 서버 OFF
			P_Vision_Cal_Reset_Count++;							
		}														
		// 2.3.1.2.1. 음극 얼라인 모터 정지 및 서보 온
		IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	//음극 얼라인 오토 캘일 경우	
		{
			cmd "#39j/ #40j/ #41j/"								//음극 얼라인 X,Y,T축 서버 OFF
			P_Vision_Cal_Reset_Count++;
		}
	}
	if( P_Vision_Cal_Reset_Count == 3)	
	{
		P_PMAC_AutoCal_Mode = 0;								//오토 캘 모드 초기화
		P_Vision_AutoCal_Command = 0;							//비전 오토캘 커맨드 초기화
		P_Vision_AutoCal_Status = 0;							//비전 오토캘 상태 초기화
		P_PMAC_AutoCal_Alarm = 0;								//비전 오토캘 알람 초기화
		P_PMAC_AutoCal_Status = 0;								//피맥 오토캘 상태 초기화
		P_Align_AutoCal_X_POS = 0;								//비전 오토캘 얼라인 X축 보정값 초기화
		P_Align_AutoCal_Y_POS = 0;								//비전 오토캘 얼라인 Y축 보정값 초기화
		P_Align_AutoCal_T_POS = 0;								//비전 오토캘 얼라인 T축 보정값 초기화
		
		P_CMD_Cell_Align(P_Vision_AutoCal_Mode) = 0;			
		P_CMD_Cell_Stop(P_Vision_AutoCal_Mode) = 0;
		
		P_Vision_Cal_Reset_Count++;
	} 
	// 리셋 완료
	if( P_Vision_Cal_Reset_Count == 4)
	{
		P_CMD_Cell_Reset(P_Vision_AutoCal_Mode) = 0;
		P_Vision_Cal_Reset_Count =0;
	}
}

//=======================================================================================================================================================
//3. 2차 PNP 클리닝 위치 이동 
//=======================================================================================================================================================
//3.1 Idle 상태
if(P_2nd_PNP_Cleaning_Mode_Cmd == 0)
{
	P_2nd_PNP_Cleaning_Mode_Status = F_Status_IDLE;			
}	
 
// 3.2 Start
if( P_2nd_PNP_Cleaning_Mode_Cmd == 1 )
{
	P_2nd_PNP_Cleaning_Mode_Status = F_Status_STARTING;			// 2차 PNP 클리닝 위치 이동 상태 Starting
	Motor[21].JogSpeed = P_2nd_PNP_Cleaning_Mode_Jog_Speed;		// 양극 2차 PNP Z축 조그 스피드 설정
	Motor[22].JogSpeed = P_2nd_PNP_Cleaning_Mode_Jog_Speed;		// 음극 2차 PNP Z축 조그 스피드 설정
													
	// test 용
	//리밋 감지를 위해 임시로 조건 추가(삭제 예정)
	#ifdef F_Virtual_Axis_Test
	motor[21].minpos = -5000;								
	motor[22].minpos = -5000;
	#endif
	P_2nd_PNP_Cleaning_Chk_Pos_Timer = 0;						//스텟 머신 증가

	P_2nd_PNP_Cleaning_Mode_Cmd++;				
}

if( P_2nd_PNP_Cleaning_Mode_Cmd == 2 )
{
	if ( P_2nd_PNP_Cleaning_Chk_Pos_Timer > 50 ) 
	{
		P_2nd_PNP_Cleaning_Mode_Status = F_Status_EXECUTE;		// 2차 PNP 클리닝 위치 이동 상태 EXECUTE
		jog-21;													// 양극 2차 PNP Z축 - 이동 
		jog-22;													// 음극 2차 PNP Z축 - 이동
		P_2nd_PNP_Cleaning_Chk_Pos_Timer = 0;					// 타이머 초기화.
		P_2nd_PNP_Cleaning_Mode_Cmd++;							//스텟 머신 증가
	}
}
if( P_2nd_PNP_Cleaning_Mode_Cmd == 3 )						
{
	if ( P_2nd_PNP_Cleaning_Chk_Pos_Timer > 50 ) 
	{
		if ( Motor[21].MinusLimit == 1 && Motor[22].MinusLimit == 1 )	//양극 2차 PNP, 음극 2차 PNP -리밋 위치 이동
		{
			P_2nd_PNP_Cleaning_Chk_Pos_Timer = 0;	// 타이머 초기화.
			P_2nd_PNP_Cleaning_Mode_Cmd++;			//스텟 머신 증가
		}
		//Test 용
		//리밋 감지를 위해 임시로 조건 추가(삭제 예정)
		else if( ( Motor[21].SoftMinusLimit == 1 || Motor[21].SoftLimit == 1 ) && ( Motor[22].SoftMinusLimit == 1 || Motor[22].SoftLimit == 1 ))
		{
			P_2nd_PNP_Cleaning_Chk_Pos_Timer = 0;	// 타이머 초기화.
			P_2nd_PNP_Cleaning_Mode_Cmd++;			//스텟 머신 증가
		}
	}
}
if( P_2nd_PNP_Cleaning_Mode_Cmd == 4 )
{
	P_2nd_PNP_Cleaning_Mode_Status = F_Status_COMPLETE;	// 2차 PNP 클리닝 위치 이동 상태 Complete
	P_2nd_PNP_Cleaning_Chk_Pos_Timer = 0;				// 타이머 초기화.
	P_2nd_PNP_Cleaning_Mode_Cmd = 0;					//스텟 머신 증가

	//Test 용 
	//리밋 감지를 위해 임시로 조건 추가(삭제 예정)
	#ifdef F_Virtual_Axis_Test
	motor[21].minpos = 0;
	motor[22].minpos = 0;
	#endif
}
close
