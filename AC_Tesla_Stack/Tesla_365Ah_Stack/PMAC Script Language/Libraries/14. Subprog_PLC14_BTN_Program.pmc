// [ 참조 : 버튼 프로그램 추가 (ARC BTN 동작, 인터락, NP Plate Lamp) ]
/* [search / ㄴㄷㅁㄱ]
---------------------------------------------------------------------------------------------------
|							램		프		동		작		진		행							  |
|-------------------------------------------------------------------------------------------------|
|	     상부	   |	    하부		  |							조		건						  |
|-------------------------------------|-----------------------------------------------------------|
|  Upper_1st_Step  |  Lower_1st_Step  |		언와인더 언척											  |
|-------------------------------------|-----------------------------------------------------------|
|  Upper_2nd_Step  |  Lower_2nd_Step  |		언와인더 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 OFF    |
|-------------------------------------|-----------------------------------------------------------|
| Upper_3rd_Step__ | Lower_3rd_Step__ |		언와인더 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 ON	  |
|-------------------------------------|-----------------------------------------------------------|
|  Upper_4th_Step  |  Lower_4th_Step  |		언와인더 척 + 틸팅 0도								  |
|-------------------------------------|-----------------------------------------------------------|
|  Upper_5th_Step  |  Lower_5th_Step  |		언와인더 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF   |
|-------------------------------------|-----------------------------------------------------------|
|  Upper_6th_Step  |  Lower_6th_Step  |		언와인더 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON    |
|-------------------------------------|-----------------------------------------------------------|
| Upper_7th_Step__ | Lower_7th_Step__ |		언와인더 척 + 틸팅 90도								  |
---------------------------------------------------------------------------------------------------*/
open subprog ARC_NP_Lamp(void)
	//==============//
	// 상부 선택 시 //
	//============//
	sub:Upper_1st_Step(void)		// 상부 언척 => 척 점멸
		if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 척 버튼 점멸.
		{
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Chuck_Unchuck ^= $1					// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 0;								// 틸팅 버튼.
		M_Y_NP_BTN_Vacuum_On_OFF = 0;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Upper_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Upper_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Upper_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;

	sub:Upper_2nd_Step(void)		// 상부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 진공 버튼 점멸.
		{
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Vacuum_On_OFF ^= $1;					// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Upper_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Upper_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Upper_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Upper_3rd_Step(void)		// [Upper_3rd_Step__] 상부 척 + 틸팅0도 + 진공 출력 ON + 진공 입력 ON => Ready 점멸, 틸팅 점등, 척 점등, 진공 점등		
		// Ready 버튼 점멸
		if ( M_X_ARC_NP_BTN_Ready == 1 && M_Old_X_ARC_NP_Ready != M_X_ARC_NP_BTN_Ready)	// Ready 버튼을 누를 경우.
			P_ARC_NP_Upper_3rd_Step_Toggle_Variable ^= $1;	// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time && P_ARC_NP_Upper_3rd_Step_Toggle_Variable == 0 )	// Ready 버튼 점멸.
		{
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Ready ^= $1;							// 점멸.
			P_ARC_NP_Upper_Ready_Check_Bit = 1;				// Ready 버튼 점멸 중 일정 시간 후 팝업 및 부저 발생.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
			P_ARC_Upper_Ready = 0;							// 상부 언와인더 준비 완료 변수.
		}
		else if ( P_ARC_NP_Upper_3rd_Step_Toggle_Variable == 1 )	// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		{
			if ( P_ARC_Ready_Flag(N_Upper) == 1 )			// 상부 ARC 준비 상태 확인 [ 참조 : 26.04.17 ARC 보완사항 수정 ]
			{
				M_Y_NP_BTN_Ready = 1;						// 점등.
				P_ARC_NP_Upper_Ready_Check_Bit = 0;			// Ready 버튼 점멸 중 일정 시간 후 팝업 및 부저 발생.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
				P_ARC_Upper_Ready = 1;						// 상부 언와인더 준비 완료 변수.
			}
			else
			{
				M_Y_NP_BTN_Ready = 0;						// 소등.
				P_ARC_NP_Upper_Ready_Check_Bit = 0;			// Ready 버튼 점멸 중 일정 시간 후 팝업 및 부저 발생.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
				P_ARC_Upper_Ready = 0;						// 상부 언와인더 준비 완료 변수.
			}
		}
		M_Old_X_ARC_NP_Ready = M_X_ARC_NP_BTN_Ready;		// Edge 값 업데이트.
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼.
		M_Y_NP_BTN_Vacuum_On_OFF = 1;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Upper_4th_Step(void)		// 상부 척 + 틸팅 0도 => 척 점등, 틸팅 점멸
		if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 틸팅 버튼 점멸.
		{
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Tilting ^= $1						// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		M_Y_NP_BTN_Vacuum_On_OFF = 0;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Upper_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Upper_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Upper_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Upper_5th_Step(void)		// 상부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 진공 버튼 점멸.
		{
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Vacuum_On_OFF ^= $1;					// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Upper_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Upper_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Upper_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Upper_6th_Step(void)		// 상부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON => 틸팅 점멸, 척 점등, 진공 점등
		if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 틸팅 버튼 점멸.
		{
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Tilting ^= $1;						// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		M_Y_NP_BTN_Vacuum_On_OFF = 1;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Upper_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Upper_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Upper_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Upper_7th_Step(void)		// [Upper_7th_Step__] 상부 척 + 틸팅 90도 => 틸팅 점등, 척 점등, 진공 램프 점멸, 정회전 점멸, 역회전 점멸		
		if ( P_ARC_NP_Upper_7th_Step_Variable == 0 )		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		{
			M_Y_NP_BTN_Rotation = 0;						// 정회전 램프 초기화.
			M_Y_NP_BTN_Re_Rotation = 0;						// 역회전 램프 초기화.
			M_Y_NP_BTN_Vacuum_On_OFF = 0;					// 진공 램프 초기화.
			P_ARC_NP_Upper_Timer = 0;						// 타이머 초기화.
			P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;		// [상,하 바꿀 때 램프 초기화]
			P_ARC_NP_Upper_7th_Step_Variable = 1;			// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		}
		if ( P_ARC_NP_Upper_7th_Step_Variable == 1 )		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		{
			if ( P_ARC_NP_Upper_7th_Step_Edge_Variable == 0 )	// [상,하 바꿀 때 램프 초기화]
			{
				P_ARC_NP_Upper_7th_Step_Edge_Variable = 1;	// 재진입 방지.
				M_Y_NP_BTN_Rotation = 0;					// 정회전 램프 초기화.
				M_Y_NP_BTN_Re_Rotation = 0;					// 역회전 램프 초기화.
				M_Y_NP_BTN_Vacuum_On_OFF = 0;				// 진공 램프 초기화.
				P_ARC_NP_Upper_Timer = 0;					// 타이머 초기화.
			}
			if ( M_X_ARC_NP_BTN_Unwinder_Rotation == 1 )	// 정회전 버튼 누를 경우.
			{
				if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 역회전, 진공 램프 점멸.
				{
					P_ARC_NP_Upper_Timer = 0;				// 타이머 초기화.
					M_Y_NP_BTN_Rotation = 1;				// 점등.
					M_Y_NP_BTN_Re_Rotation ^= $1;			// 점멸.
					M_Y_NP_BTN_Vacuum_On_OFF ^= $1;			// 점멸.
				}
			}
			else if ( M_X_ARC_NP_BTN_Unwinder_Rotation == 0 && M_Old_X_ARC_NP_Unwinder_Rotation != M_X_ARC_NP_BTN_Unwinder_Rotation )	// 정회전 버튼을 땔 경우.
				P_ARC_NP_Upper_7th_Step_Variable = 0;		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
			if ( M_X_ARC_NP_BTN_Unwinder_Re_Rotation == 1 )	// 역회전 버튼 누를 경우.
			{
				if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 정회전, 진공 버튼 점멸.
				{
					P_ARC_NP_Upper_Timer = 0;				// 타이머 초기화.
					M_Y_NP_BTN_Rotation ^= $1;				// 점멸.
					M_Y_NP_BTN_Re_Rotation = 1;				// 점등.
					M_Y_NP_BTN_Vacuum_On_OFF ^= $1;			// 점멸.
				}
			}
			else if ( M_X_ARC_NP_BTN_Unwinder_Re_Rotation == 0 && M_Old_X_ARC_NP_Unwinder_Re_Rotation != M_X_ARC_NP_BTN_Unwinder_Re_Rotation )	// 역회전 버튼을 땔 경우.
				P_ARC_NP_Upper_7th_Step_Variable = 0;		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
			if ( P_ARC_NP_Upper_Timer > ARC_NP_Blinking_Time )	// 정회전, 역회전, 진공 램프 점멸.
			{
				P_ARC_NP_Upper_Timer = 0;					// 타이머 초기화.
				M_Y_NP_BTN_Rotation ^= $1;					// 점멸.
				M_Y_NP_BTN_Re_Rotation ^= $1;				// 점멸.
				M_Y_NP_BTN_Vacuum_On_OFF ^= $1;				// 점멸.
			}
		}
		M_Old_X_ARC_NP_Unwinder_Rotation = M_X_ARC_NP_BTN_Unwinder_Rotation;		// Edge 값 업데이트.
		M_Old_X_ARC_NP_Unwinder_Re_Rotation = M_X_ARC_NP_BTN_Unwinder_Re_Rotation;	// Edge 값 업데이트.
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Upper_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Upper_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit = 1;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
//===========================================================================================================================================================================//
	//==============//
	// 하부 선택 시 //
	//============//
	sub:Lower_1st_Step(void)		// 하부 언척 => 척 점멸
		// 척 버튼 점멸
		if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 척 버튼 점멸.
		{
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Chuck_Unchuck ^= $1;					// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 0;								// 틸팅 버튼.
		M_Y_NP_BTN_Vacuum_On_OFF = 0;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Lower_Ready = 0;								// 하부 언와인더 준비 완료 변수.
		P_ARC_NP_Lower_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Lower_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;

	sub:Lower_2nd_Step(void)		// 하부 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 진공 버튼 점멸.
		{
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Vacuum_On_OFF ^= $1;					// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Lower_Ready = 0;								// 하부 언와인더 준비 완료 변수.
		P_ARC_NP_Lower_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Lower_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Lower_3rd_Step(void)		// [Lower_3rd_Step__]하부 척 + 틸팅0도 + 진공 출력 ON + 진공 입력 ON => Ready 점멸, 틸팅 점등, 척 점등, 진공 점등
		// Ready 버튼 점멸
		if ( M_X_ARC_NP_BTN_Ready == 1 && M_Old_X_ARC_NP_Ready != M_X_ARC_NP_BTN_Ready)	// Ready 버튼을 누를 경우.
			P_ARC_NP_Lower_3rd_Step_Toggle_Variable ^= $1;	// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time && P_ARC_NP_Lower_3rd_Step_Toggle_Variable == 0 )	// Ready 버튼 점멸.
		{
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Ready ^= $1;							// 점멸.
			P_ARC_NP_Lower_Ready_Check_Bit = 1;				// Ready 버튼 점멸 중 일정 시간 후 팝업 및 부저 발생.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
			P_ARC_Lower_Ready = 0;							// 하부 언와인더 준비 완료 변수.
		}
		else if ( P_ARC_NP_Lower_3rd_Step_Toggle_Variable == 1 )	// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		{
			if ( P_ARC_Ready_Flag(N_Lower) == 1 )			// 하부 ARC 준비 상태 확인 [ 참조 : 26.04.17 ARC 보완사항 수정 ]
			{
				M_Y_NP_BTN_Ready = 1;						// 점등.
				P_ARC_NP_Lower_Ready_Check_Bit = 0;			// Ready 버튼 점멸 중 일정 시간 후 팝업 및 부저 발생.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
				P_ARC_Lower_Ready = 1;						// 상부 언와인더 준비 완료 변수.
			}
			else
			{
				M_Y_NP_BTN_Ready = 0;						// 소등.
				P_ARC_NP_Lower_Ready_Check_Bit = 0;			// Ready 버튼 점멸 중 일정 시간 후 팝업 및 부저 발생.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
				P_ARC_Lower_Ready = 0;						// 상부 언와인더 준비 완료 변수.
			}
		}
		M_Old_X_ARC_NP_Ready = M_X_ARC_NP_BTN_Ready;		// Edge 값 업데이트.
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼
		M_Y_NP_BTN_Vacuum_On_OFF = 1;						// 진공 버튼
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Lower_4th_Step(void)		// 하부 척 + 틸팅 0도 => 척 점등, 틸팅 점멸
		if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 틸팅 버튼 점멸.
		{
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Tilting ^= $1;						// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		M_Y_NP_BTN_Vacuum_On_OFF = 0;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Lower_Ready = 0;								// 하부 언와인더 준비 완료 변수.
		P_ARC_NP_Lower_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Lower_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Lower_5th_Step(void)		// 하부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 진공 버튼 점멸.
		{
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Vacuum_On_OFF ^= $1;					// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Lower_Ready = 0;								// 하부 언와인더 준비 완료 변수.
		P_ARC_NP_Lower_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Lower_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Lower_6th_Step(void)		// 하부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON => 틸팅 점멸, 척 점등, 진공 점등
		if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 틸팅 버튼 점멸.
		{
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			M_Y_NP_BTN_Tilting ^= $1;						// 점멸.
		}
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		M_Y_NP_BTN_Vacuum_On_OFF = 1;						// 진공 버튼.
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Lower_Ready = 0;								// 하부 언와인더 준비 완료 변수.
		P_ARC_NP_Lower_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Lower_7th_Step_Variable = 0;				// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 0;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
	
	sub:Lower_7th_Step(void)		// [Lower_7th_Step__] 하부 척 + 틸팅 90도 => 틸팅 점등, 척 점등, 진공 램프 점멸, 정회전 점멸, 역회전 점멸		
		if ( P_ARC_NP_Lower_7th_Step_Variable == 0 )		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		{
			M_Y_NP_BTN_Rotation = 0;						// 정회전 램프 초기화.
			M_Y_NP_BTN_Re_Rotation = 0;						// 역회전 램프 초기화.
			M_Y_NP_BTN_Vacuum_On_OFF = 0;					// 진공 램프 초기화.
			P_ARC_NP_Lower_Timer = 0;						// 타이머 초기화.
			P_ARC_NP_Lower_7th_Step_Edge_Variable = 0;		// [상,하 바꿀 때 램프 초기화]
			P_ARC_NP_Lower_7th_Step_Variable = 1;			// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		}
		if ( P_ARC_NP_Lower_7th_Step_Variable == 1 )		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
		{
			if ( P_ARC_NP_Lower_7th_Step_Edge_Variable == 0 )	// [상,하 바꿀 때 램프 초기화]
			{
				P_ARC_NP_Lower_7th_Step_Edge_Variable = 1;	// 재진입 방지.
				M_Y_NP_BTN_Rotation = 0;					// 정회전 램프 초기화.
				M_Y_NP_BTN_Re_Rotation = 0;					// 역회전 램프 초기화.
				M_Y_NP_BTN_Vacuum_On_OFF = 0;				// 진공 램프 초기화.
				P_ARC_NP_Lower_Timer = 0;					// 타이머 초기화.
			}
			if ( M_X_ARC_NP_BTN_Unwinder_Rotation == 1 )	// 정회전 버튼 누를 경우.
			{
				if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 역회전, 진공 램프 점멸.
				{
					P_ARC_NP_Lower_Timer = 0;				// 타이머 초기화.
					M_Y_NP_BTN_Rotation = 1;				// 점등.
					M_Y_NP_BTN_Re_Rotation ^= $1;			// 점멸.
					M_Y_NP_BTN_Vacuum_On_OFF ^= $1;			// 점멸.
				}
			}
			else if ( M_X_ARC_NP_BTN_Unwinder_Rotation == 0 && M_Old_X_ARC_NP_Unwinder_Rotation != M_X_ARC_NP_BTN_Unwinder_Rotation )	// 정회전 버튼을 땔 경우.
				P_ARC_NP_Lower_7th_Step_Variable = 0;		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
			if ( M_X_ARC_NP_BTN_Unwinder_Re_Rotation == 1 )	// 역회전 버튼 누를 경우.
			{
				if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 정회전, 진공 버튼 점멸.
				{
					P_ARC_NP_Lower_Timer = 0;				// 타이머 초기화.
					M_Y_NP_BTN_Rotation ^= $1;				// 점멸.
					M_Y_NP_BTN_Re_Rotation = 1;				// 점등.
					M_Y_NP_BTN_Vacuum_On_OFF ^= $1;			// 점멸.
				}
			}
			else if ( M_X_ARC_NP_BTN_Unwinder_Re_Rotation == 0 && M_Old_X_ARC_NP_Unwinder_Re_Rotation != M_X_ARC_NP_BTN_Unwinder_Re_Rotation )	// 역회전 버튼을 땔 경우.
				P_ARC_NP_Lower_7th_Step_Variable = 0;		// [정회전, 역회전 누른 후 땔 때 램프 초기화]
			if ( P_ARC_NP_Lower_Timer > ARC_NP_Blinking_Time )	// 정회전, 역회전, 진공 램프 점멸.
			{
				P_ARC_NP_Lower_Timer = 0;					// 타이머 초기화.
				M_Y_NP_BTN_Rotation ^= $1;					// 점멸.
				M_Y_NP_BTN_Re_Rotation ^= $1;				// 점멸.
				M_Y_NP_BTN_Vacuum_On_OFF ^= $1;				// 점멸.
			}
		}
		M_Old_X_ARC_NP_Unwinder_Rotation = M_X_ARC_NP_BTN_Unwinder_Rotation;			// Edge 값 업데이트.
		M_Old_X_ARC_NP_Unwinder_Re_Rotation = M_X_ARC_NP_BTN_Unwinder_Re_Rotation;		// Edge 값 업데이트.
		//==================//
		// 나머지 버튼 조작 //
		//================//
		M_Y_NP_BTN_Ready = 0;								// Ready 버튼.
		M_Y_NP_BTN_Tilting = 1;								// 틸팅 버튼.
		M_Y_NP_BTN_Chuck_Unchuck = 1;						// 척 버튼. 
		//=============//
		// 변수 초기화 //
		//===========//
		P_ARC_Lower_Ready = 0;								// 상부 언와인더 준비 완료 변수.
		P_ARC_NP_Lower_3rd_Step_Toggle_Variable = 0;		// [Ready 버튼 누를 때 : 점멸 → 점등, 점등 → 점멸]
		P_ARC_NP_Upper_7th_Step_Edge_Variable = 0;			// [상,하 바꿀 때 램프 초기화]
		P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit = 1;			// 정회전, 역회전 램프 점멸 확인 비트.
	return;
//===========================================================================================================================================================================//
	sub:Unconditional(object)
		switch(object)
		{
			case ARC_NP_Upper_Check:						// [U_Unconditional]
				if ( M_X_Sepa_Upper_ARC_Up_Sensor && M_X_Sepa_Upper_ARC_Dn_Sensor^$1 )		// 상부 플레이트 상승 일 경우.
				{
					M_Y_NP_BTN_Plate_Up_Down = 1;			// NP 상승/하강 버튼 램프 ON.
				}
				else if ( M_X_Sepa_Upper_ARC_Up_Sensor^$1 && M_X_Sepa_Upper_ARC_Dn_Sensor )	// 상부 플레이트 하강 일 경우.
				{
					M_Y_NP_BTN_Plate_Up_Down = 0;			// NP 상승/하강 버튼 램프 OFF.
				}
				if ( M_X_ARC_NP_BTN_Plate_Stopper_Clamp || (M_X_Sepa_Upper_ARC_Stopper_Front_Sensor && M_X_Sepa_Upper_ARC_Stopper_Rear_Sensor) )	// NP 클램프 버튼을 누를 경우 또는 클램프 상태 일 경우.
				{
					M_Y_NP_BTN_Clamp_On_OFF = 1;			// NP 클램프 램프 ON.
				}
				else										// NP 클램프 버튼을 땔 경우.
				{
					M_Y_NP_BTN_Clamp_On_OFF = 0;			// NP 클램프 램프 OFF.
				}
				if ( M_X_ARC_NP_BTN_Plate_Sepa_Cutting || (M_X_Sepa_Upper_ARC_Cutting_FWD_Sensor && M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor^$1))		// NP 커팅 버튼을 누를 경우 또는 전진 상태 일 경우.
				{
					M_Y_NP_BTN_Sepa_Cutting = 1;			// NP 커팅 램프 ON.
				}
				else										// NP 커팅 버튼을 땔 경우.
				{
					M_Y_NP_BTN_Sepa_Cutting = 0;			// NP 커팅 램프 OFF.
				}
				if ( P_ARC_NP_Upper_Rot_ReRot_Blinking_Bit^$1)	// NP 정회전, 역회전 램프가 점멸이 아닐 경우.
				{
					if ( M_X_ARC_NP_BTN_Unwinder_Rotation )	// NP 정회전 버튼을 누를 경우.
					{
						M_Y_NP_BTN_Rotation = 1;			// NP 정회전 램프 ON.
					}
					else									// NP 정회전 버튼을 땔 경우.
					{
						M_Y_NP_BTN_Rotation = 0;			// NP 정회전 램프 OFF.
					}
					if ( M_X_ARC_NP_BTN_Unwinder_Re_Rotation )	// NP 역회전 버튼을 누를 경우. 
					{
						M_Y_NP_BTN_Re_Rotation = 1;			// NP 역회전 램프 ON. 
					}
					else									// NP 역회전 버튼을 땔 경우.
					{ 
						M_Y_NP_BTN_Re_Rotation = 0;			// NP 역회전 램프 OFF. 
					}
				}
			break;

			case ARC_NP_Lower_Check:						// [L_Unconditional]
				if ( M_X_Sepa_Lower_ARC_Up_Sensor && M_X_Sepa_Lower_ARC_Dn_Sensor^$1 )		// 하부 플레이트 상승 일 경우.
				{
					M_Y_NP_BTN_Plate_Up_Down = 0;			// NP 상승/하강 버튼 램프 OFF.
				}
				else if ( M_X_Sepa_Lower_ARC_Up_Sensor^$1 && M_X_Sepa_Lower_ARC_Dn_Sensor )	// 하부 플레이트 하강 일 경우.
				{
					M_Y_NP_BTN_Plate_Up_Down = 1;			// NP 상승/하강 버튼 램프 ON.
				}
				if ( M_X_ARC_NP_BTN_Plate_Stopper_Clamp || (M_X_Sepa_Lower_ARC_Stopper_Front_Sensor && M_X_Sepa_Lower_ARC_Stopper_Rear_Sensor) )	// NP 클램프 버튼을 누를 경우 또는 클램프 상태 일 경우.
				{
					M_Y_NP_BTN_Clamp_On_OFF = 1;			// NP 클램프 램프 ON.
				}
				else										// NP 클램프 버튼을 땔 경우.
				{
					M_Y_NP_BTN_Clamp_On_OFF = 0;			// NP 클램프 램프 OFF.
				}
				if ( M_X_ARC_NP_BTN_Plate_Sepa_Cutting || (M_X_Sepa_Lower_ARC_Cutting_FWD_Sensor && M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor^$1) )		// NP 커팅 버튼을 누를 경우 또는 전진 상태 일 경우.
				{
					M_Y_NP_BTN_Sepa_Cutting = 1;			// NP 커팅 램프 ON.
				}
				else										// NP 커팅 버튼을 땔 경우.
				{
					M_Y_NP_BTN_Sepa_Cutting = 0;			// NP 커팅 램프 OFF.
				}
				if ( P_ARC_NP_Lower_Rot_ReRot_Blinking_Bit^$1)	// NP 정회전, 역회전 램프가 점멸이 아닐 경우.
				{
					if ( M_X_ARC_NP_BTN_Unwinder_Rotation )	// NP 정회전 버튼을 누를 경우.
					{
						M_Y_NP_BTN_Rotation = 1;			// NP 정회전 램프 ON.
					}
					else									// NP 정회전 버튼을 땔 경우.
					{
						M_Y_NP_BTN_Rotation = 0;			// NP 정회전 램프 OFF.
					}
					if ( M_X_ARC_NP_BTN_Unwinder_Re_Rotation )	// NP 역회전 버튼을 누를 경우. 
					{
						M_Y_NP_BTN_Re_Rotation = 1;			// NP 역회전 램프 ON. 
					}
					else									// NP 역회전 버튼을 땔 경우. 
					{
						M_Y_NP_BTN_Re_Rotation = 0;			// NP 역회전 램프 OFF. 
					}
				}
			break;
		}
	return;
//===========================================================================================================================================================================//
	sub:Lamp_Clear(void)
		M_Y_NP_BTN_Ready = 0;			// Merge 시 주석 삭제 필요. [ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
		M_Y_NP_BTN_Spool_Home = 0;      
		M_Y_NP_BTN_Alignment = 0;    
		M_Y_NP_BTN_Tilting = 0;		
		M_Y_NP_BTN_Chuck_Unchuck = 0;
		M_Y_NP_BTN_Rotation = 0;     
		M_Y_NP_BTN_Re_Rotation = 0;  
		M_Y_NP_BTN_Vacuum_On_OFF = 0;
		M_Y_NP_BTN_Sepa_Cutting = 0; 
		M_Y_NP_BTN_Clamp_On_OFF = 0; 
		M_Y_NP_BTN_Plate_Up_Down = 0;
	return;

close
