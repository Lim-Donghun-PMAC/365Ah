		IF ( L_Subprog_Act_EXECUTE_Vision_Check == N_COMPLETE )														// 실행 함수 호출 완료 되었을 경우.
		{
			P_Module_Act_Execute_Command_Array(N_Act_Vision_Check) = F_ACT_STATUS_DISABLE;							// 시퀀스 완료 시 상태 비활성화.
		}
		ELSE IF ( L_Subprog_Act_EXECUTE_Vision_Check == N_FALSE )													// 실행 함수 호출 실패 되었을 경우.
		{
			//P_Suspend_Anode_1TR_Cell_Supply_State_Machine = N_Error_Step; 										// 스탑포인트 에러 처리 할 것 
			P_Module_Act_Execute_Command_Array(N_Act_Vision_Check) = F_ACT_STATUS_ALARM;							// 동작 에러.
