	//===========//
	// 버튼 LED //
	//===========//
	sub:Manual_LED(void)
		switch(P_PMAC_Status)
		{
			case F_Status_IDLE:
				if( P_PMAC_Status_IDLE_Motor_Pos == 1 )			// 대기위치, 음극 스텍 정지 위치, 양극 스텍 정지 위치, 배출 중 정지 위치.
				{
					call BTN_Program.Lamp(Ready_BTN,Turn_On)	// Ready Lamp [점등]
					call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
					call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
				}
				else if( P_PMAC_Status_IDLE_Motor_Not_Pos == 1 )// 그 외에 위치 일 경우. (IDLE 에서 모터의 위치가 움직 일 경우)
				{
					// MSA, Motion Cal, 얼라인 탈착 모드 진행 시 IDLE 상태여도 Commands Stop X [ 참조 : 25.07.09 MSA 프로그램 신규 추가 ] 
					if( P_VISION_MSA_Status == F_Status_EXECUTE || P_VISION_MSA_Status_Prod_Sequence(N_PLC13_VISION_MSA) == F_Status_STARTING || P_Align_Take_Off_Status == F_Status_EXECUTE || P_Align_Take_Off_Status_Prod_Sequence(N_PLC13_Align_Take_Off) == F_Status_STARTING || P_PMAC_AutoCal_Mode != 0 || P_Single_Run_Execute_Bit == 1 )
					{
						call BTN_Program.Lamp(Ready_BTN,Turn_On)	// Ready Lamp [점등]
						call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
						call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
					}
					else 
					{
						call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
						call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
						call BTN_Program.Lamp(Stop_BTN,Turn_On)		// Stop Lamp [점등]
						P_BTN_IDLE_Motor_Not_Pos = 1;				// PackML Stopping Skip 변수 추가.
						P_PMAC_Commands = F_Command_Stop;			// Commands Stop.
						P_Stop_Cmd_Origin = 1
					}
				}
			break;

			case F_Status_RESETTING:
				call BTN_Program.Lamp(Ready_BTN,Blinking)	// Ready Lamp [점멸]
				call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_STOPPING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
				call BTN_Program.Lamp(Stop_BTN,Blinking)	// Stop Lamp [점멸]
			break;

			case F_Status_STOPPED:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
				call BTN_Program.Lamp(Stop_BTN,Turn_On)		// Stop Lamp [점등]
			break;
		}

	return;
	//===========//
	// 버튼 LED //
	//===========//
	sub:Auto_LED(void)
		switch(P_PMAC_Status)
		{
			case F_Status_IDLE:
				call BTN_Program.Lamp(Ready_BTN,Turn_On)	// Ready Lamp [점등]
				call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_EXECUTE:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_STARTING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Blinking)	// Start Lamp [점멸]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_HOLDING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_HOLD:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_UNHOLDING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_SUSPENDING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_SUSPENDED:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_UNSUSPENDING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_On)	// Start Lamp [점등]
				call BTN_Program.Lamp(Stop_BTN,Turn_Off)	// Stop Lamp [OFF]
			break;

			case F_Status_STOPPING:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
				call BTN_Program.Lamp(Stop_BTN,Blinking)	// Stop Lamp [점멸]
			break;

			case F_Status_STOPPED:
				call BTN_Program.Lamp(Ready_BTN,Turn_Off)	// Ready Lamp [OFF]
				call BTN_Program.Lamp(Start_BTN,Turn_Off)	// Start Lamp [OFF]
				call BTN_Program.Lamp(Stop_BTN,Turn_On)		// Stop Lamp [점등]
			break;
		}

		////--------------------//
		//// 알람 발생 신호 전달 //
		////--------------------//
		//If ( P_PMAC_Status == F_Status_ABORTING || P_PMAC_Status == F_Status_ABORTED )
		//	M_Y_Trigger_Display_Enable_Alarm_To_PLC = 1;					// 알람 발생 신호 PLC 측에 전달
		//Else 
		//	M_Y_Trigger_Display_Enable_Alarm_To_PLC = 0;					// 알람 발생 신호 OFF PLC 측에 전달

	return;

	//===============//
	// 모터 Servo ON //
	//===============//
	sub:Motor_Servo_On(void)

		local L_Motor_Num = 0;						// 모터 번호 초기화.
		local L_Motor_Cnt = 48;						// 모터 최대 번호 설정.
		//if ( P_Status_Sepa_ARC_Request == 1 )		// ARC 요청 신호가 있을 경우. [Unwinder Servo On]
			L_Motor_Num = 1;						// 모터 번호 1번 설정.
		//else										// ARC 요청 신호가 없을 경우. 
		//	L_Motor_Num = 3;						// 모터 번호 3번 설정.
		while ( L_Motor_Num <= L_Motor_Cnt )		// 모터 번호 <= 모터 최대 번호.
		{
			if ( Motor[L_Motor_Num].AmpEna != 1 )	// 모터 Servo OFF 일 경우.
			{
				//[참조 : 260116 페이징 안된 모터 j/ 막기]
				if( L_Motor_Num == 1 || L_Motor_Num == 2 || L_Motor_Num == 3 || L_Motor_Num == 4 )
				{
					if( Motor[L_Motor_Num].phasefound == 0 )
					{
						//P_PWM_Phasing_Start(L_Motor_Num) = 1;
						P_Phasing_Err(L_Motor_Num)++
					}
					else
					{
						Ldata.Motor = L_Motor_Num			// 모터 설정 ← 모터 번호.
						jog/								// 모터 Servo ON.
						P_Servo_ON_MNTR14++
					}
				}
				else
				{
					Ldata.Motor = L_Motor_Num			// 모터 설정 ← 모터 번호.
					jog/								// 모터 Servo ON.
					P_Servo_ON_MNTR15++
				}
				L_Motor_Num += 1;					// 모터 번호 증가.
			}
			else									// 모터 Servo ON 일 경우.
				L_Motor_Num += 1;					// 모터 번호 증가.
		}

	return;

	//===============//
	// 모터 Stop //			- // [ 참조 : 26.04.24 Manual 상태에서 조그 구종 중 Stop 버튼 눌렀을 시 조그 STOP ]
	//===============//
	sub:Motor_Stop(void)
		// 스탑 조건 3.5세대와 동일하게 변경
		P_Servo_ON_MNTR17++
		if ( Motor[N_1st_PnP_CA_T].DesVelZero == 0 && Motor[N_1st_PnP_CA_T].Inpos == 0 ||  P_Current_Homming_Status(N_1st_PnP_CA_T) == F_Status_STARTING)	// 모터 Servo ON 일 경우.
		{
			if ( Motor[N_1st_PnP_CA_T].phasefound == 1 )
			{
				P_Home_Command(N_1st_PnP_CA_T) = 9;
				jog/N_1st_PnP_CA_T;		// 양극 1차 PNP T
			}
		}

		if ( Motor[N_1st_PnP_AN_T].DesVelZero == 0 && Motor[N_1st_PnP_AN_T].Inpos == 0 ||  P_Current_Homming_Status(N_1st_PnP_AN_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			if ( Motor[N_1st_PnP_AN_T].phasefound == 1 )
			{
				P_Home_Command(N_1st_PnP_AN_T) = 9;
				jog/N_1st_PnP_AN_T;		// 음극 1차 PNP T
			}
		}

		if ( Motor[N_2nd_PnP_CA_T].DesVelZero == 0 && Motor[N_2nd_PnP_CA_T].Inpos == 0 ||  P_Current_Homming_Status(N_2nd_PnP_CA_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			if ( Motor[N_2nd_PnP_CA_T].phasefound == 1 )
			{
				P_Home_Command(N_2nd_PnP_CA_T) = 9;
				jog/N_2nd_PnP_CA_T;		// 양극 2차 PNP T
			}
		}

		if ( Motor[N_2nd_PnP_AN_T].DesVelZero == 0 && Motor[N_2nd_PnP_AN_T].Inpos == 0 ||  P_Current_Homming_Status(N_2nd_PnP_AN_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			if ( Motor[N_2nd_PnP_AN_T].phasefound == 1 )
			{
				P_Home_Command(N_2nd_PnP_AN_T) = 9;
				jog/N_2nd_PnP_AN_T;		// 양극 2차 PNP T
			}
		}

		if ( Motor[N_Clamp_CA_Y1].DesVelZero == 0 && Motor[N_Clamp_CA_Y1].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_CA_Y1) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_CA_Y1) = 9;
			jog/N_Clamp_CA_Y1;			// 양극 클램프 Y1
		}

		if ( Motor[N_Clamp_AN_Y1].DesVelZero == 0 && Motor[N_Clamp_AN_Y1].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_AN_Y1) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_AN_Y1) = 9;
			jog/N_Clamp_AN_Y1;			// 음극 클램프 Y1
		}

		if ( Motor[N_Clamp_CA_Y2].DesVelZero == 0 && Motor[N_Clamp_CA_Y2].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_CA_Y2) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_CA_Y2) = 9;
			jog/N_Clamp_CA_Y2;			// 양극 클램프 Y2
		}

		if ( Motor[N_Clamp_AN_Y2].DesVelZero == 0 && Motor[N_Clamp_AN_Y2].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_AN_Y2) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_AN_Y2) = 9;
			jog/N_Clamp_AN_Y2;			// 음극 클램프 Y2
		}

	//	if ( Motor[N_Motor_Spare_1].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_Motor_Spare_1;		// N_Motor_Spare_1
	//	}
	//
	//	if ( Motor[N_Motor_Spare_2].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_Motor_Spare_2;		// N_Motor_Spare_2
	//	}

		if ( Motor[N_MAIN_Z].DesVelZero == 0 && Motor[N_MAIN_Z].Inpos == 0 ||  P_Current_Homming_Status(N_MAIN_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_MAIN_Z) = 9;
			jog/N_MAIN_Z;			// Main Z
		}

		if ( Motor[N_FINAL_ROLL_X].DesVelZero == 0 && Motor[N_FINAL_ROLL_X].Inpos == 0 ||  P_Current_Homming_Status(N_FINAL_ROLL_X) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_FINAL_ROLL_X) = 9;
			jog/N_FINAL_ROLL_X;			// Final Roll X
		}

		if ( Motor[N_FINAL_ROLL_Z].DesVelZero == 0 && Motor[N_FINAL_ROLL_Z].Inpos == 0 ||  P_Current_Homming_Status(N_FINAL_ROLL_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_FINAL_ROLL_Z) = 9;
			jog/N_FINAL_ROLL_Z;			// Final Roll Z
		}

	//	if ( Motor[N_SUB_FEEDING_ROLL].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_SUB_FEEDING_ROLL;		// N_SUB_FEEDING_ROLL
	//	}

		if ( Motor[N_DRIVING_ROLL].DesVelZero == 0 && Motor[N_DRIVING_ROLL].Inpos == 0 ||  P_Current_Homming_Status(N_DRIVING_ROLL) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_DRIVING_ROLL) = 9;
			jog/N_DRIVING_ROLL;			// Driving Roll
		}

		if ( Motor[N_SERVO_DANCER].DesVelZero == 0 && Motor[N_SERVO_DANCER].Inpos == 0 ||  P_Current_Homming_Status(N_SERVO_DANCER) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_SERVO_DANCER) = 9;
			jog/N_SERVO_DANCER;			// Servo Dancer
		}

		if ( Motor[N_1st_PnP_CA_Z].DesVelZero == 0 && Motor[N_1st_PnP_CA_Z].Inpos == 0 ||  P_Current_Homming_Status(N_1st_PnP_CA_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_1st_PnP_CA_Z) = 9;
			jog/N_1st_PnP_CA_Z;			// 양극 1차 PNP Z
		}

		if ( Motor[N_1st_PnP_AN_Z].DesVelZero == 0 && Motor[N_1st_PnP_AN_Z].Inpos == 0 ||  P_Current_Homming_Status(N_1st_PnP_AN_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_1st_PnP_AN_Z) = 9;
			jog/N_1st_PnP_AN_Z;			// 음극 1차 PNP Z
		}

		if ( Motor[N_1st_Picker_CA_T].DesVelZero == 0 && Motor[N_1st_Picker_CA_T].Inpos == 0 ||  P_Current_Homming_Status(N_1st_Picker_CA_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_1st_Picker_CA_T) = 9;
			jog/N_1st_Picker_CA_T;			// 양극 1차 PNP Picker T
		}

		if ( Motor[N_1st_Picker_AN_T].DesVelZero == 0 && Motor[N_1st_Picker_AN_T].Inpos == 0 ||  P_Current_Homming_Status(N_1st_Picker_AN_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_1st_Picker_AN_T) = 9;
			jog/N_1st_Picker_AN_T;			// 음극 1차 PNP Picker T
		}

		if ( Motor[N_2nd_PnP_CA_Z].DesVelZero == 0 && Motor[N_2nd_PnP_CA_Z].Inpos == 0 ||  P_Current_Homming_Status(N_2nd_PnP_CA_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_2nd_PnP_CA_Z) = 9;
			jog/N_2nd_PnP_CA_Z;			// 양극 2차 PNP Z
		}

		if ( Motor[N_2nd_PnP_AN_Z].DesVelZero == 0 && Motor[N_2nd_PnP_AN_Z].Inpos == 0 ||  P_Current_Homming_Status(N_2nd_PnP_AN_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_2nd_PnP_AN_Z) = 9;
			jog/N_2nd_PnP_AN_Z;			// 음극 2차 PNP Z
		}

		if ( P_EXECUTE_Status_Prod_Sequence(N_ARC_Module) != F_Status_STARTING )
		{
			P_Home_Command(N_UNWINDER_UPPER) = 9;
			if ( Motor[N_UNWINDER_UPPER].DesVelZero == 0 && Motor[N_UNWINDER_UPPER].Inpos == 0 ||  P_Current_Homming_Status(N_UNWINDER_UPPER) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
			{
				jog/N_UNWINDER_UPPER;			// 상부 언와인더
			}

			if ( Motor[N_UNWINDER_LOWER].DesVelZero == 0 && Motor[N_UNWINDER_LOWER].Inpos == 0 ||  P_Current_Homming_Status(N_UNWINDER_LOWER) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
			{
				P_Home_Command(N_UNWINDER_LOWER) = 9;
				jog/N_UNWINDER_LOWER;			// 하부 언와인더
			}
		}

		if ( Motor[N_Clamp_CA_Z2].DesVelZero == 0 && Motor[N_Clamp_CA_Z2].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_CA_Z2) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_CA_Z2) = 9;
			jog/N_Clamp_CA_Z2;			// 양극 클램프 Z1
		}

		if ( Motor[N_Clamp_AN_Z2].DesVelZero == 0 && Motor[N_Clamp_AN_Z2].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_AN_Z2) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_AN_Z2) = 9;
			jog/N_Clamp_AN_Z2;			// 음극 클램프 Z1
		}

		if ( Motor[N_Clamp_CA_Z1].DesVelZero == 0 && Motor[N_Clamp_CA_Z1].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_CA_Z1) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_CA_Z1) = 9;
			jog/N_Clamp_CA_Z1;			// 양극 클램프 Z2
		}

		if ( Motor[N_Clamp_AN_Z1].DesVelZero == 0 && Motor[N_Clamp_AN_Z1].Inpos == 0 ||  P_Current_Homming_Status(N_Clamp_AN_Z1) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Clamp_AN_Z1) = 9;
			jog/N_Clamp_AN_Z1;			// 음극 클램프 Z2
		}

	//	if ( Motor[N_Motor_Spare_3].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_Motor_Spare_3;		// N_Motor_Spare_3
	//	}
	//
	//	if ( Motor[N_Motor_Spare_4].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_Motor_Spare_4;		// N_Motor_Spare_4
	//	}
	//
	//	if ( Motor[N_Motor_Spare_5].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_Motor_Spare_5;		// N_Motor_Spare_5
	//	}
	//
	//	if ( Motor[N_Motor_Spare_6].AmpEna == 1 )	// 모터 Servo ON 일 경우.
	//	{
	//		jog/N_Motor_Spare_6;		// N_Motor_Spare_6
	//	}

		if ( Motor[N_EPC_SENSOR].DesVelZero == 0 && Motor[N_EPC_SENSOR].Inpos == 0 ||  P_Current_Homming_Status(N_EPC_SENSOR) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_EPC_SENSOR) = 9;
			jog/N_EPC_SENSOR;			// EPC Sensor
		}

		if ( Motor[N_STACK_VISION].DesVelZero == 0 && Motor[N_STACK_VISION].Inpos == 0 ||  P_Current_Homming_Status(N_STACK_VISION) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_STACK_VISION) = 9;
			jog/N_STACK_VISION;			// Stack Vision
		}

		if ( Motor[N_SHEET_PAPER_X].DesVelZero == 0 && Motor[N_SHEET_PAPER_X].Inpos == 0 ||  P_Current_Homming_Status(N_SHEET_PAPER_X) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_SHEET_PAPER_X) = 9;
			jog/N_SHEET_PAPER_X;			// 시트페이퍼
		}

		if ( Motor[N_Align_CA_X].DesVelZero == 0 && Motor[N_Align_CA_X].Inpos == 0 ||  P_Current_Homming_Status(N_Align_CA_X) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Align_CA_X) = 9;
			jog/N_Align_CA_X;			// 양극 얼라인 X
		}

		if ( Motor[N_Align_CA_Y].DesVelZero == 0 && Motor[N_Align_CA_Y].Inpos == 0 ||  P_Current_Homming_Status(N_Align_CA_Y) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Align_CA_Y) = 9;
			jog/N_Align_CA_Y;			// 양극 얼라인 Y
		}

		if ( Motor[N_Align_CA_T].DesVelZero == 0 && Motor[N_Align_CA_T].Inpos == 0 ||  P_Current_Homming_Status(N_Align_CA_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Align_CA_T) = 9;
			jog/N_Align_CA_T;			// 양극 얼라인 T
		}

		if ( Motor[N_Align_AN_X].DesVelZero == 0 && Motor[N_Align_AN_X].Inpos == 0 ||  P_Current_Homming_Status(N_Align_AN_X) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Align_AN_X) = 9;
			jog/N_Align_AN_X;			// 음극 얼라인 X
		}

		if ( Motor[N_Align_AN_Y].DesVelZero == 0 && Motor[N_Align_AN_Y].Inpos == 0 ||  P_Current_Homming_Status(N_Align_AN_Y) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Align_AN_Y) = 9;
			jog/N_Align_AN_Y;			// 음극 얼라인 Y
		}

		if ( Motor[N_Align_AN_T].DesVelZero == 0 && Motor[N_Align_AN_T].Inpos == 0 ||  P_Current_Homming_Status(N_Align_AN_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_Align_AN_T) = 9;
			jog/N_Align_AN_T;			// 음극 얼라인 T
		}

		if ( Motor[N_NG_PnP_CA_T].DesVelZero == 0 && Motor[N_NG_PnP_CA_T].Inpos == 0 ||  P_Current_Homming_Status(N_NG_PnP_CA_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_NG_PnP_CA_T) = 9;
			jog/N_NG_PnP_CA_T;			// 양극 NG PNP T
		}

		if ( Motor[N_NG_PnP_AN_T].DesVelZero == 0 && Motor[N_NG_PnP_AN_T].Inpos == 0 ||  P_Current_Homming_Status(N_NG_PnP_AN_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_NG_PnP_AN_T) = 9;
			jog/N_NG_PnP_AN_T;			// 음극 NG PNP T
		}

		if ( Motor[N_NG_PnP_CA_Z].DesVelZero == 0 && Motor[N_NG_PnP_CA_Z].Inpos == 0 ||  P_Current_Homming_Status(N_NG_PnP_CA_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_NG_PnP_CA_Z) = 9;
			jog/N_NG_PnP_CA_Z;			// 양극 NG PNP Z
		}

		if ( Motor[N_NG_PnP_AN_Z].DesVelZero == 0 && Motor[N_NG_PnP_AN_Z].Inpos == 0 ||  P_Current_Homming_Status(N_NG_PnP_AN_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_NG_PnP_AN_Z) = 9;
			jog/N_NG_PnP_AN_Z;			// 음극 NG PNP Z
		}

		if ( Motor[N_UNLOADER_X].DesVelZero == 0 && Motor[N_UNLOADER_X].Inpos == 0 ||  P_Current_Homming_Status(N_UNLOADER_X) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_UNLOADER_X) = 9;
			jog/N_UNLOADER_X;			// 언로더 X
		}

		if ( Motor[N_UNLOADER_Z].DesVelZero == 0 && Motor[N_UNLOADER_Z].Inpos == 0 ||  P_Current_Homming_Status(N_UNLOADER_Z) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_UNLOADER_Z) = 9;
			jog/N_UNLOADER_Z;			// 언로더 Y
		}

		if ( Motor[N_UNLOADER_T].DesVelZero == 0 && Motor[N_UNLOADER_T].Inpos == 0 ||  P_Current_Homming_Status(N_UNLOADER_T) == F_Status_STARTING )	// 모터 Servo ON 일 경우.
		{
			P_Home_Command(N_UNLOADER_T) = 9;
			jog/N_UNLOADER_T;			// 언로더 T
		}

	return;

