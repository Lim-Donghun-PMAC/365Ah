#define Max_Motor_EA		62		// 가상축 모터 추가 시 증가
#ifdef F_Virtual_Axis_Test	// 가상축으로 테스트 용 설정.

//============================================================================================================================
//-------Virtual Axis #1--------------------
// 1ST P&P CATHODE T
                           
Motor[1].Ctrl		= Sys.PidCtrl // only need simple PID loop
Motor[1].ServoCtrl	= 1
Motor[1].pDac		= Sys.Idata[1].a 
Motor[1].pAmpEnable = 0
Motor[1].pAmpFault	= 0
Motor[1].pLimits	= 0
Motor[1].CaptureMode= 1 // software capture 
Motor[1].pEnc=EncTable[1].a
Motor[1].pEnc2=EncTable[1].a
// needed gains
Motor[1].Servo.Kp	= 1 
Motor[1].Servo.Kvfb = 0 
Motor[1].Servo.Kvff = 0
Motor[1].Servo.Kaff = 0
Motor[1].Servo.Ki	= 0.001
Motor[1].servo.MaxGainFactor=28000
Motor[1].servo.MaxPosErr=10000
Motor[1].MaxSpeed=0
Motor[1].InvAmax = 0;
Motor[1].InvDmax = 0;
Motor[1].InvJmax = 0;
Motor[1].JogTa=100
Motor[1].JogTs=50
Motor[1].JogSpeed=10
Motor[1].MaxDac=32767
Motor[1].PosSf=1
Motor[1].Pos2Sf=1
// process Dac data
EncTable[1].type		= 1
EncTable[1].ScaleFactor = 1/65536
EncTable[1].pEnc		= Sys.Idata[1].a
EncTable[1].index4		= 1

