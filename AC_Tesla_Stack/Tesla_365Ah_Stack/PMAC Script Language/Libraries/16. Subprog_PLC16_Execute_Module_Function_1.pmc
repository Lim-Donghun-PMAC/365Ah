//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.xx.xx 
// 내용 - [ 참조 : 25.xx.xx 내용 ]

open subprog Execute_Module(void)		// [ 참조 : 25.06.20 세파 첫장 모듈 추가. ]

	sub:Init(&Init_RTN)
	Init_RTN = 0;
	// 0. 인덱스 초기화.
	P_Execute_1st_Sepa_Index = 0;
	// 1. 모듈 진행 상태 초기화.
	P_Execute_1st_Sepa_Status = 0;
	// 2. 모듈 반환값 초기화.
	P_Execute_1st_Sepa_Func_RTN(0),N_Execute_Module_End_Index = 0;
	// 3. 모듈 스텟머신 초기화.
	P_Execute_1st_Sepa_Func_State_Machine(0),N_Execute_Module_End_Index = 0;

	Init_RTN = F_TRUE;
	return;

	/* Search //
	=============================================================================
	1. N_Act_Motor_Pos_Check		1. 세파 첫장 가능 위치 확인.
	2. N_Act_FR_1st_Move			2. 파이널 롤러 1차 이동 && Sheet Paper 전진.
	3. N_Act_FR_2nd_Move			3. 파이널 롤러 2차 이동.
	4. N_Act_FR_Down				4. 파이널 롤러 하강.
	5. N_Act_Cathode_Clamp_On		5. 양극 클램프 ON.
	6. N_Act_Vision_Check			6. Vision 촬상.
	7. N_Act_FR_Up					7. 파이널 롤러 상승.
	=============================================================================
	*/
	sub:Execute(Index, &Execute_RTN)
	Execute_RTN = 0;
	switch(Index)
	{
		case N_Act_Motor_Pos_Check:		// 세파 첫장 가능 위치 확인.
			// 0) 메모리 타워 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Motor_Pos_Check) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_STARTING;							// 모듈 상태 : 시작 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_Motor_Pos_Check) = Sys.Time;			// 시간 업데이트.
				P_Memory_Tower_Search_Flag = 1;											// 메모리 타워 실행.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_Motor_Pos_Check) = 1;		// 다음 스텟 머신으로 이동.
			}
			// 1) 세파 첫장 가능 위치 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Motor_Pos_Check) == 1 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_Motor_Pos_Check) + P_Execute_1st_Sepa_Time_Out(N_Act_Motor_Pos_Check))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos )	// 설비 대기 위치, Sheet Paper 입력 센서 확인.
					{
						if ( P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence && M_X_First_Sheet_Paper_Plate_Vac_Sensor == 1 )		// [ 참조 : 25.07.18 세파 첫장 프로그램 수정 ]
						{
							Execute_RTN = F_TRUE;											// 반환값 : TRUE.
							P_Execute_1st_Sepa_Func_State_Machine(N_Act_Motor_Pos_Check) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
						}
						else if ( P_Buffer_Mode_Status_Sequence == N_Dryrun_Status_Sequence )
						{
							Execute_RTN = F_TRUE;											// 반환값 : TRUE.
							P_Execute_1st_Sepa_Func_State_Machine(N_Act_Motor_Pos_Check) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
						}
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
		break;

		case N_Act_FR_1st_Move:			// 파이널 롤러 1차 이동 && Sheet Paper 전진.
			// 0) 모션 상태 초기화.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_1st_Move) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_EXECUTE;							// 모듈 상태 : 진행 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_FR_1st_Move) = Sys.Time;				// 시간 업데이트.
				P_Final_Roll_Stack_Pos_Status = 0;										// 파이널 롤러 모션 상태 초기화.
				P_Sheet_Paper_FWD_Pos_Status = 0;										// Sheet Paper 모션 상태 초기화.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_1st_Move) = 1;			// 다음 스텟 머신으로 이동.
			}
			// 1) 모션 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_1st_Move) == 1 )
			{
				P_Slave5_Motion_Command = N_FR_Stack_Pos_Motion;						// 파이널 롤러 음극 방향 이동 (X:-168mm)
				P_Slave11_Motion_Command = N_Sheet_Paper_FWD_Motion;					// Sheet Paper 전진 (120.1mm)
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_1st_Move) = 2;
			}
			// 2) 모션 실행 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_1st_Move) == 2 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_FR_1st_Move) + P_Execute_1st_Sepa_Time_Out(N_Act_FR_1st_Move))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Final_Roll_Stack_Pos_Status & P_Sheet_Paper_FWD_Pos_Status == F_Status_COMPLETE )	// 모션 완료.
					{
						Execute_RTN = F_TRUE;											// 반환값 : TRUE.
						P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_1st_Move) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
		break;

		case N_Act_FR_2nd_Move:			// 파이널 롤러 2차 이동.
			// 0) 모션 상태 초기화.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_2nd_Move) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_EXECUTE;							// 모듈 상태 : 진행 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_FR_2nd_Move) = Sys.Time;				// 시간 업데이트.
				P_Final_Roll_Cathode_Pos_Status = 0;									// 파이널 롤러 모션 상태 초기화.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_2nd_Move) = 1;			// 다음 스텟 머신으로 이동.
			}
			// 1) 모션 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_2nd_Move) == 1 )
			{
				P_Slave5_Motion_Command = N_FR_Cathode_Move_Motion;						// 파이널 롤러 양극 방향 이동 (X:168mm)
				P_Slave15_Motion_Command = N_FR_Cathode_Move_Motion;					// [ 참조 : 2025.10.20 세파 첫장 드라이빙 구동 ]
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_2nd_Move) = 2;			// 다음 스텟 머신으로 이동.
			}
			// 2) 모션 실행 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_2nd_Move) == 2 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_FR_2nd_Move) + P_Execute_1st_Sepa_Time_Out(N_Act_FR_2nd_Move))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Final_Roll_Cathode_Pos_Status == F_Status_COMPLETE )			// 모션 완료.
					{
						Execute_RTN = F_TRUE;											// 반환값 : TRUE.
						P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_2nd_Move) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
		break;

		case N_Act_FR_Down:				// 파이널 롤러 하강.
			// 0) 모션 상태 초기화.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Down) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_EXECUTE;							// 모듈 상태 : 진행 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_FR_Down) = Sys.Time;					// 시간 업데이트.
				P_Final_Roll_Vision_Pos_Status = 0;										// 파이널 롤러 모션 상태 초기화.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Down) = 1;				// 다음 스텟 머신으로 이동.
			}
			// 1) 모션 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Down) == 1 )
			{
				P_Slave5_Motion_Command = N_FR_Stack_Down_Motion;						// 파이널 롤러 촬상 위치 이동 (Z:61.5mm)
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Down) = 2;				// 다음 스텟 머신으로 이동.
			}
			// 2) 모션 실행 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Down) == 2 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_FR_Down) + P_Execute_1st_Sepa_Time_Out(N_Act_FR_Down))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Final_Roll_Vision_Pos_Status == F_Status_COMPLETE )			// 모션 완료.
					{
						Execute_RTN = F_TRUE;											// 반환값 : TRUE.
						P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Down) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
		break;

		case N_Act_Cathode_Clamp_On:	// 양극 클램프 ON.
			// 0) 모션 상태 초기화.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Cathode_Clamp_On) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_EXECUTE;							// 모듈 상태 : 진행 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_Cathode_Clamp_On) = Sys.Time;			// 시간 업데이트.
				P_Cathode_Clamp_ON_Status = 0;											// 양극 클램프 모션 상태 초기화.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_Cathode_Clamp_On) = 1;		// 다음 스텟 머신으로 이동.
			}
			// 1) 모션 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Cathode_Clamp_On) == 1 )
			{
				P_Slave7_Motion_Command = N_Clamp_On_Motion;							// 양극 클램프 ON 이동.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_Cathode_Clamp_On) = 2;		// 다음 스텟 머신으로 이동.
			}
			// 2) 모션 실행 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Cathode_Clamp_On) == 2 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_Cathode_Clamp_On) + P_Execute_1st_Sepa_Time_Out(N_Act_Cathode_Clamp_On))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Cathode_Clamp_ON_Status == F_Status_COMPLETE )				// 모션 완료.
					{
						Execute_RTN = F_TRUE;											// 반환값 : TRUE.
						P_Execute_1st_Sepa_Func_State_Machine(N_Act_Cathode_Clamp_On) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
		break;

		case N_Act_Vision_Check:		// Vision 촬상.
			// 0) 상태 초기화.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_EXECUTE;							// 모듈 상태 : 진행 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_Vision_Check) = Sys.Time;				// 시간 업데이트.
				P_Vision_FirstSepa_Complete = 0;										// Vision 검사 상태 초기화.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) = 1;			// 다음 스텟 머신으로 이동.
			}
			// 1) Vision 모듈 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) == 1 )
			{
				if ( P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence )		// 드라이 런 모드가 아닐 경우.
				{
					P_Vision_FirstSepa_Command = 1;										// Vision 검사 실행.
					P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) = 2;		// 다음 스텟 머신으로 이동.
				}
				else																	// 드라이 런 모드 일 경우.	[ 참조 : 25.07.15 세파 첫장 모듈 수정. ]
					P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
			}
			// 2) Vision 모듈 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) == 2 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_Vision_Check) + P_Execute_1st_Sepa_Time_Out(N_Act_Vision_Check))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Vision_FirstSepa_Complete == 1 )								// Vision 검사 상태 완료.
					{
						P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
			// 3) Complete Step.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_Vision_Check) == N_Complete_Step )
				Execute_RTN = F_TRUE;													// 반환값 : TRUE.
		break;

		case N_Act_FR_Up:				// 파이널 롤러 상승.
			// 0) 모션 상태 초기화.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Up) == 0 )
			{
				P_Execute_1st_Sepa_Status = F_Status_EXECUTE;							// 모듈 상태 : 진행 중.
				P_Execute_1st_Sepa_Old_Time(N_Act_FR_Up) = Sys.Time;					// 시간 업데이트.
				P_Final_Roll_Stack_Up_Pos_Status = 0;									// 파이널 롤러 모션 상태 초기화.
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Up) = 1;					// 다음 스텟 머신으로 이동.
			}
			// 1) 모션 실행.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Up) == 1 )
			{
				P_Slave5_Motion_Command = 6;											// 파이널 롤러 적층 위치 이동 (Z:58mm)
				P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Up) = 2;					// 다음 스텟 머신으로 이동.
			}
			// 2) 모션 실행 확인.
			if ( P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Up) == 2 )
			{
				if ( Sys.Time < P_Execute_1st_Sepa_Old_Time(N_Act_FR_Up) + P_Execute_1st_Sepa_Time_Out(N_Act_FR_Up))	// 제한 시간을 넘기지 않을 경우.
				{
					if ( P_Final_Roll_Stack_Up_Pos_Status == F_Status_COMPLETE )		// 모션 완료.
					{
						Execute_RTN = N_Complete_Step;									// 반환값 : Complete.
						P_Execute_1st_Sepa_Func_State_Machine(N_Act_FR_Up) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
					}
				}
				else																	// 제한 시간을 넘길 경우.
					Execute_RTN = N_Error_Step;											// 반환값 : Error.
			}
		break;

	}

close
