	// 1.1.1) 동작 타입 멤버 정보 업데이트 
	sub:Group_Action_Type_Update( Group, &Result )	 
		switch( Group )
		{// 인자값으로 받아온 Group Index값으로 그룹에 대한 정보를 갱신한다.
			case 1: //Group 1 : 그룹1 배열변수에 담긴 정보를 동작정보 배열변수에 대입. ( 레시피 형태로 변환예정 )
				P_AH_Action_Type(0) = P_Recipe_G1_Action_Type_Type_1(0) 				// 그룹1의 멤버0은 #1// 동작타입 없음 
				P_AH_Action_Type(1) = P_Recipe_G1_Action_Type_Type_1(1) 				// 그룹1의 멤버1은 #2// +회피동작 
				P_AH_Action_Type(2) = P_Recipe_G1_Action_Type_Type_1(2) 				// 그룹1의 멤버2은 #3// -회피동작 
				P_AH_Action_Type(3) = P_Recipe_G1_Action_Type_Type_1(3) 				// 그룹1의 멤버3은 #4// IO On/Off.
				P_AH_Action_Type(4) = P_Recipe_G1_Action_Type_Type_1(4) 				// 그룹1의 멤버4은 #5// 동작타입 없음 
				P_AH_Action_Type(5) = P_Recipe_G1_Action_Type_Type_1(5) 				// 그룹1의 멤버5은 #6// 동작타입 없음 
				P_AH_Action_Type(6) = P_Recipe_G1_Action_Type_Type_1(6) 				// 그룹1의 멤버6은 #7// 동작타입 없음 
				P_AH_Action_Type(7) = P_Recipe_G1_Action_Type_Type_1(7) 				// 그룹1의 멤버7은 #8// 동작타입 없음 
				P_AH_Action_Type(8) = P_Recipe_G1_Action_Type_Type_1(8) 				// 그룹1의 멤버8은 #9// 동작타입 없음 
				P_AH_Action_Type(9) = P_Recipe_G1_Action_Type_Type_1(9) 				// 그룹1의 멤버9은 #10// 동작타입 없음 
				P_AH_Action_Type(10) = P_Recipe_G1_Action_Type_Type_1(10)				// 그룹1의 멤버9는 #11// 동작타입 없음 
				P_AH_Action_Type(11) = P_Recipe_G1_Action_Type_Type_1(11)				// 그룹1의 멤버10는 #12// 동작타입 없음 
