	P_Anode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_AN_Z) - ( P_Recipe_M22_POS(1) - 10 );///10000	
	//↑음극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 음극 2차 PNP Z축 얼라인 상승 레시피 값  
	P_Anode_2nd_PNP_Z_Acos_numerator = ( P_Anode_2nd_PNP_Z_Crank_real_Move_Pos*P_Anode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑음극 2차 PNP Z축 분자값 = (음극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 음극 2차 PNP Crank Z축 반지름^2 - 음극 2차 PNP Crank Z축 빗변 길이^2)
	P_Anode_2nd_PNP_Z_Acos_denominator = 2*P_Anode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑음극 2차 PNP Z축 분모값 = 2*음극 2차 PNP Crank Z축 실제 이동해야하는 위치*음극 2차 PNP Crank Z축 반지름
	P_Anode_2nd_PNP_Z_Crank_radian = acos(P_Anode_2nd_PNP_Z_Acos_numerator/P_Anode_2nd_PNP_Z_Acos_denominator)
	//↑음극 2차 PNP Z축 Crank 라디안 = Acos(음극 2차 PNP Z축 분자값/음극 2차 PNP Z축 분모값)
	P_Anode_2nd_PNP_Z_Crank_Angle = P_Anode_2nd_PNP_Z_Crank_radian*180/PI
	//↑음극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Anode_2nd_Fwd_Bwd_Rise = (P_Anode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_AN_Z));



	//=====================================================================================================================
	//4. 양극 2차 PNP Z축 
	//=====================================================================================================================
	//------------------------------------------------------------------
	//4.1. 양극 2차 PNP Z축 얼라인 상승 위치  
	//------------------------------------------------------------------
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - P_Recipe_M21_POS(2);///10000
	//↑양극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 2차 PNP Z축 얼라인 상승 레시피 값  
	P_Cathode_2nd_PNP_Z_Acos_numerator = ( P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑양극 2차 PNP Z축 분자값 = (양극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 양극 2차 PNP Crank Z축 반지름^2 - 양극 2차 PNP Crank Z축 빗변 길이^2)
	P_Cathode_2nd_PNP_Z_Acos_denominator = 2*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑양극 2차 PNP Z축 분모값 = 2*양극 2차 PNP Crank Z축 실제 이동해야하는 위치*양극 2차 PNP Crank Z축 반지름
	P_Cathode_2nd_PNP_Z_Crank_radian = acos(P_Cathode_2nd_PNP_Z_Acos_numerator/P_Cathode_2nd_PNP_Z_Acos_denominator)
	//↑양극 2차 PNP Z축 Crank 라디안 = Acos(양극 2차 PNP Z축 분자값/양극 2차 PNP Z축 분모값)
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Cathode_2nd_PNP_Z_Crank_radian*180/PI
	//↑양극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Cathode_2nd_Z_Align_Up = (P_Cathode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_CA_Z))
	//↑양극 2차 PNP Z축 얼라인 상승 PMAC Motor Count  = (현재 각도 - Crank Z축 Home 상태 각도) 

	//------------------------------------------------------------------
	//4.2. 양극 2차 PNP Z축 얼라인 하강 위치  
	//------------------------------------------------------------------
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - P_Recipe_M21_POS(3);///10000
	//↑양극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 2차 PNP Z축 얼라인 하강 레시피 값  
	P_Cathode_2nd_PNP_Z_Acos_numerator = ( P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑양극 2차 PNP Z축 분자값 = (양극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 양극 2차 PNP Crank Z축 반지름^2 - 양극 2차 PNP Crank Z축 빗변 길이^2)
	P_Cathode_2nd_PNP_Z_Acos_denominator = 2*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑양극 2차 PNP Z축 분모값 = 2*양극 2차 PNP Crank Z축 실제 이동해야하는 위치*양극 2차 PNP Crank Z축 반지름
	P_Cathode_2nd_PNP_Z_Crank_radian = acos(P_Cathode_2nd_PNP_Z_Acos_numerator/P_Cathode_2nd_PNP_Z_Acos_denominator)
	//↑양극 2차 PNP Z축 Crank 라디안 = Acos(양극 2차 PNP Z축 분자값/양극 2차 PNP Z축 분모값)
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Cathode_2nd_PNP_Z_Crank_radian*180/PI
	//↑양극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Cathode_2nd_Z_Align_Down = (P_Cathode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_CA_Z));
	//↑양극 2차 PNP Z축 얼라인 하강 PMAC Motor Count  = (현재 각도 - Crank Z축 Home 상태 각도)

	//------------------------------------------------------------------
	//4.3. 양극 2차 PNP Z축 Stack 상승 위치  
	//------------------------------------------------------------------
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - P_Recipe_M21_POS(4);///10000
	//↑양극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 2차 PNP Z축 스텍 상승 레시피 값  
	P_Cathode_2nd_PNP_Z_Acos_numerator = ( P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑양극 2차 PNP Z축 분자값 = (양극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 양극 2차 PNP Crank Z축 반지름^2 - 양극 2차 PNP Crank Z축 빗변 길이^2)
	P_Cathode_2nd_PNP_Z_Acos_denominator = 2*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑양극 2차 PNP Z축 분모값 = 2*양극 2차 PNP Crank Z축 실제 이동해야하는 위치*양극 2차 PNP Crank Z축 반지름
	P_Cathode_2nd_PNP_Z_Crank_radian = acos(P_Cathode_2nd_PNP_Z_Acos_numerator/P_Cathode_2nd_PNP_Z_Acos_denominator)
	//↑양극 2차 PNP Z축 Crank 라디안 = Acos(양극 2차 PNP Z축 분자값/양극 2차 PNP Z축 분모값)
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Cathode_2nd_PNP_Z_Crank_radian*180/PI
	//↑양극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Cathode_2nd_Z_Stack_Up = (P_Cathode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_CA_Z));
	//↑양극 2차 PNP Z축 스텍 상승 PMAC Motor Count  = (현재 각도 - Crank Z축 Home 상태 각도)

	//------------------------------------------------------------------
	//4.4. 양극 2차 PNP Z축 Stack 하강 위치  
	//------------------------------------------------------------------
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - P_Recipe_M21_POS(5);///10000	
	//↑양극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 2차 PNP Z축 스텍 하강 레시피 값  
	P_Cathode_2nd_PNP_Z_Acos_numerator = ( P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑양극 2차 PNP Z축 분자값 = (양극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 양극 2차 PNP Crank Z축 반지름^2 - 양극 2차 PNP Crank Z축 빗변 길이^2)
	P_Cathode_2nd_PNP_Z_Acos_denominator = 2*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑양극 2차 PNP Z축 분모값 = 2*양극 2차 PNP Crank Z축 실제 이동해야하는 위치*양극 2차 PNP Crank Z축 반지름
	P_Cathode_2nd_PNP_Z_Crank_radian = acos(P_Cathode_2nd_PNP_Z_Acos_numerator/P_Cathode_2nd_PNP_Z_Acos_denominator)
	//↑양극 2차 PNP Z축 Crank 라디안 = Acos(양극 2차 PNP Z축 분자값/양극 2차 PNP Z축 분모값)
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Cathode_2nd_PNP_Z_Crank_radian*180/PI
	//↑양극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Cathode_2nd_Z_Stack_Down = (P_Cathode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_CA_Z));
	//↑양극 2차 PNP Z축 스텍 하강 PMAC Motor Count  = (현재 각도 - Crank Z축 Home 상태 각도) 
	//------------------------------------------------------------------
	//4.5. 양극 2차 PNP Z축 대기 상승 위치 (Stack 진입 또는 후진)    
	//------------------------------------------------------------------
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - P_Recipe_M21_POS(1);///10000	
	//↑양극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 2차 PNP Z축 대기 상승 레시피 값  
	P_Cathode_2nd_PNP_Z_Acos_numerator = ( P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑양극 2차 PNP Z축 분자값 = (양극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 양극 2차 PNP Crank Z축 반지름^2 - 양극 2차 PNP Crank Z축 빗변 길이^2)
	P_Cathode_2nd_PNP_Z_Acos_denominator = 2*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑양극 2차 PNP Z축 분모값 = 2*양극 2차 PNP Crank Z축 실제 이동해야하는 위치*양극 2차 PNP Crank Z축 반지름
	P_Cathode_2nd_PNP_Z_Crank_radian = acos(P_Cathode_2nd_PNP_Z_Acos_numerator/P_Cathode_2nd_PNP_Z_Acos_denominator)
	//↑양극 2차 PNP Z축 Crank 라디안 = Acos(양극 2차 PNP Z축 분자값/양극 2차 PNP Z축 분모값)
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Cathode_2nd_PNP_Z_Crank_radian*180/PI
	//↑양극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Cathode_2nd_Z_Ready_Up = (P_Cathode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_CA_Z));
	//↑양극 2차 PNP Z축 대기 상승 PMAC Motor Count  = (현재 각도 - Crank Z축 Home 상태 각도) 	


	//------------------------------------------------------------------
	//4.6. 양극 2차 PNP T축 전/후진 시 Z축 상승 위치 
	//------------------------------------------------------------------
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - ( P_Recipe_M21_POS(1) - 10 );///10000
	//↑양극 2차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 2차 PNP Z축 얼라인 상승 레시피 값  
	P_Cathode_2nd_PNP_Z_Acos_numerator = ( P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
	//↑양극 2차 PNP Z축 분자값 = (양극 2차 PNP Crank Z축 실제 이동해야하는 위치^2 + 양극 2차 PNP Crank Z축 반지름^2 - 양극 2차 PNP Crank Z축 빗변 길이^2)
	P_Cathode_2nd_PNP_Z_Acos_denominator = 2*P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos*N_Crank_Radius
	//↑양극 2차 PNP Z축 분모값 = 2*양극 2차 PNP Crank Z축 실제 이동해야하는 위치*양극 2차 PNP Crank Z축 반지름
	P_Cathode_2nd_PNP_Z_Crank_radian = acos(P_Cathode_2nd_PNP_Z_Acos_numerator/P_Cathode_2nd_PNP_Z_Acos_denominator)
	//↑양극 2차 PNP Z축 Crank 라디안 = Acos(양극 2차 PNP Z축 분자값/양극 2차 PNP Z축 분모값)
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Cathode_2nd_PNP_Z_Crank_radian*180/PI
	//↑양극 2차 PNP Z축 Crank 각도 = 라디안*180/π
	P_Cathode_2nd_Fwd_Bwd_Rise = (P_Cathode_2nd_PNP_Z_Crank_Angle - P_Zero_Angle(N_2nd_PnP_CA_Z))

	//rtn = F_TRUE;
	
	return;


	//모터 카운트 → 레시피 값 전환 함수 [참조 : 1,2차 PNP 클랭크 Z축 수식 프로그램 추가 ]
	sub: PNP_Z_Axis_Cnt_to_Recipe(void) 
	//=====================================================================================================================
	//음극 1차 PNP Z축 
	//=====================================================================================================================
	P_Anode_1st_PNP_Z_Crank_Angle = P_Motor_Current_Pos(N_1st_PnP_AN_Z) + P_Zero_Angle(N_1st_PnP_AN_Z);
	//↑음극 1차 PNP Z축 Crank 각도 = 음극 1차 PNP Z축 현재 Motor Count 값 - Crank Z축 Home 상태 각도
	//P_Anode_1st_PNP_Z_Crank_radian = P_Anode_1st_PNP_Z_Crank_Angle*PI/180
	////↑음극 1차 PNP Z축 Crank 각도 = 각도*π/180
	//P_Anode_1st_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * COS(P_Anode_1st_PNP_Z_Crank_radian) + SQRT(N_Crank_Rod*N_Crank_Rod - (N_Crank_Radius*N_Crank_Radius * SIN(P_Anode_1st_PNP_Z_Crank_radian) * SIN(P_Anode_1st_PNP_Z_Crank_radian)))
	//↑음극 1차 PNP Z축 Crank 실제 이동 거리 = 음극 1차 PNP Crank Z축 반지름* Cos(음극 1차 PNP Z축 Crank 라디안) + √(음극 1차 PNP Z축 Crank 빗변 길이^2 - (음극 1차 PNP Z축 Crank 반지름^2 * Sin(음극 1차 PNP Z축 Crank 라디안)^2))

	P_Anode_1st_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * cosd(P_Anode_1st_PNP_Z_Crank_Angle) + sqrt( pow(N_Crank_Rod,2) - ( pow(N_Crank_Radius,2) * pow(sind(P_Anode_1st_PNP_Z_Crank_Angle),2) ));
	P_Anode_1st_PNP_Z_Real_Move_Pos = P_Zero_Length(N_1st_PnP_AN_Z) - P_Anode_1st_PNP_Z_Crank_real_Move_Pos
	//↑음극 1차 PNP Z축 Crank 최종 이동 거리 = 96.03 - 음극 1차 PNP Z축 Crank 실제 이동 거리

	//=====================================================================================================================
	//양극 1차 PNP Z축 
	//===================================================================================================================== 
	P_Cathode_1st_PNP_Z_Crank_Angle = P_Motor_Current_Pos(N_1st_PnP_CA_Z) + P_Zero_Angle(N_1st_PnP_CA_Z);
	//↑양극 1차 PNP Z축 Crank 각도 = 양극 1차 PNP Z축 현재 Motor Count 값 - Crank Z축 Home 상태 각도
	//P_Cathode_1st_PNP_Z_Crank_radian = P_Cathode_1st_PNP_Z_Crank_Angle*PI/180
	////↑양극 1차 PNP Z축 Crank 각도 = 각도*π/180
	//P_Cathode_1st_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * COS(P_Cathode_1st_PNP_Z_Crank_radian) + SQRT(N_Crank_Rod*N_Crank_Rod - (N_Crank_Radius*N_Crank_Radius * SIN(P_Cathode_1st_PNP_Z_Crank_radian) * SIN(P_Cathode_1st_PNP_Z_Crank_radian)))
	////↑양극 1차 PNP Z축 Crank 실제 이동 거리 = 양극 1차 PNP Crank Z축 반지름* Cos(양극 1차 PNP Z축 Crank 라디안) + √(양극 1차 PNP Z축 Crank 빗변 길이^2 - (양극 1차 PNP Z축 Crank 반지름^2 * Sin(양극 1차 PNP Z축 Crank 라디안)^2))
	
	P_Cathode_1st_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * cosd(P_Cathode_1st_PNP_Z_Crank_Angle) + sqrt( pow(N_Crank_Rod,2) - ( pow(N_Crank_Radius,2) * pow(sind(P_Cathode_1st_PNP_Z_Crank_Angle),2) ));
	P_Cathode_1st_PNP_Z_Real_Move_Pos = P_Zero_Length(N_1st_PnP_CA_Z) - P_Cathode_1st_PNP_Z_Crank_real_Move_Pos
	//↑양극 1차 PNP Z축 Crank 최종 이동 거리 = 96.03 - 양극 1차 PNP Z축 Crank 실제 이동 거리

	//=====================================================================================================================
	//음극 2차 PNP Z축 
	//=====================================================================================================================
	P_Anode_2nd_PNP_Z_Crank_Angle = P_Motor_Current_Pos(N_2nd_PnP_AN_Z) + P_Zero_Angle(N_2nd_PnP_AN_Z);
	//↑음극 2차 PNP Z축 Crank 각도 = 음극 2차 PNP Z축 현재 Motor Count 값 - Crank Z축 Home 상태 각도
	//P_Anode_2nd_PNP_Z_Crank_radian = P_Anode_2nd_PNP_Z_Crank_Angle*PI/180
	////↑음극 2차 PNP Z축 Crank 각도 = 각도*π/180
	//P_Anode_2nd_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * COS(P_Anode_2nd_PNP_Z_Crank_radian) + SQRT(N_Crank_Rod*N_Crank_Rod - (N_Crank_Radius*N_Crank_Radius * SIN(P_Anode_2nd_PNP_Z_Crank_radian) * SIN(P_Anode_2nd_PNP_Z_Crank_radian)))
	////↑음극 2차 PNP Z축 Crank 실제 이동 거리 = 음극 2차 PNP Crank Z축 반지름* Cos(음극 2차 PNP Z축 Crank 라디안) + √(음극 2차 PNP Z축 Crank 빗변 길이^2 - (음극 2차 PNP Z축 Crank 반지름^2 * Sin(음극 2차 PNP Z축 Crank 라디안)^2))
	
	P_Anode_2nd_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * cosd(P_Anode_2nd_PNP_Z_Crank_Angle) + sqrt( pow(N_Crank_Rod,2) - ( pow(N_Crank_Radius,2) * pow(sind(P_Anode_2nd_PNP_Z_Crank_Angle),2) ));
	P_Anode_2nd_PNP_Z_Real_Move_Pos = P_Zero_Length(N_2nd_PnP_AN_Z) - P_Anode_2nd_PNP_Z_Crank_real_Move_Pos
	//↑음극 2차 PNP Z축 Crank 최종 이동 거리 = 96.03 - 음극 2차 PNP Z축 Crank 실제 이동 거리

	//=====================================================================================================================
	//양극 2차 PNP Z축 
	//===================================================================================================================== 
	P_Cathode_2nd_PNP_Z_Crank_Angle = P_Motor_Current_Pos(N_2nd_PnP_CA_Z) + P_Zero_Angle(N_2nd_PnP_CA_Z);
	//↑양극 2차 PNP Z축 Crank 각도 = 양극 2차 PNP Z축 현재 Motor Count 값 - Crank Z축 Home 상태 각도
	//P_Cathode_2nd_PNP_Z_Crank_radian = P_Cathode_2nd_PNP_Z_Crank_Angle*PI/180
	////↑양극 2차 PNP Z축 Crank 각도 = 각도*π/180
	//P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * COS(P_Cathode_2nd_PNP_Z_Crank_radian) + SQRT(N_Crank_Rod*N_Crank_Rod - (N_Crank_Radius*N_Crank_Radius * SIN(P_Cathode_2nd_PNP_Z_Crank_radian) * SIN(P_Cathode_2nd_PNP_Z_Crank_radian)))
	////↑양극 2차 PNP Z축 Crank 실제 이동 거리 = 양극 2차 PNP Crank Z축 반지름* Cos(양극 2차 PNP Z축 Crank 라디안) + √(양극 2차 PNP Z축 Crank 빗변 길이^2 - (양극 2차 PNP Z축 Crank 반지름^2 * Sin(양극 2차 PNP Z축 Crank 라디안)^2))
	
	P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos = N_Crank_Radius * cosd(P_Cathode_2nd_PNP_Z_Crank_Angle) + sqrt( pow(N_Crank_Rod,2) - ( pow(N_Crank_Radius,2) * pow(sind(P_Cathode_2nd_PNP_Z_Crank_Angle),2) ));
	P_Cathode_2nd_PNP_Z_Real_Move_Pos = P_Zero_Length(N_2nd_PnP_CA_Z) - P_Cathode_2nd_PNP_Z_Crank_real_Move_Pos
	//↑양극 2차 PNP Z축 Crank 최종 이동 거리 = 96.03 - 양극 2차 PNP Z축 Crank 실제 이동 거리

	// [참조 : 260428 2차 PNP 얼라인 하강 중 미리 얼라인 블로우 실행]
	if( P_Anode_Align_Blow == 1 )
	{
		if( P_Recipe_M22_POS(2) <= P_Recipe_M22_POS(6) && P_Recipe_M22_POS(6) <= P_Recipe_M22_POS(3) )	// 2차 PNP 얼라인 테이블 블로우 레시피 값이 얼라인 상승보다 크고 얼라인 하강보다 작을 경우.	[ 참조 : 26.05.08 2차 PNP 레시피 값에 따른 얼라인 블로우 타이밍 인터락 ]
		{
			if( P_Anode_2nd_PNP_Z_Real_Move_Pos > P_Recipe_M22_POS(6) )
			{
				M_Y_Anode_AT_Vac_Ejector_Vac_On = 0;			
				M_Y_Anode_AT_Vac_Ejector_Vac_Off = 1;	
				P_Anode_Align_Blow = 0
			}
		}
		else							// 2차 PNP 얼라인 테이블 블로우 레시피 값이 얼라인 상승보다 작거나 얼라인 하강보다 클 경우.
		{
			P_Anode_Align_Blow = 0		// 미동작.
		}
	}
	
	// [참조 : 260428 2차 PNP 얼라인 하강 중 미리 얼라인 블로우 실행]
	if( P_Cathode_Align_Blow == 1 )
	{
		if( P_Recipe_M21_POS(2) <= P_Recipe_M21_POS(6) && P_Recipe_M21_POS(6) <= P_Recipe_M21_POS(3) )	// 2차 PNP 얼라인 테이블 블로우 레시피 값이 얼라인 상승보다 크고 얼라인 하강보다 작을 경우.	[ 참조 : 26.05.08 2차 PNP 레시피 값에 따른 얼라인 블로우 타이밍 인터락 ]
		{
			if( P_Cathode_2nd_PNP_Z_Real_Move_Pos > P_Recipe_M21_POS(6) )
			{
				M_Y_Cathode_AT_Vac_Ejector_Vac_On  = 0; 
				M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 1;
				P_Cathode_Align_Blow = 0
			}
		}
		else							// 2차 PNP 얼라인 테이블 블로우 레시피 값이 얼라인 상승보다 작거나 얼라인 하강보다 클 경우.
		{
			P_Cathode_Align_Blow = 0	// 미동작.
		}
	}

	return;
	
	
sub: Crank_Z_Pos_Init(angle,&rnt_Pos)

if( angle < 0 || angle > 180 )	// ERROR
	rnt_Pos = 0;	// ERROR 처리?
else // rnt_Pos = P_Zero_Length(L_pnpZ_Num)
	rnt_Pos = N_Crank_Radius * cosd(angle) + sqrt( pow(N_Crank_Rod,2) - ( pow(N_Crank_Radius,2) * pow(sind(angle),2)) );
return;

sub: pnp_Z_Home_offset(unit,offset)
// 17,18,21,22모터만 사용하는데 안쓰는 P변수 배열을 선언하기 싫어서 선언
local L_unit = 0;	

switch( unit )
{
	case N_1st_PnP_CA_Z:	L_unit = 1;	break;
	case N_1st_PnP_AN_Z:	L_unit = 2;	break;
	case N_2nd_PnP_CA_Z:	L_unit = 3;	break;
	case N_2nd_PnP_AN_Z:	L_unit = 4;	break;
}

	P_Cal_Distance(L_unit) = N_Deg90_Length - offset/1000;
	P_Cal_Denominator(L_unit) = pow(P_Cal_Distance(L_unit),2) + pow(N_Crank_Radius,2) - pow(N_Crank_Rod,2);
	P_Cal_Numerator(L_unit) = 2 * P_Cal_Distance(L_unit) * N_Crank_Radius;
	P_Cal_Dif_Deg(L_unit) = (acosd(P_Cal_Denominator(L_unit) / P_Cal_Numerator(L_unit))) - N_Deg90;
	Motor[unit].HomeOffset = P_Cal_Dif_Deg(L_unit)*1000;	// HomeOffset
	//rtn = N_Deg90 + P_Cal_Dif_Deg(unit);			// Minus 상승 Plus 하강
		
return;

sub: PV_PnP_Z_mm_Cal(unit,input,&output)

local L_angle = 0;
local L_angle_pos = 0;

L_angle = input + P_Zero_Angle(unit);
L_angle_pos = N_Crank_Radius * cosd(L_angle) + sqrt( pow(N_Crank_Rod,2) - ( pow(N_Crank_Radius,2) * pow(sind(L_angle),2) ));
output = P_Zero_Length(unit) - L_angle_pos;

return;

close
