// 알람변수정의 추가 - [ 참조 : 2025.08.26 알람변수정의 추가 ]
#define N_Alarm_None					0
#define N_High_Alarm_Emergency_Stop     1  // 중알람 즉시 정지
#define N_High_Alarm_Cycle_Stop         2  // 중알람 사이클 정지
#define N_Low_Alarm                     3  // 경알람 경고

// 알람 테스트 용 변수 선언
