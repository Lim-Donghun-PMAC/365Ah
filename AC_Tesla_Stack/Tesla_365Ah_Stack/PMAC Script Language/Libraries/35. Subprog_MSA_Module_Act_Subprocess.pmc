	}
	else if( Mode == N_MSA_Cathode_Align )				// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave18_Motion_Command = 6;																					//양극 2차 PNP 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																						//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Up_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Up_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z)  > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um )  // 음극 2차 PNP 스텍 상승 위치 확인
		{
			if( Motor[N_2nd_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 								// 음극 2차 PNP 속도 0 확인
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Up_Move) = N_Complete_Step;						// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um )  // 양극 2차 PNP 스텍 상승 위치 확인
		{
			if( Motor[N_2nd_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 								// 양극 2차 PNP 속도 0 확인
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Up_Move) = N_Complete_Step;						// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Up_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_2nd_Align_Up_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

//=========================================================
//10. 얼라인 MSA 파이널롤러 이동
//=========================================================
sub: MSA_Align_FinalRoll_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) == N_Ready_Step )										//얼라인 MSA 파이널롤러 이동 ready step
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave5_Motion_Command = 2;																					// 음극 2차 PNP Stack 이동 예정으로 양극 방향 이동
		P_MSA_Chk_Pos_Timer = 0;																						//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave5_Motion_Command = 1;																					// 양극 2차 PNP Stack 이동 예정으로 음극 방향 이동
		P_MSA_Chk_Pos_Timer = 0;																						//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )         	// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Final_Roll_X_Cathode_Move - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Final_Roll_X_Cathode_Move + P_Motor_Ready_Pos_Inpos_200um ) // 파이널롤러 양극 위치 이동 확인 
		{
			if( Motor[N_FINAL_ROLL_X].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > 250 ) 														// 파이널롤러 속도 0 확인 
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}
		}
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 걍으
	{																														
		if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Final_Roll_X_Anode_Move - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Final_Roll_X_Anode_Move + P_Motor_Ready_Pos_Inpos_200um )			// 파이널롤러 음극 위치 이동 확인 
		{
			if( Motor[N_FINAL_ROLL_X].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > 250 ) 													  // 파이널롤러 속도 0 확인 
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}	
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_FinalRoll_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_FinalRoll_Move) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//11. 얼라인 MSA 2차 PNP 스텍 이동
//=========================================================
sub: MSA_2nd_PNP_Stack_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) == N_Ready_Step )										//얼라인 MSA 2차 PNP 스텍 이동 ready step		
{
	if( Mode == N_MSA_Anode_Align )		      // 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Current_MSA_Run_Num(F_Anode_Align_MSA) == 0)																	// 음극 얼라인 MSA 첫번째 동작 시
		{
			P_Slave3_Motion_Command = 1;																				//음극 2차 PNP T축 Align -> Stack 이동 모션 커멘드
			P_MSA_Chk_Pos_Timer = 0;																					//체크 타이머 초기화
		}
		//음극 얼라인 x축 원점 이동.
		Motor[39].jogSpeed = 10 ;																						// 모터 조그 스피드 입력
		Motor[39].ProgJogPos = 0; 																						// 모터 정위치 입력
		   
		Ldata.motor = 39;  																								// 모터 번호 선택
		jog=*;																											// 절대 위치 이동 명령																	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		 // 양극 얼라인 MSA 모드일 경우 
	{
		if ( P_Current_MSA_Run_Num(F_Cathode_Align_MSA) == 0 )																// 양극 얼라인 MSA 첫번째 동작 시
		{
			P_Slave8_Motion_Command = 1;																				// 양극 2차 PNP T축 Align -> Stack 이동 모션 커멘드
			P_MSA_Chk_Pos_Timer = 0;																					//체크 타이머 초기화		
		}																													
		// 양극 얼라인 x축 원점 이동.
		Motor[36].jogSpeed = 10 ;																						// 모터 조그 스피드 입력
		Motor[36].ProgJogPos = 0; 																						// 모터 정위치 입력
		   
		Ldata.motor = 36;  																								// 모터 번호 선택
		jog=*;																											// 절대 위치 이동 명령		
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우 
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 2차 PNP Stack 위치 확인		
		{
			if( Motor[N_2nd_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													//음극 2차 PNP 속도 0 확인																			
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 2차 PNP Stack 위치 확인
		{
			if( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													 // 양극 2차 PNP Stack 속도 0 확인																					
			{																										
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) = N_Complete_Step;								 // 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Stack_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_2nd_Stack_Move) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//12. 얼라인 MSA 1차 Belt->얼라인 이동 & 1차 PNP 피커 회전(첫번째 동작 시에만)
//=========================================================
sub: MSA_1st_PNP_Align_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) == N_Ready_Step )											//얼라인 MSA 1차 Belt->얼라인 이동 & 1차 PNP 피커 회전 ready step		
{	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우 
	{
		if ( P_Current_MSA_Run_Num(F_Anode_Align_MSA) == 0)																		// 음극 얼라인 MSA 첫번째 동작 시
		{
			P_Slave2_Motion_Command = 1;																					// 음극 1차 PNP 피커 T축 180도 회전 							
			P_MSA_Chk_Pos_Timer = 0;																						//체크 타이머 초기화																				
		}
		P_Slave1_Motion_Command = 1;																						// 음극 1차 PNP 얼라인 위치 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{
		if ( P_Current_MSA_Run_Num(F_Cathode_Align_MSA) == 0)																	// 양극 얼라인 MSA 첫번째 동작 시
		{
			P_Slave9_Motion_Command = 1;																					// 양극 1차 PNP 피커 T축 180도 회전 	
			P_MSA_Chk_Pos_Timer = 0;																						//체크 타이머 초기화																				
		}
		P_Slave10_Motion_Command = 1;																						// 양극 1차 PNP 얼라인 위치 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우 
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 1차 PNP 얼라인 위치 확인
		{
			if( Motor[N_1st_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 음극 1차 PNP 속도 0 확인																							
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_T) < 90 + P_Motor_Ready_Pos_Inpos_200um )  // 양극 1차 PNP 얼라인 위치 확인
		{
			if( Motor[N_1st_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 양극 1차 PNP 속도 0 확인																						 
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Align_Move) = 1;														// 동작 완료 Bit On.
	rtn = N_COMPLETE;																											// 반환값 : COMPLETE
}
return;

//=========================================================
//13. 얼라인 MSA 1차 얼라인 하강
//=========================================================
sub: MSA_1st_PNP_Align_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) == N_Ready_Step )										//얼라인 MSA 1차 얼라인 하강 Ready Step 
{
	if( Mode == N_MSA_Anode_Align )				 // 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave16_Motion_Command = 3;																						// 음극 1차 PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave19_Motion_Command = 3;																						// 양극 1차 PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 1차 얼라인 하강 확인		
		{
			if( Motor[N_1st_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 음극 1차 PNP 속도 0 확인																						  
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	   // 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 1차 얼라인 하강 확인	
		{
			if( Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 양극 1차 PNP 속도 0 확인																						
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Align_Down_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//14. 얼라인 MSA 1차 얼라인 파기 
//=========================================================
sub: MSA_1st_PNP_Align_Blow_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) == N_Ready_Step )										//얼라인 MSA 1차 얼라인 파기 Ready Step
{
	if( Mode == N_MSA_Anode_Align )				 // 음극 얼라인 MSA 모드일 경우
	{
		P_Slave16_Motion_Command = 12;																						//음극 1차 PNP 얼라인 파기 커멘드
		P_MSA_Chk_Pos_Timer=0;																								//체크 타이머 초기화
		//M_Y_Anode_1st_Vac_Sol_On = 0; 																					
		//M_Y_Anode_1st_Vac_Sol_Off = 1;

		//M_Y_Anode_1st_Vac_Sol_On = 0;     
		//M_Y_Anode_1st_Vac_Sol_Off = 1;    
		//M_Y_Anode_1st_Release_Sol_On = 1; 
		//M_Y_Anode_1st_Release_Sol_Off = 0;

		//M_Y_Anode_AT_Vac_Ejector_Vac_On = 1;																			
		//M_Y_Anode_AT_Vac_Ejector_Vac_Off = 0;
		//M_X_Anode_AT_Vac_Sensor = 1; //임시
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave19_Motion_Command = 12;																						//양극 1차 PNP 얼라인 파기 커멘드
		P_MSA_Chk_Pos_Timer= 0;																								//체크 타이머 초기화
		//M_Y_Cathode_1st_Vac_Sol_On = 0; 																				
		//M_Y_Cathode_1st_Vac_Sol_Off = 1; 

		//M_Y_Cathode_1st_Vac_Sol_On = 0;	
		//M_Y_Cathode_1st_Vac_Sol_Off = 1;    
		//M_Y_Cathode_1st_Release_Sol_On = 1; 
		//M_Y_Cathode_1st_Release_Sol_Off = 0;

		//M_Y_Cathode_AT_Vac_Ejector_Vac_On = 1;																				
		//M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 0;
		//M_X_Cathode_AT_Vac_Sensor = 1 //임시
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우
	{
		if ( M_X_Anode_1st_PNP_Vac_Sensor == 0 && M_X_Anode_AT_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )		// 음극 얼라인 흡착 확인 
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) = N_Complete_Step;										// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( M_X_Cathode_1st_PNP_Vac_Sensor == 0 && M_X_Cathode_AT_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )   	// 양극 얼라인 흡착 확인 
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) = N_Complete_Step;										// 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Blow_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Align_Blow_ON) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//15. 얼라인 MSA 1차 얼라인 비전 촬상
//=========================================================
sub: MSA_Align_VISION_Trigger_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) == N_Ready_Step )											//얼라인 MSA 1차 얼라인 비전 촬상 Ready Step
{
	if( Mode == N_MSA_Anode_Align )		     // 음극 얼라인 MSA 모드일 경우
	{
		M_Y_VisioN_Align_AN_Trigger = 1; 																				// 음극 얼라인 비전 트리거 ON
		P_Vision_Align_Trigger_Timer = 0;																					//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{
		M_Y_VisioN_Align_CA_Trigger = 1;  																				// 양극 얼라인 비전 트리거 ON
		P_Vision_Align_Trigger_Timer = 0;																					//체크 타이머 초기화																					// 양극 얼라인 비전 트리거 ON
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		if( P_Vision_Align_Trigger_Timer > P_Vision_Align_Trigger_Time )													// 음극 얼라인 비전 촬상 트리거 1000ms 후 OFF
		{
			M_Y_VisioN_Align_AN_Trigger = 0; 																			// 음극 얼라인 비전 촬상 트리거 Off	
			P_Vision_Align_Trigger_Timer = 0;																				// 촬상 트리거 타이머 초기화 
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{																														
		if( P_Vision_Align_Trigger_Timer > P_Vision_Align_Trigger_Time )													// 양극 얼라인 비전 촬상 트리거 1000ms 후 OFF
		{
			M_Y_VisioN_Align_CA_Trigger = 0; 																			// 양극 얼라인 비전 촬상 트리거 O
			P_Vision_Align_Trigger_Timer = 0;																				// 촬상 트리거 타이머 초기화 
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
		}																													
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Vision_Trg_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Vision_Trg_ON) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//16. 얼라인 MSA 1차 얼라인 흡착
//=========================================================
sub: MSA_Align_1st_Align_Vacume_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) == N_Ready_Step )										// 얼라인 MSA 1차 얼라인 흡착 Ready Step
{
	if( Mode == N_MSA_Anode_Align )			 // 음극 얼라인 MSA 모드일 경우
	{
		P_Slave16_Motion_Command = 14;																						// 음극 1차 PNP 얼라인 흡착 커멘드											
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		//M_Y_Anode_AT_Vac_Ejector_Vac_On = 0;																																				
		//M_Y_Anode_AT_Vac_Ejector_Vac_Off = 1; 

		//M_Y_Anode_1st_Vac_Sol_On = 1;     
		//M_Y_Anode_1st_Vac_Sol_Off = 0;    
		//M_Y_Anode_1st_Release_Sol_On = 0; 
		//M_Y_Anode_1st_Release_Sol_Off = 1;		
																																																														
		//M_Y_Anode_1st_Vac_Sol_On = 1;	
		//M_Y_Anode_1st_Vac_Sol_Off = 0;	
		//M_X_Anode_1st_PNP_Vac_Sensor = 1; //임시																			
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave19_Motion_Command = 14;																						// 양극 1차 PNP 얼라인 흡착 커멘드				
		P_MSA_Chk_Pos_Timer= 0;																								//체크 타이머 초기화
		//M_Y_Cathode_AT_Vac_Ejector_Vac_On = 0;																			
		//M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 1; 																																																
		//M_Y_Cathode_1st_Vac_Sol_On = 1;
		//M_Y_Cathode_1st_Vac_Sol_Off = 0;	

		//M_Y_Cathode_1st_Vac_Sol_On = 1;	
		//M_Y_Cathode_1st_Vac_Sol_Off = 0;    
		//M_Y_Cathode_1st_Release_Sol_On = 0; 
		//M_Y_Cathode_1st_Release_Sol_Off = 1;
			
		//M_X_Cathode_1st_PNP_Vac_Sensor = 1;//임시																	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		if ( M_X_Anode_1st_PNP_Vac_Sensor == 1 && M_X_Anode_AT_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time) 	//음극 1차 PNP 흡착 입력 신호 확인																	
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( M_X_Cathode_1st_PNP_Vac_Sensor == 1 && M_X_Cathode_AT_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time) //양극 1차 PNP 흡착 입력 신호 확인																	
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) = N_Complete_Step;								  // 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Vacume_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Align_Vacume_ON) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//17. 얼라인 MSA 1차 PNP Z축 얼라인 상승
//=========================================================
sub: MSA_1st_PNP_Align_Up_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) == N_Ready_Step )										//얼라인 MSA 1차 PNP Z축 얼라인 상승 Ready Step
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave16_Motion_Command = 4;																						//음극 1차 PNP Z축 얼라인 상승 모션 커멘드		
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave19_Motion_Command = 4;																						//양극 1차 PNP Z축 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 1차 Z축 얼라인 상승 위치 확인	
		{
			if( Motor[N_1st_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 1차 Z축 속도 0 확인																								
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{																														
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 1차 Z축 얼라인 상승 위치 확인
		{
			if( Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 1차 Z축 속도 0 확인																							
			{																										
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Align_Up_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Align_Up_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

//=========================================================
//18. 얼라인 MSA 1차 PNP 얼라인 -> 벨트 이동 
//=========================================================
sub: MSA_1st_PNP_Belt_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) == N_Ready_Step )											//얼라인 MSA 1차 PNP 얼라인 -> 벨트 이동 Ready Step
{
	if( Mode == N_MSA_Anode_Align )						// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave1_Motion_Command = 2;																						// 음극 1차 PNP Align -> Belt 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )				// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave10_Motion_Command = 2;																						// 양극 1차 PNP Align -> Belt 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우
	{
		if (P_Motor_Current_Pos(N_1st_PnP_AN_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_T) < 0 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 1차 PNP 벨트 위치 확인	
		{
			if( Motor[N_1st_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 1차 PNP 속도 0 확인 																						
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우 
	{																											
		if (P_Motor_Current_Pos(N_1st_PnP_CA_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_T)  < 0 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 1차 PNP 벨트 위치 확인	
		{
			if( Motor[N_1st_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 양극 1차 PNP 속도 0 확인 																								
			{																							
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Blet_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Blet_Move) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

//=========================================================
//19. 얼라인 MSA 카운트 
//=========================================================
sub: MSA_Align_MSA_Move_Cnt(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) == N_Ready_Step )											//얼라인 MSA 카운트  Ready Step
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		P_Current_MSA_Run_Num(F_Anode_Align_MSA)++;																				// 현재 진행한 횟수 증가
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) = 1;														// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{
		P_Current_MSA_Run_Num(F_Cathode_Align_MSA)++;																			// 현재 진행한 횟수 증가
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) = 1;														// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		if(  P_Current_MSA_Run_Num(F_Anode_Align_MSA) < P_MSA_Run_Repeat_Num(F_Anode_Align_MSA) )											// 음극 얼라인 MSA Total 횟수 미달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) = N_Not_Complete_Step;								// 반환값 : Not COMPLETE
		}
		else if(  P_Current_MSA_Run_Num(F_Anode_Align_MSA) == P_MSA_Run_Repeat_Num(F_Anode_Align_MSA) )									// 음극 얼라인 MSA Total 횟수 도달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) = N_Complete_Step;									// 반환값 : COMPLETE
		}																													
	}		
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{	
		if(  P_Current_MSA_Run_Num(F_Cathode_Align_MSA) < P_MSA_Run_Repeat_Num(F_Cathode_Align_MSA) )										// 양극 얼라인 MSA Total 횟수 미달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) = N_Not_Complete_Step;								// 반환값 : Not COMPLETE
		}
		else if(  P_Current_MSA_Run_Num(F_Cathode_Align_MSA) == P_MSA_Run_Repeat_Num(F_Cathode_Align_MSA) )								// 양극 얼라인 MSA Total 횟수 도달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) = N_Complete_Step;									// 반환값 : COMPLETE
		}
	}
}
if (P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) == N_Not_Complete_Step)										// 얼라인 MSA Total 횟수 미달 경우	
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_MSA_Move_Cnt) = 2;													// Complete Bit 2 
	rtn = N_COMPLETE;	
}
else if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_MSA_Move_Cnt) == N_Complete_Step)										// 얼라인 MSA Total 횟수 도달했을 경우
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_MSA_Move_Cnt) = 1;													// Complete Bit 1
	rtn = N_COMPLETE;	
}
return;

//MSA 횟수 도달 시 진입
//=========================================================
//20. Align MSA 1차 PNP 벨트->얼라인 이동 ( MSA 완료 ) 
//=========================================================
sub: MSA_Align_Discharge_1st_Align_Move(Mode,&rtn)													
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) == N_Ready_Step )								//Align MSA 1차 벨트->얼라인 이동 Ready Step
{	
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave1_Motion_Command = 1;																						// 음극 1차 PNP 얼라인 위치 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 변수 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave10_Motion_Command = 1;																						// 양극 1차 PNP 얼라인 위치 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							//체크 타이머 변수 초기화	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_T) < 90 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 1차 PNP 얼라인 위치 확인	
		{
			if( Motor[N_1st_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 음극 1차 PNP 속도 0 확인																				
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{																														
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_T) < 90 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 1차 PNP 얼라인 위치 확인	
		{
			if( Motor[N_1st_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 음극 1차 PNP 속도 0 확인																						
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_1st_Align_Move) = 1;														// 동작 완료 Bit On.
	rtn = N_COMPLETE;																														// 반환값 : COMPLETE
}
return;

//=========================================================
//21. Align MSA 1차 PNP 얼라인 하강 (MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_1st_Align_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) == N_Ready_Step )										// Align MSA 1차 얼라인 하강 Ready Step
{
	if( Mode == N_MSA_Anode_Align )						// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave16_Motion_Command = 3;																									// 음극 1차 PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )				// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave19_Motion_Command = 3;																									// 양극 1차 PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )						// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um )	//음극 1차 PNP 얼라인 하강 확인
		{
			if( Motor[N_1st_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 												// 음극 1차 PNP 속도 0 확인 																							
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우 																					
	{																														
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) //양극 1차 PNP 얼라인 하강 확인
		{
			if( Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 												// 양극 1차 PNP 속도 0 확인 																								
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_1st_Align_Down_Move) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																													// 반환값 : COMPLETE
}
return;

//=========================================================
//22. 얼라인 MSA 1차 PNP 얼라인 파기 (MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_1st_Align_Blow_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) == N_Ready_Step )											//얼라인 MSA 1차 얼라인 파기 Ready Step 
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave16_Motion_Command = 12;																									//음극 1차 PNP 얼라인 파기 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 																									
		//M_Y_Anode_1st_Vac_Sol_On = 0; 																					
		//M_Y_Anode_1st_Vac_Sol_Off = 1;

		//M_Y_Anode_1st_Vac_Sol_On = 0;     
		//M_Y_Anode_1st_Vac_Sol_Off = 1;    
		//M_Y_Anode_1st_Release_Sol_On = 1; 
		//M_Y_Anode_1st_Release_Sol_Off = 0;

		//M_Y_Anode_AT_Vac_Ejector_Vac_On = 1;																				
		//M_Y_Anode_AT_Vac_Ejector_Vac_Off = 0;
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		  // 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave19_Motion_Command = 12;																									//양극 1차 PNP 얼라인 파기 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
		//M_Y_Cathode_1st_Vac_Sol_On = 0; 																							
		//M_Y_Cathode_1st_Vac_Sol_Off = 1; 

		//M_Y_Cathode_1st_Vac_Sol_On = 0;	
		//M_Y_Cathode_1st_Vac_Sol_Off = 1;    
		//M_Y_Cathode_1st_Release_Sol_On = 1; 
		//M_Y_Cathode_1st_Release_Sol_Off = 0;

		//M_Y_Cathode_AT_Vac_Ejector_Vac_On = 1;																						
		//M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 0;
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우 
	{
		if ( M_X_Anode_1st_PNP_Vac_Sensor == 0 && M_X_Anode_AT_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time) 			// 1차 PNP 입력 신호 OFF 및 음극 얼라인 테이블 흡착 확인												
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{																														
		if (M_X_Cathode_1st_PNP_Vac_Sensor == 0 && M_X_Cathode_AT_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time)   		// 1차 PNP 입력 신호 OFF 및 음극 얼라인 테이블 흡착 확인		
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Blow_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_1st_Align_Blow_ON) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//23. 얼라인 MSA 1차 PNP 얼라인 상승 (MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_1st_Align_Up_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) == N_Ready_Step )								//얼라인 MSA 1차 PNP 얼라인 상승 Ready Step
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave16_Motion_Command = 4;																						//음극 1차 PNP 얼라인 상승 모션 커멘드		
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화 												
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) = 1;										// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave19_Motion_Command = 4;																						//양극 1차 PNP 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) = 1;										// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우 
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 1차 얼라인 상승 위치 확인		
		{
			if( Motor[N_1st_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 									// 음극 1차 PNP Z축 속도 0 확인 																						
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) = N_Complete_Step;				// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{																														
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 1차 얼라인 상승 위치 확인	
		{
			if( Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 									// 양극 1차 PNP Z축 속도 0 확인 																					
			{																										
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) = N_Complete_Step;				// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_Up_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_1st_Align_Up_Move) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//24. 얼라인 MSA 1차 PNP 얼라인 -> 대기위치 이동(MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_1st_Align_to_Init_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) == N_Ready_Step )
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave1_Motion_Command = 9;																						// 음극 1차 PNP Align -> 대기 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave10_Motion_Command = 9;																						// 양극 1차 PNP Align -> 대기 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화			
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				  // 음극 얼라인 MSA 모드일 경우 
	{
		if (P_Motor_Current_Pos(N_1st_PnP_AN_T) > 45 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_T) < 45 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 1차 대기 위치 확인 
		{
			if( Motor[N_1st_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 음극 1차 PNP T축 속도 0 확인																							
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{																											
		if (P_Motor_Current_Pos(N_1st_PnP_CA_T) > 45 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_T)  < 45 + P_Motor_Ready_Pos_Inpos_200um )   // 양극 1차 대기 위치 확인 
		{
			if( Motor[N_1st_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 														// 양극 1차 PNP T축 속도 0 확인																									
			{																							
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.	
			}
		}		
	}		
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_1st_Align_to_Init_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_1st_Align_to_Init_Move) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																														// 반환값 : COMPLETE
}
return;

#ifdef F_MSA_Discharge_Use
//↓ MSA배출 모드 사용 시
//=========================================================
//25. NG PNP 대기-> 얼라인 이동 ( MSA 완료 ) 
//=========================================================
sub: MSA_Align_Discharge_NG_PNP_Align_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) == N_Ready_Step )
{	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave13_Motion_Command = 2;																									// 음극 NG PNP 얼라인 위치 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave12_Motion_Command = 2;																									// 양극 NG PNP 얼라인 위치 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_NG_PnP_AN_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_NG_PnP_AN_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 NG PNP 얼라인 위치 확인 
		{
			if( Motor[N_NG_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 음극 NG PNP T축 속도 0 확인																					
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.	
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_NG_PnP_CA_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_NG_PnP_CA_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 NG PNP 얼라인 위치 확인 
		{
			if( Motor[N_NG_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 양극 NG PNP T축 속도 0 확인																											
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.	
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_NG_PNP_Align_Move) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																														// 반환값 : COMPLETE
}
return;


//=========================================================
//26. Align MSA NG PNP 얼라인 하강 (MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_NG_PNP_Align_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) == N_Ready_Step )									//Align MSA NG PNP 얼라인 하강 Ready Step
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave13_Motion_Command = 4;																									// 음극 NG PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave12_Motion_Command = 4;																									// 양극 NG PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )																										// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_NG_PnP_AN_Z) > 25 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_NG_PnP_AN_Z) < 25 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 NG PNP 얼라인 하강 확인 
		{
			if( Motor[N_NG_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 음극 NG PNP T축 속도 0 확인																						
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.	
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )																								// 양극 얼라인 MSA 모드일 경우 
	{																														
		if ( P_Motor_Current_Pos(N_NG_PnP_CA_Z) > 25 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_NG_PnP_CA_Z) < 25 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 NG PNP 얼라인 하강 확인 
		{
			if( Motor[N_NG_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 												// 음극 NG PNP T축 속도 0 확인																								
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) = N_Complete_Step;						// 다음 스텟 머신으로 이동.	
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_NG_PNP_Align_Down_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																													// 반환값 : COMPLETE
}
return;


//=========================================================
//27. Align MSA NG PNP 얼라인 흡착 (MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_NG_PNP_Vacume_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) == N_Ready_Step )											//Align MSA NG PNP 얼라인 흡착 Ready Step 
{
	if( Mode == N_MSA_Anode_Align )					// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave13_Motion_Command = 7;																									// 음극 NG PNP 얼라인 흡착 커멘드 													
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
