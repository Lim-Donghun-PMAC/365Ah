	sub:Transmission_Tact_Time(Unit, Unit_Tact_Time)
		P(Unit+9) = P(Unit+8);
		P(Unit+8) = P(Unit+7);
		P(Unit+7) = P(Unit+6);
		P(Unit+6) = P(Unit+5);
		P(Unit+5) = P(Unit+4);
		P(Unit+4) = P(Unit+3);
		P(Unit+3) = P(Unit+2);
		P(Unit+2) = P(Unit+1);
		P(Unit+1) = p(Unit)
		P(Unit) = Unit_Tact_Time;
	return
close