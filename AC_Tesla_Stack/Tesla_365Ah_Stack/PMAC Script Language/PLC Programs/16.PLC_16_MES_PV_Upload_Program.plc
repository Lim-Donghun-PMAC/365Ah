//=======================================================================================================================================
// [4]. 실시간 위치 PV값 [1차,2차 P&P]
//=======================================================================================================================================
IF ( L_MES_Comunication_Timer > 10 )
{	
	L_MES_Comunication_Timer = 0;		// 10ms마다 위치값 업데이트

	// 1. 양극 1차 PNP
	// 1.1. 양극 1차 PNP 실시간 지령 위치
	Sys.Idata[21171] = ((Motor[1].Despos - Motor[1].HomePos) / (Motor[1].PosSf)) / P_Cathode_1PNP_Sacle_Value;
	// 1.2. 양극 1차 PNP 실시간 현재 위치
	Sys.Idata[21172] = ((Motor[1].Actpos - Motor[1].HomePos) / (Motor[1].PosSf)) / P_Cathode_1PNP_Sacle_Value;

	// 2. 양극 2차 PNP
	// 2.1. 양극 2차 PNP 실시간 지령 위치
	Sys.Idata[21173] = ((Motor[3].Despos - Motor[3].HomePos) / (Motor[3].PosSf)) / P_Cathode_2PNP_Sacle_Value;	
	// 2.1. 양극 2차 PNP 실시간 현재 위치
	Sys.Idata[21174] = ((Motor[3].Actpos - Motor[3].HomePos) / (Motor[3].PosSf)) / P_Cathode_2PNP_Sacle_Value;

	// 3. 음극 1차 PNP
	// 3.1. 음극 1차 PNP 실시간 지령 위치
	Sys.Idata[21175] = ((Motor[2].Despos - Motor[2].HomePos) / (Motor[2].PosSf)) / P_Anode_1PNP_Sacle_Value;
	// 3.2. 음극 1차 PNP 실시간 현재 위치
	Sys.Idata[21176] = ((Motor[2].Actpos - Motor[2].HomePos) / (Motor[2].PosSf)) / P_Anode_1PNP_Sacle_Value;

	// 4. 음극 2차 PNP
	// 4.1. 음극 2차 PNP 실시간 지령 위치
	Sys.Idata[21177] = ((Motor[4].Despos - Motor[4].HomePos) / (Motor[4].PosSf)) / P_Anode_2PNP_Sacle_Value;
    // 4.1. 양극 2차 PNP 실시간 현재 위치
	Sys.Idata[21178] = ((Motor[4].Actpos - Motor[4].HomePos) / (Motor[4].PosSf)) / P_Anode_2PNP_Sacle_Value;
}


P_MNTR_PLC20_Task_Time(1) = (Sys.Time - P_MNTR_PLC20_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC20_Task_Time(1) > P_MNTR_PLC20_Task_Max_Time )
{
	P_MNTR_PLC20_Task_Max_Time = P_MNTR_PLC20_Task_Time(1);
}

CLOSE
