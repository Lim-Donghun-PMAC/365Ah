// 26.10.28
// 내용 - [ 참조 : 26.10.28 양,음극 2차 회피 위치 추가 ]

&23
#4-> 1000tt		// 음극 2차 PNP T축
//#22-> 1000z		// 음극 2차 PNP Z축
//===============//



open prog 23
	
	ABS					// 절대좌표모드
	LINEAR
	
	while( P_Master_Motion_Program_Flag == 1 && P_Sub_Master_Motion_Program_Flag(3) == 1 && P_Slave_Motion_Program_Flag(3) == 1 )
	{	// 프로그램 허용 플래그
	
		Switch ( P_Slave3_Motion_Command )
		{	
			// 커멘드별 모션
			case 0:
			break;

			// case 1
			case N_2nd_PNP_Align_To_Stack_Motion :		// Stack 진입
				P_Anode_2TR_T_Align_To_Stack = P_Master_Motion_Trigger
				P_Slave3_Motion_Command == 0;
				P_A_2nd_PNP_FWD_Abort_Calc_Bit == 1;				// Abort Calc 진행 Bit.		[ 참조 : 25.07.04 모션 중 P&P AbortTa,Ts 적용 ]
				P_A_2nd_PNP_FWD_Restore_Bit == 1;					// Abort 완료 후 원복 Bit.	[ 참조 : 25.07.29 Abort 프로그램 수정 ]
				P_Second_PNP_T_Align_To_Stack_Status == F_Status_EXECUTE;		// Hold 모듈 모션 동작 상태 확인. [ 참조 : 25.12.02 Hold 액팅 모듈 추가 ]
				dwell(0)
				linear
				tm(115) ta(80) ts(30)		// 230ms
				tt(P_Anode_2TR_T_Stack_POS) //z( 24 )				
				// tt(P_Anode_2st_T_Align_To_Stack)	z(P_Anode_2nd_Z_Ready_Up)   // [ 참조 : 25.09.01 추후 레시피로 받을때 상수->레시피변수로변경 ]
				dwell(0)
				if ( P_SemiRun_Anode_2th_ST_T_Axis_Pos_Flag == 1 )			// PV 항목 : 위치 값 보고 (세미 런 진입 + 모터 이동 완료 후 위치 값 저장)	[ 참조 : 26.09.14 MES PV 수정 ]
				{
					P_Motion_Anode_2th_ST_T_Axis_Pos_Flag == 1;				// 위치 값 저장 Flag On.
				}
				P_Anode_2nd_Motion_Complete == 1
				P_A_2nd_PNP_FWD_Abort_Calc_Bit == 0;				// Abort Calc 진행 Bit.		[ 참조 : 25.07.04 모션 중 P&P AbortTa,Ts 적용 ]
				P_Second_PNP_T_Align_To_Stack_Status == F_Status_COMPLETE;		// Hold 모듈 모션 동작 상태 확인. [ 참조 : 25.12.02 Hold 액팅 모듈 추가 ]
				dwell(0)
			break;

			// case 2
			case N_2nd_PNP_Stack_To_Align_Motion :		// Align 진입
				P_Anode_2TR_T_Stack_To_Align = P_Master_Motion_Trigger
				P_Slave3_Motion_Command == 0;
				P_A_2nd_PNP_BWD_Abort_Calc_Bit == 1;				// Abort Calc 진행 Bit.		[ 참조 : 25.07.04 모션 중 P&P AbortTa,Ts 적용 ]
				P_A_2nd_PNP_BWD_Restore_Bit == 1;					// Abort 완료 후 원복 Bit.	[ 참조 : 25.07.29 Abort 프로그램 수정 ]
				P_Second_PNP_T_Stack_To_Align_Status == F_Status_EXECUTE;		// Hold 모듈 모션 동작 상태 확인. [ 참조 : 25.12.02 Hold 액팅 모듈 추가 ]
				// [ 참조 : 26.05.06 1,2차,NG PNP 및 얼라인 흡착 해제 타이밍 수정 ]
				if( (Sys_Anode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence) == 0 )
				{
					M_Y_Anode_2nd_Vac_Sol_On == 0;						// 흡착 ON
					M_Y_Anode_2nd_Vac_Sol_Off == 0;						// 흡착 OFF
				}
				dwell(0)
				linear
				tm(115) ta(80) ts(30)		// 230ms
				tt(P_Anode_2TR_T_Align_POS) //z( 24 )
				// tt(P_Anode_2st_T_Stack_To_Align)	z(P_Anode_2nd_Z_Ready_Up)   // [ 참조 : 25.09.01 추후 레시피로 받을때 상수->레시피변수로변경 ]
				dwell(0)
				if ( P_SemiRun_Anode_2th_AT_T_Axis_Pos_Flag == 1 )			// PV 항목 : 위치 값 보고 (세미 런 진입 + 모터 이동 완료 후 위치 값 저장)	[ 참조 : 26.09.14 MES PV 수정 ]
				{
					P_Motion_Anode_2th_AT_T_Axis_Pos_Flag == 1;				// 위치 값 저장 Flag On.
				}
				P_Anode_2nd_Motion_Complete == 1
				P_A_2nd_PNP_BWD_Abort_Calc_Bit == 0;				// Abort Calc 진행 Bit.		[ 참조 : 25.07.04 모션 중 P&P AbortTa,Ts 적용 ]
				P_Second_PNP_T_Stack_To_Align_Status == F_Status_COMPLETE;		// Hold 모듈 모션 동작 상태 확인. [ 참조 : 25.12.02 Hold 액팅 모듈 추가 ]
				dwell(0)
			break;

			//// case 3
			//case N_2nd_PNP_Stack_Down_Motion :			// stack 하강
			//	P_Slave3_Motion_Command == 0;
			//	linear
			//	//ta(33.5)ts(10)tm(45)td(21.5)			// 90ms
			//	//ta(38)ts(10)tm(41)td(24)				// 90ms 수정250415 잘 못 만들었어서 부하율 비슷하게 나옴
			//	//ta(46)ts(10)tm(48)td(28)				// 100ms
