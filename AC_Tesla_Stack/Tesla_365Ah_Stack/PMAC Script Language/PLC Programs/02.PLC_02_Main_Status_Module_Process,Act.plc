				P_Hold_Supply_Align_Tact_Time_Array(0) = P_Hold_Supply_Align_Tact_Time_Array(0) + P_Hold_Supply_Align_Tact_Time_Array(P_Hold_Supply_Align_Seq_Index);		// HOLD Align 공급 모듈  시퀀스 총 Tact Time 업데이트.
				P_Hold_Supply_Align_State_Machine = N_Ready_Step;																						
