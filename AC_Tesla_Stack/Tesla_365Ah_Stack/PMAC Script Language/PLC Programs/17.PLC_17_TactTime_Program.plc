	// N_ARC_Upper_Plate - 상부 플레이트 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Upper_Dn_Sol == 1 && M_Y_Sepa_ARC_Upper_Up_Sol == 0 )		// 하강.
	{
		P_Tact_Time_ARC_Upper_Plate_Down = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Plate) == 0 && M_X_Sepa_Upper_ARC_Dn_Sensor == 1 && M_X_Sepa_Upper_ARC_Up_Sensor == 0 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_Plate) = P_Tact_Time_ARC_Upper_Plate_Up / 10;		// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Plate) = 1;										// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Upper_Dn_Sol == 0 && M_Y_Sepa_ARC_Upper_Up_Sol == 1 )	// 상승.
	{
		P_Tact_Time_ARC_Upper_Plate_Up = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Plate) == 1 && M_X_Sepa_Upper_ARC_Dn_Sensor == 0 && M_X_Sepa_Upper_ARC_Up_Sensor == 1 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_UnPlate) = P_Tact_Time_ARC_Upper_Plate_Down / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Plate) = 0;										// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Upper_Tilting - 상부 틸팅 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Upper_Tilting_Sol == 1 && M_Y_Sepa_ARC_Upper_UnTilting_Sol == 0 )			// 틸팅 ON. (90도)
	{
		P_Tact_Time_ARC_Upper_Tilting_Off = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Tilting) == 0 && (M_X_Sepa_Upper_ARC_Tilting_Sensor_Front & M_X_Sepa_Upper_ARC_Tilting_Sensor_Rear) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_Tilting) = P_Tact_Time_ARC_Upper_Tilting_On / 10;		// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Tilting) = 1;											// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Upper_Tilting_Sol == 0 && M_Y_Sepa_ARC_Upper_UnTilting_Sol == 1 )	// 틸팅 OFF. (0도)
	{
		P_Tact_Time_ARC_Upper_Tilting_On = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Tilting) == 1 && (M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front & M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_UnTilting) = P_Tact_Time_ARC_Upper_Tilting_Off / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Tilting) = 0;											// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Upper_Cutter - 상부 커터 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Upper_Cutting_FWD_Sol == 1 )				// 커터 전진.
	{
		P_Tact_Time_ARC_Upper_Cutter_Bwd = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Cutter) == 0 && M_X_Sepa_Upper_ARC_Cutting_FWD_Sensor == 1 && M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor == 0 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_Cutter) = P_Tact_Time_ARC_Upper_Cutter_Fwd / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Cutter) = 1;										// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Upper_Cutting_FWD_Sol == 0 )			// 커터 후진.
	{
		P_Tact_Time_ARC_Upper_Cutter_Fwd = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Cutter) == 1 && M_X_Sepa_Upper_ARC_Cutting_FWD_Sensor == 0 && M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor == 1 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_UnCutter) = P_Tact_Time_ARC_Upper_Cutter_Bwd / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Cutter) = 0;										// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Upper_Clamp - 상부 클램프 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Upper_Stopper_FWD_Sol == 1 && M_Y_Sepa_ARC_Upper_Stopper_BWD_Sol == 0 )			// 클램프 ON.
	{
		P_Tact_Time_ARC_Upper_Clamp_Off = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Clamp) == 0 && (M_X_Sepa_Upper_ARC_Stopper_Front_Sensor & M_X_Sepa_Upper_ARC_Stopper_Rear_Sensor) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_Clamp) = P_Tact_Time_ARC_Upper_Clamp_On / 10;		// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Clamp) = 1;										// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Upper_Stopper_BWD_Sol == 1 && M_Y_Sepa_ARC_Upper_Stopper_FWD_Sol == 0 )		// 클램프 OFF.
	{
		P_Tact_Time_ARC_Upper_Clamp_On = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Upper_Clamp) == 1 && (M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor & M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_UPPER_UnClamp) = P_Tact_Time_ARC_Upper_Clamp_Off / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Upper_Clamp) = 0;										// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Lower_Plate - 하부 플레이트 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Lower_Up_Sol == 1 && M_Y_Sepa_ARC_Lower_Dn_Sol == 0 )			// 상승.
	{
		P_Tact_Time_ARC_Lower_Plate_Down = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Plate) == 0 && M_X_Sepa_Lower_ARC_Up_Sensor == 1 && M_X_Sepa_Lower_ARC_Dn_Sensor == 0 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_Plate) = P_Tact_Time_ARC_Lower_Plate_Up / 10;		// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Plate) = 1;										// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Lower_Up_Sol == 0 && M_Y_Sepa_ARC_Lower_Dn_Sol == 1 )	// 하강.
	{
		P_Tact_Time_ARC_Lower_Plate_Up = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Plate) == 1 && M_X_Sepa_Lower_ARC_Up_Sensor == 0 && M_X_Sepa_Lower_ARC_Dn_Sensor == 1 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_UnPlate) = P_Tact_Time_ARC_Lower_Plate_Down / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Plate) = 0;										// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Lower_Tilting - 하부 틸팅 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Lower_Tilting_Sol == 1 && M_Y_Sepa_ARC_Lower_UnTilting_Sol == 0 )		// 틸팅 ON. (90도)
	{
		P_Tact_Time_ARC_Lower_Tilting_Off = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Tilting) == 0 && (M_X_Sepa_Lower_ARC_Tilting_Sensor_Front & M_X_Sepa_Lower_ARC_Tilting_Sensor_Rear) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_Tilting) = P_Tact_Time_ARC_Lower_Tilting_On / 10;		// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Tilting) = 1;											// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Lower_Tilting_Sol == 0 && M_Y_Sepa_ARC_Lower_UnTilting_Sol == 1 )	// 틸팅 OFF. (0도)
	{
		P_Tact_Time_ARC_Lower_Tilting_On = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Tilting) == 1 && (M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front & M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_UnTilting) = P_Tact_Time_ARC_Lower_Tilting_Off / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Tilting) = 0;											// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Lower_Cutter - 하부 커터 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Lower_Cutting_FWD_Sol == 1 )				// 전진.
	{
		P_Tact_Time_ARC_Lower_Cutter_Bwd = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Cutter) == 0 && M_X_Sepa_Lower_ARC_Cutting_FWD_Sensor == 1 && M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor == 0 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_Cutter) = P_Tact_Time_ARC_Lower_Cutter_Fwd / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Cutter) = 1;										// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Lower_Cutting_FWD_Sol == 0 )			// 후진.
	{
		P_Tact_Time_ARC_Lower_Cutter_Fwd = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Cutter) == 1 && M_X_Sepa_Lower_ARC_Cutting_FWD_Sensor == 0 && M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor == 1 )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_UnCutter) = P_Tact_Time_ARC_Lower_Cutter_Bwd / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Cutter) = 0;										// 재진입 방지.
		}
	}
	//--------------------------------------------------------------------------------//
	// N_ARC_Lower_Clamp - 하부 클램프 [출력 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Sepa_ARC_Lower_Stopper_FWD_Sol == 1 && M_Y_Sepa_ARC_Lower_Stopper_BWD_Sol == 0 )			// 클램프 ON.
	{
		P_Tact_Time_ARC_Lower_Clamp_Off = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Clamp) == 0 && (M_X_Sepa_Lower_ARC_Stopper_Front_Sensor & M_X_Sepa_Lower_ARC_Stopper_Rear_Sensor) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_Clamp) = P_Tact_Time_ARC_Lower_Clamp_On / 10;		// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Clamp) = 1;										// 재진입 방지.
		}
	}
	else if ( M_Y_Sepa_ARC_Lower_Stopper_BWD_Sol == 1 && M_Y_Sepa_ARC_Lower_Stopper_FWD_Sol == 0 )	// 클램프 OFF.
	{
		P_Tact_Time_ARC_Lower_Clamp_On = 0;
		if ( P_Old_Tact_Time_Check(N_ARC_Lower_Clamp) == 1 && (M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor & M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor) )	// 입력 센서 들어올 경우.
		{
			P_Pneumatic_Pressure_Unit_Tack_Time(N_ARC_LOWER_UnClamp) = P_Tact_Time_ARC_Lower_Clamp_Off / 10;	// Tact TIme 저장.
			P_Old_Tact_Time_Check(N_ARC_Lower_Clamp) = 0;										// 재진입 방지.
		}
	}

P_MNTR_PLC17_Task_Time(1) = (Sys.Time - P_MNTR_PLC17_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC17_Task_Time(1) > P_MNTR_PLC17_Task_Max_Time )
{
	P_MNTR_PLC17_Task_Max_Time = P_MNTR_PLC17_Task_Time(1);
}
close
