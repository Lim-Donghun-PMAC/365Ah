//-------------------------//
// 강제 출력 버튼 관련 함수 //
//-------------------------//
open Subprog Force_BTN_Function(void)
	// 일반 출력 모드 주소 설정.
	sub:Normal_Mode_Address_Config(void)
		
		// GPIO #0
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5000+P_Force_BTN_Address_Count,0,16+P_Force_BTN_Address_Count
		// GPIO #1
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5016+P_Force_BTN_Address_Count,2,16+P_Force_BTN_Address_Count
		// GPIO #2
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5032+P_Force_BTN_Address_Count,3,16+P_Force_BTN_Address_Count
		// GPIO #3
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5048+P_Force_BTN_Address_Count,4,16+P_Force_BTN_Address_Count
		// GPIO #4
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5064+P_Force_BTN_Address_Count,5,16+P_Force_BTN_Address_Count
		// GPIO #5
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5080+P_Force_BTN_Address_Count,6,16+P_Force_BTN_Address_Count
		// GPIO #6
		cmd"M%d->Gate3[%d].GpioData[0].%d.1",5096+P_Force_BTN_Address_Count,7,16+P_Force_BTN_Address_Count
		// Ecat #100
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5112+P_Force_BTN_Address_Count,0,P_Force_BTN_Address_Count
		// Ecat #101
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5128+P_Force_BTN_Address_Count,1,P_Force_BTN_Address_Count
		// Ecat #102
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5144+P_Force_BTN_Address_Count,2,P_Force_BTN_Address_Count
		// Ecat #103
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5160+P_Force_BTN_Address_Count,3,P_Force_BTN_Address_Count
		// Ecat #104
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5176+P_Force_BTN_Address_Count,4,P_Force_BTN_Address_Count
		// Ecat #106
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5208+P_Force_BTN_Address_Count,87,P_Force_BTN_Address_Count
		// Ecat #107
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5224+P_Force_BTN_Address_Count,88,P_Force_BTN_Address_Count
		// Ecat #108
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5240+P_Force_BTN_Address_Count,89,P_Force_BTN_Address_Count
		// Ecat #111
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5288+P_Force_BTN_Address_Count,83,P_Force_BTN_Address_Count
		// Ecat #112
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5304+P_Force_BTN_Address_Count,84,P_Force_BTN_Address_Count
		// Ecat #113
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5320+P_Force_BTN_Address_Count,85,P_Force_BTN_Address_Count
		// Ecat #114
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",5336+P_Force_BTN_Address_Count,86,P_Force_BTN_Address_Count

		if ( P_Force_BTN_Address_Count > 15 ) {}
		else
			P_Force_BTN_Address_Count++;

	return;

	// 일반 출력 모드 저장된 M변수 불러오기.
	sub:Normal_Mode_Retrieve_M_Variable(void)

		// GPIO #0
		M(5000 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5000 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #1
		M(5016 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5016 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #2																     
		M(5032 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5032 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #3																     
		M(5048 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5048 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #4																    
		M(5064 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5064 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #5																     
		M(5080 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5080 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #6																     
		M(5096 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5096 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #100
		M(5112 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5112 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #101																
		M(5128 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5128 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #102																
		M(5144 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5144 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #103																 
		M(5160 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5160 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #104																 
		M(5176 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5176 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #106																 
		M(5208 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5208 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #107																 
		M(5224 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5224 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #108																 
		M(5240 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5240 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #111																 
		M(5288 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5288 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #112																 
		M(5304 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5304 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #113																 
		M(5320 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5320 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #114																 
		M(5336 + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((5336 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)

		if( P_Force_BTN_M_Variable_Save_Count > 15 ){}
		else
			P_Force_BTN_M_Variable_Save_Count++;

	return;

	// 강제 출력 모드 주소 설정.
	sub:Force_Mode_Address_Config(void)

		if ( P_Force_BTN_Address_Count > P_Force_BTN_Address_Clear_Count ){}
		else
		{
			cmd"M%d->*",P_Force_BTN_M_Variable_Start_Num+P_Force_BTN_Address_Count;		// 주소값 초기화.
			P_Force_BTN_Address_Count++;					// 카운트 증가.
		}

	return;

	// 강제 출력 모드 저장된 M변수 저장.
	sub:Force_Mode_Save_M_Variable(void)

		// GPIO #0
		P_Force_BTN_M_Variable_Save((5000 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5000 + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #1
		P_Force_BTN_M_Variable_Save((5016 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5016 + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #2
		P_Force_BTN_M_Variable_Save((5032 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5032 + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #3
		P_Force_BTN_M_Variable_Save((5048 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5048 + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #4
		P_Force_BTN_M_Variable_Save((5064 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5064 + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #5
		P_Force_BTN_M_Variable_Save((5080 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5080 + P_Force_BTN_M_Variable_Save_Count)
		// GPIO #6
		P_Force_BTN_M_Variable_Save((5096 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5096 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #100
		P_Force_BTN_M_Variable_Save((5112 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5112 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #101
		P_Force_BTN_M_Variable_Save((5128 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5128 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #102
		P_Force_BTN_M_Variable_Save((5144 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5144 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #103
		P_Force_BTN_M_Variable_Save((5160 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5160 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #104
		P_Force_BTN_M_Variable_Save((5176 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5176 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #106
		P_Force_BTN_M_Variable_Save((5208 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5208 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #107
		P_Force_BTN_M_Variable_Save((5224 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5224 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #108
		P_Force_BTN_M_Variable_Save((5240 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5240 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #111
		P_Force_BTN_M_Variable_Save((5288 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5288 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #112
		P_Force_BTN_M_Variable_Save((5304 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5304 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #113
		P_Force_BTN_M_Variable_Save((5320 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5320 + P_Force_BTN_M_Variable_Save_Count)
		// Ecat #114
		P_Force_BTN_M_Variable_Save((5336 - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count) = M(5336 + P_Force_BTN_M_Variable_Save_Count)

		if( P_Force_BTN_M_Variable_Save_Count > 15 ){}
		else
			P_Force_BTN_M_Variable_Save_Count++;

	return;

close
