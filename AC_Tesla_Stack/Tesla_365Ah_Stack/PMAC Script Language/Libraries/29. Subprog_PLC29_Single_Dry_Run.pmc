//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.09.12
// 단동, 연동 프로그램 주석 정리 및 인터락 추가. [ 참조 : 25.09.12 단동, 연동 프로그램 주석 및 인터락 추가 ]

/*	search [ㄴㄷㅁㄱ] ← 검색용.
Evade_Pos				회피 동작
Evade_Pos_Check			회피 확인
Motion_Ready			모션 준비
Coord_Activate			좌표계 활성화
Coord_Activate_Check	좌표계 활성화 확인
Select_Run_Mode			런모드 선택
Run_Execute				런모드 진행
Interlock				인터락
__Init					초기화
*/
open subprog Single_Dry_Run(void)
	
	//1.회피동작
	sub:Evade_Pos(Unit,&rtn)

		rtn = 0;

		switch ( Unit )
		{
			case N_Cathode_1st_PNP_Unit :
				Motor[1].JogSpeed = 50;									// 속도 지정.
				Motor[3].JogSpeed = 50;									// 속도 지정.
				//Motor[1].ProgJogPos = (P_Recipe_M01_POS(1)/10);		// 양극 1차 PNP 벨트 위치 이동.		추후 레시피 Pos로 변경.
				//Motor[3].ProgJogPos = (P_Recipe_M03_POS(2)/10);		// 양극 2차 PNP 스택 위치 이동.
				Motor[1].ProgJogPos = 0;								// 양극 1차 PNP 벨트 위치 이동.
				Motor[3].ProgJogPos = 90000;							// 양극 2차 PNP 스택 위치 이동.
				Jog1=*													// Jog 이동.
				Jog3=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]	
			break;

			case N_Anode_1st_PNP_Unit :	
				Motor[2].JogSpeed = 50;									// 속도 지정.
				Motor[4].JogSpeed = 50;									// 속도 지정.
				///Motor[2].ProgJogPos = (P_Recipe_M02_POS(1)/10);		// 음극 1차 PNP 벨트 위치 이동.
				///Motor[4].ProgJogPos = (P_Recipe_M04_POS(2)/10);		// 음극 2차 PNP 스택 위치 이동.
				Motor[2].ProgJogPos = 0;								// 음극 1차 PNP 벨트 위치 이동.
				Motor[4].ProgJogPos = 90000;							// 음극 2차 PNP 스택 위치 이동.
				Jog2=*													// Jog 이동.
				Jog4=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Cathode_Clamp_Unit : 
				Motor[11].JogSpeed = 20;								// 속도 지정.
				Motor[11].ProgJogPos = -30000							// 스택테이블 30mm 하강.
				Jog11:*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_Clamp_Unit :
				Motor[11].JogSpeed = 20;								// 속도 지정.
				Motor[11].ProgJogPos = -30000							// 스택테이블 30mm 하강.
				Jog11:*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Stack_Table_Unit :			
				Motor[11].JogSpeed = 20;								// 속도 지정.
				Motor[11].ProgJogPos = -30000							// 스택테이블 30mm 하강.
				Jog11:*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Finall_Roller_X_Unit:
				Motor[12].JogSpeed = 50;								// 속도 지정.
				//Motor[12].ProgJogPos = (P_Recipe_M12_POS(1)/10);		// 파이널롤러 음극 위치로 이동	.
				Motor[12].ProgJogPos = -197000;							// 파이널롤러 음극 위치로 이동	.
				Jog12=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Cathode_2nd_PNP_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]
				Motor[12].JogSpeed = 50;								// 속도 지정.
				//Motor[12].ProgJogPos = (P_Recipe_M12_POS(1)/10);		// 파이널롤러 음극 위치로 이동	.
				Motor[12].ProgJogPos = -197000;							// 파이널롤러 음극 위치로 이동	.
				Jog12=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Anode_2nd_PNP_Unit :	
				Motor[12].JogSpeed = 50;								// 속도 지정.
				//Motor[12].ProgJogPos = (P_Recipe_M12_POS(1)/10);		// 파이널롤러 음극 위치로 이동	.
				Motor[12].ProgJogPos = 168000;							// 파이널롤러 음극 위치로 이동	.
				Jog12=*													// Jog 이동.
				rtn = N_TRUE;	
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]
			break

			case N_Cathode_Align_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Anode_Align_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Finall_Roller_Z_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Cathode_1st_Picker_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Anode_1st_Picker_T :								
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Final_Roll_Evade :
				Motor[13].JogSpeed = 30;								// 속도 지정.
				cmd"#13j-"												// 파이널롤러 z축 - 리밋으로 회피.
			break;

			case N_Sheet_Paper_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Cathode_NG_PNP_Total_Unit :
			case N_Cathode_NG_PNP_T :
				Motor[3].JogSpeed = 50;									// 속도 지정.
				//Motor[3].ProgJogPos = (P_Recipe_M03_POS(2)/10);			// 양극 2차 PNP 스택 위치 이동
				Motor[3].ProgJogPos = 90000;							// 양극 2차 PNP 스택 위치 이동
				Jog3=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Cathode_NG_PNP_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_NG_PNP_Total_Unit :
			case N_Anode_NG_PNP_T :
				Motor[4].JogSpeed = 50;									// 속도 지정.
				//Motor[4].ProgJogPos = (P_Recipe_M04_POS(2)/10);			// 음극 2차 PNP 스택 위치 이동
				Motor[4].ProgJogPos = 90000;							// 음극 2차 PNP 스택 위치 이동
				Jog4=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Anode_NG_PNP_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_X :
				Motor[11].JogSpeed = 20;								// 속도 지정.
				Motor[47].JogSpeed = 20;								// 속도 지정.
				//Motor[47].ProgJogPos = (P_Recipe_M47_POS(1)/10);		// 스텟 진입 위치 이동.
				Motor[47].ProgJogPos = -9790;							// 스텟 진입 위치 이동.
				cmd"#11j-"												// 메인 Z축 - 리밋으로 회피.
				Jog47=*													// Jog 이동.
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break
		}
	return

	// 2.회피 확인 
	sub:Evade_Pos_Check(Unit,&rtn)

		rtn = 0;

		switch ( Unit )
		{
			case N_Cathode_1st_PNP_Unit :
				if ( Motor[N_1st_PnP_CA_T].DesVelZero == 1 && Motor[N_2nd_PnP_CA_T].DesVelZero == 1 )			//양극2차 정지확인
				{	
					P_Single_Run_Pos_Rtn1 = 0;							// 반환값 초기화.
					P_Single_Run_Pos_Rtn2 = 0;							// 반환값 초기화.
					call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP, &P_Cathode_2nd_Unit_Status, &P_Single_Run_Pos_Rtn1);	// 메모리 타워로 위치 확인.
					call Sub_Unit_Memory_Status.individual_mode(F_Cathode_1st_PNP, &P_Cathode_1st_Unit_Status, &P_Single_Run_Pos_Rtn2);	// 메모리 타워로 위치 확인.
					if( P_Single_Run_Pos_Rtn1 == 1 && P_Single_Run_Pos_Rtn2 == 1 )	// 반환값 확인.
					{
						if( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos && P_Cathode_1st_Unit_Status == F_1st_PNP_Belt_Up_Pos )	// 양극 2차 PNP : Stack 위치, 1차 PNP : Belt 위치.
							rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
						else											// 아닐 경우.
							rtn = N_FALSE;								// 반환값 업데이트. [FALSE]
					}
					else												// 위치 메모리 타워 진행이 안될 경우.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
				}
			break;

			case N_Anode_1st_PNP_Unit :	
				if ( Motor[N_1st_PnP_AN_T].DesVelZero == 1 && Motor[N_2nd_PnP_AN_T].DesVelZero == 1 )			//양극2차 정지확인
				{	
					P_Single_Run_Pos_Rtn1 = 0;							// 반환값 초기화.
					P_Single_Run_Pos_Rtn2 = 0;							// 반환값 초기화.
					call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP, &P_Anode_2nd_Unit_Status, &P_Single_Run_Pos_Rtn1);		// 메모리 타워로 위치 확인.
					call Sub_Unit_Memory_Status.individual_mode(F_Anode_1st_PNP, &P_Anode_1st_Unit_Status, &P_Single_Run_Pos_Rtn2);		// 메모리 타워로 위치 확인.
					if( P_Single_Run_Pos_Rtn1 == 1 && P_Single_Run_Pos_Rtn2 == 1 )	// 반환값 확인.
					{
						if( P_Anode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos && P_Anode_1st_Unit_Status == F_1st_PNP_Belt_Up_Pos )		// 음극 2차 PNP : Stack 위치, 1차 PNP : Belt 위치.
							rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
						else											// 아닐 경우.
							rtn = N_FALSE;								// 반환값 업데이트. [FALSE]
					}
					else												// 위치 메모리 타워 진행이 안될 경우.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
				}			
			break;

			case N_Cathode_Clamp_Unit : 
				if ( Motor[11].DesVelZero == 1 )						// 워크 테이블 정지확인
				{
					if ( P_Motor_Current_Pos(N_MAIN_Z) > ((P_Recipe_M11_POS(1)/10000) - 30) - P_Motor_Ready_Poa_Inpos_200um && P_Motor_Current_Pos(N_MAIN_Z) < ((P_Recipe_M11_POS(1)/10000) - 30) + P_Motor_Ready_Poa_Inpos_200um )		//20 워크 테이블 위치 확인.
					{				
						rtn = N_TRUE;									// 반환값 업데이트. [TRUE]		
					}
					else												// 아닐 경우.
					{
						P_Error_Monitoring_Count_1++;					// 모니터링 카운트 증가.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
					}
				}												
			break;

			case N_Anode_Clamp_Unit :
				if ( Motor[11].DesVelZero == 1 )						// 워크 테이블 정지확인
				{
					if ( P_Motor_Current_Pos(N_MAIN_Z) > ((P_Recipe_M11_POS(1)/10000) - 30) - P_Motor_Ready_Poa_Inpos_200um && P_Motor_Current_Pos(N_MAIN_Z) < ((P_Recipe_M11_POS(1)/10000) - 30) + P_Motor_Ready_Poa_Inpos_200um )		//20 워크 테이블 위치 확인.
					{				
						rtn = N_TRUE;									// 반환값 업데이트. [TRUE]		
					}
					else												// 아닐 경우.
					{
						P_Error_Monitoring_Count_1++; 					// 모니터링 카운트 증가.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
					}
				}			
			break;

			case N_Stack_Table_Unit :
				if ( Motor[11].DesVelZero == 1 )						// 워크테이블 정지확인
				{
					if ( P_Motor_Current_Pos(N_MAIN_Z) > ((P_Recipe_M11_POS(1)/10000) - 30) - P_Motor_Ready_Poa_Inpos_200um && P_Motor_Current_Pos(N_MAIN_Z) < ((P_Recipe_M11_POS(1)/10000) - 30) + P_Motor_Ready_Poa_Inpos_200um )		//20 워크 테이블 위치 확인.
					{				
						rtn = N_TRUE;									// 반환값 업데이트. [TRUE]		
					}
					else												// 아닐 경우.
					{
						P_Error_Monitoring_Count_1++; 					// 모니터링 카운트 증가.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
					}
				}			
			break;

			case N_Cathode_2nd_PNP_Unit :						
				if(Motor[12].DesVelZero == 1)
				{
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) > (P_Recipe_M12_POS(1)/10000) - P_Motor_Ready_Poa_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < (P_Recipe_M12_POS(1)/10000) + P_Motor_Ready_Poa_Inpos_200um)
					{
						rtn = N_TRUE;
					}
					else
					{
						P_Error_Monitoring_Count_1++; 					// 모니터링 카운트 증가.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
					}
				}
			break;

			case N_Anode_2nd_PNP_Unit :						
				if(Motor[12].DesVelZero == 1)
				{
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) > (P_Recipe_M12_POS(2)/10000) - P_Motor_Ready_Poa_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < (P_Recipe_M12_POS(2)/10000) + P_Motor_Ready_Poa_Inpos_200um)
					{
						rtn = N_TRUE;
					}
					else
					{
						P_Error_Monitoring_Count_1++; 					// 모니터링 카운트 증가.
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
					}
				}	
			break;

			case N_Cathode_Align_Unit :						
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_Align_Unit :						
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Finall_Roller_X_Unit :
				if ( Motor[N_FINAL_ROLL_X].DesVelZero == 1 )						// 파이널롤러 X축 정지 확인			
				{			
					P_Single_Run_Pos_Rtn1 = 0;							// 반환값 초기화.
					call Sub_Unit_Memory_Status.individual_mode(F_Final_Roll, &P_FinalRoll_Unit_Status, &P_Single_Run_Pos_Rtn1);	// 메모리 타워로 위치 확인.
					if( P_Single_Run_Pos_Rtn1 == 1 )					// 반환값 확인.
					{
						if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Discharge_Pos )	// 음극 위치에 있을 경우.
							rtn = N_TRUE;								// 반환값 업데이트. [TRUE]	
						else
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
					}	
				}					
			break;

			case N_Finall_Roller_Z_Unit :						
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Cathode_1st_Picker_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Anode_1st_Picker_T :								
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Final_Roll_Evade :
				//if( Motor[13].MinusLimit == 1 )							// 리밋 확인.
				if( P789 == 1 )							// 리밋 확인.
				{
					rtn = N_TRUE;										// 반환값 업데이트. [TRUE]		
				}
			break;

			case N_Sheet_Paper_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Cathode_NG_PNP_Total_Unit :
			case N_Cathode_NG_PNP_T :
				if ( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 )							//양극2차 정지확인
				{	
					P_Single_Run_Pos_Rtn1 = 0;							// 반환값 초기화.
					call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP, &P_Cathode_2nd_Unit_Status, &P_Single_Run_Pos_Rtn1);	// 메모리 타워로 위치 확인.
					if( P_Single_Run_Pos_Rtn1 == 1 )					// 반환값 확인.
					{
						if( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos )	// 양극 2차 PNP Stack 상승 일 경우.
							rtn = N_TRUE;								// 반환값 업데이트. [TRUE]
						else
					rtn = N_FALSE;										// 반환값 업데이트. [FALSE]
					}
					else
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
				}
			break

			case N_Cathode_NG_PNP_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_NG_PNP_Total_Unit :
			case N_Anode_NG_PNP_T :	
				if (Motor[N_2nd_PnP_AN_T].DesVelZero == 1 )							//양극2차 정지확인
				{	
					P_Single_Run_Pos_Rtn1 = 0;							// 반환값 초기화.
					call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP, &P_Anode_2nd_Unit_Status, &P_Single_Run_Pos_Rtn1);	// 메모리 타워로 위치 확인.
					if( P_Single_Run_Pos_Rtn1 == 1 )					// 반환값 확인.
					{
						if( P_Anode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos )		// 음극 2차 PNP Stack 상승 일 경우.
							rtn = N_TRUE;								// 반환값 업데이트. [TRUE]
						else
							rtn = N_FALSE;								// 반환값 업데이트. [FALSE]
					}
					else
						rtn = N_FALSE;									// 반환값 업데이트. [FALSE]
				}			
			break;

			case N_Anode_NG_PNP_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_X :
				if (Motor[11].DesVelZero == 1 && Motor[47].DesVelZero == 1 )		// 워크 테이블, 1차 언로드 Z축 정지 확인.		
				{
					//if( Motor[11].MinusLimit == 1 )						// 워크 테이블 리밋 확인.
					if( P789 == 1 )						// 워크 테이블 리밋 확인.
						rtn = N_TRUE;									// 반환값 업데이트. [TRUE]
				}
			break

			case N_1st_UND_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

		}
	return

	// 3.모션 준비
	sub:Motion_Ready(&rtn)
		rtn = 0;
		switch (P_Single_Run_Motion_Ready_State_Machine)
		{
			case 1 :
				P_Single_Run_Motion_Ready_RTN = 0;						// 타임 베이스 반환값 초기화.
				call Sub_Common_Function.Timebase_On(&P_Single_Run_Motion_Ready_RTN);	// 타임 베이스 ON
				if( P_Single_Run_Motion_Ready_RTN == 1 )				// 반환값 확인.
					P_Single_Run_Motion_Ready_State_Machine = 2 ;		// 다음 스텟 머신으로 이동.
			break;
			case 2 : 
				P_Slave1_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave2_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave3_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave4_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave5_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave6_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave7_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave8_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave9_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave10_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave11_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave12_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave13_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave14_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
				P_Slave15_Motion_Command = 0;							// Slave 모션 Cmd 초기화.
		
				P_Cathode_Count = 0;									// 극판 카운트 초기화.
				// 단동 때만 음극 1카운트 1 만들어 클램프 표창 모드 막음
				P_Anode_Count = 1;										// 극판 카운트 초기화.
				P_Mode_Command = 0;										// 모드 커멘드 초기화.
				P_Current_Mode = 0;										// 현재 모드 초기화.
				

				P_SubMaster_Sub_Old_Command(0),F_Max_Index,1=0;							// 서브 프로그램 내 변수 초기화.
				P_SubMaster_Sub_Old_Mode(0),F_Max_Index,1=0;								// 서브 프로그램 내 변수 초기화.
				P_SubMaster_Sub_Old_Trigger(0),F_Max_Index,1=0;							// 서브 프로그램 내 변수 초기화.
				P_SubMaster_Sub_Mode_Command(0),F_Max_Index,1=0;							// 서브 프로그램 내 변수 초기화.


				if( P_Single_Run_Unit == N_Cathode_1st_PNP_Unit || P_Single_Run_Unit ==  N_Cathode_2nd_PNP_Unit || P_Single_Run_Unit ==  N_Anode_1st_PNP_Unit || P_Single_Run_Unit == N_Anode_2nd_PNP_Unit )
				{
					if(Motor[1].phasefound == 1 && Motor[2].phasefound == 1 && Motor[3].phasefound == 1 && Motor[4].phasefound == 1)
					{
						cmd"#*j/"
						P_Servo_ON_MNTR2++
						P_Master_Motion_Program_Flag = 1;						// 마스터 플래그	On.	
						P_Old_X_PLC_Sync_Heart_Bit = 0;
						P_Single_Run_Motion_Ready_State_Machine = 3;			// 다음 스텟 머신으로 이동.								
					}
				}
				else
				{
					cmd"#*j/"
					P_Servo_ON_MNTR3++
					P_Master_Motion_Program_Flag = 1;						// 마스터 플래그	On.	
					P_Old_X_PLC_Sync_Heart_Bit = 0;
					P_Single_Run_Motion_Ready_State_Machine = 3;			// 다음 스텟 머신으로 이동.								
				}
			break;

			case 3 :																	
				if (P_Master_Motion_Program_Flag == 1 )					// 마스터 플래그 On 확인.
				{
					#ifdef F_Virtual_Axis_Test		// 가상축일때
						if( P_Single_Run_Unit == N_Cathode_1st_PNP_Unit || P_Single_Run_Unit == N_Anode_1st_PNP_Unit )
						{
							if(M_Y_A_Site_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit && M_Y_A_Site_Heart_Bit == 1)
							{
								if( M_X_Pause_Status_Complete_Signal ) {}	// 진입 타이밍을 맞추기위해 반댓열 퍼즈일시 starting에서 모션 잡아둠
								else
								{
									START N_Coord_Master_Motion	: N_Prog_Master_Motion_Sub_Program;
									P_Single_Run_Motion_Ready_State_Machine = 4;
								}
								P_Old_X_PLC_Sync_Heart_Bit = M_Y_A_Site_Heart_Bit;
							}
						}
					#else // F_Real_Axis_Test			// 실축일때

						#ifdef F_Def_Stack_A			// A열일때	
							if( (M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit && M_X_PLC_Sync_Heart_Bit == 1) && P_Single_Run_Pass == 0 ) // P_Old_X_PLC_Sync_Heart_Bit -> 03번 PLC 동기화
							{
								if( M_X_Pause_Status_Complete_Signal ) {}	// 진입 타이밍을 맞추기위해 반댓열 퍼즈일시 starting에서 모션 잡아둠
								else
								{
									START N_Coord_Master_Motion	: N_Prog_Master_Motion_Sub_Program;
									P_Single_Run_Motion_Ready_State_Machine = 4;
								}
							}
						#else							// B열일때
							if( (M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit && M_X_PLC_Sync_Heart_Bit == 0) && P_Single_Run_Pass == 0 )	// P_Old_X_PLC_Sync_Heart_Bit -> 03번 PLC 동기화
							{
								if( M_X_Pause_Status_Complete_Signal ) {}	// 진입 타이밍을 맞추기위해 반댓열 퍼즈일시 starting에서 모션 잡아둠
								else
								{
									START N_Coord_Master_Motion	: N_Prog_Master_Motion_Sub_Program;
									P_Single_Run_Motion_Ready_State_Machine = 4;
								}
							}
						#endif

					#endif
					else
					{
						START N_Coord_Master_Motion	: N_Prog_Master_Motion_Sub_Program;
						P_Single_Run_Motion_Ready_State_Machine = 4;		// 다음 스텟 머신으로 이동.	
					}
				}						
			break;

			case 4 : 	
				P_Single_Run_Motion_Ready_RTN = 0					// 모션 프로그램 On 반환값 초기화.
				call Sub_Common_Function.Master_Motion_Program_On(&P_Single_Run_Motion_Ready_RTN);	// 모션 프로그램 플래그 ON
				if ( P_Single_Run_Motion_Ready_RTN == 1 )			// 반환값 확인.
					P_Single_Run_Motion_Ready_State_Machine = 5;	// 다음 스텟 머신으로 이동.		
			break;
		
			case 5 : 			
				//cmd"disable plc 4,12,27,28";							// 생각해보자																	
				P_Single_Run_Motion_Ready_State_Machine = 6;			// 다음 스텟 머신으로 이동.			
			break;
			
			case 6 :
				if ( Coord[1].ProgRunning == 1 )						// 마스터 촤표계 활성화 확인.
				{
					rtn = N_TRUE;										// 반환값 업데이트. [TRUE]		
				}
			break;														
		}
	return

	// 4.좌표계 활성화
	sub:Coord_Activate(Unit,&rtn)
		rtn = 0;														// 반환값 초기화.
		P_Coord_1 = 0;													// 좌표계 설정 초기화.
		P_Coord_2 = 0;													// 좌표계 설정 초기화.
		P_Coord_3 = 0;													// 좌표계 설정 초기화.
		P_Coord_4 = 0;													// 좌표계 설정 초기화.

		switch( Unit )
		{
			default:
			break;

			case N_Cathode_1st_PNP_Unit :

				START N_Coord_Cathode_TR1_Sub			: N_Prog_Cathode_TR1_Sub_Program;
				START N_Coord_Cathode_TR1_Slave			: N_Prog_Cathode_TR1_Slave_Program;
				start N_Coord_Cathode_TR1_Z_Slave		: N_Prog_Cathode_TR1_Z_Slave_Program;
			break;

			case N_Cathode_1st_Picker_T :
				// 양극 1차 pnp 피커 좌표계 번호
				//START N_Coord_Cathode_TR1_Picker_Sub	: N_Prog_Cathode_TR1_Picker_Sub_Program;			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				//START N_Coord_Cathode_TR1_Picker_Slave	: N_Prog_Cathode_TR1_Picker_Slave_Program;		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
			break;
			
			case N_Anode_1st_PNP_Unit :	
				// 음극 1차 PNP 좌표계 번호
				START N_Coord_Anode_TR1_Sub				: N_Prog_Anode_TR1_Sub_Program;
				START N_Coord_Anode_TR1_Slave			: N_Prog_Anode_TR1_Slave_Program;
				start N_Coord_Anode_TR1_Z_Slave			: N_Prog_Anode_TR1_Z_Slave_Program;
				//// 음극 1차 pnp 피커 좌표계 번호
				//P_Coord_3 = 12;
				//P_Coord_4 = 22;																																							 
			break;

			case N_Anode_1st_Picker_T :
				// 음극 1차 pnp 피커 좌표계 번호
				//START N_Coord_Anode_TR1_Picker_Sub		: N_Prog_Anode_TR1_Picker_Sub_Program;			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				//START N_Coord_Anode_TR1_Picker_Slave	: N_Prog_Anode_TR1_Picker_Slave_Program;			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
			break
			
			case N_Cathode_Clamp_Unit : 
				START N_Coord_Cathode_Clamp_Sub			: N_Prog_Cathode_Clamp_Sub_Program;
				START N_Coord_Cathode_Clamp_Slave		: N_Prog_Cathode_Clamp_Slave_Program;
			break;
			
			case N_Anode_Clamp_Unit :
				START N_Coord_Anode_Clamp_Sub			: N_Prog_Anode_Clamp_Sub_Program;
				START N_Coord_Anode_Clamp_Slave			: N_Prog_Anode_Clamp_Slave_Program;
			break;
			
			case N_Stack_Table_Unit :
				START N_Coord_Stack_Table_Sub			: N_Prog_Stack_Table_Sub_Program;
				START N_Coord_Stack_Table_Slave			: N_Prog_Stack_Table_Slave_Program;
			break;
			
			case N_Cathode_2nd_PNP_Unit :						
				START N_Coord_Cathode_TR2_Sub			: N_Prog_Cathode_TR2_Sub_Program;
				START N_Coord_Cathode_TR2_Slave			: N_Prog_Cathode_TR2_Slave_Program;
				start N_Coord_Cathode_TR2_Z_Slave		: N_Prog_Cathode_TR2_Z_Slave_Program;
			break;
			
			case N_Anode_2nd_PNP_Unit :						
				START N_Coord_Anode_TR2_Sub				: N_Prog_Anode_TR2_Sub_Program;
				START N_Coord_Anode_TR2_Slave			: N_Prog_Anode_TR2_Slave_Program;
				start N_Coord_Anode_TR2_Z_Slave			: N_Prog_Anode_TR2_Z_Slave_Program;
			break;
			
			case N_Cathode_Align_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_Align_Unit :				
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;
								
			case N_Finall_Roller_X_Unit :						
				START N_Coord_Final_Roll_Sub			: N_Prog_Final_Roll_Sub_Program;
				START N_Coord_Final_Roll_Slave			: N_Prog_Final_Roll_Slave_Program;
			break;
			
			case N_Finall_Roller_Z_Unit :						
				START N_Coord_Final_Roll_Sub			: N_Prog_Final_Roll_Sub_Program;
				START N_Coord_Final_Roll_Slave			: N_Prog_Final_Roll_Slave_Program;
			break;

			case N_Sheet_Paper_Unit :
				START N_Coord_Sheet_Paper_TR1_Slave		: N_Prog_Sheet_Paper_TR1_Slave_Program;
			break;

			case N_Cathode_NG_PNP_Total_Unit :
			case N_Cathode_NG_PNP_T :
				START N_Coord_Cathode_NG_TR_Slave		: N_Prog_Cathode_NG_TR_Slave_Program;
			break

			case N_Cathode_NG_PNP_Z :
				START N_Coord_Cathode_NG_TR_Slave		: N_Prog_Cathode_NG_TR_Slave_Program;
			break;

			case N_Anode_NG_PNP_Total_Unit :
			case N_Anode_NG_PNP_T :
				START N_Coord_Anode_NG_TR_Slave			: N_Prog_Anode_NG_TR_Slave_Program;
			break;

			case N_Anode_NG_PNP_Z :
				START N_Coord_Anode_NG_TR_Slave			: N_Prog_Anode_NG_TR_Slave_Program;
			break

			case N_1st_UND_X :
				START N_Coord_Unload_TR1_Slave			: N_Prog_Unload_TR1_Slave_Program;
			break

			case N_1st_UND_Z :
				START N_Coord_Unload_TR1_Slave			: N_Prog_Unload_TR1_Slave_Program;
			break

			case N_1st_UND_T :
				START N_Coord_Unload_TR1_Slave			: N_Prog_Unload_TR1_Slave_Program;
			break

			case N_Clamp_FR_Run :
				START N_Coord_Anode_Clamp_Sub			: N_Prog_Anode_Clamp_Sub_Program;
				START N_Coord_Anode_Clamp_Slave			: N_Prog_Anode_Clamp_Slave_Program;
				START N_Coord_Final_Roll_Sub			: N_Prog_Final_Roll_Sub_Program;
				START N_Coord_Final_Roll_Slave			: N_Prog_Final_Roll_Slave_Program;
				START N_Coord_Cathode_Clamp_Sub			: N_Prog_Cathode_Clamp_Sub_Program;
				START N_Coord_Cathode_Clamp_Slave		: N_Prog_Cathode_Clamp_Slave_Program;
			break
		}

//		if( P_Single_Run_Unit != N_Clamp_FR_Run )
//		{
//			if( P_Coord_1 != 0 )											// 좌표계 활성화.
//				cmd"&%ub%ur",P_Coord_1,P_Coord_1;							// 좌표계 활성화.
//			if( P_Coord_2 != 0 )											// 좌표계 활성화.
//				cmd"&%ub%ur",P_Coord_2,P_Coord_2;							// 좌표계 활성화.
//			if( P_Coord_3 != 0 )											// 좌표계 활성화.
//				cmd"&%ub%ur",P_Coord_3,P_Coord_3;							// 좌표계 활성화.
//			if( P_Coord_4 != 0 )											// 좌표계 활성화.
//				cmd"&%ub%ur",P_Coord_4,P_Coord_4;							// 좌표계 활성화.
//		}
//		else if ( P_Single_Run_Unit == N_Clamp_FR_Run )
//		{
//			START N_Coord_Anode_Clamp_Sub			: N_Prog_Anode_Clamp_Sub_Program;
//			START N_Coord_Final_Roll_Sub			: N_Prog_Final_Roll_Sub_Program;
//			START N_Coord_Cathode_Clamp_Sub			: N_Prog_Cathode_Clamp_Sub_Program;
//		}

		rtn = N_TRUE;													// 반환값 업데이트. [TRUE]		

	return

	// 5.좌표계 활성화 확인
	sub:Coord_Activate_Check(Unit, &rtn)
		rtn = 0;
		switch ( Unit )
		{
			case N_Cathode_1st_PNP_Unit :
				if ( Coord[20].ProgRunning == 1 && Coord[30].ProgRunning == 1 )	// 좌표계 활성화 확인.	
				{
					rtn = N_TRUE;										// 반환값 업데이트. [TRUE]		
				}
				else													// 좌표계 비활성화 일 경우.
				{
					P_Error_Monitoring_Count_4++; 						// 모니터링 카운트 증가.
					rtn = N_FALSE;										// 반환값 업데이트. [FALSE]
				}	
			break;

			case N_Cathode_1st_Picker_T :
				//if ( Coord[19].ProgRunning == 1 && Coord[29].ProgRunning == 1 )	// 좌표계 활성화 확인.		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]		
				//{
				//	rtn = N_TRUE;										// 반환값 업데이트. [TRUE]		
				//}
				//else													// 좌표계 비활성화 일 경우.
				//{
				//	P_Error_Monitoring_Count_4++; 						// 모니터링 카운트 증가.
				//	rtn = N_FALSE;										// 반환값 업데이트. [FALSE]
				//}	
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]
			break;

			case N_Cathode_2nd_PNP_Unit :
				if ( Coord[18].ProgRunning == 1 && Coord[28].ProgRunning == 1 )	// 좌표계 활성화 확인.	
				{
					rtn = N_TRUE;										// 반환값 업데이트. [TRUE]		
				}
				else													// 좌표계 비활성화 일 경우.
				{
					P_Error_Monitoring_Count_4++; 						// 모니터링 카운트 증가.
					rtn = N_FALSE;										// 반환값 업데이트. [FALSE]
				}	
			break;

			case N_Anode_1st_PNP_Unit :
