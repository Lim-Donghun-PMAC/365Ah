EncTable[0].ScaleFactor = 1/256;	///1024//16384				// 결과 단위는 LSB 

// 2. 아우터 모터 설정
Motor[0].ServoCtrl = 1;											// 모터 기동 
Motor[0].PhaseCtrl = 0;											// PMAC 에 의한 전류(commutation) 없음 
Motor[0].pEnc = EncTable[0].a;									// ECT 항목 0의 결과를 사용 
Motor[0].pEnc2 = EncTable[0].a;									// ECT 항목 0의 결과를 사용 
Motor[0].pLimits = 0;											// 하드웨어 위치 리미트 없음 
Motor[0].pAmpFault = 0;											// 앰프 폴트 입력 없음
Motor[0].Servo.Kp = 1.2; 
Motor[0].Servo.Kvfb = 0; 
Motor[0].Servo.Kvff = 0;
Motor[0].Servo.Kaff = 0;
Motor[0].Servo.Ki	= 0;
Motor[0].FatalFeLimit = 0;
Motor[0].WarnFeLimit = 0;
//Motor[0].Servo.BreakPosErr = 10				//test후 추가예정 불감대 영역 KP영역을 구동 기준으로 잡아서, 모터 구동하지 않을때, 게인값을 잡아줘서 진동이 우는걸 방지해줌. PIDCtrl일때는 사용안함
