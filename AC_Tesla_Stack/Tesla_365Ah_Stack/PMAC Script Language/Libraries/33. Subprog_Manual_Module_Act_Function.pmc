		if( motor[N_FINAL_ROLL_Z].AmpEna == 0 )						// 파이널롤러 z축	 모터 활성화 체크
		{
			cmd"#13j/";
		}
		rtn = 1;
	return

	//음극 Align MSA 모션 좌표계 활성화 체크
	sub:Anode_Align_MSA_Motion_ProgActive(&rtn)
		rtn = 0;
		// 음극 2차 pnp T 모션 프래그램 온 확인.
		if( Coord[23].ProgActive == 0 )
		{	// 음극 2차 pnp 모션 프로그램이 온이 아닐 경우 음극 2차 pnp 모션프로그램 실행 명령어 날림.
			cmd"&23b23r"
		}
		// 음극 2차 pnp  Z 모션 프래그램 온 확인.
		if( Coord[38].ProgActive == 0 )
		{	// 음극 2차 pnp 모션 프로그램이 온이 아닐 경우 음극 2차 pnp 모션프로그램 실행 명령어 날림.
			cmd"&38b38r"
		}
		// 음극 1차 pnp T 모션 프래그램 온 확인.
		if( Coord[21].ProgActive == 0 )
		{	// 음극 1차 pnp 모션 프로그램이 온이 아닐 경우 음극 1차 pnp 모션프로그램 실행 명령어 날림.
			cmd"&21b21r"
		}
		// 음극 1차 pnp Z 모션 프래그램 온 확인.
		if( Coord[37].ProgActive == 0 )
		{	// 음극 1차 pnp 모션 프로그램이 온이 아닐 경우 음극 1차 pnp 모션프로그램 실행 명령어 날림.
			cmd"&37b37r"
		}
		// 파이널롤 모션 프래그램 온 확인.
		if( Coord[25].ProgActive == 0 )
		{	//파이널롤 모션 프로그램이 온이 아닐 경우 파이널롤 모션프로그램 실행 명령어 날림.
			cmd"&25b25r"
		}
		// NG PNP 모션 프래그램 온 확인.
		if( Coord[33].ProgActive == 0 )
		{	//파이널롤 모션 프로그램이 온이 아닐 경우 파이널롤 모션프로그램 실행 명령어 날림.
			cmd"&33b33r"
		}
		// 음극 1차 Picker 모션 프로그램 온		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
		//if( Coord[22].ProgActive == 0 )
		//{	//음극 1차 Picker 모션 프로그램이 온이 아닐 경우 파이널롤 모션프로그램 실행 명령어 날림.
		//	cmd"&22b22r"
		//}
		rtn = 1;
	return

