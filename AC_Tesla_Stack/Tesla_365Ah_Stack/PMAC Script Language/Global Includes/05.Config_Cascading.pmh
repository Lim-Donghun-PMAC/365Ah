CompTable[0].Sf[0]= -0.006;										// 단일 스케일 계수(활성일 때)


 Sys.CompEnable = 0;//1 //-> 보정테이블 유효 갯수

 #endif
// MasterFollowing 변수 시작.
// 드라이빙 외경
//반지름 20mm
//지금 : 40mm
//둘레 : 40*3.14  = 125.6
global P_Driving_Circumference = 125.6;
global P_PLC06_Spool_Circumference = 0;												// 세파 외경 
// Master Following 
 // 언와인더 모터번호 23 , 24
 // 드라이빙 롤러 모터 번호 15
 Motor[N_UNWINDER_UPPER].pMasterEnc = EncTable[N_DRIVING_ROLL].a;		// 출력 실축 마스터 엔코더 
 Motor[N_UNWINDER_UPPER].MasterCtrl = 0;								// 추종 시작 ( 0 안함 : 1 사용 )
 Motor[N_UNWINDER_UPPER].SlewMasterPosSf = 0;
 Motor[N_UNWINDER_UPPER].MasterPosSf = P_Driving_Circumference / P_PLC06_Spool_Circumference ;
 Motor[N_UNWINDER_UPPER].SlewMasterPosSf = 1


