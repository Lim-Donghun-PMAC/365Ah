//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.09 김성중 선임
// MSA 모듈화 프로그래밍 진행 - [ 참조 : 25.07.09 MSA 프로그램 신규 추가 ] 
// 25.07.28 김성중 선임 
// Cal, Cleaning 위치 이동, Align 탈착 모드 프로그래밍 진행 - [ 참조 : 25.07.28 Cal 프로그램 및 얼라인 탈착 모드 신규 추가 ]  

open subprog Subprog_Mainprocess_VISION_Manual_Act_Module(void)

sub: Management(&rtn)

// 로컬변수 선언 (완료 감시 변수 초기화)
//=============================================================================================================================================
// 1. 얼라인 MSA 
//=============================================================================================================================================
	local L_Subprog_VISION_MSA_Align_Module_Set;										// Type : [ Interface ]			동작 : 초기화 작업
	local L_Subprog_VISION_MSA_Align_Module_Pos_Check;									// Type : [ Interface ]			동작 : 모터 위치 확인
	local L_Subprog_VISION_MSA_Align_Module_1st_Init_to_Belt_Move;						// Type : [ Motor ]				동작 : 1차 벨트 이동  
	local L_Subprog_VISION_MSA_Align_Module_1st_Belt_Down_Move;							// Type : [ Motor ]				동작 : 1차 벨트하강 
	local L_Subprog_VISION_MSA_Align_Module_2nd_Align_Down_Move;						// Type : [ Motor ]				동작 : 2차 얼라인 하강 
	local L_Subprog_VISION_MSA_Align_Module_1st_Belt_Vacume_Enable;						// Type : [ Cylinder ]			동작 : 1차 벨트 흡착 
	local L_Subprog_VISION_MSA_Align_Module_2nd_Vacume_Enable;							// Type : [ Cylinder ]			동작 : 2차 흡착	
	local L_Subprog_VISION_MSA_Align_Module_1st_Belt_Up_Move;							// Type : [ Motor ]				동작 : 1차 벨트 상승 이동
	local L_Subprog_VISION_MSA_Align_Module_2nd_Align_Up_Move;							// Type : [ Motor ]				동작 : 2차 얼라인 상승 이동
	local L_Subprog_VISION_MSA_Align_Module_FinalRoll_Move;								// Type : [ Motor ]				동작 : 파이널롤러 양음극 이동
	local L_Subprog_VISION_MSA_Align_Module_2nd_Stack_Move;								// Type : [ Motor ]				동작 : 2차 PNP 스텍 이동
	local L_Subprog_VISION_MSA_Align_Module_1st_Align_Move;								// Type : [ Motor ]				동작 : 1차 PNP 얼라인 이동
	local L_Subprog_VISION_MSA_Align_Module_1st_Align_Down_Move;						// Type : [ Motor ]				동작 : 1차 PNP 얼라인 하강
	local L_Subprog_VISION_MSA_Align_Module_1st_Blow_Enable;							// Type : [ Cylinder ]			동작 : 1차 PNP 얼라인 파기
	local L_Subprog_VISION_MSA_Align_Module_VISION_Trigger_ON;							// Type : [ DIO ]				동작 : 비전 촬상 트리거 ON
	local L_Subprog_VISION_MSA_Align_Module_1st_Align_Vacume_Enable;					// Type : [ Cylinder ]			동작 : 1차 PNP 얼라인 흡착
	local L_Subprog_VISION_MSA_Align_Module_1st_Align_Up_Move;							// Type : [ Motor ]				동작 : 1차 PNP 얼라인 상승
	local L_Subprog_VISION_MSA_Align_Module_1st_Belt_Move;								// Type : [ Motor ]				동작 : 1차 PNP 벨트 이동
	local L_Subprog_VISION_MSA_Align_Module_Count_Increase;								// Type : [ Interface ]			동작 : 동작 카운트 증가
	//배출 
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_1st_Align_Move;					// Type : [ Motor ]				동작 : 1차 PNP 얼라인 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_1st_Align_Down_Move;				// Type : [ Motor ]				동작 : 1차 PNP 얼라인 하강(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_1st_Align_Blow_Enable;			// Type : [ Cylinder ]			동작 : 1차 PNP 얼라인 파기(MSA 완료)
	local L_Subprog_VISION_MSA_Align_Module_Discharge_1st_Align_Up_Move;				// Type : [ Motor ]				동작 : 1차 PNP 얼라인 상승(MSA 완료)
	local L_Subprog_VISION_MSA_Align_Module_Discharge_1st_Align_to_Init_Move;			// Type : [ Motor ]				동작 : 1차 PNP 대기 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_NG_PNP_Align_Move;				// Type : [ Motor ]				동작 : NG PNP 얼라인 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_NG_PNP_Align_Down_Move;			// Type : [ Motor ]				동작 : NG PNP 얼라인 하강(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_NG_PNP_Align_Vacume_Enable;		// Type : [ Cylinder ]			동작 : NG PNP 얼라인 흡착(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_NG_PNP_Align_Up_Move;				// Type : [ Motor ]				동작 : NG PNP 얼라인 상승(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_NG_PNP_NGBox_Move;				// Type : [ Motor ]				동작 : NG PNP NGBox 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Align_Module_Discharge_NG_PNP_NGBox_Blow_Enable;			// Type : [ Cylinder ]			동작 : NG PNP NGBox 파기(MSA 완료)
	local L_Subprog_VISION_MSA_Align_Module_Discharge_2nd_Align_Move;					// Type : [ Motor ]				동작 : 2차 PNP 얼라인 이동(MSA 완료)
	local L_Subprog_VISION_MSA_Align_Module_Discharge_FR_Init_Move;						// Type : [ Motor ]				동작 : 파이널롤러 대기 위치 이동(MSA 이동)

	
//=============================================================================================================================================
// 2. 스텍 MSA 
//=============================================================================================================================================
	local L_Subprog_VISION_MSA_Stack_Module_Set;										// Type : [ Interface ]			동작 : 초기화 작업
	local L_Subprog_VISION_MSA_Stack_Module_Pos_Check;									// Type : [ Interface ]			동작 : 모터 위치 확인
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Align_Down_Move							// Type : [ Motor ]				동작 : 2차 PNP 얼라인 하강 
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Vacume_Enable;							// Type : [ Cylinder ]			동작 : 2차 흡착	
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Align_Up_Move;							// Type : [ Motor ]				동작 : 2차 얼라인 상승 이동
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Stack_Move;								// Type : [ Motor ]				동작 : 2차 PNP 스텍 이동
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Stack_Down_Move;						// Type : [ Motor ]				동작 : 2차 PNP 스텍 하강 이동
	local L_Subprog_VISION_MSA_Stack_Module_VISION_Trigger_ON;							// Type : [ DIO]				동작 : 비전 촬상 트리거 ON
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Stack_Up_Move;							// Type : [ Motor ]				동작 : 2차 PNP 스텍 하강 이동
	local L_Subprog_VISION_MSA_Stack_Module_2nd_Align_Move;								// Type : [ Motor ]				동작 : 2차 PNP 얼라인 이동
	local L_Subprog_VISION_MSA_Stack_Module_Count_Increase;								// Type : [ Interface ]			동작 : 동작 카운트 증가
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_2nd_Align_Down_Move;				// Type : [ Motor ]				동작 : 2차 PNP 얼라인 하강(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_2nd_Align_Blow_Enable;			// Type : [ Cylinder ]			동작 : 2차 PNP 얼라인 파기(MSA 완료)
	local L_Subprog_VISION_MSA_Stack_Module_Discharge_2nd_Align_Up_Move;				// Type : [ Motor ]				동작 : 2차 얼라인 상승 이동(MSA 완료)
	local L_Subprog_VISION_MSA_Stack_Module_Discharge_2nd_Stack_Move;					// Type : [ Motor ]				동작 : 2차 PNP 스텍 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_NG_PNP_Align_Move;				// Type : [ Motor ]				동작 : NG PNP 얼라인 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_NG_PNP_Align_Down_Move;			// Type : [ Motor ]				동작 : NG PNP 얼라인 하강(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_NG_PNP_Align_Vacume_Enable;		// Type : [ Cylinder ]			동작 : NG PNP 얼라인 흡착(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_NG_PNP_Align_Up_Move;				// Type : [ Motor ]				동작 : NG PNP 얼라인 상승(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_NG_PNP_NGBox_Move;				// Type : [ Motor ]				동작 : NG PNP NGBox 이동(MSA 완료)
	Local L_Subprog_VISION_MSA_Stack_Module_Discharge_NG_PNP_NGBox_Blow_Enable;			// Type : [ Cylinder ]			동작 : NG PNP NGBox 파기(MSA 완료)
	local L_Subpog_VISION_MSA_Stack_Module_Discharge_2nd_Align_Move;					// Type : [ Motor ]				동작 : 2차 PNP 얼라인 이동(MSA 완료)

//=============================================================================================================================================
// 4. 얼라인 탈착 모드
//=============================================================================================================================================
	Local L_Subprog_VISION_Align_Take_Off_Ready_Pos_Check;									// Type : [ Interface ]				동작 : 모터 위치 확인
	Local L_Subprog_VISION_Align_Take_Off_Ready_Pos_Set;									// Type : [ Interface ]				동작 : 초기화 작업
	Local L_Subprog_VISION_Align_Take_Off_FR_Move;											// Type : [ Motor ]					동작 : 파이널롤러 회피 이동 
	Local L_Subprog_VISION_Align_Take_Off_2nd_PNP_Stack_Move;								// Type : [ Motor ]					동작 : 2차 PNP 스텍 이동
//=============================================================================================================================================


// Align MSA Module Start--------------------------------------------------------------------------------------------------------------------------------

//===============================================
// 1) Align MSA SET					
//===============================================
if( P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) == F_ACT_STATUS_ENABLE )					//Align MSA Set 상태 활성화
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) != F_ACT_STATUS_ENABLE )																						
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) = F_ACT_STATUS_ENABLE;			// 변수 업데이트
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) = N_Ready_Step;			 			// 스텝 머신 실행
	}
	L_Subprog_VISION_MSA_Align_Module_Set = 0;
	call Subprog_Subprocess_VISION_Manual_Module.MSA_Align_Set(P_VISION_MSA_MODE,&L_Subprog_VISION_MSA_Align_Module_Set);	//Align MSA 시퀀스 시작					
	if( L_Subprog_VISION_MSA_Align_Module_Set == N_COMPLETE )																//Align MSA 시퀀스 완료
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) = F_ACT_STATUS_DISABLE;			// 시퀀스 완료 시 상태 비활성화
		rtn = 1;
	}
	else if( L_Subprog_VISION_MSA_Align_Module_Set == N_FALSE )									//Align MSA 시퀀스 미완료 시 
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) = F_ACT_STATUS_ALARM;			// 동작 에러
	}
}
else
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) == F_ACT_STATUS_ENABLE )							
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) = F_ACT_STATUS_INITIAL;		// 엣지 변수 초기화
	}
}

//===============================================
// 2) Align MSA 모터 위치 확인
//===============================================
if( P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) == F_ACT_STATUS_ENABLE )				//Align MSA 모터 체크 상태 활성화
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) != F_ACT_STATUS_ENABLE )																				
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) = F_ACT_STATUS_ENABLE;		// 변수 업데이트
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) = N_Ready_Step;			 		// 스텝 머신 실행
	}
	L_Subprog_VISION_MSA_Align_Module_Pos_Check = 0;
	call Subprog_Subprocess_VISION_Manual_Module.MSA_Motor_Pos_Chk(P_VISION_MSA_MODE,&L_Subprog_VISION_MSA_Align_Module_Pos_Check);		//Align MSA 모터 체크 시퀀스 시작			
	if( L_Subprog_VISION_MSA_Align_Module_Pos_Check == N_COMPLETE )																		//Align MSA 모터 체크 시퀀스 완료
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) = F_ACT_STATUS_DISABLE;			// 시퀀스 완료 시 상태 비활성화
		rtn = 1;
	}
	else if( L_Subprog_VISION_MSA_Align_Module_Pos_Check == N_FALSE )									    //Align MSA 모터 체크 시퀀스 미완료 시 
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) = F_ACT_STATUS_ALARM;		    // 동작 에러
	}
}
else
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) == F_ACT_STATUS_ENABLE )							
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) = F_ACT_STATUS_INITIAL;	// 엣지 변수 초기화
	}
}

//===============================================
// 3) Align MSA 1차 벨트 이동
//===============================================
if( P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) == F_ACT_STATUS_ENABLE )				//Align MSA 1차 벨트 이동 상태 활성화
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) != F_ACT_STATUS_ENABLE )					
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) = F_ACT_STATUS_ENABLE;			// 변수 업데이트
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) = N_Ready_Step;			 			// 스텝 머신 실행
	}
	L_Subprog_VISION_MSA_Align_Module_1st_Init_to_Belt_Move = 0;
	call Subprog_Subprocess_VISION_Manual_Module.MSA_Align_1st_Init_to_Belt_Move(P_VISION_MSA_MODE,&L_Subprog_VISION_MSA_Align_Module_1st_Init_to_Belt_Move);		//Align MSA 1차 벨트 이동 시퀀스 시작			
	if( L_Subprog_VISION_MSA_Align_Module_1st_Init_to_Belt_Move == N_COMPLETE )														//Align MSA 1차 벨트 이동 시퀀스 완료
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) = F_ACT_STATUS_DISABLE;							// 시퀀스 완료 시 상태 비활성화
		rtn = 1;
	}
	else if( L_Subprog_VISION_MSA_Align_Module_1st_Init_to_Belt_Move == N_FALSE )													//Align MSA 1차 벨트 이동 미완료 시 
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) = F_ACT_STATUS_ALARM;								// 동작 에러
	}
}
else
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) == F_ACT_STATUS_ENABLE )						
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) = F_ACT_STATUS_INITIAL;						// 엣지 변수 초기화	
	}
}

//===============================================
// 4-1) Align MSA 1차 벨트 하강 
//===============================================
if( P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) == F_ACT_STATUS_ENABLE )									//Align MSA 1차 벨트 하강 상태 활성화
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) != F_ACT_STATUS_ENABLE )														
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) = F_ACT_STATUS_ENABLE;							// 변수 업데이트
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) = N_Ready_Step;			 							// 스텝 머신 실행
	}
	L_Subprog_VISION_MSA_Align_Module_1st_Belt_Down_Move = 0;
	call Subprog_Subprocess_VISION_Manual_Module.MSA_1st_PNP_Belt_Down_Move(P_VISION_MSA_MODE,&L_Subprog_VISION_MSA_Align_Module_1st_Belt_Down_Move);	//Align MSA 1차 벨트 하강 시퀀스 시작 
	if( L_Subprog_VISION_MSA_Align_Module_1st_Belt_Down_Move == N_COMPLETE )														//Align MSA 1차 벨트 하강 시퀀스 완료
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) = F_ACT_STATUS_DISABLE;								// 시퀀스 완료 시 상태 비활성화
		rtn = 1;
	}
	else if( L_Subprog_VISION_MSA_Align_Module_1st_Belt_Down_Move == N_FALSE )
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) = F_ACT_STATUS_ALARM;									// 동작 에러
	}
}
else
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) == F_ACT_STATUS_ENABLE )									
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) = F_ACT_STATUS_INITIAL;							// 엣지 변수 초기화
	}
}

//===============================================
// 4-2) Align MSA 2차 얼라인 하강 
//===============================================
if( P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Align_Down_Move) == F_ACT_STATUS_ENABLE )									//Align MSA 2차 얼라인 하강 상태 활성화 
{
	if( P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Align_Down_Move) != F_ACT_STATUS_ENABLE )													
	{
		P_OLD_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Align_Down_Move) = F_ACT_STATUS_ENABLE;							// 변수 업데이트
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) = N_Ready_Step;			 							// 스텝 머신 실행
	}
	L_Subprog_VISION_MSA_Align_Module_2nd_Align_Down_Move = 0;
	call Subprog_Subprocess_VISION_Manual_Module.MSA_2nd_PNP_Align_Down_Move(P_VISION_MSA_MODE,&L_Subprog_VISION_MSA_Align_Module_2nd_Align_Down_Move);	//Align MSA 2차 얼라인 하강 시퀀스 시작 	
	if( L_Subprog_VISION_MSA_Align_Module_2nd_Align_Down_Move == N_COMPLETE )														//Align MSA 2차 얼라인 하강 시퀀스 완료
	{
		P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Align_Down_Move) = F_ACT_STATUS_DISABLE;								// 시퀀스 완료 시 상태 비활성화
		rtn = 1;
	}
	else if( L_Subprog_VISION_MSA_Align_Module_2nd_Align_Down_Move == N_FALSE )
	{
