global P_ARC_Name_Plate_Passive_Status = 0;	// NP Plate 가능 상태.
global P_ARC_Passive_Status = 0;			// UI 터치 가능 상태.
global P_NP_Spool_Number = 0;				// ARC Spool 번호.
global P_ARC_Page_On = 0;					// ARC Page.

/*
[search]
---------------------------------------------------------------------------------------------------
|							램		프		동		작		진		행							  |
|-------------------------------------------------------------------------------------------------|
|	     상부	   |	    하부		  |							조		건						  |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_1st_Step | N_Lower_1st_Step |		언와인더 언척											  |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_2nd_Step | N_Lower_2nd_Step |		언와인더 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 OFF    |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_3rd_Step | N_Lower_3rd_Step |		언와인더 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 ON	  |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_4th_Step | N_Lower_4th_Step |		언와인더 척 + 틸팅 0도								  |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_5th_Step | N_Lower_5th_Step |		언와인더 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF   |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_6th_Step | N_Lower_6th_Step |		언와인더 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON    |
|-------------------------------------|-----------------------------------------------------------|
| N_Upper_7th_Step | N_Lower_7th_Step |		언와인더 척 + 틸팅 90도								  |
---------------------------------------------------------------------------------------------------*/

#define N_Upper_1st_Step		M_Y_Upper_Unwinder_Lock_Sol^$1 && M_Y_Upper_Unwinder_UnLock_Sol
#define N_Upper_2nd_Step		M_Y_Upper_Unwinder_Lock_Sol && M_Y_Upper_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear && M_Y_Sepa_Upper_ARC_Ejector_Vac_On && M_X_ARC_NP_Upper_Plate_Vac_On^$1
#define N_Upper_3rd_Step		M_Y_Upper_Unwinder_Lock_Sol && M_Y_Upper_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear && M_Y_Sepa_Upper_ARC_Ejector_Vac_On && M_X_ARC_NP_Upper_Plate_Vac_On
#define N_Upper_4th_Step		M_Y_Upper_Unwinder_Lock_Sol && M_Y_Upper_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear
#define N_Upper_5th_Step		M_Y_Upper_Unwinder_Lock_Sol && M_Y_Upper_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Upper_ARC_Tilting_Sensor_Front && M_X_Sepa_Upper_ARC_Tilting_Sensor_Rear && M_Y_Sepa_Upper_ARC_Ejector_Vac_On && M_X_ARC_NP_Upper_Plate_Vac_On^$1
#define N_Upper_6th_Step		M_Y_Upper_Unwinder_Lock_Sol && M_Y_Upper_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Upper_ARC_Tilting_Sensor_Front && M_X_Sepa_Upper_ARC_Tilting_Sensor_Rear && M_Y_Sepa_Upper_ARC_Ejector_Vac_On && M_X_ARC_NP_Upper_Plate_Vac_On
#define N_Upper_7th_Step		M_Y_Upper_Unwinder_Lock_Sol && M_Y_Upper_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Upper_ARC_Tilting_Sensor_Front && M_X_Sepa_Upper_ARC_Tilting_Sensor_Rear

#define N_Lower_1st_Step		M_Y_Lower_Unwinder_Lock_Sol^$1 && M_Y_Lower_Unwinder_UnLock_Sol
#define N_Lower_2nd_Step		M_Y_Lower_Unwinder_Lock_Sol && M_Y_Lower_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear && M_Y_Sepa_Lower_ARC_Ejector_Vac_On && M_X_ARC_NP_Lower_Plate_Vac_On^$1
#define N_Lower_3rd_Step		M_Y_Lower_Unwinder_Lock_Sol && M_Y_Lower_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear && M_Y_Sepa_Lower_ARC_Ejector_Vac_On && M_X_ARC_NP_Lower_Plate_Vac_On
#define N_Lower_4th_Step		M_Y_Lower_Unwinder_Lock_Sol && M_Y_Lower_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear
#define N_Lower_5th_Step		M_Y_Lower_Unwinder_Lock_Sol && M_Y_Lower_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Lower_ARC_Tilting_Sensor_Front && M_X_Sepa_Lower_ARC_Tilting_Sensor_Rear && M_Y_Sepa_Lower_ARC_Ejector_Vac_On && M_X_ARC_NP_Lower_Plate_Vac_On^$1
#define N_Lower_6th_Step		M_Y_Lower_Unwinder_Lock_Sol && M_Y_Lower_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Lower_ARC_Tilting_Sensor_Front && M_X_Sepa_Lower_ARC_Tilting_Sensor_Rear && M_Y_Sepa_Lower_ARC_Ejector_Vac_On && M_X_ARC_NP_Lower_Plate_Vac_On
#define N_Lower_7th_Step		M_Y_Lower_Unwinder_Lock_Sol && M_Y_Lower_Unwinder_UnLock_Sol^$1 && M_X_Sepa_Lower_ARC_Tilting_Sensor_Front && M_X_Sepa_Lower_ARC_Tilting_Sensor_Rear

//=============//
