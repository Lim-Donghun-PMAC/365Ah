//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.06.04 박성민 책임
// 모듈화 프로그래밍 진행 - [ 참조 : 25.06.04 모듈화 프로그램 신규 추가 ] 

open plc 11

#define	L_System_Timer				Sys.Time		// 시스템 타이머

Local L_PLC11_Time_Cycle_Up_Count_Start_Time;		// Plc[11].ldata.L[0]	시간 체크 시작 시간
Local L_PLC11_Time_Cycle_Up_Count_End_Time;			// Plc[11].ldata.L[1]	시간 체크 종료 시간
Local L_PLC11_Time_Cycle_Up_Count_Delta_Time;		// Plc[11].ldata.L[2]	시작과 종료 시간 사이의 시간
Local L_PLC11_Flag_Cycle_Up_Count_Init_Flag;		// Plc[11].ldata.L[3]	타이머 초기화 플래그
local L_Module_Interval_Timer;						// Plc[11].ldata.L[4]	서브 프로그램 인터벌 타이머
local L_Module_Set_Interval_Time=5;					// Plc[11].ldata.L[5]	서브 프로그램 리드 주기 타임
local L_Act_Management_Active;						// Plc[11].ldata.L[6]	서브 프로그램 활성화

// 시퀀스 발생 변수			
local L_Discharge_Seq_Command_Occurs;				// Plc[10].ldata.L[7]	맨드릴1			시퀀스 발생 변수 

// Acting 동작 번호 													
local L_Discharge_Seq_Data;							// Plc[10].ldata.L[8]	맨드릴1			Acting 동작 번호

// 인터락 타이머 
local L_Discharge_seq_InterLock_Timer;				// Plc[10].ldata.L[9]	P1시퀀스			인터락 타이머.	24.06.10 추가.

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_PLC11_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_PLC11_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_PLC11_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_PLC11_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 00.2) 시간 체크
if( L_PLC11_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_PLC11_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_PLC11_Time_Cycle_Up_Count_Delta_Time = (L_PLC11_Time_Cycle_Up_Count_End_Time - L_PLC11_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_PLC11_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_PLC11_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_PLC11_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	//L_Sub_Interval_Timer = L_Sub_Interval_Timer + L_PLC11_Time_Cycle_Up_Count_Delta_Time;
	L_Module_Interval_Timer = L_Module_Interval_Timer + L_PLC11_Time_Cycle_Up_Count_Delta_Time;
	L_Discharge_seq_InterLock_Timer = L_Discharge_seq_InterLock_Timer + L_PLC11_Time_Cycle_Up_Count_Delta_Time;	

	L_PLC11_Time_Cycle_Up_Count_Start_Time = L_PLC11_Time_Cycle_Up_Count_End_Time;
	L_PLC11_Time_Cycle_Up_Count_Delta_Time = 0;
}


// All Home Sub Program 
// 1. 회피 조건 감지란


close
