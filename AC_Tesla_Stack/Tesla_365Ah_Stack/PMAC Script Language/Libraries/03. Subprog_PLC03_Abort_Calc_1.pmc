					Motor[N_A_1st_PNP_M_Num].AbortTs = P_A_1st_PNP_BWD_AbortTs;							// AbortTs 업데이트.
					P_A_1st_PNP_BWD_AbortTa_Buffer = P_A_1st_PNP_BWD_AbortTa;							// AbortTa 저장.		[ 참조 : 25.07.29 Abort 프로그램 수정 ]
					P_A_1st_PNP_BWD_AbortTs_Buffer = P_A_1st_PNP_BWD_AbortTs;							// AbortTs 저장. 
