// 모션 프로그램 On
sub: Master_Motion_Program_On(&rtn)
	P_Sub_Master_Motion_Program_Flag(0),F_Type_Coord_EA = 1;
	P_Slave_Motion_Program_Flag(0),F_Type_Coord_EA = 1;			
	P_Master_Motion_Program_Flag = 1;									// 마스터 플래그
	rtn = F_TRUE;
return

// 모션 프로그램 Off
Sub: Master_Motion_Program_OFF(&rtn)

	P_Sub_Master_Motion_Program_Flag(0),F_Type_Coord_EA = 0;	//언로더,NG PNP
	P_Slave_Motion_Program_Flag(0),F_Type_Coord_EA = 0;			// 슬레이브 플래그
	P_Master_Motion_Program_Flag = 0;
	
	rtn = F_TRUE;		
return

// 타임베이스 On
sub: Timebase_On(&rtn)
	local L_Index = 1;
	Coord[1].pDesTimeBase = Coord[1].DesTimeBase.a;
	while(L_Index < Sys.MaxCoords)
	{
		Coord[L_Index].pDesTimeBase = Coord[1].DesTimeBase.a;
		L_Index++;
	}
	rtn = F_TRUE;
	// 나머지 좌표계 입력
return

// 타임베이스 off
Sub: Timbase_OFF(&rtn)
	local L_Index = 1;
	while( L_Index < Sys.MaxCoords )
	{
		Coord[L_Index].pDesTimeBase = Coord[L_Index].DesTimeBase.a;
		L_Index++;
	}
	rtn = F_TRUE;
return

