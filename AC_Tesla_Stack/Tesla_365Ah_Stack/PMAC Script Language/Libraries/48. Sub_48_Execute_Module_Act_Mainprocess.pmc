			P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_Up) = F_ACT_STATUS_ENABLE;								// 변수 업데이트.
			P_Module_Act_Execute_State_Machine_Array(N_Act_FR_Up) = N_Ready_Step;									// 스텝 머신 실행.
