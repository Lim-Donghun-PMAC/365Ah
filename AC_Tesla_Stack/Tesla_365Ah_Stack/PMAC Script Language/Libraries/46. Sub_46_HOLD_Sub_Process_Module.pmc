//======================================================================================================
// 프로그램 개정이력
//======================================================================================================



open subprog Subprog_Hold_Prod_Process(void)
//========================================================//
// 제거_1) Remove_NG PNP Sub Process 모듈
//========================================================//
sub:Remove_NG_PNP_Queue(&Remove_NG_PNP_Queue_RTN)
		Remove_NG_PNP_Queue_RTN = 0;
	//------------------------------------
	//명령부 - NG PNP Sub Process
	//------------------------------------
	IF ( P_PLC01_Hold_Remove_NG_PNP_Sub_Flag == F_Command_Start )
	{
		P_PLC01_Hold_Remove_NG_PNP_Sub_Flag = 0;
		P_PLC01_Hold_Remove_NG_PNP_Sub_Status = F_Status_STARTING;
		P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = 1;
	}
	IF ( P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine == 0 )
	{
		P_PLC01_Hold_Remove_NG_PNP_Sub_Status = F_Status_IDLE;
	}
	//------------------------------------
	//실행부 - NG PNP Sub Process
	//------------------------------------
	IF ( P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine == 1 )			// 1) NG PNP 이동 시간 결정
	{
		P_PLC01_Hold_Remove_NG_PNP_Sub_Status = F_Status_EXECUTE;
		if( P_Slow_NG_Mode_Btn == 0 )
		{
			// NG PNP Turn - 300ms
			P_NG_PNP_Turn_TM = 160
			P_NG_PNP_Turn_TS = 55
			P_NG_PNP_Turn_TA = 75

			// NG PNP 상승 - 100ms
			// NG PNP 상승 - 300ms, 변경 260427
			P_NG_PNP_Up_TM = 200;	// 150
			P_NG_PNP_Up_TS = 50;	// 75
			P_NG_PNP_Up_TA = 50;	// 75

			// NG PNP 하강 - 100ms
			// NG PNP 하강 - 300ms, 변경 260427
			P_NG_PNP_Down_TM = 200;	// 150
			P_NG_PNP_Down_TS = 50;	// 75
			P_NG_PNP_Down_TA = 50;	// 75

			// NG PNP 진공 - 100ms
			P_NG_PNP_Vac_Time = 200

			// NG PNP 블로우 - 100ms
			P_NG_PNP_Blow_Time = 200
		}
		else
		{
			// NG PNP Turn - 1500ms
			P_NG_PNP_Turn_TM = 1000
			P_NG_PNP_Turn_TS = 100
			P_NG_PNP_Turn_TA = 400
			
			// NG PNP 상승 - 500ms
			P_NG_PNP_Up_TM = 300
			P_NG_PNP_Up_TS = 50
			P_NG_PNP_Up_TA = 150

			// NG PNP 상승 - 500ms
			P_NG_PNP_Down_TM = 300
			P_NG_PNP_Down_TS = 50
			P_NG_PNP_Down_TA = 150

			// NG PNP 진공 - 100ms
			P_NG_PNP_Vac_Time = 500

			// NG PNP 블로우 - 100ms
			P_NG_PNP_Blow_Time = 500
		}
		P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = 2;
	}
	IF ( P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine == 2 )			// 2) NG PNP 이동 시간 결정 확인
	{
		P_PLC01_Hold_Remove_NG_PNP_Sub_Status = F_Status_EXECUTE;
		if( P_Slow_NG_Mode_Btn == 0 )
		{
			//if (P_NG_PNP_Turn_TM == 200 && P_NG_PNP_Turn_TS == 15 && P_NG_PNP_Turn_TA == 80 && P_NG_PNP_Up_TM == 55 && P_NG_PNP_Up_TS == 5 && P_NG_PNP_Up_TA == 35 && P_NG_PNP_Down_TM == 55 && P_NG_PNP_Down_TS == 5 && P_NG_PNP_Down_TA == 35 && P_NG_PNP_Vac_Time == 100 && P_NG_PNP_Blow_Time == 100)
			//{
				P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = 3;
			//}
			//else
			//{
			//	P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = 1;
			//}
		}
		else
		{
			//if (P_NG_PNP_Turn_TM == 1000 && P_NG_PNP_Turn_TS == 100 && P_NG_PNP_Turn_TA == 400 && P_NG_PNP_Up_TM == 300 && P_NG_PNP_Up_TS == 50 && P_NG_PNP_Up_TA == 150 && P_NG_PNP_Down_TM == 300 && P_NG_PNP_Down_TS == 50 && P_NG_PNP_Down_TA == 150 && P_NG_PNP_Vac_Time == 500 && P_NG_PNP_Blow_Time == 500)
			//{
				P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = 3;
			//}
			//else
			//{
			//	P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = 1;
			//}
		}
	}

	IF ( P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine == 3 )			// 3) 완료단계 이동
	{
		P_PLC01_Hold_Remove_NG_PNP_Sub_Status = F_Status_EXECUTE;
		P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine = N_Complete_Step;
	}	
	IF ( P_PLC01_Hold_Remove_NG_PNP_Sub_State_Machine == N_Complete_Step )	// 4) 완료 단계 
	{
		Remove_NG_PNP_Queue_RTN = N_TRUE;
		P_PLC01_Hold_Remove_NG_PNP_Sub_Status = F_Status_COMPLETE;
	}

return

//========================================================//
// 제거_2) Remove_Align Sub Process 모듈
//========================================================//
sub:Remove_Align_Queue(&Remove_Align_Queue_RTN)
		Remove_Align_Queue_RTN = 0;
	//------------------------------------
	//명령부 - NG PNP Sub Process
	//------------------------------------
	IF ( P_PLC01_Hold_Remove_Align_Sub_Flag == F_Command_Start )
	{
		P_PLC01_Hold_Remove_Align_Sub_Flag = 0;
		P_PLC01_Hold_Remove_Align_Sub_Status = F_Status_STARTING;
		P_PLC01_Hold_Remove_Align_Sub_State_Machine = 1;
	}
	IF ( P_PLC01_Hold_Remove_Align_Sub_State_Machine == 0 )
	{
		P_PLC01_Hold_Remove_Align_Sub_Status = F_Status_IDLE;
	}
	//------------------------------------
	//실행부 - NG PNP Sub Process
	//------------------------------------
	IF ( P_PLC01_Hold_Remove_Align_Sub_State_Machine == 1 )			// 1) NG PNP 이동 시간 결정
	{
		P_PLC01_Hold_Remove_Align_Sub_Status = F_Status_EXECUTE;
		if( P_Slow_NG_Mode_Btn == 0 )
		{
			// NG PNP Turn - 300ms
			P_NG_PNP_Turn_TM = 160
			P_NG_PNP_Turn_TS = 55
			P_NG_PNP_Turn_TA = 75

			// NG PNP 상승 - 100ms
			// NG PNP 상승 - 300ms, 변경 260427
			P_NG_PNP_Up_TM = 150
			P_NG_PNP_Up_TS = 75
			P_NG_PNP_Up_TA = 75

			// NG PNP 하강 - 100ms
			// NG PNP 하강 - 300ms, 변경 260427
			P_NG_PNP_Down_TM = 150
			P_NG_PNP_Down_TS = 75
			P_NG_PNP_Down_TA = 75

			// NG PNP 진공 - 200ms, 변경 260427
			P_NG_PNP_Vac_Time = 200

			// NG PNP 블로우 - 200ms, 변경 260427
			P_NG_PNP_Blow_Time = 200
		}
		else
		{
			// NG PNP Turn - 1500ms
			P_NG_PNP_Turn_TM = 1000
			P_NG_PNP_Turn_TS = 100
			P_NG_PNP_Turn_TA = 400
			
			// NG PNP 상승 - 500ms
			P_NG_PNP_Up_TM = 300
			P_NG_PNP_Up_TS = 50
			P_NG_PNP_Up_TA = 150

			// NG PNP 상승 - 500ms
			P_NG_PNP_Down_TM = 300
			P_NG_PNP_Down_TS = 50
			P_NG_PNP_Down_TA = 150

			// NG PNP 진공 - 100ms
			P_NG_PNP_Vac_Time = 500

			// NG PNP 블로우 - 100ms
			P_NG_PNP_Blow_Time = 500
		}
		P_PLC01_Hold_Remove_Align_Sub_State_Machine = 2;

	}
	IF ( P_PLC01_Hold_Remove_Align_Sub_State_Machine == 2 )			// 3) 완료단계 이동
	{
		P_PLC01_Hold_Remove_Align_Sub_Status = F_Status_EXECUTE;
		P_PLC01_Hold_Remove_Align_Sub_State_Machine = N_Complete_Step;
	}	
	IF ( P_PLC01_Hold_Remove_Align_Sub_State_Machine == N_Complete_Step )	// 4) 완료 단계 
	{
		Remove_Align_Queue_RTN = N_TRUE;
		P_PLC01_Hold_Remove_Align_Sub_Status = F_Status_COMPLETE;
	}
return
//========================================================//
// 공급) Supply_1TR_Judge 판단 모듈
//========================================================//
sub:Supply_1TR_Judge(&Supply_1TR_Judge_RTN)
	
	Supply_1TR_Judge_RTN = 0;
	//------------------------------------
	//명령부 - Supply_1TR_Judge
	//------------------------------------
	P_PLC01_Hold_Supply_1TR_Memory_RTN = 0;

	if( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos)
	{
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP, &P_Anode_2nd_Unit_Status, &P_PLC01_Hold_Supply_1TR_Memory_RTN);
		IF ( P_PLC01_Hold_Supply_1TR_Memory_RTN == 1 )
		{
			P_PLC01_Hold_Supply_1TR_Judge_Flag = 1;
		}

	}
	else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos )
	{
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP, &P_Cathode_2nd_Unit_Status, &P_PLC01_Hold_Supply_1TR_Memory_RTN);
		IF ( P_PLC01_Hold_Supply_1TR_Memory_RTN == 1 )
		{
			P_PLC01_Hold_Supply_1TR_Judge_Flag = 1;
		}
	}
	//------------------------------------
	//실행부 - Supply_1TR_Judge
	//------------------------------------
	IF ( P_PLC01_Hold_Supply_1TR_Judge_Flag == 1 )
	{
		P_PLC01_Hold_Supply_1TR_Judge_Flag = 0;
		P_Plate_1TR_Supply_Module_Judge_Bit = 0;			

		P_PLC01_Hold_Supply_1TR_Judge_Status = F_Status_STARTING
		P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 1;
	}
	IF (P_PLC01_Hold_Supply_1TR_Judge_State_Machine == 0 )
	{
		P_PLC01_Hold_Supply_1TR_Judge_Status = F_Status_IDLE;

	}
	IF (P_PLC01_Hold_Supply_1TR_Judge_State_Machine == 1)
	{
		P_PLC01_Hold_Supply_1TR_Judge_Status = F_Status_EXECUTE;

		//=====================================================================================================================================================================
		// 1) F/R 방향이 양극 방향일 경우 
		//=====================================================================================================================================================================

		if( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos)								// 1) 파이널롤러 양극 방향 위치 할 경우
		{		
			if(Sys_Anode_2nd_Sheet_Data != 0 && Sys_Anode_Align_Sheet_Data == 0 )		// 1.1) 2차 pnp에 극판이 존재하여 얼라인 공급을 할 필요가 없어 1차 pnp 극판 공급 후 대기위치에서 마무리
			{
				P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_1;			//     → 변수 1
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			}
			else if(Sys_Anode_2nd_Sheet_Data == 0 && Sys_Anode_Align_Sheet_Data != 0 )	// 1.2) 2차 pnp 미존재, 얼라인 극판 존재  (1차 pnp에 극판 공급 시 2차 pnp도 동시에 하강->흡착->상승 진행)
			{
				if ( P_Anode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos )                // 1.2.1) 2차 PNP 위치가 스텍 상승 위치일 경우 
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_2;			//     → 변수 2
				}
				else if( P_Anode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos )			// 1.2.2) 2차 PNP 위치가 얼라인 상승 위치일 경우 
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_3;			//     → 변수 3
				}
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			}
			else if(Sys_Anode_2nd_Sheet_Data == 0 && Sys_Anode_Align_Sheet_Data == 0)	// 1.3) 2차 pnp와 얼라인에 극판 미존재 (1차 pnp 극판 공급 후 얼라인 위치에서 마무리)
			{
				if( P_Anode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos )					// 1.3.1) 2차 pnp가 얼라인에 있으므로 1차 pnp 극판 공급 후 1차/2차 pnp 동시 진입
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_4;			//     → 변수 4
				}
				else if ( P_Anode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos )			// 1.3.2) 2차 pnp가 이미 Stack 위치에 있으므로 1차 pnp 극판 공급 후 1차 pnp만 얼라인 이동
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_5;			//     → 변수 5
				}
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			}
			else
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			
		}
		//=====================================================================================================================================================================
		// 2) F/R 방향이 음극 or 대기 or 배출 위치일 경우
		//=====================================================================================================================================================================
		else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos)	// 2) 파이널롤러 음극 방향, 대기 배출 위치일 경우 
		{	
			if(Sys_Cathode_2nd_Sheet_Data != 0 && Sys_Cathode_Align_Sheet_Data == 0 )		// 2.1) 2차 pnp에 극판이 존재하여 얼라인 공급을 할 필요가 없어 1차 pnp 극판 공급 후 대기위치에서 마무리
			{
				P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_1;				//     → 변수 1
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			}
			else if(Sys_Cathode_2nd_Sheet_Data == 0 && Sys_Cathode_Align_Sheet_Data != 0 )	// 2.2) 2차 pnp 미존재, 얼라인 극판 존재 (1차 pnp에 극판 공급 시 2차 pnp도 동시에 하강->흡착->상승 진행)
			{
				if ( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos )
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_2;			//     → 변수 2
				}
				else if( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos )
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_3;			//     → 변수 3
				}
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			}
			else if(Sys_Cathode_2nd_Sheet_Data == 0 && Sys_Cathode_Align_Sheet_Data == 0)	// 2차 pnp와 얼라인에 극판 미존재로 1차 pnp 극판 공급 후 얼라인 위치에서 마무리
			{
				if( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos )	// 2차 pnp가 얼라인에 있으므로 1차 pnp 극판 공급 후 1차/2차 pnp 동시 진입
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_4;			//     → 변수 4
				}
				else if ( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Stack_Up_Pos )	// 2차 pnp가 이미 Stack 위치에 있으므로 1차 pnp 극판 공급 후 1차 pnp만 얼라인 이동
				{
					P_Plate_1TR_Supply_Module_Judge_Bit = N_Plate_1TR_Supply_5;			//     → 변수 5
				}
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			}
			else
				P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
			
		}
		else
		{
			P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
		}
		//P_PLC01_Hold_Supply_1TR_Judge_State_Machine = 2;
	}
	IF (P_PLC01_Hold_Supply_1TR_Judge_State_Machine == 2)
	{
		P_PLC01_Hold_Supply_1TR_Judge_Status = F_Status_EXECUTE;

		P_Buffer_Judge_Trg(5) = P_Buffer_Judge_Trg(4);	
		P_Buffer_Judge_Trg(4) = P_Buffer_Judge_Trg(3);	
		P_Buffer_Judge_Trg(3) = P_Buffer_Judge_Trg(2);	
		P_Buffer_Judge_Trg(2) = P_Buffer_Judge_Trg(1);	
		P_Buffer_Judge_Trg(1) = P_Buffer_Judge_Trg(0);	
		P_Buffer_Judge_Trg(0) = P_Plate_1TR_Supply_Module_Judge_Bit;

		Supply_1TR_Judge_RTN = N_TRUE;

		P_PLC01_Hold_Supply_1TR_Judge_State_Machine = N_Complete_Step;
	}
	IF (P_PLC01_Hold_Supply_1TR_Judge_State_Machine == 999)
	{
		P_PLC01_Hold_Supply_1TR_Judge_Status = F_Status_COMPLETE;
	}
Return;


close



