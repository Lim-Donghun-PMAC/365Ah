			Motor[N_1st_PnP_AN_T].HomeOffset = P_ABS_Home_Offset_Data(2);
			Motor[N_2nd_PnP_CA_T].HomeOffset = P_ABS_Home_Offset_Data(3);
			Motor[N_2nd_PnP_AN_T].HomeOffset = P_ABS_Home_Offset_Data(4);
		#endif
		
		cmd"#1..4 hmz";
		sendallcmds									// 모든 커맨드문 버퍼를 비워냄
		while (Ldata.CmdStatus == 1) {}				// 모든 커맨드문 버퍼가 비워질 때 까지 대기
		call Timer.sec(2);
	//}
