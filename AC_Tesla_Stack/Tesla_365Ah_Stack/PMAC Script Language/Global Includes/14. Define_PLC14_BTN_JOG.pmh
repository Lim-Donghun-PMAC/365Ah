// BTN Lamp 인자.
#define Ready_BTN	1						// Ready 버튼.
#define Start_BTN	2						// Start 버튼.
#define Stop_BTN	3						// Stop 버튼.

#define Turn_Off	1						// 소등.
#define Blinking	2						// 점멸.
#define Turn_On		3						// 점등.

global P_Lamp_Blinking_Timer = 0;			// 점멸을 위한 램프 타이머.
#define Blinking_Time	500

global P_BTN_Ready_Lamp = 0;				// Ready 램프.	[매칭 후 변수명 변경 필요]
global P_BTN_Start_Lamp = 0;				// Start 램프.	[매칭 후 변수명 변경 필요]
global P_BTN_Stop_Lamp = 0;					// Stop 램프.	[매칭 후 변수명 변경 필요]


