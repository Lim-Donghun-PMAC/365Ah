#define N_1st_Cathode				0
#define N_2nd_Cathode				1
#define N_NG_Cathode				2
#define N_Align_Cathode				3
#define N_1st_Anode					4
#define N_2nd_Anode					5
#define N_NG_Anode					6
#define N_Align_Anode				7

//		양극 1차 pnp 흡착 , 양극 2차 pnp 흡착, 양극 ng pnp 흡착, 양극 얼라인 흡착
//		음극 1차 pnp 흡착, 음극 2차 pnp 흡착, 음극 ng pnp 흡착, 음극 얼라인 흡착
 
#define N_Cathode_vacuum_Check_Bit				( P_PLC12_Vacuum_MNTR(N_1st_Cathode) << 0 | P_PLC12_Vacuum_MNTR(N_2nd_Cathode) << 1 | P_PLC12_Vacuum_MNTR(N_NG_Cathode) << 2 | P_PLC12_Vacuum_MNTR(N_Align_Cathode) << 3 )
#define N_Anode_vacuum_Check_Bit				( P_PLC12_Vacuum_MNTR(N_1st_Anode) << 4 | P_PLC12_Vacuum_MNTR(N_2nd_Anode) << 5 | P_PLC12_Vacuum_MNTR(N_NG_Anode) << 6 | P_PLC12_Vacuum_MNTR(N_Align_Anode) << 7 )
#define N_Observe_vacuum_Bit					( N_Cathode_vacuum_Check_Bit | N_Anode_vacuum_Check_Bit )

//		양극 1차 pnp 파기 , 양극 2차 pnp 파기, 양극 ng pnp 파기
//		음극 1차 pnp 파기, 음극 2차 pnp 파기, 음극 ng pnp 파기

#define N_Cathode_Blow_Check_Bit				( P_PLC12_Blow_MNTR(N_1st_Cathode) << 0 | P_PLC12_Blow_MNTR(N_2nd_Cathode) << 1 | P_PLC12_Blow_MNTR(N_NG_Cathode) << 2 | P_PLC12_Blow_MNTR(N_Align_Cathode) << 3 )
#define N_Anode_Blow_Check_Bit					( P_PLC12_Blow_MNTR(N_1st_Anode) << 4 | P_PLC12_Blow_MNTR(N_2nd_Anode) << 5 | P_PLC12_Blow_MNTR(N_NG_Anode) << 6 | P_PLC12_Blow_MNTR(N_Align_Anode) << 7 )
#define N_Observe_Blow_Bit						( N_Cathode_Blow_Check_Bit | N_Anode_Blow_Check_Bit )


#define N_Cathode_1st_PNP_Masking						$1		// 0x01
#define N_Cathode_2nd_PNP_Masking						$2		// 0x02
#define N_Cathode_NG_PNP_Masking						$4		// 0x04
#define N_Cathode_Align_Masking							$8		// 0x08
#define N_Anode_1st_PNP_Masking							$10		// 0x10
#define N_Anode_2nd_PNP_Masking							$20		// 0x20
#define N_Anode_NG_PNP_Masking							$40		// 0x40
#define N_Anode_Align_Masking							$80		// 0x80

