				//////음극 1차 P&P //////	
				P_Slave1_Anode_Run_Motion_Array(22)=10;		// 대기 -> A/S 위치 이동.
				//////음극 2차 P&P //////
				P_Slave17_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave3_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.
				//////음극 클램프 //////
				//////FINAL ROLL //////
				//////STACK TABLE //////
				//////양극 클램프 //////
				P_Slave7_Anode_Run_Motion_Array(29)=1;		// Clamp Off
				//////양극 2차 P&P //////
				//////양극 1차 P&P //////
				P_Slave10_Anode_Run_Motion_Array(22)=11;	// 대기 -> belt 이동	
				P_Align_NG_Tack_Flag = 1;
			// 3) 결과값 리턴.
				Result = F_Result_Complete;

				P_Anode_Cur_Mode = F_Frist_Sepa_Semi_Run;
		break;
		// [ 참 조 : 2025.12.12 세파 첫장 세미런 추가 ] 
		case F_Frist_Sepa_Sepa_Semi_Run :		// 양극 얼라인 NG처리를 위한 음극런 사이클.	24.01.31 추가.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Anode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.
				// 2.1) Init
				P_Slave1_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave10_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave16_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Anode_Run_Motion_Array(0),100,1 = 0;
				// 2.2) 입력.
				//////음극 1차 P&P //////
				//////음극 2차 P&P //////
				P_Slave17_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave3_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.
				//////음극 클램프 //////
				//////FINAL ROLL //////
				//////STACK TABLE //////
				//////양극 클램프 //////
				P_Slave7_Anode_Run_Motion_Array(29)=1;		// Clamp Off
				//////양극 2차 P&P //////
				//////양극 1차 P&P //////
				P_Align_NG_Tack_Flag = 1;
			// 3) 결과값 리턴.
				Result = F_Result_Complete;

				P_Anode_Cur_Mode = F_Frist_Sepa_Sepa_Semi_Run;
		break;

		default: 	break;
	}
return

sub: Cathode_Run( Type, Trg, &Result )
	switch(Type)
	{
		case F_Normal_Run :	// 일반 런.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Cathode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.	
				// 2.1) Init
				P_Slave1_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave10_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave16_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Cathode_Run_Motion_Array(0),100,1 = 0;
				// 2.2) 입력.
				//////음극 1차 P&P //////
				P_Slave16_Cathode_Run_Motion_Array(45)=3;	//P_Slave1_Cathode_Run_Motion_Array(45)=3;	 A/S 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Cathode_Run_Motion_Array(53)=12;	//P_Slave1_Cathode_Run_Motion_Array(53)=12;	 A/S 블로우.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Cathode_Run_Motion_Array(60)=4;	//P_Slave1_Cathode_Run_Motion_Array(60)=4;	 A/S 상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Cathode_Run_Motion_Array(67)=2;	// A/S -> Belt이동.											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave1_Cathode_Run_Motion_Array(67)=2;	// A/S -> Belt이동.
				//////음극 2차 P&P //////
				P_Slave17_Cathode_Run_Motion_Array(45)=3;	//P_Slave3_Cathode_Run_Motion_Array(45)=3;	 Stack 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(53)=11;	//P_Slave3_Cathode_Run_Motion_Array(53)=11;	 Stack 블로우.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(60)=4;	//P_Slave3_Cathode_Run_Motion_Array(60)=4;	 Stack 상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(67)=2;	// Align 이동.												// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave3_Cathode_Run_Motion_Array(67)=2;	// Align 이동.		
				//////음극 클램프 //////
				if ( P_Anode_Count == 0 )					// 세파 첫장에 클램프를 하지 않아 Cathode Run 진행 시 표창 모드 발생을 막기 위함		[ 참조 : 26.05.28 세파 첫장 시 클램프 미진행 ]
				{}
				else
				{
					P_Slave4_Cathode_Run_Motion_Array(74)=1;	// Clamp Off.
				}
				//////FINAL ROLL //////
				P_Slave5_Cathode_Run_Motion_Array(66)=1;	// 음극방향 이동
				P_Slave15_Cathode_Run_Motion_Array(P_Cathode_Run_DR) = 1;	// 음극방향으로 이동할때  // 드라이빙
				//////STACK TABLE //////
				P_Slave6_Cathode_Run_Motion_Array(58) = 2;	// 극판 두께만큼 하강
				//////양극 클램프 //////
				P_Slave7_Cathode_Run_Motion_Array(46)=2;	// 클램프 on.
				P_Slave7_Cathode_Run_Motion_Array(59)=3;	// 클램프 on.
				//////양극 2차 P&P //////
				P_Slave18_Cathode_Run_Motion_Array(45)=5;	//P_Slave8_Cathode_Run_Motion_Array(45)=5;	 A/S하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Cathode_Run_Motion_Array(53)=10;	//P_Slave8_Cathode_Run_Motion_Array(53)=10;	 A/S흡착.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Cathode_Run_Motion_Array(60)=6;	//P_Slave8_Cathode_Run_Motion_Array(60)=6;	 A/S상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Cathode_Run_Motion_Array(67)=1;	// Stack 이동.												// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave8_Cathode_Run_Motion_Array(67)=1;	// Stack 이동.
				//////양극 Picker T //////
				//P_Slave9_Cathode_Run_Motion_Array(67)=1;	//PickerT좌표계 PNP에 묶음으로 인하여 Run Mode 배열 주석 처리  [ 참조 : 26.08.14 PickerT 모션 변경 ] // 180 Deg 회전.		[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				//////양극 1차 P&P //////
				P_Slave19_Cathode_Run_Motion_Array(45)=5;   //P_Slave10_Cathode_Run_Motion_Array(45)=5;  BELT 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Cathode_Run_Motion_Array(53)=13;  //P_Slave10_Cathode_Run_Motion_Array(53)=13; BELT 흡착.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Cathode_Run_Motion_Array(60)=6;   //P_Slave10_Cathode_Run_Motion_Array(60)=6;  BELT 상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Cathode_Run_Motion_Array(67)=1;   // Align 이동.												// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave10_Cathode_Run_Motion_Array(67)=1;   // Align 이동.
			// 3) 결과값 리턴.
				Result = F_Result_Complete;		
				
				P_Cathode_Cur_Mode = F_Normal_Run;	
		break;
		case F_Last_Run :	// 일반 라스트런.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Cathode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.	
				// 2.1) Init
				P_Slave1_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave10_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave16_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Cathode_Run_Motion_Array(0),100,1 = 0;
				// 2.2) 입력.
				//////음극 1차 P&P //////
				P_Slave16_Cathode_Run_Motion_Array(45)=3;	//P_Slave1_Cathode_Run_Motion_Array(45)=3;	 A/S 하강.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Cathode_Run_Motion_Array(53)=12;	//P_Slave1_Cathode_Run_Motion_Array(53)=12;	 A/S 블로우.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Cathode_Run_Motion_Array(60)=4;	//P_Slave1_Cathode_Run_Motion_Array(60)=4;	 A/S 상승.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Cathode_Run_Motion_Array(67)=9;	// A/S -> 대기 위치 이동.									// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave1_Cathode_Run_Motion_Array(67)=9;	// A/S -> 대기 위치 이동.	
				//////음극 2차 P&P //////
				P_Slave17_Cathode_Run_Motion_Array(45)=3;	//P_Slave3_Cathode_Run_Motion_Array(45)=3;	 Stack 하강.	 // [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(53)=11;	//P_Slave3_Cathode_Run_Motion_Array(53)=11;	 Stack 블로우// [ 참 조 : 2025.11.24 Z축 분리 ].
				P_Slave17_Cathode_Run_Motion_Array(60)=4;	//P_Slave3_Cathode_Run_Motion_Array(60)=4;	 Stack 상승.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(67)=2;	// Align 이동.											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave3_Cathode_Run_Motion_Array(67)=2;	// Align 이동.	
				//////음극 클램프 //////
				P_Slave4_Cathode_Run_Motion_Array(74)=1;	// Clamp Off.
				//////FINAL ROLL //////
				//P_Slave5_Cathode_Run_Motion_Array(66)=1;	// 음극방향 이동
				//P_Slave15_Cathode_Run_Motion_Array(P_Cathode_Run_DR) = 1;	// 음극방향으로 이동할때  // 드라이빙
				P_Slave5_Cathode_Run_Motion_Array(66)=8;	/// 라스트런 FR 
				P_Slave15_Cathode_Run_Motion_Array(P_Cathode_Run_DR) = 8;	// 라스트런 DR 
				//////STACK TABLE //////
				P_Slave6_Cathode_Run_Motion_Array(58) = 2;	// 극판 두께만큼 하강
				//////양극 클램프 //////
				P_Slave7_Cathode_Run_Motion_Array(46)=2;	// 클램프 on.
				P_Slave7_Cathode_Run_Motion_Array(59)=3;	// 클램프 on.
				//////양극 2차 P&P //////
				//////양극 1차 P&P //////
				P_Slave10_Cathode_Run_Motion_Array(67)=9;   // Align 이동.
				P_Slave19_Cathode_Run_Motion_Array(67)=9;   // Align 이동.											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Execute_Last_Run_Flag = 1;				// 배출 시작 플래그 ON [ 2025.06.18 서스펜드 추가 ]	 
			// 3) 결과값 리턴.
				Result = F_Result_Complete;			

				
				P_Cathode_Cur_Mode = F_Last_Run;	
		break;
		case F_Sepa_Run : 	// 세파 런.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Cathode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.	
				// 2.1) Init
				P_Slave1_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave10_Cathode_Run_Motion_Array(0),100,1 = 0;
				P_Slave16_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Cathode_Run_Motion_Array(0),100,1 = 0;
				// 2.2) 입력.
				//////음극 1차 P&P //////
				//////음극 2차 P&P //////
				P_Slave17_Cathode_Run_Motion_Array(45)=3;	// P_Slave3_Cathode_Run_Motion_Array(45)=3; Stack 하강.	 // [ 참 조 : 2025.11.24 Z축 분리 ]

				// [ 참조 : 2025.07.25 Sepa Blow 모션 추가 ]
				P_Slave17_Cathode_Run_Motion_Array(53)=13;	// P_Slave3_Cathode_Run_Motion_Array(53)=13; Stack 블로우.// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(60)=4;	// P_Slave3_Cathode_Run_Motion_Array(60)=4;	 Stack 상승.	 // [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Cathode_Run_Motion_Array(67)=2;	// Align 이동.											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave3_Cathode_Run_Motion_Array(67)=2;	// Align 이동.	
				//////음극 클램프 //////
				if ( P_Anode_Count == 0 )					// 세파 첫장에 클램프를 하지 않아 Cathode Run 진행 시 표창 모드 발생을 막기 위함		[ 참조 : 26.05.28 세파 첫장 시 클램프 미진행 ]
				{}
				else
				{
					P_Slave4_Cathode_Run_Motion_Array(74)=1;	// Clamp Off.
				}
				//////FINAL ROLL //////
				P_Slave5_Cathode_Run_Motion_Array(66)=1;	// 음극방향 이동
				P_Slave15_Cathode_Run_Motion_Array(P_Cathode_Run_DR) = 1;	// 음극방향으로 이동할때  // 드라이빙
				//////STACK TABLE //////
