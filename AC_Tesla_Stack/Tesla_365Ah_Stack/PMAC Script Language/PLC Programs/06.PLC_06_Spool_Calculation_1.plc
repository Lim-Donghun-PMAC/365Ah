//	// 파이널 롤 드라이빙 캠테이블 부동소수점으로 인한 보상(배출 시 진행)값 수식.
//	P_FR_Driving_Reward = P_FR_Driving_Floating_Point * (P_Cathode_Recipe_Count + P_Anode_Recipe_Count) / 1000;	// 부동 소수점으로 인한 값 * 적층 수 / 1000(1mm당 Cnt)
//}

// 드라이빙 롤 회전 시 언와인더 마스터 팔로잉 스케일 변경.	[ 참조 : 25.10.16 드라이빙 롤 회전 시 언와인더 마스터 팔로잉 스케일 변경 추가 ]
if ( P_Unwinder_Master_Following_Use_Flag == 1 )		// 언와인더 마스터 팔로잉 사용 플래그 [ 0 : 미사용, 1 : 마스터 팔로잉 ]
{
	if ( P_Unwinder_Master_Following_On )				// 마스터 팔로잉 사용 중일 경우 [ 0 : 미사용, 1 : 사용 ]
	{
		if ( Sys.udata[501] == F_Status_STARTING && Sys.udata[501] != P_Old_Master_Following_Start )			// 한번만 적용.
		{
			P_Unwinder_Master_Following_Scale = P_PI * P_FR_Driving_Diameter / P_PLC06_Spool_Circumference;		// Scale = 파이널 롤 드라이빙 외경 / 현재 스풀 외경.
			Motor[L_Selected_Spool_Number].MasterPosSf = P_Unwinder_Master_Following_Scale * -1;	// * -1 : 방향 반대.
		}
	}
	P_Old_Master_Following_Start = Sys.udata[501];		// Edge 값 업데이트.
}
// 드라이빙 롤 회전 시 언와인더 조그 이동.	[ 참조 : 25.10.16 드라이빙 롤 회전 시 언와인더 조그 이동 수식 추가 ]
if ( P_Unwinder_Jog_Use_Flag == 1 )						// 언와인더 조그 사용 플래그 [ 0 : 미사용, 1 : Jog 구동 ]
{
	if ( Sys.udata[501] == F_Status_STARTING && Sys.udata[501] != P_Old_Jog_Start )		// 한번만 실행.
	{
		P_Unwinder_1mm_Deg = P_PLC06_Spool_Circumference / 360;	// 언와인더 1도 당 세파 길이.
		P_Unwinder_Jog_Cnt = P_Unwinder_Jog_Pos / P_Unwinder_1mm_Deg * 1000;	// 언와인더 움직여야하는 거리. ( 요구 거리 / 1도 당 거리 = 움직여야할 각도 * 1000(mm → cnt) )
		Motor[L_Selected_Spool_Number].JogTa = P_Unwinder_Ta;	// JogTa 설정.
		Motor[L_Selected_Spool_Number].JogTs = P_Unwinder_Ts;	// JogTs 설정.
		Motor[L_Selected_Spool_Number].JogSpeed = P_Unwinder_Jog_Cnt / P_Unwinder_Tm;	// 최고 속도 = 가야할 거리 / TM시간.
		if ( L_Selected_Spool_Number == N_UNWINDER_UPPER )
			jog23:(P_Unwinder_Jog_Cnt * -1);			// 가야할 거리 이동. [cnt] [ *-1 : 언와인터 풀어주는 것이 -방향이기 때문 ]
		else if ( L_Selected_Spool_Number == N_UNWINDER_LOWER )
			jog24:(P_Unwinder_Jog_Cnt * -1);			// 가야할 거리 이동. [cnt] [ *-1 : 언와인터 풀어주는 것이 -방향이기 때문 ]
	}									
	P_Old_Jog_Start = Sys.udata[501];					// Edge 값 업데이트.
}
