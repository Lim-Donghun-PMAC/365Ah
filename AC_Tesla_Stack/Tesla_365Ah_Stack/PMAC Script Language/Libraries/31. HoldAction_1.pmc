//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.xx.xx 
// 내용 - [ 참조 : 25.xx.xx 내용 ]



open subprog MotionAction(Data, &rtn)
	rtn = 0;
	P_DataList(0),5,1 = 0;

	P_DataList(N_Obj) = Data & Hex_Obj_Masking;		// 유닛 선택
	P_DataList(N_Cmd) = Data & Hex_Cmd_Masking;		// 수평이동, 수직이동, 진공, 블로우, 스탑
	P_DataList(N_Dst) = Data & Hex_Dst_Masking;		// 목적지
	P_DataList(N_Cur) = Data & Hex_Cur_Masking;		// 현재위치
	P_DataList(N_Elec) = Data & Hex_Elec_Masking;	// 음극 or 양극

	P_Hold_Data_OK = 0

	P_Anode_1st_Motion_Complete = 1
	P_Anode_2nd_Motion_Complete = 1
	P_Anode_NG_PNP_Motion_Complete = 1
	P_Anode_1st_Picker_Motion_Complete = 1
	
	P_Cathode_1st_Motion_Complete = 1
	P_Cathode_2nd_Motion_Complete = 1
	P_Cathode_NG_PNP_Motion_Complete = 1
	P_Cathode_1st_Picker_Motion_Complete = 1


	// 움직이는 유닛 파악 후 해당 유닛 변수 0으로 만듬(모션 완료 시 1로 만들어서 모션 완료 되었다고 판단하기 위함)
	if( P_DataList(N_Obj) == Hex_1stPNP )
	{
		if(P_DataList(N_Elec) == Hex_Anode_Unit)
			P_Anode_1st_Motion_Complete = 0
		else
			P_Cathode_1st_Motion_Complete = 0
	}
	else if( P_DataList(N_Obj) == Hex_2ndPNP )
	{
		if(P_DataList(N_Elec) == Hex_Anode_Unit)
			P_Anode_2nd_Motion_Complete = 0
		else
			P_Cathode_2nd_Motion_Complete = 0
	}
	
	else if( P_DataList(N_Obj) == Hex_NgPNP )
	{
		if(P_DataList(N_Elec) == Hex_Anode_Unit)
			P_Anode_NG_PNP_Motion_Complete = 0
		else
			P_Cathode_NG_PNP_Motion_Complete = 0
	}
	else if( P_DataList(N_Obj) == Hex_12PNP )
	{
		if(P_DataList(N_Elec) == Hex_Anode_Unit)
		{
			P_Anode_1st_Motion_Complete = 0
			P_Anode_2nd_Motion_Complete = 0
		}
		else
		{
			P_Cathode_1st_Motion_Complete = 0
			P_Cathode_2nd_Motion_Complete = 0
		}

	}


	switch(P_DataList(N_Obj))
	{
		case Hex_1stPNP:
			switch(P_DataList(N_Cmd))
			{
				case Hex_Cmd_Horizontal:									// 수평 이동			
					if(P_DataList(N_Cur) == Comb_CurComb_BeltUp)			// 1차 PNP 현재 위치 : 벨트 상승
					{
						// 1차 pnp 벨트 -> 대기 위치 이동
						if(P_DataList(N_Dst) == Comb_DstComb_1stReadyUP)
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave1_Motion_Command =  N_1st_PNP_Ready_Pos_Motion
								P_Anode_1st_Picker_Motion_Complete = 0		// 피커 동작 확인 변수 초기화
								P_Slave2_Motion_Command = N_1st_Picker_Turn 
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion
								P_Cathode_1st_Picker_Motion_Complete = 0	// 피커 동작 확인 변수 초기화
								P_Slave9_Motion_Command = N_1st_Picker_Turn 
								P_Hold_Data_OK = 1
							}
							P_Hold_Resume_Need_Flag = 1						 // 홀드 Resume
						}
						// 1차 pnp 벨트 -> 얼라인 이동
						else if(P_DataList(N_Dst) == Comb_DstComb_AlignUp)	// 얼라인 상승
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave1_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
								P_Anode_1st_Picker_Motion_Complete = 0		// 피커 동작 확인 변수 초기화
								P_Slave2_Motion_Command = N_1st_Picker_Turn 
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
								P_Cathode_1st_Picker_Motion_Complete = 0	// 피커 동작 확인 변수 초기화
								P_Slave9_Motion_Command = N_1st_Picker_Turn
								P_Hold_Data_OK = 1
							}
							P_Hold_Resume_Need_Flag = 1						// 홀드 Resume
						}
						else
						{
						}

					}
					else if(P_DataList(N_Cur) == Comb_CurComb_1stReadyUP)	// 1차 pnp 현재 위치 : 대기 위치
					{					
						// 1차 pnp 대기 위치 -> 벨트 이동	
						if(P_DataList(N_Dst) == Comb_DstComb_BeltUp)
						{
							P_Hold_1st_Belt_Move = 0
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Anode_Belt_Move_Timing )
									{
										P_Hold_Anode_Pause_CHK = 1			// 음극 퍼즈
										P_Slave1_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
									if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}								
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Cathode_Belt_Move_Timing )
									{
										P_Hold_Cathode_Pause_CHK = 1					//양극 퍼즈
										P_Slave10_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
									if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}					
							}
							
						}
						// 1차 pnp 대기 위치 -> 얼라인 이동
						else if(P_DataList(N_Dst) == Comb_DstComb_AlignUp)
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave1_Motion_Command = N_1st_PNP_Ready_To_Align_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Ready_To_Align_Motion
								P_Hold_Data_OK = 1
							}
						}
						else{}
					}
					else if(P_DataList(N_Cur) == Comb_CurComb_AlignUp)		// 1차 PNP 현재 위치 : 얼라인 상승
					{
						if(P_DataList(N_Dst) == Comb_DstComb_BeltUp)		// 1차 pnp 얼라인 -> 벨트 이동
						{
							P_Hold_1st_Belt_Move = 0
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Anode_Belt_Move_Timing )
									{
										P_Hold_Anode_Pause_CHK = 1			// 음극 퍼즈
										P_Slave1_Motion_Command = N_1st_PNP_Align_To_Belt_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
										if(P_PMAC_Status == F_Status_STOPPING)
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}				
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Cathode_Belt_Move_Timing )
									{
										P_Hold_Cathode_Pause_CHK = 1					//양극 퍼즈
										P_Slave10_Motion_Command = N_1st_PNP_Align_To_Belt_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
										if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}												
							}
						}
						else if(P_DataList(N_Dst) == Comb_DstComb_1stReadyUP)	// 1차 pnp 얼라인 -> 대기 위치 이동
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)			// 음극
							{
								P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)					// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion
								P_Hold_Data_OK = 1
							}
						}
						else
						{
						
						}
					
					}
					else
					{
					
					}


				break;

				case Hex_Cmd_Vertical:									// 수직 이동
					// 1차 PNP 현재 위치 : 벨트 상승,  1차 PNP 벨트 상승 -> 벨트 하강
					if(P_DataList(N_Cur) == Comb_CurComb_BeltUp && P_DataList(N_Dst) == Comb_DstComb_BeltDn)
					{// 반대만 가능하다.
						P_Hold_1st_Belt_Move = 0
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							while( P_Hold_1st_Belt_Move == 0 )
							{
								if( M_X_PLC_Anode_Sheet_Ready == 1 )
								{
									P_Slave1_Motion_Command = N_1st_PNP_Belt_Down_Motion
									P_Hold_1st_Belt_Move = 1;
									P_Hold_Data_OK = 1
								}

								if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
								{
									P_Hold_1st_Belt_Move = 1;
									rtn = N_Stop_Point
									return;
								}
							}
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							while( P_Hold_1st_Belt_Move == 0 )
							{
								if( M_X_PLC_Cathode_Sheet_Ready == 1 )
								{
									P_Slave10_Motion_Command = N_1st_PNP_Belt_Down_Motion
									P_Hold_1st_Belt_Move = 1;
									P_Hold_Data_OK = 1
								}

								if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
								{
									P_Hold_1st_Belt_Move = 1;
									rtn = N_Stop_Point
									return;
								}
							}
						}

					}
					// 1차 PNP 현재 위치 : 벨트 하강, 1차 PNP 벨트 하강 -> 벨트 상승
					else if(P_DataList(N_Cur) == Comb_CurComb_BeltDn && P_DataList(N_Dst) == Comb_DstComb_BeltUp)			
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave1_Motion_Command = N_1st_PNP_Belt_Up_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave10_Motion_Command = N_1st_PNP_Belt_Up_Motion
							P_Hold_Data_OK = 1
						}

					}
					// 1차 PNP 현재 위치 : 얼라인 상승, 1차 PNP 얼라인 상승 -> 얼라인 하강
					else if(P_DataList(N_Cur) == Comb_CurComb_AlignUp && P_DataList(N_Dst) == Comb_DstComb_AlignDn)				
					{// 반대만 가능하다.
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave1_Motion_Command = N_1st_PNP_Align_Down_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave10_Motion_Command = N_1st_PNP_Align_Down_Motion
							P_Hold_Data_OK = 1
						}
					}
					// 1차 PNP 현재 위치 : 얼라인 하강, 1차 PNP 얼라인 하강 -> 얼라인 상승
					else if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignUp)
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave1_Motion_Command = N_1st_PNP_Align_Up_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave10_Motion_Command = N_1st_PNP_Align_Up_Motion
							P_Hold_Data_OK = 1
						}

					}
					else
					{
					}


				break;

				case Hex_Cmd_Vac:										// 진공
					// 1차 PNP 현재 위치 : 벨트 하강, 1차 PNP 벨트 흡착
					if(P_DataList(N_Cur) == Comb_CurComb_BeltDn && P_DataList(N_Dst) == Comb_DstComb_BeltDn)
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave1_Motion_Command = N_1st_PNP_Belt_Vac
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave10_Motion_Command = N_1st_PNP_Belt_Vac
							P_Hold_Data_OK = 1
						}

					}
					//// 1차 pnp 얼라인 흡착
					//else if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignDn)			// Belt에서 Destination 위치로 갈때,
					//{
					//	if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
					//	{
					//		//P_Slave1_Motion_Command = 
					//	}
					//	else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
					//	{
					//		//P_Slave10_Motion_Command = 
					//	}
					//}
					else
					{
					}

				break;

				case Hex_Cmd_Blow:
					// 1차 PNP 현재 위치 : 얼라인 하강, 얼라인 블로우
					if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignDn)			// Belt에서 Destination 위치로 갈때,
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave1_Motion_Command = N_1st_PNP_Align_Blow
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave10_Motion_Command = N_1st_PNP_Align_Blow
							P_Hold_Data_OK = 1
						}

					}
					else
					{

					}
				break;

				default:
				break;

			}


		break;


		case Hex_2ndPNP:													// 2차 PNP
			switch(P_DataList(N_Cmd))
			{
				case Hex_Cmd_Horizontal:									// 수평 이동
					if(P_DataList(N_Cur) == Comb_CurComb_AlignUp)			// 2차 PNP 현재 위치 : 얼라인 상승
					{
						if(P_DataList(N_Dst) == Comb_DstComb_StackUp)		// 2차 얼라인 -> 스택 이동
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave3_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave8_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
								P_Hold_Data_OK = 1
							}
						}
						else{}

					}
					else if(P_DataList(N_Cur) == Comb_CurComb_StackUp)		// 2차 PNP 현재 위치 : 스택 상승
					{
						// 2차 pnp 스택 -> 얼라인 이동
						if(P_DataList(N_Dst) == Comb_DstComb_AlignUp)		// 2차 PNP 스택 -> 얼라인 이동
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave3_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave8_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
								P_Hold_Data_OK = 1
							}
						}
						else{}
					
					}
					else
					{}


				break;

				case Hex_Cmd_Vertical:									// 수직 이동
					if(P_DataList(N_Cur) == Comb_CurComb_AlignUp && P_DataList(N_Dst) == Comb_DstComb_AlignDn)			// 2차 PNP 현재 위치 : 얼라인 상승, 2차 PNP 얼라인 상승 -> 얼라인 하강
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave3_Motion_Command = N_2nd_PNP_Align_Down_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave8_Motion_Command = N_2nd_PNP_Align_Down_Motion
							P_Hold_Data_OK = 1
						}
					}
					// 2차 pnp 얼라인 상승
					else if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignUp)		// 2차 PNP 현재 위치 : 얼라인 하강, 2차 PNP 얼라인 하강 -> 얼라인 상승
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave3_Motion_Command = N_2nd_PNP_Align_Up_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave8_Motion_Command = N_2nd_PNP_Align_Up_Motion
							P_Hold_Data_OK = 1
						}
					}
					else
					{

					}


				break;

				case Hex_Cmd_Vac:										// 흡착
					if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignDn)	// 2차 PNP 현재 위치 : 얼라인 하강, 얼라인 흡착
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave3_Motion_Command = N_2nd_PNP_Align_Vac
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave8_Motion_Command = N_2nd_PNP_Align_Vac
							P_Hold_Data_OK = 1
						}
					}
					else
					{

					}

				break;

				case Hex_Cmd_Blow:
					// 2차 pnp 얼라인 블로우
					if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignDn)			// 2차 PNP 현재 위치 : 얼라인 하강, 얼라인 블로우
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave3_Motion_Command = N_2nd_PNP_Align_Blow
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave8_Motion_Command = N_2nd_PNP_Align_Blow
							P_Hold_Data_OK = 1
						}
					}
					else
					{

					}
				break;

				default:

				break;

			}

		break;

		case Hex_NgPNP:		// NG PNP
			switch(P_DataList(N_Cmd))
			{
				case Hex_Cmd_Horizontal:									// 수평 이동
					if(P_DataList(N_Cur) == Comb_CurComb_NGReadyUp)			// NG PNP 현재 위치 : NG 박스
					{
						if(P_DataList(N_Dst) == Comb_DstComb_AlignUp)		// NG PNP NG 박스 -> 얼라인 이도
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave13_Motion_Command = N_NG_PNP_NG_To_Align_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave12_Motion_Command = N_NG_PNP_NG_To_Align_Motion
								P_Hold_Data_OK = 1
							}

						}
						else{}

					}
					else if(P_DataList(N_Cur) == Comb_CurComb_AlignUp)		// NG PNP 현재 위치 : 얼라인 상승
					{
						if(P_DataList(N_Dst) == Comb_DstComb_NGReadyUp)		// NG PNP 얼라인 -> NG 박스 이동
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave13_Motion_Command = N_NG_PNP_Align_To_NG_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave12_Motion_Command = N_NG_PNP_Align_To_NG_Motion
								P_Hold_Data_OK = 1
							}
						}
						else
						{
						}
					}
					else
					{}


				break;

				case Hex_Cmd_Vertical:
					// ng pnp 얼라인 하강
					if(P_DataList(N_Cur) == Comb_CurComb_AlignUp && P_DataList(N_Dst) == Comb_DstComb_AlignDn)			// NG PNP 현재 위치 : 얼라인 상승, NG PNP 얼라인 상승 -> 얼라인 하강
					{// 반대만 가능하다.

						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave13_Motion_Command = N_NG_PNP_Align_Down_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave12_Motion_Command = N_NG_PNP_Align_Down_Motion
							P_Hold_Data_OK = 1
						}
					}
					// ng pnp 얼라인 상승
					else if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignUp)			// NG PNP 현재 위치 : 얼라인 하강, NG PNP 얼라인 하강 -> 얼라인 상승
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave13_Motion_Command = N_NG_PNP_Align_UP_Motion
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave12_Motion_Command = N_NG_PNP_Align_UP_Motion
							P_Hold_Data_OK = 1
						}
					}
					else
					{

					}

				break;

				case Hex_Cmd_Vac:
					// ng pnp 얼라인 흡착
					if(P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignDn)		// NG PNP 현재 위치 : 얼라인 하강, 얼라인 흡착
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave13_Motion_Command = N_NG_PNP_Align_Vac
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave12_Motion_Command = N_NG_PNP_Align_Vac
							P_Hold_Data_OK = 1
						}
					}
					else
					{

					}

				break;

				case Hex_Cmd_Blow:
					// NG PNP 현재 위치 : NG 박스 하강 or NG 박스 상승,  NG PNP 블로우
					if((P_DataList(N_Cur) == Comb_CurComb_NGReadyUp && P_DataList(N_Dst) == Comb_DstComb_NGReadyUp) || (P_DataList(N_Cur) == Comb_CurComb_AlignDn && P_DataList(N_Dst) == Comb_DstComb_AlignDn))
					{
						if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
						{
							P_Slave13_Motion_Command = N_NG_PNP_NG_Blow
							P_Hold_Data_OK = 1
						}
						else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
						{
							P_Slave12_Motion_Command = N_NG_PNP_NG_Blow
							P_Hold_Data_OK = 1
						}
					}
					else
					{

					}
				break;

				default:

				break;

			}

		break;

		case Hex_12PNP:		// 1차, 2차 PNP 동시 동작 

			switch(P_DataList(N_Cmd))
			{
				case Hex_Cmd_Horizontal:	// 수평 이동
				
					if(P_DataList(N_Cur) == (Comb_CurComb_BeltUp | Comb_CurComb_AlignUp))			// 1차 PNP 현재 위치 : 벨트 상승, 2차 PNP 현재 위치 : 얼라인 상승
					{
						// 1차 pnp 벨트 -> 얼라인 이동 , 2차 pnp 얼라인 -> 스택 이동
						if(P_DataList(N_Dst) == (Comb_DstComb_AlignUp | Comb_DstComb_StackUp))
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave1_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
								P_Slave3_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
								P_Anode_1st_Picker_Motion_Complete = 0		// 피커 동작 확인 변수 초기화
								P_Slave2_Motion_Command = N_1st_Picker_Turn 
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
								P_Slave8_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
								P_Cathode_1st_Picker_Motion_Complete = 0	// 피커 동작 확인 변수 초기화
								P_Slave9_Motion_Command = N_1st_Picker_Turn 
								P_Hold_Data_OK = 1
							}
							P_Hold_Resume_Need_Flag = 1 // 홀드 Resume
						}

						else{}

					}

					else if(P_DataList(N_Cur) == (Comb_CurComb_AlignUp | Comb_CurComb_StackUp))		// 1차 PNP 현재 위치 : 얼라인 상승, 2차 PNP 현재 위치 : 스택 상승
					{
						// 1차 pnp 얼라인 -> 벨트, 2차 pnp 스택 -> 얼라인
						if(P_DataList(N_Dst) == (Comb_DstComb_BeltUp | Comb_DstComb_AlignUp))
						{
							P_Hold_1st_Belt_Move = 0
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Anode_Belt_Move_Timing )
									{
										P_Hold_Anode_Pause_CHK = 1			// 음극 퍼즈
										P_Slave1_Motion_Command = N_1st_PNP_Align_To_Belt_Motion
										P_Slave3_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
									if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}

							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Cathode_Belt_Move_Timing )
									{
										P_Hold_Cathode_Pause_CHK = 1					//양극 퍼즈
										P_Slave10_Motion_Command = N_1st_PNP_Align_To_Belt_Motion
										P_Slave8_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
										if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}								
								
							}
						}
						else
						{
						}
					}
					else if(P_DataList(N_Cur) == (Comb_CurComb_1stReadyUP | Comb_CurComb_StackUp))		// 1차 PNP 현재 위치 : 대기 상승, 2차 PNP 현재 위치 : 스택 상승
					{
						// 1차 pnp 대기 -> 벨트, 2차 pnp 스택 -> 얼라인
						if(P_DataList(N_Dst) == (Comb_DstComb_BeltUp | Comb_DstComb_AlignUp))
						{
							P_Hold_1st_Belt_Move = 0
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Anode_Belt_Move_Timing )
									{
										P_Hold_Anode_Pause_CHK = 1			// 음극 퍼즈
										P_Slave1_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
										P_Slave3_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
										if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}														
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( P_Master_Motion_Trigger == N_Hold_Cathode_Belt_Move_Timing )
									{
										P_Hold_Cathode_Pause_CHK = 1					//양극 퍼즈
										P_Slave10_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
										P_Slave8_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}
										if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}
								
							}

						}
					}
					else
					{}

				break;

				case Hex_Cmd_Vertical:		// 수직 이동
					
					if(P_DataList(N_Cur) == (Comb_CurComb_BeltUp | Comb_CurComb_AlignUp))			// 1차 PNP 현재 위치 : 벨트 상승, 2차 PNP 현재 위치 : 얼라인 상승
					{// 반대만 가능하다.
						P_Hold_1st_Belt_Move = 0
						// 1차 pnp 벨트 하강, 2차 pnp 얼라인 하강
						if(P_DataList(N_Dst) == (Comb_DstComb_BeltDn | Comb_DstComb_AlignDn))
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( M_X_PLC_Anode_Sheet_Ready == 1 )
									{
										P_Slave1_Motion_Command = N_1st_PNP_Belt_Down_Motion
										P_Slave3_Motion_Command = N_2nd_PNP_Align_Down_Motion
										P_Hold_1st_Belt_Move = 1;
										P_Hold_Data_OK = 1
									}

									if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								while( P_Hold_1st_Belt_Move == 0 )
								{
									if( M_X_PLC_Cathode_Sheet_Ready == 1 )
									{
										P_Slave10_Motion_Command = N_1st_PNP_Belt_Down_Motion
										P_Slave8_Motion_Command = N_2nd_PNP_Align_Down_Motion
										P_Hold_1st_Belt_Move = 1
										P_Hold_Data_OK = 1
									}

									if(P_PMAC_Status == F_Status_STOPPING)	// 1차 PNP가 벨트로 들어가기 전 stop이 되면 시퀀스 종료
									{
										P_Hold_1st_Belt_Move = 1;
										rtn = N_Stop_Point
										return;
									}
								}
							}
						}
						else{}
						
					}
					else if(P_DataList(N_Cur) == (Comb_CurComb_BeltDn | Comb_CurComb_AlignDn))				// 1차 PNP 현재 위치 : 벨트 하강, 2차 PNP 현재 위치 : 얼라인 하강
					{
						// 1차 pnp 벨트 상승, 2차 pnp 얼라인 상승
						if(P_DataList(N_Dst) == (Comb_DstComb_BeltUp | Comb_DstComb_AlignUp))
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave1_Motion_Command = N_1st_PNP_Belt_Up_Motion
								P_Slave3_Motion_Command = N_2nd_PNP_Align_Up_Motion
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Belt_Up_Motion
								P_Slave8_Motion_Command = N_2nd_PNP_Align_Up_Motion
								P_Hold_Data_OK = 1
							}
						}
						else{}
					}
					else
					{

					}

				break;

				case Hex_Cmd_Vac:
					if(P_DataList(N_Cur) == (Comb_CurComb_BeltDn | Comb_CurComb_AlignDn))					// 1차 PNP 현재 위치 : 벨트 하강, 2차 PNP 현재 위치 : 얼라인 하강
					{
						// 1차 pnp 벨? 흡착, 2차 pnp 얼라인 흡착
						if(P_DataList(N_Dst) == (Comb_DstComb_BeltDn | Comb_DstComb_AlignDn))
						{
							if(P_DataList(N_Elec) == Hex_Anode_Unit)		// 음극
							{
								P_Slave1_Motion_Command = N_1st_PNP_Belt_Vac
								P_Slave3_Motion_Command = N_2nd_PNP_Align_Vac
								P_Hold_Data_OK = 1
							}
							else if(P_DataList(N_Elec) == Hex_Cathode_Unit)				// 양극
							{
								P_Slave10_Motion_Command = N_1st_PNP_Belt_Vac
								P_Slave8_Motion_Command = N_2nd_PNP_Align_Vac
								P_Hold_Data_OK = 1
							}
						}
						else{}
						
					}
					else
					{

					}

				break;

				default:

				break;

			}

		break;

		case Hex_1NGPNP:
			
		break;
		case Hex_2NGPNP:

		break;

		default:

		break;

	}

	if( P_Hold_Data_OK == 1 )
		rtn = 1 
	else
	{
		rtn = N_Hold_Data_Err
		//P_Hold_Err_MNTR(N_Hold_Data_Err) = 1
	}


	
close

