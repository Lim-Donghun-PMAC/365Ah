#define	Hex_Cmd_Masking				$0F000000			// 10진수 : 251,658,240
#define	Hex_Dst_Masking				$00FFF000			// 10진수 : 16,773,120
#define	Hex_Cur_Masking				$00000FFF			// 10진수 : 4,095


