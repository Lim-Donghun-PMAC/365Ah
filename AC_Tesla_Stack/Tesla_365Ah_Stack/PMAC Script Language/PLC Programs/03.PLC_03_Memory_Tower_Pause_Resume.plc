//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.04 
// P&P Abort 프로그램 추가 - [ 참조 : 25.07.04 모션 중 P&P AbortTa,Ts 적용 ]

open plc 3
P_MNTR_PLC3_Task_Time(0) = Sys.Time;

#define N_Complete_Step				999		
#define	L_System_Timer				Sys.Time
Local L_Time_Cycle_Up_Count_Start_Time;				// Plc[3].ldata.L[0] 시간 체크 시작 시간
Local L_Time_Cycle_Up_Count_End_Time;				// Plc[3].ldata.L[1] 시간 체크 종료 시간
Local L_Time_Cycle_Up_Count_Delta_Time;				// Plc[3].ldata.L[2] 시작과 종료 시간 사이의 시간
Local L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[3].ldata.L[3] 타이머 초기화 플래그
local L_STMS_Memory_Tower_Status;					// Plc[3].ldata.L[4]
local L_individual_return;							// Plc[3].ldata.L[5]		
local L_Memory_individual_Scan_Complete;			// Plc[3].ldata.L[6]
local L_Complete_Num = 999;							// Plc[3].ldata.L[7]
local L_integrated_return;							// Plc[3].ldata.L[8]
// pause Local Variable								
local L_old_PMAC_Status;							// Plc[3].ldata.L[9]	이전 피맥상태
local L_old_Current_Mode; 							// Plc[3].ldata.L[10]	이전 피맥 모드
local L_old_PMAC_Current_Mode;						// Plc[3].ldata.L[11]	이전 피맥 오토 or 매뉴얼
local L_old_Master_Motion_Trigger;					// Plc[3].ldata.L[12]	이전 마스터트리거
local L_Resume_Timer;								// Plc[3].ldata.L[13]	리줌 타이머 
local L_Pause_Check_Timer;							// Plc[3].ldata.L[14]	퍼즈 타이머
local L_X_A_Site_Puase_Signal;						// Plc[3].ldata.L[15]	퍼즈 시그널 엣지용 변수
local L_X_A_Site_Resume_Signal;						// Plc[3].ldata.L[16]	리줌 시그널 엣지용 변수
local L_X_B_Site_Puase_Signal;						// Plc[3].ldata.L[17]	퍼즈 시그널 엣지용 변수
local L_X_B_Site_Resume_Signal;						// Plc[3].ldata.L[18]	리줌 시그널 엣지용 변수
local L_Once_Check;									// Plc[3].ldata.L[19]	재진입 방지 변수
local L_X_B_Site_To_A_Site_Ack_Pause_Signal;		// Plc[3].ldata.L[20]	퍼즈 아크신호 엣지변수
local L_X_A_Site_To_B_Site_Ack_Pause_Signal;		// Plc[3].ldata.L[21]	퍼즈 아크신호 엣지 변수
local L_Y_A_Site_Heart_Bit;							// Plc[3].ldata.L[22]	리줌 시그널 하트비트 엣지용 변수
local L_X_B_Site_Heart_Bit;							// Plc[3].ldata.L[23]	리줌 시그널 하트비트 엣지용 변수
local L_Abort_check_Variable;						// Plc[3].ldata.L[24]	Abort 엣지변수	
local L_Heart_Bit_Calc_Old;							// Plc[3].ldata.L[25]	P_Stack_Heart_Bit_Calc 엣지변수	

local L_Y_A_Site_Heart_Bit2;						// Plc[3].ldata.L[26]	리줌 시그널 하트비트 엣지용 변수
local L_X_B_Site_Heart_Bit2;						// Plc[3].ldata.L[27]	리줌 시그널 하트비트 엣지용 변수

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
 IF (L_Flag_Cycle_Up_Count_Init_Flag == 0)
{
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 00.2) 시간 체크
IF (L_Flag_Cycle_Up_Count_Init_Flag == 1)
{
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * 1000;

	IF( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
IF (L_Time_Cycle_Up_Count_Delta_Time > 0.1)
{
	P_Pause_Err_Timer = P_Pause_Err_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	P_Stack_Heart_Bit_Timer = P_Stack_Heart_Bit_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}	
//==============================================================================================================================================================

//=============================================================================================================================
// 1) 통합 위치메모리 
//=============================================================================================================================

if ( P_Memory_Tower_Search_Flag == 1 )		// 유닛 위치 검색 
{
	P_Memory_Tower_Search_Flag = 0;
	P_MemTow_integrated_return = 0;	
	//P_Unit_integrated_Status = 0;			// 통합 메모리변수 1차 삭제
	//L_STMS_Memory_Tower_Status = 1;
	P_STMS_Memory_Tower_Status = 222;
}

// 1.1. 유닛별 상태 변수화
switch(P_STMS_Memory_Tower_Status)
{
	// 1.1.0. 동작 대기 및 레시피값 삽입
	case 0 :
		if ( P_Unit_Status_Update_Flag == 1 )			// 무슨 변수지 ??
		{
			L_individual_return = 0;
			call Sub_Unit_Memory_Status.Initialize(&L_individual_return);			// 레시피값 받아오기
			if ( L_individual_return == 1 )
			{
				P_Unit_Status_Update_Flag = 0;
				P_STMS_Memory_Tower_Status = 1;
			}
		}
	break;

	case 222:
		if(P_PMAC_Current_Mode == F_Current_Automatic)
		{
			//if(Total_Inpos_Bit)			[ 참조 : 241119 Heap구조 알람프로그램 추가기능 머지작업_배출텍 ]
			//{
				P_STMS_Memory_Tower_Status = 1;
			//}
		}
		else
		{
			P_STMS_Memory_Tower_Status = 1;
		}
	break;
	// 1.1.1. 음극 1차 PNP 위치 변수화
	case 1 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_1st_PNP,&P_Anode_1st_Unit_Status,&L_individual_return);
		
		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 2;
		}
	break;

	// 1.1.2. 음극 2차 PNP 위치 변수화
	case 2 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP,&P_Anode_2nd_Unit_Status,&L_individual_return);
		
		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 3;
		}
	break;

	// 1.1.3. 음극 클램프 위치 변수화
	case 3 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_Clamp,&P_Anode_CLP_Unit_Status,&L_individual_return);

		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 4;
		}
	break;

	// 1.1.4. 파이널 롤 위치 변수화
	case 4 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Final_Roll,&P_FinalRoll_Unit_Status,&L_individual_return);

		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 5;
		}
	break;

	// 1.1.5. 스텍 테이블 위치 변수화
	case 5 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Stack_Table,&P_StackTable_Unit_Status,&L_individual_return);

		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 6;
		}
	break;

	// 1.1.6. 양극 클램프 위치 변수화
	case 6 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_Clamp,&P_Cathode_CLP_Unit_Status,&L_individual_return);

		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 7;
		}
	break;

	// 1.1.7. 양극 2차 PNP 위치 변수화
	case 7 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP,&P_Cathode_2nd_Unit_Status,&L_individual_return);

		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 8;
		}
	break;

	// 1.1.8. 양극 1차 PNP 위치 변수화
	case 8 :
		L_individual_return = 0;						// 결과 변수 초기화
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_1st_PNP,&P_Cathode_1st_Unit_Status,&L_individual_return);

		if ( L_individual_return == F_TRUE )
		{ 	
			L_individual_return = 0;
			P_STMS_Memory_Tower_Status = 9;
		}
	break;
	// 1.1.9 1차 언로더 위치 변수화
	case 9 :
		if( P_PMAC_Status == F_Status_SUSPENDED || P_PMAC_Status == F_Status_IDLE || P_PMAC_Status == F_Status_RESETTING )		// 배출로 인한 위치 메모리라면 || IDLE 상태에서도 확인 (IDLE 상태에서 위치 변경 시 Commands Stop을 날리기 위함) [ 참조 : 25.08.01 PackML 버튼 프로그램 추가 ]
		{
			L_individual_return = 0;						// 결과 변수 초기화
			call Sub_Unit_Memory_Status.individual_mode(F_1st_Unloader,&P_1st_Unloader_Unit_Status,&L_individual_return);

			if ( L_individual_return == F_TRUE )
			{ 	
				L_individual_return = 0;
				P_STMS_Memory_Tower_Status = 10;
			}
		}
		else											// 1차언로더 <-> 2차 및 3차 언로더 PLC 인터페이스 간 시퀀스로 움직일텐데 Execute 및 Hold에서 위치메모리를 읽었을 시 Error 뜰수도 있으므로
		{
			P_1st_Unloader_Unit_Status = 0;				// 이전에 발생된 언로더 위치값이 저장되어있으므로 초기화 시켜줌
			P_STMS_Memory_Tower_Status = 10;
		}
	break;

	// 1.1.10. 완료
	case 10 :
		if ( P_PMAC_Status == F_Status_IDLE )			// IDLE 상태 일 경우.[ 참조 : 25.08.01 PackML 버튼 프로그램 추가 ]
			P_BTN_Memory_Tower_Check_Bit = 1;			// IDLE 상태에서 메모리 타워 돌린 것 확인.
		L_Memory_individual_Scan_Complete = L_Complete_Num;
		P_STMS_Memory_Tower_Status = N_Complete_Step;
	break;

	// 반환값 False 일 경우
	if ( L_individual_return == N_FALSE )
	{
		// 위치 내부 경알람 발생
		P_Error_STMS_Memory_Tower_Status = P_STMS_Memory_Tower_Status;
		P_STMS_Memory_Tower_Status = N_Error_Step;
	}
}

// 1.2. 설비 상태 업데이트 - 유닛의 상태를 조합해서 설비 상태로 업데이트
if ( L_Memory_individual_Scan_Complete == L_Complete_Num )
{
	// [ 참조 : 24049 디버깅 ] 
	L_integrated_return = 0;
	
	call Sub_Unit_Memory_Status.integrated_mode(&P_Unit_integrated_Status,&L_integrated_return);		// 유닛 통합 변수화 서브 프로그램 실행
	if ( L_integrated_return == F_TRUE )
	{
		P_MemTow_integrated_return = F_TRUE;									// 글로벌 설비 위치 업데이트 완료 변수
		L_Memory_individual_Scan_Complete = 0;									// 진입 커맨드 초기화
	}
	else
	{
		P_MemTow_integrated_return = L_integrated_return;						// 글로벌 설비 위치 업데이트 완료 변수
		L_Memory_individual_Scan_Complete = N_Error_Step;						// 진입 커맨드 초기화
	}
}

//=============================================================================================================================
// 2) 정지 및 재시작 프로그램  [ 2025.06.19 추가 ]
//=============================================================================================================================

//======================================//
//===== 감시부 [Find_Pause_Moniter]=====//
//======================================//
if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence || P_PMAC_Status == F_Status_STARTING )							// 일반 모드 일 경우. [세파, 드라이런 불필요]
{
	switch( P_PMAC_Status )
	{
		case F_Status_EXECUTE:	
			// [참조 : 250623 퍼즈 수정 ] - P_Current_Mode 보는거 수정, 세파 첫장 큐에서 계속 퍼즈 걸림
			if( P_Current_Mode == F_Half_Cathode_Run_Mode ) 
			{
				if( P_Master_Motion_Trigger == P_Pause_Cathode_MNTR_Max_Trigger) 
				{
					if( P_Cathode_Cur_Mode == F_Last_Run || P_Cathode_Cur_Mode == F_NG || P_Cathode_Cur_Mode == F_Stop || P_Cathode_Cur_Mode == F_Vac_Err )							// 양극 모드가 NG, Stop, Vac_Err가 아닐 경우.
					{}
					else																	// 그 외의 모드 일 경우.
					{
						//// [참조 : 250623 퍼즈 수정 ] - 마스터 트리거 상승 엣지 보고 퍼즈 키는거 삭제
						if( M_X_PLC_Anode_Sheet_Ready == 0 && M_Y_Pause_Anode_Signal == 0 )								// 음극 극판 준비가 되지 않을 경우.
						{
							M_Y_Pause_Anode_Signal = 1;											// 음극 극판 미공급으로 Pause 신호 ON.
						}					
					}
				}
			}
			// [참조 : 250623 퍼즈 수정 ] - P_Current_Mode 보는거 수정, 세파 첫장 큐에서 계속 퍼즈 걸림
			else if( P_Current_Mode == F_Half_Anode_Run_Mode )
			{
				if( P_Master_Motion_Trigger == P_Pause_Anode_MNTR_Max_Trigger )		// 음극 감지 트리거 사이 && 양극 극판 확인 전 일 경우.
				{
					if( P_Anode_Cur_Mode == F_NG || P_Anode_Cur_Mode == F_Stop || P_Anode_Cur_Mode == F_Vac_Err )																	// 음극 모드가 NG, Stop, Vac_Err가 아닐 경우.
					{}
					else																	// 그 외의 모드 일 경우.
					{		
						//// [참조 : 250623 퍼즈 수정 ] - 마스터 트리거 상승 엣지 보고 퍼즈 키는거 삭제
						if( M_X_PLC_Cathode_Sheet_Ready == 0 && M_Y_Pause_Cathode_Signal == 0 )								// 양극 극판 준비가 되지 않을 경우.
						{
							M_Y_Pause_Cathode_Signal = 1;										// 양극 극판 미공급으로 Pause 신호 ON.
						}
					}			
				}
			}
		break;

		case F_Status_HOLD:												// Hold 상태.
			if( P_Hold_Anode_Pause_CHK == 1 )							// 음극 1차 PNP 벨트 이동 시 on
			{
				if ( P_Hold_Pause_Use == 1 )							//  HOLD 시 무조건 Pause ON 
				{
					M_Y_Pause_to_Sequence_Signal = 1;							// Hold로 Pause 신호.
					P_Hold_Anode_Pause_CHK = 0;							// Flag 초기화.
					P_Seq_Pause2 = 1
				}
				else                                                    // HOLD 시 극판 존재에 따라 pause on
				{
					if( P_Master_Motion_Trigger == 87 )					
					{
						if( M_X_PLC_Anode_Sheet_Ready == 0 )			// 1차 PNP 벨트 이동 명령 시 특정 마스터 트리거에 극판 레디신호 off면 퍼즈
						{
							M_Y_Pause_to_Sequence_Signal = 1;					// Hold로 Pause 신호.
							P_Seq_Pause2 = 2
						}
						P_Hold_Anode_Pause_CHK = 0;						// Flag 초기화.
					}
				}
			}
			else if( P_Hold_Cathode_Pause_CHK == 1 )					// 양극 1차 PNP 벨트 이동 명령 시 on		
			{
				if ( P_Hold_Pause_Use == 1 )							//  HOLD 시 무조건 Pause ON 
				{
					M_Y_Pause_to_Sequence_Signal = 1;							// Hold로 Pause 신호.
					P_Hold_Cathode_Pause_CHK = 0;						// Flag 초기화.
					P_Seq_Pause2 = 3
				}
				else													// HOLD 시 극판 존재에 따라 pause on
				{
					if( P_Master_Motion_Trigger == 42 )
					{
						if( M_X_PLC_Cathode_Sheet_Ready == 0 )			// 1차 PNP 벨트 이동 명령 시 특정 마스터 트리거에 극판 레디신호 off면 퍼즈
						{
							M_Y_Pause_to_Sequence_Signal = 1;					// Hold로 Pause 신호.
							P_Seq_Pause2 = 4
						}
						P_Hold_Cathode_Pause_CHK = 0;					// Flag 초기화.
					}
				}
			}
		break;

		case F_Status_SUSPENDED: // [ 참조 : 2025.10.28 SUSPEND 배출 시, 음극 1TR 극판 공급모듈 추가 ]	
			if( P_Suspend_Anode_1TR_Cell_Supply_Module_Status == F_Status_EXECUTE )			// 공급 모듈 시작 상태
			{
				if( P_Suspend_Supply_Pause_Flag == N_TRUE )				// 퍼즈 요청 신호가 온다면
				{
					P_Suspend_Supply_Pause_Flag = 0;					// Pause Flag 초기화
					M_Y_Pause_to_Sequence_Signal = 1;					// Pause GPIO On
					P_Seq_Pause2 = 5
				}
			}
		break;
	}

	if( P_Starting_Pause_IO_Flag == 1 )
	{
		P_Starting_Pause_IO_Flag = 0
		M_Y_Pause_to_Sequence_Signal = 1
		P_Seq_Pause2 = 6
	}


}


//// PackML 상태 감시.
if( P_PMAC_Current_Mode == F_Current_Automatic )
{
	if((P_PMAC_Status == F_Status_STOPPING || P_PMAC_Status == F_Status_ABORTING) && P_Resume_Stop_Blocked == 0 )			// 상태가 Stopping 일 경우.
	{
		P_Resume_Stop_Blocked = 1
		M_Y_Resume_Stop_Signal = 1;						// 반대 열에게 Resume 정지 신호 ON.
	}
}

if( P_PMAC_Status == F_Status_STOPPED || P_PMAC_Status == F_Status_ABORTED )	// 상태가 Stopped, Aborted 일 경우.
{
	P_Starting_Pause_IO_Flag = 0
	P_PLC03_Seq_Pause_Start_State_Machine = 0
	P_Resume_Stop_Blocked = 0
	P_Dry_Pause_Flag = 0;							// 드라이런 퍼즈 플래그 초기화
	M_Y_Pause_Anode_Signal = 0;						// 음극 극판 미공급으로 인한 Pause 신호 초기화.
	M_Y_Pause_Cathode_Signal = 0;					// 양극 극판 미공급으로 인한 Pause 신호 초기화.
	M_Y_Pause_to_Sequence_Signal = 0;				// 홀드로 인한 Pause 신호 초기화.
	M_Y_Pause_Status_Complete_Signal = 0;			// 본인 열 Pause 완료 신호 초기화.
	P_Pause_Protect_Variable = 0;					// Pause Edge 변수 초기화.
	P_Resume_Protect_Variable = 0;					// Resume Edge 변수 초기화.
	P_Hold_Resume_Need_Flag = 0						// resume flag 초기화
	P_Suspend_Supply_Resume_Flag = 0				// resume flag 초기화
	P_Starting_Pause_IO_OFF_Flag = 0				// resume flag 초기화
	// [참조 : 260423 홀드 1차 공급 중 스탑 후 재가동 시 pause가 풀리지 않아 초기화 추가]
	P_Hold_Anode_Pause_CHK = 0
	P_Hold_Cathode_Pause_CHK = 0
	P_Suspend_Supply_Pause_Flag = 0
	M_Y_Resume_Stop_Signal = 0;	
}

//======================================//
//===== 실행부 [Find_Pause_Execute]=====//
//======================================//
if(  M_X_Pause_Anode_Signal == 1 || M_X_Pause_Cathode_Signal == 1 || M_X_Pause_to_Sequence_Signal == 1 )	// 반대열로 부터 Pause 신호를 받을 경우.
{
	M_Y_Pause_Ack_Signal = 0;						// Pause 요청 확인 신호 ON. [접점 반대 0 : ON, 1 : OFF]
}
else												// 반대열로 부터 Pause 신호가 모두 꺼졌을 경우.	
{
	M_Y_Pause_Ack_Signal = 1;						// Pause 요청 확인 신호 OFF. [접점 반대 0 : ON, 1 : OFF]
}

if( (((M_Y_Pause_Anode_Signal | M_Y_Pause_Cathode_Signal | M_Y_Pause_to_Sequence_Signal) && M_X_Pause_Ack_Signal == 0) || M_Y_Pause_Ack_Signal == 0))		// (본인열 Pause 필요 && 반대열로 부터 Ack 신호 받을 경우) || 반대 열로 인한 Pause 진행이 필요한 경우 (현재 열을 공장 초기화 했을 경우 반대 열은 계속 진행해야 하기 때문에 접점 반대 사용 [ 0 : ON, 1 : OFF ]).
{
	if( P_Buffer_Mode_Status_Sequence != N_Sepa_Consume_Status_Sequence )			// 세파 모드 아닐 경우 (세파 모드 일 경우 Pause 걸리지 않음) [ 참조 : 26.07.31 Pause_Resume 수정 ] 
	{
		if( P_Master_Motion_Trigger == 43 && P_Pause_Protect_Variable == 0 )							// 43 타이밍때 퍼즈
		{	
			pause 1;										// Pause 신호 ON.
			M_Y_Pause_Status_Complete_Signal = 1;			// Pause 완료 신호 ON.
			P_Pause_Protect_Variable = 1;					// 재진입 방지.
			P_Resume_Protect_Variable = 0;					// Resume 진입 변수 초기화.
		}
		if( P_Master_Motion_Trigger == 88 && P_Pause_Protect_Variable == 0 )							// 88 타이밍때 퍼즈	
		{
			pause 1;										// Pause 신호 ON.
			M_Y_Pause_Status_Complete_Signal = 1;			// Pause 완료 신호 ON.
			P_Pause_Protect_Variable = 1;					// 재진입 방지.
			P_Resume_Protect_Variable = 0;					// Resume 진입 변수 초기화.
		}
	}
}
//======================================//
//===== 처리부 [Find_Pause_Process]=====//
//======================================//
if( Coord[1].ProgActive == 1 && Coord[1].ProgRunning == 0 && P_Resume_Protect_Variable == 0 )
{
	// 260401 반대열 pause 완료 후 Resume되게 조건 수정, 반대열 1번 좌표계(마스터트리거)가 off면 반대열 pause 상태 보지 않고 resume 가능
	if( M_X_Pause_Status_Complete_Signal == 1 || M_X_Opposite_Resume_Not_Free == 0)
	{
		// Pause 신호 초기화 Part. [ 극판 공급 신호가 들어올 경우 초기화 ]
		if( M_Y_Pause_Cathode_Signal == N_TRUE )			// 양극 극판 미공급으로 인한 정지 일 경우.
		{
			if( M_X_PLC_Cathode_Sheet_Ready )				// 양극 극판 공급 신호 ON 일 경우.
			{
				M_Y_Pause_Cathode_Signal = 0;				// 양극 극판 미공급 신호 OFF.
			}
		}
		else if( M_Y_Pause_Anode_Signal == N_TRUE )			// 음극 레디 때문이라면
		{
			if( M_X_PLC_Anode_Sheet_Ready )					// 음극 레디 신호가 on
			{
				M_Y_Pause_Anode_Signal = 0;					// GPIO 초기화
			}
		}
		else if( P_Hold_Resume_Need_Flag == N_TRUE )		// 홀드에서 리줌 해달라하면
		{
			M_Y_Pause_to_Sequence_Signal = 0;				// GPIO 초기화
			P_Hold_Resume_Need_Flag = 0;					// 홀드 리줌 변수 초기화
		}
		else if( P_Suspend_Supply_Resume_Flag == N_TRUE )	// Suspend 1차 공급 끝난 후 리줌 플래그  // [ 참조 : 2025.10.28 SUSPEND 배출 시, 음극 1TR 극판 공급모듈 추가 ]
		{
			M_Y_Pause_to_Sequence_Signal = 0;				// Pause GPIO 초기화
			P_Suspend_Supply_Resume_Flag = 0;				// 플래그 초기화
		}
		else if ( P_Starting_Pause_IO_OFF_Flag == 1 )
		{
			M_Y_Pause_to_Sequence_Signal = 0
			P_Starting_Pause_IO_OFF_Flag = 0
		}
	}


	if( ((!(M_Y_Pause_Anode_Signal | M_Y_Pause_Cathode_Signal | M_Y_Pause_to_Sequence_Signal | M_Y_Resume_Stop_Signal)) && (!(M_X_Pause_Anode_Signal | M_X_Pause_Cathode_Signal | M_X_Pause_to_Sequence_Signal | M_X_Resume_Stop_Signal))) )		// 주는 열에서 문제가 해결될 경우.
	{
		P_Suspend_Discharge_Resume_Flag = 0;
		#ifdef F_Def_Stack_A
		if( P_Master_Motion_Trigger == 44 || P_Master_Motion_Trigger == 43 )						// 43,44 트리거에서 멈췄을 경우.
		{
			if( M_X_Opposite_Resume_Not_Free == 1 )
			{
				if( M_X_PLC_Sync_Heart_Bit == 0 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )	// 하강 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR1++
				}
				else if ( M_X_Pause_Status_Complete_Signal == 0 && M_X_PLC_Sync_Heart_Bit == 0 )		// [ 참조 : 26.07.31 Pause_Resume 수정 ]
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR2++
				}
			}
			else
			{
				if( M_X_PLC_Sync_Heart_Bit == 0 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )			// 하강 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR3++
				}	
			}		
		}
		if( P_Master_Motion_Trigger == 89 || P_Master_Motion_Trigger == 88 )						// 88,89 트리거에서 멈췄을 경우.
		{
			if( M_X_Opposite_Resume_Not_Free == 1 )
			{
				if( M_X_PLC_Sync_Heart_Bit == 1 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )	// 상승 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR4++
				}
				else if ( M_X_Pause_Status_Complete_Signal == 0 && M_X_PLC_Sync_Heart_Bit == 1 )		// [ 참조 : 26.07.31 Pause_Resume 수정 ]
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR5++
				}
			}
			else
			{
				if( M_X_PLC_Sync_Heart_Bit == 1 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )			// 상승 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR6++
				}
			}
		}
		//else if( Coord[1].ProgActive == 0 )															// 좌표계가 꺼져 있을 경우.
		//{
		//	M_Y_Pause_Status_Complete_Signal = 0;													// 컴플리트 상태 GPIO 초기화
		//	P_Pause_Protect_Variable = 0;															// Pause Edge 변수 초기화.
		//}
		#else
		if( P_Master_Motion_Trigger == 44 || P_Master_Motion_Trigger == 43 )						// 43,44 트리거에서 멈췄을 경우.
		{
			if( M_X_Opposite_Resume_Not_Free == 1 )
			{
				if( M_X_PLC_Sync_Heart_Bit == 1 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )	// 상승 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR7++
				}	
				else if ( M_X_Pause_Status_Complete_Signal == 0 && M_X_PLC_Sync_Heart_Bit == 1 )		// [ 참조 : 26.07.31 Pause_Resume 수정 ]
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR8++
				}	
			}
			else
			{
				if( M_X_PLC_Sync_Heart_Bit == 1 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit)	// 상승 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR9++
				}		
			}	
		}
		if( P_Master_Motion_Trigger == 89 || P_Master_Motion_Trigger == 88 )						// 88,89 트리거에서 멈췄을 경우.
		{
			if( M_X_Opposite_Resume_Not_Free == 1 )
			{
				if( M_X_PLC_Sync_Heart_Bit == 0 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )			// 하강 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR10++
				}
				else if ( M_X_Pause_Status_Complete_Signal == 0 && M_X_PLC_Sync_Heart_Bit == 0 )		// [ 참조 : 26.07.31 Pause_Resume 수정 ]
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR11++
				}
			}
			else
			{
				if( M_X_PLC_Sync_Heart_Bit == 0 && M_X_PLC_Sync_Heart_Bit != P_Old_X_PLC_Sync_Heart_Bit )			// 하강 Edge 일 경우.
				{
					M_Y_Pause_Status_Complete_Signal = 0;												// 컴플리트 상태 GPIO 초기화.
					P_Pause_Protect_Variable = 0;														// Pause Edge 변수 초기화.
					P_Resume_Protect_Variable = 1;														// Resume 재진입 방지.
					resume 1;																			// Resume 진행.
					P_Resume_MNTR12++
				}
			}
		}
		//else if( Coord[1].ProgActive == 0 )															// 좌표계가 꺼져 있을 경우.
		//{
		//	M_Y_Pause_Status_Complete_Signal = 0;													// 컴플리트 상태 GPIO 초기화.
		//	P_Pause_Protect_Variable = 0;															// Pause Edge 변수 초기화.
		//}
		#endif
	}
}


if( Coord[1].ProgActive == 1 && Coord[1].ProgRunning == 0 )
{
	if ( P_Motor_Current_Pos(N_1st_PnP_CA_T) > P_Cathode_1TR_T_Belt_POS - P_Sheet_Pos_Offset && P_Motor_Current_Pos(N_1st_PnP_CA_T) < P_Cathode_1TR_T_Belt_POS + P_Sheet_Pos_Offset )
	{
		M_Y_Cathode_1st_PNP_Sheet_Wait = 1				// 양극 1차 PNP 퍼즈 걸려서 대기중, ON 이면 PLC에서 극판 제대로 다 밀었는지 확인 후 극판 레디 신호 ON
	}
	else
	{
		M_Y_Cathode_1st_PNP_Sheet_Wait = 0				
	}

	if ( P_Motor_Current_Pos(N_1st_PnP_AN_T) > P_Anode_1TR_T_Belt_POS - P_Sheet_Pos_Offset && P_Motor_Current_Pos(N_1st_PnP_AN_T) < P_Anode_1TR_T_Belt_POS + P_Sheet_Pos_Offset )
	{
		M_Y_Anode_1st_PNP_Sheet_Wait = 1				// 음극 1차 PNP 퍼즈 걸려서 대기중, ON 이면 PLC에서 극판 제대로 다 밀었는지 확인 후 극판 레디 신호 ON
	}
	else
	{
		M_Y_Anode_1st_PNP_Sheet_Wait = 0
	}
}
else
{
	M_Y_Cathode_1st_PNP_Sheet_Wait = 0
	M_Y_Anode_1st_PNP_Sheet_Wait = 0 
}

// ↓ 마스터 좌표계가 죽어있을 경우 || ↓ 본인열 세파 모드 일 경우 || ↓ 세파 모드로 배출 후 싱크 맞추기 전 일 경우
if( Coord[1].ProgActive == 0 || P_Sepa_Mode_Opposite_Resume_Free == 1 || P_Sepa_To_Normal_Mode_Sync_Flag == 1 )				// [ 참조 : 26.07.31 Pause_Resume 수정 ]	
{
	M_Y_Opposite_Resume_Not_Free = 0	// 반대열 퍼즈 무시하고 런
}
else if( Coord[1].ProgActive == 1 )		// ← 마스터 좌표계가 살아 있을 경우
{

	M_Y_Opposite_Resume_Not_Free = 1	// 퍼즈 필요해
}

IF ( P_PLC03_Seq_Pause_Start_Flag == 1 ) 					// 1) Flag 확인 단계
{
	P_PLC03_Seq_Pause_Start_Flag = 0;
	P_PLC03_Seq_Pause_Start_State_Machine = 1;
}
IF ( P_PLC03_Seq_Pause_Start_State_Machine == 0 )			// 0) 다운로드시 상태 감시 단계
{
	P_PLC03_Seq_Pause_Start_Status = F_Status_Nonseatus		// 상태 : Nonseatus 0
}

IF ( P_PLC03_Seq_Pause_Start_State_Machine== 1 )			// [1]스텟머신 1단계 
{
	P_PLC03_Seq_Pause_Start_Status = F_Status_IDLE			//   - 상태 : IDLE

	// 사용자 세파 모드가 설정되어 있다면 ( 1차 PNP 진입을 안할테니 )
	//if( P_Com_User_Sepa_Consume_Mode_Flag == 1 && P_Com_ARC_Sepa_Consume_Mode_Flag == 0 && P_Com_EPC_Sepa_Consume_Mode_Flag == 0 )			
	// 세파 모드 일 경우 ( 1차 PNP 진입을 하지 않음 )
	if( P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence )		// [ 참조 : 26.07.31 Pause_Resume 수정 ]		
	{
		P_PLC03_Seq_Pause_Start_State_Machine = 4;
	}
	else
	{
		// Pause 걸 수 있는 마스터 트리거 최소 단위를 런모드 기준 1차 PNP가 벨트로 이동할 수 있는 마스터트리거로 기준 잡음
		if( P_Master_Motion_Trigger == 30 || P_Master_Motion_Trigger == 77 )
		{
			P_Starting_Pause_IO_Flag = 1;							//   - Pause IO ON
			P_Seq_Pause = 14
			P_PLC03_Seq_Pause_Start_State_Machine = 2;
		}
	}
}
		
IF ( P_PLC03_Seq_Pause_Start_State_Machine== 2 )			// [2] 스텟머신 2단계
{	
	P_PLC03_Seq_Pause_Start_Status = F_Status_STARTING		//   - 상태 : STARTING
	if( Coord[1].ProgRunning == 0 && Coord[1].ProgActive == 1 &&( M_X_Pause_Status_Complete_Signal == 1 || M_X_Opposite_Resume_Not_Free == 0) )
	{
		if( M_X_Pause_Status_Complete_Signal == 1 )
		{
			P_Puase_Resume_Time_Check = Sys.Time;	// Pause 시간 저장
			P_Pause_Time_Flag = 1;
		}
			// 둘다 퍼즈 확인 완료
		P_Starting_Pause_IO_OFF_Flag = 1
		P_Sepa_To_Normal_Mode_Sync_Flag = 0;				// [ 참조 : 26.07.31 Pause_Resume 수정 ]
		P_PLC03_Seq_Pause_Start_State_Machine = 3;
	}
}

IF ( P_PLC03_Seq_Pause_Start_State_Machine== 3 ) 			// [3] 스텟머신 3단계 (Pause 확인)
{
	P_PLC03_Seq_Pause_Start_Status = F_Status_EXECUTE		// 	- 상태 : STARTING
	
	if( Coord[1].ProgRunning == 1 && Coord[1].ProgActive == 1  && M_X_Pause_Status_Complete_Signal == 0 )
	{
		// 둘다 리쥼 확인 완료
		if(P_Pause_Time_Flag == 1)
		{
			P_Pause_Time_Flag = 0;
			P_Pause_To_Resume_Time = Sys.Time - P_Puase_Resume_Time_Check;	// Resume 까지의 시간 확인
		}

		P_PLC03_Seq_Pause_Start_State_Machine = 4
	}
}
IF ( P_PLC03_Seq_Pause_Start_State_Machine== 4 )			// [4] 스텟머신 4단계 (완료 체크단계)
{
	P_PLC03_Seq_Pause_Start_Status = F_Status_COMPLETE;
	P_PLC03_Seq_Pause_Start_State_Machine = 999;
}





if( P_Stack_Heart_Bit_Sync_Flag == 1 )
{
	#ifdef F_Debug_Mode							//Debug ( C# UI Mode )
		local L_Sync_Rtn = 0;
		#ifdef F_Def_Stack_A						// A열은 상승엣지보고 좌표계 on
			call System_Module.Coord_ON(M_Y_A_Site_Heart_Bit,P_Old_X_PLC_Sync_Heart_Bit,&L_Sync_Rtn);
			if( L_Sync_Rtn == N_TRUE )
			{
				P_Stack_Heart_Bit_Sync_Flag = N_FALSE; 
				P_Stack_Heart_Bit_Sunc_Complete_Bit = N_TRUE;
			}
			P_Old_X_PLC_Sync_Heart_Bit = M_Y_A_Site_Heart_Bit;
		#else										// B열은 하강엣지 보고 좌표계 on
			call System_Module.Coord_ON(M_X_B_Site_Heart_Bit,P_Old_X_PLC_Sync_Heart_Bit,&L_Sync_Rtn);
			if( L_Sync_Rtn == N_TRUE )
			{
				P_Stack_Heart_Bit_Sync_Flag = N_FALSE;
				P_Stack_Heart_Bit_Sunc_Complete_Bit = N_TRUE;
			}
			P_Old_X_PLC_Sync_Heart_Bit = M_X_B_Site_Heart_Bit;
		#endif
	#endif										

	#ifdef F_Real_Axis_Test						// 실축모드
		local L_Sync_Rtn = 0;
		#ifdef F_Def_Stack_A						// A열은 상승엣지보고 좌표계 on
			call System_Module.Coord_ON(M_X_PLC_Sync_Heart_Bit,P_Old_X_PLC_Sync_Heart_Bit,&L_Sync_Rtn);
			if( L_Sync_Rtn == N_TRUE )
			{
				P_Stack_Heart_Bit_Sync_Flag = N_FALSE; 
				P_Stack_Heart_Bit_Sunc_Complete_Bit = N_TRUE;
			}
		
		#else										// B열은 하강엣지 보고 좌표계 on
			call System_Module.Coord_ON(M_X_PLC_Sync_Heart_Bit,P_Old_X_PLC_Sync_Heart_Bit,&L_Sync_Rtn);
			if( L_Sync_Rtn == N_TRUE )
			{
				P_Stack_Heart_Bit_Sync_Flag = N_FALSE;
				P_Stack_Heart_Bit_Sunc_Complete_Bit = N_TRUE;
			}
			
		#endif
	#endif
}

P_Old_X_PLC_Sync_Heart_Bit = M_X_PLC_Sync_Heart_Bit;						// PLC 싱크 DIO 갱신
