			P_Tact_Time_Head_Address(N_Anode_1st_Vac) = &P_Tact_Time_Anode_1st_PNP_Vac_Array(0);		// Tact Time 배열 P변수 주소값 업데이트.
			call Tack_Time.Transmission_Tact_Time(P_Tact_Time_Head_Address(N_Anode_1st_Vac),P_Tack_Time_Save_Time(N_Anode_1st_Vac))	// Tact Time 배열에 저장.
			P_Old_Tact_Time_Check(N_Anode_1st_Vac) = 1;							// 재진입 방지.
		}
	}
	else if ( M_Y_Anode_1st_Vac_Sol_On == 0 )
	{
		P_Tact_Time_Timer(N_Anode_1st_Vac) = 0;									// Tact Time 타이머 초기화.
		P_Old_Tact_Time_Check(N_Anode_1st_Vac) = 0;								// 재진입 방지.
	}
	//--------------------------------------------------------------------------------//
	// N_Anode_Align_Vac - 양극 얼라인 [흡착 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Anode_AT_Vac_Ejector_Vac_On == 1 && M_Y_Anode_AT_Vac_Ejector_Vac_Off == 0 && P_Old_Tact_Time_Check(N_Anode_Align_Vac) == 0 )		// 흡착 IO ON.
	{
		if ( M_X_Anode_AT_Vac_Sensor == 1 )							// 입력 센서 들어올 경우.
		{
			P_Tack_Time_Save_Time(N_Anode_Align_Vac) = P_Tact_Time_Timer(N_Anode_Align_Vac) / 10;	// Tact Time 저장.
			P_Tact_Time_Head_Address(N_Anode_Align_Vac) = &P_Tact_Time_Anode_Align_PNP_Vac_Array(0);	// Tact Time 배열 P변수 주소값 업데이트.
			call Tack_Time.Transmission_Tact_Time(P_Tact_Time_Head_Address(N_Anode_Align_Vac),P_Tack_Time_Save_Time(N_Anode_Align_Vac))	// Tact Time 배열에 저장.
			P_Old_Tact_Time_Check(N_Anode_Align_Vac) = 1;						// 재진입 방지.
		}
	}
	else if ( M_Y_Anode_AT_Vac_Ejector_Vac_On == 0 )
	{
		P_Tact_Time_Timer(N_Anode_Align_Vac) = 0;								// Tact Time 타이머 초기화.
		P_Old_Tact_Time_Check(N_Anode_Align_Vac) = 0;							// 재진입 방지.
	}
