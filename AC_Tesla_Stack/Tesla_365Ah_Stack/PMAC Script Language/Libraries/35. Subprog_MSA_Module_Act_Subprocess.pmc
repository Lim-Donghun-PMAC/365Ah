	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 0 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 2차 PNP 얼라인 이동 위치 확인		
		{
			if( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 양극 2차 PNP 속도 0 확인 																						 
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_2nd_Align_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_2nd_Align_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_2nd_Align_Move) = 1;														// 동작 완료 Bit On.
	rtn = N_COMPLETE;																														// 반환값 : COMPLETE
}
return;


//=========================================================
//32. 파이널롤러 대기 위치 이동 (MSA 완료)
//=========================================================
sub: MSA_Align_Discharge_FinalRoll_Init_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) == N_Ready_Step )										//파이널롤러 대기 위치 이동 Ready Step 
{	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave5_Motion_Command = 3;																									// 파이널롤러 대기 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 		
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave5_Motion_Command = 3;																									// 파이널롤러 대기 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 		
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Final_Roll_X_Discharge - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Final_Roll_X_Discharge + P_Motor_Ready_Pos_Inpos_200um ) // 파이널롤러 대기 위치 이동 위치 확인	
		{
			if( Motor[N_FINAL_ROLL_X].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 파이널롤러 속도 0 확인 																									
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Final_Roll_X_Discharge - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Final_Roll_X_Discharge + P_Motor_Ready_Pos_Inpos_200um ) // 파이널롤러 대기 위치 이동 위치 확인		
		{
			if( Motor[N_FINAL_ROLL_X].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 파이널롤러 속도 0 확인 																				 
			{																											
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_FinalRoll_Init_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_FinalRoll_Init_Move) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																														// 반환값 : COMPLETE
}
return;



// Stack MSA Module Start--------------------------------------------------------------------------------------------------------------------------------
//=========================================================
//1.Stack MSA Set
//=========================================================
sub: MSA_Stack_Set(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) == N_Ready_Step )													//Stack MSA Set Ready Step
{
	if( Mode == N_MSA_Anode_Stack )			// 음극 Stack MSA 모드일 경우
	{
		#ifdef F_Def_Stack_A //A열인 경우
		P_Modbus_A_VISION_MSA_Status = F_Status_EXECUTE		//A열 MSA 진행 중 상태 EXECUTE
		#endif

		#ifdef F_Def_Stack_B //B열인 경우
		P_Modbus_B_VISION_MSA_Status = F_Status_EXECUTE		//B열 MSA 진행 중 상태 EXECUTE
		#endif
		P_Current_MSA_Run_Num(F_Anode_Stack_MSA) = 0;																		// 음극 Stack MSA 현재 진행한 횟수 초기화
		// 인터락 PLC disable		cmd"disable plc??"
		// 흡착 알람 감시 PLC disable cmd"disable plc??"
		call Manual_Module_Motor_Active.Anode_Stack_MSA_Motion_Check(&P_Anode_Stack_MSA_Motion_Check)								//Stack MSA 모터 활성화
		if(P_Anode_Stack_MSA_Motion_Check == 1)																			//Stack MSA 모터 체크 완료 
		{
			P_Anode_Stack_MSA_Motion_Check = 0;
			call Sub_Common_Function.Master_Motion_Program_On ();														//마스터 모션, 서브마스터, 슬레이브 ON
		}
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) = 1;															// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack ) 	// 양극 Stack MSA 모드일 경우																					
	{
		#ifdef F_Def_Stack_A  //A열인 경우
		P_Modbus_A_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
		#endif

		#ifdef F_Def_Stack_B  //B열인 경우
		P_Modbus_B_VISION_MSA_Status = F_Status_EXECUTE	//B열 MSA 진행 중 상태 EXECUTE
		#endif
		P_Current_MSA_Run_Num(F_Cathode_Stack_MSA) = 0;																		// 양극 Stack MSA 현재 진행한 횟수 초기화								
		// 인터락 PLC disable		cmd"disable plc??"
		// 흡착 알람 감시 PLC disable cmd"disable plc??"
		call Manual_Module_Motor_Active.Cathode_Stack_MSA_Motion_Check(&P_Cathode_Stack_MSA_Motion_Check)							//Stack MSA 모터 활성화
		if(P_Cathode_Stack_MSA_Motion_Check == 1)																		//Stack MSA 모터 체크 완료 
		{
			P_Cathode_Stack_MSA_Motion_Check = 0;
			call Sub_Common_Function.Master_Motion_Program_On();														//마스터 모션, 서브마스터, 슬레이브 ON
		}								
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) = 1;															// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )			// 음극 Stack MSA 모드일 경우
	{
		call Manual_Module_Motor_Active.Anode_Stack_MSA_Motion_ProgActive(&P_Anode_Stack_MSA_Motion_ProgActive_Complete)				// 음극 Stack MSA 좌표계 활성화
		if( P_Anode_Stack_MSA_Motion_ProgActive_Complete == 1)																// 음극 Stack MSA 좌표계 활성화 완료
		{
			P_Anode_Stack_MSA_Motion_ProgActive_Complete = 0;
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) = N_Complete_Step;											//다음 스텟 이동
		}
	}
	else if( Mode == N_MSA_Cathode_Stack )	// 양극 Stack MSA 모드일 경우		
	{
		call Manual_Module_Motor_Active.Cathode_Stack_MSA_Motion_ProgActive(&P_Cathode_Stack_MSA_Motion_ProgActive_Complete)			// 양극 Stack MSA 좌표계 활성화
		if( P_Cathode_Stack_MSA_Motion_ProgActive_Complete == 1)															// 양극 Stack MSA 좌표계 활성화 완료
		{
			P_Cathode_Stack_MSA_Motion_ProgActive_Complete = 0;
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) = N_Complete_Step;											//다음 스텟 이동
		}
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Set) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Set) = 1;															// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//2.Stack MSA 모터 위치 확인
//=========================================================
sub: MSA_Stack_Motor_Pos_Check(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) == N_Ready_Step )
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		if ( N_MSA_Anode_Stack_Coord_Check == 1 )																			// 음극 Stack MSA 좌표계 활성화 확인 
		{
			P_Slave5_Motion_Command = 2;																					// 음극 2차 PNP Stack 이동 예정으로 양극 방향 이동
			P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화 
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) = 1;												// 다음 스텟 머신으로 이동.
		}
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우	
	{
	    if ( N_MSA_Cathode_Stack_Coord_Check == 1  )																		 // 양극 Stack MSA 좌표계 활성화 확인 
		{
			P_Slave5_Motion_Command = 1;																					// 음극 2차 PNP Stack 이동 예정으로 양극 방향 이동
			P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화 
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) = 1;												// 다음 스텟 머신으로 이동.
		}
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 0 + P_Motor_Ready_Pos_Inpos_200um &&  P_Motor_Current_Pos(N_2nd_PnP_AN_Z) > 17.897 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 17.897 + P_Motor_Ready_Pos_Inpos_200um )
		{// 2차 PNP T축 Z축 대기 위치 확인 
			if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Final_Roll_X_Cathode_Move - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Final_Roll_X_Cathode_Move + P_Motor_Ready_Pos_Inpos_200um && P_MSA_Chk_Pos_Timer >100 ) 
			{// 파이널롤러 X축 양극 이동 방향 168mm 위치 확인 
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) = N_Complete_Step;
			}
		}
	}
	else if ( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우	
	{
		if( P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 0 + P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 17.897 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 17.897 + P_Motor_Ready_Pos_Inpos_200um )  
		{// 2차 PNP T축 Z축 대기 위치 확인 
			if(  P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Final_Roll_X_Anode_Move - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Final_Roll_X_Anode_Move + P_Motor_Ready_Pos_Inpos_200um && P_MSA_Chk_Pos_Timer >100 ) 
			{// 파이널롤러 X축 음극 이동 방향 -168mm 위치 확인 
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) = N_Complete_Step;
			}
		}
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Motor_Pos_Check) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Motor_Pos_Check) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//3.Stack MSA 2차 얼라인 하강
//=========================================================
sub: MSA_Stack_2nd_Align_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) == N_Ready_Step )									//Stack MSA 2차 얼라인 하강 Ready Step 확인 
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		P_Slave17_Motion_Command = 5;																					//음극 2차 PNP T축 Align -> Stack 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화 																																				
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{
		P_Slave18_Motion_Command = 5;																					//양극 2차 PNP T축 Align -> Stack 이동 모션 커멘드	
		P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화 																									
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) 	// 음극 2차 PNP Stack 위치 확인	
		{
			if( Motor[N_2nd_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 								// 음극 2차 PNP 속도 0 확인 																						
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
			}	
		}
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um )	// 양극 2차 PNP Stack 위치 확인	
		{
			if( Motor[N_2nd_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )									// 음극 2차 PNP 속도 0 확인 	
			{																											
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
			}		
		}																											
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Down_Move) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

//=========================================================
//4. Stack MSA 2차 PNP 얼라인 흡착 
//=========================================================
sub: MSA_Stack_2nd_PNP_Vacume_ON(Mode,&rtn)																			//Stack MSA 2차 얼라인 흡착 Ready Step 확인 
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) == N_Ready_Step )
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave17_Motion_Command = 10;																				//음극 2차 PNP 얼라인 흡착 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																					// 체크 타이머 초기화 	
		//M_Y_Anode_AT_Vac_Ejector_Vac_On = 0;																										
		//M_Y_Anode_AT_Vac_Ejector_Vac_Off = 1; 																																		
		//M_Y_Anode_2nd_Vac_Sol_On = 1;																	
		//M_Y_Anode_2nd_Vac_Sol_Off = 0;	
		
		//M_Y_Anode_2nd_Vac_Sol_On = 1;    
		//M_Y_Anode_2nd_Vac_Sol_Off = 0;    
		//M_Y_Anode_2nd_Release_Sol_On = 0;
		//M_Y_Anode_2nd_Release_Sol_Off = 1;
																					
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) = 1;										// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave18_Motion_Command = 10;																				//양극 2차 PNP 얼라인 흡착 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																					// 체크 타이머 초기화 	
		//M_Y_Cathode_AT_Vac_Ejector_Vac_On = 0;																			
		//M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 1; 	
		
		//M_Y_Cathode_2nd_Vac_Sol_On = 1;    
		//M_Y_Cathode_2nd_Vac_Sol_Off = 0;
		//M_Y_Cathode_2nd_Release_Sol_On = 0;
		//M_Y_Cathode_2nd_Release_Sol_Off = 1;	
																																																		
		//M_Y_Cathode_2nd_Vac_Sol_On = 1;																				
		//M_Y_Cathode_2nd_Vac_Sol_Off = 0;																					

		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) = 1;										// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )						// 음극 Stack MSA 모드일 경우
	{
		if ( M_X_Anode_2nd_PNP_Vac_Sensor == 1 && M_X_Anode_AT_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 		// 음극 얼라인 흡착 확인 
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) = N_Complete_Step;
		}
	}
	else if( Mode == N_MSA_Cathode_Stack )				// 양극 얼라인 MSA 모드일 경우
	{
		if ( M_X_Cathode_2nd_PNP_Vac_Sensor == 1 && M_X_Cathode_AT_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time) 	// 양극 얼라인 흡착 확인 
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) = N_Complete_Step;
		}
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_PNP_Vacume_ON) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;


//=========================================================
//5. Stack MSA 2차 PNP 얼라인 상승
//=========================================================
sub: MSA_Stack_2nd_Align_Up_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) == N_Ready_Step )									//Stack MSA 2차 PNP 얼라인 상승 Ready Step 확인 
{
	if( Mode == N_MSA_Anode_Stack )							// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave17_Motion_Command = 6;																					//음극 2차 PNP 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화 															
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )					// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave18_Motion_Command = 6;																					//양극 2차 PNP 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화 	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )						// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z)  > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 2차 PNP 스텍 상승 위치 확인
		{
			if( Motor[N_2nd_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 2차 PNP 속도 0 확인 
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )			// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 2차 PNP 스텍 상승 위치 확인
		{
			if( Motor[N_2nd_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 양극 2차 PNP 속도 0 확인 
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Up_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Up_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;


//=========================================================
//6. Stack MSA 2차 PNP 얼라인 -> 스텍 위치 이동 
//=========================================================
sub: MSA_Stack_2nd_Stack_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) == N_Ready_Step )										//Stack MSA 2차 PNP 얼라인 -> 스텍 위치 이동 Ready Step
{
	if( Mode == N_MSA_Anode_Stack )			// 음극 Stack MSA 모드일 경우
	{
		P_Slave3_Motion_Command = 1;																					//음극 2차 PNP T축 Align -> Stack 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화																																					
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )	// 양극 Stack MSA 모드일 경우
	{
		P_Slave8_Motion_Command = 1;																					//양극 2차 PNP T축 Align -> Stack 이동 모션 커멘드	
		P_MSA_Chk_Pos_Timer = 0;																						// 체크 타이머 초기화																									
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 2차 PNP Stack 위치 확인
		{
			if( Motor[N_2nd_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 											// 음극 2차 PNP 속도 0 확인																								
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}	
		}
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{																														
		if (P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 2차 PNP Stack 위치 확인
		{
			if( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )										//양극 2차 PNP 속도 0 확인 	
			{																														
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}		
		}																											
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Stack_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Move) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

