					P_Plus_IL_Offset = P_Clamp_Z_Plus_IL_Offset;
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(2) - 10)
					{// 양극 2차 pnp가 80도 초과라면...
						P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M21_POS(5) - P_Cathode_2nd_PNP_Z_Real_Move_Pos + P_Plus_IL_Offset;		// Ca 2nd Z [#21] 하강 위치 - 현재 위치 시 절대위치 변환 가능
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_Z;
					}
					else if(P_Motor_Current_Pos(N_2nd_PnP_AN_T) > P_Recipe_M04_POS(2) - 10)
					{// 음극 2차 pnp가 80도 초과라면...
						P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M22_POS(5) - P_Anode_2nd_PNP_Z_Real_Move_Pos + P_Plus_IL_Offset;			// An 2nd Z [#22] 하강 위치 - 현재 위치 시 절대위치 변환 가능
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_AN_Z;
					}
					else if( P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(3) && P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Recipe_M12_POS(2) )   
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Motor_Current_Pos(N_FINAL_ROLL_Z) * -1 + P_Plus_IL_Offset;			// FR Z축이랑 확인. 
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_Z;
					}
