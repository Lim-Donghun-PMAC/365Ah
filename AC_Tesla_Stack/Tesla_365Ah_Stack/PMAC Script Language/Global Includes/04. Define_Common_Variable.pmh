// 정의
	//------------------------------------------------------------------------------------
	// 01. 글로벌 상태 정의
	//------------------------------------------------------------------------------------
	#define	F_Status_Length			18		// 상태 목록 개수
	#define	F_Status_Nonseatus		0		// 프로그램이 실행중이 아님
	#define	F_Status_IDLE			1      // 유휴 상태
	#define	F_Status_STARTING		2      // 자동 생산 준비
	#define	F_Status_EXECUTE		3      // 자동 생산 중
	#define	F_Status_COMPLETING		4      // 자동 생산 종료중
	#define	F_Status_COMPLETE		5      // 자동 생산 완료
	#define	F_Status_RESETTING		6      // 상태 이상 리셋
	#define	F_Status_HOLDING		7      // 내부적인 일시 정지 준비
	#define	F_Status_HOLD			8      // 내부적인 일시정지 완료
	#define	F_Status_UNHOLDING		9      // 내부적인 일시 정지 해제 준비
	#define	F_Status_SUSPENDING		10      // 외부적인 일시 정지 준비
	#define	F_Status_SUSPENDED		11      // 외부적인 일시 정지 완료
	#define	F_Status_UNSUSPENDING	12      // 외부적인 일시 정지 해제 준비
	#define	F_Status_STOPPING		13      // 정지 준비
	#define	F_Status_STOPPED		14      // 정지 완료
	#define	F_Status_ABORTING		15      // 긴급 정지 준비
	#define	F_Status_ABORTED		16      // 긴급 정지 완료
	#define	F_Status_CLEARING		17      // 긴급 정지 복구

	
	//------------------------------------------------------------------------------------
	// 02. // [프로그램 모드 변수] [ Command_And_Status.pmh ]
	//------------------------------------------------------------------------------------
	#define	F_Current_Not_Decided			0	//	모드가 정해지지 않음
	#define F_Current_Automatic				1	//	자동 모드 시퀀스
	#define F_Current_Manual				2	//	수동 모드 시퀀스
	#define	F_Current_Maintenance			3	//	정비 모드 시퀀스
	#define F_Current_Semi_Automatic		4	//	드라이런 모드 시퀀스
	#define F_Current_Idle					5	//	대기 모드 시퀀스
	#define	F_Current_Mode_Length			6	//	모드 목록 개수

	// [프로그램 명령어 변수] [ Command_And_Status.pmh ]
	#define	F_Command_NonCommand				0		// 명령 대기 상태
	#define F_Command_Start         			1		// 시작
	#define F_Command_Hold          			2		// 내부 상태에 의한 일시정지
	#define F_Command_Unhold        			3		// 내부 상태에 의한 일시정지 해제
	#define F_Command_Suspend       			4		// 외부 상태에 의한 일시정지
	#define F_Command_Unsuspend     			5		// 외부 상태에 의한 일시정지 해제
	#define F_Command_Complete      			6		// 완료
	#define F_Command_Stop          			7		// 정지
	#define F_Command_Reset         			8		// 리셋(운전준비)
	#define F_Command_Abort						9		// EMO 등 긴급 정지
	#define F_Command_Clear         			10		// EMO 등 긴급 정지 처리에 대한 초기화
	#define	F_Command_Length					11		// 명령 목록 개수


