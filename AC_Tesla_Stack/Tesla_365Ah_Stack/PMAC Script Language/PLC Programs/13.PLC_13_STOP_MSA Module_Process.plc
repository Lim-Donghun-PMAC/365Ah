//==============================================================================================================================================
//2. 비전 오토 캘 모듈 ( 극판 선택이 완료 되어 있다면 실행 명령부 가능)
//==============================================================================================================================================
//2.1) 자동 캘리브레이션일 경우 
IF ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode || P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	//오토 캘 양극, 음극 선택
{
	//2.1.1)비전 오토 캘 시작
	if( P_Vision_AutoCal_Command == F_Command_Start )				//비전 오토 캘 시작 커맨드 
	{
		P_Vision_AutoCal_Command = 0;
		if ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode )		//양극 비전 오토 캘 일 경우 
		{
			P_Cathode_Align_Table_Move = F_Align_AutoCal_Move_Mode;	//양극 얼라인 캘 무브 설정 
		}
		else if ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	//음극 비전 오토 캘 일 경우 
		{
			P_Anode_Align_Table_Move = F_Align_AutoCal_Move_Mode;	//음극 얼라인 캘 무브 설정 
		}
		P_CMD_Align_Complete = 0;							
		P_CMD_Cell_Align(P_Vision_AutoCal_Mode) = 1;				
	}	
	//2.1.2)비전 오토 스탑
	if( P_Vision_AutoCal_Command == F_Command_Stop )				 //비전 오토 캘 스탑 커맨드 
	{
		P_Vision_AutoCal_Command = 0;
		if ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Cathode )		 //양극 비전 오토 캘 일 경우 
		{															 
			P_Cathode_Align_Table_Move = F_Align_AutoCal_Move_Mode;	 //양극 얼라인 캘 무브 설정 
		}															 
		else if ( P_Vision_AutoCal_Mode == N_AutoCal_Mode_Anode )	 //음극 비전 오토 캘 일 경우 
		{															 
			P_Anode_Align_Table_Move = F_Align_AutoCal_Move_Mode;	 //음극 얼라인 캘 무브 설정 
		} 
		P_CMD_Align_Complete = 0;									 //얼라인 캘 무브 시작	
		P_CMD_Cell_Stop(P_Vision_AutoCal_Mode) = 1;		
	}
	//2.1.3)비전 리셋 시작
	if( P_Vision_AutoCal_Command == F_Command_Reset )				//비전 오토 캘 리셋 커맨드 
	{
		P_Vision_AutoCal_Command = 0;								//얼라인 캘 무브 설정 
		P_CMD_Cell_Reset(P_Vision_AutoCal_Mode) = 1;				//얼라인 캘 무브 시작	
		P_Vision_Cal_Reset_Count = 1;
	}
}
//==============================================================================================================================================
//3. 2차 PNP 클리닝 위치 이동 
//==============================================================================================================================================
//[참조 : 260724 2차 클리닝 위치 이동, 얼라인 탈착 모드 시퀀스 수정 ]
if (P_PMAC_Current_Mode == F_Current_Manual)		// 메뉴얼, IDEL 젤리롤 적층 아닐 경우에서만 가능
{ 
	if ( M_Func_BTN.Stack_2nd_PNP_Cleaning_Mode == 1 && M_Func_BTN.Stack_2nd_PNP_Cleaning_Mode != L_Old_BTN_Stack_2nd_PNP_Cleaning_Mode  )	// 2차 PNP 클리닝 위치 이동 시작 
	{
		P_2nd_PNP_Cleaning_Mode_Cmd = F_Command_Start;		//2차 PNP 클린이 위치 이동 커멘드 시작 
	}
}
L_Old_BTN_Stack_2nd_PNP_Cleaning_Mode = M_Func_BTN.Stack_2nd_PNP_Cleaning_Mode;			// Old Data	
//=============================================================================================================================================

//[참조 : 260922 MSA Interlock 조건 수정 ]
#ifdef F_Def_Stack_A	//A열 사용 시 
if( M_Option_Function_BTN.MSA_Use == 1 ) 
{
	P_Y_Vision_MSA_Use_Flag = 1;	//Vision으로 MSA 진행 중 신호 전달 
	if( P_Modbus_B_PMAC_Cur_Mode == F_Current_Manual && P_Modbus_B_VISION_MSA_Status != F_Status_EXECUTE ) 
	{
		if( M_X_Opposite_Cathode_1st_PNP_Collision_Detect_Sensor == 1 && M_X_Opposite_Anode_1st_PNP_Collision_Detect_Sensor == 1 )
		{
			P_MSA_Interlock = 0
			P_PNP_Vac_Chk_Mode_Interlock = 0
		}
		else
		{
			P_MSA_Interlock = 1
			P_PNP_Vac_Chk_Mode_Interlock = 1
		}
	}
	else 
	{
		P_MSA_Interlock = 1
		P_PNP_Vac_Chk_Mode_Interlock = 1
	}
}
else 
{
	P_Y_Vision_MSA_Use_Flag = 0;
	P_MSA_Interlock = 1
	P_PNP_Vac_Chk_Mode_Interlock = 1
}
#endif

//[참조 : 260922 MSA Interlock 조건 수정 ]
#ifdef F_Def_Stack_B	//B열 사용 시 
if( M_Option_Function_BTN.MSA_Use == 1 ) 
{
	P_Y_Vision_MSA_Use_Flag = 1; //Vision으로 MSA 진행 중 신호 전달 
	if( P_Modbus_A_PMAC_Cur_Mode == F_Current_Manual && P_Modbus_A_VISION_MSA_Status != F_Status_EXECUTE ) 
	{
		if( M_X_Opposite_Cathode_1st_PNP_Collision_Detect_Sensor == 1 && M_X_Opposite_Anode_1st_PNP_Collision_Detect_Sensor == 1 )
		{
			P_MSA_Interlock = 0
			P_PNP_Vac_Chk_Mode_Interlock = 0
		}
		else
		{
			P_MSA_Interlock = 1
			P_PNP_Vac_Chk_Mode_Interlock = 1
		}
	}
	else 
	{
		P_MSA_Interlock = 1
		P_PNP_Vac_Chk_Mode_Interlock = 1
	}
}
else 
{
	P_Y_Vision_MSA_Use_Flag = 0;
	P_MSA_Interlock = 1
	P_PNP_Vac_Chk_Mode_Interlock = 1
}
#endif


if( P_MSA_Interlock == 1 )
{
	// MSA 수정!!!!!!!!!!!
	if( P_SM_Anode_Align_MSA != 0 && P_Anode_Align_Interlock_Blocked == 0  )
	{
		P_Anode_Align_Interlock_Blocked = 1
		P_SM_Anode_Align_MSA = 41
	}
	
	if( P_SM_Cathode_Align_MSA != 0 && P_Cathode_Align_Interlock_Blocked == 0  )
	{
		P_Cathode_Align_Interlock_Blocked = 1
		P_SM_Cathode_Align_MSA = 41
	}

	if( P_SM_Cathode_Stack_MSA != 0 && P_Cathode_Stack_Interlock_Blocked == 0 )
	{
		P_Cathode_Stack_Interlock_Blocked = 1
		P_SM_Cathode_Stack_MSA = 44
	}

	if( P_SM_Anode_Stack_MSA != 0 && P_Anode_Stack_Interlock_Blocked == 0 )
	{
		P_Anode_Stack_Interlock_Blocked = 1
		P_SM_Anode_Stack_MSA = 44
	}
}
//==============================================================================================================================================================================
//[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
//==============================================================================================================================================================================
if ( P_PNP_Vac_Chk_Mode_Interlock == 1 ) 
{
	if( P_SM_Anode_1st_PNP_Vac_Chk_Mode != 0 && P_Anode_1st_PNP_Vac_Chk_Mode_Blocked == 0  )
	{
		P_Anode_1st_PNP_Vac_Chk_Mode_Blocked  = 1
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 11
	}
	if( P_SM_Cathode_1st_PNP_Vac_Chk_Mode != 0 && P_Cathode_1st_PNP_Vac_Chk_Mode_Blocked == 0  )
	{
		P_Cathode_1st_PNP_Vac_Chk_Mode_Blocked  = 1
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 11
	}
	if( P_SM_Anode_2nd_PNP_Vac_Chk_Mode != 0 && P_Anode_2nd_PNP_Vac_Chk_Mode_Blocked == 0  )
	{
		P_Anode_2nd_PNP_Vac_Chk_Mode_Blocked  = 1
		P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 9
	}
	if( P_SM_Cathode_2nd_PNP_Vac_Chk_Mode != 0 && P_Cathode_2nd_PNP_Vac_Chk_Mode_Blocked == 0  )
	{
		P_Cathode_2nd_PNP_Vac_Chk_Mode_Blocked  = 1
		P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 9
	}
}
//==============================================================================================================================================================================



// MSA 수정!!!!!!!!!!!
if( P_PMAC_Current_Mode == F_Current_Manual && P_PMAC_Status == F_Status_IDLE )
{
	// 음극 얼라인 MSA 실행 가능 Lamp ON
	if( ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos|| P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos) && P_SM_Anode_Align_MSA == 0 && P_MSA_Interlock == 0 )
	{
		P_Mode_Run_Enable_Flag(F_Anode_Align_MSA) = 1;
	}
	// 음극 얼라인 MSA 실행중 Lamp ON
	else if( P_SM_Anode_Align_MSA != 0 && P_Anode_Align_MSA_Execute_Timer > 500 )
	{
		P_Anode_Align_MSA_Execute_Timer = 0
		P_Mode_Run_Enable_Flag(F_Anode_Align_MSA) ^= $1;
	}
	else
	{
		P_Mode_Run_Enable_Flag(F_Anode_Align_MSA) = 0;
	}

	// 양극 얼라인 MSA 실행 가능 Lamp ON
	if( ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos|| P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos) && P_SM_Cathode_Align_MSA == 0 && P_MSA_Interlock == 0 )
	{
		P_Mode_Run_Enable_Flag(F_Cathode_Align_MSA) = 1;
	}
	// 양극 얼라인 MSA 실행중 Lamp ON
	else if( P_SM_Cathode_Align_MSA != 0 && P_Cathode_Align_MSA_Execute_Timer > 500 )
	{
		P_Cathode_Align_MSA_Execute_Timer = 0
		P_Mode_Run_Enable_Flag(F_Cathode_Align_MSA) ^= $1;
	}
	else
	{
		P_Mode_Run_Enable_Flag(F_Cathode_Align_MSA) = 0;
	}

	// 음극 스택 MSA 실행 가능 Lamp ON
	if( (P_Unit_integrated_Status == F_Equipment_Anode_Side_Pos || P_Unit_integrated_Status == F_Equipment_IDLE_Anode_Side_Pos ) && P_SM_Anode_Stack_MSA == 0 && P_MSA_Interlock == 0 )
	{
		P_Mode_Run_Enable_Flag(F_Anode_Stack_MSA) = 1;
	}
	// 음극 스택 MSA 실행중 Lamp ON
	else if( P_SM_Anode_Stack_MSA != 0 && P_Anode_Stack_MSA_Execute_Timer > 500 )
	{
		P_Anode_Stack_MSA_Execute_Timer = 0
		P_Mode_Run_Enable_Flag(F_Anode_Stack_MSA) ^= $1;
	}
	else
	{
		P_Mode_Run_Enable_Flag(F_Anode_Stack_MSA) = 0
	}
	
	// 양극 스택 MSA 실행 가능 Lamp ON
	if( (P_Unit_integrated_Status == F_Equipment_Cathode_Side_Pos || P_Unit_integrated_Status == F_Equipment_IDLE_Cathode_Side_Pos )&& P_SM_Cathode_Stack_MSA == 0 && P_MSA_Interlock == 0 )
	{
		P_Mode_Run_Enable_Flag(F_Cathode_Stack_MSA) = 1
	}
	// 양극 스택 MSA 실행중 Lamp ON
	else if( P_SM_Cathode_Stack_MSA != 0 && P_Anode_Stack_MSA_Execute_Timer > 500 )
	{
		P_Anode_Stack_MSA_Execute_Timer = 0
		P_Mode_Run_Enable_Flag(F_Cathode_Stack_MSA) ^= $1;
	}
	else
	{
		P_Mode_Run_Enable_Flag(F_Cathode_Stack_MSA) = 0
	}


	// 모든 MSA 동작이 진행중이지 않을 경우 MSA 실행 가능
	if( P_SM_Anode_1st_PNP_Vac_Chk_Mode == 0 && P_SM_Cathode_1st_PNP_Vac_Chk_Mode == 0 && P_SM_Anode_2nd_PNP_Vac_Chk_Mode == 0 && P_SM_Cathode_2nd_PNP_Vac_Chk_Mode == 0 &&  P_SM_Cathode_Stack_MSA == 0 && P_SM_Anode_Stack_MSA == 0 && P_SM_Cathode_Align_MSA == 0 && P_SM_Anode_Align_MSA == 0 )		
	{
		P_VISION_MSA_Status = 0	//A열 MSA 진행 중 상태 EXECUTE

		// MSA 버튼 중 하나만 들어올 때만 동작 가능, 여러개가 들어오면 실행 안함
		if((N_BTN_CA_Stack_MSA + N_BTN_AN_Stack_MSA + N_BTN_CA_Align_MSA + N_BTN_AN_Align_MSA) == 1 && P_PMAC_Current_Mode == F_Current_Manual )
		{
			// MSA 인터락이 걸리지 않을 경우 실행 가능
			if( P_MSA_Interlock == 0 )
			{
				if( P_Mode_Run_Enable_Flag(F_Anode_Align_MSA) == 1 && N_BTN_AN_Align_MSA == 1 && N_BTN_AN_Align_MSA != L_Old_BTN_AN_Align_MSA )			// 1. 음극 얼라인 MSA 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_SM_Anode_Align_MSA = 1
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
				else if( P_Mode_Run_Enable_Flag(F_Cathode_Align_MSA) == 1 && N_BTN_CA_Align_MSA == 1 && N_BTN_CA_Align_MSA != L_Old_BTN_CA_Align_MSA )		// 2. 양극 얼라인 MSA 버튼 
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_SM_Cathode_Align_MSA = 1
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
				else if( P_Mode_Run_Enable_Flag(F_Anode_Stack_MSA) == 1 && N_BTN_AN_Stack_MSA == 1 && N_BTN_AN_Stack_MSA != L_Old_BTN_AN_Stack_MSA )		// 3. 음극 스텍 MSA 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_MSA_Sample_Flag = 1;	// Stack MSA 후 MSA 샘플로 배출
						P_SM_Anode_Stack_MSA = 1;
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
				else if( P_Mode_Run_Enable_Flag(F_Cathode_Stack_MSA) == 1 && N_BTN_CA_Stack_MSA == 1 && N_BTN_CA_Stack_MSA != L_Old_BTN_CA_Stack_MSA )		// 4. 양극 스텍 MSA 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_MSA_Sample_Flag = 1;	// Stack MSA 후 MSA 샘플로 배출
						P_SM_Cathode_Stack_MSA = 1;
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
			}
			
		}
	}
	// 버튼이 동시에 2개 이상 들어왔을 경우
	else if((N_BTN_CA_Stack_MSA + N_BTN_AN_Stack_MSA + N_BTN_CA_Align_MSA + N_BTN_AN_Align_MSA) > 1)
	{
		// 어떤 버튼이 2개 이상 들어왔는지 저장
		P_MSA_Err_Save_CA_Stack_MSA = N_BTN_CA_Stack_MSA
		P_MSA_Err_Save_AN_Stack_MSA = N_BTN_AN_Stack_MSA
		P_MSA_Err_Save_CA_Align_MSA = N_BTN_CA_Align_MSA
		P_MSA_Err_Save_AN_Align_MSA = N_BTN_AN_Align_MSA
		P_MSA_BTN_Err++

	}
}
else //[참조 : 260806 MSA 활성화 램프 IDEL 아닌 경우 초기화 ]
{
	P_Mode_Run_Enable_Flag(F_Cathode_Stack_MSA) = 0;
	P_Mode_Run_Enable_Flag(F_Anode_Stack_MSA) = 0;
	P_Mode_Run_Enable_Flag(F_Cathode_Align_MSA) = 0;
	P_Mode_Run_Enable_Flag(F_Anode_Align_MSA) = 0;
}
L_Old_BTN_AN_Align_MSA = N_BTN_AN_Align_MSA;	// Old Data 
L_Old_BTN_CA_Align_MSA = N_BTN_CA_Align_MSA;	// Old Data 
L_Old_BTN_AN_Stack_MSA = N_BTN_AN_Stack_MSA;	// Old Data 
L_Old_BTN_CA_Stack_MSA = N_BTN_CA_Stack_MSA;	// Old Data 

//==============================================================================================================================================================================
//[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
//==============================================================================================================================================================================
if( P_PMAC_Current_Mode == F_Current_Manual && P_PMAC_Status == F_Status_IDLE )
{
	// 음극 1차 PNP 흡착 텍 측정 모드 실행 가능 Lamp ON
	if( ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos|| P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos) && P_SM_Anode_1st_PNP_Vac_Chk_Mode == 0 && P_PNP_Vac_Chk_Mode_Interlock == 0 )
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_1st_PNP_Vac_Chk_Mode)  = 1;
	}
	// 음극 1차 PNP 흡착 텍 측정 모드 실행중 Lamp ON
	else if( P_SM_Anode_1st_PNP_Vac_Chk_Mode != 0 && P_Anode_1st_PNP_Vac_Chk_Execute_Timer > 500 )
	{
		P_Anode_1st_PNP_Vac_Chk_Execute_Timer = 0
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_1st_PNP_Vac_Chk_Mode)  ^= $1;
	}
	else
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_1st_PNP_Vac_Chk_Mode) = 0;
	}

	// 양극 1차 PNP 흡착 텍 측정 모드 실행 가능 Lamp ON
	if( ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos|| P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos) && P_SM_Cathode_1st_PNP_Vac_Chk_Mode == 0 && P_PNP_Vac_Chk_Mode_Interlock == 0 )
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_1st_PNP_Vac_Chk_Mode) = 1;
	}
	// 양극 1차 PNP 흡착 텍 측정 모드 실행중 Lamp ON
	else if( P_SM_Cathode_1st_PNP_Vac_Chk_Mode != 0 && P_Cathode_1st_PNP_Vac_Chk_Execute_Timer > 500 )
	{
		P_Cathode_1st_PNP_Vac_Chk_Execute_Timer = 0
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_1st_PNP_Vac_Chk_Mode) ^= $1;
	}
	else
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_1st_PNP_Vac_Chk_Mode) = 0;
	}

	// 음극 2차 PNP 흡착 텍 측정 모드 실행 가능 Lamp ON
	if( ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos|| P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos) && P_SM_Anode_2nd_PNP_Vac_Chk_Mode == 0 && P_PNP_Vac_Chk_Mode_Interlock == 0 )
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_2nd_PNP_Vac_Chk_Mode) = 1;
	}
	// 음극 2차 PNP 흡착 텍 측정 모드 실행중 Lamp ON
	else if( P_SM_Anode_2nd_PNP_Vac_Chk_Mode != 0 && P_Anode_2nd_PNP_Vac_Chk_Execute_Timer > 500 )
	{
		P_Anode_2nd_PNP_Vac_Chk_Execute_Timer = 0
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_2nd_PNP_Vac_Chk_Mode) ^= $1;
	}
	else
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_2nd_PNP_Vac_Chk_Mode) = 0
	}
	
	// 양극 2차 PNP 흡착 텍 측정 모드 실행 가능 Lamp ON
	if( ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos|| P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos) && P_SM_Cathode_2nd_PNP_Vac_Chk_Mode == 0 && P_PNP_Vac_Chk_Mode_Interlock == 0 )
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_2nd_PNP_Vac_Chk_Mode) = 1
	}
	// 양극 2차 PNP 흡착 텍 측정 모드 실행중 Lamp ON
	else if( P_SM_Cathode_2nd_PNP_Vac_Chk_Mode != 0 && P_Cathode_2nd_PNP_Vac_Chk_Execute_Timer > 500 )
	{
		P_Cathode_2nd_PNP_Vac_Chk_Execute_Timer = 0
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_2nd_PNP_Vac_Chk_Mode) ^= $1;
	}
	else
	{
		P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_2nd_PNP_Vac_Chk_Mode) = 0
	}


	// 모든 PNP 흡착 텍 측정 모드가 실행 중이지 않을 경우에만 실행 가능
	if( P_SM_Anode_1st_PNP_Vac_Chk_Mode == 0 && P_SM_Cathode_1st_PNP_Vac_Chk_Mode == 0 && P_SM_Anode_2nd_PNP_Vac_Chk_Mode == 0 && P_SM_Cathode_2nd_PNP_Vac_Chk_Mode == 0 &&  P_SM_Cathode_Stack_MSA == 0 && P_SM_Anode_Stack_MSA == 0 && P_SM_Cathode_Align_MSA == 0 && P_SM_Anode_Align_MSA == 0 )
	{		
		P_VISION_MSA_Status = 0	//A열 MSA 진행 중 상태 EXECUTE = 0	

		//  PNP 흡착 텍 측정 모드 버튼 중 하나만 들어올 때만 동작 가능, 여러개가 들어오면 실행 안함
		if((P_BTN_CA_1st_PNP_Vac_Chk_Mode + P_BTN_AN_1st_PNP_Vac_Chk_Mode + P_BTN_CA_2nd_PNP_Vac_Chk_Mode + P_BTN_AN_2nd_PNP_Vac_Chk_Mode) == 1 && P_PMAC_Current_Mode == F_Current_Manual )
		{
			// PNP 흡착 텍 측정 모드 인터락이 걸리지 않을 경우 실행 가능
			if( P_PNP_Vac_Chk_Mode_Interlock == 0 )
			{
				if( P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_1st_PNP_Vac_Chk_Mode) == 1 && P_BTN_AN_1st_PNP_Vac_Chk_Mode == 1 && P_BTN_AN_1st_PNP_Vac_Chk_Mode != L_Old_N_BTN_AN_1st_PNP_Vac_Chk_Mode )		// 1. 음극 1차 PNP 흡착 텍 측정 모드 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_SM_Anode_1st_PNP_Vac_Chk_Mode = 1;
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
				else if( P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_1st_PNP_Vac_Chk_Mode) == 1 && P_BTN_CA_1st_PNP_Vac_Chk_Mode == 1 && P_BTN_CA_1st_PNP_Vac_Chk_Mode != L_Old_N_BTN_CA_1st_PNP_Vac_Chk_Mode )	// 2. 양극 1차 PNP 흡착 텍 측정 모드 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 1;
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
				else if( P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_2nd_PNP_Vac_Chk_Mode) == 1 && P_BTN_AN_2nd_PNP_Vac_Chk_Mode == 1 && P_BTN_AN_2nd_PNP_Vac_Chk_Mode != L_Old_N_BTN_AN_2nd_PNP_Vac_Chk_Mode )		// 3. 음극 2차 PNP 흡착 텍 측정 모드 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 1
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
				else if( P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_2nd_PNP_Vac_Chk_Mode) == 1 && P_BTN_CA_2nd_PNP_Vac_Chk_Mode == 1 && P_BTN_CA_2nd_PNP_Vac_Chk_Mode != L_Old_N_BTN_CA_2nd_PNP_Vac_Chk_Mode )		// 4. 양극 2차 PNP 흡착 텍 측정 모드 버튼
				{
					//[참조 : 260116 페이징 안된 모터 j/ 막기]
					if( Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
					{
						P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 1
						P_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
					}
				}
			}
			
		}
	}
	// 버튼이 동시에 2개 이상 들어왔을 경우
	else if((P_BTN_CA_1st_PNP_Vac_Chk_Mode + P_BTN_AN_1st_PNP_Vac_Chk_Mode + P_BTN_CA_2nd_PNP_Vac_Chk_Mode + P_BTN_AN_2nd_PNP_Vac_Chk_Mode) > 1)
	{
		// 어떤 버튼이 2개 이상 들어왔는지 저장
		P_Anode_1st_PNP_Vac_Chk_Mode_Err = P_BTN_AN_1st_PNP_Vac_Chk_Mode
		P_Cathode_1st_PNP_Vac_Chk_Mode_Err = P_BTN_CA_1st_PNP_Vac_Chk_Mode
		P_Anode_2nd_PNP_Vac_Chk_Mode_Err = P_BTN_AN_2nd_PNP_Vac_Chk_Mode
		P_Cathode_2nd_PNP_Vac_Chk_Mode_Err = P_BTN_CA_2nd_PNP_Vac_Chk_Mode
		P_PNP_Vac_Chk_Mode_BTN_Err++

	}
}
else 
{
	P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_1st_PNP_Vac_Chk_Mode) = 0;
	P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_1st_PNP_Vac_Chk_Mode) = 0;
	P_PNP_Vac_Mode_Run_Enable_Flag(F_Anode_2nd_PNP_Vac_Chk_Mode) = 0;
	P_PNP_Vac_Mode_Run_Enable_Flag(F_Cathode_2nd_PNP_Vac_Chk_Mode) = 0;
}
L_Old_N_BTN_AN_1st_PNP_Vac_Chk_Mode = P_BTN_AN_1st_PNP_Vac_Chk_Mode;	// Old Data 
L_Old_N_BTN_CA_1st_PNP_Vac_Chk_Mode = P_BTN_CA_1st_PNP_Vac_Chk_Mode;	// Old Data 
L_Old_N_BTN_AN_2nd_PNP_Vac_Chk_Mode = P_BTN_AN_2nd_PNP_Vac_Chk_Mode;	// Old Data 
L_Old_N_BTN_CA_2nd_PNP_Vac_Chk_Mode = P_BTN_CA_2nd_PNP_Vac_Chk_Mode;	// Old Data 
//==============================================================================================================================================================================

// 음극 얼라인 MSA 실행부
switch( P_SM_Anode_Align_MSA )
{
	case 0 :
		P_Anode_Align_Interlock_Blocked = 0
		P_Anode_Align_Stop_Blocked = 0
	break;

	// 모터 서보 ON
	case 1 :
		P_Anode_Align_MSA_Count = 0
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Anode_Algin_MSA_RTN)
			if( P_Anode_Algin_MSA_RTN == 1)
			{
				P_SM_Anode_Align_MSA = 777
			}
		}
	break;

	case 777 :
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_MSA_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_MSA_TimeBase_Rtn == 1 )
		{
			P_SM_Anode_Align_MSA = 2
		}
	break;

	case 2 :
		call Sub_Common_Function.Master_Motion_Program_On(&P_Anode_Algin_MSA_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Anode_Align_MSA = 3
	break;

	case 3 :
		cmd"&23b23r"		// 음극 2차 PNP T축 좌표계 ON
		cmd"&38b38r"		// 음극 2차 PNP Z축 좌표계 ON
		cmd"&21b21r"		// 음극 1차 PNP T축 좌표계 ON
		cmd"&37b37r"		// 음극 1차 PNP Z축 좌표계 ON
		cmd"&25b25r"		// 파이널롤러 좌표계 ON
		cmd"&33b33r"		// NG PNP 좌표계 ON
		//cmd"&22b22r"		// 음극 1차 PNP Picker 좌표계 ON

		P_MSA_Timer = 0
		P_SM_Anode_Align_MSA = 4
	break;

	case 4 :
		if( P_MSA_Timer > 100 )
		{
			if( Coord[23].ProgActive & Coord[38].ProgActive & Coord[21].ProgActive & Coord[37].ProgActive & Coord[25].ProgActive & Coord[33].ProgActive ) //PickerT PNP에 묶음으로 인하여 주석처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]//& Coord[22].ProgActive )
			{
				P_SM_Anode_Align_MSA = 888
			}
			else
			{
				P_SM_Anode_Align_MSA = 3
			}
		}
	break;

	case 888 :
		P_Slave5_Motion_Command = N_FR_Stack_Pos_Motion
		P_SM_Anode_Align_MSA = 889
		P_MSA_Timer = 0
	break;

	case 889 :
		call MSA_SubProg.Motor_Pos_CHK(N_FINAL_ROLL_X, P_Final_Roll_X_Anode_Move, &P_Anode_Algin_MSA_RTN)
		call MSA_SubProg.Motor_Pos_CHK(N_FINAL_ROLL_Z, P_Final_Roll_Z_Run_Pos, &P_Anode_Algin_MSA_RTN2)
		if( P_Anode_Algin_MSA_RTN == 1 && P_Anode_Algin_MSA_RTN2 == 1 )
		{
			P_SM_Anode_Align_MSA = 5
			P_MSA_Timer = 0
		}
	break;


	// 파이널롤러 회피, 양극 방향 이동
	case 5 :
		P_Slave5_Motion_Command = N_FR_Cathode_Move_Motion
		P_SM_Anode_Align_MSA = 6
		P_MSA_Timer = 0
	break;

	// 파이널롤러 양극 방향 이동 완료 확인
	case 6 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_FINAL_ROLL_X, P_Final_Roll_X_Cathode_Move, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 7
			}
		}
	break;

	// 음극 2차 PNP 얼라인 하강
	case 7 : 
		IF( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )
		{
			P_Slave17_Motion_Command = N_2nd_PNP_Align_Down_Motion
			P_SM_Anode_Align_MSA = 8
			P_MSA_Timer = 0
		}
		else
		{
			P_SM_Anode_Align_MSA = 13
		}
	break;

	// 음극 2차 PNP 얼라인 하강 완료 확인
	case 8 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_Z, P_Anode_2nd_Z_Align_Down, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 9
			}
		}	
	break;

	// 음극 2차 PNP 얼라인 흡착
	case 9 : 
		P_Slave17_Motion_Command = N_2nd_PNP_Align_Vac
		P_SM_Anode_Align_MSA = 10
		P_MSA_Timer = 0
	break;

	// 음극 2차 PNP 얼라인 흡착 대기
	case 10 :
		if( P_MSA_Timer > 100 )
		{
			P_SM_Anode_Align_MSA = 11
		}	
	break;

	// 음극 2차 PNP 얼라인 상승
	case 11 : 
		P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion
		P_SM_Anode_Align_MSA = 12
		P_MSA_Timer = 0
	break;

	/// 음극 2차 PNP 얼라인 상승 확인
	case 12 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_Z, P_Anode_2nd_Z_Align_Up, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 13
			}
		}	
	break;

	// 음극 2차 PNP 스택 이동
	case 13 : 
		P_Slave3_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
		P_Slave17_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion;
		P_SM_Anode_Align_MSA = 14
		P_MSA_Timer = 0
	break;


	/// 음극 2차 PNP 스택 이동 확인
	case 14 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_T, P_Anode_2TR_T_Stack_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 15
			}
		}	
	break;


	// 음극 1차 PNP 벨트 이동
	case 15 : 
		P_Slave1_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion;
		P_SM_Anode_Align_MSA = 16
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 벨트 이동 확인
	case 16 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Belt_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 17
			}
		}	
	break;


	// 음극 1차 PNP 벨트 하강
	case 17 : 
		if( M_X_PLC_Anode_Sheet_Ready == 1 )
		{
			P_Slave16_Motion_Command = N_1st_PNP_Belt_Down_Motion
			P_SM_Anode_Align_MSA = 18
			P_MSA_Timer = 0
		}
	break;


	// 음극 1차 PNP 벨트 하강 이동 확인
	case 18 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Belt_Down, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 19
			}
		}	
	break;


	// 음극 1차 PNP 벨트 흡착
	case 19 : 
		P_Slave16_Motion_Command = N_1st_PNP_Belt_Vac
		P_SM_Anode_Align_MSA = 20
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 벨트 흡착 대기
	case 20 :
		if( P_MSA_Timer > 100 )
		{
			P_SM_Anode_Align_MSA = 21
		}	
	break;


	// 음극 1차 PNP 벨트 상승
	case 21 : 
		P_Slave16_Motion_Command = N_1st_PNP_Belt_Up_Motion
		P_SM_Anode_Align_MSA = 22
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 벨트 상승 이동 확인
	case 22 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Belt_Up, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 23
			}
		}	
	break;

	// 음극 1차 PNP 얼라인 이동, 피커 회전
	case 23 :
		//P_Slave2_Motion_Command = N_1st_Picker_Turn								//PickerT PNP에 묶음으로 인하여 주석처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
		P_Slave1_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Belt_To_Align_Motion;
		P_SM_Anode_Align_MSA = 24
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 이동 확인, 피커 회전 확인
	case 24 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Align_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 && P_First_PNP_Picker_T_Turn_Status == F_Status_COMPLETE )
			{
				P_SM_Anode_Align_MSA = 25
			}

		}
	break;

	// 음극 1차 PNP 얼라인 하강
	case 25 :
		P_Slave16_Motion_Command = N_1st_PNP_Align_Down_Motion
		P_SM_Anode_Align_MSA = 26
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 하강 확인
	case 26 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Align_Down, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 27
			}
		}
	break;

	// 음극 1차 PNP 얼라인 블로우
	case 27 :
		P_Slave16_Motion_Command = N_1st_PNP_Align_Blow;
		P_SM_Anode_Align_MSA = 28
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 블로우 대기
	case 28 :
		if( P_MSA_Timer > 100 )
		{
			P_Anode_Align_MSA_Count++
			if( P_Anode_Align_MSA_Count >= P_MSA_Run_Repeat_Num(F_Anode_Align_MSA))
			{
				P_SM_Anode_Align_MSA = 37
			}
			else
			{
				P_SM_Anode_Align_MSA = 29
			}
		}
	break;

	// 음극 1차 PNP 얼라인 흡착
	case 29 :
		P_Slave16_Motion_Command = N_1st_PNP_Align_Vac
		P_SM_Anode_Align_MSA = 30
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 흡착 대기
	case 30 :
		if( P_MSA_Timer > 100 )
		{
			P_SM_Anode_Align_MSA = 31
		}
	break;


	// 음극 1차 PNP 얼라인 상승
	case 31 :
		P_Slave16_Motion_Command = N_1st_PNP_Align_Up_Motion
		P_SM_Anode_Align_MSA = 32
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 상승 확인
	case 32 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Align_Up, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 33
			}
		}
	break;

	// 음극 1차 PNP 벨트 이동
	case 33 :
		P_Slave1_Motion_Command = N_1st_PNP_Align_To_Belt_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Align_To_Belt_Motion;
		P_SM_Anode_Align_MSA = 34
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 벨트 이동 확인
	case 34 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Belt_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 35
			}
		}
	break;


	// 음극 1차 PNP 얼라인 이동
	case 35 :
		P_Slave1_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Belt_To_Align_Motion;
		P_SM_Anode_Align_MSA = 36
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 이동 확인
	case 36 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Align_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 25
			}

		}
	break;


	// 음극 1차 PNP 얼라인 상승
	case 37 :
		P_Slave16_Motion_Command = N_1st_PNP_Align_Up_Motion
		P_SM_Anode_Align_MSA = 38
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 상승 확인
	case 38 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Align_Up, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 39
			}
		}
	break;

	// 음극 1차 PNP 얼라인 대기위치 이동
	case 39 :
		P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion;
		P_SM_Anode_Align_MSA = 40
		P_MSA_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 대기위치 이동 확인
	case 40 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Ready_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 90
			}
		}
	break;

	// 음극 ng pnp 얼라인 이동
	case 90 :
		P_Slave13_Motion_Command = N_NG_PNP_NG_To_Align_Motion
		P_SM_Anode_Align_MSA = 91
		P_MSA_Timer = 0
	break;

	// 음극 ng pnp 얼라인 이동 확인
	case 91 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_AN_T, P_Anode_NG_T_NG_To_Align, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 93
			}
		}
	break;

	// 음극 ng pnp 얼라인 하강
	case 93 :
		P_Slave13_Motion_Command = N_NG_PNP_Align_Down_Motion
		P_SM_Anode_Align_MSA = 94
		P_MSA_Timer = 0
	break;

	// 음극 ng pnp 얼라인 하강 확인
	case 94 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_AN_Z, P_Anode_NG_Z_Align_Down, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 95
			}
		}
	break;

	// 음극 ng pnp 얼라인 흡착
	case 95 :
		P_Slave13_Motion_Command = N_NG_PNP_Align_Vac
		P_SM_Anode_Align_MSA = 96
		P_MSA_Timer = 0
	break;

	// 음극 ng pnp 얼라인 흡착 대기
	case 96 :
		if( P_MSA_Timer > 200 )
		{
			P_SM_Anode_Align_MSA = 97
		}
	break;

	// 음극 ng pnp 얼라인 상승
	case 97 :
		P_Slave13_Motion_Command = N_NG_PNP_Align_UP_Motion
		P_SM_Anode_Align_MSA = 98
		P_MSA_Timer = 0
	break;

	// 음극 ng pnp 얼라인 상승 확인
	case 98 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_AN_Z, P_Anode_NG_Z_Align_Up, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 99
			}
		}
	break;

	// 음극 ng pnp 얼라인 이동
	case 99 :
		P_Slave13_Motion_Command = N_NG_PNP_Align_To_NG_Motion
		P_SM_Anode_Align_MSA = 100
		P_MSA_Timer = 0
	break;

	// 음극 ng pnp 얼라인 이동 확인
	case 100 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_AN_T, P_Anode_NG_T_Align_To_NG, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				// ng PNP 블로우
				M_Y_Anode_NG_PNP_Ejector_Vac_On = 0
				M_Y_Anode_NG_PNP_Ejector_Vac_Off = 1 
				// 260708 MSA 종료 중 NG PNP 블로우를 했는데 Data가 삭제되지 않아 재가동 시 진공알람 발생하여 수정
				Sys_Anode_NG_TR_Sheet_Data = 0
				P_SM_Anode_Align_MSA = 41
			}
		}
	break;


	case 41 :
		if( Motor[N_1st_PnP_AN_T].DesVel == 0 && Motor[N_1st_PnP_AN_Z].DesVel == 0 && Motor[N_2nd_PnP_AN_Z].DesVel == 0 && Motor[N_2nd_PnP_AN_T].DesVel == 0 )
		{
			P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion
			P_SM_Anode_Align_MSA = 42
			P_MSA_Timer = 0
		}
	break;

	case 42 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Ready_Up, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 43
			}
		}
	break;

	case 43 :
		P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion;
		P_SM_Anode_Align_MSA = 44
		P_MSA_Timer = 0
	break;

	case 44 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Ready_POS, &P_Anode_Algin_MSA_RTN)

			if( P_Anode_Algin_MSA_RTN == 1 )
			{
				P_SM_Anode_Align_MSA = 45
			}
		}
	break;

	case 45 :

		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드		
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Anode_Algin_MSA_RTN);
		P_SM_Anode_Align_MSA = 0
		P_Anode_Align_MSA_Count = 0
		//[ 참조 : 26.11.03 MSA 동작 완료 후 Status Clear 삭제 ]	
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 125
	break;

	default :
	break;
}



// 양극 얼라인 MSA 실행부
switch( P_SM_Cathode_Align_MSA )
{
	case 0 :
		P_Cathode_Align_Interlock_Blocked = 0
		P_Cathode_Align_Stop_Blocked = 0
	break;

	// 모터 서보 ON
	case 1 :
		P_Cathode_Align_MSA_Count = 0
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Cathode_Algin_MSA_RTN)
			if( P_Cathode_Algin_MSA_RTN == 1)
			{
				P_SM_Cathode_Align_MSA = 777
			}
		}
	break;

	case 777 :
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_MSA_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_MSA_TimeBase_Rtn == 1 )
		{
			P_SM_Cathode_Align_MSA = 2
		}
	break;

	case 2 :
		call Sub_Common_Function.Master_Motion_Program_On(&P_Cathode_Algin_MSA_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Cathode_Align_MSA = 3
	break;

	case 3 :
		cmd"&28b28r"		// 양극 2차 PNP T축 좌표계 ON
		cmd"&39b39r"		// 양극 2차 PNP Z축 좌표계 ON
		cmd"&30b30r"		// 양극 1차 PNP T축 좌표계 ON
		cmd"&40b40r"		// 양극 1차 PNP Z축 좌표계 ON
		cmd"&25b25r"		// 파이널롤러 좌표계 ON
		cmd"&32b32r"		// NG PNP 좌표계 ON
		//cmd"&29b29r"		// 양극 1차 PNP Picker 좌표계 ON

		P_MSA_Timer = 0
		P_SM_Cathode_Align_MSA = 4
	break;

	case 4 :
		if( P_MSA_Timer > 100 )
		{
			if( Coord[28].ProgActive & Coord[39].ProgActive & Coord[30].ProgActive & Coord[40].ProgActive & Coord[25].ProgActive ) //PickerT PNP에 묶음으로 인하여 주석처리 [ 참조 : 26.08.14 PickerT 모션 변경 ] //& Coord[29].ProgActive )
			{
				P_SM_Cathode_Align_MSA = 5
			}
			else
			{
				P_SM_Cathode_Align_MSA = 3
			}
		}
	break;

	// 파이널롤러 회피, 양극 방향 이동
	case 5 :
		//P_Slave5_Motion_Command = N_FR_Cathode_Move_Motion
		P_SM_Cathode_Align_MSA = 6
		//P_MSA_Timer = 0
	break;

	// 파이널롤러 양극 방향 이동 완료 확인
	case 6 :
		//if( P_MSA_Timer > 100 )
		//{
		//	call MSA_SubProg.Motor_Pos_CHK(N_FINAL_ROLL_X, P_Final_Roll_X_Cathode_Move, &P_Cathode_Algin_MSA_RTN)
		//
		//	if( P_Cathode_Algin_MSA_RTN == 1 )
		//	{
				P_SM_Cathode_Align_MSA = 7
		//	}
		//}
	break;

	// 양극 2차 PNP 얼라인 하강
	case 7 : 
		// 얼라인에 극판이 존재 시에만 하강
		if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )
		{
			P_Slave18_Motion_Command = N_2nd_PNP_Align_Down_Motion
			P_SM_Cathode_Align_MSA = 8
			P_MSA_Timer = 0
		}
		// 얼라인에 극판 미존재 시 2차 PNP 스택 전진 스탭으로 이동
		else
		{
			P_SM_Cathode_Align_MSA = 13
		}
	break;

	// 양극 2차 PNP 얼라인 하강 완료 확인
	case 8 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_Z, P_Cathode_2nd_Z_Align_Down, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 9
			}
		}	
	break;

	// 양극 2차 PNP 얼라인 흡착
	case 9 : 
		P_Slave18_Motion_Command = N_2nd_PNP_Align_Vac
		P_SM_Cathode_Align_MSA = 10
		P_MSA_Timer = 0
	break;

	// 양극 2차 PNP 얼라인 흡착 대기
	case 10 :
		if( P_MSA_Timer > 100 )
		{
			P_SM_Cathode_Align_MSA = 11
		}	
	break;

	// 음극 2차 PNP 얼라인 상승
	case 11 : 
		P_Slave18_Motion_Command = N_2nd_PNP_Align_Up_Motion
		P_SM_Cathode_Align_MSA = 12
		P_MSA_Timer = 0
	break;

	/// 양극 2차 PNP 얼라인 상승 확인
	case 12 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_Z, P_Cathode_2nd_Z_Align_Up, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 13
			}
		}	
	break;

	// 양극 2차 PNP 스택 이동
	case 13 : 
		P_Slave8_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
		P_Slave18_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion;	
		P_SM_Cathode_Align_MSA = 14
		P_MSA_Timer = 0
	break;


	/// 양극 2차 PNP 스택 이동 확인
	case 14 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_T, P_Cathode_2TR_T_Stack_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 15
			}
		}	
	break;


	// 양극 1차 PNP 벨트 이동
	case 15 : 
		P_Slave10_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
		P_SM_Cathode_Align_MSA = 16
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 벨트 이동 확인
	case 16 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Belt_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 17
			}
		}	
	break;


	// 양극 1차 PNP 벨트 하강
	case 17 : 
		if( M_X_PLC_Cathode_Sheet_Ready == 1 )
		{
			P_Slave19_Motion_Command = N_1st_PNP_Belt_Down_Motion
			P_SM_Cathode_Align_MSA = 18
			P_MSA_Timer = 0
		}
	break;


	// 양극 1차 PNP 벨트 하강 이동 확인
	case 18 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Belt_Down, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 19
			}
		}	
	break;


	// 양극 1차 PNP 벨트 흡착
	case 19 : 
		P_Slave19_Motion_Command = N_1st_PNP_Belt_Vac
		P_SM_Cathode_Align_MSA = 20
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 벨트 흡착 대기
	case 20 :
		if( P_MSA_Timer > 100 )
		{
			P_SM_Cathode_Align_MSA = 21
		}	
	break;


	// 양극 1차 PNP 벨트 상승
	case 21 : 
		P_Slave19_Motion_Command = N_1st_PNP_Belt_Up_Motion
		P_SM_Cathode_Align_MSA = 22
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 벨트 상승 이동 확인
	case 22 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Belt_Up, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 23
			}
		}	
	break;

	// 양극 1차 PNP 얼라인 이동, 피커 회전
	case 23 :
		//P_Slave9_Motion_Command = N_1st_Picker_Turn							//PickerT PNP에 묶음으로 인하여 주석처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
		P_Slave10_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Belt_To_Align_Motion;														// 음극 1차 PNP Z축 얼라인 위치 이동.
		P_SM_Cathode_Align_MSA = 24
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 이동 확인, 피커 회전 확인
	case 24 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Align_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 && P_First_PNP_Picker_T_Turn_Status == F_Status_COMPLETE )
			{
				P_SM_Cathode_Align_MSA = 25
			}

		}
	break;

	// 양극 1차 PNP 얼라인 하강
	case 25 :
		P_Slave19_Motion_Command = N_1st_PNP_Align_Down_Motion
		P_SM_Cathode_Align_MSA = 26
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 하강 확인
	case 26 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Align_Down, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 27
			}
		}
	break;

	// 양극 1차 PNP 얼라인 블로우
	case 27 :
		P_Slave19_Motion_Command = N_1st_PNP_Align_Blow
		P_SM_Cathode_Align_MSA = 28
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 블로우 대기
	case 28 :
		if( P_MSA_Timer > 100 )
		{
			P_Cathode_Align_MSA_Count++
			if( P_Cathode_Align_MSA_Count >= P_MSA_Run_Repeat_Num(F_Cathode_Align_MSA))
			{
				P_SM_Cathode_Align_MSA = 37
			}
			else
			{
				P_SM_Cathode_Align_MSA = 29
			}
		}
	break;

	// 양극 1차 PNP 얼라인 흡착
	case 29 :
		P_Slave19_Motion_Command = N_1st_PNP_Align_Vac
		P_SM_Cathode_Align_MSA = 30
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 흡착 대기
	case 30 :
		if( P_MSA_Timer > 100 )
		{
			P_SM_Cathode_Align_MSA = 31
		}
	break;


	// 양극 1차 PNP 얼라인 상승
	case 31 :
		P_Slave19_Motion_Command = N_1st_PNP_Align_Up_Motion
		P_SM_Cathode_Align_MSA = 32
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 상승 확인
	case 32 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Align_Up, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 33
			}
		}
	break;

	// 양극 1차 PNP 벨트 이동
	case 33 :
		P_Slave10_Motion_Command = N_1st_PNP_Align_To_Belt_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Align_To_Belt_Motion;
		P_SM_Cathode_Align_MSA = 34
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 벨트 이동 확인
	case 34 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Belt_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 35
			}
		}
	break;


	// 양극 1차 PNP 얼라인 이동
	case 35 :
		P_Slave10_Motion_Command = N_1st_PNP_Belt_To_Align_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Belt_To_Align_Motion;
		P_SM_Cathode_Align_MSA = 36
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 이동 확인
	case 36 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Align_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 25
			}

		}
	break;


	// 양극 1차 PNP 얼라인 상승
	case 37 :
		P_Slave19_Motion_Command = N_1st_PNP_Align_Up_Motion
		P_SM_Cathode_Align_MSA = 38
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 상승 확인
	case 38 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Align_Up, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 39
			}
		}
	break;

	// 양극 1차 PNP 얼라인 대기위치 이동
	case 39 :
		P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_SM_Cathode_Align_MSA = 40
		P_MSA_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 대기위치 이동 확인
	case 40 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Ready_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 90
			}
		}
	break;

	// 양극 ng pnp 얼라인 이동
	case 90 :
		P_Slave12_Motion_Command = N_NG_PNP_NG_To_Align_Motion
		P_SM_Cathode_Align_MSA = 91
		P_MSA_Timer = 0
	break;

	// 양극 ng pnp 얼라인 이동 확인
	case 91 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_CA_T, P_Cathode_NG_T_NG_To_Align, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 93
			}
		}
	break;

	// 양극 ng pnp 얼라인 하강
	case 93 :
		P_Slave12_Motion_Command = N_NG_PNP_Align_Down_Motion
		P_SM_Cathode_Align_MSA = 94
		P_MSA_Timer = 0
	break;

	// 양극 ng pnp 얼라인 하강 확인
	case 94 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_CA_Z, P_Cathode_NG_Z_Align_Down, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 95
			}
		}
	break;

	// 양극 ng pnp 얼라인 흡착
	case 95 :
		P_Slave12_Motion_Command = N_NG_PNP_Align_Vac
		P_SM_Cathode_Align_MSA = 96
		P_MSA_Timer = 0
	break;

	// 양극 ng pnp 얼라인 흡착 대기
	case 96 :
		if( P_MSA_Timer > 200 )
		{
			P_SM_Cathode_Align_MSA = 97
		}
	break;

	// 양극 ng pnp 얼라인 상승
	case 97 :
		P_Slave12_Motion_Command = N_NG_PNP_Align_UP_Motion
		P_SM_Cathode_Align_MSA = 98
		P_MSA_Timer = 0
	break;

	// 양극 ng pnp 얼라인 상승 확인
	case 98 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_CA_Z, P_Cathode_NG_Z_Align_Up, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 99
			}
		}
	break;

	// 양극 ng pnp 얼라인 이동
	case 99 :
		P_Slave12_Motion_Command = N_NG_PNP_Align_To_NG_Motion
		P_SM_Cathode_Align_MSA = 100
		P_MSA_Timer = 0
	break;

	// 양극 ng pnp 얼라인 이동 확인
	case 100 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_NG_PnP_CA_T, P_Cathode_NG_T_Align_To_NG, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{	
				//ng pnp 블로우
				M_Y_Cathode_NG_PNP_Ejector_Vac_On = 0
				M_Y_Cathode_NG_PNP_Ejector_Vac_Off = 1 
				// 260708 MSA 종료 중 NG PNP 블로우를 했는데 Data가 삭제되지 않아 재가동 시 진공알람 발생하여 수정
				Sys_Cathode_NG_TR_Sheet_Data = 0
				P_SM_Cathode_Align_MSA = 41
			}
		}
	break;


	case 41 :
		if( Motor[N_1st_PnP_CA_T].DesVel == 0 && Motor[N_1st_PnP_CA_Z].DesVel == 0 && Motor[N_2nd_PnP_CA_Z].DesVel == 0 && Motor[N_2nd_PnP_CA_T].DesVel == 0 )
		{
			P_Slave19_Motion_Command = N_1st_PNP_Ready_Pos_Motion
			P_SM_Cathode_Align_MSA = 42
			P_MSA_Timer = 0
		}
	break;

	case 42 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Ready_Up, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 43
			}
		}
	break;

	case 43 :
		P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Ready_Pos_Motion;
		P_SM_Cathode_Align_MSA = 44
		P_MSA_Timer = 0
	break;

	case 44 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Ready_POS, &P_Cathode_Algin_MSA_RTN)

			if( P_Cathode_Algin_MSA_RTN == 1 )
			{
				P_SM_Cathode_Align_MSA = 45
			}
		}
	break;

	case 45 :

		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드		
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Cathode_Algin_MSA_RTN);
		P_SM_Cathode_Align_MSA = 0
		P_Cathode_Align_MSA_Count = 0
		//[ 참조 : 26.11.03 MSA 동작 완료 후 Status Clear 삭제 ]	
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 126
	break;

	default :
	break;
}



// 양극 Stack MSA 실행부
switch( P_SM_Cathode_Stack_MSA )
{
	case 0 :
		P_Cathode_Stack_Interlock_Blocked = 0
		P_Cathode_Stack_Stop_Blocked = 0
	break;

	// 모터 서보 ON
	case 1 :
		P_Cathode_Stack_MSA_Count = 0
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Cathode_Stack_MSA_RTN)
			if( P_Cathode_Stack_MSA_RTN == 1)
			{
				P_SM_Cathode_Stack_MSA = 777
			}
		}
	break;

	case 777 :
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_MSA_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_MSA_TimeBase_Rtn == 1 )
		{
			P_SM_Cathode_Stack_MSA = 2
		}
	break;


	case 2 :
		call Sub_Common_Function.Master_Motion_Program_On(&P_Cathode_Stack_MSA_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Cathode_Stack_MSA = 3
	break;

	case 3 :
		cmd"&28b28r"		// 양극 2차 PNP T축 좌표계 ON
		cmd"&39b39r"		// 양극 2차 PNP Z축 좌표계 ON

		P_MSA_Timer = 0
		P_SM_Cathode_Stack_MSA = 4
	break;

	case 4 :
		if( P_MSA_Timer > 100 )
		{
			if( Coord[28].ProgActive & Coord[39].ProgActive )
			{
				P_SM_Cathode_Stack_MSA = 5
			}
			else
			{
				P_SM_Cathode_Stack_MSA = 3
			}
		}
	break;

	// 양극 2차 PNP 스택 이동
	case 5 : 
		P_Slave8_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
		P_Slave18_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion;	
		P_SM_Cathode_Stack_MSA = 6
		P_MSA_Timer = 0
	break;

	// 양극 2차 PNP 스택 이동 확인
	case 6 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_T, P_Cathode_2TR_T_Stack_POS, &P_Cathode_Stack_MSA_RTN)

			if( P_Cathode_Stack_MSA_RTN == 1 )
			{
				P_SM_Cathode_Stack_MSA = 7
			}
		}	
	break;

	// 양극 2차 PNP 스택 하강
	case 7 : 
		P_Slave18_Motion_Command = N_2nd_PNP_Stack_Down_Motion
		P_SM_Cathode_Stack_MSA = 8
		P_MSA_Timer = 0
	break;
	
	// 양극 2차 PNP 스택 하강 확인
	case 8 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_Z, P_Cathode_2nd_Z_Stack_Down, &P_Cathode_Stack_MSA_RTN)

			if( P_Cathode_Stack_MSA_RTN == 1 )
			{
				P_SM_Cathode_Stack_MSA = 9
			}
		}	
	break;
	
	// 스택 촬상
	case 9 :
		M_Y_Vision_Stack_Cathode_Trigger = 1
		P_MSA_Timer = 0
		P_SM_Cathode_Stack_MSA = 10
	break
	
	// 스택 촬상 신호 초기화
	case 10:
		if( P_MSA_Timer > 100 )
		{
			M_Y_Vision_Stack_Cathode_Trigger = 0
			P_SM_Cathode_Stack_MSA = 11
		}
	break
	
	// 양극 2차 PNP 스택 상승
	case 11 : 
		P_Slave18_Motion_Command = N_2nd_PNP_Stack_Up_Motion
		P_SM_Cathode_Stack_MSA = 12
		P_MSA_Timer = 0
	break;
	
	// 양극 2차 PNP 스택 상승 확인
	case 12 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_Z, P_Cathode_2nd_Z_Stack_Up, &P_Cathode_Stack_MSA_RTN)

			if( P_Cathode_Stack_MSA_RTN == 1 )
			{
				P_SM_Cathode_Stack_MSA = 13
			}
		}	
	break;
	
	// 양극 2차 PNP 얼라인 이동
	case 13 : 
		P_Slave8_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
		P_Slave18_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion;	
		P_SM_Cathode_Stack_MSA = 14
		P_MSA_Timer = 0
	break;

	// 양극 2차 PNP 스택 얼라인 확인
	case 14 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_T, P_Cathode_2TR_T_Align_POS, &P_Cathode_Stack_MSA_RTN)

			if( P_Cathode_Stack_MSA_RTN == 1 )
			{
				P_SM_Cathode_Stack_MSA = 15
			}
		}	
	break;
	
	// 양극 Stack MSA 반복 회수 판단
	case 15 :
		P_Cathode_Stack_MSA_Count++
		if( P_Cathode_Stack_MSA_Count < P_MSA_Run_Repeat_Num(F_Cathode_Stack_MSA))
		{
			P_SM_Cathode_Stack_MSA = 5
		}
		else
		{
			P_SM_Cathode_Stack_MSA = 44
		}
	break;

	case 44 :
		if( Motor[N_2nd_PnP_CA_Z].DesVel == 0 && Motor[N_2nd_PnP_CA_T].DesVel == 0 )
		{
			P_SM_Cathode_Stack_MSA = 45
			P_MSA_Timer = 0
		}
	break;

	case 45 :
		if( P_MSA_Timer > 500 )
		{
			P_SM_Cathode_Stack_MSA = 16
		}
	break; 

	// 종료
	case 16 :
		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드		
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Anode_Algin_MSA_RTN);
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 31
		P_SM_Cathode_Stack_MSA = 0	
		P_Cathode_Stack_MSA_Count = 0
	break;
}


// 음극 Stack MSA 실행부
switch( P_SM_Anode_Stack_MSA )
{
	case 0 :
		P_Anode_Stack_Interlock_Blocked = 0
		P_Anode_Stack_Stop_Blocked = 0
	break;

	// 모터 서보 ON
	case 1 :
		P_Anode_Stack_MSA_Count = 0
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Anode_Stack_MSA_RTN)
			if( P_Anode_Stack_MSA_RTN == 1)
			{
				P_SM_Anode_Stack_MSA = 777
			}
		}
	break;

	case 777 :
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_MSA_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_MSA_TimeBase_Rtn == 1 )
		{
			P_SM_Anode_Stack_MSA = 2
		}
	break;


	case 2 :
		call Sub_Common_Function.Master_Motion_Program_On(&P_Anode_Stack_MSA_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Anode_Stack_MSA = 3
	break;

	case 3 :
		cmd"&23b23r"		// 음극 2차 PNP T축 좌표계 ON
		cmd"&38b38r"		// 음극 2차 PNP Z축 좌표계 ON

		P_MSA_Timer = 0
		P_SM_Anode_Stack_MSA = 4
	break;

	case 4 :
		if( P_MSA_Timer > 100 )
		{
			if( Coord[23].ProgActive & Coord[38].ProgActive )
			{
				P_SM_Anode_Stack_MSA = 5
			}
			else
			{
				P_SM_Anode_Stack_MSA = 3
			}
		}
	break;

	// 음극 2차 PNP 스택 이동
	case 5 : 
		P_Slave3_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion
		P_Slave17_Motion_Command = N_2nd_PNP_Align_To_Stack_Motion;	
		P_SM_Anode_Stack_MSA = 6
		P_MSA_Timer = 0
	break;

	// 음극 2차 PNP 스택 이동 확인
	case 6 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_T, P_Anode_2TR_T_Stack_POS, &P_Anode_Stack_MSA_RTN)

			if( P_Anode_Stack_MSA_RTN == 1 )
			{
				P_SM_Anode_Stack_MSA = 7
			}
		}	
	break;

	// 음극 2차 PNP 스택 하강
	case 7 : 
		P_Slave17_Motion_Command = N_2nd_PNP_Stack_Down_Motion
		P_SM_Anode_Stack_MSA = 8
		P_MSA_Timer = 0
	break;
	
	// 음극 2차 PNP 스택 하강 확인
	case 8 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_Z, P_Anode_2nd_Z_Stack_Down, &P_Anode_Stack_MSA_RTN)

			if( P_Anode_Stack_MSA_RTN == 1 )
			{
				P_SM_Anode_Stack_MSA = 9
			}
		}	
	break;
	
	// 스택 촬상
	case 9 :
		M_Y_Vision_Stack_Anode_Trigger = 1
		P_MSA_Timer = 0
		P_SM_Anode_Stack_MSA = 10
	break
	
	// 스택 촬상 신호 초기화
	case 10:
		if( P_MSA_Timer > 100 )
		{
			M_Y_Vision_Stack_Anode_Trigger = 0
			P_SM_Anode_Stack_MSA = 11
		}
	break
	
	// 음극 2차 PNP 스택 상승
	case 11 : 
		P_Slave17_Motion_Command = N_2nd_PNP_Stack_Up_Motion
		P_SM_Anode_Stack_MSA = 12
		P_MSA_Timer = 0
	break;
	
	// 음극 2차 PNP 스택 상승 확인
	case 12 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_Z, P_Anode_2nd_Z_Stack_Up, &P_Anode_Stack_MSA_RTN)

			if( P_Anode_Stack_MSA_RTN == 1 )
			{
				P_SM_Anode_Stack_MSA = 13
			}
		}	
	break;
	
	// 음극 2차 PNP 얼라인 이동
	case 13 : 
		P_Slave3_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion
		P_Slave17_Motion_Command = N_2nd_PNP_Stack_To_Align_Motion;	
		P_SM_Anode_Stack_MSA = 14
		P_MSA_Timer = 0
	break;

	// 음극 2차 PNP 스택 얼라인 확인
	case 14 :
		if( P_MSA_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_T, P_Anode_2TR_T_Align_POS, &P_Anode_Stack_MSA_RTN)

			if( P_Anode_Stack_MSA_RTN == 1 )
			{
				P_SM_Anode_Stack_MSA = 15
			}
		}	
	break;
	
	// 음극 Stack MSA 반복 회수 판단
	case 15 :
		P_Anode_Stack_MSA_Count++
		if( P_Anode_Stack_MSA_Count < P_MSA_Run_Repeat_Num(F_Anode_Stack_MSA))
		{
			P_SM_Anode_Stack_MSA = 5
		}
		else
		{
			P_SM_Anode_Stack_MSA = 44
		}
	break;

	case 44 :
		if( Motor[N_2nd_PnP_AN_Z].DesVel == 0 && Motor[N_2nd_PnP_AN_T].DesVel == 0 )
		{
			P_SM_Anode_Stack_MSA = 45
			P_MSA_Timer = 0
		}
	break;

	case 45 :
		if( P_MSA_Timer > 500 )
		{
			P_SM_Anode_Stack_MSA = 16
		}
	break; 
	
	// 종료
	case 16 :
		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드		
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Anode_Algin_MSA_RTN);
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 32
		P_SM_Anode_Stack_MSA = 0	
		P_Anode_Stack_MSA_Count = 0
	break;
}

//===========================================================================================================================================================
//PNP 흡착 텍 측정 모드 실행부 //[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
//===========================================================================================================================================================
// 음극 1차 PNP 흡착 텍 측정 모드 실행부
//------------------------------------------------------------------------------------------------------------------------
switch( P_SM_Anode_1st_PNP_Vac_Chk_Mode )
{
	case 0 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_IDLE;
		P_Anode_1st_PNP_Vac_Chk_Mode_Blocked = 0;
		P_Anode_1st_PNP_Vac_Chk_Mode_Stop_Blocked = 0;
	break;

	// 모터 서보 ON
	case 1 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Anode_1st_PnP_Vac_Chk_Mode_RTN)
			if( P_Anode_1st_PnP_Vac_Chk_Mode_RTN == 1)
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 777
			}
		}
	break;

	// 타임 베이스 ON
	case 777 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_PNP_Vac_Chk_Mode_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_PNP_Vac_Chk_Mode_TimeBase_Rtn == 1 )
		{
			P_SM_Anode_1st_PNP_Vac_Chk_Mode = 2
		}
	break;

	//마스터 모션, 서브마스터, 슬레이브 ON
	case 2 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		call Sub_Common_Function.Master_Motion_Program_On(&P_Anode_1st_PnP_Vac_Chk_Mode_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 3
	break;

	// 음극 1차 PNP T, Z축 좌표계 ON
	case 3 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		cmd"&21b21r"		// 음극 1차 PNP T축 좌표계 ON
		cmd"&37b37r"		// 음극 1차 PNP Z축 좌표계 ON

		P_PNP_Vac_Chk_Mode_Timer = 0
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 4
	break;

	//좌표계 활성화 확인
	case 4 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			if( Coord[21].ProgActive & Coord[37].ProgActive )
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 5
			}
			else
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 3
			}
		}
	break;

	// 음극 1차 PNP 벨트 이동
	case 5 : 
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave1_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion;
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 6
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	// 음극 1차 PNP 벨트 이동 확인
	case 6 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Belt_POS, &P_Anode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Anode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 7
			}
		}	
	break;


	// 음극 1차 PNP 벨트 하강
	case 7 : 
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( M_X_PLC_Anode_Sheet_Ready == 1 || P_Vac_Chk_Test == 1 )
		{
			P_Slave16_Motion_Command = N_1st_PNP_Belt_Down_Motion
			P_SM_Anode_1st_PNP_Vac_Chk_Mode = 8
			P_PNP_Vac_Chk_Mode_Timer = 0
		}
	break;


	// 음극 1차 PNP 벨트 하강 이동 확인
	case 8 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Belt_Down, &P_Anode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Anode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 9
			}
		}	
	break;

	// 음극 1차 PNP 벨트 흡착
	case 9 : 
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave16_Motion_Command = N_1st_PNP_Belt_Vac
		P_Anode_1st_PNP_Vac_Check_Timer = 0;
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 10
	break;

	// 음극 1차 PNP 벨트 흡착 대기
	case 10 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if ( M_Y_Anode_1st_Vac_Sol_On == 1 && M_Y_Anode_1st_Vac_Sol_Off == 0 )		// 흡착 IO ON.
		{
			if ( M_X_Anode_1st_PNP_Vac_Sensor == 1 )								// 입력 센서 들어올 경우.
			{
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array10 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array9
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array9 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array8
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array8 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array7
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array7 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array6
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array6 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array5
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array5 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array4
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array4 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array3
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array3 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array2
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array2 = P_Anode_1st_PNP_Vac_Chk_TackTime_Array1
				P_Anode_1st_PNP_Vac_Chk_TackTime_Array1 = P_Anode_1st_PNP_Vac_Check_Timer

				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 11
			}
		}
	break;

	// 음극 1차 PNP 벨트 상승
	case 11 : 
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave16_Motion_Command = N_1st_PNP_Belt_Up_Motion
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 12
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	// 음극 1차 PNP 벨트 상승 이동 확인
	case 12 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_Z, P_Anode_1st_Z_Belt_Up, &P_Anode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Anode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 13
			}
		}	
	break;

	// 음극 1차 PNP 얼라인 대기위치 이동
	case 13 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion;
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 14
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	// 음극 1차 PNP 얼라인 대기위치 이동 확인
	case 14 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE; 
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_AN_T, P_Anode_1TR_T_Ready_POS, &P_Anode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Anode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Anode_1st_PNP_Vac_Chk_Mode = 15
			}
		}
	break;

	case 15 :
		P_Anode_1st_PNP_Vac_Chk_Status = F_Status_COMPLETE;
		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드	
		P_Slave16_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave17_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave18_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave19_Motion_Command = 0;	// 슬레이브축 커멘드	
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Anode_1st_PnP_Vac_Chk_Mode_RTN);
		P_SM_Anode_1st_PNP_Vac_Chk_Mode = 0
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 120
	break;

	default :
	break;
}
//------------------------------------------------------------------------------------------------------------------------
// 양극 1차 PNP 흡착 텍 측정 모드 실행부 //[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
//------------------------------------------------------------------------------------------------------------------------
switch( P_SM_Cathode_1st_PNP_Vac_Chk_Mode )
{
	case 0 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_IDLE;
		P_Cathode_1st_PNP_Vac_Chk_Mode_Blocked = 0;
		P_Cathode_1st_PNP_Vac_Chk_Mode_Stop_Blocked = 0;
	break;

	// 모터 서보 ON
	case 1 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Cathode_1st_PnP_Vac_Chk_Mode_RTN)
			if( P_Cathode_1st_PnP_Vac_Chk_Mode_RTN == 1)
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 777
			}
		}
	break;

	//타임 베이스 ON
	case 777 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_PNP_Vac_Chk_Mode_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_PNP_Vac_Chk_Mode_TimeBase_Rtn == 1 )
		{
			P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 2
		}
	break;

	//마스터 모션, 서브마스터, 슬레이브 ON
	case 2 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		call Sub_Common_Function.Master_Motion_Program_On(&P_Cathode_1st_PnP_Vac_Chk_Mode_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 3
	break;

	//양극 1차 T, Z축 좌표계 ON
	case 3 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		cmd"&30b30r"		// 양극 1차 PNP T축 좌표계 ON
		cmd"&40b40r"		// 양극 1차 PNP Z축 좌표계 ON
		P_PNP_Vac_Chk_Mode_Timer = 0
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 4
	break;

	//좌표계 활성화 확인
	case 4 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_STARTING;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			if( Coord[30].ProgActive & Coord[40].ProgActive )
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 5
			}
			else
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 3
			}
		}
	break;

	// 양극 1차 PNP 벨트 이동
	case 5 : 
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave10_Motion_Command = N_1st_PNP_Ready_To_Belt_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Ready_Pos_Motion;									
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 6
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	// 양극 1차 PNP 벨트 이동 확인
	case 6 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Belt_POS, &P_Cathode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Cathode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 7
			}
		}
	break;


	// 양극 1차 PNP 벨트 하강
	case 7 : 
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( M_X_PLC_Cathode_Sheet_Ready == 1 || P_Vac_Chk_Test == 1 )
		{
			P_Slave19_Motion_Command = N_1st_PNP_Belt_Down_Motion
			P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 8
			P_PNP_Vac_Chk_Mode_Timer = 0
		}
	break;


	// 양극 1차 PNP 벨트 하강 이동 확인
	case 8 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Belt_Down, &P_Cathode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Cathode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 9
			}
		}	
	break;

	// 양극 1차 PNP 벨트 흡착
	case 9 : 
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave19_Motion_Command = N_1st_PNP_Belt_Vac
		P_Cathode_1st_PNP_Vac_Check_Timer = 0;
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 10
	break;

	// 양극 1차 PNP 벨트 흡착 대기
	case 10 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if ( M_Y_Cathode_1st_Vac_Sol_On == 1 && M_Y_Cathode_1st_Vac_Sol_Off == 0 )		// 흡착 IO ON.
		{
			if ( M_X_Cathode_1st_PNP_Vac_Sensor == 1 )								// 입력 센서 들어올 경우.
			{
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array10 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array9
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array9 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array8
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array8 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array7
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array7 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array6
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array6 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array5
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array5 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array4
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array4 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array3
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array3 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array2
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array2 = P_Cathode_1st_PNP_Vac_Chk_TackTime_Array1
				P_Cathode_1st_PNP_Vac_Chk_TackTime_Array1 = P_Cathode_1st_PNP_Vac_Check_Timer

				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 11
			}
		}
	break;

	// 양극 1차 PNP 벨트 상승
	case 11 : 
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave19_Motion_Command = N_1st_PNP_Belt_Up_Motion
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 12
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	// 양극 1차 PNP 벨트 상승 이동 확인
	case 12 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_Z, P_Cathode_1st_Z_Belt_Up, &P_Cathode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Cathode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 13
			}
		}	
	break;

	// 양극 1차 PNP 얼라인 대기위치 이동
	case 13 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave19_Motion_Command = N_1st_PNP_Ready_Pos_Motion;
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 14
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	// 양극 1차 PNP 얼라인 대기위치 이동 확인
	case 14 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_1st_PnP_CA_T, P_Cathode_1TR_T_Ready_POS, &P_Cathode_1st_PnP_Vac_Chk_Mode_RTN)

			if( P_Cathode_1st_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 15
			}
		}
	break;

	case 15 :
		P_Cathode_1st_PNP_Vac_Chk_Status = F_Status_COMPLETE;
		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드	
		P_Slave16_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave17_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave18_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave19_Motion_Command = 0;	// 슬레이브축 커멘드	
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Cathode_1st_PnP_Vac_Chk_Mode_RTN);
		P_SM_Cathode_1st_PNP_Vac_Chk_Mode = 0
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 121
	break;

	default :
	break;
}
//------------------------------------------------------------------------------------------------------------------------
// 음극 2차 PNP 흡착 텍 측정 모드 실행부 //[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
//------------------------------------------------------------------------------------------------------------------------
switch( P_SM_Anode_2nd_PNP_Vac_Chk_Mode )
{
	case 0 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_IDLE;
		P_Anode_2nd_PNP_Vac_Chk_Mode_Blocked = 0;
		P_Anode_2nd_PNP_Vac_Chk_Mode_Stop_Blocked = 0;
	break;

	// 모터 서보 ON
	case 1 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Anode_2nd_PnP_Vac_Chk_Mode_RTN)
			if( P_Anode_2nd_PnP_Vac_Chk_Mode_RTN == 1)
			{
				P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 777
			}
		}
	break;

	// 타임 베이스 ON
	case 777 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_PNP_Vac_Chk_Mode_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_PNP_Vac_Chk_Mode_TimeBase_Rtn == 1 )
		{
			P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 2
		}
	break;

	//마스터 모션, 서브마스터, 슬레이브 ON
	case 2 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		call Sub_Common_Function.Master_Motion_Program_On(&P_Anode_2nd_PnP_Vac_Chk_Mode_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 3
	break;

	// 음극 2차 PNP T, Z축 좌표계 ON
	case 3 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		cmd"&23b23r"		// 음극 2차 PNP T축 좌표계 ON
		cmd"&38b38r"		// 음극 2차 PNP Z축 좌표계 ON

		P_PNP_Vac_Chk_Mode_Timer = 0
		P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 4
	break;

	//좌표계 활성화 확인
	case 4 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			if( Coord[23].ProgActive & Coord[38].ProgActive )
			{
				P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 5
			}
			else
			{
				P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 3
			}
		}
	break;

	// 음극 2차 PNP 얼라인 하강
	case 5 : 
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		IF( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence || P_Vac_Chk_Test == 1 )
		{
			P_Slave17_Motion_Command = N_2nd_PNP_Align_Down_Motion
			P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 6
			P_PNP_Vac_Chk_Mode_Timer = 0
		}
		else
		{
			P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 11
		}
	break;

	// 음극 2차 PNP 얼라인 하강 완료 확인
	case 6 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_Z, P_Anode_2nd_Z_Align_Down, &P_Anode_2nd_PnP_Vac_Chk_Mode_RTN)

			if( P_Anode_2nd_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 7
			}
		}	
	break;

	// 음극 2차 PNP 얼라인 흡착
	case 7 : 
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave17_Motion_Command = N_2nd_PNP_Align_Vac
		P_Anode_2nd_PNP_Vac_Check_Timer = 0;
		P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 8
	break;

	// 음극 2차 PNP 얼라인 흡착 대기
	case 8 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if ( M_Y_Anode_2nd_Vac_Sol_On == 1 && M_Y_Anode_2nd_Vac_Sol_Off == 0 )		// 흡착 IO ON.
		{
			if ( M_X_Anode_2nd_PNP_Vac_Sensor == 1 )								// 입력 센서 들어올 경우.
			{
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array10 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array9
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array9 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array8
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array8 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array7
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array7 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array6
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array6 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array5
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array5 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array4
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array4 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array3
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array3 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array2
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array2 = P_Anode_2nd_PNP_Vac_Chk_TackTime_Array1
				P_Anode_2nd_PNP_Vac_Chk_TackTime_Array1 = P_Anode_2nd_PNP_Vac_Check_Timer;

				P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 9
			}
		}
	break;

		// 음극 2차 PNP 얼라인 상승
	case 9 : 
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion
		P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 10
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	/// 음극 2차 PNP 얼라인 상승 확인
	case 10 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_AN_Z, P_Anode_2nd_Z_Align_Up, &P_Anode_2nd_PnP_Vac_Chk_Mode_RTN)

			if( P_Anode_2nd_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 11
			}
		}	
	break;

	case 11 :
		P_Anode_2nd_PNP_Vac_Chk_Status = F_Status_COMPLETE;
		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드		
		P_Slave16_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave17_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave18_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave19_Motion_Command = 0;	// 슬레이브축 커멘드
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Anode_2nd_PnP_Vac_Chk_Mode_RTN);
		P_SM_Anode_2nd_PNP_Vac_Chk_Mode = 0
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 122
	break;

	default :
	break;
}
//------------------------------------------------------------------------------------------------------------------------
// 양극 2차 PNP 흡착 텍 측정 모드 실행부 //[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
//------------------------------------------------------------------------------------------------------------------------
switch( P_SM_Cathode_2nd_PNP_Vac_Chk_Mode )
{
	case 0 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_IDLE;
		P_Cathode_2nd_PNP_Vac_Chk_Mode_Blocked = 0;
		P_Cathode_2nd_PNP_Vac_Chk_Mode_Stop_Blocked = 0;
	break;

	// 모터 서보 ON
	case 1 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		//[ 참조 : 26.11.03 MSA 모션 커멘드 초기화 ]
		call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC13_Manual_Stopping_RTN);		
		if ( L_PLC13_Manual_Stopping_RTN == 1 ) 
		{
			call MSA_SubProg.Motor_Servo_ON(&P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN)
			if( P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN == 1)
			{
				P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 777
			}
		}
	break;

	// 타임 베이스 ON
	case 777 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );
		call Sub_Common_Function.Timebase_On(&P_PNP_Vac_Chk_Mode_TimeBase_Rtn);									// 타임 베이스 ON
		if( P_PNP_Vac_Chk_Mode_TimeBase_Rtn == 1 )
		{
			P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 2
		}
	break;

	//마스터 모션, 서브마스터, 슬레이브 ON
	case 2 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		call Sub_Common_Function.Master_Motion_Program_On(&P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN);					//마스터 모션, 서브마스터, 슬레이브 ON
		P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 3
	break;

	// 양극 2차 PNP T, Z축 좌표계 ON
	case 3 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		cmd"&28b28r"		// 양극 2차 PNP T축 좌표계 ON
		cmd"&39b39r"		// 양극 2차 PNP Z축 좌표계 ON

		P_PNP_Vac_Chk_Mode_Timer = 0
		P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 4
	break;

	//좌표계 활성화 확인
	case 4 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_STARTING;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			if( Coord[28].ProgActive & Coord[39].ProgActive )
			{
				P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 5
			}
			else
			{
				P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 3
			}
		}
	break;

	// 양극 2차 PNP 얼라인 하강
	case 5 : 
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		// 얼라인에 극판이 존재 시에만 하강
		if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence || P_Vac_Chk_Test == 1  )
		{
			P_Slave18_Motion_Command = N_2nd_PNP_Align_Down_Motion
			P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 6
			P_PNP_Vac_Chk_Mode_Timer = 0
		}
		else
		{
			P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 11
		}
	break;

	// 양극 2차 PNP 얼라인 하강 완료 확인
	case 6 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_Z, P_Cathode_2nd_Z_Align_Down, &P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN)

			if( P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 7
			}
		}	
	break;

	// 양극 2차 PNP 얼라인 흡착
	case 7 : 
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave18_Motion_Command = N_2nd_PNP_Align_Vac
		P_Cathode_2nd_PNP_Vac_Check_Timer = 0;
		P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 8
	break;

	// 양극 2차 PNP 얼라인 흡착 대기
	case 8 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if ( M_Y_Cathode_2nd_Vac_Sol_On == 1 && M_Y_Cathode_2nd_Vac_Sol_Off == 0 )		// 흡착 IO ON.
		{
			if ( M_X_Cathode_2nd_PNP_Vac_Sensor == 1 )								// 입력 센서 들어올 경우.
			{
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array10 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array9
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array9 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array8
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array8 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array7
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array7 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array6
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array6 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array5
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array5 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array4
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array4 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array3
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array3 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array2
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array2 = P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array1
				P_Cathode_2nd_PNP_Vac_Chk_TackTime_Array1 = P_Cathode_2nd_PNP_Vac_Check_Timer;

				P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 9
			}
		}
	break;

	// 양극 2차 PNP 얼라인 상승
	case 9 : 
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		P_Slave18_Motion_Command = N_2nd_PNP_Align_Up_Motion
		P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 10
		P_PNP_Vac_Chk_Mode_Timer = 0
	break;

	/// 양극 2차 PNP 얼라인 상승 확인
	case 10 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_EXECUTE;
		if( P_PNP_Vac_Chk_Mode_Timer > 100 )
		{
			call MSA_SubProg.Motor_Pos_CHK(N_2nd_PnP_CA_Z, P_Cathode_2nd_Z_Align_Up, &P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN)

			if( P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN == 1 )
			{
				P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 11
			}
		}	
	break;

	case 11 :
		P_Cathode_2nd_PNP_Vac_Chk_Status = F_Status_COMPLETE;
		P_Slave1_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave2_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave3_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave4_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave5_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave6_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave7_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave8_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave9_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave10_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave11_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave12_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave13_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave14_Motion_Command = 0;	// 슬레이브축 커멘드	
		P_Slave16_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave17_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave18_Motion_Command = 0;	// 슬레이브축 커멘드
		P_Slave19_Motion_Command = 0;	// 슬레이브축 커멘드	
		cmd"&1..60a"
		call Sub_Common_Function.Master_Motion_Program_OFF(&P_Cathode_2nd_PnP_Vac_Chk_Mode_RTN);
		P_SM_Cathode_2nd_PNP_Vac_Chk_Mode = 0
		P_PMAC_Commands = F_Command_Stop
		P_Stop_Cmd_Origin = 123
	break;

	default :
	break;
}
//===========================================================================================================================================================

P_MNTR_PLC13_Task_Time(1) = (Sys.Time - P_MNTR_PLC13_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC13_Task_Time(1) > P_MNTR_PLC13_Task_Max_Time )
{
	P_MNTR_PLC13_Task_Max_Time = P_MNTR_PLC13_Task_Time(1);
}

close

