//======================================================================================================//
// 06. 세파 HOST ID 발생 부 
//======================================================================================================//
// NG, 세파 배출이 아닐때 -> 정상 젤리롤 생산
if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence)
{
	// 세파 첫장 검사 OK 시에만 젤리롤 ID 생성
	if(P_Flag_Stack_Work_Host_ID == 1 && P_Vision_First_Sepa_Stack_Align_OK_PMAC_Flag == 1)
	{
		P_Flag_Stack_Work_Host_ID = 0;
		P_Vision_First_Sepa_Stack_Align_OK_PMAC_Flag = 0;
		P_Sepa_Run_Completed_Flag = 1
		//P_Sepa_Run_Completed_Status_Machine = 1;
	}
}

if(P_Sepa_Run_Completed_Status_Machine == 1)
{
	M_Y_Host_JR_ID_Create_Request = 1;		// 세파 깔기 완료 신호 (젤리롤 Host ID 생성 타이밍)

	P_Sepa_Run_Completed_Status_Machine = 2;
}

if(P_Sepa_Run_Completed_Status_Machine == 2)
{
	if(M_X_Host_JR_ID_Create_Complete == 1)	// 세파 깔기 신호 리턴 
	{
		M_Y_Host_JR_ID_Create_Request  = 0;			// 세파 깔기 신호 해제
		P_Current_Cell_Memory_Jelly_Roll = 1;	// 젤리롤 유무 표시 

		P_Sepa_Run_Completed_Status_Machine = 3;
	}
}

if(P_Sepa_Run_Completed_Status_Machine == 3)
{
	if( M_X_Host_JR_ID_Create_Complete == 0 && M_Y_Host_JR_ID_Create_Request == 0 && P_Anode_Count > 1)
	{
		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(0) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(0);
		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(1) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(1);
		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(2) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(2);
		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(3) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(3);
		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(4) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(4);
//		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(5) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(5);
//		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(6) = M_ASCII_Read_Stack_Work_Host_Sepa_ID_Buffer(6);

		P_Sepa_Run_Completed_Status_Machine = N_Complete_Step;
	}
}



// [ 참조 : 260224 Abort 발생 시 모터 Kill 처리 ]
// [ 참조 : 260406 EMO 눌렀을 때 모터 정지 ]
if( P_PMAC_Current_Mode == F_Current_Automatic )
{
	if( ( (M_X_Abort_Command == 1 || M_X_EMO_Signal == 1 ) && P_Blocked_Abort == 0) || M_Y_Abort_Command == 1 )	
	{
		if( P_PMAC_Status != F_Status_ABORTING && P_PMAC_Status != F_Status_ABORTED && P_Seq_Abort == 0 )
		{
			P_Blocked_Abort = 1;
			P_Seq_Abort = 1;
			if ( M_X_Abort_Command == 1 )
			{
				P_Abort_Cnt++
				P_Opposite_Lane_Abort_Alram_Flag = 1
			}
			if( M_X_EMO_Signal == 1 )
			{
				P_EMO_Cnt++
			}
		}
	}

	if ( P_Seq_Abort == 0 )
	{
		if ( P_SlewTime != P_Old_SlewTime )
		{
			Coord[1].TimeBaseSlew = Sys.ServoPeriod * Sys.ServoPeriod / P_SlewTime;
		}
		P_Old_SlewTime = P_SlewTime;
	}
	
	if( P_Seq_Abort == 1 )
	{
		Coord[1].DesTimeBase = 0;
		//cmd"&1%%0"
		P_Seq_Abort_Timer = 0
		P_Seq_Abort++
	}
	
	if( P_Seq_Abort == 2 )
	{
		if( Total_DesVelZero_Bit && P_Seq_Abort_Timer > 1000 )
		{
			cmd"#*k"
			P_Seq_Abort++
		}
	}
	
	if( P_Seq_Abort == 3 )
	{
		if( P_Opposite_Lane_Abort_Alram_Flag == 1 )
		{
			P_Opposite_Lane_Abort_Alram_Flag = 0;
			call Alarm.Insert_Alarm(N_Alarm_Opposite_Lane_Abort_Alram, N_High_Alarm_Emergency_Stop);
		}
		P_Seq_Abort = 0
		
	}
}


// 1차 P&P 벨트에서 극판 픽업 할 때 하강 위치에서 + mm 상승시 Complete 신호 송신
// Start, Interlock 신호 해제
// [ 참조: 26.01.21 극판 인터페이스 추가 ]
if(P_PMAC_Current_Mode == F_Current_Automatic)
{
	//if(P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence)
	//{
		if(P_PLC12_Anode_Sheet_Pick_Up_Flag == 1)
		{
			//// 음극 1차 PNP 벨트 하강 위치에서 10mm 상승 후 sheet complete 신호 보냄(조건 모두 mm 단위)
			//if( P_Recipe_M18_POS(4) - P_Anode_Sheet_Interface_Complete_Pos >= P_Anode_1st_PNP_Z_Real_Move_Pos)
			//{		
			//	M_Y_PLC_A_Anode_Sheet_Completed = 1;
			//	M_Y_PLC_A_Anode_Interlock = 1;
			//	P_PLC12_Anode_Sheet_Pick_Up_Flag = 0;
			//}
			if( P_Master_Motion_Trigger == P_Anode_Sheet_Interlock_Timing )
			{
				M_Y_PLC_A_Anode_Sheet_Completed = 1;
				M_Y_PLC_A_Anode_Interlock = 1;
				P_PLC12_Anode_Sheet_Pick_Up_Flag = 0;
			}
		}
		if(P_PLC12_Cathode_Sheet_Pick_Up_Flag == 1)
		{
			//// 양극 1차 PNP 벨트 하강 위치에서 10mm 상승 후 sheet complete 신호 보냄(조건 모두 mm 단위)
			//if(P_Recipe_M17_POS(4) - P_Cathode_Sheet_Interface_Complete_Pos >= P_Cathode_1st_PNP_Z_Real_Move_Pos)
			//{		
			//	M_Y_PLC_A_Cathode_Sheet_Completed = 1;
			//	M_Y_PLC_A_Cathode_Interlock = 1;
			//	P_PLC12_Cathode_Sheet_Pick_Up_Flag = 0;
			//}

			if( P_Master_Motion_Trigger == P_Cathode_Sheet_Interlock_Timing )
			{
				M_Y_PLC_A_Cathode_Sheet_Completed = 1;
				M_Y_PLC_A_Cathode_Interlock = 1;
				P_PLC12_Cathode_Sheet_Pick_Up_Flag = 0;
			}
		}
		// Hold 중 1차 PNP 극판 공급 진행 시 Pause 상태로 MasterTrigger가 돌지 않기 때문에 조건 추가.	[ 참조 : 26.05.08 Hold 중 벨트 극판 공급 인터페이스 조건 추가 ]
		if ( P_PMAC_Status == F_Status_HOLD )			// Hold 상태 일 경우.
		{
			// ↓ 음극
			P_PLC12_Anode_Sheet_Pick_Up_Flag = 0;		// Execute 상태 일 때 극판 공급 인터락 실행 변수 초기화.
			if ( P_Hold_Anode_Sheet_Pick_Up_Flag == 1 )	// 1차 PNP 벨트 상승 완료 확인.
			{
				M_Y_PLC_A_Anode_Sheet_Completed = 1;	// 음극 완료 신호 ON.
				M_Y_PLC_A_Anode_Interlock = 1;			// 음극 극판 공급 인터락 ON [ 0 : 동작 불가, 1 : 동작 가능 ]
				P_Hold_Anode_Sheet_Pick_Up_Flag = 0;	// 플래그 초기화.
			}
			// ↓ 양극
			P_PLC12_Cathode_Sheet_Pick_Up_Flag = 0;		// Execute 상태 일 때 극판 공급 인터락 실행 변수 초기화.
			if ( P_Hold_Cathode_Sheet_Pick_Up_Flag == 1 )	// 1차 PNP 벨트 상승 완료 확인.
			{
				M_Y_PLC_A_Cathode_Sheet_Completed = 1;	// 양극 완료 신호 ON.
				M_Y_PLC_A_Cathode_Interlock = 1;		// 양극 극판 공급 인터락 ON [ 0 : 동작 불가, 1 : 동작 가능 ]
				P_Hold_Cathode_Sheet_Pick_Up_Flag = 0;	// 플래그 초기화.
			}
		}
		else											// Hold 상태가 아닐 경우.
		{
			P_Hold_Anode_Sheet_Pick_Up_Flag = 0;		// 플래그 초기화.
			P_Hold_Cathode_Sheet_Pick_Up_Flag = 0;		// 플래그 초기화.
		}

		// ↓양,음극 벨트 극판 공급 확인
		if(M_Y_PLC_A_Anode_Sheet_Completed == 1 && M_X_PLC_Anode_Sheet_Completed == 1)		// 벨트 극판 공급 요청 완료 + 벨트 극판 공급 완료.
		{
			M_Y_PLC_A_Anode_Sheet_Start = 0;												// 벨트 극판 공급 요청 초기화.
			M_Y_PLC_A_Anode_Sheet_Completed = 0;											// 벨트 극판 공급 요청 완료 초기화.
		}
		if(M_Y_PLC_A_Cathode_Sheet_Completed == 1 && M_X_PLC_Cathode_Sheet_Completed == 1)	// 벨트 극판 공급 요청 완료 + 벨트 극판 공급 완료.
		{
			M_Y_PLC_A_Cathode_Sheet_Start = 0;												// 벨트 극판 공급 요청 초기화.
			M_Y_PLC_A_Cathode_Sheet_Completed = 0;											// 벨트 극판 공급 요청 완료 초기화.
		}
	//}
}


// 상시 감시 란
// [ PMAC → UI ]===========================================================================================================
call Initialize.PNP_Z_Axis_Cnt_to_Recipe();													//모터 카운트 → 레시피 값 전환 함수 호출
