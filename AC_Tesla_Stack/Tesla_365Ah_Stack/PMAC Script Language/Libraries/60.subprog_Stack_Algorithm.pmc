 open subprog stack_algorithm(void)

 sub: Clear_(&Top)	
//	클리어	 ↑ Top 변수
   Top = -1;
 return;


 sub: Push(Mode,MAX_Index,Input_Top,&Output_Top,element,Input_Data,&Data)
 //	 삽입  ↑ 순환 모드, 인덱스 최대치, Top, &Push 처리 Top, 요소, 저장할 데이터, 출력 데이터 
   Output_Top = Input_Top;						// Power Pmac 함수에서는 주소를 접근하여 처리과정에서 버그가 있음 따라서 값을 읽어오고, 그 값을 내보내는 변수에 집어넣어서 사용
   Data = Input_Data;							// Power Pmac 함수에서는 주소를 접근하여 처리과정에서 버그가 있음 따라서 값을 읽어오고, 그 값을 내보내는 변수에 집어넣어서 사용
   if( Input_Top == MAX_Index - 1 )				// Top 위치가 최대 Index와 같다면
   {
		if( Mode == N_Circulation )				// 인덱스 초과 시 순환모드를 사용중이라면
		{
			Output_Top = 0;						// Top 위치 0으로 초기화
			Data = element;
		}
		else									// 순환 모드를 사용 안한다면
		{
			// over Flow 발생 --> Top 증가 x, data삽입 x 
		}	
   }
   else if( element != 0 )						// Top 위치가 최대 Index보다 작으며, 요소가 있다면 
   {
      Output_Top++;								// Top 증가 
      Data = element;							// 데이터 삽입
   }
 return;

 sub: Pop(Input_Top,&Output_Top,element,&Data)
 //	 취출 ↑ Top, &Pop 처리 Top, 요소, 출력 데이터
   Output_Top = Input_Top;						// Power Pmac 함수에서는 주소를 접근하여 처리과정에서 버그가 있음 따라서 값을 읽어오고, 그 값을 내보내는 변수에 집어넣어서 사용
   if( Output_Top != -1 )						// Top 초기위치가 아니라면
   {
	  Data = element;							// 데이터 삽입
	  Output_Top--;								// Top 감소
	}
	else										// 초기위치라면
	{
		Data = 0;								// 쓰레기값 방지 
	}
 return;

 close 

 // [ 참조 : 2025.10.22 AIO Cal Prog Add ] 
 open subprog AIO_Calc(void)

 sub:AO_Regulator(Recv_Voltage, &Ret_AO_Ecat_Data)					
	Ret_AO_Ecat_Data = Recv_Voltage * P_AO_Range_Set_Value(0);		// P_AO_Range_Set_Value(0) → 1500  1v : 1500
return;

sub:AI_Regulator(Recv_AI_Data, &Ret_Processed_Data)
	Ret_Processed_Data = int(((P_Regul_Max_kPa_Value - P_Regul_Min_kPa_Value) / (P_Regul_Max_AD - P_Regul_Min_AD)) * Recv_AI_Data - P_Regul_Cal_Inclination);// 125);
return;

sub: AI_Current_Input_Type(Recv_AI_Data, &Ret_Processed_Data)
							// (20mA - 4mA) / (29700 - 20) * AI_data + 기울기 ( 3.99 )
	Ret_Processed_Data = int(((P_Current_Max_Value - P_Current_Min_Value) / (P_Current_Max_AD - P_Current_Min_AD)) * Recv_AI_Data + 3.99 );
return;

close

open subprog PWM_Motor(void)

// [참조 : 26.01.09 PWM Home 추가 ]
// 26.01.09 추가===================================================================================================================
// DD Motor Phase Found가 되어야 홈 진행 할 수 있도록 추가.
// 1. Motor[x].phasefound = 0 ;
// 2. cout x 0;
// 3. Motor[x].iabias = 0; 
// 4. Motor[x].ibbias = 1500;	>> b상 1500  천천히 증가 500ms마다 증가 500ms 쉬고
// 5. Motor[x].phasepos = 0;	// 0에서 2048값
// 6. Motor[x].ibbias = 0;		// 0	
// 7. Motor Kill
// 8. Motor[x].phasefound = 1;	
// ( FE 값은 추후 추가 )
//	Motor[x].Homepos = 0; abs 생 데이터 올라옴. 
// ================================================================================================================================ 

sub: Phasing_Found(unit,in_data,&out_data,&old_time,&rtn)
	out_data = in_data;		// 쓰레기값 리턴 방지
	rtn = 0;				// 쓰레기값 리턴 방지
		switch(in_data)
		{
			case 1:			// 1. Motor[x].phasefound = 0 ;
				Motor[unit].PhaseFound = 0;			// PhaseFound = 0;
				Motor[unit].FatalFeLimit = 50;		// FatalFelimt = 50;
				old_time = Sys.time;				// time 저장	
				out_data++;							// OutData 증가
			break;

			case 2:			// 2. cout x 0;
				if( Sys.time >= old_time + 0.01)	// 10ms 이후
				{
					cmd"#%d out0",unit;					// open loop 
					old_time = Sys.time;				// time 저장	
					out_data++;							// OutData 증가
				}
			break;

			case 3:			// 3. Motor[x].iabias = 0; 
				if( Sys.time >= old_time + 0.01)	// 10ms 이후
				{
					Motor[unit].iabias = 0;
					old_time = Sys.time;				// time 저장	
					out_data++;							// OutData 증가
				}
			break;

			case 4:			// 4. Motor[x].ibbias = 1500;	>> b상 1500  천천히 증가 500ms마다 증가 
				if( Sys.time >= old_time + 0.5 )		// 500ms 이후
				{
					Motor[unit].ibbias += 150;
					old_time = Sys.time;				// time 저장
						
					if( Motor[unit].ibbias >= 1500 )	// 목표 도달값에 들어왔다면 --> 1500 변수로해서 나중에 실시간으로 바꾸면서 테스트 진행도 ㄱㅊ
						out_data++;						// OutData 증가
				}
			break;

			case 5 :		// 5. Motor[x].phasepos = 0;	// 0에서 2048값
				if( Sys.time >= old_time + 0.5 )		// 500ms 이후
				{
					//if( Motor[unit].PhasePos + 5 >= 2048 && 2048 >= Motor[unit].PhasePos -5)		// 2048 근처값 확인 필요?
					Motor[unit].phasepos = 0;
					old_time = Sys.time;				// time 저장	
					out_data++;							// OutData 증가
				}
			break;

			case 6:			// 6. Motor[x].ibbias = 0;		
				if( Sys.time >= old_time + 0.01 )		// 10ms 이후
				{
					 Motor[unit].ibbias = 0;
					 old_time = Sys.time;				// time 저장	
					 out_data++;						// OutData 증가
				}
			break;

			case 7:			// 7. Motor Kill
				if( Sys.time >= old_time + 0.01 )		// 10ms 이후
				{
					cmd"#%d kill",unit;					// Kill
					 old_time = Sys.time;				// time 저장	
					 out_data++;						// OutData 증가
				}
			break;

			case 8:			// 8. Motor[x].phasefound = 1;	
				if( Sys.time >= old_time + 0.01 )		// 10ms 이후
				{
					 Motor[unit].phasefound = 1;		// PhaseFound = 1;
					 Motor[unit].FatalFeLimit = 1000;	// FatalFelimit 원복
					 rtn = N_TRUE;
					 out_data = 0;						// OutData 초기화
				}
			break;

			default :
				out_data = 0;
			break;
		}
	
return;

close



