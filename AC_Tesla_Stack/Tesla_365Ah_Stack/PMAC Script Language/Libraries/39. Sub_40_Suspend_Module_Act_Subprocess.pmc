			{
				case N_2nd_PNP_Align_Down_Motion:
					P_Slave17_Motion_Command = N_2nd_PNP_Align_Down_Motion;									// 하강 커맨드	// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Act_Old_Time(N_Act_Motion_to_PickUp_2nd) = Sys.Time;									// 시간 저장
					P_Suspend_Supply_Index_2nd++;															// 인덱스 업
				break;

				case N_2nd_PNP_Align_Vac:
					if( Sys.Time < P_Act_Old_Time(N_Act_Motion_to_PickUp_2nd) + P_Act_Time_Out(N_Act_Motion_to_PickUp_2nd))		// 일정 딜레이 시간을 넘기지 않을 경우.
					{
						if( P_Anode_Suspend_Supply_Complete(N_2nd_Supply_to_Down) == N_TRUE )				// 하강 완료 신호
						{
							P_Slave17_Motion_Command = N_2nd_PNP_Align_Vac;									// 흡착 커맨드	// [ 참 조 : 2025.11.24 Z축 분리 ]
							P_Act_Old_Time(N_Act_Motion_to_PickUp_2nd) = Sys.Time;							// 시간 저장
							P_Suspend_Supply_Index_2nd++;													// 인덱스 업
						}
					}
					else
					{
						P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion;								// 얼라인 상승으로 보내야함	// [ 참 조 : 2025.11.24 Z축 분리 ]
						P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) = N_Error_Step;		// 에러 스텝
					}
				break;

				case N_2nd_PNP_Align_Up_Motion:
					if( Sys.Time < P_Act_Old_Time(N_Act_Motion_to_PickUp_2nd) + P_Act_Time_Out(N_Act_Motion_to_PickUp_2nd))		// 일정 딜레이 시간을 넘기지 않을 경우.
					{
						if( P_Anode_Suspend_Supply_Complete(N_2nd_Supply_to_Vac) == N_TRUE )				// 흡착 완료 신호
						{
							P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion;							// 상승 커맨드				// [ 참 조 : 2025.11.24 Z축 분리 ]
							P_Act_Old_Time(N_Act_Motion_to_PickUp_2nd) = Sys.Time;							// 시간 저장
							P_Suspend_Supply_Index_2nd++;													// 인덱스 업
						}
					}
					else
					{
						P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion;								// 얼라인 상승으로 보내야함	// [ 참 조 : 2025.11.24 Z축 분리 ]
						P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) = N_Error_Step;		// 에러 스텝
					}
				break;

				case N_Supply_Verify:
					if( Sys.Time < P_Act_Old_Time(N_Act_Motion_to_PickUp_2nd) + P_Act_Time_Out(N_Act_Motion_to_PickUp_2nd))		// 일정 딜레이 시간을 넘기지 않을 경우.
					{
						if( P_Anode_Suspend_Supply_Complete(N_2nd_Supply_to_Up) == N_TRUE )					// 상승 완료 신호
						{
							P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) = N_Complete_Step;	// 컴플리트 반환
						}
					}
					else
					{
						P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion;								// 얼라인 상승으로 보내야함	// [ 참 조 : 2025.11.24 Z축 분리 ]
						P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) = N_Error_Step;		// 에러 스텝
					}
				break;

				default:
					P_Slave17_Motion_Command = N_2nd_PNP_Align_Up_Motion;									// 얼라인 상승으로 보내야함	// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) = N_Error_Step;			// 에러 스텝
				break;
			}

		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_1st_Supply_Error = N_Act_Motion_to_PickUp_2nd;															// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			Anode_2nd_Supply_PickUp_RTN = N_FALSE;															// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Motion_to_PickUp_2nd) == N_Complete_Step )				// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Motion_to_PickUp_2nd) = 1;												// 동작 완료 Bit On.
			Anode_2nd_Supply_PickUp_RTN = N_COMPLETE;														// 반환값 : COMPLETE
		}
		*/
	return;

	sub:Supply_Motion_to_Ready(&Anode_1st_Supply_Ready_Pos_RTN)
		Anode_1st_Supply_Ready_Pos_RTN = 0;

		if ( P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) == N_Ready_Step )						// 진행 준비 완료 일 경우.
		{					
			P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion;											// 대기위치 진입 커맨드	// [ 참 조 : 2025.11.24 Z축 분리 ]
			P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion;											// 대기위치 진입 커맨드
			//P_Slave2_Motion_Command = N_1st_Picker_Turn													// 피커 턴	//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]	
			P_Act_Old_Time(N_Act_Motion_to_Ready) = Sys.Time;												// 시간 저장
			P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) = 1;									// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) == 1 )							
		{	
			if( Sys.Time < P_Act_Old_Time(N_Act_Motion_to_Ready) + P_Act_Time_Out(N_Act_Motion_to_Ready))	// 일정 딜레이 시간을 넘기지 않을 경우.
			{
				if( P_Anode_Suspend_Supply_Complete(N_Supply_to_Ready) == 1 )								// 대기위치 진입 완료 신호
				{ 
					P_Suspend_Supply_Resume_Flag = 1;														// 리줌 커맨드
					P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) = N_Complete_Step;				// 다음 스텟머신으로 이동
				}
			}
			else
			{
				P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion;										// 대기위치 이동 커맨드
				P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion;										// 대기위치 이동 커맨드	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Module_Act_State_Machine_Error_Array(N_Act_Motion_to_Ready) = P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) = N_Error_Step;						// 에러 스텝
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) == N_Error_Step )						// 애러 상태 일 경우.
		{
			P_Suspend_1st_Supply_Error = N_Act_Motion_to_Ready;															// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			Anode_1st_Supply_Ready_Pos_RTN = N_FALSE;														// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Motion_to_Ready) == N_Complete_Step )					// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Motion_to_Ready) = 1;													// 동작 완료 Bit On.
			Anode_1st_Supply_Ready_Pos_RTN = N_COMPLETE;													// 반환값 : COMPLETE
		}
	return;

	// [ 참조 : 260420 SUSPEND 배출 시, 얼라인 재보정 기능 추가 ]
	sub:Ca_Align_Retry_Cal(&Ca_Align_Retry_Cal_RTN)
		Ca_Align_Retry_Cal_RTN = 0;
		local L_individual_return = 0;

		if ( P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{	
			if ( P_Vision_Ca_AT_Retry_Cal_Flag == 1 && P_Ca_AT_Retry_Cal_Complete == 0 )
			{	
				P_Align_Retry_Cal_RTN = 0
				call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP,&P_Cathode_2nd_Unit_Status,&P_Align_Retry_Cal_RTN);	
						
				P_Act_Old_Time(N_Act_Ca_Align_Retry_Cal) = Sys.Time;										// 시간 저장
				P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = 1;								// 다음 스텟 머신으로 이동.
			}
			else
			{
				P_Ca_AT_Retry_Cal_Pass = 1;																	// 양극 얼라인 재보정 패스
				P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = N_Complete_Step;				// 완료
			}
		}
		// 1) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) == 1 )							
		{	
			if ( P_Cathode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos )
			{
				P_Cathode_Align_Table_Move = F_Align_Move_Mode;												// 양극 얼라인 보정모드 설정
				P_Ca_AT_Retry_Cal_Move_Complete = 0;														// 양극 얼라인 재보정 동작 완료 신호 초기화
				P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = 2;								// 다음 스텟머신으로 이동
			}
			else
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Ca_Align_Retry_Cal) = P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = N_Error_Step;					// 에러 스텝이동
			}
		}

		if ( P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) == 2 )							
		{	
			if( P_Cathode_Align_Table_Move == F_Align_Move_Mode )											// 얼라인 무브 모드
			{ 
				Ldata.CmdStatus = 1 																		// 커맨드 상태 초기화
				CMD"&2b2r";																					// Cathode Align Stage 모션 커멘드 발생
				sendallcmds 																				// 모든 커맨드문 버퍼를 비워냄
				while (Ldata.CmdStatus == 1){} 																// 모든 커맨드문 버퍼가 비워질 때 까지 대기	
				P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = 3;								// 다음 스텟머신으로 이동
			}
			else
				P_Cathode_Align_Table_Move = F_Align_Move_Mode;
		}

		if ( P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) == 3 )							
		{	
			if( Sys.Time < P_Act_Old_Time(N_Act_Ca_Align_Retry_Cal) + P_Act_Time_Out(N_Act_Ca_Align_Retry_Cal))	// 일정 딜레이 시간을 넘기지 않을 경우.
			{
				if( P_Ca_AT_Retry_Cal_Move_Complete == 1 )													// 양극 얼라인 재보정 동작 완료
				{ 
					P_Ca_AT_Retry_Cal_Cnt++	
					P_PMAC_To_Vision_Ca_AT_Retry_Cal_Ack = 1;												// 양극 얼라인 재보정 동작 완료 ACK신호[PMAC → VISION]
					P_Ca_AT_Retry_Cal_Complete = 1;
					P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = N_Complete_Step;			// 다음 스텟머신으로 이동
				}
			}
			else
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Ca_Align_Retry_Cal) = P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) = N_Error_Step;					// 에러 스텝
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_1st_Supply_Error = N_Act_Ca_Align_Retry_Cal;											// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Cathode_Align_Retry_Cal_Error_Popup_Flag = 1;								// 양극 얼라인 재보정 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Ca_Align_Retry_Cal_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Ca_Align_Retry_Cal) == N_Complete_Step )				// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Ca_Align_Retry_Cal) = 1;												// 동작 완료 Bit On.
			Ca_Align_Retry_Cal_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}
	return;
	
	sub:An_Align_Retry_Cal(&An_Align_Retry_Cal_RTN)
		An_Align_Retry_Cal_RTN = 0;
		local L_individual_return = 0;
		
		if ( P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{	
			if ( P_Vision_An_AT_Retry_Cal_Flag == 1 && P_An_AT_Retry_Cal_Complete == 0 )
			{		
				P_Align_Retry_Cal_RTN = 0;
				call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP,&P_Anode_2nd_Unit_Status,&P_Align_Retry_Cal_RTN);

				P_Act_Old_Time(N_Act_An_Align_Retry_Cal) = Sys.Time;										// 시간 저장
				P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = 1;								// 다음 스텟 머신으로 이동.
			}
			else
			{
				P_An_AT_Retry_Cal_Pass = 1;																	// 음극 얼라인 재보정 패스
				P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = N_Complete_Step;				// 완료
			}
		}
		// 1) 동작 완료 감시. 
		if ( P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) == 1 )							
		{	
			if ( P_Anode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos )
			{
				P_Anode_Align_Table_Move = F_Align_Move_Mode;												// 음극 얼라인 보정모드 설정
				P_An_AT_Retry_Cal_Move_Complete = 0;														// 음극 얼라인 재보정 동작 완료 신호 초기화
				P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = 2;								// 다음 스텟 머신으로 이동.
			}
			else
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_An_Align_Retry_Cal) = P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = N_Error_Step;					// 에러 스텝
			}
		}
			
		if ( P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) == 2 )							
		{	
			if( P_Anode_Align_Table_Move == F_Align_Move_Mode )												// 얼라인 무브 모드
			{ 
				Ldata.CmdStatus = 1 																		// 커맨드 상태 초기화
				CMD"&3b3r";																					// Anode Align Stage 모션 커멘드 발생
				sendallcmds 																				// 모든 커맨드문 버퍼를 비워냄
				while (Ldata.CmdStatus == 1){} 																// 모든 커맨드문 버퍼가 비워질 때 까지 대기	
				P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = 3;								// 다음 스텟머신으로 이동
			}
			else
				P_Anode_Align_Table_Move = F_Align_Move_Mode;
		}

		if ( P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) == 3 )							
		{	
			if( Sys.Time < P_Act_Old_Time(N_Act_An_Align_Retry_Cal) + P_Act_Time_Out(N_Act_An_Align_Retry_Cal))	// 일정 딜레이 시간을 넘기지 않을 경우.
			{
				if( P_An_AT_Retry_Cal_Move_Complete == 1 )													// 음극 얼라인 재보정 동작 완료
				{ 
					P_An_AT_Retry_Cal_Cnt++
					P_PMAC_To_Vision_An_AT_Retry_Cal_Ack = 1;												// 음극 얼라인 재보정 동작 완료 ACK신호[PMAC → VISION]
					P_An_AT_Retry_Cal_Complete = 1;
					P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = N_Complete_Step;			// 다음 스텟머신으로 이동
				}
			}
			else
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_An_Align_Retry_Cal) = P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) = N_Error_Step;					// 에러 스텝
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_1st_Supply_Error = N_Act_An_Align_Retry_Cal;											// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Anode_Align_Retry_Cal_Error_Popup_Flag = 1;									// 음극 얼라인 재보정 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			An_Align_Retry_Cal_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_An_Align_Retry_Cal) == N_Complete_Step )				// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_An_Align_Retry_Cal) = 1;												// 동작 완료 Bit On.
			An_Align_Retry_Cal_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}
	return;

	

close
