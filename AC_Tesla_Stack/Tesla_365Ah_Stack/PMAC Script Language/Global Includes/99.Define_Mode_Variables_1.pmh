
//!중요! 값 설정해주는 Define보다 항시 상위에 있어 먼저 빌드 및 다운로드 해야함.
global P_Old_Trigger_PLC0=0;

// [ 참조 : 20220725 모드 개수 수정 ]
#define	N_Mode_EA	5//700//600 //400

// Seqeunce 변환 모드 관련 변수 정의.
//============================================================================
// 1. 커멘드 변수
//============================================================================
global P_Mode_Command=0;			// 모드 변환 외부 명령어

//============================================================================
// 2. 현재 모드( Status )
//============================================================================
global P_Current_Mode=0;			// 현재 모드

//============================================================================
// 3. 진입할 모드 변수 ( = Next_Mode )
//============================================================================
global P_MOde_Num(N_Mode_EA);				// 커멘드를 받았을 때 실행할 모드번호 ( 커멘드 )
P_MOde_Num(0),N_Mode_EA,1 = 0; 			// global선언으로 인해 쓰레기값이 저장되어 있을 수 있어 배열 내부 초기화.

//============================================================================
// 4. 모드(Status)의 사이클 개수 ( 실제 사이클 개수 - 1)
//============================================================================
global	P_Command_Depth(N_Mode_EA);		// 한 모드의 사이클 개수-1 ( 커멘드 )
P_Command_Depth(0),N_Mode_EA,1 = 0;		// global선언으로 인해 쓰레기값이 저장되어 있을 수 있어 배열 내부 초기화.

//============================================================================
// 5. 모드(Status)의 진입 시점 ( 실제 진입할 시점 - 1 Ex. 0번부터 시작해야한다면 99번 트리거 입력)
//============================================================================
global	P_In_Position(N_Mode_EA);			// 모드에 할당된 진입(트리거)시점 ( 커멘드 + n )
P_In_Position(0),N_Mode_EA,1 = 0;			// global선언으로 인해 쓰레기값이 저장되어 있을 수 있어 배열 내부 초기화.

//============================================================================
// 6. Tail ( 모드 마지막 사이클 완료 후 진입할 모드 입력) 
//============================================================================
global P_Last_Cycle_Command(N_Mode_EA);
P_Last_Cycle_Command(0),N_Mode_EA,1 = 0;	// global선언으로 인해 쓰레기값이 저장되어 있을 수 있어 배열 내부 초기화.

//============================================================================
// 7. Buffer (버퍼 영역 추가, 진입 시점을 놓쳐 Wait모드로 빠질 경우 Buffer 저장 )
//============================================================================
global	P_Mode_Command_Buffer = 0;

global	P_Mode_Command_Wait_Count = 0;
global	P_Old_Mode_Command=0;








