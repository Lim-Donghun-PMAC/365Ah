		{
			//P_Suspend_Anode_1TR_Cell_Supply_State_Machine = N_Error_Step; 										// 스탑포인트 에러 처리 할 것 
			P_Module_Act_Execute_Command_Array(N_Act_Clamp_On) = F_ACT_STATUS_ALARM;								// 동작 에러.
		}
	}
	else
