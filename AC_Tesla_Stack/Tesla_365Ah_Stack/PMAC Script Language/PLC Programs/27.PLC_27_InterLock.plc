						   P_IL_Popup_Motor = N_2nd_PnP_CA_Z;									// 인터락 팝업 모터 추가
						} 	
						else if( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) >= P_Cathode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{ // 2차 PNP 대기 위치 상승보다 밑에 있을 경우.
							if( P_IL_Motor_Page == N_2nd_PnP_CA_T )								// 2차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							  
							  P_IL_Outer_Status = N_IL_Align_Down_Pos;							// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함) 
							  P_IL_Popup_Motor = N_2nd_PnP_CA_Z;								// 인터락 팝업 모터 추가
						}									
						else
						{		
							P_IL_Outer_Status = N_IL_Normal_Pos;								// 노말 포스 
						}
					}
					else if( P_Motor_Current_Pos(N_2nd_PnP_CA_T) >= P_Recipe_M03_POS(2) - 35 )  // 2차 PNP가 스택 위치에서 -35도 보다 들어가 있을 경우.
					{ // 2차 PNP 스택 위치.
						if( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) >= P_Cathode_2nd_Z_Stack_Down - 0.01 )		// 스택 하강위치보다 하강일 경우.
						{
						   if( P_IL_Motor_Page == N_2nd_PnP_CA_T )								// 2차 T 
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
						   else if( P_IL_Motor_Page == N_2nd_PnP_CA_Z )							// 2차 Z 
						      P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락

						   P_IL_Outer_Status = N_IL_Stack_Down_Pos;								// 스택 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
						   P_IL_Popup_Motor = N_2nd_PnP_CA_Z;									// 인터락 팝업 모터 추가
						}	
						else if( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) >= P_Cathode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_2nd_PnP_CA_T )								// 1차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							P_IL_Outer_Status = N_IL_Stack_Down_Pos;							// 스택 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
							P_IL_Popup_Motor = N_2nd_PnP_CA_Z;									// 인터락 팝업 모터 추가
						}
						else
						{
							 P_IL_Outer_Status = N_IL_Stack_Pos;								// 스택 포스
						}
					} 					
					else																		// 얼라인도 아니고 스택도 아니면
					{	
						if( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) >= P_Cathode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_2nd_PnP_CA_T )								// 2차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							  P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
							  P_IL_Popup_Motor = N_2nd_PnP_CA_Z;								// 인터락 팝업 모터 추가
						}
						else
							P_IL_Outer_Status = N_IL_Upper_Pos;									// 상승 포스 
					}
				}
			break;
		
			case N_IL_Robot_AN_2nd_PNP:      // 음극 2차 PnP 로봇 4,22
				If ( M_X_PLC_Anode_ReelCut_Door_Interlock == 0 || M_X_PLC_Anode_Small_Door_Close_Signal == 0)	// 음극 2차 PnP 로봇 4,22 
				{	
					if( P_IL_Motor_Page == N_2nd_PnP_AN_T || P_IL_Motor_Page == N_2nd_PnP_AN_Z  )// 1차 T, 피커 T 
					{
						P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
						P_IL_Outer_Status = IL_Out_Close;										// 외부 인터락 닫기
					}
				}
				//else
				//{
				//	if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Align_Down + 0.01 )// 얼라인 하강위치보다 하강한다면
				//	{
				//	   if( P_IL_Motor_Page == N_2nd_PnP_AN_T )									// 2차 T  
				//	      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
				//	   else if( P_IL_Motor_Page == N_2nd_PnP_AN_Z )								// 2차 Z 
				//	      P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스 인터락
				//
				//	   P_IL_Outer_Status = IL_Out_Close;										// 외부 인터락 닫기
