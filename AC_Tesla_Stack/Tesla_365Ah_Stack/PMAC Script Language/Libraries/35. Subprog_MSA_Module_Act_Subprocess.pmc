//21. Stack MSA NG PNP NGBox 파기 (MSA 완료)
//=========================================================
sub: MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) == N_Ready_Step )										//Stack MSA NG PNP NGBox 파기 Ready Step
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우		
	{
		P_Slave13_Motion_Command = 8;																									// 음극 NG PNP NGBox 파기 
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화	
		//M_Y_Anode_NG_PNP_Ejector_Vac_On = 0;																				
		//M_Y_Anode_NG_PNP_Ejector_Vac_Off = 1;	
		//M_X_Anode_NG_PNP_Vac_Sensor = 0; //임시																					
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우	
	{
		P_Slave12_Motion_Command = 8;																									// 양극 NG PNP NGBox 파기 
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화	
		//M_Y_Cathode_NG_PNP_Ejector_Vac_On = 0;																					 
		//M_Y_Cathode_NG_PNP_Ejector_Vac_Off = 1;		
		//M_X_Cathode_NG_PNP_Vac_Sensor = 0; //임시 	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우		
	{
		if ( M_X_Anode_NG_PNP_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 								// 음극 NG PNP 흡착 입력 신호 OFF
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우	
	{																														
		if ( M_X_Cathode_NG_PNP_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )   							// 양극 NG PNP 흡착 입력 신호 OFF
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//22. 얼라인 2차 PNP 얼라인 이동 (MSA 완료)
//=========================================================
sub: MSA_Stack_Discharge_2nd_Align_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) == N_Ready_Step )
{	
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우		
	{
		P_Slave3_Motion_Command = 2;																								// 음극 2차 PNP 얼라인 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																									// 체크 타이머 초기화		
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우	
	{
		P_Slave8_Motion_Command = 2;																								// 양극 2차 PNP 얼라인 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																									// 체크 타이머 초기화		
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우		
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 0 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 2차 PNP 얼라인 이동 위치 확인	
		{
			if( Motor[N_2nd_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 음극 2차 PNP 속도 0 확인																						
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우	
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 0 + P_Motor_Ready_Pos_Inpos_200um )// 양극 2차 PNP 얼라인 이동 위치 확인	
		{
			if( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 													// 양극 2차 PNP 속도 0 확인																												 
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Move) = 1;														// 동작 완료 Bit On.
	rtn = N_COMPLETE;																														// 반환값 : COMPLETE
}
return;
#endif 


// 얼라인 테이블 탈착 모드  --------------------------------------------------------------------------------------------------------------------------------
//=======================================================================================================================
//1. 2차 PNP. 파이널롤 서버 온 & 대기위치 확인(얼라인 테이블 탈착 모드 )
//=======================================================================================================================
sub: Align_Take_Off_Ready_Pos_Check(Mode,&rtn)
rtn = 0;
local L_Align_Take_Off_individual_Anode_1st_PNP_return;
local L_Align_Take_Off_individual_Anode_2nd_PNP_return; 
local L_Align_Take_Off_individual_Cathode_1st_PNP_return; 
local L_Align_Take_Off_individual_Cathode_2nd_PNP_return; 
local L_Align_Take_Off_individual_FR_return;
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Check) == N_Ready_Step )		// 음극 얼라인 탈착 모드 위치 확인 Ready Step 
{
	if( Mode == N_Align_AN_Take_Off )	// 음극 얼라인 탈착 모드일 경우
	{
		call Manual_Module_Motor_Active.Align_Take_Off_Motor_Check(&P_Align_Take_Off_Motor_Check_Complete)	//음극 1, 2차 PNP, 파이널 롤 서버 온
		if ( P_Align_Take_Off_Motor_Check_Complete == 1)
		{
			P_Align_Take_Off_Motor_Check_Complete = 0;														
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Check) = 1;			// 다음 스텟 머신으로 이동.
		}
	}
	else if( Mode == N_Align_CA_Take_Off )	// 양극 얼라인 탈착 모드일 경우
	{
	  call Manual_Module_Motor_Active.Align_Take_Off_Motor_Check(&P_Align_Take_Off_Motor_Check_Complete)	//양극 1, 2차 PNP, 파이널 롤 서버 온
		if ( P_Align_Take_Off_Motor_Check_Complete == 1)
		{
			P_Align_Take_Off_Motor_Check_Complete = 0;														
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Check) = 1;			// 다음 스텟 머신으로 이동.
		}
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Check) == 1 )
{
	if( Mode == N_Align_AN_Take_Off ||  Mode == N_Align_CA_Take_Off )			// 음극 또는 양극 얼라인 탈착 모드일 경우
	{
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_1st_PNP,&P_Anode_1st_Unit_Status,&L_Align_Take_Off_individual_Anode_1st_PNP_return);			//음극 1차 PNP 대기 위치 확인 
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP,& P_Anode_2nd_Unit_Status,&L_Align_Take_Off_individual_Anode_2nd_PNP_return);			//음극 2차 PNP 대기 위치 확인 
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_1st_PNP,&P_Cathode_1st_Unit_Status,&L_Align_Take_Off_individual_Cathode_1st_PNP_return);		//양극 1차 PNP 대기 위치 확인
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP,& P_Cathode_2nd_Unit_Status,&L_Align_Take_Off_individual_Cathode_2nd_PNP_return);		//양극 2차 PNP 대기 위치 확인
		call Sub_Unit_Memory_Status.individual_mode(F_Final_Roll,&P_FinalRoll_Unit_Status,&L_Align_Take_Off_individual_FR_return);							//파이널롤 대기 위치 확인
		if ( L_Align_Take_Off_individual_Anode_1st_PNP_return == 1 && L_Align_Take_Off_individual_Anode_2nd_PNP_return == 1 && L_Align_Take_Off_individual_Cathode_1st_PNP_return == 1 && L_Align_Take_Off_individual_Cathode_2nd_PNP_return == 1 && L_Align_Take_Off_individual_FR_return == 1)
		{
			if( P_Anode_1st_Unit_Status == F_1st_PNP_Init_Up_Pos && P_Anode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_Cathode_1st_Unit_Status == F_1st_PNP_Init_Up_Pos && P_Cathode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos  )	//대기 위치 확인
			{
				L_Align_Take_Off_individual_Anode_1st_PNP_return = 0;
				L_Align_Take_Off_individual_Anode_2nd_PNP_return = 0;
				L_Align_Take_Off_individual_Cathode_1st_PNP_return = 0;
				L_Align_Take_Off_individual_Cathode_2nd_PNP_return = 0;
				L_Align_Take_Off_individual_FR_return = 0;
				P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Check) = N_Complete_Step;	
			}
		}
	}
}

if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Check) == N_Complete_Step )
{
	P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_Ready_Pos_Check) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																								// 반환값 : COMPLETE
}
return;

//=======================================================================================================================
//2. 2차 PNP, 파이널 롤 이동 속도 설정 (얼라인 테이블 탈착 모드 )
//=======================================================================================================================
//[참조 : 260724 2차 클리닝 위치 이동, 얼라인 탈착 모드 시퀀스 수정 ]
sub:Align_Take_Off_Ready_Pos_Set(Mode,&rtn)
rtn = 0;
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Set) == N_Ready_Step )				//2차 PNP, 파이널 롤 이동 속도 설정 Ready Step
{
	if( Mode == N_Align_AN_Take_Off )		// 음극 얼라인 탈착 모드일 경우
	{
		call Manual_Module_Motor_Active.Align_Take_Off_Speed_Return(&P_Align_Take_Off_Speed_Return_Complete)		// 음극 2차 PNP 파이널롤 속도 30 지정 
		if ( P_Align_Take_Off_Speed_Return_Complete == 1)
		{
			P_Align_Take_Off_Speed_Return_Complete = 0;
			Motor[N_1st_PnP_AN_Z].ProgJogPos = 0;	//음극 1차 PNP Z축 대기 상승위치
			Motor[N_2nd_PnP_AN_Z].ProgJogPos = 0;	//음극 2차 PNP Z축 대기 상승위치
			Motor[N_FINAL_ROLL_Z].ProgJogPos = P_Final_Roll_Z_Run_Pos * 1000;	//파이널롤러 적층 위치		
			jog18=*;
			jog22=*;
			jog13=*;	
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Set) = 1;					// 다음 스텟 머신으로 이동.
		}
	}
	else if(  Mode == N_Align_CA_Take_Off ) // 양극 얼라인 탈착 모드일 경우
	{
		call Manual_Module_Motor_Active.Align_Take_Off_Speed_Return(&P_Align_Take_Off_Speed_Return_Complete)		// 양극 2차 PNP 파이널롤 속도 30 지정  
		if ( P_Align_Take_Off_Speed_Return_Complete == 1)
		{
			P_Align_Take_Off_Speed_Return_Complete = 0;
			Motor[N_1st_PnP_CA_Z].ProgJogPos = 0;	//양극 1차 PNP Z축 대기 상승위치
			Motor[N_2nd_PnP_CA_Z].ProgJogPos = 0;	//양극 2차 PNP Z축 대기 상승위치
			Motor[N_FINAL_ROLL_Z].ProgJogPos = P_Final_Roll_Z_Run_Pos * 1000;			//파이널롤러 Z축 적층 위치		
			jog17=*;
			jog21=*;
			jog13=*;																		//파이널롤러 Z축 상승  
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Set) = 1;					// 다음 스텟 머신으로 이동.
		}
	}
	else																													
	{
		// ERROR 
	}
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Set) == 1 )												
{
	P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Set) = N_Complete_Step;				//다음 스텟 이동
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_Ready_Pos_Set) == N_Complete_Step )
{
	P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_Ready_Pos_Set) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																								// 반환값 : COMPLETE
}
return;

//=======================================================================================================================
//3. 파이널롤러 회피 동작 이동 및 확인 (얼라인 테이블 탈착 모드 )
//=======================================================================================================================
//[참조 : 260724 2차 클리닝 위치 이동, 얼라인 탈착 모드 시퀀스 수정 ]
sub:Align_Take_Off_FR_Move(Mode,&rtn)
rtn = 0;
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) == N_Ready_Step )				//파이널롤러 회피 동작 Ready Step
{
	if( Mode == N_Align_AN_Take_Off ) // 음극 얼라인 탈착 모드일 경우
	{
		if((P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 0 + 0.5 && P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 0 - 0.5) && (P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 0 + 0.5 && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) > 0 - 0.5) && (P_Motor_Current_Pos(N_FINAL_ROLL_Z) < P_Final_Roll_Z_Run_Pos + 0.5 && P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Final_Roll_Z_Run_Pos - 0.5))
		{
			jog12= ((P_Final_Roll_X_Cathode_Move*1000) + 10000 ) 													//파이널롤러 양극 방향 이동 + 10mm
			P_Align_Take_Off_Chk_Pos_Timer = 0;
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) = 1;						// 다음 스텟 머신으로 이동.
		}
	}
	else if(  Mode == N_Align_CA_Take_Off ) // 양극 얼라인 탈착 모드일 경우
	{
		if((P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 0 + 0.5 && P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 0 - 0.5) && (P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 0 + 0.5 && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 0 - 0.5) && (P_Motor_Current_Pos(N_FINAL_ROLL_Z) < P_Final_Roll_Z_Run_Pos + 0.5 && P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Final_Roll_Z_Run_Pos - 0.5))
		{
			jog12=((P_Final_Roll_X_Anode_Move*1000) - 10000 )														//파이널롤러 음극 방향 이동 - 10mm
			P_Align_Take_Off_Chk_Pos_Timer = 0;
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) = 1;						// 다음 스텟 머신으로 이동.
		}
	}
	else																													
	{
		// ERROR 
	}
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) == 1 )												
{
	if( Mode == N_Align_AN_Take_Off ) // 음극 얼라인 탈착 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > (P_Final_Roll_X_Cathode_Move + 10) - 0.5 && P_Motor_Current_Pos(N_FINAL_ROLL_X) < (P_Final_Roll_X_Cathode_Move + 10) + 0.5 ) // 파이널롤러 양극 위치 이동 확인
		{	
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) = N_Complete_Step;	//다음 스텟 이동			
		}
	}
	else if(  Mode == N_Align_CA_Take_Off )  // 양극 얼라인 탈착 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) > (P_Final_Roll_X_Anode_Move - 10) - 0.5 && P_Motor_Current_Pos(N_FINAL_ROLL_X) < (P_Final_Roll_X_Anode_Move - 10) + 0.5 ) // 파이널롤러 양극 위치 이동 확인
		{
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) = N_Complete_Step;	//다음 스텟 이동	
		}
	}
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_FR_Move) == N_Complete_Step )
{
	P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_FR_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																							// 반환값 : COMPLETE
}
return;
//===================================================================================
//4. 2차 PNP T축 스텍 위치 이동 및 확인 (얼라인 테이블 탈착 모드 )
//===================================================================================
//[참조 : 260724 2차 클리닝 위치 이동, 얼라인 탈착 모드 시퀀스 수정 ]
sub:Align_Take_Off_2nd_PNP_Stack_Move(Mode,&rtn)
rtn = 0;
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) == N_Ready_Step )		//  2차 PNP T축 스텍 위치 이동 및 확인 Ready Step 
{
	if( Mode == N_Align_AN_Take_Off )	 // 음극 얼라인 탈착 모드일 경우
	{	
		Motor[N_1st_PnP_AN_T].ProgJogPos = P_Anode_1TR_T_Ready_POS * 1000;										//음극 1차 PNP축 대기 위치 이동 
		Motor[N_2nd_PnP_AN_T].ProgJogPos = P_Anode_2TR_T_Stack_POS * 1000;										//음극 2차 PNP축 스텍 위치 이동 
		jog2=*;
		jog4=*;
		P_Align_Take_Off_Chk_Pos_Timer = 0;
		P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) = 1;				// 다음 스텟 머신으로 이동.
	}
	else if(  Mode == N_Align_CA_Take_Off ) // 양극 얼라인 탈착 모드일 경우
	{
		Motor[N_1st_PnP_CA_T].ProgJogPos = P_Cathode_1TR_T_Ready_POS * 1000;									//양극 1차 PNP축 대기 위치 이동 
		Motor[N_2nd_PnP_CA_T].ProgJogPos = P_Cathode_2TR_T_Stack_POS * 1000;									//양극 2차 PNP축 스텍 위치 이동 
		jog1=*;
		jog3=*;
		P_Align_Take_Off_Chk_Pos_Timer = 0;
		P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) = 1;				// 다음 스텟 머신으로 이동.
	}
	else																													
	{
		// ERROR 
	}
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) == 1 )												
{
	if( Mode == N_Align_AN_Take_Off )		// 음극 얼라인 탈착 모드일 경우
	{
		if((P_Motor_Current_Pos(N_1st_PnP_AN_T) < P_Anode_1TR_T_Ready_POS + 0.5 && P_Motor_Current_Pos(N_1st_PnP_AN_T) > P_Anode_1TR_T_Ready_POS - 0.5) && (P_Motor_Current_Pos(N_2nd_PnP_AN_T) < P_Anode_2TR_T_Stack_POS + 0.5 && P_Motor_Current_Pos(N_2nd_PnP_AN_T) > P_Anode_2TR_T_Stack_POS - 0.5))
		{
			kill 41;		// 음극 얼라인 T축 서보 Off
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) = N_Complete_Step;			//다음 스텟 이동			
		}
	}
	else if(  Mode == N_Align_CA_Take_Off ) // 양극 얼라인 탈착 모드일 경우
	{
		if((P_Motor_Current_Pos(N_1st_PnP_CA_T) < P_Cathode_1TR_T_Ready_POS + 0.5 && P_Motor_Current_Pos(N_1st_PnP_CA_T) > P_Cathode_1TR_T_Ready_POS - 0.5) && (P_Motor_Current_Pos(N_2nd_PnP_CA_T) < P_Cathode_2TR_T_Stack_POS + 0.5 && P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Cathode_2TR_T_Stack_POS - 0.5))
		{	
			kill 38;		// 양극 얼라인 T축 서보 Off
			P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) = N_Complete_Step;			//다음 스텟 이동	
		}
	}
}
if( P_Module_Align_Take_Off_Act_State_Machine_Array(N_Align_Take_Off_2nd_PNP_Stack_Move)== N_Complete_Step )
{
	if( Mode == N_Align_AN_Take_Off )		// 음극 얼라인 탈착 모드일 경우
	{
		M_Y_Anode_AT_Zero_Clamp_Sol = 1;	//음극 얼라인 테이블 제로 언클램프(1이 언클램프)
		P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_2nd_PNP_Stack_Move) = 1;				// 동작 완료 Bit On.
		rtn = N_COMPLETE;																			// 반환값 : COMPLETE
	}
	else if( Mode == N_Align_CA_Take_Off )// 양극 얼라인 탈착 모드일 경우
	{
		M_Y_Cathode_AT_Zero_Clamp_Sol = 1;	//양극 얼라인 테이블 제로 언클램프
		P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_2nd_PNP_Stack_Move) = 1;				// 동작 완료 Bit On.
		rtn = N_COMPLETE;																			// 반환값 : COMPLETE
	}
}
return;

close

