//================================================================================================//	


//================================================================================================//	
// 03. PMAC 명령 입력
//================================================================================================//	
//if( P_PMAC_Commands != P_Old_PMAC_Commands )	
//{	// 새로운 명령을 감지하면
switch( P_PMAC_Commands )
{
	case F_Command_NonCommand :
		// 명령이 없을 때
	break;

	case F_Command_Start :
		// 스타트 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Start ( P_PMAC_Status ) != F_Status_Nonseatus )
		{	// 현재상태의 스타트 커멘드에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Start( P_PMAC_Status );		// 현재 상태값 갱신
		}
	break;

	case F_Command_Complete :
		// 완료 명령.
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Complete ( P_PMAC_Status ) != F_Status_Nonseatus )
		{	// 현재 상태의 완료커멘드에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Complete( P_PMAC_Status );	// 현재 상태값 갱신
		}
	break;

	case F_Command_Reset :
		// 리셋 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Reset ( P_PMAC_Status ) != F_Status_Nonseatus )
		{	// 현재 상태의 리셋커멘드에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Reset( P_PMAC_Status );		// 현재 상태값 갱신
		}
	break;

	case F_Command_Hold :
		// 일시정지 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Hold ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재 상태의 일시정지명령에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Hold( P_PMAC_Status );		// 현재 상태값 갱신
		}
	break;

	case F_Command_Unhold :
		// 일시정지 해제 명령.
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Unhold ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재상태의 일시정지해제명령에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Unhold( P_PMAC_Status );	// 현재 상태값 갱신
		}
	break;

	case F_Command_Suspend :
		// 대기 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Suspend ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재상태의 대기명령에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Suspend( P_PMAC_Status );	// 현재 상태값 갱신
		}
	break;

	case F_Command_Unsuspend :
		// 대기 해제 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Unsuspend ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재상태의 대기해제명령에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Unsuspend( P_PMAC_Status );	// 현재 상태값 갱신
		}
	break;

	case F_Command_Clear :
		// 긴급 정지 해제 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Clear ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재상태의 긴급정지해제 명령에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Clear( P_PMAC_Status );		// 현재 상태값 갱신
		}
	break;

	case F_Command_Stop :
		// 정지 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Stop ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재상태의 정지 명령에 대한 변경될 상태값이 존재한다면
			// 260612 Stopping 무언정지 수정
			P_Stopping_Test_Timer = 0
			P_PMAC_Status = P_Command_Stop( P_PMAC_Status );		// 현재 상태값 갱신
		}
	break;

	case F_Command_Abort :
		// 긴급정지 명령
		P_Old_PMAC_Commands = P_PMAC_Commands;
		P_Old_PMAC_Status = P_PMAC_Status;						// 이전 상태값 저장
		P_PMAC_Commands = F_Command_NonCommand;					// 재진입 방지 커맨드 초기화
		if ( P_Command_Abort ( P_PMAC_Status ) != F_Status_Nonseatus )
		{ // 현재상태의 긴급정지 명령에 대한 변경될 상태값이 존재한다면
			P_PMAC_Status = P_Command_Abort( P_PMAC_Status );		// 현재 상태값 갱신
		}
	break;
}		
//}
//P_Old_PMAC_Commands = P_PMAC_Commands;
//================================================================================================//	

if(PLC[10].Active == 0)
{
	M_Y_P_PMAC_Status1 = 0;
	M_Y_P_PMAC_Status2 = 0;
	M_Y_P_PMAC_Status3 = 0;
	M_Y_P_PMAC_Status4 = 0;
	M_Y_P_PMAC_Status5 = 0;
}
//================================================================================================//	
// 04. Status변경에 따른 실행
//================================================================================================//	
//-------------------------------------------------------------------------------------
// 04-1) 명령부
//-------------------------------------------------------------------------------------
//If( P_Old_PMAC_Status != P_PMAC_Status )
// [ 참조 : 2021.08.31 P_PMAC_Status 변경 시 조건 글로벌 변수에서 로컬로 수정. 글로벌 변수 사용 구문이 너무 많음. ]
If( L_Old_PMAC_Status != P_PMAC_Status )
{ 
	//[참조 : 260507 마스터 싱크 기다리다가 스탑 시 해당 변수 초기화 되지 않아 초기화 추가]
	P_Stack_Heart_Bit_Sync_Flag = N_FALSE


	// 반대편 열에게 현재 P_PMAC_Status을 알려줌
	M_Y_P_PMAC_Status1 = ( (P_PMAC_Status >> 0) & 1 );
	M_Y_P_PMAC_Status2 = ( (P_PMAC_Status >> 1) & 1 );
	M_Y_P_PMAC_Status3 = ( (P_PMAC_Status >> 2) & 1 );
	M_Y_P_PMAC_Status4 = ( (P_PMAC_Status >> 3) & 1 );
	M_Y_P_PMAC_Status5 = ( (P_PMAC_Status >> 4) & 1 );

	//-------------------------------------------------------------------------------------
	// 04-1.1) 초기화.
	//-------------------------------------------------------------------------------------
		P_array_CF_Mode_Name,10,100 = 0; 
		L_Program_Run_Timer = 0;
	//-------------------------------------------------------------------------------------
	
	//-------------------------------------------------------------------------------------
	// 04-1.2) 상태에 따른 명령 프로세스 타입이 Acting Type이면
	//-------------------------------------------------------------------------------------
	If( P_Command_Process_Type(P_PMAC_Status) == F_Mask_Process_Type_Acting )
	{ 
		P_array_CF_Mode_Name = P_PMAC_Current_Mode;				// 현재 모드 저장
		P_array_CF_Function_Name = P_PMAC_Commands;				// 현재 명령 저장
		P_array_CF_Function_State_Number = 999;					// 현재 상태 저장(서브프로세스 프로그램 실행전 999라는 값을 넣어 서브프로세스프로그램이 정상런하는지 확인.)
		P_array_CF_Local_Alarm_Code = 0;						// 알람 코드 초기화
		P_array_CF_Function_Run_Time = 0;						// 실행시간 초기화
		P_array_CF_Function_Start_Flag = 0;						// 함수 실행 시작 플래그 초기화
		P_array_CF_Function_Run_Flag = 0;						// 함수 실행중 플래그 초기화			
		P_array_CF_Function_Return_Flag = 0;					// 함수 완료 복귀 플래그 초기화
		P_array_CF_Function_Mask = F_Mask_Process_Type_Acting;	// 함수 실행 상태 마스크

		// [ 참조 : 사이클정지 미사용 포인트_240221]
		// [ 참조 : stopping 시 자체 초기화 기능으로 인한 여기서 사용 금지 240415]

		P_Process_Function_Command = 0;

		call Sub_Automation_Circular_Queue.ClearQueue(&P_Queue_Clear);

		P_Mode_Function_State_Machine = 1;	// 스텟머신 시작.


		P_PMAC_Commands = F_Command_NonCommand;	
	}
	//-------------------------------------------------------------------------------------
	
	//-------------------------------------------------------------------------------------
	// 04-1.3) 상태에 따른 명령 프로세스 타입이 Completed Type이면
	//-------------------------------------------------------------------------------------
	If( P_Command_Process_Type(P_PMAC_Status) == F_Mask_Process_Type_Completed )
	{ 
		P_array_CF_Mode_Name = P_PMAC_Current_Mode;				// 현재 모드 저장
		P_array_CF_Function_Name = P_PMAC_Commands;				// 현재 명령 저장
		P_array_CF_Function_State_Number = 999;					// 현재 상태 저장(서브프로세스 프로그램 실행전 999라는 값을 넣어 서브프로세스프로그램이 정상런하는지 확인.)
		P_array_CF_Local_Alarm_Code = 0;							// 알람 코드 초기화
		P_array_CF_Function_Run_Time = 0;							// 실행시간 초기화
		P_array_CF_Function_Start_Flag = 0;							// 함수 실행 시작 플래그 초기화
		P_array_CF_Function_Run_Flag = 0;							// 함수 실행중 플래그 초기화		
		P_array_CF_Function_Return_Flag = 0;						// 함수 완료 복귀 플래그 초기화
		P_array_CF_Function_Mask = F_Mask_Process_Type_Completed;	// 함수 실행 상태 마스크
		P_Mode_Function_State_Machine = 1;	// 스텟머신 시작.

		P_PMAC_Commands = F_Command_NonCommand;	
	}
	//-------------------------------------------------------------------------------------
}
//P_Old_PMAC_Status = P_PMAC_Status;
// [ 참조 : 2021.08.31 P_PMAC_Status 변경 시 조건 글로벌 변수에서 로컬로 수정. 글로벌 변수 사용 구문이 너무 많음. ]
L_Old_PMAC_Status = P_PMAC_Status;
//-----------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------
// 04-2) 실행부
//-----------------------------------------------------------------------------------------
// 스텟머신별 실행내용.
if( P_Mode_Function_State_Machine == 0 )
{ // 0. 대기상태
	L_Old_Mode_Function_State_Machine = 0;
	L_Program_Run_Timer = 0;					// 프로그램 시작 시간 초기화
}

if( P_Mode_Function_State_Machine == 1 )
{ // 1.	상태변경 시작 플래그 대기.	
	if( L_Old_Mode_Function_State_Machine != 1 )
	{ // 스텟머신 1이 되는 순간 타이머초기화.
		L_Program_Run_Timer = 0;					// 프로그램 시작 시간 초기화
		L_Old_Mode_Function_State_Machine = 1;
	}
	else
	{ // 이후.
		if( L_Program_Run_Timer > N_Main_Timer_Value )		// 명령을 콜 한시간이 제한시간을 넘어간다면
		{		
			P_Mode_Function_State_Machine = 3;				// 스텟머신 3으로 이동.
		}
		if( P_array_CF_Function_Start_Flag != 0 )	// 함수가 시작되면 스텟머신 시작
		{ // 상태변경 시작 플래그 On상태면
			P_Mode_Function_State_Machine = 2;				// 스텟머신 증가. [ 참조 : 2021.08.31 자동운전중 무언정지 상황에서 P_PMAC_Status가 Stopping루틴에서 못빠져나오는 상황예외처리 ]
		}
	}
}

if( P_Mode_Function_State_Machine == 2 )
{ // 2. 상태변경 리턴 플래그 대기.
	P_array_CF_Function_Run_Time = L_Program_Run_Timer;	// 함수의 실행시간을 기록
	L_Old_Mode_Function_State_Machine = 2;
	if( P_array_CF_Function_Return_Flag != 0 )			 
	{	// 함수가 실행 완료되어 리턴 플래그를 주면
		//P_Mode_Function_State_Machine++;				// 스텟머신 증가.
		//[ 참조 : 2021.08.31 자동운전중 무언정지 상황에서 P_PMAC_Status가 Stopping루틴에서 못빠져나오는 상황예외처리 ]
		// 2021.08.31 P_Mode_Function_State_Machine++ -> P_Mode_Function_State_Machine = 3으로 수정	
		P_Mode_Function_State_Machine = 3; //2021.08.31 수정예정.
	}
}

if( P_Mode_Function_State_Machine == 3 )
{ // 3. Function_Mask 타입에 따른 실행 분류.
	L_Old_Mode_Function_State_Machine =3;
	if( P_array_CF_Function_Mask == F_Mask_Process_Type_Acting )
	{	// 3.1) Acting Type이면
		P_PMAC_Status = P_Command_Status_Complete( P_PMAC_Status );	// 다음 경로의 명령을 자동 호출
	}
	if( P_array_CF_Function_Mask == F_Mask_Process_Type_Completed )
	{	// 3.2) Completed Type이면
			// 다른 명령이 들어올 때 까지 대기
	}
	P_Mode_Function_State_Machine = 0;				// 명령 대기 상태로 이동.
}
//-----------------------------------------------------------------------------------------
P_Old_PMAC_Current_Mode = P_PMAC_Current_Mode;

P_MNTR_PLC8_Task_Time(1) = (Sys.Time - P_MNTR_PLC8_Task_Time(0))*N_Task_Scale;

if ( P_MNTR_PLC8_Task_Time(1) > P_MNTR_PLC8_Task_Max_Time )
{
	P_MNTR_PLC8_Task_Max_Time = P_MNTR_PLC8_Task_Time(1);
}

CLOSE
//enable plc 8