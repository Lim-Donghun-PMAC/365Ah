	Motor[N_1st_PnP_AN_T].ProgJogPos = P_Anode_1TR_T_Ready_POS*1000;	//T축 대기 
	cmd"#%d j=*",N_1st_PnP_CA_T;
	cmd"#%d j=*",N_1st_PnP_AN_T;
	//jog1=*;
	//jog2=*;
	rtn = N_TRUE;
return;

