				P_Slave16_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Anode_Run_Motion_Array(0),100,1 = 0;
				if( P_Dry_Run_Inspection == 0 )
				{
					// 2.2) 입력.
					//////음극 1차 P&P //////
					P_Slave16_Anode_Run_Motion_Array(0)=5;		// P_Slave1_Anode_Run_Motion_Array(0)=5;	Belt하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave16_Anode_Run_Motion_Array(15)=6;		// P_Slave1_Anode_Run_Motion_Array(15)=6;	Belt상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave16_Anode_Run_Motion_Array(22)=1;		// Belt -> A/S 이동.										// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave1_Anode_Run_Motion_Array(22)=1;
					//////음극 Picker T //////
					//P_Slave2_Anode_Run_Motion_Array(22)=1;	//PickerT좌표계 PNP에 묶음으로 인하여 Run Mode 배열 주석 처리  [ 참조 : 26.08.14 PickerT 모션 변경 ]		// 180 Deg 회전.		[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
					//////음극 2차 P&P //////
					P_Slave17_Anode_Run_Motion_Array(0)=5;		// P_Slave3_Anode_Run_Motion_Array(0)=5;	A/S하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave17_Anode_Run_Motion_Array(15)=6;		// P_Slave3_Anode_Run_Motion_Array(15)=6;	A/S상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave17_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.									// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave3_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.
					//////음극 클램프 //////
					P_Slave4_Anode_Run_Motion_Array(1)=2;		// Clamp On.
					P_Slave4_Anode_Run_Motion_Array(14)=3;		// Clamp On.
					//////FINAL ROLL //////
					P_Slave5_Anode_Run_Motion_Array(21)=2;		// 양극방향  이동
					// 드라이빙
					P_Slave15_Anode_Run_Motion_Array(P_Anode_Run_DR) = 2;	// 드라이빙
					//////STACK TABLE //////
					//////양극 클램프 //////
					P_Slave7_Anode_Run_Motion_Array(29)=1;		// Clamp Off
					//////양극 2차 P&P //////
					P_Slave18_Anode_Run_Motion_Array(0)=3; 		// P_Slave8_Anode_Run_Motion_Array(0)=3;  Stack 하강.	// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave18_Anode_Run_Motion_Array(8)=13; 	// 드라이런 Stack 세파모드 블로우 추가.	
					P_Slave18_Anode_Run_Motion_Array(15)=4;		// P_Slave8_Anode_Run_Motion_Array(15)=4; Stack 상승.	// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave18_Anode_Run_Motion_Array(22)=2;		// Stack -> A/S 이동										// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave8_Anode_Run_Motion_Array(22)=2;		// Stack -> A/S 이동
					//////양극 1차 P&P //////
					P_Slave19_Anode_Run_Motion_Array(0)=3;		// P_Slave10_Anode_Run_Motion_Array(0)=3;	A/S 하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave19_Anode_Run_Motion_Array(15)=4;		// P_Slave10_Anode_Run_Motion_Array(15)=4;	A/S 상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave19_Anode_Run_Motion_Array(22)=2;		// belt 이동												// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave10_Anode_Run_Motion_Array(22)=2;		// belt 이동	
				}
				else
				{
					//////음극 1차 P&P //////
					P_Slave16_Anode_Run_Motion_Array(0)=5;		//P_Slave1_Anode_Run_Motion_Array(0)=5;		// Belt하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave16_Anode_Run_Motion_Array(15)=6;		//P_Slave1_Anode_Run_Motion_Array(15)=6;	// Belt상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave16_Anode_Run_Motion_Array(22)=1;		// Belt -> A/S 이동.											// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave1_Anode_Run_Motion_Array(22) = 1;	// Belt -> A/S 이동.											
					//////음극 Picker T //////
					//P_Slave2_Anode_Run_Motion_Array(22)=1;	//PickerT좌표계 PNP에 묶음으로 인하여 Run Mode 배열 주석 처리  [ 참조 : 26.08.14 PickerT 모션 변경 ]		// 180 Deg 회전.		[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
					//////음극 2차 P&P //////
					P_Slave17_Anode_Run_Motion_Array(0)=5;		//P_Slave3_Anode_Run_Motion_Array(0)=5;		// A/S하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave17_Anode_Run_Motion_Array(15)=6;		//P_Slave3_Anode_Run_Motion_Array(15)=6;	// A/S상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave17_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.										// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave3_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.
					//////음극 클램프 //////
					//[ 참조 : 26.02.25 클램프, 스텍테이블, 드라이빙 롤러 모션 배열 변경(타임테이블 일치화) ]
					P_Slave4_Anode_Run_Motion_Array(1)=2;		// Clamp On.
					P_Slave4_Anode_Run_Motion_Array(14) = 3;	// 극판 두께만큼 하강
					//////FINAL ROLL //////
					P_Slave5_Anode_Run_Motion_Array(21)=2;		// 양극방향  이동
					if( P_First_Sepa_Driving_Use == 1 )			// 드라이빙 사용 
						P_Slave15_Anode_Run_Motion_Array(P_Anode_Run_DR) = 2;	// 드라이빙
						
					//////양극 클램프 //////
					P_Slave7_Anode_Run_Motion_Array(29)=1;		// Clamp Off
					//////양극 2차 P&P //////
					P_Slave18_Anode_Run_Motion_Array(0)=3; 		// P_Slave8_Anode_Run_Motion_Array(0)=3;	Stack 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave18_Anode_Run_Motion_Array(8)=11; 	// P_Slave8_Anode_Run_Motion_Array(8)=11;	Stack 블로우.	// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave18_Anode_Run_Motion_Array(15)=4;		// P_Slave8_Anode_Run_Motion_Array(15)=4;	Stack 상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave18_Anode_Run_Motion_Array(22)=2;		// Stack -> A/S 이동											// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave8_Anode_Run_Motion_Array(22)=2;		// Stack -> A/S 이동	
					//////양극 1차 P&P //////
					P_Slave19_Anode_Run_Motion_Array(0)=3;		// P_Slave10_Anode_Run_Motion_Array(0)=3;	A/S 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave19_Anode_Run_Motion_Array(8)=12;		// P_Slave10_Anode_Run_Motion_Array(8)=12;	A/S 블로우		// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave19_Anode_Run_Motion_Array(15)=4;		// P_Slave10_Anode_Run_Motion_Array(15)=4;	A/S 상승			// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave19_Anode_Run_Motion_Array(22)=2;		// belt 이동													// [ 참 조 : 2025.11.24 Z축 분리 ]
					P_Slave10_Anode_Run_Motion_Array(22)=2;		// belt 이동	

				}
			// 3) 결과값 리턴.
				Result = F_Result_Complete;		

				P_Anode_Cur_Mode = F_Dry_Run;
		break;

		case F_NG :		// 양극 얼라인 NG처리를 위한 음극런 사이클.	24.01.31 추가.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Anode_Run_Command) = Trg;
