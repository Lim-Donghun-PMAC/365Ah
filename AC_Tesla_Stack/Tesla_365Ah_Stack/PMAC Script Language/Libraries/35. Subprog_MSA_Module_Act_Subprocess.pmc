		//M_Y_Anode_AT_Vac_Ejector_Vac_Off = 1; 																																																										
		//M_Y_Anode_NG_PNP_Ejector_Vac_On = 1;	
		//M_Y_Anode_NG_PNP_Ejector_Vac_Off = 0;	
		//M_X_Anode_NG_PNP_Vac_Sensor = 1; //임시																						
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )			// 양극 얼라인 MSA 모드일 경우 																		
	{
		P_Slave12_Motion_Command = 7;																									// 양극 NG PNP 얼라인 흡착 커멘드 				
		P_MSA_Chk_Pos_Timer = 0;																										// 체크 타이머 초기화 
		//M_Y_Cathode_AT_Vac_Ejector_Vac_On = 0;																				
		//M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 1; 																																															
		//M_Y_Cathode_NG_PNP_Ejector_Vac_On = 1;
		//M_Y_Cathode_NG_PNP_Ejector_Vac_Off = 0;	
		//M_X_Cathode_NG_PNP_Vac_Sensor = 1; //임시																					
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Align )						// 음극 얼라인 MSA 모드일 경우
	{
		if ( M_X_Anode_NG_PNP_Vac_Sensor == 1 && M_X_Anode_AT_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )				// 음극 NG PNP 흡착 확인 
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )				// 양극 얼라인 MSA 모드일 경우
	{																														
		if ( M_X_Cathode_NG_PNP_Vac_Sensor == 1 && M_X_Cathode_AT_Vac_Sensor == 0 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time)	 		// 양극 NG PNP 흡착 확인 
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_NG_PNP_Vacume_ON) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																													// 반환값 : COMPLETE
}
return;

