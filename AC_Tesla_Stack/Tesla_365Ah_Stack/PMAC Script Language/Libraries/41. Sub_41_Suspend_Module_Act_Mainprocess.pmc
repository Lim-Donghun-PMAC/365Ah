			P_Module_Act_Command_Array(N_Act_ARC_Post_Act) = F_ACT_STATUS_ALARM;						// 동작 에러.
		}
	}
	ELSE																								// 동작이 활성화 상태가 아닐 경우.
	{
		IF ( P_OLD_Module_Act_Command_Array(N_Act_ARC_Post_Act) == F_ACT_STATUS_ENABLE )				// 이전 Command가 Enable 일 경우.
		{
			P_OLD_Module_Act_Command_Array(N_Act_ARC_Post_Act) = F_ACT_STATUS_INITIAL;					// 엣지 변수 초기화
