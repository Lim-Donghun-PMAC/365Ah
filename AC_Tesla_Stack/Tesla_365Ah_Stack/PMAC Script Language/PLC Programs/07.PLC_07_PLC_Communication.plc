//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.xx.xx 
// 내용 - [ 참조 : 25.xx.xx 내용 ]

open PLC 7
P_MNTR_PLC7_Task_Time(0) = Sys.Time;
#define	L_System_Timer							Sys.Time
#define N_Time_Scale							1000
#define N_Range_Update_Interval_Interface		0.1
Local   L_Time_Cycle_Up_Count_Start_Time;       // Plc[7].ldata.L[0]  시작 체크 시작 시간 
Local   L_Time_Cycle_Up_Count_End_Time;         // Plc[7].ldata.L[1]  시작 체크 종료 시간
Local   L_Time_Cycle_Up_Count_Delta_Time;       // Plc[7].ldata.L[2]  시작과 종료 시간 사이의 시간
Local   L_Flag_Cycle_Up_Count_Init_Flag;        // Plc[7].ldata.L[3]  타이머 초기화 플래그
local	L_SizeQueue_Select_Clear;

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
If (L_Flag_Cycle_Up_Count_Init_Flag == 0)
{
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 00.2) 시간 체크
If (L_Flag_Cycle_Up_Count_Init_Flag == 1)
{
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;

	If( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
     		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
If (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval_Interface)
{
    // 여기에 타이머 추가	
    P_Read_Timer_S(1) = P_Read_Timer_S(1) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(2) = P_Read_Timer_S(2) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(3) = P_Read_Timer_S(3) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(4) = P_Read_Timer_S(4) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(5) = P_Read_Timer_S(5) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(6) = P_Read_Timer_S(6) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(7) = P_Read_Timer_S(7) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Read_Timer_S(8) = P_Read_Timer_S(8) + L_Time_Cycle_Up_Count_Delta_Time;

	P_Write_Timer_S(1) = P_Write_Timer_S(1) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(2) = P_Write_Timer_S(2) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(3) = P_Write_Timer_S(3) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(4) = P_Write_Timer_S(4) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(5) = P_Write_Timer_S(5) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(6) = P_Write_Timer_S(6) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(7) = P_Write_Timer_S(7) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Write_Timer_S(8) = P_Write_Timer_S(8) + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//========================================================================================================================
if(P_PMAC_Current_Mode == F_Current_Automatic)
{
	P_Interval_Read_S(1) = P_Read_Sector_TactTime(1);
	P_Interval_Read_S(2) = P_Read_Sector_TactTime(2);			
	P_Interval_Read_S(3) = P_Read_Sector_TactTime(3);			
	P_Interval_Read_S(4) = P_Read_Sector_TactTime(4);			
	P_Interval_Read_S(5) = P_Read_Sector_TactTime(5);			

	P_Interval_Write_S(1) = P_Write_Sector_TactTime(1);
	P_Interval_Write_S(2) = P_Write_Sector_TactTime(2);
	P_Interval_Write_S(3) = P_Write_Sector_TactTime(3);
	P_Interval_Write_S(4) = P_Write_Sector_TactTime(4);
	P_Interval_Write_S(5) = P_Write_Sector_TactTime(5);
}
else if(P_PMAC_Current_Mode == F_Current_Manual)
{
	P_Interval_Read_S(1) = P_Interval_Read_Time(1)
	P_Interval_Read_S(2) = P_Interval_Read_Time(2)		
	P_Interval_Read_S(3) = P_Interval_Read_Time(3)		
	P_Interval_Read_S(4) = P_Interval_Read_Time(4)		
	P_Interval_Read_S(5) = P_Interval_Read_Time(5)			

	P_Interval_Write_S(1) = P_Interval_Write_Time(1)
	P_Interval_Write_S(2) = P_Interval_Write_Time(2)
	P_Interval_Write_S(3) = P_Interval_Write_Time(3)
	P_Interval_Write_S(4) = P_Interval_Write_Time(4)
	P_Interval_Write_S(5) = P_Interval_Write_Time(5)
}

//=========================================================================
// <Sector 1> Receive Data (Receive From PLC)
//=========================================================================
// Sector 별 가중치
if( P_Read_Timer_S(1) > P_Interval_Read_S(1))
{
	M_Read_Sector_Scan_Complete(1) = 0;
	M_Read_Sector_Scan_Cmd(1) = 1;			// Read Sector No.1 Scan Command!
	P_Read_Timer_S(1) = 0;
}

if( P_SV_Read_Enable_Flag == 0 && M_Read_Sector_Scan_Complete(1) == 1 ) // sv 읽기 허가 신호 on
{	// Recipe에 있는 값을 Auto, Starting 시 1번 값을 읽어온다.
	M_Read_Sector_Scan_Complete(1) = 0;

}

if( P_Read_Timer_S(2) > P_Interval_Read_S(2))
{
	M_Read_Sector_Scan_Complete(2) = 0;
	M_Read_Sector_Scan_Cmd(2) = 1;			// Read Sector No.1 Scan Command!
	P_Read_Timer_S(2) = 0;
}

if( M_Read_Sector_Scan_Complete(2) == 1 )			// QCP Data 구간. → 구간 맞는지 확인 필요
{
	// QCP 1-1
	if( Sys.Idata[10400] >= 0 )
	{	
		P_Jelly_Roll_Recipe_Count = Sys.Idata[10400];				// 젤리 롤 목표 생산 개수 설정
	}

	P_ARC_End_Sepa_Recipe_Count	                        = Sys.Idata[10403];				// 세파 ARC 종료 후 적층 개수
	P_Sepa_Mode_Sepa_Recipe_Count	                    = Sys.Idata[10404];				// 세파 모드 적층 개수

	if( Sys.Idata[10405] >= 0 && Sys.Idata[10405] <= 100 )								
	{																					
		P_Recipe_Speed_Value = Sys.Idata[10405];										// 장비 속도
	}
	P_Separate_Cutter_Heating_Limit_Value = Sys.Idata[10406];							// 1차 언로더 열선 커터 온 리미트 값 
	P_Separate_Cutting_Current   = Sys.Idata[10407];									// Separate_Cutting 전류 확인 값
	
	P_Cathode_Clamp_MC_Cylinder_Count = Sys.Idata[10416];					// 양극 클램프 상단 실린더 사용 횟수 저장 영역
	P_Anode_Clamp_MC_Cylinder_Count	  = Sys.Idata[10417];					// 음극 클램프 상단 실린더 사용 횟수 저장 영역
	P_Cathode_Clamp_OP_Cylinder_Count = Sys.Idata[10418];					// 양극 클램프 중단 실런더 사용 횟수 저장 영역
	P_Anode_Clamp_OP_Cylinder_Count   = Sys.Idata[10419];					// 음극 클램프 중단 실런더 사용 횟수 저장 영역

	//[ 참조 : 26.08.21 Power Rack 풀림 현상 개선 프로그램. ]
	//P_Cathode_Run_FR_Move_Check_AI	= Sys.Idata[10428];					// 테스트 후, 해당 영역 잡아주시면 됩니다.
	//P_Anode_Run_FR_Move_Check_AI		= Sys.Idata[10429];					// 테스트 후, 해당 영역 잡아주시면 됩니다.

	P_Separate_Cutter_Change_Cycle = Sys.Idata[10442];									// 세파 커터 교체 주기

	P_Recipe_Dancer_input_kgf = u.user:$00A394.00.16;

	// 터치에서 3자리로 받아옴 0 ~ 116범위.
	if( P_Recipe_Dancer_input_kgf/10 <= P_MAX_KGF )
	{
		P_Rot_OutValue = int((P_Recipe_Dancer_input_kgf/10) * P_KGF_TO_DAC_RATIO)/100;
	}
	else
	{
		//현재 값 유지.
	}

	P_Servo_Dancer_Alarm_Maximum_Angle_Value = Sys.Idata[10456];				//서보 댄서 알람 발생 각도 상한 값
	P_Servo_Dancer_Alarm_Minimum_Angle_Value = Sys.Idata[10457];				//서보 댄서 알람 발생 각도 하한 값


	if( P_SV_Read_Enable_Flag == 0 )
	{
		// J/R 폭
		if( Sys.Idata[10441] < 30000 && Sys.Idata[10441] >= 0 )
		{
		  P_SV_Jelly_Roll_Width	= Sys.Idata[10441]/100;
		}

		// 양극 Stack 수 
		if( Sys.Idata[10421] < 300 && Sys.Idata[10421] >= 0 )
		{
			P_SV_Cathode_Count	= Sys.Idata[10421];
		}

		// 음극 Stack 수
		if( Sys.Idata[10422] < 300 && Sys.Idata[10422] >= 0 )
		{
			P_SV_Anode_Count = Sys.Idata[10422];
		}	


		// Clamp 압력_양극뱡항_기준값
		if( I_Cathode_Clamp_Damper < 1000 && I_Cathode_Clamp_Damper >= 0 )
		{
		//									I_Cathode_Clamp_Damper = Sys.Idata[10423] 
		  P_SV_AO_Reference_Value_Chanel(1)	= I_Cathode_Clamp_Damper/50;	// 나누기 50을 하는 이유는 Voltage 변환을 위함
																			// ex) 0.5를 입력하게 되면 PLC에선 500이란 값을 주게됌. -> 500/50 = 10V 사용
																			//		0.5Mpa = Max = 10V
		}
		// Clamp 압력_음극뱡항_기준값
		if( I_Anode_Clamp_Damper < 1000 && I_Anode_Clamp_Damper >= 0 )
		{  
		//									I_Anode_Clamp_Damper = Sys.Idata[10426] 
		  P_SV_AO_Reference_Value_Chanel(2)	= I_Anode_Clamp_Damper/50;		// 나누기 50을 하는 이유는 Voltage 변환을 위함
																			// ex) 0.5를 입력하게 되면 PLC에선 500이란 값을 주게됌. -> 500/50 = 10V 사용
																			//		0.5Mpa = Max = 10V
		}

		// 양극 두께_기준값
		if( Sys.Idata[10432] < 1000 && Sys.Idata[10432] >= 0 )
		{
		  P_SV_Cathode_Reference_Thickness	= Sys.Idata[10432]/1000;
		}

		// 음극 두께_기준값
		if( Sys.Idata[10435] < 1000 && Sys.Idata[10435] >= 0 )
		{
		  P_SV_Anode_Reference_Thickness	= Sys.Idata[10435]/1000;
		}

		// 분리막 두께_기준값
		if( Sys.Idata[10438] < 1000 && Sys.Idata[10438] >= 0 )
		{
		  P_SV_Sepa_Reference_Thickness	= Sys.Idata[10438]/1000;
		}

		P_SV_Stack_Table_Cathode_Reference_Value = Sys.Idata[10436];		// 스택 테이블 댐퍼 정공 레귤레이터 양극
		P_SV_Stack_Table_Anode_Reference_Value = Sys.Idata[10437];			// 스택 테이블 댐퍼 정공 레귤레이터 음극

		P_Cathode_Recipe_Count = P_SV_Cathode_Count;								// 양극 Stack 수
		P_Anode_Recipe_Count = P_SV_Anode_Count;									// 음극 Stack 수
		P_AO_Cathode_Clamp_Damper = P_SV_AO_Reference_Value_Chanel(1);				// Clamp 압력_양극 방향_기준 값
		P_AO_Anode_Clamp_Damper = P_SV_AO_Reference_Value_Chanel(2);				// Clamp 압력_음극 방향_기준 값
		P_Cathode_Thickness_PLC = P_SV_Cathode_Reference_Thickness;					// 양극 두께_기준 값
		P_Anode_Thickness_PLC = P_SV_Anode_Reference_Thickness;						// 음극 두께_기준 값
		P_Sepa_Thickness_PLC = P_SV_Sepa_Reference_Thickness;						// 분리막 두께_기준 값
		
		// 드라이빙 롤러 옵셋 값 (임시로 1호기만 적용해서 테스트)

		P_SV_Read_Enable_Flag = 1;
	}

		P_CA_DR_Offset = Sys.Idata[10473]/1000;
		P_AN_DR_Offset = Sys.Idata[10474]/1000;
		P_First_DR_Offset = Sys.Idata[10475]/1000;
		P_Last_DR_Offset = Sys.Idata[10476]/1000;

		P_After_ARC_Rotate_Distance = sys.Idata[10464] / 10000;						// 260423

		P_X_Move_Recipe_Percent					  = Sys.Idata[10408];						// APC 보정값 
		P_Discharged_After_End_Trigger			  = u.user:$00A2A4.00.16					// 중간 배출 후 설비 정지 신호 (APC 관련 - 배출 후 PLC에서 생산을 멈추기 위해 주는 신호)
		P_Unloader_1st_Grip_Delay				  = Sys.Idata[10410];						// 1차 언로더 그립 딜레이 값 (소수점 두자리) ex ui: 20sec -> idata = 2000

		/*
		// 양/음극 탭 재검사 연속ng 발생시 plc <-> ppmac 인터페이스 신호
		P_X_Cathode_Sheet_Tab_Retry_inspection_Continuos_Ng_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A2AC.00.1;
		P_X_Anode_Sheet_Tab_Retry_inspection_Continuos_Ng_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A2AC.01.1;

		// 양/음극 캘틀어짐 사이클정지 사용/미사용 정의
		#ifdef F_Align_Calibration_twisted_Enable 
		// 양/음극 캘틀어짐 사이클정지
		P_X_Cathode_Align_Calibration_twisted_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A2AC.02.1;
		P_X_Anode_Align_Calibration_twisted_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A2AC.03.1;

		// 스텍 얼라인 캘리브레이션 틀어짐 vision -> ppmac 인터페이스 신호 
		P_X_Stack_Align_Calibration_twisted_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A2AC.04.1;
		#endif
		*/
		P_Interlock_Messege_Confirmed = u.user:$00A2AC.05.1;								// 인터락 팝업 완료 신호
		P_X_MC_Communication_HeartBit = u.user:$00A2AC.06.1;								// 이더넷 통신 하트 비트 신호 (D영역 하트비트 신호 입력)
		P_BTN_LED_LAMP = u.user:$00A2AC.07.1
		
		P_X_Ecat_Reconnection_BTN = u.user:$00A2AC.08.1

		// PLC 셋업 모드 상태
		P_X_PLC_Setup_Mode_Check = u.user:$00A2AC.09.1;

		//양극 vision 연속 불량 알람 발생 횟수
		if( Sys.Idata[10444] > P_Cathode_Align_Continuous_NG_Check_range )
		{
			P_Cathode_Align_Continuous_NG_Recipe = P_Cathode_Align_Continuous_NG_Check_range;	
		}
		else
		{
			P_Cathode_Align_Continuous_NG_Recipe = Sys.Idata[10444];
		}

		//음극 vision 연속 불량 알람 발생 횟수
		if( Sys.Idata[10445] > P_Anode_Align_Continuous_NG_Check_range )
		{
			P_Anode_Align_Continuous_NG_Recipe = P_Anode_Align_Continuous_NG_Check_range;	
		}
		else
		{
			P_Anode_Align_Continuous_NG_Recipe = Sys.Idata[10445];
		}

		//양극 Surface vision 연속 불량 알람 발생 횟수
		if( Sys.Idata[10446] > P_Cathode_Surface_Continuous_NG_Check_range )
		{
			P_Cathode_Surface_Continuous_NG_Recipe = P_Cathode_Surface_Continuous_NG_Check_range;	
		}
		else
		{
			P_Cathode_Surface_Continuous_NG_Recipe = Sys.Idata[10446];
		}
		
		//음극 Surface vision 연속 불량 알람 발생 횟수
		if( Sys.Idata[10447] > P_Anode_Surface_Continuous_NG_Check_range )
		{
			P_Anode_Surface_Continuous_NG_Recipe = P_Anode_Surface_Continuous_NG_Check_range;	
		}
		else
		{
			P_Anode_Surface_Continuous_NG_Recipe = Sys.Idata[10447];
		}

		//스텍 vision 연속 불량 알람 발생 횟수
		if( Sys.Idata[10450] > P_Stack_Align_Continuous_NG_Check_range )
		{
			P_Stack_Vision_Continuous_NG_Recipe = P_Stack_Align_Continuous_NG_Check_range;	
		}
		else
		{
			P_Stack_Vision_Continuous_NG_Recipe = Sys.Idata[10450];
		}

		P_PLC_EPC_Status = u.user:$00A34C.16.16;								// 엑츄에이터 동작 상태 0 - AUTO , 2 - Manual,  4- Center

		P_Sepa_Mode_EPC_Recipe_Count = u.user:$00A350.00.16;					// EPC 보정 모드 2차 세파 모드 개수
		P_PLC_Recipe_Revise_Sepa	 =	u.user:$00A350.16.16;					// EPC 보정 모드 Retry 횟수 설정
		P_X_PLC_to_PMAC_Correction_Value = u.user:$00A354.00.16;				// EPC 보정률

		//음극 Align Vision 연속 불량 알람 발생 탐색 범위 설정
		if( u.user:$00A354.16.16 > N_Queue_Max_Size )
		{
			P_Anode_Align_Continuous_NG_Check_range = N_Queue_Max_Size;
		}
		else if( u.user:$00A354.16.16 > 0 )
		{
			P_Anode_Align_Continuous_NG_Check_range	= u.user:$00A354.16.16;
		}

		//양극 Align Vision 연속 불량 알람 발생 탐색 범위 설정
		if( u.user:$00A358.00.16 > N_Queue_Max_Size )
		{
			P_Cathode_Align_Continuous_NG_Check_range = N_Queue_Max_Size;
		}
		else if( u.user:$00A358.00.16 > 0 )
		{
			P_Cathode_Align_Continuous_NG_Check_range	= u.user:$00A358.00.16;
		}

		//스텍 Align Vision 연속 불량 알람 발생 탐색 범위 설정
		if( u.user:$00A35C.16.16 > N_Queue_Max_Size )
		{
			P_Stack_Align_Continuous_NG_Check_range = N_Queue_Max_Size;
		}
		else if( u.user:$00A35C.16.16 > 0 )
		{
			P_Stack_Align_Continuous_NG_Check_range	= u.user:$00A35C.16.16;
		}	

		//양극 Surface Vision 연속 불량 알람 발생 탐색 범위 설정
		if( u.user:$00A35C.00.16 > N_Queue_Max_Size )
		{
			P_Cathode_Surface_Continuous_NG_Check_range = N_Queue_Max_Size;
		}
		else if( u.user:$00A35C.00.16 > 0 )
		{
			P_Cathode_Surface_Continuous_NG_Check_range	= u.user:$00A35C.00.16;
		}	

		//음극 Surface Vision 연속 불량 알람 발생 탐색 범위 설정
		if( u.user:$00A358.16.16 > N_Queue_Max_Size )
		{
			P_Anode_Surface_Continuous_NG_Check_range = N_Queue_Max_Size;
		}
		else if( u.user:$00A358.16.16 > 0 )
		{
