//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.09 김성중 선임
// MSA 모듈화 프로그래밍 진행 - [ 참조 : 25.07.09 MSA 프로그램 신규 추가 ] 
// 25.07.28 김성중 선임 
// Cal, Cleaning 위치 이동, Align 탈착 모드 프로그래밍 진행 - [ 참조 : 25.07.28 Cal 프로그램 및 얼라인 탈착 모드 신규 추가 ] 
// 25.12.09 김성중 선임
// Cycle Stop 모듈화 작업 진행

open plc 13
P_MNTR_PLC13_Task_Time(0) =  Sys.Time;
#define	L_System_Timer				Sys.Time			// 시스템 타이머

Local L_Time_Cycle_Up_Count_Start_Time;						// Plc[13].ldata.L[0] 시간 체크 시작 시간
Local L_Time_Cycle_Up_Count_End_Time;						// Plc[13].ldata.L[1] 시간 체크 종료 시간
Local L_Time_Cycle_Up_Count_Delta_Time;						// Plc[13].ldata.L[2] 시작과 종료 시간 사이의 시간
Local L_Flag_Cycle_Up_Count_Init_Flag;						// Plc[13].ldata.L[3] 타이머 초기화 플래그
local L_PLC13_MSA_InterLock_Program_Active;					// Plc[13].ldata.L[4] 상태에 따른 프로그램 
local L_MSA_InterLock_MNTR;									// Plc[13].ldata.L[5] MSA Interlock 모니터링 
local L_Old_BTN_AN_Align_MSA;								// Plc[13].ldata.L[6] 음극 얼라인 MSA 버튼 상태 
local L_Old_BTN_CA_Align_MSA;								// Plc[13].ldata.L[7] 양극 얼라인 MSA 버튼 상태
local L_Old_BTN_AN_Stack_MSA;								// Plc[13].ldata.L[8] 음극 Stack MSA 버튼 상태 
local L_Old_BTN_CA_Stack_MSA;								// Plc[13].ldata.L[9] 양극 Stack MSA 버튼 상태 
local L_VISION_MSA_InterLock_Check_Assy_Bit;				// Plc[13].ldata.L[10] MSA 인터락 비트 변화 감지
local L_MSA_Check_Bit_Rtn;									// Plc[13].ldata.L[11] MSA 체크 비트 리턴 값 
local L_MSA_InterLock_Check_Rtn;							// Plc[13].ldata.L[12] MSA 인터락 비트 리턴 값 
local L_MSA_InterLock_Bit_Add_Rtn;							// Plc[13].ldata.L[13] 비트 삽입 함수 결과값 리턴 값
local L_Module_Interval_Timer;								// Plc[13].ldata.L[14] 인터벌 타이머

local L_Old_BTN_Align_AN_Take_OFF;							// Plc[13].ldata.L[15] 음극 얼라인 탈착 모드 버튼 이전 값 
Local L_Old_BTN_Align_CA_Take_OFF;							// Plc[13].ldata.L[16] 양극 얼라인 탈착 모드 버튼 이전 값 

local L_Align_Take_Off_InterLock_Check_Assy_Bit;			// Plc[13].ldata.L[17] 양극 얼라인 탈착 모드 비트 변화 감지 
Local L_Align_Take_Off_InterLock_MNTR;						// Plc[13].ldata.L[18] 음극 얼라인 탈착 모드 Interlock 모니터링
local L_Align_Take_Off_Check_Bit_Rtn;						// Plc[13].ldata.L[19] 양극 얼라인 탈착 모드 체크 비트 리턴 값  
Local L_Align_Take_Off_InterLock_Check_Rtn;					// Plc[13].ldata.L[20] 음극 얼라인 탈착 모드 인터락 비트 리턴 값  
local L_Align_Take_Off_InterLock_Bit_Add_Rtn;				// Plc[13].ldata.L[21] 양극 얼라인 탈착 모드 비트 삽입 함수 결과값 리턴 값
Local L_Pos_Mem_Rtn;										// Plc[13].ldata.L[22] 개별 위치메모리 리턴값 

// 모니터링 변수 
local L_PLC13_Stopping_CycleStop_Precondtion_MNTR;			// Plc[13].ldata.L[23]
local L_PLC13_Cycle_Stop_Act_Management_Active;				// Plc[13].ldata.L[24]	서브 프로그램 활성화
local L_PLC13_Manual_Act_Management_Active;					// Plc[13].ldata.L[25]	서브 프로그램 활성화
Local L_PLC13_Manual_ARC_Act_Management_Active				// Plc[13].ldata.L[25]	매뉴얼 ARC 동작 프로그램 활성화

Local L_Old_BTN_Stack_2nd_PNP_Cleaning_Mode;				// Plc[13].ldata.L[26]	2차 클리닝 모드 버튼 이전 값 

//[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
local L_Old_N_BTN_CA_1st_PNP_Vac_Chk_Mode;					// Plc[13].ldata.L[27]	음극 1차 PNP 흡착 텍 측정 모드 버튼 이전 값 		
local L_Old_N_BTN_AN_1st_PNP_Vac_Chk_Mode;					// Plc[13].ldata.L[28]	양극 1차 PNP 흡착 텍 측정 모드 버튼 이전 값 
local L_Old_N_BTN_CA_2nd_PNP_Vac_Chk_Mode;					// Plc[13].ldata.L[29]	음극 2차 PNP 흡착 텍 측정 모드 버튼 이전 값 
local L_Old_N_BTN_AN_2nd_PNP_Vac_Chk_Mode;					// Plc[13].ldata.L[30]	양극 2차 PNP 흡착 텍 측정 모드 버튼 이전 값 

local L_PLC13_Manual_Stopping_RTN;							// Plc[13].ldata.L[31]
//========================================================================================================================
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
	
// 00.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	
	L_Module_Interval_Timer = L_Module_Interval_Timer +	L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	P_MSA_Chk_Pos_Timer = P_MSA_Chk_Pos_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Align_Take_Off_Chk_Pos_Timer = P_Align_Take_Off_Chk_Pos_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Anode_Align_MSA_Execute_Timer = P_Anode_Align_MSA_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Cathode_Align_MSA_Execute_Timer = P_Cathode_Align_MSA_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Anode_Stack_MSA_Execute_Timer = P_Anode_Stack_MSA_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Cathode_Stack_MSA_Execute_Timer = P_Cathode_Stack_MSA_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	//[참조 : 260813 PNP 흡착 텍 측정 모드 추가 ]
	P_Anode_1st_PNP_Vac_Chk_Execute_Timer = P_Anode_1st_PNP_Vac_Chk_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Cathode_1st_PNP_Vac_Chk_Execute_Timer = P_Cathode_1st_PNP_Vac_Chk_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Anode_2nd_PNP_Vac_Chk_Execute_Timer = P_Anode_2nd_PNP_Vac_Chk_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Cathode_2nd_PNP_Vac_Chk_Execute_Timer = P_Cathode_2nd_PNP_Vac_Chk_Execute_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PNP_Vac_Chk_Mode_Timer = P_PNP_Vac_Chk_Mode_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Anode_1st_PNP_Vac_Check_Timer = P_Anode_1st_PNP_Vac_Check_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Cathode_1st_PNP_Vac_Check_Timer = P_Cathode_1st_PNP_Vac_Check_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Anode_2nd_PNP_Vac_Check_Timer = P_Anode_2nd_PNP_Vac_Check_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_Cathode_2nd_PNP_Vac_Check_Timer = P_Cathode_2nd_PNP_Vac_Check_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	P_MSA_Timer = P_MSA_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//===========================================================================================================================================================
// 1. Manual & IDLE 프로그램 활성화 
//===========================================================================================================================================================
if( P_PMAC_Current_Mode == F_Current_Manual)			//현재 Manual & Idle 상태일 경우
{
	L_PLC13_MSA_InterLock_Program_Active = F_Status_STARTING;							// MSA 인터락 프로그램 Start
	L_PLC13_Manual_Act_Management_Active = F_Status_STARTING;
	L_PLC13_Cycle_Stop_Act_Management_Active = F_Status_STOPPING						// Stop 프로그램 Stop
	L_PLC13_Manual_ARC_Act_Management_Active = F_Status_STARTING;						// 메뉴얼 강제 자동 ARC 시작 - [ 참조 : 25.12.23 매뉴얼 ARC 동작부 보완 ]
}
else if ( P_PMAC_Current_Mode == F_Current_Automatic )									//오토일 경우
{
	L_PLC13_MSA_InterLock_Program_Active = F_Status_STOPPING;							// MSA 인터락 프로그램 Stop
	L_PLC13_Manual_Act_Management_Active = F_Status_STOPPING;
	L_PLC13_Cycle_Stop_Act_Management_Active = F_Status_STARTING						// Stop 프로그램 Start
	L_PLC13_Manual_ARC_Act_Management_Active = F_Status_STOPPING;						// 메뉴얼 강제 자동 ARC 정지
}
else																					
{	
	L_PLC13_MSA_InterLock_Program_Active = F_Status_STOPPING							// MSA 인터락 프로그램 Stop
	L_PLC13_Manual_Act_Management_Active = F_Status_STOPPING;
	L_PLC13_Cycle_Stop_Act_Management_Active = F_Status_STOPPING;						// Stop 프로그램 Stop
	L_PLC13_Manual_ARC_Act_Management_Active = F_Status_STOPPING;						// 메뉴얼 강제 자동 ARC 해제 
}

// Total Push BTN 변수 대입 ( 감시창 용이 )
 P_BTN_MSA_Total_Value = N_BTN_MAS_Total_Value;			
 P_BTN_Align_Off_Total_Value = N_BTN_Align_Off_Total_Value;


//==============================================================================================================================================
//2-2  양음극 얼라인테이블 탈착 모드 버튼 이중 커맨드 처리 
//=============================================================================================================================================
if( P_BTN_Align_Off_Total_Value == N_TRUE )																			// 하나의 버튼만 눌렸을 시 N_TRUE
{
	// 대기위치 개별 메모리 구간
	call Sub_Unit_Memory_Status.individual_mode(F_Anode_1st_PNP,& P_Anode_1st_Unit_Status,&L_Pos_Mem_Rtn);			//음극 1차 PNP 대기 위치 확인 
	call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP,& P_Anode_2nd_Unit_Status,&L_Pos_Mem_Rtn);			//음극 2차 PNP 대기 위치 확인 
	call Sub_Unit_Memory_Status.individual_mode(F_Cathode_1st_PNP,&P_Cathode_1st_Unit_Status,&L_Pos_Mem_Rtn);		//양극 1차 PNP 대기 위치 확인
	call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP,& P_Cathode_2nd_Unit_Status,&L_Pos_Mem_Rtn);		//양극 2차 PNP 대기 위치 확인
	call Sub_Unit_Memory_Status.individual_mode(F_Final_Roll,&P_FinalRoll_Unit_Status,&L_Pos_Mem_Rtn);				//파이널롤 대기 위치 확인
	// 대기위치 확인
	if( P_Anode_1st_Unit_Status == F_1st_PNP_Init_Up_Pos && P_Anode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_Cathode_1st_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_Cathode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos  )			//대기 위치 확인
	{
		// 1. 음극 탈착 모드
		//[참조 : 260724 2차 클리닝 위치 이동, 얼라인 탈착 모드 시퀀스 수정 ]
		//[참조 : 260116 페이징 안된 모터 j/ 막기]
		if( M_Func_BTN.Anode_Align_Take_OFF == 1 && M_Func_BTN.Anode_Align_Take_OFF != L_Old_BTN_Align_AN_Take_OFF )				// 상승엣지
		{
			if( (Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound) )
			{
				M_Func_BTN.Anode_Align_Take_OFF = 0;																			// 푸쉬버튼이면 초기화가 필요 없지만 일단 넣자
				P_Align_Take_Off_Cmd(N_Align_AN_Take_Off) = F_Command_Start;											//음극 얼라인 테이블 탈착 모드 커멘드 Start
				P_Align_Take_Off_BTN_ON = N_TRUE;
			}
		}
		//2. 양극 탈착 모드 
		//[참조 : 260116 페이징 안된 모터 j/ 막기]
		else if( M_Func_BTN.Cathode_Align_Take_OFF == 1 && M_Func_BTN.Cathode_Align_Take_OFF != L_Old_BTN_Align_CA_Take_OFF  )			// 상승엣지 
		{
			if((Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound))
			{
				M_Func_BTN.Cathode_Align_Take_OFF = 0;																			// 푸쉬버튼이면 초기화가 필요 없지만 일단 넣자
				P_Align_Take_Off_Cmd(N_Align_CA_Take_Off) = F_Command_Start;											//양극 얼라인 테이블 탈착 모드 커멘드 Start
				P_Align_Take_Off_BTN_ON = N_TRUE;
			}
		}
	}
}	
L_Old_BTN_Align_AN_Take_OFF = M_Func_BTN.Anode_Align_Take_OFF;					// Old Data
L_Old_BTN_Align_CA_Take_OFF = M_Func_BTN.Cathode_Align_Take_OFF;					// Old Data

//============================================================================================================================================== //
// 2-3. Stop 동작 커맨드 감시 부분 _ 동작 커맨드 관리 -> 시퀀스에서 동작 살리면 
//==============================================================================================================================================
// 2.3.1 동작 커맨드 감시 부분 _ 동작 커맨드 관리 -> 시퀀스에서 동작 살리면 
if ( L_PLC13_Manual_Act_Management_Active == F_Status_STARTING )
{
	// 2.3.1.1 동작 커맨드 감시 _ 동작 커맨드 서치 (동작 활성화)
	P_Except_Return_Array(N_Vision_Manual_Management_RTN) = 0;
	call Subprog_Mainprocess_VISION_Manual_Act_Module.Management(&P_Except_Return_Array(N_Vision_Manual_Management_RTN))

	if ( P_Except_Return_Array(N_Vision_Manual_Management_RTN) != N_TRUE )
	{
		// 동작 이상 알람 발생
	}
}
IF ( L_PLC13_Cycle_Stop_Act_Management_Active == F_Status_STARTING )
{
	// 2.3.1.2 동작 커맨드 감시 _ 동작 커맨드 서치 (동작 활성화)
	P_Except_Return_Array(N_PLC13_Sub_Cycle_Stop_Act_Management_RTN) = 0;
	call Subprog_Mainprocess_Cycle_Stop_Act_Module.Management(&P_Except_Return_Array(N_PLC13_Sub_Cycle_Stop_Act_Management_RTN))
	if ( P_Except_Return_Array(N_PLC13_Sub_Cycle_Stop_Act_Management_RTN) != N_TRUE )
	{
		// 동작 이상 알람 발생
	}
}
IF ( L_PLC13_Manual_ARC_Act_Management_Active == F_Status_STARTING ) 
{
		// 2.3.1.3 동작 커맨드 감시 _ 동작 커맨드 서치 (동작 활성화) - [ 참조 : 25.12.23 매뉴얼 ARC 동작부 보완 ]
	P_Except_Return_Array(N_PLC13_Manual_ARC_Management_RTN) = 0;
	call Subprog_Mainprocess_Manual_ARC_Act_Module.Management(&P_Except_Return_Array(N_PLC13_Manual_ARC_Management_RTN))
	IF ( P_Except_Return_Array(N_PLC13_Manual_ARC_Management_RTN) != N_TRUE )
	{
		// 동작 이상 알람 발생
	}
}

								
