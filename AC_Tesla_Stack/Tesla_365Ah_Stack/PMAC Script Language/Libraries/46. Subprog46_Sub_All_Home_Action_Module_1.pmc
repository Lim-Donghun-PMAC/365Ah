	// 1.1.3) 동작 정지 타임아웃 시간 멤버 정보 업데이트 
	sub:Group_Action_Stop_CHK_Time_Update( Group, &Result )	 
		switch( Group )
		{// 인자값으로 받아온 Group Index값으로 그룹에 대한 정보를 갱신한다.
			case 1: //Group 1 : 그룹1 배열변수에 담긴 정보를 동작정보 배열변수에 대입. ( 레시피 형태로 변환예정 )
				P_AH_Act_Stop_Time(0) = P_Recipe_G1_AH_Action_Stop_Time_Type_1(0)			// 그룹1의 멤버0은 #1    타임아웃 시간 업데이트
				P_AH_Act_Stop_Time(1) = P_Recipe_G1_AH_Action_Stop_Time_Type_1(1)			// 그룹1의 멤버1은 #2    타임아웃 시간 업데이트
				P_AH_Act_Stop_Time(2) = P_Recipe_G1_AH_Action_Stop_Time_Type_1(2)			// 그룹1의 멤버2은 #3    타임아웃 시간 업데이트
