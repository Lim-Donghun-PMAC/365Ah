global P_ECAT_MNTR_Bit =0;
global P_Local_MNTR_Bit= 0;
open subprog AH_Func(void)

sub: AH_Motor_State_Chk(&AH_Motor_State_Chk_RTN)							// 시퀀스 종류 노드 선택
AH_Motor_State_Chk_RTN = 0;
// 생각필요 : 적층에 관련이 없는 모터는 home chk 변수가 꺼졌어도 그 부분만 home 잡으면서 home chk변수를 살릴지 
// → 일단은 하나라도 꺼지면 home chk변수 없다는 가정하에 전부 홈 

#ifdef F_Def_Stack_NRT_DryRun
	AH_Motor_State_Chk_RTN = N_NRT_Dry_Enable;				// NRT 용 드라이런 홈
#else

P_ECAT_MNTR_Bit = ECAT_All_Chk_Complete;
P_Local_MNTR_Bit = Local_All_Chk_Complete;

if( P_Stack_Judgement_Memory == N_TRUE )			// 적층여부판단
	AH_Motor_State_Chk_RTN = N_JellyRoll_Enable;	// 적층중임 리턴 == 1
else
{
	if( Local_All_Chk_Complete & ECAT_All_Chk_Complete )	// 매크로함수 설정 [ 참조 : CPU 최적화 진행 ]
	{
		//if( P_Stack_Judgement_Memory == N_TRUE )			// 적층여부판단
		//	AH_Motor_State_Chk_RTN = N_JellyRoll_Enable;	// 적층중임 리턴 == 1
		//else
			AH_Motor_State_Chk_RTN = N_JellyRoll_Disable;	// 비적층중 리턴 == 2
	}
	else
	{	
		P_FR_Sheet_Paper_Home_Chk = 0;
		// [참 조 : NG PNP 위치 센서 추가 하여 언로더 간섭 여부 회피 2026.04.16]
		//if(	M_X_Cathode_NG_PNP_Location_Sensor == 1 )		// 양극 NG PNP 위치감지 센서가 켜져있다면, 얼라인과 NG 박스 사이에 존재하므로 언로더 간섭없음
		//	AH_Motor_State_Chk_RTN = N_New_Non_Homing_CHK;		// 홈체크 == 3
		//else												// 양극 ng pnp가 얼라인 또는 ng 박스에 있다는 말이므로 언로더 z축이 상승해있을 가능성이 있음
			AH_Motor_State_Chk_RTN = N_New_Non_Homing_CHK2;		// 홈체크 == 4
		
		// [참조 26.09.24 : 전체 홈 시퀀스 수정]
		// 언로더, 양극 2차 PNP, NG PNP 위치에 따라 홈 순서 변경
		// 언로더 X가 스택 진입전 기준으로 앞/뒤
		if( P_Motor_Current_Pos(N_UNLOADER_X) > P_Recipe_M46_POS(2) + 30) // 언로더 X축이 스택 위치쪽
		{
			P_Home_First_Move = 1;
		}
		else if(P_Motor_Current_Pos(N_UNLOADER_X) < P_Recipe_M46_POS(2) + 30)	//언로더 X축이 대기위치쪽  
		{
			// Z축 먼저 내릴 수 있음
			// T축이 대기위치 보다 + 방향일 경우
			if( P_Motor_Current_Pos(N_UNLOADER_T) > P_Recipe_M48_POS(1) + 1 && P_Motor_Current_Pos(N_UNLOADER_T) < P_Recipe_M48_POS(2) - 3)
			{
				P_Home_First_Move = 3;
			}
			else if(P_Motor_Current_Pos(N_UNLOADER_T) < P_Recipe_M48_POS(2) + 3 && P_Motor_Current_Pos(N_UNLOADER_T) > P_Recipe_M48_POS(2) - 3)
			{
				// 인계위치라 2차 언로더와 맞물려 있을 가능 성이 있음
				// 고민이 필요해
				P_PMAC_Commands = F_Command_Stop;
				P_Stop_Cmd_Origin = 180;
			}
			else
			{
				P_Home_First_Move = 2;
			}
		}

		// [ 참조 : 260910 전체 홈 진행시 파이널롤러 X,Z축 시트페이퍼 X축 대기위치 확인 ]
		if(P_PMAC_Homing_CHK(N_FINAL_ROLL_X) == 1 && (P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Recipe_M12_POS(1) - 0.2 && P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(1) + 0.2))
		{
			P_FR_Sheet_Paper_Home_Chk |= $1;
		}
		else
		{
			P_FR_Sheet_Paper_Home_Chk = 0;
		}
		if(P_PMAC_Homing_CHK(N_FINAL_ROLL_Z) == 1 && (P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(1) - 0.2 && P_Motor_Current_Pos(N_FINAL_ROLL_Z) < P_Recipe_M13_POS(1) + 0.2))
		{
			P_FR_Sheet_Paper_Home_Chk |= $2;
		}
		else
		{
			P_FR_Sheet_Paper_Home_Chk = 0;
		}
		if(P_PMAC_Homing_CHK(N_SHEET_PAPER_X) == 1 && (P_Motor_Current_Pos(N_SHEET_PAPER_X) > P_Recipe_M35_POS(1) - 0.2 && P_Motor_Current_Pos(N_SHEET_PAPER_X) < P_Recipe_M35_POS(1) + 0.2))
		{
			P_FR_Sheet_Paper_Home_Chk |= $4;
		}
		else
		{
			P_FR_Sheet_Paper_Home_Chk = 0;
		}
	}
		
}
#endif

// while 문 돌리지 말고 매크로함수 이용해서 확인하자.
return;


sub: Stop_Action(void)	// cycle stop [ 참조 : 2025.08.18 홈 시퀀스 스탑 보안 ]

// 홈 진행중이면, C 쪽 매트릭스가 진행될수도 있으므로, C쪽 매트릭스 Step 0으로 보내는 변수 추가.
// 조그 j/ 명령을 일괄로 뿌려서 모든 모터들이 멈출 수 있게 함
P_All_Home_Stop_Cmd = N_TRUE;	// P_Home_Command(All) = Stop Cmd
//[참조 : 260116 페이징 안된 모터 j/ 막기]
P_Servo_ON_MNTR8++
if( Motor[1].phasefound == 1 )
	cmd"#1j/"
else
	P_Phasing_Err2(1)++

if( Motor[2].phasefound == 1 )
	cmd"#2j/"
else
	P_Phasing_Err2(2)++

if( Motor[3].phasefound == 1 )
	cmd"#3j/"
else
	P_Phasing_Err2(3)++

if( Motor[4].phasefound == 1 )
	cmd"#4j/"
else
	P_Phasing_Err2(4)++

//cmd"#1..48j/";					// Motor Jog/
cmd"#5..48j/";					// Motor Jog/

return;

close



