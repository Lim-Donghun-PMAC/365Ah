				P_AH_Action_Type(13) = P_Recipe_G1_Action_Type_Type_1(13)				// 그룹1의 멤버12는 #14
				P_AH_Action_Type(14) = P_Recipe_G1_Action_Type_Type_1(14)				// 그룹1의 멤버13는 #15
				P_AH_Action_Type(15) = P_Recipe_G1_Action_Type_Type_1(15)				// 그룹1의 멤버15는 #16

				//P_AH_Group_Max_Num = 5;		
				Result = N_AH_TRUE;		// 리턴값 반환. ( 성공 )
			break;

			case 2: //Group 2 : 그룹2 배열변수에 담긴 정보를 동작정보 배열변수에 대입.
				P_AH_Action_Type(0) = P_Recipe_G2_Action_Type_Type_1(0) 				// 그룹2의 멤버0은 #1// 동작타입 없음 
				P_AH_Action_Type(1) = P_Recipe_G2_Action_Type_Type_1(1) 				// 그룹2의 멤버1은 #2// +회피동작 
				P_AH_Action_Type(2) = P_Recipe_G2_Action_Type_Type_1(2) 				// 그룹2의 멤버2은 #3// -회피동작 
				P_AH_Action_Type(3) = P_Recipe_G2_Action_Type_Type_1(3) 				// 그룹2의 멤버3은 #4// IO On/Off.
				P_AH_Action_Type(4) = P_Recipe_G2_Action_Type_Type_1(4) 				// 그룹2의 멤버4은 #5// 동작타입 없음 
				P_AH_Action_Type(5) = P_Recipe_G2_Action_Type_Type_1(5) 				// 그룹2의 멤버5은 #6// 동작타입 없음 
				P_AH_Action_Type(6) = P_Recipe_G2_Action_Type_Type_1(6) 				// 그룹2의 멤버6은 #7// 동작타입 없음 
				P_AH_Action_Type(7) = P_Recipe_G2_Action_Type_Type_1(7) 				// 그룹2의 멤버7은 #8// 동작타입 없음 
				P_AH_Action_Type(8) = P_Recipe_G2_Action_Type_Type_1(8) 				// 그룹2의 멤버8은 #9// 동작타입 없음 
				P_AH_Action_Type(9) = P_Recipe_G2_Action_Type_Type_1(9) 				// 그룹2의 멤버9은 #10// 동작타입 없음 
				P_AH_Action_Type(10) = P_Recipe_G2_Action_Type_Type_1(10)				// 그룹2의 멤버9는 #11// 동작타입 없음 
				P_AH_Action_Type(11) = P_Recipe_G2_Action_Type_Type_1(11)				// 그룹2의 멤버10는 #12// 동작타입 없음
				P_AH_Action_Type(12) = P_Recipe_G2_Action_Type_Type_1(12)				// 그룹2의 멤버11는 #13
				P_AH_Action_Type(13) = P_Recipe_G2_Action_Type_Type_1(13)				// 그룹2의 멤버12는 #14
				P_AH_Action_Type(14) = P_Recipe_G2_Action_Type_Type_1(14)				// 그룹2의 멤버13는 #15
				P_AH_Action_Type(15) = P_Recipe_G2_Action_Type_Type_1(15)				// 그룹2의 멤버15는 #16	
				//P_AH_Group_Max_Num = 5;				
				Result = N_AH_TRUE;		// 리턴값 반환. ( 성공 )
			break; 

			case 3: //Group 3 : 그룹2 배열변수에 담긴 정보를 동작정보 배열변수에 대입.
				P_AH_Action_Type(0) = P_Recipe_G3_Action_Type_Type_1(0) 				// 그룹3의 멤버0은 #1// 동작타입 없음 
				P_AH_Action_Type(1) = P_Recipe_G3_Action_Type_Type_1(1) 				// 그룹3의 멤버1은 #2// +회피동작 
				P_AH_Action_Type(2) = P_Recipe_G3_Action_Type_Type_1(2) 				// 그룹3의 멤버2은 #3// -회피동작 
				P_AH_Action_Type(3) = P_Recipe_G3_Action_Type_Type_1(3) 				// 그룹3의 멤버3은 #4// IO On/Off.
				P_AH_Action_Type(4) = P_Recipe_G3_Action_Type_Type_1(4) 				// 그룹3의 멤버4은 #5// 동작타입 없음 
				P_AH_Action_Type(5) = P_Recipe_G3_Action_Type_Type_1(5) 				// 그룹3의 멤버5은 #6// 동작타입 없음 
				P_AH_Action_Type(6) = P_Recipe_G3_Action_Type_Type_1(6) 				// 그룹3의 멤버6은 #7// 동작타입 없음 
				P_AH_Action_Type(7) = P_Recipe_G3_Action_Type_Type_1(7) 				// 그룹3의 멤버7은 #8// 동작타입 없음 
				P_AH_Action_Type(8) = P_Recipe_G3_Action_Type_Type_1(8) 				// 그룹3의 멤버8은 #9// 동작타입 없음 
				P_AH_Action_Type(9) = P_Recipe_G3_Action_Type_Type_1(9) 				// 그룹3의 멤버9은 #10// 동작타입 없음 
				P_AH_Action_Type(10) = P_Recipe_G3_Action_Type_Type_1(10)				// 그룹3의 멤버9는 #11// 동작타입 없음 
				P_AH_Action_Type(11) = P_Recipe_G3_Action_Type_Type_1(11)				// 그룹3의 멤버10는 #12// 동작타입 없음
				P_AH_Action_Type(12) = P_Recipe_G3_Action_Type_Type_1(12)				// 그룹3의 멤버11는 #13
				P_AH_Action_Type(13) = P_Recipe_G3_Action_Type_Type_1(13)				// 그룹3의 멤버12는 #14
				P_AH_Action_Type(14) = P_Recipe_G3_Action_Type_Type_1(14)				// 그룹3의 멤버13는 #15
				P_AH_Action_Type(15) = P_Recipe_G3_Action_Type_Type_1(15)				// 그룹3의 멤버15는 #16
				//P_AH_Group_Max_Num = 5;				
				Result = N_AH_TRUE;		// 리턴값 반환. ( 성공 )
			break; 

			case 4: //Group 4 : 그룹2 배열변수에 담긴 정보를 동작정보 배열변수에 대입.
				P_AH_Action_Type(0) = P_Recipe_G4_Action_Type_Type_1(0) 				// 그룹4의 멤버0은 #1// 동작타입 없음 
				P_AH_Action_Type(1) = P_Recipe_G4_Action_Type_Type_1(1) 				// 그룹4의 멤버1은 #2// +회피동작 
				P_AH_Action_Type(2) = P_Recipe_G4_Action_Type_Type_1(2) 				// 그룹4의 멤버2은 #3// -회피동작 
				P_AH_Action_Type(3) = P_Recipe_G4_Action_Type_Type_1(3) 				// 그룹4의 멤버3은 #4// IO On/Off.
				P_AH_Action_Type(4) = P_Recipe_G4_Action_Type_Type_1(4) 				// 그룹4의 멤버4은 #5// 동작타입 없음 
				P_AH_Action_Type(5) = P_Recipe_G4_Action_Type_Type_1(5) 				// 그룹4의 멤버5은 #6// 동작타입 없음 
				P_AH_Action_Type(6) = P_Recipe_G4_Action_Type_Type_1(6) 				// 그룹4의 멤버6은 #7// 동작타입 없음 
				P_AH_Action_Type(7) = P_Recipe_G4_Action_Type_Type_1(7) 				// 그룹4의 멤버7은 #8// 동작타입 없음 
				P_AH_Action_Type(8) = P_Recipe_G4_Action_Type_Type_1(8) 				// 그룹4의 멤버8은 #9// 동작타입 없음 
				P_AH_Action_Type(9) = P_Recipe_G4_Action_Type_Type_1(9) 				// 그룹4의 멤버9은 #10// 동작타입 없음 
				P_AH_Action_Type(10) = P_Recipe_G4_Action_Type_Type_1(10)				// 그룹4의 멤버9는 #11// 동작타입 없음 
				P_AH_Action_Type(11) = P_Recipe_G4_Action_Type_Type_1(11)				// 그룹4의 멤버10는 #12// 동작타입 없음
				P_AH_Action_Type(12) = P_Recipe_G4_Action_Type_Type_1(12)				// 그룹4의 멤버11는 #13
				P_AH_Action_Type(13) = P_Recipe_G4_Action_Type_Type_1(13)				// 그룹4의 멤버12는 #14
				P_AH_Action_Type(14) = P_Recipe_G4_Action_Type_Type_1(14)				// 그룹4의 멤버13는 #15
				P_AH_Action_Type(15) = P_Recipe_G4_Action_Type_Type_1(15)				// 그룹4의 멤버15는 #16
				//P_AH_Group_Max_Num = 5;		
