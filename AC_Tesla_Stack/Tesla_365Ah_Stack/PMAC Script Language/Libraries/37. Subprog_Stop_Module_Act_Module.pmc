// 사이클 스탑 모듈 



//=========================================================
//첫번째 시퀀스 Motion Prog OFF , Time Base Off, Motion_Command_Init
//=========================================================
sub: CycleStop_1st_Action(Mode,&rtn)
rtn = 0;
if(P_Module_Cycle_Stop_Act_State_Machine_Array(N_CycleStop_1st_Action) == N_Ready_Step )							// 얼라인 MSA 1차 PNP 대기 위치 -> 벨트 이동 Ready Step 
{
	if ( Mode == N_Normal_Status_Sequence || Mode == N_Sepa_Consume_Status_Sequence || Mode == N_Dryrun_Status_Sequence )
	{
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_1st_Action) == 0 )
		{
			P_PLC13_Cycle_Stop_Return_Array(N_Com_Master_Motion_Program_OFF_Complete_RTN) = 0;	// 0.1) 마스터 모션 off 함수 반환값 초기화	
			P_PLC13_Cycle_Stop_Return_Array(N_Com_Timbase_OFF_Complete_RTN) = 0;					// 0.2) 타임 베이스 off 함수 반환값 초기화
			P_PLC13_Cycle_Stop_Return_Array(N_Com_Slave_Motion_Common_Init_Complete_RTN) = 0;		// 0.3) Slave Motion Command 초기화 함수 반환값 초기화

			call Sub_Common_Function.Master_Motion_Program_OFF(&P_PLC13_Cycle_Stop_Return_Array(N_Com_Master_Motion_Program_OFF_Complete_RTN));
			call Sub_Common_Function.Timbase_OFF(&P_PLC13_Cycle_Stop_Return_Array(N_Com_Timbase_OFF_Complete_RTN));
			call Sub_Common_Function.Slave_Motion_Command_Init(&P_PLC13_Cycle_Stop_Return_Array(N_Com_Slave_Motion_Common_Init_Complete_RTN));
			callsub sub.New_Speed(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_CycleStop_Motor_New_Speed_RTN));

			if( P_PLC13_Cycle_Stop_Return_Array(N_Com_Master_Motion_Program_OFF_Complete_RTN) & P_PLC13_Cycle_Stop_Return_Array(N_Com_Timbase_OFF_Complete_RTN) & P_PLC13_Cycle_Stop_Return_Array(N_Com_Slave_Motion_Common_Init_Complete_RTN) & P_PLC13_Cycle_Stop_Return_Array(N_Stop_CycleStop_Motor_New_Speed_RTN))
			{
				P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_1st_Action) = 1;
			}
		}
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_1st_Action) == 1 )
		{
			call Sub_Common_Function.Timbase_OFF_Check(&P_PLC13_Cycle_Stop_Return_Array(N_Com_Timbase_OFF_Check_Complete_RTN));

			if( P_Master_Motion_Program_Flag == 0 && P_PLC13_Cycle_Stop_Return_Array(N_Com_Timbase_OFF_Check_Complete_RTN) == 1 )
			{ 
				P_Module_Cycle_Stop_Act_Complete_Bit(N_CycleStop_1st_Action) = 1;															// 동작 완료 Bit On.
				rtn = N_COMPLETE;	
			}
		}
	}
}
return;

//=========================================================
//두번째 시퀀스 New Speed 설정	
//=========================================================
sub: CycleStop_2nd_Action(Mode,&rtn)
rtn = 0;
if(P_Module_Cycle_Stop_Act_State_Machine_Array(N_CycleStop_2nd_Action) == N_Ready_Step )							// 얼라인 MSA 1차 PNP 대기 위치 -> 벨트 이동 Ready Step 
{
	if ( Mode == N_Normal_Status_Sequence || Mode == N_Sepa_Consume_Status_Sequence || Mode == N_Dryrun_Status_Sequence )
	{	
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_2nd_Action) == 0 )
		{
			callsub sub.Cathode_Anode_1st_Z_Ready_Move(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_Z_Ready_Move_RTN));
			
			if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_Z_Ready_Move_RTN) == 1 )
			{				
				P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_2nd_Action) = 1;
			}
		}
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_2nd_Action) == 1 )
		{
			callsub sub.Cathode_Anode_1st_Z_Ready_Move_Check(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_Z_Ready_Move_Check_RTN));

			if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_Z_Ready_Move_Check_RTN) )
			{
				P_Module_Cycle_Stop_Act_Complete_Bit(N_CycleStop_2nd_Action) = 1;															// 동작 완료 Bit On.
				rtn = N_COMPLETE;
			}
		}
	}
}
return;

//=========================================================
//얼라인 MSA 1차 PNP 대기 위치 -> 벨트 이동 Ready Step 	
//=========================================================
sub: CycleStop_3rd_Action(Mode,&rtn)
rtn = 0;
if(P_Module_Cycle_Stop_Act_State_Machine_Array(N_CycleStop_3rd_Action) == N_Ready_Step )							
{
	if ( Mode == N_Normal_Status_Sequence || Mode == N_Sepa_Consume_Status_Sequence || Mode == N_Dryrun_Status_Sequence )
	{
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_3rd_Action) == 0 )
		{
			callsub sub.Cathode_Anode_1st_T_Ready_Move(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_T_Ready_Move_RTN));
			
			if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_T_Ready_Move_RTN) == 1 )
			{
				P_Cycle_Stop_Delay_Time = Sys.Time

				P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_3rd_Action) = 1;
			}
		}
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_3rd_Action) == 1 )
		{
			if( Sys.Time > P_Cycle_Stop_Delay_Time + P_Cycle_Stop_Offset )
			{
				callsub sub.Cathode_Anode_1st_T_Ready_Move_Check(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_T_Ready_Move_Check_RTN));
				
				if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_1st_T_Ready_Move_Check_RTN) )
				{
					P_Module_Cycle_Stop_Act_Complete_Bit(N_CycleStop_3rd_Action) = 1;															// 동작 완료 Bit On.
					rtn = N_COMPLETE;
				}
			}
		}
	}
}
return;


//=========================================================
//// 네번째 시퀀스, 양,음극 ng pnp 대기위치
//=========================================================
sub: CycleStop_4th_Action(Mode,&rtn)
rtn = 0;
if(P_Module_Cycle_Stop_Act_State_Machine_Array(N_CycleStop_4th_Action) == N_Ready_Step )							
{
	if ( Mode == N_Normal_Status_Sequence || Mode == N_Sepa_Consume_Status_Sequence || Mode == N_Dryrun_Status_Sequence )
	{
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_4th_Action) == 0 )
		{
			callsub sub.Cathode_Anode_NG_PNP_Z_Ready_Move(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_Z_Ready_Move_RTN));

			if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_Z_Ready_Move_RTN) == 1 )
			{
				P_Cycle_Stop_Delay_Time = Sys.Time
				P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_4th_Action) = 1;
			}
		}
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_4th_Action) == 1 )
		{
			if( Sys.Time > P_Cycle_Stop_Delay_Time + P_Cycle_Stop_Offset )
			{
				callsub sub.Cathode_Anode_NG_PNP_Z_Ready_Move_Check(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_Z_Ready_Move_Check_RTN));

				if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_Z_Ready_Move_Check_RTN) == 1 )
				{
					P_Module_Cycle_Stop_Act_Complete_Bit(N_CycleStop_4th_Action) = 1;															// 동작 완료 Bit On.
					rtn = N_COMPLETE;
				}
			}
		}
	}
}
return;
		
//=========================================================
//5) 다섯번째 시퀀스, 양,음극 2차 pnp 대기위치
//=========================================================
sub: CycleStop_5th_Action(Mode,&rtn)
rtn = 0;
if(P_Module_Cycle_Stop_Act_State_Machine_Array(N_CycleStop_5th_Action) == N_Ready_Step )							
{
	if ( Mode == N_Normal_Status_Sequence || Mode == N_Sepa_Consume_Status_Sequence || Mode == N_Dryrun_Status_Sequence )
	{
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_5th_Action) == 0 )
		{
			callsub sub.Cathode_Anode_NG_PNP_T_Ready_Move(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_T_Ready_Move_RTN));

			if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_T_Ready_Move_RTN) == 1 )
			{
				P_Cycle_Stop_Delay_Time = Sys.Time
				P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_5th_Action) = 1;
			}
		}
		if( P_Stopping_CycleStop_Act_State_Machine(N_CycleStop_5th_Action) == 1 )
		{
			if( Sys.Time > P_Cycle_Stop_Delay_Time + P_Cycle_Stop_Offset )
			{
				callsub sub.Cathode_Anode_NG_PNP_T_Ready_Move_Check(&P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_T_Ready_Move_Check_RTN));

				if( P_PLC13_Cycle_Stop_Return_Array(N_Stop_Cathode_Anode_NG_PNP_T_Ready_Move_Check_RTN) == 1 )
				{
					P_Module_Cycle_Stop_Act_Complete_Bit(N_CycleStop_5th_Action) = 1;															// 동작 완료 Bit On.
					rtn = N_COMPLETE;
				}
			}
		}
	}
}
return;


