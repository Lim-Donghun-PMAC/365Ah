				P_AH_Act_Time(6) = P_Recipe_G1_AH_Action_Time_Type_1(6)				// 그룹1의 멤버6은 #7    타임아웃 시간 업데이트
				P_AH_Act_Time(7) = P_Recipe_G1_AH_Action_Time_Type_1(7)				// 그룹1의 멤버7은 #8    타임아웃 시간 업데이트
