open subprog Continuous_NG(void)		// 연속 NG 라이브러리 이재욱 추가_240503

//========================================================
// 음극 얼라인 NG
//========================================================
sub:Anode_Align_NG(Visoin_Result, Continuos_NG_Range)
local L_Save_Size = Continuos_NG_Range;
local L_Search_Count = 0;
local L_Detected_NG_Count = 0;
if( P_Anode_Align_Continuous_NG_Stop_Select == 0 )
{
	if( L_Save_Size > 0 )
	{
		while( L_Save_Size > 1 )
		{
			P_Anode_Align_NG_Array(L_Save_Size - 1) = P_Anode_Align_NG_Array(L_Save_Size - 2);
			L_Save_Size--;
		}
		P_Anode_Align_NG_Array(0) = Visoin_Result;
	}
	if ( Visoin_Result == N_Inspection_NG )
	{
		while( L_Search_Count < Continuos_NG_Range )
		{
			if( P_Anode_Align_NG_Array(L_Search_Count) == N_Inspection_NG )
			{
				L_Detected_NG_Count++;
			}
			L_Search_Count++;
		} 
		if( L_Detected_NG_Count >= P_Anode_Align_Continuous_NG_Recipe )	// 지정된 횟수보다 NG횟수가 커지면
		{
			//call Heap_Sort.Node_Insert();	
			P_Anode_Align_NG_Array(0), N_Queue_Max_Size = 0;				// 음극 얼라인 NG 횟수 초기화 
		}
	}
}
else
{
	P_Anode_Align_NG_Array(0),N_Queue_Max_Size = 0;	
}
return

//========================================================
// 양극 얼라인 NG
//========================================================
sub:Cathode_Align_NG(Visoin_Result, Continuos_NG_Range)
local L_Save_Size = Continuos_NG_Range;
local L_Search_Count = 0;
local L_Detected_NG_Count = 0;
if ( P_Cathode_Align_Continuous_NG_Stop_Select == 0 )
{
	if( L_Save_Size > 0 )
	{
		while( L_Save_Size > 1 )
		{
			P_Cathode_Align_NG_Array(L_Save_Size - 1) = P_Cathode_Align_NG_Array(L_Save_Size - 2);
			L_Save_Size--;
		}
		P_Cathode_Align_NG_Array(0) = Visoin_Result;
	}
	
	if ( Visoin_Result == N_Inspection_NG )
	{
		while( L_Search_Count < Continuos_NG_Range )
		{
			if( P_Cathode_Align_NG_Array(L_Search_Count) == N_Inspection_NG )
			{
				 L_Detected_NG_Count++;
			}
			L_Search_Count++;
		} 
		if( L_Detected_NG_Count >= P_Cathode_Align_Continuous_NG_Recipe )	// 지정된 횟수보다 NG횟수가 커지면
		{
			//call Heap_Sort.Node_Insert();
			
			P_Cathode_Align_NG_Array(0),N_Queue_Max_Size = 0;				// 양극 얼라인 NG 횟수 초기화 
		}
	}
}
else
{
	P_Cathode_Align_NG_Array(0),N_Queue_Max_Size = 0;
}
return

