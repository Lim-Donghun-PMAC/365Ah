// 극판 정보를 1Byte로 나타냄
#define Hex_Vision_Timeout			$1				// 0000 0000 0000 0001
#define Hex_Maint_NG				$2				// 0000 0000 0000 0010

#define Hex_Align_NG				$4				// 0000 0000 0000 0100

#define Hex_Align_OK				$8				// 0000 0000 0000 1000

#define Hex_Surface_NG				$10				// 0000 0000 0001 0000
#define Hex_Surface_OK				$20				// 0000 0000 0010 0000

#define Hex_Saved_Surface_Image		$40				// 0000 0000 0100 0000
#define Hex_Cell_Existence			$80				// 0000 0000 1000 0000

#define Hex_Stack_NG				$100			// 0000 0001 0000 0000
#define Hex_Stack_OK				$200			// 0000 0010 0000 0000

#define	Hex_NG_Masking				$117			// 0000 0001 0001 0111
#define	Hex_OK_Masking				$28				// 0000 0000 0010 1000

