//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 26.02.03
// 모듈화 홈프로그램 리뉴얼 
// 코드 제어 구조 일원화, 모듈화 홈 작업 진행 - [ 참조 : 26.02.03 홈 모듈화 프로그램 리뉴얼 ]


open plc 19
P_MNTR_PLC19_Task_Time(0) = Sys.Time;


// 로컬 타이머
Local L_PLC19_Time_Cycle_Up_Count_Start_Time;		// Plc[19].ldata.L[0]	시간 체크 시작 시간
Local L_PLC19_Time_Cycle_Up_Count_End_Time;			// Plc[19].ldata.L[1]	시간 체크 종료 시간
Local L_PLC19_Time_Cycle_Up_Count_Delta_Time;		// Plc[19].ldata.L[2]	시작과 종료 시간 사이의 시간
Local L_PLC19_Flag_Cycle_Up_Count_Init_Flag;		// Plc[19].ldata.L[3]	타이머 초기화 플래그
local L_Sub_Interval_Timer;							// Plc[19].ldata.L[4]	서브 프로그램 인터벌 타이머
local L_Sub_Set_Interval_Time=6;					// Plc[19].ldata.L[5]	서브 프로그램 리드 주기 타임
local L_Auto_Sub_Program_Active;					// Plc[19].ldata.L[6]	서브 프로그램 활성화

// 시퀀스 발생 변수 - HOME		
local L_ALL_Home_Seq_Command_Occurs;				// Plc[19].ldata.L[7]	ALL Home 시퀀스	발생 변수 
// Acting 동작 번호 - HOME

local L_All_Home_Seq_Data							// Plc[19].ldata.L[8]	All Home Acting	동작 번호		
// 액팅 동작 함수 - Home

local L_Module_Interval_Timer;						// Plc[19].ldata.L[9]	서브 프로그램 인터벌 타이머	

local L_Motor_Num;									//	plc[19].ldata.l[10]
local L_Rtn(5);										//	plc[19].ldata.l[11 ~ 15]
local L_Old_Motor_Home_Offset(5);					//	plc[19].ldata.l[16 ~ 20]
local L_ABS_PhaseFound_Timer(5);					//	plc[19].ldata.l[21 ~ 25]
local L_ABS_Interval_Time = 50;						//	plc[19].ldata.l[26]
local L_Ecat_M;										//	plc[19].ldata.l[27]
//=================================================================================================================================


//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_PLC19_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_PLC19_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_PLC19_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_PLC19_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 00.2) 시간 체크
if( L_PLC19_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_PLC19_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_PLC19_Time_Cycle_Up_Count_Delta_Time = (L_PLC19_Time_Cycle_Up_Count_End_Time - L_PLC19_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_PLC19_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_PLC19_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_PLC19_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	L_Sub_Interval_Timer = L_Sub_Interval_Timer + L_PLC19_Time_Cycle_Up_Count_Delta_Time;
	P_PLC19_All_Home_Timer = P_PLC19_All_Home_Timer + L_PLC19_Time_Cycle_Up_Count_Delta_Time;						
	
	L_ABS_PhaseFound_Timer(N_1st_PnP_CA_T) = L_ABS_PhaseFound_Timer(N_1st_PnP_CA_T) + L_PLC19_Time_Cycle_Up_Count_Delta_Time;
	L_ABS_PhaseFound_Timer(N_1st_PnP_AN_T) = L_ABS_PhaseFound_Timer(N_1st_PnP_AN_T) + L_PLC19_Time_Cycle_Up_Count_Delta_Time;
	L_ABS_PhaseFound_Timer(N_2nd_PnP_CA_T) = L_ABS_PhaseFound_Timer(N_2nd_PnP_CA_T) + L_PLC19_Time_Cycle_Up_Count_Delta_Time;
	L_ABS_PhaseFound_Timer(N_2nd_PnP_AN_T) = L_ABS_PhaseFound_Timer(N_2nd_PnP_AN_T) + L_PLC19_Time_Cycle_Up_Count_Delta_Time;

	L_PLC19_Time_Cycle_Up_Count_Start_Time = L_PLC19_Time_Cycle_Up_Count_End_Time;
	L_PLC19_Time_Cycle_Up_Count_Delta_Time = 0;
}

// Motor[x].PhaseFound Bit --> 페이지 파운드 비트가 없다면, 커맨드 초기화
// 선행으로 읽게 해서 cmd 막기
//if((Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound) == 0 )
//{
//	// 1차2차PnP PhaseFound Bit가 0이라면 Home Cmd = 0;
//	P_Resetting_All_Home_Command = F_Command_NonCommand;
//}

/*
	// 1st, NG, 2nd 움직임에 있어서는 간섭 여부 판단 필요!

	<적층중(H)>N_JellyRoll_Enable							<홈체크x(H)> N_New_Non_Homing_CHK ( NG PnP 중간 위치 )							<홈체크x(H)> N_New_Non_Homing_CHK2 ( NG PnP 중간위치 X )
	1. 양,음극 1st(H)										1. SheetPaper(-), 스텍테이블, 파이널롤러Z, 양,음극 1st Z(-), 양,음극 2nd Z(-)		1. SheetPaper(-), 스텍테이블, 파이널롤러Z, 양,음극 1st Z(-), 양,음극 2nd Z(-)
	2. 양,음극 NG(H)											2. 클램프Y(H), 양,음극 1st(H)														2. 클램프Y(H), 양,음극 1st(H)
	3. 양,음극 2nd(H) , 양,음극 피커T(H)						3. 양,음극 NG(H)																	3. 언로더X(H),피커(H)
	4. 언로더X(H)											4. 양,음극 2nd(H) 																4. 언로더T(H),얼라인 X,Y,T(H)
	5. 언로더T(H)											5. 언로더X(H),피커(H)															5. 양,음극Z clamp Z,언로더 그립(if)
	6. 언로더 그립(if)										6. 언로더T(H),얼라인 X,Y,T(H)														6. 언로더 Z(H)
	7. 언로더Z(H)											7. 양,음극Z clamp Z (H), 언로더 그립(if)											7. 양,음극 NG(H)
															8. 언로더 Z(H), FR X(H)															8. 양,음극 2nd(H)
															9.  FR Z(H),스텍테이블(H), SheetPaper(H)											9.  FR X(H)
																																			10. FR Z(H),스텍테이블(H), SheetPaper(H)
															
	<비적층중(H)> N_JellyRoll_Disable
	1. 클램프(H), if 파이널롤러Z (-) 	
	2. SheetPaper(H),양,음극 1st(H)	
	3. 양,음극 NG(H)		
	4. 양,음극 2nd(H) , 양,음극 피커T(H)						
	5. 언로더X(H)						
	6. 언로더T(H), 파이널롤러X(H)			
	7. 언로더 그립(if)				
	8. 언로더Z(H) , 스텍테이블(H), 파이널롤러Z(H)
	
																			
																			
	
	< 드라이런 NRT 용 H > N_NRT_Dry_Enable 
	1. 1. 스텍테이블, 파이널롤러Z, 양,음극 1st Z(-) 
	2. 클램프Y(H) 클램프 Y는 Minus리밋이없음
	3. 양,음극 1st,2nd Z(H)
	4. 양,음극 1st ,2nd T(H)
	5. 양,음극 clamp (H) , FR X ( H )
	6. FR Z (H), Picker T (H)
	7. Main Z (H)
*/

//================================================================================================================================================================================
// 0) Main 시퀀스 실행부 
//================================================================================================================================================================================
// 0.1. Main Process
IF ( L_Sub_Interval_Timer > L_Sub_Set_Interval_Time )
{
	L_Sub_Interval_Timer = 0;		// 인터벌 타이머 초기화

	// 전체 홈은 Manual 때만 가능
	IF ( P_PMAC_Current_Mode == F_Current_Manual )
		L_Auto_Sub_Program_Active = F_Status_STARTING;								
	ELSE
		L_Auto_Sub_Program_Active = F_Status_STOPPING;
	

	// 0.3. 오토 메인 프로그램 - 상태별 서브 프로그램 실행
	IF ( L_Auto_Sub_Program_Active == F_Status_STARTING )
	{		
		//================================================================================================================================================================================
		// [Manual All Home Part]
		IF ( P_Resetting_All_Home_Command == F_Command_Start )								// 0)	All Home 모듈 실행 - PLC 1번에서 조건보고 실행 
		{																				
			P_Resetting_All_Home_Command = 0;												// 0.1) All Home 모듈 - 커맨드 초기화 (재진입 방지) 
			P_EXECUTE_Status_Prod_Sequence(N_All_Home_Module_Mode) = F_Status_STARTING;		// 0.2) All Home 모듈 - 시작 상태 대입
																								
			P_PLC19_All_Home_Status = N_TRUE;												// 0.3) All Home 모듈 - 시퀀스 모듈 실행 상태
			L_ALL_Home_Seq_Command_Occurs = 1;												// 0.4) All Home 모듈 - 시퀀스 커맨드 발생 변수
		}
		else if( P_Resetting_All_Home_Command == F_Command_Stop )
		{
			P_Resetting_All_Home_Command = 0;
			P_PLC19_All_Home_State_Machine = N_Error_Step;
		}
	}
	// 0.3.2. 메인 프로그램 정지
	ELSE IF ( L_Auto_Sub_Program_Active == F_Status_STOPPING )
	{
	}
}

//========================================================================================================================================================
// 1) Manual - All_Home 모듈
//========================================================================================================================================================
// 1.1 All_Home 모듈   구동 시퀀스 - TRUE 일 경우 실행
IF ( P_PLC19_All_Home_Status == N_TRUE )							
{
	// 1.1.1 All_Home 모듈  시퀀스 발생 변수
	IF ( L_ALL_Home_Seq_Command_Occurs == 1 )							
	{		
		// 1.1.1.1) All_Home 모듈  인덱스 초기화 
		P_AH_Home_Status = F_Status_STARTING;							// Manual - All_Home 진행 상태 업데이트.
		P_PLC19_All_Home_Seq_Index = 0;										
		P_Except_Return_Array(N_PLC19_All_Home_Set_Seq_Occurs_RTN) = 0;	

		P_PLC19_All_Home_Set_Mode_Return = 0;
		call AH_Func.AH_Motor_State_Chk(&P_PLC19_All_Home_Set_Mode_Return);			// 홈 모드 탐색할 것 하기 ↓ IF문 조건문은 가독성이 좋도록 일부로 모드 3개를 풀어서 작성

		IF ( P_PLC19_All_Home_Set_Mode_Return == N_JellyRoll_Enable || P_PLC19_All_Home_Set_Mode_Return == N_JellyRoll_Disable || P_PLC19_All_Home_Set_Mode_Return == N_New_Non_Homing_CHK || P_PLC19_All_Home_Set_Mode_Return == N_New_Non_Homing_CHK2 || P_PLC19_All_Home_Set_Mode_Return == N_NRT_Dry_Enable )
		{
			// 1.1.1.2) 현재 모드에 맞는 배열값 셋
			call Sub_Manual_All_Home_Prod_Sequnce.Set_Manual_All_Home(P_PLC19_All_Home_Set_Mode_Return,&P_Except_Return_Array(N_PLC19_All_Home_Set_Seq_Occurs_RTN))	 
			IF ( P_Except_Return_Array(N_PLC19_All_Home_Set_Seq_Occurs_RTN) == N_TRUE )
			{
				L_ALL_Home_Seq_Command_Occurs = 0;										// 커맨드 초기화
				//P_Execute_First_Sepa_Mode_Tact_Time_Array(0),20 = 0;					// Manual - All_Home  시퀀스 총 Tact Time 초기화.	
				call All_Home_Act_Module.Init();
				P_PLC19_All_Home_State_Machine = N_Ready_Step;							// Manual - All_Home  구동 준비 스텝으로 이동		
			}
			// 1.1.1.3) 리턴값 오류시 - Error Step 이동
			ELSE
			{
				L_ALL_Home_Seq_Command_Occurs = 0;								// Manual - All_Home  커맨드 초기화
				P_PLC19_All_Home_State_Machine = N_Error_Step;					// Manual - All_Home  모듈 구동 준비 스텝으로 이동
			}
		}
	}
//=====================================================================================//
// 1.1) All_Home 모듈  - READY STEP
//=====================================================================================//
	// 1.1.2 All_Home 모듈  모듈 시퀀스 _ 동작 준비 스텝
	IF ( P_PLC19_All_Home_State_Machine == N_Ready_Step )
	{
		// 1.1.2.0 시퀀스 Tact Time 측정.
		P_PLC19_All_Home_Timer = 0;
		// 1.1.2.1 시퀀스 인덱스 증가 _ 시퀀스 실행시킬 인덱스 번호 증가		
		P_AH_Home_Status = F_Status_EXECUTE;					
		P_PLC19_All_Home_Seq_Index = P_PLC19_All_Home_Seq_Index + 1;

		// 1.1.2.2 시퀀스 겟 _ 실행시킬 동작 불러오기 
		call Sub_Manual_All_Home_Prod_Sequnce.Management_All_Home(P_PLC19_All_Home_Set_Mode_Return,P_PLC19_All_Home_Seq_Index,&L_All_Home_Seq_Data,&P_Except_Return_Array(N_PLC19_All_Home_Manage_Get_RTN))		
															
		// 1.1.2.3 시퀀스 겟 결과 _ 실행 가능 or 시퀀스 완료 or 오류 시퀀스 동작 실행 (실행 인터락 포함)
		IF ( P_Except_Return_Array(N_PLC19_All_Home_Manage_Get_RTN) == N_TRUE )																													
		{
			P_Except_Return_Array(N_PLC19_All_Home_Exe_Seq_RTN) = 0;

			call Sub_Manual_All_Home_Prod_Sequnce.Execute_All_Home(P_PLC19_All_Home_Set_Mode_Return, L_All_Home_Seq_Data,&P_Except_Return_Array(N_PLC19_All_Home_Exe_Seq_RTN) );
																																
			IF ( P_Except_Return_Array(N_PLC19_All_Home_Exe_Seq_RTN) == N_TRUE )		
			{																		
				P_PLC19_All_Home_State_Machine = N_Execute_Step;
				P_AH_Indvi_rtn(0),N_DIO_Last_Num = 0;										// 조건 확인 변수 초기화																									
			}
			else if( P_Except_Return_Array(N_PLC19_All_Home_Exe_Seq_RTN) == N_WAIT )		// Wait 구간 추가. ( 간섭여부 판단에 따라 개별 회피동작을 대기해야하므로 )
			{
				P_WAIT_INDEX = P_PLC19_All_Home_Seq_Index;									// 실제 걸려있는 WAIT 구간 INDEX
				P_PLC19_All_Home_Seq_Index = P_PLC19_All_Home_Seq_Index - 1;				// 인덱스를 -1 해주는 이유는 다시 태워야 하므로 ( 재귀할때 증가만 하면 안되므로 )
			}
			ELSE
			{																																		
				P_PLC19_All_Home_State_Machine = N_Error_Step;																						
			}
		}
		// 1.1.2.4. 시퀀스 완료 _ 시퀀스 완료
		ELSE IF ( P_Except_Return_Array(N_PLC19_All_Home_Manage_Get_RTN) == N_EXCEPT )																		
		{
			P_PLC19_All_Home_State_Machine = N_Complete_Step;																						
		}																																	
		// 1.1.2.5 시퀀스 에러 _ 시퀀스 실행 불가능 ( 실행 인터락에 걸림 )																		  
		ELSE																																			
		{
			P_PLC19_All_Home_State_Machine = N_Error_Step;																							
		}		
	}
//=====================================================================================//
// 1.2) All_Home 모듈  - EXECUTE STEP
//=====================================================================================//
	// 1.2.1. All_Home 모듈  모듈 시퀀스 _ 동작 실행중 스텝
	IF ( P_PLC19_All_Home_State_Machine == N_Execute_Step )																						
	{	
	
		P_Except_Return_Array(N_PLC19_All_Home_Pre_Seq_Complete_RTN) = 0;																					
		P_PLC19_All_Home_Self_Index = P_PLC19_All_Home_Seq_Index + 1;	
		
			Call Sub_Manual_All_Home_Prod_Sequnce.Precondition_All_Home(P_PLC19_All_Home_Set_Mode_Return,P_PLC19_All_Home_Self_Index,&P_Except_Return_Array(N_PLC19_All_Home_Pre_Seq_Complete_RTN))		
			IF ( P_Except_Return_Array(N_PLC19_All_Home_Pre_Seq_Complete_RTN) == N_TRUE )																	
			{																										
				P_PLC19_All_Home_Tact_Time_Array(P_PLC19_All_Home_Seq_Index) = P_PLC19_All_Home_Timer;															// Manual - All_Home  시퀀스 Tact Time 업데이트.
				P_PLC19_All_Home_Tact_Time_Array(0) = P_PLC19_All_Home_Tact_Time_Array(0) + P_PLC19_All_Home_Tact_Time_Array(P_PLC19_All_Home_Seq_Index);		// Manual - All_Home  시퀀스 총 Tact Time 업데이트.
				P_PLC19_All_Home_State_Machine = N_Ready_Step;																							
			}		
			IF ( P_All_Home_Module_Error == N_FALSE )													// 액팅 모듈 중 Error 처리가 될 경우. (TimeOut)		
			{
				P_All_Home_Module_Error = 0;															// 초기화.
				P_PLC19_All_Home_State_Machine = N_Error_Step;											// 모듈 정지.
			}
	}

//=====================================================================================//
// 1.3) All_Home 모듈  - Complte STEP
//=====================================================================================//
	// 1.3.1 All_Home 모듈  모듈 시퀀스 _ 동작 완료 스텝
	IF ( P_PLC19_All_Home_State_Machine == N_Complete_Step )
	{
		P_EXECUTE_Status_Prod_Sequence(N_All_Home_Module_Mode) = F_Status_COMPLETE;				// Manual - All_Home 모듈 상태 변경 _ 완료
		P_AH_Home_Status = F_Status_COMPLETE;													// Manual - All_Home 진행 상태 업데이트.
		P_PLC19_All_Home_Status = N_NoValue;													// Manual - All_Home 기능 off
		P_PLC19_All_Home_State_Machine = 0;														// Manual - All_Home 스텝 초기화	
	}
//=====================================================================================//
// 1.4) All_Home 모듈  - Error STEP
//=====================================================================================//
	// 1.4.1 All_Home 모듈 시퀀스 _ 에러 처리 스텝
	IF ( P_PLC19_All_Home_State_Machine == N_Error_Step )
	{
		call AH_Func.Stop_Action();
		P_EXECUTE_Status_Prod_Sequence(N_All_Home_Module_Mode) = F_Status_ABORTED;				// Manual - All_Home  모듈 상태 변경 _ 어볼트
		//P_PMAC_Commands = F_Command_Stop;														// Commands Stop 발생.	
		P_AH_Home_Status = F_Status_STOPPED;													// 세파 첫장모드 진행 상태 업데이트.
		P_PLC19_All_Home_Status = N_FALSE;														// 기능 실패
		P_PLC19_All_Home_State_Machine = 0;														// 스텝 초기화
	}
}
ELSE
{
	P_PLC19_All_Home_State_Machine = 0;															// Manual - All_Home  시퀀스 초기화
}

//===============================================================================================================================================================================================================================================================//
// 2) DD 모터 T축 Phase Found
//===============================================================================================================================================================================================================================================================//

// [참조 : 26.01.09 PWM Home 추가 ]
// 26.01.09 추가===================================================================================================================
// DD Motor Phase Found가 되어야 홈 진행 할 수 있도록 추가.
// 1. Motor[x].phasefound = 0 ;
// 2. cout x 0;
// 3. Motor[2].iabias = 0; 
// 4. Motor[2].ibbias = 1500;	>> b상 1500  천천히 증가 500ms마다 증가 500ms 쉬고
// 5. Motor[2].phasepos = 0;	// 0에서 2048값
// 6. Motor[2].ibbias = 0;		// 0	
// 7. Motor Kill
// 8. Motor[x].phasefound = 1;	
// ( FE 값은 추후 추가 )
//	Motor[x].Homepos = 0; abs 생 데이터 올라옴. 
// ================================================================================================================================  

//// ABS PhaseFound Cmd
#ifndef	NAND_MEMORY_USE
	if( P_PWM_Phasing_Start(N_1st_PnP_CA_T) == N_TRUE )
	{
		P_PWM_Phasing_Start(N_1st_PnP_CA_T) = N_FALSE;		// Flag 초기화
		P_PWM_Status(N_1st_PnP_CA_T) = F_Status_STARTING;	// state machine 시작
		P_PWM_State_Machine(N_1st_PnP_CA_T) = 1;			// State machine = 1
	}
	if( P_PWM_Phasing_Start(N_1st_PnP_AN_T) == N_TRUE )
	{
		P_PWM_Phasing_Start(N_1st_PnP_AN_T) = N_FALSE;		// Flag 초기화
		P_PWM_Status(N_1st_PnP_AN_T) = F_Status_STARTING;	// state machine 시작
		P_PWM_State_Machine(N_1st_PnP_AN_T) = 1;			// State machine = 1
	}
	if( P_PWM_Phasing_Start(N_2nd_PnP_CA_T) == N_TRUE )
	{
		P_PWM_Phasing_Start(N_2nd_PnP_CA_T) = N_FALSE;		// Flag 초기화
		P_PWM_Status(N_2nd_PnP_CA_T) = F_Status_STARTING;	// state machine 시작
		P_PWM_State_Machine(N_2nd_PnP_CA_T) = 1;			// State machine = 1
	}
	if( P_PWM_Phasing_Start(N_2nd_PnP_AN_T) == N_TRUE )
	{
		P_PWM_Phasing_Start(N_2nd_PnP_AN_T) = N_FALSE;		// Flag 초기화
		P_PWM_Status(N_2nd_PnP_AN_T) = F_Status_STARTING;	// state machine 시작
		P_PWM_State_Machine(N_2nd_PnP_AN_T) = 1;			// State machine = 1
	}
#else // #ifdef NAND_MEMORY_USE
// ABS PhaseFound Cmd
// 260710
	if( P_PWM_Phasing_Start(N_1st_PnP_CA_T) == N_TRUE )
	{
		if ( ( P_AbsPhasePosOffset_Change_Complete & Hex_Ca_1st_Phasing_OK ) && P_PWM_AbsPhasing_Fail == 0 )
		{
			P_PWM_Phasing_Start(N_1st_PnP_CA_T) = N_FALSE;		// Flag 초기화
			P_PWM_Status(N_1st_PnP_CA_T) = F_Status_STARTING;	// state machine 시작
			P_PWM_State_Machine(N_1st_PnP_CA_T) = 1;			// State machine = 1
		}
		else
		{
			P_PWM_Phasing_Start(N_1st_PnP_CA_T) = N_FALSE;		// Flag 초기화
		}
	}
	if( P_PWM_Phasing_Start(N_1st_PnP_AN_T) == N_TRUE )
	{
		if ( ( P_AbsPhasePosOffset_Change_Complete & Hex_An_1st_Phasing_OK ) && P_PWM_AbsPhasing_Fail == 0 )
		{
			P_PWM_Phasing_Start(N_1st_PnP_AN_T) = N_FALSE;		// Flag 초기화
			P_PWM_Status(N_1st_PnP_AN_T) = F_Status_STARTING;	// state machine 시작
			P_PWM_State_Machine(N_1st_PnP_AN_T) = 1;			// State machine = 1
		}
		else
		{
			P_PWM_Phasing_Start(N_1st_PnP_AN_T) = N_FALSE;		// Flag 초기화
		}
	}
	if( P_PWM_Phasing_Start(N_2nd_PnP_CA_T) == N_TRUE )
	{
		if ( ( P_AbsPhasePosOffset_Change_Complete & Hex_Ca_2nd_Phasing_OK ) && P_PWM_AbsPhasing_Fail == 0 )
		{
			P_PWM_Phasing_Start(N_2nd_PnP_CA_T) = N_FALSE;		// Flag 초기화
			P_PWM_Status(N_2nd_PnP_CA_T) = F_Status_STARTING;	// state machine 시작
			P_PWM_State_Machine(N_2nd_PnP_CA_T) = 1;			// State machine = 1
		}
		else
		{
			P_PWM_Phasing_Start(N_2nd_PnP_CA_T) = N_FALSE;		// Flag 초기화
		}
	}
	if( P_PWM_Phasing_Start(N_2nd_PnP_AN_T) == N_TRUE )
	{
		if ( ( P_AbsPhasePosOffset_Change_Complete & Hex_An_2nd_Phasing_OK ) && P_PWM_AbsPhasing_Fail == 0 )
		{
			P_PWM_Phasing_Start(N_2nd_PnP_AN_T) = N_FALSE;		// Flag 초기화
			P_PWM_Status(N_2nd_PnP_AN_T) = F_Status_STARTING;	// state machine 시작
			P_PWM_State_Machine(N_2nd_PnP_AN_T) = 1;			// State machine = 1
		}
		else
		{
			P_PWM_Phasing_Start(N_2nd_PnP_AN_T) = N_FALSE;		// Flag 초기화
		}
	}
#endif
// ABS PhaseFound Motor Num Cycle
if( L_Motor_Num < N_2nd_PnP_AN_T)
	L_Motor_Num++;
else
	L_Motor_Num = 1;


//#ifdef F_Def_Stack_B
//===============================================
//	[ 참조 : 2026.03.31 Phasing Found ABS Type ADD ]
//	AmpFalut 있으므로 Cmd"#x out0"
//	Cmd"#x Kill"
//	cmd"#x $";
//	sendallcmds // 모든 커맨드문 버퍼를 비워냄
//	while (Ldata.CmdStatus == 1) {} // 모든 커맨드문 버퍼가 비워질 때 까지 대기
//	jog/ x; 
//  Kill x;
//===============================================
// ABS PhaseFound StateMachine
switch( P_PWM_State_Machine(L_Motor_Num) )
{
	case 0: break;

	case 1:		// Out 0 만들어서 AmpFalut 제거
		P_Servo_ON_MNTR10++
		Motor[L_Motor_Num].FatalFeLimit = 100;		// 안전을 위하여 페이탈리밋 낮춤
		cmd"#%d out0",L_Motor_Num;
		sendallcmds									// 모든 커맨드문 버퍼를 비워냄
		while (Ldata.CmdStatus == 1) {}				// 모든 커맨드문 버퍼가 비워질 때 까지 대기
		P_PWM_Status(L_Motor_Num) = F_Status_EXECUTE;
		L_ABS_PhaseFound_Timer(L_Motor_Num) = 0;
		P_PWM_State_Machine(L_Motor_Num)++;
	break;

	case 2:		// Out 0 만들었으니 Kill
		if( L_ABS_PhaseFound_Timer(L_Motor_Num) >= L_ABS_Interval_Time )	// 50ms 
		{
			cmd"#%d Kill",L_Motor_Num;
			sendallcmds									// 모든 커맨드문 버퍼를 비워냄
			while (Ldata.CmdStatus == 1) {}				// 모든 커맨드문 버퍼가 비워질 때 까지 대기
			L_ABS_PhaseFound_Timer(L_Motor_Num) = 0;
			P_PWM_State_Machine(L_Motor_Num)++;
		}
	break;

	case 3:		// Kill 되었으니 $ (페이징)
		if( L_ABS_PhaseFound_Timer(L_Motor_Num) >= L_ABS_Interval_Time )	// 50ms 
		{
			cmd"#%d $",L_Motor_Num;
			sendallcmds									// 모든 커맨드문 버퍼를 비워냄
			while (Ldata.CmdStatus == 1) {}				// 모든 커맨드문 버퍼가 비워질 때 까지 대기
			L_ABS_PhaseFound_Timer(L_Motor_Num) = 0;
			P_PWM_State_Machine(L_Motor_Num)++;
		}
	break;

	case 4:		// PhaseFound 비트가 살면 J/
		if( L_ABS_PhaseFound_Timer(L_Motor_Num) >= L_ABS_Interval_Time )	// 50ms 
		{
			if( Motor[L_Motor_Num].PhaseFound == N_TRUE )
			{
				cmd"#%d j/",L_Motor_Num;
				sendallcmds								// 모든 커맨드문 버퍼를 비워냄
				while (Ldata.CmdStatus == 1) {}			// 모든 커맨드문 버퍼가 비워질 때 까지 대기
				L_ABS_PhaseFound_Timer(L_Motor_Num) = 0;
				P_PWM_State_Machine(L_Motor_Num)++;
			}
			else
			{
				// 260608 FatalFeLimit 원복 되지 않아 에러일 경우 원복
				Motor[L_Motor_Num].FatalFeLimit = 2000;	// 페이탈리밋 원복
				P_PWM_State_Machine(L_Motor_Num) = 0;
				P_PWM_Status(L_Motor_Num) = F_Status_STOPPED;
			}
		}
	break;

	case 5:		// J/ 되었다면 잘 된것이므로 Kill
		if( L_ABS_PhaseFound_Timer(L_Motor_Num) >= L_ABS_Interval_Time )	// 50ms 
		{
			if( Motor[L_Motor_Num].AmpEna == N_TRUE )
			{
				cmd"#%d kill",L_Motor_Num;
				sendallcmds								// 모든 커맨드문 버퍼를 비워냄
				while (Ldata.CmdStatus == 1) {}			// 모든 커맨드문 버퍼가 비워질 때 까지 대기
				Motor[L_Motor_Num].FatalFeLimit = 2000;	// 페이탈리밋 원복
				P_PWM_Status(L_Motor_Num) = F_Status_COMPLETE;
				P_PWM_State_Machine(L_Motor_Num) = 0;
			}
			else
			{
				// 260608 FatalFeLimit 원복 되지 않아 에러일 경우 원복
				Motor[L_Motor_Num].FatalFeLimit = 2000;	// 페이탈리밋 원복
				Motor[L_Motor_Num].PhaseFound = 0;
				P_PWM_State_Machine(L_Motor_Num) = 0;
				P_PWM_Status(L_Motor_Num) = F_Status_STOPPED;
			}
		}
	break;
}
//#endif


