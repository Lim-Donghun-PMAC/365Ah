			if( M_X_Anode_1st_PNP_Vac_Sensor != 0 )
			{
				P_Blow_Check(N_1st_Anode) = 0;													// 플래그 초기화

				P_PLC12_Blow_1st_Anode_Take_Time(4) = P_PLC12_Blow_1st_Anode_Take_Time(3);
				P_PLC12_Blow_1st_Anode_Take_Time(3) = P_PLC12_Blow_1st_Anode_Take_Time(2);
				P_PLC12_Blow_1st_Anode_Take_Time(2) = P_PLC12_Blow_1st_Anode_Take_Time(1);
				P_PLC12_Blow_1st_Anode_Take_Time(1) = P_PLC12_Blow_1st_Anode_Take_Time(0);
				P_PLC12_Blow_1st_Anode_Take_Time(0) = P_PLC12_Blow_1st_Anode_MNTR_Timer;			// 타이머 저장
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_1st_Anode) = 0;
				#endif
			}
		}
		else
		{
			if( M_X_Anode_1st_PNP_Vac_Sensor == 0 )
			{
				P_Blow_Check(N_1st_Anode) = 0;													// 플래그 초기화
				// 버퍼에 저장
				P_PLC12_Blow_1st_Anode_Take_Time(4) = P_PLC12_Blow_1st_Anode_Take_Time(3);
				P_PLC12_Blow_1st_Anode_Take_Time(3) = P_PLC12_Blow_1st_Anode_Take_Time(2);
				P_PLC12_Blow_1st_Anode_Take_Time(2) = P_PLC12_Blow_1st_Anode_Take_Time(1);
				P_PLC12_Blow_1st_Anode_Take_Time(1) = P_PLC12_Blow_1st_Anode_Take_Time(0);
				P_PLC12_Blow_1st_Anode_Take_Time(0) = P_PLC12_Blow_1st_Anode_MNTR_Timer;			// 타이머 저장
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_1st_Anode) = 0;
				#endif
			}
		}
	}
	
	// 음극 2차 PNP 블로우 감시 모듈
	if( P_PLC12_Blow_MNTR(N_2nd_Anode) == 1 )
	{
		P_PLC12_Blow_MNTR(N_2nd_Anode) = 0
		P_Blow_Check(N_2nd_Anode) = 1
		P_PLC12_Blow_2nd_Anode_MNTR_Timer = 0
		#ifdef F_Debug_Mode
			P_Debug_blow_MNTR(N_2nd_Anode) = 1;
		#endif
	}
	
	if( P_Blow_Check(N_2nd_Anode) == 1 )
	{
		if( P_PLC12_Blow_2nd_Anode_MNTR_Timer > P_PLC12_Blow_2nd_Anode_Set_Time / ((Coord[1].DesTimeBase*400)/100))
		{
			if( M_X_Anode_2nd_PNP_Vac_Sensor != 0 )
			{
				P_Blow_Check(N_2nd_Anode) = 0;													// 플래그 초기화

				P_PLC12_Blow_2nd_Anode_Take_Time(4) = P_PLC12_Blow_2nd_Anode_Take_Time(3);
				P_PLC12_Blow_2nd_Anode_Take_Time(3) = P_PLC12_Blow_2nd_Anode_Take_Time(2);
				P_PLC12_Blow_2nd_Anode_Take_Time(2) = P_PLC12_Blow_2nd_Anode_Take_Time(1);
				P_PLC12_Blow_2nd_Anode_Take_Time(1) = P_PLC12_Blow_2nd_Anode_Take_Time(0);
				P_PLC12_Blow_2nd_Anode_Take_Time(0) = P_PLC12_Blow_2nd_Anode_MNTR_Timer;			// 타이머 저장	
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_2nd_Anode) = 0;
				#endif
			}
		}
		else
		{
			if( M_X_Anode_2nd_PNP_Vac_Sensor == 0 )
			{
				P_Blow_Check(N_2nd_Anode) = 0;													// 플래그 초기화
				// 버퍼에 저장
				P_PLC12_Blow_2nd_Anode_Take_Time(4) = P_PLC12_Blow_2nd_Anode_Take_Time(3);
				P_PLC12_Blow_2nd_Anode_Take_Time(3) = P_PLC12_Blow_2nd_Anode_Take_Time(2);
				P_PLC12_Blow_2nd_Anode_Take_Time(2) = P_PLC12_Blow_2nd_Anode_Take_Time(1);
				P_PLC12_Blow_2nd_Anode_Take_Time(1) = P_PLC12_Blow_2nd_Anode_Take_Time(0);
				P_PLC12_Blow_2nd_Anode_Take_Time(0) = P_PLC12_Blow_2nd_Anode_MNTR_Timer;			// 타이머 저장	
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_2nd_Anode) = 0;
				#endif
			}
		}
	}
	
	// 음극 NG PNP 블로우 감시 모듈
	if( P_PLC12_Blow_MNTR(N_NG_Anode) == 1 )
	{
		P_PLC12_Blow_MNTR(N_NG_Anode) = 0
		P_Blow_Check(N_NG_Anode) = 1
		P_PLC12_Blow_NG_Anode_MNTR_Timer = 0
		#ifdef F_Debug_Mode
			P_Debug_blow_MNTR(N_NG_Anode) = 1;
		#endif
	}
	
	if( P_Blow_Check(N_NG_Anode) == 1 )
	{
		if( P_PLC12_Blow_NG_Anode_MNTR_Timer > P_PLC12_Blow_NG_Anode_Set_Time / ((Coord[1].DesTimeBase*400)/100))
		{
			if( M_X_Anode_NG_PNP_Vac_Sensor != 0 )
			{
				P_Blow_Check(N_NG_Anode) = 0;													// 플래그 초기화

				P_PLC12_Blow_NG_Anode_Take_Time(4) = P_PLC12_Blow_NG_Anode_Take_Time(3);
				P_PLC12_Blow_NG_Anode_Take_Time(3) = P_PLC12_Blow_NG_Anode_Take_Time(2);
				P_PLC12_Blow_NG_Anode_Take_Time(2) = P_PLC12_Blow_NG_Anode_Take_Time(1);
				P_PLC12_Blow_NG_Anode_Take_Time(1) = P_PLC12_Blow_NG_Anode_Take_Time(0);
				P_PLC12_Blow_NG_Anode_Take_Time(0) = P_PLC12_Blow_NG_Anode_MNTR_Timer;				// 타이머 저장	
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_NG_Anode) = 0;
				#endif
			}
		}
		else
		{
			if( M_X_Anode_NG_PNP_Vac_Sensor == 0 )
			{
				P_Blow_Check(N_NG_Anode) = 0;													// 플래그 초기화
				// 버퍼에 저장
				P_PLC12_Blow_NG_Anode_Take_Time(4) = P_PLC12_Blow_NG_Anode_Take_Time(3);
				P_PLC12_Blow_NG_Anode_Take_Time(3) = P_PLC12_Blow_NG_Anode_Take_Time(2);
				P_PLC12_Blow_NG_Anode_Take_Time(2) = P_PLC12_Blow_NG_Anode_Take_Time(1);
				P_PLC12_Blow_NG_Anode_Take_Time(1) = P_PLC12_Blow_NG_Anode_Take_Time(0);
				P_PLC12_Blow_NG_Anode_Take_Time(0) = P_PLC12_Blow_NG_Anode_MNTR_Timer;				// 타이머 저장	
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_NG_Anode) = 0;
				#endif
			}
		}
	}
	
	// 음극 얼라인테이블 블로우 감시 모듈
	if( P_PLC12_Blow_MNTR(N_Align_Anode) == 1 )
	{
		P_PLC12_Blow_MNTR(N_Align_Anode) = 0
		P_Blow_Check(N_Align_Anode) = 1
		P_PLC12_Blow_Align_Anode_MNTR_Timer = 0
		#ifdef F_Debug_Mode
			P_Debug_blow_MNTR(N_Align_Anode) = 1;
		#endif
	}
	
	if( P_Blow_Check(N_Align_Anode) == 1 )
	{
		if( P_PLC12_Blow_Align_Anode_MNTR_Timer > P_PLC12_Blow_Align_Anode_Set_Time / ((Coord[1].DesTimeBase*400)/100) )
		{
			if( M_X_Anode_AT_Vac_Sensor != 0 )
			{
				P_Blow_Check(N_Align_Anode) = 0;												// 플래그 초기화

				P_PLC12_Blow_Align_Anode_Take_Time(4) = P_PLC12_Blow_Align_Anode_Take_Time(3);		
				P_PLC12_Blow_Align_Anode_Take_Time(3) = P_PLC12_Blow_Align_Anode_Take_Time(2);		
				P_PLC12_Blow_Align_Anode_Take_Time(2) = P_PLC12_Blow_Align_Anode_Take_Time(1);		
				P_PLC12_Blow_Align_Anode_Take_Time(1) = P_PLC12_Blow_Align_Anode_Take_Time(0);		
				P_PLC12_Blow_Align_Anode_Take_Time(0) = P_PLC12_Blow_Align_Anode_MNTR_Timer;		// 타이머 저장	
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_Align_Anode) = 0;
				#endif
			}
		}
		else
		{
			if( M_X_Anode_AT_Vac_Sensor == 0 )
			{
				P_Blow_Check(N_Align_Anode) = 0;												// 플래그 초기화
				// 버퍼에 저장																		
				P_PLC12_Blow_Align_Anode_Take_Time(4) = P_PLC12_Blow_Align_Anode_Take_Time(3);		
				P_PLC12_Blow_Align_Anode_Take_Time(3) = P_PLC12_Blow_Align_Anode_Take_Time(2);		
				P_PLC12_Blow_Align_Anode_Take_Time(2) = P_PLC12_Blow_Align_Anode_Take_Time(1);		
				P_PLC12_Blow_Align_Anode_Take_Time(1) = P_PLC12_Blow_Align_Anode_Take_Time(0);		
				P_PLC12_Blow_Align_Anode_Take_Time(0) = P_PLC12_Blow_Align_Anode_MNTR_Timer;		// 타이머 저장	
	
				#ifdef F_Debug_Mode
					P_Debug_blow_MNTR(N_Align_Anode) = 0;
				#endif
			}
		}
	}
}


// 서보 댄서 각도 알람 체크
if(P_PMAC_Current_Mode == F_Current_Automatic && P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence)
{
	if(P_Motor_Current_Pos(N_SERVO_DANCER) < P_Servo_Dancer_Alarm_Minimum_Angle_Value || P_Motor_Current_Pos(N_SERVO_DANCER) > P_Servo_Dancer_Alarm_Maximum_Angle_Value)
	{
		P_Dancer_Angle_Alarm_Timer_Flag = 1;
		P_Dancer_Angle_Alarm_Check_Timer = 0;
	}
	else
	{
		P_Dancer_Angle_Alarm_Timer_Flag = 0;
	}

	if(P_Dancer_Angle_Alarm_Timer_Flag == 1)
	{
		if(P_Dancer_Angle_Alarm_Check_Timer > N_Dancer_Angle_Check_Time)
		{
			// 댄서 각도 알람 발생
//			M_Servo_Dancer_Angle_Alarm = 1;
			call Alarm.Insert_Alarm(N_Alarm_Servo_Dancer_Angle, N_High_Alarm_Cycle_Stop);
		}
	}
}



// 스탑 버튼(34) 눌렀을 때, 커맨드 초기화 되어 0으로 들어왔을 때 제외하고 저장
// 888은 정지 후 재시작을 나누기 위해 리셋팅에서 888 값 처리
if( P_Stop_Cmd_Origin != P_Stop_Origin_Save(0) && P_Stop_Cmd_Origin != 0 )
{
	P_Stop_Origin_Save(14) = P_Stop_Origin_Save(13)
	P_Stop_Origin_Save(13) = P_Stop_Origin_Save(12)
	P_Stop_Origin_Save(12) = P_Stop_Origin_Save(11)
	P_Stop_Origin_Save(11) = P_Stop_Origin_Save(10)
	P_Stop_Origin_Save(10) = P_Stop_Origin_Save(9)
	P_Stop_Origin_Save(9) = P_Stop_Origin_Save(8)
	P_Stop_Origin_Save(8) = P_Stop_Origin_Save(7)
	P_Stop_Origin_Save(7) = P_Stop_Origin_Save(6)
	P_Stop_Origin_Save(6) = P_Stop_Origin_Save(5)
	P_Stop_Origin_Save(5) = P_Stop_Origin_Save(4)
	P_Stop_Origin_Save(4) = P_Stop_Origin_Save(3)
	P_Stop_Origin_Save(3) = P_Stop_Origin_Save(2)
	P_Stop_Origin_Save(2) = P_Stop_Origin_Save(1)
	P_Stop_Origin_Save(1) = P_Stop_Origin_Save(0)
	P_Stop_Origin_Save(0) = P_Stop_Cmd_Origin
}

// ng 박스 센서 off 시 NG PNP 동작 멈춤
//[참조 : 260730 환경안전검수용 인터락 활성화 버튼 추가]
If ( P_PMAC_Current_Mode == F_Current_Automatic && P_X_PLC_Setup_Mode_Check == 0 )
{
	// ng pnp 동작은 hold 때만 있음
	if ( P_PMAC_Status == F_Status_HOLD )
	{
		// 양극 NG BOX 미감지 및 양극 NG PNP 동작 중이라면 NG PNP 동작 정지 시퀀스 실행
		if( M_X_Cathode_NG_Box_Detect_Sensor == 0 && P_Cathode_NG_PNP_Vel_Zero_Set == 0  )
		{
			if( Motor[42].DesVelZero == 0 ||  Motor[44].DesVelZero == 0 )
				P_Cathode_NG_PNP_Vel_Zero_Set = 1
		}
	
		// 음극 NG BOX 미감지 및 음극 NG PNP 동작 중이라면 NG PNP 동작 정지 시퀀스 실행
		if( M_X_Anode_NG_Box_Detect_Sensor == 0 && P_Anode_NG_PNP_Vel_Zero_Set == 0  )
		{
			if( Motor[43].DesVelZero == 0 ||  Motor[45].DesVelZero == 0 )
				P_Anode_NG_PNP_Vel_Zero_Set = 1
		}
	}

	switch( P_Cathode_NG_PNP_Vel_Zero_Set )
	{
		// 좌표계 원복
		case 1 :
			Coord[N_Coord_NG_PNP_CA].pDesTimeBase = Coord[N_Coord_NG_PNP_CA].DesTimeBase.a;
			P_Cathode_NG_PNP_Vel_Zero_Set++
		break;
	
		// NG PNP 정지
		case 2 :
			if( Coord[N_Coord_NG_PNP_CA].pDesTimeBase == Coord[N_Coord_NG_PNP_CA].DesTimeBase.a )
			{
				Coord[N_Coord_NG_PNP_CA].DesTimeBase = 0
				P_Cathode_NG_PNP_Vel_Zero_Set++
			}
		break;
		
		// NG BOX 재감지 시 동작 실행
		case 3 :
			if( M_X_Cathode_NG_Box_Detect_Sensor == 1 )
			{
				Coord[N_Coord_NG_PNP_CA].pDesTimeBase =  Coord[1].DesTimeBase.a;
				P_Cathode_NG_PNP_Vel_Zero_Set++
			}
		break;

		// TimeBase 원복
		case 4 :
			if( Coord[N_Coord_NG_PNP_CA].pDesTimeBase == Coord[1].DesTimeBase.a )
			{
				Coord[N_Coord_NG_PNP_CA].DesTimeBase = Sys.ServoPeriod
				if( Coord[N_Coord_NG_PNP_CA].DesTimeBase == Sys.ServoPeriod  )
				{
					P_Cathode_NG_PNP_Vel_Zero_Set = 0
				}
			}
		break;
	
		default:
	
		break
	}
	
	
	
	switch( P_Anode_NG_PNP_Vel_Zero_Set )
	{
		case 1 :
			Coord[N_Coord_NG_PNP_AN].pDesTimeBase = Coord[N_Coord_NG_PNP_AN].DesTimeBase.a;
			P_Anode_NG_PNP_Vel_Zero_Set++
		break;
	
		case 2 :
			if( Coord[N_Coord_NG_PNP_AN].pDesTimeBase == Coord[N_Coord_NG_PNP_AN].DesTimeBase.a )
			{
				Coord[N_Coord_NG_PNP_AN].DesTimeBase = 0
				P_Anode_NG_PNP_Vel_Zero_Set++
			}
		break;
	
		case 3 :
			if( M_X_Anode_NG_Box_Detect_Sensor == 1 )
			{
				Coord[N_Coord_NG_PNP_AN].pDesTimeBase = Coord[1].DesTimeBase.a;
				P_Anode_NG_PNP_Vel_Zero_Set++
			}
		break;

		case 4 :
			if( Coord[N_Coord_NG_PNP_AN].pDesTimeBase == Coord[1].DesTimeBase.a )
			{
				Coord[N_Coord_NG_PNP_AN].DesTimeBase = Sys.ServoPeriod
				if( Coord[N_Coord_NG_PNP_AN].DesTimeBase == Sys.ServoPeriod )
				{
					P_Anode_NG_PNP_Vel_Zero_Set = 0
				}
			}
		break; 
	
		default:
	
		break
	}
}

// 정지 완료 및 Abort 완료 시 시퀀스 종료
if( P_Cathode_NG_PNP_Vel_Zero_Set != 0 || P_Anode_NG_PNP_Vel_Zero_Set != 0 )
{
	if ( P_PMAC_Status == F_Status_STOPPED || P_PMAC_Status == F_Status_ABORTED || P_PMAC_Status == F_Status_EXECUTE || (P_Hold_Remove_NG_PNP == 0 && P_Hold_Remove_Align == 0) )
	{
		P_Cathode_NG_PNP_Vel_Zero_Set = 0
		P_Anode_NG_PNP_Vel_Zero_Set = 0
		Coord[N_Coord_NG_PNP_CA].DesTimeBase = Sys.ServoPeriod
		Coord[N_Coord_NG_PNP_CA].DesTimeBase = Sys.ServoPeriod
	}
	else
	{
		// 260806 NG 박스 센서 감지 안될 시 팝업 발생
		nop(memset(F_IL_Cdata,0,N_IL_memset_size));

		if( P_Cathode_NG_PNP_Vel_Zero_Set != 0 )
		{
			nop(sprintf(F_IL_Cdata," Cathode NG_PNP "));		
		}

		if( P_Anode_NG_PNP_Vel_Zero_Set != 0 )
		{
			nop(sprintf(F_IL_Cdata," Anode NG_PNP "));
		}

		nop(sprintf(F_IL_Cdata2," Sensor Check "));
		P_Y_Interlock_Popup_On_Request = 1;
	}
}

// 260401 세파 열선 ON 후 20초 동안 꺼지지 않는다면 강제로 off
if( M_Y_Sepa_Cutter_SSR_On == 1 && M_Y_Sepa_Cutter_SSR_On != P_Old_M_Y_Sepa_Cutter_SSR_On  )
{
	P_Sepa_Cutter_SSR_Off = 1
	P_Sepa_Cutter_SSR_Off_Timer = 0
}
else if( M_Y_Sepa_Cutter_SSR_On == 0 && M_Y_Sepa_Cutter_SSR_On != P_Old_M_Y_Sepa_Cutter_SSR_On )
{
	P_Sepa_Cutter_SSR_Off = 0
}
P_Old_M_Y_Sepa_Cutter_SSR_On = M_Y_Sepa_Cutter_SSR_On

if( P_Sepa_Cutter_SSR_Off  == 1 && P_Sepa_Cutter_SSR_Off_Timer > P_Sepa_Cutter_SSR_Off_Time )
{
	M_Y_Sepa_Cutter_SSR_On = 0
}

// [ 참조 : 260414 Reel Work Confirm 관련 PMAC ↔ Vision,PLC I/F ]
if ( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )	// 노말모드
{
	if ( P_Stack_Judgement_Memory == 0  )							// J/R 적층 중 X
	{
		M_Y_Vision_Jelly_Roll_Not_Stacking_Flag = 1;				// J/R 적층 X라는 것을 알려주는 IO ON(PMAC → VISION)
	}
	else															// J/R 적층 중 O
	{
		M_Y_Vision_Jelly_Roll_Not_Stacking_Flag = 0;				// J/R 적층 X라는 것을 알려주는 IO 초기화(PMAC → VISION)
	}
}
if ( M_X_PLC_Work_Confirm_Operation_Flag == 1 )						// Reel Work Confirm 했다는 IO(PLC → PMAC)
{
	P_PLC_TO_PMAC_Work_Confirm_Operation_Cnt++
	M_Y_PLC_Work_Confirm_Operation_Ack = 1;							// Reel Work Confirm에 대한 ACK 신호 ON(PMAC → PLC)
	P_Y_Vision_Work_Confirm_Operation_Flag = 1;						// Reel Work Confirm 했다는 P번지 ON(PMAC → VISION)
}
if ( P_X_Vision_Work_Confirm_Operation_Ack == 1 )					// Reel Work Confirm에 대한 P번지 ACK 신호(VISION → PMAC)
{
	P_VISION_TO_PMAC_Work_Confirm_Operation_Ack_Cnt++
	P_Y_Vision_Work_Confirm_Operation_Flag = 0;						// Reel Work Confirm 했다는 P번지 OFF(PMAC → VISION)
	M_Y_PLC_Work_Confirm_Operation_Ack = 0;							// Reel Work Confirm에 대한 ACK 신호 OFF(PMAC → PLC) 
}

// [ 참조 : 26.04.28 Picker T축 탭방향에 따른 홈방식 변경 ]
//PickerT 단방향위치로 변경으로 홈 오프셋 변경부 주석. [ 참조 : 26.09.11 PickerT 모션 변경에 따른 동작 횟수 감시 삭제 ]
