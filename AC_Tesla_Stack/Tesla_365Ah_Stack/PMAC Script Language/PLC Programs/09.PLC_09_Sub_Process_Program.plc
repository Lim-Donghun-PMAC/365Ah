//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 2025.06.24 - 리팩토링 [ 2025.06.24 추가 ]
//	-> 전체 간소화 및 오토,메뉴얼 리팩토링
// 25.08.12 김성중 선임 
// 1,2차 PNP 클랭크 Z축 수식 프로그램(Recipe to Count, Count to Recipe) 추가 [ 참조 : 25.07.09 MSA 프로그램 신규 추가 ] -김성중 선임

//===============================================================================
// 	00. 프로그램 설명                                                                     
//===============================================================================
// 서브프로세스 프로그램
//	- 각 함수의 동작들을 실행해주는 프로그램
//	- 함수호출은 plc8에서
//	- 사용자는 각 함수의 스텟머신(P_array_CF_Function_State_Number)에 동작을 추가하여 프로그램 작성하면 됩니다.
//===============================================================================+

open plc 9

P_MNTR_PLC9_Task_Time(0) = Sys.Time;

   //01. 다이나믹 로컬 타이머 변수 선언 
Local L_Time_Cycle_Up_Count_Start_Time;				// Plc[09].ldata.L[0] 시간 체크 시작 시간
Local L_Time_Cycle_Up_Count_End_Time;				// Plc[09].ldata.L[1] 시간 체크 종료 시간
Local L_Time_Cycle_Up_Count_Delta_Time;				// Plc[09].ldata.L[2] 시작과 종료 시간 사이의 시간
Local L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[09].ldata.L[3] 타이머 초기화 플래그

// Auto - RTN
local	L_PLC09_Auto_Starting_RTN;					// Plc[09].ldata.L[4]	스타팅 결과값 변수
local	L_PLC09_Auto_Stopping_RTN;					// Plc[09].ldata.L[5]	스타핑 결과값 변수
local	L_PLC09_Auto_Aborting_RTN;					// Plc[09].ldata.L[6]	어볼팅 결과값 변수
// Auto - Timer
local	L_PLC09_Auto_Starting_Timer;				// Plc[09].ldata.L[7]	스타팅 타이머 변수
local	L_PLC09_Auto_Stopping_Timer;				// Plc[09].ldata.L[8]	스타핑 타이머 변수
local	L_PLC09_Auto_Aborting_Timer;				// Plc[09].ldata.L[9]	어볼팅 타이머 변수
// Manual - RTN
local	L_PLC09_Manual_Resetting_RTN;				// Plc[09].ldata.L[10]	리셋팅 결과값 변수
local	L_PLC09_Manual_Stopping_RTN;				// Plc[09].ldata.L[11]	스타핑 결과값 변수
local	L_PLC09_Manual_Aborting_RTN;				// Plc[09].ldata.L[12]	어볼팅 결과값 변수
// Manual - Timer
local	L_PLC09_Manual_Resetting_Timer;				// Plc[09].ldata.L[13]	스타팅 타이머 변수
local	L_PLC09_Manual_Stopping_Timer;				// Plc[09].ldata.L[14]	스타핑 타이머 변수
local	L_PLC09_Manual_Aborting_Timer;				// Plc[09].ldata.L[15]	어볼팅 타이머 변수
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
IF (L_Flag_Cycle_Up_Count_Init_Flag == 0)
{
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 00.2) 시간 체크
IF (L_Flag_Cycle_Up_Count_Init_Flag == 1)
{
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;

	IF( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
IF (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{
	L_PLC09_Auto_Starting_Timer = L_PLC09_Auto_Starting_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC09_Auto_Stopping_Timer = L_PLC09_Auto_Stopping_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC09_Auto_Aborting_Timer = L_PLC09_Auto_Aborting_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	
	L_PLC09_Manual_Resetting_Timer = L_PLC09_Manual_Resetting_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC09_Manual_Stopping_Timer = L_PLC09_Manual_Stopping_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC09_Manual_Aborting_Timer = L_PLC09_Manual_Aborting_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}	

//=========================================================================================================================
//	03. 서브 프로세스 프로그램 (공용화)
//=========================================================================================================================
// [명령부]
IF ( P_PLC09_Common_Command_Flag == 1 )								// 1. 공통 명령부 플래그
{		
	P_PLC09_Common_Command_Flag = 0;								// 1.1 플래그 초기화
			
	P_PLC09_Common_Command_Complete_Bit = 0;						// 1.2 공통 명령부 함수호출 완료 비트 초기화
																													   
	Call Sub_Common_Function.Common_Command();						// 1.4 공통 명령부 함수호출
	
	IF ( P_PLC09_Common_Command_Complete_Bit == 1)					// 1.5 공통 명령부 완료 Bit 확인 되었다면	
	{				
		P_PLC09_Common_Command_Complete_Bit = 0;					// 1.6 초기화
		
		P_PLC09_Common_Execute_Complete_Bit = 0;					// 1.7 공통 실행부 함수호출 완료 비트 초기화 	
		
		// [실행부]													
		Call Sub_Common_Function.Common_Excute();					// 1.8 공통 실행부 함수 호출		
	
		IF ( P_PLC09_Common_Execute_Complete_Bit == 1 ) 			// 1.9 공통 실행부 완료 Bit 확인
		{			
			P_PLC09_Common_Execute_Complete_Bit = 0;				// 1.10 공통 실행부 완료비트 초기화
		}
	}
	
	//	[옵저버] - 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{		
		P_array_CF_Function_Return_Flag = 1;						// 1.11 프로그램이 정상 종료되어 반환을 알림
	}
	//  1.12) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	//	1.13) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}
}

//==============================================================================================================================================================
// 01. 오토 모드 ( Automatic Mode )
//==============================================================================================================================================================
//==========================================================================================================================
// 01.1. Automatic Mode - IDLE
//==========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_IDLE )	
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Status = 1;

		P_PLC09_Common_Command_Flag = 1;							
	}
}

//==========================================================================================================================
//	2. STARTING
//==========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_STARTING )
{	
	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )
	{	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
		// 프로그램이 실행되었음을 표시
		P_array_CF_Function_Start_Flag = 1;																			// 서브 프로그램 진입 플래그		
		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;													// [프로그램 스텟머신 1번] - 이동
	}
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )	
		{
			case N_PLC09_PackML_Num_0: break;

			case N_PLC09_PackML_Num_1:
				P_SV_Read_Enable_Flag = 0

				// [ 참조 : 260506 격벽 파티션 추가 ]
//				if(M_X_Cathode_Belt_Partition_Down_Sensor == 1 || M_X_Anode_Belt_Partition_Down_Sensor == 1)
//				{
//					call Alarm.Insert_Alarm(, N_High_Alarm_Cycle_Stop);
//					P_PMAC_Commands = F_Command_Stop;
//					P_array_CF_Function_State_Number = 44;
//				}

				if( P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence )
				{
					// [참조 : 260108 maint ng flag로 인덱스 불량 발생하는 부분 수정]
					P_Memory_Tower_Search_Flag = 1
					P_MemTow_integrated_return = 0;

					P_array_CF_Function_Run_Flag = 1;																			// 서브 프로그램 시작을 알림
					P_PLC01_Execute_Retry_Sepa_Mode_Count = 0;																	// 리트라이 세파모드 횟수 초기화
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;	
				}
				else
				{
					if( P_Opposite_Lane_P_PMAC_Status == 0 || P_Opposite_Lane_P_PMAC_Status == F_Status_STOPPING || P_Opposite_Lane_P_PMAC_Status == F_Status_STOPPED || P_Opposite_Lane_P_PMAC_Status == F_Status_ABORTING || P_Opposite_Lane_P_PMAC_Status == F_Status_ABORTED )
					{
						if( M_X_Pause_Status_Complete_Signal == 0 )		// 반대열 퍼즈 상태이면 퍼즈가 풀릴 때 까지 대기 후 반대열 1차 PNP 위치 확인
						{
							// 반대열 1차 PNP가 벨트 위치에 가까우면 알람 발생
							if( M_X_Opposite_Cathode_1st_PNP_Collision_Detect_Sensor == 0 || M_X_Opposite_Anode_1st_PNP_Collision_Detect_Sensor == 0 )
							{
								// 알람 발생, 반대편 열 1차 PNP 벨트 쪽
								call Alarm.Insert_Alarm(N_Alarm_Opposite_Lane_1st_PNP_Near_Belt_Pos, N_High_Alarm_Cycle_Stop);
								P_array_CF_Function_State_Number = 44;
							}
							else
							{
								// [참조 : 260108 maint ng flag로 인덱스 불량 발생하는 부분 수정]
								P_Memory_Tower_Search_Flag = 1
								P_MemTow_integrated_return = 0;

								P_array_CF_Function_Run_Flag = 1;																			// 서브 프로그램 시작을 알림
								P_PLC01_Execute_Retry_Sepa_Mode_Count = 0;																	// 리트라이 세파모드 횟수 초기화
								P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;	

							}
						}
					}
					else
					{
						// [참조 : 260108 maint ng flag로 인덱스 불량 발생하는 부분 수정]
						P_Memory_Tower_Search_Flag = 1
						P_MemTow_integrated_return = 0;

						P_array_CF_Function_Run_Flag = 1;																			// 서브 프로그램 시작을 알림
						P_PLC01_Execute_Retry_Sepa_Mode_Count = 0;																	// 리트라이 세파모드 횟수 초기화
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;	
					}
				}
				//  [참조 : 26.10.19 세파 커터 하강 상태 확인 추가 ]
				if(  (M_X_FR_Sepa_Cutter_Dn_Sensor  ==  1  &&  M_X_FR_Sepa_Cutter_Up_Sensor  ==  0)  ||    M_Y_FR_Sepa_Cutter_Dn_Sol  ==  1  ) 
				{ 
					call  Alarm.Insert_Alarm(N_Alarm_Cutter_Lowering  ,N_High_Alarm_Cycle_Stop); 
					P_array_CF_Function_State_Number  =  444; 
				} 

			break;

			case N_PLC09_PackML_Num_2:		// 스타팅 필요 초기화 란
				
				// 260320 starting 시 시트페이퍼 실린더 전진
				M_Y_First_Sheet_Paper_Plate_FWD_Sol = 1
				M_Y_First_Sheet_Paper_Plate_BWD_Sol = 0

				// 260616 1차 언로더 데이터 있는 상태에서 유저 선택 세파모드로 재가동 시 1차 언로더 데이터를 2차 언로더까지 전달해야 execute로 넘어가는 부분 수정
				P_Proceed_Execute_Flag = 0

				P_EXECUTE_IsEnable_Firt_Stacking_Flag = 0;
				/* NG 연속 발생 초기화 부분 필요 시 추가
				*/
				// 구준영책임 - [ Execute 에서 Starting 필요 초기화 란 ]
				P_Mode_Command = 0;																					// 모드 커멘드 초기화.
				P_Current_Mode = 0;																					// 현재모드 초기화.
				//Plc[0].Ldata.L[4] = 0;																				// PLC0 로컬변수 초기화. (L_Mode_Depth)
				P_Command_Run_Flag = 0;																				// PLC0 로컬변수 초기화. (L_Command_Run_Flag)
				P_Cathode_Cur_Mode = 0;																				// 양극 현재 모드 초기화
				P_Anode_Cur_Mode = 0;																				// 음극 현재모드 초기화
				P_Current_Mode = F_Wait_Mode;																		// 현재 모드 초기화
				L_PLC09_Auto_Starting_Timer = 0;																	// 타이머 초기화
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;											// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_3:		// 타임베이스 ON 모니터링 램프 OFF 함수 호출
				if( L_PLC09_Auto_Starting_Timer > 50 )
				{
					L_PLC09_Auto_Starting_RTN = 0;																		// 결과 변수 초기화
					call Sub_Common_Function.Timebase_On(&L_PLC09_Auto_Starting_RTN);									// 타임 베이스 ON
					if( L_PLC09_Auto_Starting_RTN == N_TRUE )				
					{
						L_PLC09_Auto_Starting_RTN = 0;																	// 결과 변수 초기화
						call Sub_Common_Function.Monitoring_Lamp_off(&L_PLC09_Auto_Starting_RTN);						// 모니터링 시퀀스 Lamp OFF [함수 호출]
						if( L_PLC09_Auto_Starting_RTN == N_TRUE )
						{
							L_PLC09_Auto_Starting_Timer = 0;															// 타이머 초기화
							P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;									// 다음 스텝으로 이동
						}
					}
				}	
			break;

			case N_PLC09_PackML_Num_4:		//	타임베이스 동기화 확인 후 마스터 플래그 on
				if( L_PLC09_Auto_Starting_Timer > 50 )
				{
					L_PLC09_Auto_Starting_RTN = 0;																		// 결과 변수 초기화
					call Sub_Common_Function.Timbase_ON_Check(&L_PLC09_Auto_Starting_RTN);								// 타임베이스 동기화 확인
					if( L_PLC09_Auto_Starting_RTN == N_TRUE )
					{
						L_PLC09_Auto_Starting_RTN = 0;
						call Sub_Common_Function.Master_Motion_Program_On(&L_PLC09_Auto_Starting_RTN);					// 모션 프로그램 플래그 ON
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5;										// 다음 스텝으로 이동
					}
				}					
			break;

			case N_PLC09_PackML_Num_5:		// Hold 필요 변수 선언
				// [참조 : 260108 maint ng flag로 인덱스 불량 발생하는 부분 수정]
				if ( P_Memory_Tower_Search_Flag == 0 && P_MemTow_integrated_return == N_TRUE )	
				{
					// [참조 : 260108 maint ng flag로 인덱스 불량 발생하는 부분 수정]
					if ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos )
					{
						P_Cathode_Count = 0;											// 양극 극판 카운트 초기화.
						P_Anode_Count = 0;												// 음극 극판 카운트 초기화.

						Sys_Stack_Sheet_Data = 0;

						// [ 참조 : 26.06.10 스택테이블 진공 on/off 추가 ]
						M_Y_ST_Center_Sol = 1
						M_Y_ST_Center_Ejector_VAC_On = 0
						M_Y_ST_Center_Ejector_VAC_Off = 1

						P_Status_Clear_Sheet_Maint_Check = 1
						// [참조 : 260127 얼라인 스타트 io on/off 시점 추가]
						P_Align_Start_IO_Judgment = 1
					}
					// 박찬호선임 - [ Hold 에서 Starting 필요 ]
					P_Anode_1st_Motion_Complete = 1;
					P_Anode_2nd_Motion_Complete = 1;
					P_Anode_NG_PNP_Motion_Complete = 1;
					P_Anode_1st_Picker_Motion_Complete = 1;
					
					P_Cathode_1st_Motion_Complete = 1;
					P_Cathode_2nd_Motion_Complete = 1;
					P_Cathode_NG_PNP_Motion_Complete = 1;
					P_Cathode_1st_Picker_Motion_Complete = 1;

					P_Hold_Existence_Insp_Enqueue_Flag = 1
					L_PLC09_Auto_Starting_Timer = 0;																		// 타이머 초기화
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_6;												// 다음 스텝으로 이동
				}
			break;

			case N_PLC09_PackML_Num_6:		// clamp Down pos cal
				if( L_PLC09_Auto_Starting_Timer > 100 && P_Status_Clear_Sheet_Maint_Check == 0 )
				{
					// [ 참조 : 26.06.10 스택테이블 진공 on/off 추가 ]
					M_Y_ST_Center_Sol = 0
					M_Y_ST_Center_Ejector_VAC_On = 0
					M_Y_ST_Center_Ejector_VAC_Off = 0

					// [참조 : 260127 얼라인 스타트 io on/off 시점 추가]
					if( P_Align_Start_IO_Judgment == 1 )
					{
						// 시점 : 재가동, 모든 모터 대기위치
						// 음극 얼라인와 2차 PNP에 극판이 없으면 공급하면서 첫번째 극판이다 비전에게 알려줘야함, 인덱스 초기화
						// 얼라인와 2차 PNP에 NG가 있다면 다시 가동 시 제거하고 공급하기 때문에 공급한 극판이 첫번째 극판이다 비전에게 알려줘야함
						if( ((Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence == 0) && (Sys_Anode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence == 0)) || Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_NG_Masking || Sys_Anode_2nd_Sheet_LO_Vision_BYTE & Hex_NG_Masking )
						{
							P_First_Anode_Sheet_Supply_Flag = 0
						}
						// 시점 : 재가동, 모든 모터 대기위치
						// 양극 얼라인에 극판 없으면 공급하면서 첫번째 극판이다 비전에게 알려줘야함, 인덱스 초기화
						// 양극 얼라인에 ng가 있다면 제거하고 다시 공급해야하기 때문에 공급한 극판이 첫번째 극판이다 비전에게 알려줘야함
						if( ((Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence == 0) && (Sys_Cathode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence == 0)) || Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_NG_Masking || Sys_Cathode_2nd_Sheet_LO_Vision_BYTE & Hex_NG_Masking )
						{
							P_First_Cathode_Sheet_Supply_Flag = 0
						}
					}
					P_Align_Start_IO_Judgment = 0


					// Clamp On 후 극판 두께만큼 하강 위치값 추가
					//if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )										// Normal Run
					//{
					//	P_AN_Clamp_Cell_Down_Pos = P_Recipe_M26_POS(4) - ( P_Anode_Thickness + P_Sepa_Thickness );
					//	P_CA_Clamp_Cell_Down_Pos = P_Recipe_M25_POS(4) - ( P_Cathode_Thickness + P_Sepa_Thickness );
					//}
					//else if( P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence )							// Sepa Run
					//{
					//	P_AN_Clamp_Cell_Down_Pos = P_Recipe_M26_POS(4) - P_Sepa_Thickness;
					//	P_CA_Clamp_Cell_Down_Pos = P_Recipe_M25_POS(4) - P_Sepa_Thickness;
					//}
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_7;											// 다음 스텝으로 이동
				}
			break;

			case N_PLC09_PackML_Num_7:		//	서브 마스터 초기화
				P_SubMaster_Sub_Old_Command(0),15,1=0;
				P_SubMaster_Sub_Old_Mode(0),15,1=0;
				P_SubMaster_Sub_Old_Trigger(0),15,1=0;
				P_SubMaster_Sub_Mode_Command(0),15,1=0;
				L_PLC09_Auto_Starting_Timer = 0;																		// 타이머 초기화
				if ( P_Anode_Count == 0 )																				// 음극 적층 개수가 0일 경우.	[ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
				{	
					P_Stack_Table_NG_Flag = 0;																			// Stack Table NG Flag 초기화. 
					P_Buf_Stack_NG_Flag = 0
				}
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8;												// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_8:		//	파이널 롤러 언클램프 확인 구간
				if( L_PLC09_Auto_Starting_Timer > 50 )
				{
					//if( P_Anode_Count != 0 && P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence )				// 적층을 했고, 드라이런 모드가 아니라면
					//{
					//	if( M_X_FR_Sepa_UnClamp_Front_Sensor && M_X_FR_Sepa_UnClamp_Rear_Sensor )						// 언클램프 센서가 감지가 되었다면
					//	{
					//		L_PLC09_Auto_Starting_Timer = 0;															// 타이머 초기화
					//		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_9;									// 다음 스텝으로 이동
					//	}
					//	else																							// 언클램프 센서가 감지가 안된다면
					//	{
					//		M_Y_FR_Sepa_Clamp = 0;																//	파이널롤러 언클램프 
					//		M_Y_FR_Sepa_UnClamp = 1;																//	파이널롤러 언클램프 
					//	}
					//}
					//else																								// 적층을 안했다면 클램프 상태일테니
					//{

						L_PLC09_Auto_Starting_Timer = 0;																// 타이머 초기화
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_9;										// 다음 스텝으로 이동
					//}
				}
			break;

			case N_PLC09_PackML_Num_9:		// 비전 레디 트리거 ON
				if( L_PLC09_Auto_Starting_Timer > 50 )
				{
					L_PLC09_Auto_Starting_Timer = 0;																	// 타이머 초기화
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_10;											// 다음 스텝으로 이동
				}
			break;

			case N_PLC09_PackML_Num_10:		// 세파 텐션 필요 란
				if( L_PLC09_Auto_Starting_Timer > 50 )
				{
					/*
						1. 모터 루프 확인 후 오픈루프 변경
						2. 모터 
					
					*/
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_11;											// 다음 스텝으로 이동
				}
			break;

			case N_PLC09_PackML_Num_11:		// 생산속도 설정 
				Coord[1].DesTimeBase = Sys.ServoPeriod * ( P_Recipe_Speed_Value / 100 );								// 속도 동기화

				P_Act_Execute_Time_Out(0),N_Act_Execute_Define_Limit,1 = P_Act_Execute_Time_Out_Time * ( 100 / P_Recipe_Speed_Value );		// 설비 속도에 따른 모듈 타임아웃 시간 설정.	[ 참조 : 26.01.08 Execute 모듈 수정 ]
				P_Act_Hold_Time_Out(0),N_Act_Hold_Define_Limit,1 = P_Act_Hold_Time_Out_Time * ( 100 / P_Recipe_Speed_Value );				// 설비 속도에 따른 모듈 타임아웃 시간 설정.	[ 참조 : 26.01.08 Hold 모듈 수정 ]
				P_Act_Time_Out(0),N_Act_Define_Limit,1 = P_Act_Suspend_Time_Out_Time * ( 100 / P_Recipe_Speed_Value );						// 설비 속도에 따른 모듈 타임아웃 시간 설정.	[ 참조 : 26.01.08 Suspend 모듈 수정 ]
				P_Act_ALL_Home_Time_Out(0),N_Act_All_Home_Define_Limit,1 = P_Act_ALL_Home_Time_Out_Time * ( 100 / P_Recipe_Speed_Value );	// 설비 속도에 따른 모듈 타임아웃 시간 설정				
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_12;												// 다음 스텝으로 이동
				
			break;

			case N_PLC09_PackML_Num_12:		// 좌표계 ON
				//P_Stack_Heart_Bit_Sync_State_Machine = 1;																// 좌표계 ON
				// [ 참 조 : 2025.12.12 좌표계 ON Subprog 처리 ]
				P_Stack_Heart_Bit_Sync_Flag = 1;
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_13;												// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_13:		// 큐 사이즈 지정
				//if( P_Stack_Heart_Bit_Sync_State_Machine == 999 )														// 좌표계 ON 확인 후
				if( P_Stack_Heart_Bit_Sunc_Complete_Bit == N_TRUE )
				{
					P_Stack_Heart_Bit_Sunc_Complete_Bit = N_FALSE;														// 컴플리트 비트 OFF
					P_DryRun_Timer = 0;																					// 드라이런 진행 경과 타이머 초기화.	[ 참조 : 25.07.15 드라이런 진행 경과 타이머 수정 ]
					local L_Set_QueueSize = 0;
					call Sub_Automation_Circular_Queue.SizeQueue(N_Circluar_Queue_UseSize,&L_Set_QueueSize);
					if ( L_Set_QueueSize == N_CirQueue_TRUE )
					{
						//P_array_CF_Function_State_Number = N_PLC09_PackML_Num_14;										// 다음 스텝으로 이동
					}
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_14;											// 다음 스텝으로 이동
				}				
			break;

			case N_PLC09_PackML_Num_14:		// Sepa Line 필요 사항 
		
				call Initialize.PNP_Z_Axis_Recipe_to_Cnt();								//모터 위치 레시피에 따른 모터 카운트 계산 함수 호출	

				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_15;			// 다음 스텝으로 이동
																
			break;

			case N_PLC09_PackML_Num_15:		// Tact Time 초기화.	[ 참조 : 25.09.09 
				P_Tact_Time_Check(0),N_Tact_Time_Value_End = 0;							// 초기화.
				P_Old_Tact_Time_Check(0),N_Tact_Time_Value_End = 0;						// 초기화.
				P_Sepa_To_Normal_Mode_Sync_Flag = 0;									// 세파 모드 → 일반 모드가 가능한 세파 모드 일 경우 Execute에서 싱크 맞추기 위한 플래그 변수 초기화. (Suspend → Execute가 되는 상황에서만 플래그 실행하기 위함) [ 참조 : 26.07.31 Pause_Resume 수정 ]
				P_Sepa_To_Normal_Mode_Sync_Err_Avoid = 0;								// Pause에서 Err를 피하기 위한 변수 초기화.	[ 참조 : 26.07.31 Pause_Resume 수정 ]
				if ( P_Buffer_Mode_Status_Sequence != N_Sepa_Consume_Status_Sequence )	// 세파 모드 아닐 경우.		[ 참조 : 26.07.31 Pause_Resume 수정 ]
				{
					P_PLC03_Seq_Pause_Start_Status = 0;									// Sync 맞추기.
					P_PLC03_Seq_Pause_Start_Flag = 1;									// Sync 맞추기.
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_16;			// 다음 스텝으로 이동
				}
				else																	// 세파 모드 일 경우.	 (Sync 맞추지 않음)
				{
					P_array_CF_Function_Run_Flag = 2;									// 서브프로그램이 완료를 알림
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;			// 스텝 초기화
				}
			break;

			case N_PLC09_PackML_Num_16:		// Sepa Line 필요 사항 
				if( P_PLC03_Seq_Pause_Start_Status == F_Status_COMPLETE )
				{
					//P_Seq_Starting_Pause = 0
					P_array_CF_Function_Run_Flag = 2;										// 서브프로그램이 완료를 알림
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;				// 스텝 초기화
				}
			break;
		}
	}
//-----------------------------------------------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//-----------------------------------------------------------------------------------------------------
	// 3-1) 정상 종료 표시.		
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}

//=========================================================================================================================
//	01.3. Automatic Mode - EXECUTE
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_EXECUTE )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_EXECUTE;	
	}
}

//=========================================================================================================================
//	01.4. Automatic Mode - COMPLETING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_COMPLETING )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_COMPLETING;	
	}
}
//=========================================================================================================================
//	01.5. Automatic Mode - COMPLETE
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_COMPLETE )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_COMPLETE;	
	}
}

//===============================================================================
//	6. Automatic Mode - RESETTING
//=====================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_RESETTING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
	{	
		P_array_CF_Function_Start_Flag = 1;																					// 서브 프로그램 진입 플래그 (프로그램이 실행되었음을 표시)
		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;															// 서브 프로그램 스텟머신 활성화
	}
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
// 1. 타겟 포지션 업데이트
// 2. 타임 베이스 설정
// 3. 케스케이딩 확인
// 4. 정위치 확인
// 5. 가상축 확인
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )											//  서브프로그램 진입
	{		
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;

			case N_PLC09_PackML_Num_1:
				P_array_CF_Function_Run_Flag = 1;																			// 서브 프로그램 시작됨을 알림
				P_Motion_Target_Position_Complete = 0;																		// 변수 초기화 
				//call Sub_Motion_Target_Position();																			// 타겟 포지션 함수 호출
				if( P_Motion_Target_Position_Complete == 1 )
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;												// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_2:
				
			break;
		}
		
	}
//-----------------------------------------------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//-----------------------------------------------------------------------------------------------------
	// 3-1) 정상 종료 표시.		
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}
//=====================================================================================================		
//=========================================================================================================================
//	01.7. Automatic Mode - HOLDING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_HOLDING )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_HOLDING;	
	}
}
//=========================================================================================================================
//	01.8. Automatic Mode - HOLD
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_HOLD )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_HOLD;
	}	
}
//=========================================================================================================================
//	01.9. Automatic Mode - UNHOLDING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_UNHOLDING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )
	{	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
		// 프로그램이 실행되었음을 표시
		P_array_CF_Function_Start_Flag = 1;																// 서브 프로그램 진입 플래그

		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;										// 서브 프로그램 스텟머신 활성화
	}
	
	//-----------------------------------------------------------------------------------------------------
	//코드 추가로 들어가는 부분
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;

			case N_PLC09_PackML_Num_1:
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;
			break;

			case N_PLC09_PackML_Num_2:
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;
			break;

			case N_PLC09_PackML_Num_3:
				P_array_CF_Function_Run_Flag = 2;															// 서브프로그램이 완료를 알림
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;
			break;
		}	
	}
	//-----------------------------------------------------------------------------------------------------
//------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//------------------------------------------------------------	
	// 3-1) 정상 종료 표시.		
	if ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	if ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	if ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}

//=========================================================================================================================
//	01.10. Automatic Mode - SUSPENDING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_SUSPENDING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )
	{	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
		// 프로그램이 실행되었음을 표시
		P_array_CF_Function_Start_Flag = 1;																			// 서브 프로그램 진입 플래그

		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;													// 서브 프로그램 스텟머신 활성화
	}
	
//-----------------------------------------------------------------------------------------------------
	//코드 추가로 들어가는 부분
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;

			case N_PLC09_PackML_Num_1:
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;
			break;

			case N_PLC09_PackML_Num_2:
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;
			break;

			case N_PLC09_PackML_Num_3:
				P_array_CF_Function_Run_Flag = 2;																// 서브프로그램이 완료를 알림
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;
			break;
		}	
	}
	//-----------------------------------------------------------------------------------------------------
//------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//------------------------------------------------------------	
	// 3-1) 정상 종료 표시.		
	if ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	if ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	if ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}
//=========================================================================================================================
//	01.11. Automatic Mode - SUSPENDED
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_SUSPENDED )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_SUSPENDED;	
	}
}
