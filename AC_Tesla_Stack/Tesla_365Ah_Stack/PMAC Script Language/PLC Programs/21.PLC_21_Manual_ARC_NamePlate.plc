 
 // Manual ARC PLC Script 
 // Name Plate & BTN PLC Script

open plc 21
 #define	L_System_Timer				Sys.Time			// 시스템 타이머

	Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[21].ldata.L[0] 시간 체크 시작 시간
	Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[21].ldata.L[1] 시간 체크 종료 시간
	Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[21].ldata.L[2] 시작과 종료 시간 사이의 시간
	Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[21].ldata.L[3] 타이머 초기화 플래그
	local	L_ARC_Ready_Check_Timer;						// Plc[21].ldata.L[6]	레디 체크 타이머
	local	L_ARC_Ready_Check_Interval_Time = 5;			// Plc[21].ldata.L[7]	인터벌 타이머
	local	L_Two_Btn_Interlock_Timer;						// Plc[21].ldata.L[8] 투버튼 인터락 타이머
	local	L_Old_Two_Btn_Signal;							// Plc[21].ldata.L[9] 투버튼 Old 변수
//========================================================================================================================
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 01.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 01.3) 시간 업데이트
if (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	
	L_ARC_Ready_Check_Timer = L_ARC_Ready_Check_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Two_Btn_Interlock_Timer = L_Two_Btn_Interlock_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//========================================================================================================================

//=======================================//
// ARC 버튼 인터락 [ UI Touch, NP Plate ]// [ 참조 : 버튼 프로그램 추가 (ARC BTN 동작, 인터락, NP Plate Lamp) ]
//=====================================//
// 버튼 입력 처리 부 ========================================================================================
// ARC 버튼 인터락 시작.
// M_X_ARC_NP_Plate_Select		->  기존 Master ctrl 버튼이 Two btn으로 변경되면서 그 기능으로 사용 하게 함.

//===========================================
// NamePlate or GUI BTN 감지
//===========================================
// M_X_ARC_Door_Signal 도어 신호를 보고 On 해야하나?

if( M_Function_BTN_2.Sepa_ARC_Touch_Use == 1 )		// Toggle 
{
	M_Y_ARC_NP_Two_Btn_Signal = 0;		// NP Plate 버튼 누를 시 Lamp OFF.
	P_ARC_NP_Push_BTN = N_FALSE;
	P_ARC_UI_Push_BTN = N_TRUE;

}
else if( M_X_ARC_NP_Two_Btn_Signal == 1 && L_Old_Two_Btn_Signal == 0 && def_Name_Plate_Btn_Input == 0)	// Push Btn												// NP Plate 우선권 버튼이 눌렸을 경우.
{
	M_Y_ARC_NP_Two_Btn_Signal = 1;		// NP Plate 버튼 누를 시 Lamp ON.
	P_ARC_NP_Push_BTN = N_TRUE;																	// 인터락 실행.
	P_ARC_UI_Push_BTN = N_FALSE;
	L_Two_Btn_Interlock_Timer = 0;
	P_Two_Btn_Active_Flag = 1;
}
else if((M_X_ARC_NP_BTN_Unwinder_Rotation == 1 || M_X_ARC_NP_BTN_Unwinder_Re_Rotation == 1) && M_X_ARC_NP_Two_Btn_Signal == 1)	// Hold (버튼 누르고 있음
{
	P_NP_Unwinder_Active_Hold = 1;
	P_Two_Btn_Active_Flag = 0;
}
else if((M_X_ARC_NP_Two_Btn_Signal == 0 && L_Old_Two_Btn_Signal == 1) || (L_Two_Btn_Interlock_Timer > P_Two_Btn_Interlock_Time))
{
	M_Y_ARC_NP_Two_Btn_Signal = 0;		// NP Plate 버튼 누를 시 Lamp OFF.
	P_Two_Btn_Active_Flag = 0;
	P_ARC_NP_Push_BTN = N_FALSE;
	P_ARC_UI_Push_BTN = N_FALSE;
	P_NP_Unwinder_Active_Hold = 0;
}

L_Old_Two_Btn_Signal = M_X_ARC_NP_Two_Btn_Signal;

//===========================================
// NamePlate or GUI 행동 처리
//===========================================
// Name Plate가 우선
if( P_ARC_NP_Push_BTN == N_TRUE ) 																// NP : O 
{
	P_UI_ARC_InterLock = 0;																		// 0 : 인터락	1 : 인터락 해제
	if( M_X_ARC_NP_Auto_Reel_Change_Upper == 1 )												// Name Plate 선택과 Spool 번호가 일치하는지 위하여 조건 나눔
	{
		if( P_Selected_Spool_Number != N_UNWINDER_UPPER )										// 현재 구동 및 선택된 Spool 과 NamePlate 선택이 일치 하지않다면,
		{
			P_NP_Spool_Number = N_UNWINDER_UPPER;												// NP Plate 상부 지정.
		}
	}
	else if( M_X_ARC_NP_Auto_Reel_Change_Lower == 1 )											// Name Plate 선택과 Spool 번호가 일치하는지 위하여 조건 나눔
	{
		if( P_Selected_Spool_Number != N_UNWINDER_LOWER )										// 현재 구동 및 선택된 Spool 과 NamePlate 선택이 일치 하지않다면,
		{
			P_NP_Spool_Number = N_UNWINDER_LOWER;												// NP Plate 상부 지정.
		}
	}
}	
else if( P_ARC_UI_Push_BTN == N_TRUE )															// NP : X  GUI : O  
{
	P_NP_Spool_Number = 0;																		// NP Plate 인터락.
	if( P_Selected_Spool_Number == N_UNWINDER_UPPER )											// 상단 언와인더를 사용한다면
	{	
		// 상단 ARC BTN InterLock	
		// 인터락 활성화 ( 동작x ) : 0 ,		비활성화 : 1
		F_ARC_Upper_Chuck = 1;			//u.user:$0147E0.16 = 1 ;			// 상단 와인더 잠금 인터락
		F_ARC_Upper_UnChuck = 0;		//u.user:$0147E0.17 = 0 ;			// 상단 와인더 잠금 해제
		//F_ARC_Nip_FWD = 0;			//u.user:$0147F0.0 = 0;				// 닙롤 전진상태		
		//F_ARC_Nip_BWD = 0;			//u.user:$0147F0.1 = 1;				// 닙롤 후진상태
		F_ARC_Upper_Plate_Up = 1;		//u.user:$0147F0.2 = 1;				// 상부 플레이트 상승
		F_ARC_Upper_Plate_Down = 0;		//u.user:$0147F0.3 = 0;				// 상부 플레이트 하강
		F_ARC_Upper_Tilting_0 = 1;		//u.user:$0147F0.6 = 1;				// 상부 틸팅 0도
		F_ARC_Upper_Tilting_90 = 0;		//u.user:$0147F0.7 = 0;				// 상부 틸팅 90도 
		F_ARC_Upper_Cutter_FWD = 0;		//u.user:$0147F0.10 = 0;			// 상부 커터 전진
		F_ARC_Upper_Cutter_BWD = 1;		//u.user:$0147F0.11 = 1;			// 상부 커터 후진
		F_ARC_Upper_Clamp = 0;			//u.user:$0147F0.14 = 0;			// 상부 클램프 
		F_ARC_Upper_UnClamp = 1;		//u.user:$0147F0.15 = 1;			// 상부 언클램프
		F_ARC_Upper_Vac = 0;			//u.user:$0147F0.18 = 0;			// 상부 플레이트 흡착
		F_ARC_Upper_Off = 0;			//u.user:$0147F0.19 = 0;			// 상부 플레이트 off
		F_ARC_Upper_Blow = 0;			//u.user:$0147F0.20 = 0;			// 상부 플레이트 블로우
			
		F_ARC_Lower_Chuck = 1;			//u.user:$0147E0.18 = 1;			// 하단 와인더 잠금 
		F_ARC_Lower_UnChuck = 1;		//u.user:$0147E0.19 = 1;			// 하단 와인더 잠금 해제			
		F_ARC_Lower_Plate_Up = 1;		//u.user:$0147F0.4 = 1;				// 하부 플레이트 상승
		F_ARC_Lower_Plate_Down = 1;		//u.user:$0147F0.5 = 1;				// 하부 플레이트 하강
		F_ARC_Lower_Tilting_0 = 1;		//u.user:$0147F0.8 = 1;				// 하부 틸팅 0도
		F_ARC_Lower_Tilting_90 = 1;		//u.user:$0147F0.9 = 1;				// 하부 틸팅 90도 
		F_ARC_Lower_Cutter_FWD = 1;		//u.user:$0147F0.12 = 1;			// 하부 커터 전진
		F_ARC_Lower_Cutter_BWD = 1;		//u.user:$0147F0.13 = 1;			// 하부 커터 후진
		F_ARC_Lower_UnClamp = 1;		//u.user:$0147F0.16 = 1;			// 하부 언클램프 
		F_ARC_Lower_Clamp = 1;			//u.user:$0147F0.17 = 1;			// 하부 클램프
		F_ARC_Lower_Vac = 1;			//u.user:$0147F0.21 = 1;			// 하부 플레이트 흡착
		F_ARC_Lower_Off	= 1;			//u.user:$0147F0.22 = 1;			// 하부 플레이트 off
		F_ARC_Lower_Blow = 1;			//u.user:$0147F0.23 = 1;			// 하부 플레이트 블로우
	
		// ↓ 하부 선택하고 상부 틸팅 및 플레이트 움직인 후 상부로 바꿔서 하부 틸팅 및 플레이트를 움직일 수 있으므로 막아주는 곳
		if( ARC_Plate_Warning == N_TRUE )					// 상부 또는 하부가 전진되어 있을 경우
		{
			F_ARC_Lower_Tilting_0 = 1;						// 하부 플레이트 틸팅 인터락
			F_ARC_Lower_Tilting_90 = 0;						// 하부 플레이트 틸팅 인터락 
			F_ARC_Lower_Plate_Up = 0;						// 하부 플레이트 전진 인터락
			F_ARC_Lower_Plate_Down = 1;						// 하부 플레이트 전진 인터락
		}
		if( ARC_Clamp_Warning == N_TRUE )					// 상,하부 클램프 상태 일 경우
		{
			F_ARC_Lower_Tilting_0 = 0;						// 하부 플레이트 틸팅 인터락
			F_ARC_Lower_Tilting_90 = 0;						// 하부 플레이트 틸팅 인터락
		}
		if( ARC_Tilting_Warning == N_TRUE )					// 상부 또는 하부가 틸팅되어 있을 경우
		{
			F_ARC_Lower_Tilting_0 = 1;						// 하부 플레이트 틸팅 인터락
			F_ARC_Lower_Tilting_90 = 0;						// 하부 플레이트 틸팅 인터락
			F_ARC_Lower_Plate_Up = 0;						// 하부 플레이트 전진 인터락
			F_ARC_Lower_Plate_Down = 1;						// 하부 플레이트 전진 인터락
			F_ARC_Lower_Clamp = 0;							// 하부 플레이트 클램프 인터락
			F_ARC_Lower_UnClamp = 1;						// 하부 플레이트 클램프 인터락
		}	
	}
	else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )										// 하단 언와인더를 사용한다면																		
	{
		// 하단 ARC BTN InterLock
		F_ARC_Lower_Chuck = 1;			//u.user:$0147E0.18 = 1;			// 하단 와인더 잠금 
		F_ARC_Lower_UnChuck = 0;		//u.user:$0147E0.19 = 0;			// 하단 와인더 잠금 해제
		//F_ARC_Nip_FWD = 0;			//u.user:$0147F0.0 = 0;				// 닙롤 전진상태		
		//F_ARC_Nip_BWD = 1;			//u.user:$0147F0.1 = 1;				// 닙롤 후진상태		
		F_ARC_Lower_Plate_Up = 0;		//u.user:$0147F0.4 = 0;				// 하부 플레이트 상승
		F_ARC_Lower_Plate_Down = 1;		//u.user:$0147F0.5 = 1;				// 하부 플레이트 하강
		F_ARC_Lower_Tilting_0 = 1;		//u.user:$0147F0.8 = 1;				// 하부 틸팅 0도
		F_ARC_Lower_Tilting_90 = 0;		//u.user:$0147F0.9 = 0;				// 하부 틸팅 90도 
		F_ARC_Lower_Cutter_FWD = 0;		//u.user:$0147F0.12 = 0;			// 하부 커터 전진
		F_ARC_Lower_Cutter_BWD = 1;		//u.user:$0147F0.13 = 1;			// 하부 커터 후진
		F_ARC_Lower_UnClamp = 1;		//u.user:$0147F0.16 = 1;			// 하부 언클램프 
		F_ARC_Lower_Clamp = 0;			//u.user:$0147F0.17 = 0;			// 하부 클램프
		F_ARC_Lower_Vac = 0;			//u.user:$0147F0.21 = 0;			// 하부 플레이트 흡착
		F_ARC_Lower_Off	= 0;			//u.user:$0147F0.22 = 0;			// 하부 플레이트 off
		F_ARC_Lower_Blow = 0;			//u.user:$0147F0.23 = 0;			// 하부 플레이트 블로우
	
		F_ARC_Upper_Chuck = 1;			//u.user:$0147E0.16 = 1 ;			// 상단 와인더 잠금 인터락
		F_ARC_Upper_UnChuck = 1;		//u.user:$0147E0.17 = 1 ;			// 상단 와인더 잠금 해제
		F_ARC_Upper_Plate_Up = 1;		//u.user:$0147F0.2 = 1;				// 상부 플레이트 상승
		F_ARC_Upper_Plate_Down = 1;		//u.user:$0147F0.3 = 1;				// 상부 플레이트 하강
		F_ARC_Upper_Tilting_0 = 1;		//u.user:$0147F0.6 = 1;				// 상부 틸팅 0도
		F_ARC_Upper_Tilting_90 = 1;		//u.user:$0147F0.7 = 1;				// 상부 틸팅 90도 
		F_ARC_Upper_Cutter_FWD = 1;		//u.user:$0147F0.10 = 1;			// 상부 커터 전진
		F_ARC_Upper_Cutter_BWD = 1;		//u.user:$0147F0.11 = 1;			// 상부 커터 후진
		F_ARC_Upper_Clamp = 1;			//u.user:$0147F0.14 = 1;			// 상부 클램프 
		F_ARC_Upper_UnClamp = 1;		//u.user:$0147F0.15 = 1;			// 상부 언클램프
		F_ARC_Upper_Vac = 1;			//u.user:$0147F0.18 = 1;			// 상부 플레이트 흡착
		F_ARC_Upper_Off = 1;			//u.user:$0147F0.19 = 1;			// 상부 플레이트 off
		F_ARC_Upper_Blow = 1;			//u.user:$0147F0.20 = 1;			// 상부 플레이트 블로우
	
		// ↓ 상부 선택하고 하부 틸팅 및 플레이트 움직인 후 상부로 바꿔서 상부 틸팅 및 플레이트를 움직일 수 있으므로 막아주는 곳						
		
		if( ARC_Plate_Warning == N_TRUE )					// 상부 또는 하부가 전진되어 있을 경우
		{
			F_ARC_Upper_Tilting_0 = 1;						// 상부 플레이트 틸팅 인터락
			F_ARC_Upper_Tilting_90 = 0;						// 상부 플레이트 틸팅 인터락 
			F_ARC_Upper_Plate_Up = 1;						// 상부 플레이트 전진 인터락
			F_ARC_Upper_Plate_Down = 0;						// 상부 플레이트 전진 인터락
		}
		if( ARC_Clamp_Warning == N_TRUE )					// 상,하부 클램프 상태 일 경우
		{
			F_ARC_Upper_Tilting_0 = 0;						// 상부 플레이트 틸팅 인터락
			F_ARC_Upper_Tilting_90 = 0;						// 상부 플레이트 틸팅 인터락
		}
		if( ARC_Tilting_Warning == N_TRUE )					// 상부 또는 하부가 틸팅되어 있을 경우
		{
			F_ARC_Upper_Tilting_0 = 1;						// 하부 플레이트 틸팅 인터락				
			F_ARC_Upper_Tilting_90 = 0;						// 하부 플레이트 틸팅 인터락
			F_ARC_Upper_Plate_Up = 1;						// 하부 플레이트 전진 인터락
			F_ARC_Upper_Plate_Down = 0;						// 하부 플레이트 전진 인터락
			F_ARC_Upper_Clamp = 0;							// 하부 플레이트 클램프 인터락
			F_ARC_Upper_UnClamp = 1;						// 하부 플레이트 클램프 인터락
		}	
	}
}
else														// NP : X  GUI : X
{
	P_UI_ARC_InterLock = 0;									// 0 : 인터락	1 : 인터락 해제
	P_NP_Spool_Number = 0;									// NP Plate 인터락.
}
//===========================================
// NamePlate Action -> BG.C 에서 PLC Script로 변경
//===========================================
// 네임플레이트 실린더 동작 처리
if( P_Two_Btn_Active_Flag == 1 )	// TwoBtn 눌렸을 시, NamePlate BTN 감시
{
	switch( P_NP_Spool_Number )				// Name Plate Select Data → P_NP_Spool_Number 값은 위에서 판단하여 넣어준다. 
	{
		case N_UNWINDER_UPPER:
				// 각각의 Spool 번호와, 행위들 넣어주고, BTN값을 인자로 넣어서 공통 함수로 사용하려 했지만, 보기 불편할 수 있으니..
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Chuck);				// M_X_ARC_NP_BTN_Unwinder_Lock_Unlock
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Tilting);			// M_X_ARC_NP_BTN_Plate_Tilting
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Plate_Vac);			// M_X_ARC_NP_BTN_Plate_Vac_On_Off
				//call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Jog_Plus);			// M_X_ARC_NP_BTN_Unwinder_Rotation
				//call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Jog_Minus);			// M_X_ARC_NP_BTN_Unwinder_Re_Rotation
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Plate_Up_Dn);		// M_X_ARC_NP_BTN_Plate_Tilting
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Plate_Cut);			// M_X_ARC_NP_BTN_Plate_Sepa_Cutting
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Plate_Stopper);		// M_X_ARC_NP_BTN_Plate_Stopper_Clamp
		break;

		case N_UNWINDER_LOWER:
				// 각각의 Spool 번호와, 행위들 넣어주고, BTN값을 인자로 넣어서 공통 함수로 사용하려 했지만, 보기 불편할 수 있으니..
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Chuck);				// M_X_ARC_NP_BTN_Unwinder_Lock_Unlock
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Tilting);			// M_X_ARC_NP_BTN_Plate_Tilting
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Plate_Vac);			// M_X_ARC_NP_BTN_Plate_Vac_On_Off
				//call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Jog_Plus);			// M_X_ARC_NP_BTN_Unwinder_Rotation
				//call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Jog_Minus);			// M_X_ARC_NP_BTN_Unwinder_Re_Rotation
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Plate_Up_Dn);		// M_X_ARC_NP_BTN_Plate_Tilting
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Plate_Cut);			// M_X_ARC_NP_BTN_Plate_Sepa_Cutting
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Plate_Stopper);		// M_X_ARC_NP_BTN_Plate_Stopper_Clamp
		break;

		default: break;
	}
}

// 언와인더 동작 처리
if(P_NP_Unwinder_Active_Hold == 1)
{
	switch( P_NP_Spool_Number )				// Name Plate Select Data → P_NP_Spool_Number 값은 위에서 판단하여 넣어준다. 
	{
		case N_UNWINDER_UPPER:
				// 각각의 Spool 번호와, 행위들 넣어주고, BTN값을 인자로 넣어서 공통 함수로 사용하려 했지만, 보기 불편할 수 있으니..
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Jog_Plus);			// M_X_ARC_NP_BTN_Unwinder_Rotation
				call NP_Func.Act_Func(N_UNWINDER_UPPER,N_NP_Jog_Minus);			// M_X_ARC_NP_BTN_Unwinder_Re_Rotation
		break;

		case N_UNWINDER_LOWER:
				// 각각의 Spool 번호와, 행위들 넣어주고, BTN값을 인자로 넣어서 공통 함수로 사용하려 했지만, 보기 불편할 수 있으니..
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Jog_Plus);			// M_X_ARC_NP_BTN_Unwinder_Rotation
				call NP_Func.Act_Func(N_UNWINDER_LOWER,N_NP_Jog_Minus);			// M_X_ARC_NP_BTN_Unwinder_Re_Rotation
		break;

		default: break;
	}
}
else
{
	if( P_Edge_Upper_Sensor(6) | P_Edge_Upper_Sensor(7) )						// Two Btn 먼저 손을 떼고, Jog 명령이 나갔다면 
	{
		P_Edge_Upper_Sensor(6) = 0;
		P_Edge_Upper_Sensor(7) = 0;
		cmd"#%d j/",N_UNWINDER_UPPER;
	}
	if( P_Edge_Lower_Sensor(6) | P_Edge_Lower_Sensor(7) )						// Two Btn 먼저 손을 떼고, Jog 명령이 나갔다면 
	{
		P_Edge_Lower_Sensor(6) = 0;
		P_Edge_Lower_Sensor(7) = 0;
		cmd"#%d j/",N_UNWINDER_LOWER;
	}

	P_NP_Spool_Number = 0;
}

// Jog BTN 엣지 업데이트 
P_Old_Upper_Sensor(6) = M_X_ARC_NP_BTN_Unwinder_Rotation;
P_Old_Upper_Sensor(7) = M_X_ARC_NP_BTN_Unwinder_Re_Rotation;
P_Old_Lower_Sensor(6) = M_X_ARC_NP_BTN_Unwinder_Rotation;
P_Old_Lower_Sensor(7) = M_X_ARC_NP_BTN_Unwinder_Re_Rotation;

//==================================================================//
// [ 참조 : 버튼 프로그램 추가 (ARC BTN 동작, 인터락, NP Plate Lamp) ]//
//================================================================//==========================================================================//
/* [search / ㄴㄷㅁㄱ]
-----------------------------------------------------------------------------------------------------------------------------------------------
|			|  Ready  |  Tilting  |  Lock  |  Rotation  |  Re_Rotation  |   Vac   |							조		건						  |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  1st_Step |   Off   |    Off    |  Blink |	 Off    |      Off      |   Off   |		언와인더 언척											  |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  2nd_Step |   Off   |     On    |   On   |	 Off    |      Off      |  Blink  |		언와인더 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 OFF    |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  3rd_Step |  Blink  |     On    |   On   |     Off    |      Off      |   Off   |		언와인더 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 ON	  |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  4th_Step |   Off   |   Blink   |   On   |	 Off    |      Off      |   Off   |		언와인더 척 + 틸팅 0도								  |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  5th_Step |   Off   |     On    |   On   |	 Off    |      Off      |  Blink  |		언와인더 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF   |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  6th_Step |   Off   |   Blink   |   On   |	 Off    |      Off      |    On   |		언와인더 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON    |
|---------------------------------------------------------------------------------------------------------------------------------------------|
|  7th_Step |   Off   |     On    |   On   |	Blink   |     Blink     |  Blink  |		언와인더 척 + 틸팅 90도								  |
-----------------------------------------------------------------------------------------------------------------------------------------------*/
//============================================================================================================================================//
// 네임 플레이트 상,하부 변경 시 처음 램프 초기화 진행.		// [ 참조 : 26.04.24 ARC 네임 플레이트 램프 수정 ]
if ( M_X_ARC_NP_Auto_Reel_Change_Upper == 1 && P_Edge_NP_BTN(0) == 0 )
{
	call ARC_NP_Lamp.Lamp_Clear();
	P_Edge_NP_BTN(0) = 1;
}
else if ( M_X_ARC_NP_Auto_Reel_Change_Upper == 0 )
{
	P_Edge_NP_BTN(0) = 0;
}
if ( M_X_ARC_NP_Auto_Reel_Change_Lower == 1 && P_Edge_NP_BTN(1) == 0 )
{
	call ARC_NP_Lamp.Lamp_Clear();
	P_Edge_NP_BTN(1) = 1;
}
else if ( M_X_ARC_NP_Auto_Reel_Change_Lower == 0 )
{
	P_Edge_NP_BTN(1) = 0;
}
//============================================================================================================================================//
if ( M_X_ARC_NP_Auto_Reel_Change_Upper == 1 && P_Selected_Spool_Number == N_UNWINDER_LOWER )			// 네임 플레이트 상부 방향 일 경우 + 언와인더 하부 선택 일 경우.
{
	//===================//
	// 조건 램프 프로그램 //
	//==================//
	if ( N_Upper_1st_Step )			// 상부 언척 => 척 점멸
		call ARC_NP_Lamp.Upper_1st_Step();	
	else if ( N_Upper_2nd_Step )	// 상부 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		call ARC_NP_Lamp.Upper_2nd_Step();
	else if ( N_Upper_3rd_Step )	// 상부 척 + 틸팅0도 + 진공 출력 ON + 진공 입력 ON => Ready 점멸, 틸팅 점등, 척 점등, 진공 점등
		call ARC_NP_Lamp.Upper_3rd_Step();
	else if ( N_Upper_4th_Step )	// 상부 척 + 틸팅 0도 => 척 점등, 틸팅 점멸
		call ARC_NP_Lamp.Upper_4th_Step();
	else if ( N_Upper_5th_Step )	// 상부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		call ARC_NP_Lamp.Upper_5th_Step();
	else if ( N_Upper_6th_Step )	// 상부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON => 틸팅 점멸, 척 점등, 진공 점등
		call ARC_NP_Lamp.Upper_6th_Step();
	else if ( N_Upper_7th_Step )	// 상부 척 + 틸팅 90도 => 틸팅 점등, 척 점등, 진공 램프 점멸, 정회전 점멸, 역회전 점멸
		call ARC_NP_Lamp.Upper_7th_Step();
	//=====================//
	// 비조건 램프 프로그램 //
	//====================//
	call ARC_NP_Lamp.Unconditional(ARC_NP_Upper_Check)	// 비조건 램프 프로그램 실행.
	P_ARC_NP_Lower_Ready_Check_Bit = 0;			// 하부 언와인더 선택 시 하부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
	if ( !(N_Upper_3rd_Step) )					// Ready 신호 점멸 or 점등 조건이 아닐 경우.
		P_ARC_NP_Upper_Ready_Check_Bit = 0;		// 상부 언와인더 선택 시 상부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]

	// 물리 푸쉬버튼 BTN 업데이트
	P_Edge_Upper_Sensor(0) = M_X_ARC_NP_BTN_Unwinder_Lock_Unlock;
	P_Edge_Upper_Sensor(1) = M_X_ARC_NP_BTN_Plate_Tilting;
	P_Edge_Upper_Sensor(2) = M_X_ARC_NP_BTN_Plate_Vac_On_Off;
	P_Edge_Upper_Sensor(3) = M_X_ARC_NP_BTN_Plate_Up_Dn;
	P_Edge_Upper_Sensor(4) = M_X_ARC_NP_BTN_Plate_Up_Dn;
	P_Edge_Upper_Sensor(5) = M_X_ARC_NP_BTN_Plate_Stopper_Clamp;
}
else if ( M_X_ARC_NP_Auto_Reel_Change_Upper == 1 && P_Selected_Spool_Number == N_UNWINDER_UPPER )		// 네임 플레이트 상부 방향 일 경우 + 언와인더 상부 선택 일 경우.
{
	call ARC_NP_Lamp.Lamp_Clear();
	if ( !(N_Lower_3rd_Step) )					// Ready 신호 점멸 or 점등 조건이 아닐 경우.	(NP 하부 상태에서 조건 만족 후 NP 상부로 돌린 다음 하부 Ready 조건이 풀렸을 때 초기화 하기 위함)
		P_ARC_NP_Lower_Ready_Check_Bit = 0;		// 상부 언와인더 선택 시 하부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
	P_ARC_NP_Upper_Ready_Check_Bit = 0;			// 상부 언와인더 선택 시 상부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
}

// 네임 플레이트 하부 일 경우.																																																																																									
if ( M_X_ARC_NP_Auto_Reel_Change_Lower == 1 && P_Selected_Spool_Number == N_UNWINDER_UPPER )			// 네임 플레이트 하부 방향 일 경우 + 언와인더 상부 선택 일 경우.
{
	//===================//
	// 조건 램프 프로그램 //
	//==================//
	if ( N_Lower_1st_Step )			// 하부 언척 => 척 점멸
		call ARC_NP_Lamp.Lower_1st_Step();	
	else if ( N_Lower_2nd_Step )	// 하부 척 + 틸팅 0도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		call ARC_NP_Lamp.Lower_2nd_Step();
	else if ( N_Lower_3rd_Step )	// 하부 척 + 틸팅0도 + 진공 출력 ON + 진공 입력 ON => Ready 점멸, 틸팅 점등, 척 점등, 진공 점등
		call ARC_NP_Lamp.Lower_3rd_Step();
	else if ( N_Lower_4th_Step )	// 하부 척 + 틸팅 0도 => 척 점등, 틸팅 점멸
		call ARC_NP_Lamp.Lower_4th_Step();
	else if ( N_Lower_5th_Step )	// 하부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 OFF => 틸팅 점등, 척 점등, 진공 점멸
		call ARC_NP_Lamp.Lower_5th_Step();
	else if ( N_Lower_6th_Step )	// 하부 척 + 틸팅 90도 + 진공 출력 ON + 진공 입력 ON => 틸팅 점멸, 척 점등, 진공 점등
		call ARC_NP_Lamp.Lower_6th_Step();
	else if ( N_Lower_7th_Step )	// 하부 척 + 틸팅 90도 => 틸팅 점등, 척 점등, 진공 램프 점멸, 정회전 점멸, 역회전 점멸
		call ARC_NP_Lamp.Lower_7th_Step();
	//=====================//
	// 비조건 램프 프로그램 //
	//====================//
	call ARC_NP_Lamp.Unconditional(ARC_NP_Lower_Check)	// 비조건 램프 프로그램 실행.
	P_ARC_NP_Upper_Ready_Check_Bit = 0;			// 상부 언와인더 선택 시 상부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
	if ( !(N_Lower_3rd_Step) )					// Ready 신호 점멸 or 점등 조건이 아닐 경우.
		P_ARC_NP_Lower_Ready_Check_Bit = 0;		// 상부 언와인더 선택 시 하부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
	// 물리 푸쉬버튼 BTN 업데이트
	P_Edge_Lower_Sensor(0) = M_X_ARC_NP_BTN_Unwinder_Lock_Unlock;
	P_Edge_Lower_Sensor(1) = M_X_ARC_NP_BTN_Plate_Tilting;
	P_Edge_Lower_Sensor(2) = M_X_ARC_NP_BTN_Plate_Vac_On_Off;
	P_Edge_Lower_Sensor(3) = M_X_ARC_NP_BTN_Plate_Up_Dn;
	P_Edge_Lower_Sensor(4) = M_X_ARC_NP_BTN_Plate_Up_Dn;
	P_Edge_Lower_Sensor(5) = M_X_ARC_NP_BTN_Plate_Stopper_Clamp;
}
else if ( M_X_ARC_NP_Auto_Reel_Change_Lower == 1 && P_Selected_Spool_Number == N_UNWINDER_LOWER )		// 네임 플레이트 하부 방향 일 경우 + 언와인더 하부 선택 일 경우.
{
	call ARC_NP_Lamp.Lamp_Clear();
	if ( !(N_Upper_3rd_Step) )					// Ready 신호 점멸 or 점등 조건이 아닐 경우.	(NP 하부 상태에서 조건 만족 후 NP 상부로 돌린 다음 하부 Ready 조건이 풀렸을 때 초기화 하기 위함)
		P_ARC_NP_Upper_Ready_Check_Bit = 0;		// 하부 언와인더 선택 시 상부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
	P_ARC_NP_Lower_Ready_Check_Bit = 0;			// 하부 언와인더 선택 시 하부 Ready 확인 비트 초기화.	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
}

// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
// ARC PLC READY SIGNAL → PMAC 내부 처리 
if( M_X_ARC_NP_BTN_Ready )												// ARC Ready BTN 눌리면
{
	call ARC_Motion_State_Function.ARC_Ready_Check();					// Ready 상태 체크 
}
if( L_ARC_Ready_Check_Timer >= L_ARC_Ready_Check_Interval_Time )
{
	L_ARC_Ready_Check_Timer = 0;										// ARC Ready Check Timer Init
	if( P_ARC_Ready_Flag(N_Upper) | P_ARC_Ready_Flag(N_Lower) )			// ARC upper lower Ready 되어있다면
		call ARC_Motion_State_Function.Monitoring_ARC_Ready_Flag();		// ARC Ready Flag 상태 확인
}


//=========================================================================================================================================================//
// 01) 메뉴얼 상태 + 버튼 처리부	2025.12.23 [ 참 조 : 2025.12.23 매뉴얼 ARC 버튼 추가 ]
//=========================================================================================================================================================//
IF ( P_PMAC_Current_Mode == F_Current_Manual && M_Manual_ARC_BTN != P_M_Manual_ARC_BTN && M_Manual_ARC_BTN == 1  )		// 버튼 상승엣지 감지 
{
	P_Buffer_Mode_Module_Status_Sequence(N_ARC_Module) = N_Normal_Status_Sequence;				// 매뉴얼 ARC는 한번만 들어가야되, 모드를 건

	switch( P_Selected_Spool_Number )
	{
		case N_UNWINDER_UPPER:																	// 현재 선택 된 세파가 상단 언와인더라면 하단 언와인더로 스위칭 해야하는 것이니까
			if( P_ARC_Ready_Flag(N_Lower) == N_TRUE && M_Y_Lower_Unwinder_Lock_Sol == N_TRUE )	// 레디 플래그와 언와인더 척이 되었다면	매뉴얼 ARC 가능하므로
			{
				if( Motor[N_SERVO_DANCER].ClosedLoop == 1 ){
					cmd"#%d out0",N_SERVO_DANCER;			//[ 참조 : 26.09.22 Manual ARC Dancer OpenLoop 변경 ]
					P_Suspend_ARC_Cmd = F_Command_Start;
				}
				else
					P_Suspend_ARC_Cmd = F_Command_Start;
			}
		break;

		case N_UNWINDER_LOWER:																	// 현재 선택 된 세파가 하단 언와인더라면 상단 언와인더로 스위칭 해야하는 것이니까
			if( P_ARC_Ready_Flag(N_Upper) == N_TRUE && M_Y_Upper_Unwinder_Lock_Sol == N_TRUE )	// 레디 플래그와 언와인더 척이 되었다면	매뉴얼 ARC 가능하므로
			{
				if( Motor[N_SERVO_DANCER].ClosedLoop == 1 ){
					cmd"#%d out0",N_SERVO_DANCER;			//[ 참조 : 26.09.22 Manual ARC Dancer OpenLoop 변경 ]
					P_Suspend_ARC_Cmd = F_Command_Start;
				}
				else
					P_Suspend_ARC_Cmd = F_Command_Start;
			}
		break;
	}
}
P_M_Manual_ARC_BTN = M_Manual_ARC_BTN;
//=========================================================================================================================================================//
// 01.1) 메뉴얼 상태 PLC02 번 모듈 이원화 실행부 - [ 참조 : 25.12.23 매뉴얼 ARC 동작부 보완 ]
//=========================================================================================================================================================//
IF ( P_PMAC_Current_Mode == F_Current_Manual )
{	
	IF ( P_Suspend_ARC_Cmd == F_Command_Start )												// 1)  ARC 모듈 실행 - PLC 1번에서 조건보고 실행 
	{																							   
		P_Suspend_ARC_Cmd = 0;																// 1.1) ARC 모듈 - 커맨드 초기화 (재진입 방지) 
		P_Suspend_ARC_Manual_ARC_Active_Popup_Flag = 1;										// 1.2) Manual ARC 진행 중 팝업 ON. [ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
		P_Act_Complete_Bit(N_Act_ARC_Pre_Act),20 = 0;										// 1.3) ARC 모듈 - 완료 비트 초기화.
		P_EXECUTE_Status_Prod_Sequence(N_ARC_Module) = F_Status_STARTING;					// 1.4) ARC 모듈 - 시작 상태 대입
																								   			
		P_Suspend_ARC_Status = N_TRUE;														// 1.5) ARC 모듈 - 시퀀스 모듈 실행 상태
		P_Suspend_ARC_Manual_Occur_Flag = 1;												// 1.6) ARC 모듈 - 시퀀스 커맨드 발생 변수		[ 참조 : 26.04.17 ARC 보완사항 수정 ]
	}	
}


// 틸팅 후 세파 걸고 언틸팅 동작 시 언와인더 풀어주도록 추가
if(P_Selected_Spool_Number == N_UNWINDER_LOWER)
{
	if( M_Y_Sepa_ARC_Upper_UnTilting_Sol == 1 && P_Old_ARC_Upper_Tilting_Status == 1)
	{
		Motor[N_UNWINDER_UPPER].jogspeed = 50;
		Motor[N_UNWINDER_UPPER].ProgJogPos = P_ARC_Tilting_Unwinder_Move_Dis * 1000;
		Jog23:*;
		//cmd"#23j: %f",P_ARC_Tilting_Unwinder_Move_Dis
	}
}
else if(P_Selected_Spool_Number == N_UNWINDER_UPPER)
{
	if( M_Y_Sepa_ARC_Lower_UnTilting_Sol == 1 && P_Old_ARC_Lower_Tilting_Status == 1)
	{
		Motor[N_UNWINDER_LOWER].jogspeed = 50;
		Motor[N_UNWINDER_LOWER].ProgJogPos = P_ARC_Tilting_Unwinder_Move_Dis * 1000;
		Jog24:*;
		//cmd"#24j: %f",P_ARC_Tilting_Unwinder_Move_Dis
	}
}

P_Old_ARC_Upper_Tilting_Status = M_Y_Sepa_ARC_Upper_Tilting_Sol;
P_Old_ARC_Lower_Tilting_Status = M_Y_Sepa_ARC_Lower_Tilting_Sol;
close
