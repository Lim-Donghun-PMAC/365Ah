				P_AH_Action_Type(0) = P_Recipe_G5_Action_Type_Type_1(0) 				// 그룹5의 멤버0은 #1// 동작타입 없음 
				P_AH_Action_Type(1) = P_Recipe_G5_Action_Type_Type_1(1) 				// 그룹5의 멤버1은 #2// +회피동작 
