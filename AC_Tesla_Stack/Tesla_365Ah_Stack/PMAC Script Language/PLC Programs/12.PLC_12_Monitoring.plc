// 옵저버 패턴 - [ 참조 : 25.07.02 옵저버 추가 ]
// 1. 명령 감시 옵저버
// 2. 진공 감시 옵저버 
// 3. 파기 감시 옵저버
// 자동 생산 상태 관리 프로그램 추가 [ 참조 : 2025.08.26 자동 생산 상태 관리 프로그램 추가] -김성중 선임
// PNP Z축 레시피 관리 프로그램 추가 [ 참조 : 2025.08.27 PNP Z축 레시피 관리 프로그램 추가 ] -김성중 선임
// Find : 중간배출무시
global P_Dry_Run_BTN = 0;
global P_Home_Angle_Offset_change_Bit = 0;

open plc 12
P_MNTR_PLC12_Task_Time(0) = Sys.Time;
#define	L_System_Timer				Sys.Time			// 시스템 타이머
Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[12].ldata.L[0]	시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[12].ldata.L[1]	시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[12].ldata.L[2]	시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[12].ldata.L[3]	타이머 초기화 플래그

// 비트화 변수 삽입 
 local L_PLC12_Cmd_Observer_rtn;						// Plc[12].ldata.L[4]	커맨드 감시 결과 변수
 local L_PMAC_Status;									// Plc[12].ldata.L[5]	 
 local L_Old_PMAC_Status;								// Plc[12].ldata.L[6]
 local L_Old_Queue;										// Plc[12].ldata.L[7]
 local L_Old_Step;										// Plc[12].ldata.L[8]
 local L_Old_Index;										// Plc[12].ldata.L[9]
 local L_Reentry;										// Plc[12].ldata.L[10]

 local L_PNP_Z_Recipe_Change;							// Plc[12].ldata.L[11]
 //local L_PNP_Z_Cnt_Read;								// Plc[12].ldata.L[12]
 //local L_PNP_Z_Count_Change;							// Plc[12].ldata.L[13]
 local L_X_SV_Enable_Timer;								// Plc[12].ldata.L[12]	QCP Save 딜레이 Timer
 local L_X_Trg_SV_Enable_From_PLC;						// Plc[12].ldata.L[13]	
 local L_Y_Cathode_AT_Vac_Ejector_Vac_On;				// Plc[12].ldata.L[14]	매뉴얼 때 진공 커맨드 엣지값 
 local L_Y_Anode_AT_Vac_Ejector_Vac_On;					// Plc[12].ldata.L[15]	매뉴얼 때 진공 커맨드 엣지값
 local L_Y_Cathode_1st_Vac_Sol_On;						// Plc[12].ldata.L[16]	매뉴얼 때 진공 커맨드 엣지값
 local L_Y_Cathode_2nd_Vac_Sol_On;						// Plc[12].ldata.L[17]	매뉴얼 때 진공 커맨드 엣지값
 local L_Y_Anode_1st_Vac_Sol_On;						// Plc[12].ldata.L[18]	매뉴얼 때 진공 커맨드 엣지값
 local L_Y_Anode_2nd_Vac_Sol_On;						// Plc[12].ldata.L[19]	매뉴얼 때 진공 커맨드 엣지값
 local L_Y_Cathode_NG_PNP_Ejector_Vac_On;				// Plc[12].ldata.L[20]	매뉴얼 때 진공 커맨드 엣지값
 local L_Y_Anode_NG_PNP_Ejector_Vac_On;					// Plc[12].ldata.L[21]	매뉴얼 때 진공 커맨드 엣지값
 local L_Resetting_Vac_Delay_Timer;						// Plc[12].ldata.L[22]
 local L_Heart_Bit_Timer;								// PLC[12].ldata.L[23]	하트비트 점멸 타이머	- [ 참조 : 26.01.19 하트비트 점멸 추가 ]
 local L_PMAC_Old_Mode;									// PLC[12].ldata.L[24]  이전 모드
 local L_Vac_Initialize_Timer;							// PLC[12].ldata.L[25]
 local L_motor_num;										// PLC[12].ldata.L[26]
 local L_PLC12_Start_Cnt;								// PLC[12].ldata.L[27]
 local L_old_Motor_Home_Offset(50);						// PLC[12].ldata.L[28~77] 필요없는 배열 만들기 싫은데.. 그냥 모터 번호에 맞게 처리하자
 //[ 참조 : 260513 : 양음극 릴컷부 도어 오픈 시 1차 PNP 인터락 ]
 local L_Old_M_X_PLC_Cathode_ReelCut_Door_Interlock;	// PLC[12].ldata.L[78]	//양극 릴컷 큰 도어 이전값 
 Local L_Old_M_X_PLC_Anode_ReelCut_Door_Interlock;		// PLC[12].ldata.L[79]	//음극 릴컷 큰 도어 이전값 
 local L_Old_M_X_PLC_Cathode_Small_Door_Close_Signal;	// PLC[12].ldata.L[80]	//양극 릴컷 작은 도어 이전값 
 Local L_Old_M_X_PLC_Anode_Small_Door_Close_Signal; 	// PLC[12].ldata.L[81]	//음극 릴컷 작은 도어 이전값 
 local L_Vac_Door_Clear_Bit = F_Vac_Blow_Alarm;			// PLC[12].ldata.L[82]
 local L_Vac_Bit_idx;									// PLC[12].ldata.L[83]
 local L_Vac_Door_Rtn;									// PLC[12].ldata.L[84]
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_PLC01_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_PLC01_System_Timer;
}

// 00.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_PLC01_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{
	L_X_SV_Enable_Timer = L_X_SV_Enable_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Resetting_Vac_Delay_Timer = L_Resetting_Vac_Delay_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	P_PLC12_Blow_1st_Cathode_MNTR_Timer = P_PLC12_Blow_1st_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_2nd_Cathode_MNTR_Timer = P_PLC12_Blow_2nd_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_NG_Cathode_MNTR_Timer = P_PLC12_Blow_NG_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_Align_Cathode_MNTR_Timer = P_PLC12_Blow_Align_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_1st_Anode_MNTR_Timer = P_PLC12_Blow_1st_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_2nd_Anode_MNTR_Timer = P_PLC12_Blow_2nd_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_NG_Anode_MNTR_Timer = P_PLC12_Blow_NG_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Blow_Align_Anode_MNTR_Timer = P_PLC12_Blow_Align_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	P_PLC12_Vacuum_1st_Cathode_MNTR_Timer = P_PLC12_Vacuum_1st_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_2nd_Cathode_MNTR_Timer = P_PLC12_Vacuum_2nd_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_NG_Cathode_MNTR_Timer = P_PLC12_Vacuum_NG_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_Align_Cathode_MNTR_Timer = P_PLC12_Vacuum_Align_Cathode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_1st_Anode_MNTR_Timer = P_PLC12_Vacuum_1st_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_2nd_Anode_MNTR_Timer = P_PLC12_Vacuum_2nd_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_NG_Anode_MNTR_Timer = P_PLC12_Vacuum_NG_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	P_PLC12_Vacuum_Align_Anode_MNTR_Timer = P_PLC12_Vacuum_Align_Anode_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Heart_Bit_Timer = L_Heart_Bit_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	P_Sepa_Cutter_SSR_Off_Timer = P_Sepa_Cutter_SSR_Off_Timer + L_Time_Cycle_Up_Count_Delta_Time

	L_Vac_Initialize_Timer = L_Vac_Initialize_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//========================================================================================================================
// Stack Algorithme 사용 MNTR
 if( P_PLC12_Frist == 0 )
 {	// 처음 시작 탑
	P_PLC12_Frist = 1;
	call stack_algorithm.Clear_(&P_Queue_stack_top);
	call stack_algorithm.Clear_(&P_Step_stack_top);
	call stack_algorithm.Clear_(&P_Index_stack_top);
	call stack_algorithm.Clear_(&P_Status_stack_top);
 }

// 1차 P&P 벨트에서 극판 픽업 할 때 하강 위치에서 + mm 상승시 Complete 신호 송신
// Start, Interlock 신호 해제
// [ 참조: 26.01.21 극판 인터페이스 추가 ]
if(P_PMAC_Current_Mode == F_Current_Automatic)
{
	// 연속 NG
	// 음극 얼라인 연속 NG
	if(P_Continuous_Call_Align_OK_Flag(N_Anode_Unit - 1) == 1)
	{
		P_Continuous_Call_Align_OK_Flag(N_Anode_Unit - 1) = 0
		call Continuous_NG.Anode_Align_NG(N_Inspection_OK, P_Anode_Align_Continuous_NG_Check_range);
	}
	else if(P_Continuous_Call_Align_NG_Flag(N_Anode_Unit - 1) == 1 || P_Continuous_Call_Align_TimeOut_Flag(N_Anode_Unit - 1) == 1)
	{
		P_Continuous_Call_Align_NG_Flag(N_Anode_Unit - 1) = 0
		P_Continuous_Call_Align_TimeOut_Flag(N_Anode_Unit - 1) = 0
		call Continuous_NG.Anode_Align_NG(N_Inspection_NG, P_Anode_Align_Continuous_NG_Check_range);
	}

	// 양극 얼라인 연속 NG
	if(P_Continuous_Call_Align_OK_Flag(N_Cathode_Unit - 1) == 1)
	{
		P_Continuous_Call_Align_OK_Flag(N_Cathode_Unit - 1) = 0
		call Continuous_NG.Cathode_Align_NG(N_Inspection_OK, P_Cathode_Align_Continuous_NG_Check_range);
	}
	else if(P_Continuous_Call_Align_NG_Flag(N_Cathode_Unit - 1) == 1 || P_Continuous_Call_Align_TimeOut_Flag(N_Cathode_Unit - 1) == 1)
	{
		P_Continuous_Call_Align_NG_Flag(N_Cathode_Unit - 1) = 0
		P_Continuous_Call_Align_TimeOut_Flag(N_Cathode_Unit - 1) = 0
		call Continuous_NG.Cathode_Align_NG(N_Inspection_NG, P_Cathode_Align_Continuous_NG_Check_range);
	}

	// 음극 표면검사 연속 NG
	if(P_Continuous_Call_Surface_OK_Flag(N_Anode_Unit - 1) == 1)
	{
		P_Continuous_Call_Surface_OK_Flag(N_Anode_Unit - 1) = 0
		call Continuous_NG.Anode_Surface_NG(N_Inspection_OK, P_Anode_Surface_Continuous_NG_Check_range);
	}
	else if(P_Continuous_Call_Surface_NG_Flag(N_Anode_Unit - 1) == 1 || P_Continuous_Call_Surface_TimeOut_Flag(N_Anode_Unit - 1) == 1)
	{
		P_Continuous_Call_Surface_NG_Flag(N_Anode_Unit - 1) = 0 
		P_Continuous_Call_Surface_TimeOut_Flag(N_Anode_Unit - 1) = 0
		call Continuous_NG.Anode_Surface_NG(N_Inspection_NG, P_Anode_Surface_Continuous_NG_Check_range);
	}

	// 양극 표면검사 연속 NG
	if(P_Continuous_Call_Surface_OK_Flag(N_Cathode_Unit - 1) == 1)
	{
		P_Continuous_Call_Surface_OK_Flag(N_Cathode_Unit - 1) = 0
		call Continuous_NG.Cathode_Surface_NG(N_Inspection_OK, P_Cathode_Surface_Continuous_NG_Check_range);
	}
	else if(P_Continuous_Call_Surface_NG_Flag(N_Cathode_Unit - 1) == 1 || P_Continuous_Call_Surface_TimeOut_Flag(N_Cathode_Unit - 1) == 1)
	{
		P_Continuous_Call_Surface_NG_Flag(N_Cathode_Unit - 1) = 0
		P_Continuous_Call_Surface_TimeOut_Flag(N_Cathode_Unit - 1) = 0
		call Continuous_NG.Cathode_Surface_NG(N_Inspection_NG, P_Cathode_Surface_Continuous_NG_Check_range);
	}

	// 스택 연속 NG
	// 260708 연속 ng 기준 시트 단위에서 젤리롤 단위로 변경 및 연속 ng 카운트 시점 변경하여 알람 발생 시점 배출 후 발생하게 수정
	//if(P_Continuous_Call_Stack_Flag(N_Inspection_OK - 1) == 1)
	if( P_Continuous_Call_Stack_OK_Flag == 1 )
	{
		P_Continuous_Call_Stack_OK_Flag = 0
		//P_Continuous_Call_Stack_Flag(N_Inspection_OK - 1) = 0
		call Continuous_NG.Stack_Table_NG(N_Inspection_OK, P_Stack_Align_Continuous_NG_Check_range);
	}
	//else if(P_Continuous_Call_Stack_Flag(N_Inspection_NG - 1) == 1 || P_Continuous_Call_Stack_Flag(N_Inspection_TimeOut - 1) == 1)
	else if( P_Continuous_Call_Stack_NG_Flag == 1 )
	{
		P_Continuous_Call_Stack_NG_Flag = 0
		//P_Continuous_Call_Stack_Flag(N_Inspection_NG - 1) = 0
		//P_Continuous_Call_Stack_Flag(N_Inspection_TimeOut - 1) = 0
		//if( P_Stack_Table_NG_Flag == 0 && P_Buf_Stack_NG_Flag == 0 )
			call Continuous_NG.Stack_Table_NG(N_Inspection_NG, P_Stack_Align_Continuous_NG_Check_range);
	}

	// [참조 : 260507 1차 언로더 대기 위치 시 2차 언로더 대기 위치로 내려올 수 있게 안전 위치 라는 IO 추가] - 여유있게 1mm로 설정
	if ( P_PMAC_Homing_CHK(N_UNLOADER_T) == 1 && (P_Motor_Current_Pos(N_UNLOADER_T) > P_1st_ULD_T_Wait - 1 && P_Motor_Current_Pos(N_UNLOADER_T) < P_1st_ULD_T_Wait + 1) )
	{			
		M_Y_PLC_1st_ULD_Wait_Pos = 1		// 1차 언로더 t축 대기 위치
	}
	else
	{
		M_Y_PLC_1st_ULD_Wait_Pos = 0		// 1차 언로더 t축 대기 위치 아님
	}
}
else
{
	M_Y_PLC_1st_ULD_Wait_Pos = 0		// plc에서 매뉴얼이면 off 시켜달라고 해서 추가
}

//============================================================================================================================================
// [3] 인터락 및 초기화 프로그램
//============================================================================================================================================
// 1) 메뉴얼 모드로 변경시 극판 관련 I/O 초기화
IF ( P_PMAC_Current_Mode == F_Current_Manual && L_PMAC_Old_Mode != F_Current_Manual )	
{	
	M_Y_PLC_A_Anode_Sheet_Start	= 0		
	M_Y_PLC_A_Anode_Sheet_Completed  = 0 
	M_Y_PLC_A_Anode_Interlock = 1    

	M_Y_PLC_A_Cathode_Sheet_Start = 0  
	M_Y_PLC_A_Cathode_Sheet_Completed = 0
	M_Y_PLC_A_Cathode_Interlock = 1 
} 
L_PMAC_Old_Mode = P_PMAC_Current_Mode;

// 모션, PLC04번에서 내보내는 루프와 비전측 촬상 루프 카운트 비교 Test

if(P_Vision_Anode_Trigger_Count_Reset_Complete_Flag == 1 && P_Vision_Anode_Trigger_Count_Reset_Flag == 1)
{
	P_Vision_Anode_Trigger_Count_Reset_Complete_Flag = 0;
	P_Vision_Anode_Trigger_Count_Reset_Flag = 0;
	P_Anode_Trigger_IO_Test_Vision_PLC_Loop = 0;
	P_Anode_Trigger_IO_Test_Motion_Loop = 0;
}

if(P_Vision_Cathode_Trigger_Count_Reset_Complete_Flag == 1 && P_Vision_Cathode_Trigger_Count_Reset_Flag == 1)
{
	P_Vision_Cathode_Trigger_Count_Reset_Complete_Flag = 0;
	P_Vision_Cathode_Trigger_Count_Reset_Flag = 0;
	P_Cathode_Trigger_IO_Test_Vision_PLC_Loop = 0;
	P_Cathode_Trigger_IO_Test_Motion_Loop = 0;
} 

if(P_Vision_Stack_Trigger_Count_Reset_Complete_Flag == 1 && P_Vision_Stack_Trigger_Count_Reset_Flag == 1)
{
	P_Vision_Stack_Trigger_Count_Reset_Complete_Flag = 0;
	P_Vision_Stack_Trigger_Count_Reset_Flag = 0;
	P_Stack_Trigger_IO_Test_Vision_PLC_Loop = 0;
	P_Stack_Trigger_IO_Test_Motion_Loop = 0;
}


//====================================================================================================
//Execute Management 
//====================================================================================================	
//-------------------------------------------------------
// 1. 메모리 관리 프로그램 
//-------------------------------------------------------
if ( P_SM_Status_Main_Memory_Management == 0 )
{
	// 초기화
	P_SM_Cell_Memory_Management = 0;			// 극판 현황 메모리 관리
	P_SM_Auto_Run_Status_Management = 0;		// 설비 상태 메모리 관리
	
	// 프로그램 시작 조건 (항시) 
	if ( P_PMAC_Current_Mode == F_Current_Automatic || P_PMAC_Current_Mode == F_Current_Manual )
	{
		P_SM_Status_Main_Memory_Management++;
	}	
}
// 명령 대기 (시작)
if ( P_SM_Status_Main_Memory_Management == 1 )
{
	P_SM_Status_Main_Memory_Management++;
}
if ( P_SM_Status_Main_Memory_Management == 2 )
{
	if ( P_SM_Cell_Memory_Management == 0 )
	{
		P_SM_Cell_Memory_Management = 1;			// 극판 메모리 관리 실행 
	}
	P_SM_Status_Main_Memory_Management++;
}
// 자동 생산 상태 관리 프로그램 시작
if ( P_SM_Status_Main_Memory_Management == 3 )
{
	if ( P_SM_Auto_Run_Status_Management == 0 )
	{
		P_SM_Auto_Run_Status_Management = 1;		// 여기서 자동 상태 관리 프로그램 실행 
	}
	P_SM_Status_Main_Memory_Management++;
}
// 리턴 (메모리 관리 프로그램 종료 감시)
if ( P_SM_Status_Main_Memory_Management == 4 )
{
	// 메모리 관리 프로그램 종료
	if ( P_PMAC_Current_Mode != F_Current_Automatic && P_PMAC_Current_Mode != F_Current_Manual )
	{
		P_SM_Status_Main_Memory_Management = 0;
	}
	// 조건이 아닐 경우
	else 
	{
		P_SM_Status_Main_Memory_Management = 1;	
	}
}

//-------------------------------------------------------
// 1 모드 관리 프로그램
//-------------------------------------------------------
if ( P_SM_Auto_Run_Status_Management == 0 )
{

}
// 1.2.1. 어떤 모드 상태 인지
if ( P_SM_Auto_Run_Status_Management == 1 )
{
	//[ 참조 : 25.07.04 버튼 관리 추가 ]
	if ( P_PMAC_Current_Mode == F_Current_Manual && P_Stack_Judgement_Memory != 1 )		// 메뉴얼 모드 일 때, 젤리롤 없을때만 변경 가능 (시점은 추후 추가)
	{	
		// plc에서 버튼 수정 해주면 주석 변경 필요
		if(M_Func_BTN.Sepa_Run_Mode == 1 && M_Option_Function_BTN.BTN_Dryrun_Mode == 1)	// 0) 사용자 세파모드, 드라이런 모드가 동시에 눌린다면,
		//if( P_BTN_Sepa_Stack_Mode == 1 && M_Option_Function_BTN.BTN_Dryrun_Mode == 1)	// 0) 사용자 세파모드, 드라이런 모드가 동시에 눌린다면,
		{
			// 둘다 눌려져있으면 알람발생!
		}
		else												// 0.1) 사용자 세파모드, 드라이런 모드가 동시에 눌리지 않았다면,
		{
			// plc에서 버튼 수정 해주면 주석 변경 필요
			if ( M_Func_BTN.Sepa_Run_Mode  == 1 )				// 1) 사용자 세파모드 버튼이 눌렸다면,
			//if( P_BTN_Sepa_Stack_Mode == 1 )
			{
				P_Com_User_Sepa_Consume_Mode_Flag = 1;		// → 사용자 세파모드 Flag ON
				P_Middle_Discharge_Ignore_User_Sepa_Mode_Check = 1;	// 사용자 세파모드 진행 후 중간 배출 무시를 켜기 위한 확인 변수.		[ 참조 : 26.05.13 중간 배출 무시 추가 ]
			}
			else											// 1.1) 사용자 세파모드 버튼이 눌리지 않았다면,
			{
				P_Com_User_Sepa_Consume_Mode_Flag = 0;		// → 사용자 세파모드 Flag OFF					
				P_Middle_Discharge_Ignore_User_Sepa_Mode_Check = 0;	// 사용자 세파모드 진행 후 중간 배출 무시를 켜기 위한 확인 변수.		[ 참조 : 26.05.13 중간 배출 무시 추가 ]		
			}
		
			if ( M_Option_Function_BTN.BTN_Dryrun_Mode == 1 || P_Dry_Run_BTN == 1 )					// 2) 드라이런 모드 버튼이 눌렸다면,
			{
				P_Com_Dry_Mode_Flag = 1;					// → 드라이런 모드 Flag ON
			}
			else											// 2.1) 드라이런 모드 버튼이 눌리지 않았다면,
			{
				P_Com_Dry_Mode_Flag = 0;					// → 드라이런 모드 Flag OFF
			}
	
			call Sub_Common_Function.Mode_Flag_Check();		// [ 참조 : 25.07.04 모드 체크 함수 추가 ] - Mode Flag 감시 및 버퍼 모드 결정, 적층 계속 진행 여부 결정
		}
		//고객사 요청으로 모션 슬레이브 다운 알람 시 팝업 창
		if( P_Coord_Motion_Prog_Down_Entering_Bit == 0 )		// 매뉴얼 상태이면서 리셋버튼 눌러야지 초기화
		{
			P_Minus_Limit_Detect_Popup_Flag = 0;
			P_Plus_Limit_Detect_Popup_Flag = 0;
			P_Fatal_Fe_Limit_Detect_Popup_Flag = 0;
		}
	}
	P_SM_Auto_Run_Status_Management++;
}
// 리턴 
if ( P_SM_Auto_Run_Status_Management == 2 )
{
	P_SM_Auto_Run_Status_Management = 1;
}


 // Observer MNTR =====================================================================================================================================================
 // 1. Command Stop or Abort 옵저버
	L_PLC12_Cmd_Observer_rtn = 0;
	//								↓  커맨드 감시 , private 상태 변수 , 결과값 
	call Pattern_Funtion.Observer(P_Old_PMAC_Commands,&L_PMAC_Status,&L_PLC12_Cmd_Observer_rtn);									// Stop Command or Abort 검사
	if( L_PLC12_Cmd_Observer_rtn == N_TRUE )
	{
		//L_PLC12_Cmd_Event_Status = F_Status_STARTING;																				// Stop Command 없으면 MNTR 시작
		P_Stack_Algorithme_Cmd_Event_Status = F_Status_STARTING;																	// Stack 알고리즘 상태 시작
	}
	else
	{
		//L_PLC12_Cmd_Event_Status = F_Status_STOPPING;																				// Stop Command 있으면 MNTR 중지
		//L_PLC12_Cmd_Data_Event_Status = F_Status_STOPPING;																		// Stop Command 있으면 MNTR 중지
		P_Stack_Algorithme_Cmd_Event_Status = F_Status_STOPPING;																	// stack 알고리즘 상태 중지
	}


 //======================================================================================================================================================================

 // Status Event MNTR====================================================================================================================================================
 if( P_Stack_Algorithme_Cmd_Event_Status == F_Status_STARTING )																				// Status Event MNTR 시작
 {
	if( L_Reentry == 1 )
	{
		call stack_algorithm.Clear_(&P_Queue_stack_top);
		call stack_algorithm.Clear_(&P_Step_stack_top);
		call stack_algorithm.Clear_(&P_Index_stack_top);
		call stack_algorithm.Clear_(&P_Status_stack_top);
	}
	L_Reentry = 0;
	call Pattern_Funtion.Data_Check_(NN_Status,NN_Queue,&NN_Step,&NN_Index);
	if( L_PMAC_Status != L_Old_PMAC_Status )																						// 상태가 변할때 
	{																
		call stack_algorithm.Push( N_Circulation,MAX_Size,P_Status_stack_top,&P_Status_stack_top,NN_Status,P_Status_arry(P_Status_stack_top),&P_Status_arry(P_Status_stack_top) );
		L_Old_PMAC_Status = NN_Status;																							
	}

	if( NN_Queue != L_Old_Queue )
	{
		call stack_algorithm.Push( N_Circulation,MAX_Size,P_Queue_stack_top,&P_Queue_stack_top,NN_Queue,P_Queue_arry(P_Queue_stack_top),&P_Queue_arry(P_Queue_stack_top) );
		L_Old_Queue = NN_Queue;	
	}

	if( NN_Step != L_Old_Step )
	{
		call stack_algorithm.Push( N_Circulation,MAX_Size,P_Step_stack_top,&P_Step_stack_top,NN_Step,P_Step_arry(P_Step_stack_top),&P_Step_arry(P_Step_stack_top) );
		L_Old_Step = NN_Step;
	}

	if( NN_Index != L_Old_Index )
	{
		call stack_algorithm.Push( N_Circulation,MAX_Size,P_Index_stack_top,&P_Index_stack_top,NN_Index,P_Index_arry(P_Index_stack_top),&P_Index_arry(P_Index_stack_top) );
		L_Old_Index = NN_Index;
	}
 }
 else if( P_Stack_Algorithme_Cmd_Event_Status == F_Status_STOPPING && L_Reentry == 0 )
 {
	call stack_algorithm.Pop( P_Status_stack_top, &P_Status_stack_top,P_Status_arry(P_Status_stack_top),&P_PLC_Observser_MNTR(N_Status)		);
	call stack_algorithm.Pop( P_Queue_stack_top, &P_Queue_stack_top,P_Queue_arry(P_Queue_stack_top),	&P_PLC_Observser_MNTR(N_Queue_Data)	);
	call stack_algorithm.Pop( P_Step_stack_top, &P_Step_stack_top,P_Step_arry(P_Step_stack_top),		&P_PLC_Observser_MNTR(N_Step_Data)	);
	call stack_algorithm.Pop( P_Index_stack_top, &P_Index_stack_top,P_Index_arry(P_Index_stack_top),	&P_PLC_Observser_MNTR(N_Index_Data)	);
	L_Reentry++;
 }


 // Home offset Motor num cycle
if( L_motor_num >= 48 )
	L_motor_num = 1;
else
	L_motor_num++;

//=========================================================================================================================
//PNP Z축 레시피 관리 프로그램					//[ 참조 : 2025.08.27 PNP Z축 레시피 관리 프로그램 추가 ]
//=========================================================================================================================
// [ UI → PMAC ]
if ( P_PMAC_Current_Mode == F_Current_Manual )								//메뉴얼일 경우
{
	call Initialize.PNP_Z_Axis_Recipe_Monitoring(&L_PNP_Z_Recipe_Change);	//Z축 PNP 레시피 변경 모니터링 함수 

	if ( L_PNP_Z_Recipe_Change == N_TRUE || P_Home_Angle_Offset_change_Bit == N_TRUE )	//Z축 PNP 레시피 변경되었을 경우 True
	{
		P_Home_Angle_Offset_change_Bit = 0;									// Bit 초기화
		call Initialize.PNP_Z_Axis_Recipe_to_Cnt();							//모터 위치 레시피에 따른 모터 카운트 계산 함수 호출	
	}

	// [ 참조 : 2026.05.29 pnp Z 수식 정리 및 변경 ] 
	// PnP Z축 Homeoffset 변경했는데 Curpos 변경된다고 ... 그래서 수정함
	// Home offset 변경하고 home 해야 적용되는데 그걸 모르는 사람때문에 생겨남
	if( L_motor_num == N_1st_PnP_CA_Z || L_motor_num == N_1st_PnP_AN_Z || L_motor_num == N_2nd_PnP_CA_Z || L_motor_num == N_2nd_PnP_AN_Z )	// PnP Z축이라면
	{
		// 17,18,21,22 돌면서 홈 오프셋 변경이 있다면
		if( M_Motor_Home_Offset(L_motor_num) != L_old_Motor_Home_Offset(L_motor_num) )
		{
			// ↓ Homeoffset만 지정해 두고 ZeroAngle 업데이트 X
			call Initialize.pnp_Z_Home_offset(L_motor_num,M_Motor_Home_Offset(L_motor_num));	// P_Zero_Angle(unit)
			P_Homeoffset_Change_Flag(L_motor_num) = 1;	// Homeoffset변경되었으니 홈 잡게되면 ZeroAngle업데이트 플래그
			P_PMAC_Homing_CHK(L_motor_num) = 0;			// Homecheck 변수를 꺼줌으로써 홈 잡게 유도( GUI Lamp OFF )
		}

		if( P_Homeoffset_Change_Flag(L_motor_num) == 1 )		// Homeoffset변화로 인한 플래그 on일 시 
		{
			// ↓ 개별 홈 진행이 된다면, ZeroAngle 업데이트, ZeroLength 업데이트 시작
			if( P_Home_Status(L_motor_num) == F_Status_EXECUTE || L_PLC12_Start_Cnt < 4 )	// L_PLC12_Start_Cnt(unit) 배열 만들기 싫어서 z축 4개니까 cnt로 봤음
			{
				L_PLC12_Start_Cnt++;	// L_PLC12_Start_Cnt 추가한 이유는 프로그램 처음 탔을때 제로 앵글 및 렝스를 넣기 위함
				P_Homeoffset_Change_Flag(L_motor_num) = 0;	// 플래그 초기화
				P_Zero_Angle(L_motor_num) = N_Deg90 + Motor[L_motor_num].HomeOffset / 1000;				// ZeroAngle 업데이트
				call Initialize.Crank_Z_Pos_Init(P_Zero_Angle(L_motor_num),&P_Zero_Length(L_motor_num));  // ZeroLength 갱신
				call Initialize.PNP_Z_Axis_Recipe_to_Cnt();												// ZeroAngle 및 ZeroLength 갱신값에 의한 실제 각도 계산							
			}
		}
	}
	else	// PnP Z축이 아닌축들이라면
	{
		if( M_Motor_Home_Offset(L_motor_num) != L_old_Motor_Home_Offset(L_motor_num) )
		{
			P_PMAC_Homing_CHK(L_motor_num) = 0;			// Homecheck 변수를 꺼줌으로써 홈 잡게 유도( GUI Lamp OFF )
		}
	}

	L_old_Motor_Home_Offset(L_motor_num) = M_Motor_Home_Offset(L_motor_num);

	#ifdef F_Virtual_Axis_Test	// 가상축일때
		P_Test_Motor_Ready_Pos(N_1st_PnP_AN_Z) = P_Anode_1st_Z_Ready_Up///1000;
		P_Test_Motor_Ready_Pos(N_2nd_PnP_AN_Z) = P_Anode_2nd_Z_Ready_Up///1000;
		P_Test_Motor_Ready_Pos(N_2nd_PnP_CA_Z) = P_Cathode_2nd_Z_Ready_Up///1000;
		P_Test_Motor_Ready_Pos(N_1st_PnP_CA_Z) = P_Cathode_1st_Z_Ready_Up///1000;
	#else						// 실축일때
		P_Axis_Ready_Pos(N_1st_PnP_AN_Z) = P_Anode_1st_Z_Ready_Up///1000;
		P_Axis_Ready_Pos(N_2nd_PnP_AN_Z) = P_Anode_2nd_Z_Ready_Up///1000;
		P_Axis_Ready_Pos(N_2nd_PnP_CA_Z) = P_Cathode_2nd_Z_Ready_Up///1000;
		P_Axis_Ready_Pos(N_1st_PnP_CA_Z) = P_Cathode_1st_Z_Ready_Up///1000;
	#endif
}
//=========================================================================================================================

//====================================================================================================

// 드라이런 후 리셋팅 부 홈 재 접속
if( P_Stop_CycleStop_Position == N_Equipment_Initial_Ready_Pos )								// 드라이런 후 리셋팅 시 
{
	P_Stop_CycleStop_Position = 0;																// 초기화
	P_PMAC_Homing_CHK(1),48 = 0;																// 모터 홈 상태 초기화.
	P_Stack_Judgement_Memory = 0;																// HOME RESET 버튼 추가.
}

// 마지막 공정 시 초기화 부분에서 스텍비전이 카운팅 되는 부분이 생겨 버퍼를 초기화 시켜주는 란
// 초기화를 하지 않아야 한다면, 스텍비전 부분에서 마지막 공정부분을 봐주면 될듯싶다.
if( P_PLC12_Continuous_Buffer_Reset_Flag == 1)
{
	P_PLC12_Continuous_Buffer_Reset_Flag = 0;					// 초기화
	P_Anode_Align_NG_Array(0),N_Queue_Max_Size = 0;				// 음극 얼라인 NG 횟수 초기화 
	P_Cathode_Align_NG_Array(0),N_Queue_Max_Size = 0;			// 양극 얼라인 NG 횟수 초기화 
	P_Anode_Surface_NG_Array(0),N_Queue_Max_Size = 0;			// 음극 리트라이 NG 횟수 초기화
	P_Cathode_Surface_NG_Array(0),N_Queue_Max_Size = 0;			// 양극 리트라이 NG 횟수 초기화
	P_Stack_NG_Array(0),N_Queue_Max_Size = 0;					// 스텍 비전 NG 횟수 초기화
}

// QCP Save Data [ 참조 : 2025.10.29 미비사항 추가 건 ]
if( M_X_Trg_SV_Enable_From_PLC == N_TRUE && L_X_Trg_SV_Enable_From_PLC == 0 )		// 버튼이 눌렸을 시
{
	L_X_SV_Enable_Timer = 0;														// 타이머 초기화
	L_X_Trg_SV_Enable_From_PLC = N_TRUE;											// 재진입 방지
	M_Y_Trg_SV_Receive_Complete_To_PLC = N_TRUE;									// Save Qcp 요청 받음 신호 On
}
else if( M_X_Trg_SV_Enable_From_PLC == 0 && L_X_Trg_SV_Enable_From_PLC == N_TRUE )	// 신호가 꺼졌을 시 재진입 방지 변수가 on되었다면
{
	L_X_Trg_SV_Enable_From_PLC = 0;													// 재진입 방지 변수 off
}
if( M_Y_Trg_SV_Receive_Complete_To_PLC == N_TRUE )
{
	if( L_X_SV_Enable_Timer > 100 )
	{
		P_SV_Read_Enable_Flag = 0;													// 읽기 허가 플래그 on
		M_Y_Trg_SV_Receive_Complete_To_PLC = 0;										// 출력신호 off
	}
}

// PLC Trans IN , OUT OFF	→ Monitoring prog에서 OFF 시키자. [ 참조 : Trans IN, OUT 시점 추가 ]
if( M_X_PLC_Trans_IN_Ack == N_TRUE )
	M_Y_PLC_Trans_IN_Signal = 0;
//if( M_X_PLC_Trans_OUT_Ack == N_TRUE )		// 트랜스 아웃 신호 필요 없다고 함.
//	M_Y_PLC_Trans_OUT_Signal = 0;


// Tesla Manual Vac MNTR 추가 ( 매뉴얼 일때 관람 ) ======================================================================================================================================================
if ( P_PMAC_Current_Mode == F_Current_Manual )								//메뉴얼일 경우
{
	// 1. 매뉴얼 모드 일 때 수동으로 Vac 감시가 된다면
	if( M_Y_Cathode_AT_Vac_Ejector_Vac_On == N_TRUE && M_Y_Cathode_AT_Vac_Ejector_Vac_On != L_Y_Cathode_AT_Vac_Ejector_Vac_On )
		P_PLC12_Vacuum_MNTR(N_Align_Cathode) = 1;

	if( M_Y_Anode_AT_Vac_Ejector_Vac_On == N_TRUE && M_Y_Anode_AT_Vac_Ejector_Vac_On != L_Y_Anode_AT_Vac_Ejector_Vac_On )
		P_PLC12_Vacuum_MNTR(N_Align_Anode) = 1;

	if( M_Y_Cathode_1st_Vac_Sol_On == N_TRUE && M_Y_Cathode_1st_Vac_Sol_On != L_Y_Cathode_1st_Vac_Sol_On )
		P_PLC12_Vacuum_MNTR(N_1st_Cathode) = 1;
	
	if( M_Y_Cathode_2nd_Vac_Sol_On == N_TRUE && M_Y_Cathode_2nd_Vac_Sol_On != L_Y_Cathode_2nd_Vac_Sol_On )
		P_PLC12_Vacuum_MNTR(N_2nd_Cathode) = 1;
	
	if( M_Y_Anode_1st_Vac_Sol_On == N_TRUE && M_Y_Anode_1st_Vac_Sol_On != L_Y_Anode_1st_Vac_Sol_On )
		P_PLC12_Vacuum_MNTR(N_1st_Anode) = 1;
	
	if( M_Y_Anode_2nd_Vac_Sol_On == N_TRUE && M_Y_Anode_2nd_Vac_Sol_On != L_Y_Anode_2nd_Vac_Sol_On )
		P_PLC12_Vacuum_MNTR(N_2nd_Anode) = 1;	
	
	if( M_Y_Cathode_NG_PNP_Ejector_Vac_On == N_TRUE && M_Y_Cathode_NG_PNP_Ejector_Vac_On != L_Y_Cathode_NG_PNP_Ejector_Vac_On )
		P_PLC12_Vacuum_MNTR(N_NG_Cathode) = 1;
	
	if( M_Y_Anode_NG_PNP_Ejector_Vac_On == N_TRUE && M_Y_Anode_NG_PNP_Ejector_Vac_On != L_Y_Anode_NG_PNP_Ejector_Vac_On )
		P_PLC12_Vacuum_MNTR(N_NG_Anode) = 1;	
}
// 매뉴얼 진공 동기화 ===================================================================================================================================================================================
L_Y_Cathode_AT_Vac_Ejector_Vac_On = M_Y_Cathode_AT_Vac_Ejector_Vac_On;
L_Y_Anode_AT_Vac_Ejector_Vac_On = M_Y_Anode_AT_Vac_Ejector_Vac_On;
L_Y_Cathode_1st_Vac_Sol_On = M_Y_Cathode_1st_Vac_Sol_On;
L_Y_Cathode_2nd_Vac_Sol_On = M_Y_Cathode_2nd_Vac_Sol_On;
L_Y_Anode_1st_Vac_Sol_On = M_Y_Anode_1st_Vac_Sol_On;
L_Y_Anode_2nd_Vac_Sol_On = M_Y_Anode_2nd_Vac_Sol_On;
L_Y_Cathode_NG_PNP_Ejector_Vac_On = M_Y_Cathode_NG_PNP_Ejector_Vac_On;
L_Y_Anode_NG_PNP_Ejector_Vac_On = M_Y_Anode_NG_PNP_Ejector_Vac_On;


if( P_Vac_Pass == 0 )
{
	//[ 260102 진공, 블로우 모듈 수정]
	// 양극 1차 PNP 진공 감시 모듈
	if( P_PLC12_Vacuum_MNTR(N_1st_Cathode) == 1 )
	{
		P_PLC12_Vacuum_MNTR(N_1st_Cathode) = 0
		P_Vacuum_Check(N_1st_Cathode) = 1				// 양극 1차 PNP 진공 감시 
		P_PLC12_Vacuum_1st_Cathode_MNTR_Timer = 0		// 타이머 초기화
		#ifdef F_Debug_Mode
			P_Debug_Vacuum_MNTR(N_1st_Cathode) = 1;
		#endif
	}
	
	if( P_Vacuum_Check(N_1st_Cathode) == 1 )
	{
		if( P_PLC12_Vacuum_1st_Cathode_MNTR_Timer > P_PLC12_Vacuum_1st_Cathode_Set_Time / ((Coord[1].DesTimeBase*400)/100) )
		{
			if( M_X_Cathode_1st_PNP_Vac_Sensor == 0 )
			{
				//if( P_PMAC_Status != F_Status_EXECUTE )												// Execute 에선 알람 발생 X
				//{
					call Alarm.Insert_Alarm(N_Alarm_Cathode_1ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
					P_PMAC_Commands = F_Command_Stop;
					P_Stop_Cmd_Origin = 60
				//}
			}
			P_Vacuum_Check(N_1st_Cathode) = 0;													// 플래그 초기화
		}
	}
	
	
	// 양극 2차 PNP 진공 감시 모듈
	if( P_PLC12_Vacuum_MNTR(N_2nd_Cathode) == 1 )
