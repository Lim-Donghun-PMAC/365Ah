	P_Cathode_1st_PNP_Z_Crank_real_Move_Pos = P_Zero_Length(N_1st_PnP_CA_Z) - P_Recipe_M17_POS(4);///10000	
	//↑양극 1차 PNP Crank Z축 실제 이동해야하는 위치 = 96.03 - 양극 1차 PNP Z축 벨트 하강 레시피 값  
	P_Cathode_1st_PNP_Z_Acos_numerator = ( P_Cathode_1st_PNP_Z_Crank_real_Move_Pos*P_Cathode_1st_PNP_Z_Crank_real_Move_Pos + N_Crank_Radius*N_Crank_Radius - N_Crank_Rod*N_Crank_Rod)
