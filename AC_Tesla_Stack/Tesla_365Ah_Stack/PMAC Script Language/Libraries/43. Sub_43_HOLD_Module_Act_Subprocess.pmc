			}
			else																													// 일정 시간을 넘겼을 경우.
				P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Align_Up_Pos) = N_Error_Step;									// 애러 스텟 머신으로 이동.
		}	
		// 444) 애러.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Align_Up_Pos) == N_Error_Step )										// 애러 상태 일 경우.
		{
			P_Hold_Module_Error = N_Act_NG_PNP_Align_Up_Pos;																							// Hold 모듈 정지.		[ 참조 : 26.01.08 Hold 모듈 수정 ]
			NG_PNP_Align_Up_Pos_RTN = N_FALSE;																						// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Align_Up_Pos) == N_Complete_Step )									// 완료 상태 일 경우.
		{
			P_Act_Hold_Complete_Bit(N_Act_NG_PNP_Align_Up_Pos) = 1;																	// 동작 완료 Bit On.
			NG_PNP_Align_Up_Pos_RTN = N_COMPLETE;																					// 반환값 : COMPLETE
		}
	return;

	// NG PNP 흡착.
	sub:NG_PNP_Vac_On(&NG_PNP_Vac_On_RTN)
		// 0) 반환값 초기화.
		NG_PNP_Vac_On_RTN = 0;
		// 222) 좌표계 + 서보 확인.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			// 222.0) 모션 상태 초기화
			P_NG_PNP_Vac_On_Status = 0;
		
			P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) = 1;													// 다음 스텟 머신으로 이동.		
		}
		// 1) 모션 실행.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) == 1 )														// 진행 준비 완료 일 경우.
		{
			// 1.0) 타임 아웃 확인을 위한 동작 실행 시 시간 저장.
			P_Act_Hold_Old_Time(N_Act_NG_PNP_Vac_On) = Sys.Time;																	// 동작 실행 시 시간 저장.
			// 1.1) 파이널 롤 양극 위치 일 경우. [음극 동작 가능]
			if ( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos )
			{
				P_Slave13_Motion_Command = N_NG_PNP_Align_Vac;																		// 음극 NG PNP 흡착.
				P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) = 2;														// 다음 스텟 머신 이동.
			}
			// 1.2) 파이널 롤 음극 위치 일 경우. [양극 동작 가능]
			else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos )
			{
				P_Slave12_Motion_Command = N_NG_PNP_Align_Vac;																		// 양극 NG PNP 흡착.
				P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) = 2;														// 다음 스텟 머신 이동.
			}
		}
		// 2) 동작 확인.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) == 2 )														// 동작 확인 일 경우.
		{
			if ( Sys.Time < P_Act_Hold_Old_Time(N_Act_NG_PNP_Vac_On) + P_Act_Hold_Time_Out(N_Act_NG_PNP_Vac_On))					// 일정 시간 전에 완료 될 경우.
			{
				if ( P_NG_PNP_Vac_On_Status == F_Status_COMPLETE )																	// 모션 프로그램 확인.
				{
					// 2.1) 파이널 롤 양극 위치 일 경우. [음극 동작 가능]
					if ( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos )
					{
							P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) = N_Complete_Step;							// 완료 스텟 머신으로 이동.
					}
					// 2.2) 파이널 롤 음극 위치 일 경우. [양극 동작 가능]
					else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos )
					{
							P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) = N_Complete_Step;							// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																													// 일정 시간을 넘겼을 경우.
				P_Module_Act_Hold_State_Machine_Array(N_Act_Second_PNP_Vac_On) = N_Error_Step;										// 애러 스텟 머신으로 이동.
		}	
		// 444) 애러.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) == N_Error_Step )											// 애러 상태 일 경우.
		{
			P_Hold_Module_Error = N_Act_NG_PNP_Vac_On;																							// Hold 모듈 정지.		[ 참조 : 26.01.08 Hold 모듈 수정 ]
			NG_PNP_Vac_On_RTN = N_FALSE;																							// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Vac_On) == N_Complete_Step )										// 완료 상태 일 경우.
		{
			P_Act_Hold_Complete_Bit(N_Act_NG_PNP_Vac_On) = 1;																		// 동작 완료 Bit On.
			NG_PNP_Vac_On_RTN = N_COMPLETE;																							// 반환값 : COMPLETE
		}
	return;

	// NG PNP 블로우.
	sub:NG_PNP_Blow_On(&NG_PNP_Blow_On_RTN)
		// 0) 반환값 초기화.
		NG_PNP_Blow_On_RTN = 0;
		// 222) 좌표계 + 서보 확인.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			// 222.0) 모션 상태 초기화
			P_NG_PNP_Blow_On_Status = 0;
		
			P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) = 1;												// 다음 스텟 머신으로 이동.		
		}
		// 1) 모션 실행.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) == 1 )														// 진행 준비 완료 일 경우.
		{
			// 1.0) 타임 아웃 확인을 위한 동작 실행 시 시간 저장.
			P_Act_Hold_Old_Time(N_Act_NG_PNP_Blow_On) = Sys.Time;																	// 동작 실행 시 시간 저장.
			// 1.1) 파이널 롤 양극 위치 일 경우. [음극 동작 가능]
			if ( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos )
			{
				P_Slave13_Motion_Command = N_NG_PNP_NG_Blow;																		// 음극 NG PNP 블로우.
				P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) = 2;													// 다음 스텟 머신 이동.
			}
			// 1.2) 파이널 롤 음극 위치 일 경우. [양극 동작 가능]
			else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos )
			{
				P_Slave12_Motion_Command = N_NG_PNP_NG_Blow;																		// 양극 NG PNP 블로우.
				P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) = 2;													// 다음 스텟 머신 이동.
			}
		}
		// 2) 동작 확인.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) == 2 )														// 동작 확인 일 경우.
		{
			if ( Sys.Time < P_Act_Hold_Old_Time(N_Act_NG_PNP_Blow_On) + P_Act_Hold_Time_Out(N_Act_NG_PNP_Blow_On))					// 일정 시간 전에 완료 될 경우.
			{
				if ( P_NG_PNP_Blow_On_Status == F_Status_COMPLETE )																	// 모션 프로그램 확인.
				{
					// 2.1) 파이널 롤 양극 위치 일 경우. [음극 동작 가능]
					if ( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos )
					{
							P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) = N_Complete_Step;							// 완료 스텟 머신으로 이동.
					}
					// 2.2) 파이널 롤 음극 위치 일 경우. [양극 동작 가능]
					else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos )
					{
							P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) = N_Complete_Step;							// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																													// 일정 시간을 넘겼을 경우.
				P_Module_Act_Hold_State_Machine_Array(N_Act_Second_PNP_Vac_On) = N_Error_Step;										// 애러 스텟 머신으로 이동.
		}	
		// 444) 애러.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) == N_Error_Step )											// 애러 상태 일 경우.
		{
			P_Hold_Module_Error = N_Act_NG_PNP_Blow_On;																							// Hold 모듈 정지.		[ 참조 : 26.01.08 Hold 모듈 수정 ]
			NG_PNP_Blow_On_RTN = N_FALSE;																							// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Act_NG_PNP_Blow_On) == N_Complete_Step )										// 완료 상태 일 경우.
		{
			P_Act_Hold_Complete_Bit(N_Act_NG_PNP_Blow_On) = 1;																		// 동작 완료 Bit On.
			NG_PNP_Blow_On_RTN = N_COMPLETE;																						// 반환값 : COMPLETE
		}
	return;


// Pause Check  [ 참 조: GPIO 고장 시 예외처리 (26.01.08)]
	sub:Hold_Pause_Check(&Pasue_RTN)
	Pasue_RTN = 0;
		// 퍼즈 확인 
		if ( P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			P_Hold_Module_Error = 0;
			// pause 신호를 주었는데 정지가 안되었다면 GPIO 문제임. 
			// 반댓열이 Manual 즉 가동이 안되어도 퍼즈는 걸려야함. 아크신호 자체가 안 오는거면 GPIO문제임 
			P_Act_Hold_Time_Out(N_Pasue_Check) = 0.1 * (100 / P_Recipe_Speed_Value);				// 100ms
			
			P_Act_Hold_Old_Time(N_Pasue_Check) = sys.time;			// 시간 저장
			P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) = 1;
		}
		// 1) 퍼즈 체크
		if ( P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) == 1 )														// 진행 준비 완료 일 경우.
		{
			if( sys.time >= P_Act_Hold_Old_Time(N_Pasue_Check) + P_Act_Hold_Time_Out(N_Pasue_Check) )		// 10ms 대기
			{
				if( coord[1].progrunning == 0 )			// 퍼즈 ok
				{
					P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) = N_Complete_Step;
				}
				else									// 퍼즈 안됌 문제가 발생함
				{
					P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) = 2;
				}
			}
		}
		// 2) 예외처리 모션 시작
		if ( P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) == 2 )														// 동작 확인 일 경우.
		{
			if ( P_FinalRoll_Unit_Status == F_FR_Cathode_Pos )
			{
				P_First_PNP_T_Wait_Status = F_Status_Nonseatus;					// 상태 초기화
				P_First_PNP_Z_Wait_Status = F_Status_Nonseatus;					// 상태 초기화
				P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion;			// 대기위치 이동
				P_Slave16_Motion_Command = N_1st_PNP_Ready_Pos_Motion;			// 대기위치 이동
				P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) = 3;
			}
			else if( P_FinalRoll_Unit_Status == F_FR_Anode_Pos || P_FinalRoll_Unit_Status == F_FR_Ready_And_Cutting_Pos )
			{
				P_First_PNP_T_Wait_Status = F_Status_Nonseatus;					// 상태 초기화
				P_First_PNP_Z_Wait_Status = F_Status_Nonseatus;					// 상태 초기화
				P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion;			// 대기위치 이동
				P_Slave19_Motion_Command = N_1st_PNP_Ready_Pos_Motion;			// 대기위치 이동
				P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) = 3;
			}						
		}	
		// 위치 확인
		if ( P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) == 3 )													// 동작 확인 일 경우.
		{
			if ( P_First_PNP_T_Wait_Status == F_Status_COMPLETE && P_First_PNP_Z_Wait_Status == F_Status_COMPLETE )
			{
				P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) = N_Error_Step;										// Error Stop 
			}
		}	
		// 444) 애러.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) == N_Error_Step )											// 애러 상태 일 경우.
		{
			P_Hold_Module_Error = N_Pasue_Check;																					// Hold 모듈 정지.		[ 참조 : 26.01.08 Hold 모듈 수정 ]
			Pasue_RTN = N_FALSE;																							// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_Hold_State_Machine_Array(N_Pasue_Check) == N_Complete_Step )										// 완료 상태 일 경우.
		{
			P_Act_Hold_Complete_Bit(N_Pasue_Check) = 1;																		// 동작 완료 Bit On.
			Pasue_RTN = N_COMPLETE;																							// 반환값 : COMPLETE
		}
	return;

close
