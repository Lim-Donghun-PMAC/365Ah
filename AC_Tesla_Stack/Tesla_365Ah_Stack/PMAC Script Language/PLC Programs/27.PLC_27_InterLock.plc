				//	else if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강한다면
				//	{
				//		if( P_IL_Motor_Page == N_2nd_PnP_AN_T )	// 2차 T
				//	      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
				//	
				//	   P_IL_Outer_Status = IL_Out_Close;										// 외부 인터락 닫기
				//	   P_IL_Popup_Motor = N_2nd_PnP_AN_Z;										// 인터락 팝업 모터 추가
				//	}
				//	else if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) >= P_Recipe_M04_POS(2) - 35 )	// 55도 이상에 있다면 Stack Pos
				//	   P_IL_Outer_Status = N_IL_Stack_Pos;
				//	
				//	else if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) <= P_Recipe_M04_POS(1) + 15 )	// 10도 이하에 있다면 Normal Pos      
				//	   P_IL_Outer_Status = N_IL_Normal_Pos;                                                         
		   		//
				//	else																		// 그 외 위치라면
				//	   P_IL_Outer_Status = N_IL_Upper_Pos;                                                         
				//}
				// [ 참조 : 26.10.02 인터락 조건 추가 ]
				else
				{ 
					if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) <= P_Recipe_M04_POS(1) + 15 )		// 2차 PNP가 대기위치 + 15도 이하일 경우.
					{ // 2차 PNP 얼라인 위치.
						if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Align_Down - 0.01 )		// 얼라인 하강위치보다 하강일 경우.
						{ // 2차 PNP 얼라인 하강위치 일 경우.
						   if( P_IL_Motor_Page == N_2nd_PnP_AN_T )								// 2차 T  
								P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;					// 플러스, 마이너스 인터락
						   else if( P_IL_Motor_Page == N_2nd_PnP_AN_Z )							// 2차 Z 
						      P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락
						   
						   P_IL_Outer_Status = N_IL_Align_Down_Pos;								// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
						   P_IL_Popup_Motor = N_2nd_PnP_AN_Z;									// 인터락 팝업 모터 추가
						} 	
						else if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{ // 2차 PNP 대기 위치 상승보다 밑에 있을 경우.
							if( P_IL_Motor_Page == N_2nd_PnP_AN_T )								// 2차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							  
							  P_IL_Outer_Status = N_IL_Align_Down_Pos;							// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함) 
							  P_IL_Popup_Motor = N_2nd_PnP_AN_Z;								// 인터락 팝업 모터 추가
						}									
						else
						{		
							P_IL_Outer_Status = N_IL_Normal_Pos;								// 노말 포스 
						}
					}
					else if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) >= P_Recipe_M04_POS(2) - 35 )  // 2차 PNP가 스택 위치에서 -35도 보다 들어가 있을 경우.
					{ // 2차 PNP 스택 위치.
						if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Stack_Down - 0.01 )		// 스택 하강위치보다 하강일 경우.
						{
						   if( P_IL_Motor_Page == N_2nd_PnP_AN_T )								// 2차 T 
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
						   else if( P_IL_Motor_Page == N_2nd_PnP_AN_Z )							// 2차 Z 
						      P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락

						   P_IL_Outer_Status = N_IL_Stack_Down_Pos;								// 스택 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
						   P_IL_Popup_Motor = N_2nd_PnP_AN_Z;									// 인터락 팝업 모터 추가
						}	
						else if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_2nd_PnP_AN_T )								// 1차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							P_IL_Outer_Status = N_IL_Stack_Down_Pos;							// 스택 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
							P_IL_Popup_Motor = N_2nd_PnP_AN_Z;									// 인터락 팝업 모터 추가
						}
						else
						{
							 P_IL_Outer_Status = N_IL_Stack_Pos;								// 스택 포스
						}
					} 					
					else																		// 얼라인도 아니고 스택도 아니면
					{	
						if( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_2nd_PnP_AN_T )								// 2차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							  P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
							  P_IL_Popup_Motor = N_2nd_PnP_AN_Z;								// 인터락 팝업 모터 추가
						}
						else
							P_IL_Outer_Status = N_IL_Upper_Pos;									// 상승 포스 
					}
				}
			break;
		
			case N_IL_Robot_CA_Clamp1:      // 양극 클램프 1 로봇 5,27
			   if( P_Motor_Current_Pos(N_Clamp_CA_Z1) <= P_Motor_Current_Pos(N_MAIN_Z) - 0.5 )	// 스텍테이블 보다 클램프 Z축이 낮다면
			   {
			      if( P_Motor_Current_Pos(N_Clamp_CA_Y1) >= P_Axis_Ready_Pos(N_Clamp_CA_Y1) +1 )   // 클램프 Y축이 대기위치를 벗어나게 된다면 
			      {
			         if( P_IL_Motor_Page == N_Clamp_CA_Z1 )										// 양극 클램프 Z1축  
			            P_IL_Robot_Bit = Hex_IL_Minus;											// 마이너스(하강) 인터락
			         else if( P_IL_Motor_Page == N_Clamp_CA_Y1 )								// 양극 클램프 Y1축 
			            P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스(전진) 인터락
			                  
			         P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
			         P_IL_Popup_Motor = N_MAIN_Z;												// 인터락 팝업 모터 추가   
			      }
			      else																			// 메인 Z축 클램프 Z축 간 위치가 걸리지만, Y축이 전진을 안한 상태이므로
			         P_IL_Outer_Status = N_IL_Normal_Pos;
			   }
			   else																				// Clamp Z축이 stack table 보다 높게 있다면 Y축이 전진해도 무방하므로
			      P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		
			case N_IL_Robot_AN_Clamp1:      // 음극 클램프 1  로봇 6,28
			   if( P_Motor_Current_Pos(N_Clamp_AN_Z1) <= P_Motor_Current_Pos(N_MAIN_Z) - 0.5 )	// 스텍테이블 보다 클램프 Z축이 낮다면
			   {
			      if(   P_Motor_Current_Pos(N_Clamp_AN_Y1) >= P_Axis_Ready_Pos(N_Clamp_AN_Y1) +1 )   // 클램프 Y축이 대기위치를 벗어나게 된다면
			      {
			         if( P_IL_Motor_Page == N_Clamp_AN_Z1 )										// 음극 클램프 Z1축  
			            P_IL_Robot_Bit = Hex_IL_Minus;											// 마이너스(하강) 인터락
			         else if( P_IL_Motor_Page == N_Clamp_AN_Y1 )								// 음극 클램프 Y1축 
			            P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스(전진) 인터락
			                  
			         P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
			         P_IL_Popup_Motor = N_MAIN_Z;												// 인터락 팝업 모터 추가   
			      }
			      else																			// 메인 Z축 클램프 Z축 간 위치가 걸리지만, Y축이 전진을 안한 상태이므로
			         P_IL_Outer_Status = N_IL_Normal_Pos;
			   }
			   else																				// Clamp Z축이 stack table 보다 높게 있다면 Y축이 전진해도 무방하므로
			      P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		
			case N_IL_Robot_CA_Clamp2:      // 양극 클램프 2 로봇 7,25
			   if( P_Motor_Current_Pos(N_Clamp_CA_Z2) <= P_Motor_Current_Pos(N_MAIN_Z) - 0.5 )	// 스텍테이블 보다 클램프 Z축이 낮다면
			   {
			      if(   P_Motor_Current_Pos(N_Clamp_CA_Y2) >= P_Axis_Ready_Pos(N_Clamp_CA_Y2) +1 )   // 클램프 Y축이 대기위치를 벗어나게 된다면
			      {
			         if( P_IL_Motor_Page == N_Clamp_CA_Z2 )										// 양극 클램프 Z2축  
			            P_IL_Robot_Bit = Hex_IL_Minus;											// 마이너스(하강) 인터락
			         else if( P_IL_Motor_Page == N_Clamp_CA_Y2 )								// 양극 클램프 Y2축 
			            P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스(전진) 인터락
			                  
			         P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
			         P_IL_Popup_Motor = N_MAIN_Z;												// 인터락 팝업 모터 추가   
			      }
			      else																			// 메인 Z축 클램프 Z축 간 위치가 걸리지만, Y축이 전진을 안한 상태이므로
			         P_IL_Outer_Status = N_IL_Normal_Pos;
			   }
			   else																				// Clamp Z축이 stack table 보다 높게 있다면 Y축이 전진해도 무방하므로
			      P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		
			case N_IL_Robot_AN_Clamp2:      // 음극 클램프 2 로봇 8,26
			   if( P_Motor_Current_Pos(N_Clamp_AN_Z2) <= P_Motor_Current_Pos(N_MAIN_Z) - 0.5 )	// 스텍테이블 보다 클램프 Z축이 낮다면
			   {
			      if(   P_Motor_Current_Pos(N_Clamp_AN_Y2) >= P_Axis_Ready_Pos(N_Clamp_AN_Y2) +1 )   // 클램프 Y축이 대기위치를 벗어나게 된다면
			      {
			         if( P_IL_Motor_Page == N_Clamp_AN_Z2 )										// 음극 클램프 Z2축  
			            P_IL_Robot_Bit = Hex_IL_Minus;											// 마이너스(하강) 인터락
			         else if( P_IL_Motor_Page == N_Clamp_AN_Y2 )								// 음극 클램프 Y2축 
			            P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스(전진) 인터락
			                  
			         P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
			         P_IL_Popup_Motor = N_MAIN_Z;												// 인터락 팝업 모터 추가   
			      }
			      else																			// 메인 Z축 클램프 Z축 간 위치가 걸리지만, Y축이 전진을 안한 상태이므로
			         P_IL_Outer_Status = N_IL_Normal_Pos;
			   }
			   else																				// Clamp Z축이 stack table 보다 높게 있다면 Y축이 전진해도 무방하므로
			      P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		
			case N_IL_Robot_Main:      // 메인Z축 로봇   7
			   // 스텍 테이블 입장에서는 맨드릴이 들어와있냐 없냐 문제만 먼저 보면 될것같음 -> 총 4개의 클램프 Y를 비교해야함
			   L_High_Pos(0),2 = 0;
			   L_Num(0),2 = 0;

			   // 양극 클램프 Y 비교
			   if( P_Motor_Current_Pos(N_Clamp_CA_Y1) >= P_Motor_Current_Pos(N_Clamp_CA_Y2))	// 양극 클램프 Y1 , 양극 클램프 Y2 비교
			   {
			      L_Num(0) = N_Clamp_CA_Y1;
			      L_High_Pos(0) = P_Motor_Current_Pos(N_Clamp_CA_Y1);
			   }
			   else
			   {
			      L_Num(0) = N_Clamp_CA_Y2;
			      L_High_Pos(0) = P_Motor_Current_Pos(N_Clamp_CA_Y2);
			   }
			   // 음극 클램프 Y 비교
			   if( P_Motor_Current_Pos(N_Clamp_AN_Y1) >= P_Motor_Current_Pos(N_Clamp_AN_Y2))	// 양극 클램프 Y1 , 양극 클램프 Y2 비교
			   {
			      L_Num(1) = N_Clamp_AN_Y1;
			      L_High_Pos(1) = P_Motor_Current_Pos(N_Clamp_AN_Y1);
			   }
			   else
			   {
			      L_Num(1) = N_Clamp_AN_Y2;
			      L_High_Pos(1) = P_Motor_Current_Pos(N_Clamp_AN_Y2);
			   }


			   if( L_High_Pos(0) >= L_High_Pos(1))		// P변수로 watch창 올릴수 있게 
			   {   // 양극 클램프가 더 높다면
			      P_IL_Clamp_Y = L_Num(0);				// 모터 넘버
			      P_IL_Clamp_Pos = L_High_Pos(0);		// 클램프 Y 현재 위치
			   }
			   else
			   {   // 음극 클램프가 더 높다면   
			      P_IL_Clamp_Y = L_Num(1);				// 모터 넘버
			      P_IL_Clamp_Pos = L_High_Pos(1);		// 클램프 Y 현재 위치
			   }

			   // 메인 Z 인터락 시작
			   if( P_IL_Clamp_Pos >= P_Axis_Ready_Pos(P_IL_Clamp_Y) + 1 )      // 4개의 클램프 Y축 중 하나라도 대기위치 보다 크다면, 스택 테이블 진입이라면
			   {
			      switch( P_IL_Clamp_Y )				// Z축 모터 넘버 정의 
			      {
			         case N_Clamp_CA_Y1:   P_IL_Clamp_Z = N_Clamp_CA_Z1   break;
			         case N_Clamp_AN_Y1:   P_IL_Clamp_Z = N_Clamp_AN_Z1   break;
			         case N_Clamp_CA_Y2:   P_IL_Clamp_Z = N_Clamp_CA_Z2   break;
			         case N_Clamp_AN_Y2:   P_IL_Clamp_Z = N_Clamp_AN_Z2   break;
			      }

			      if( P_Motor_Current_Pos(N_MAIN_Z) >= P_Motor_Current_Pos(P_IL_Clamp_Z) - 0.5 )	// 메인 Z축이 클램프 Z축 보다 높아 질때
			      {
			         P_IL_Robot_Bit = Hex_IL_Plus;					// Z축 + 상승 인터락
			         P_IL_Outer_Status = IL_Out_Close;				// 외부 인터락 닫기
			         P_IL_Popup_Motor =  P_IL_Clamp_Y;				// 인터락 팝업 모터 추가
			      }
			      else
			         P_IL_Outer_Status = N_IL_Normal_Pos;
			   }
			   else
			      P_IL_Outer_Status = N_IL_Normal_Pos;   
			break;
		
			case N_IL_Robot_Final_Roller:   // 파이널롤러 로봇 12,13
			   // 스텍 테이블 중앙 즉 0값으로 기준을 나누어 음극방향, 양극방향 알려주기
			   if( P_Motor_Current_Pos(N_FINAL_ROLL_X) >= 0 )
			      P_IL_Outer_Status = N_IL_Cathode_Pos;   
			   else
			      P_IL_Outer_Status = N_IL_Anode_Pos;   

			   if( P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(3) && P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Recipe_M12_POS(2) )   
			   {   // 양극,음극 위치에 있고 Z축이 적층 위치보다 하강한다면
			      //if( P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(2))				// FR Z      
			      if( P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(2) + 0.1)			// FR Z   [ 참조 : 26.10.02 인터락 조건 추가 ]                                    
			      {
			         if( P_IL_Motor_Page == N_FINAL_ROLL_X )									// 파이널롤러 X축
			         {  
			            P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스,마이너스 인터락 양,음극 이동 불가
			            P_IL_Popup_Motor = N_FINAL_ROLL_Z ;										// 인터락 팝업 모터 추가
			         }
			         else if( P_IL_Motor_Page == N_FINAL_ROLL_Z )								// 파이널롤러 Z축
			         {
			            P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스(하강) 인터락
			            P_IL_Popup_Motor = N_FINAL_ROLL_Z ;										// 인터락 팝업 모터 추가
			         }         
			         P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
			      }
			   }
			break;
		
			case N_IL_Robot_CA_Align:   // 양극 얼라인 로봇 36,37,38
			   P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		
			case N_IL_Robot_AN_Align:   // 음극 얼라인 로봇 39,40,41
			   P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		
			case N_IL_Robot_CA_NG_PNP:   // 양극 NG PNP 로봇 42,44 //[참조 : 260601 : 양음극 NG BOX 도어 오픈 시 조그 인터락 ]
			   if ( M_X_Cathode_NG_Box_Detect_Sensor == 0 )
			   {
			      if( P_IL_Motor_Page == N_NG_PnP_CA_T || P_IL_Motor_Page == N_NG_PnP_CA_Z )    // NG T, NG Z 
				  {
						P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
						P_IL_Outer_Status = IL_Out_Close;                                       // 외부 인터락 닫기
				  }
			   }
			   else
			   {
				 if( P_Motor_Current_Pos(N_NG_PnP_CA_Z) > P_Recipe_M44_POS(4) )					// NG PNP Z축이 하강되어 있다면
				 {
				    if( P_IL_Motor_Page == N_NG_PnP_CA_T )										// 양극 NG PNP T
				       P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;								// 플러스,마이너스 인터락 
				    else if( P_IL_Motor_Page == N_NG_PnP_CA_Z )
				       P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스 하강 인터락
				    
				    P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
				    P_IL_Popup_Motor = N_NG_PnP_CA_Z;											// 인터락 팝업 모터 추가
				 }
				 else if( P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 20 )		// NG PNP T축이 Box위치에서 20도 이상을 벗어났다면
				    P_IL_Outer_Status = N_IL_Align_Pos;

				 else   // NG 박스에 있다면
				    P_IL_Outer_Status = N_IL_Normal_Pos;
			  }
			break;
		
			case N_IL_Robot_AN_NG_PNP:   // 음극 NG PNP 로봇 43,45 //[참조 : 260601 : 양음극 NG BOX 도어 오픈 시 조그 인터락 ]
			   If ( M_X_Anode_NG_Box_Detect_Sensor == 0 )
			   {
			       if( P_IL_Motor_Page == N_NG_PnP_AN_T || P_IL_Motor_Page == N_NG_PnP_AN_Z )   // NG T, NG Z 
			       {
						 P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;                           // 플러스, 마이너스 인터락
						 P_IL_Outer_Status = IL_Out_Close;                                      // 외부 인터락 닫기
				   }
			    }
			    else
			    {
				  if( P_Motor_Current_Pos(N_NG_PnP_AN_Z) > P_Recipe_M45_POS(4) )				// NG PNP Z축이 하강되어 있다면
				  {
				     if( P_IL_Motor_Page == N_NG_PnP_AN_T )										// 음극 NG PNP T
				        P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스,마이너스 인터락 
				     else if( P_IL_Motor_Page == N_NG_PnP_AN_Z )
				        P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스 하강 인터락
				     
				     P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
				     P_IL_Popup_Motor = N_NG_PnP_AN_Z;											// 인터락 팝업 모터 추가
				  }
				  else if( P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(1) + 20 )		// NG PNP T축이 Box위치에서 20도 이상을 벗어났다면
				     P_IL_Outer_Status = N_IL_Align_Pos;
				  
				  else   // NG 박스에 있다면
				     P_IL_Outer_Status = N_IL_Normal_Pos;
				}
			break;
		
			case N_IL_Robot_1st_Unloader:   // 언로더 로봇  46,47,48
				// 1. 언로더 Z축이 대기위치일때  P_IL_In_Offset(15) = 0.5
				if( P_Motor_Current_Pos(N_UNLOADER_Z) >= P_Recipe_M47_POS(1) - P_IL_In_Offset(15) && P_Motor_Current_Pos(N_UNLOADER_Z) <= P_Recipe_M47_POS(1) + P_IL_In_Offset(15) )
				{ // 1. 언로더 Z축이 대기위치에 있을 경우.
					if( P_Motor_Current_Pos(N_UNLOADER_X) <= P_Recipe_M46_POS(1) + P_IL_In_Offset(16) )   // 1차 언로더 X가 대기위치일때      P_IL_In_Offset(16) = 5
					{ // 1.1. 언로더가 X축이 대기 위치에 있을 경우.
					   if( P_IL_Motor_Page == N_UNLOADER_T )									// 언로더 T 선택되었을 경우
					   { // 1.1.1. 언로더 T축 선택.
					      if( P_X_PLC_InterLock == 0 )											// PLC 2차언로더 인터락 되었을 경우 //if( M_X_PLC_InterLock == 0 )         0 인터락 1 인터락 해제
					      { // 1.1.1.1. PLC 인터락 ON → 언로더 T축 구동 불가.
					         P_IL_Popup_Motor = N_2nd_UNLOADER;									// 인터락 팝업 모터 추가
					         P_IL_Robot_Bit= Hex_IL_Plus;										// 플러스,마이너스 인터락 
					         P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
					      }
					      else
					      { // 1.1.1.2. PLC 인터락 OFF → 언로더 T축 구동 가능.
					         P_IL_Popup_Motor = 0;												// 팝업모터 초기화
					         P_IL_Robot_Bit = 0;												// 인터락 비트 초기화
					         P_IL_Outer_Status = N_IL_Normal_Pos;								// Normal Pos 
					      }    
					   }
					   if( P_IL_Motor_Page == N_UNLOADER_Z )   // 언로더 Z 선택되었을 경우
					   { // 1.1.2. 언로더 Z축 선택.
					      if( P_Motor_Current_Pos(N_UNLOADER_T) >= P_Recipe_M48_POS(3) - P_IL_In_Offset(17) )   // 언로더 X, Z가 대기위치인데 T가 회피위치를 넘어갔다면   P_IL_In_Offset(17) = 1
					      { // 1.1.2.1. 언로더 T축이 회피 위치를 넘어갈 경우 → 언로더 Z축 구동 불가.
					         P_IL_Popup_Motor = N_2nd_UNLOADER;									// 인터락 팝업 모터 추가
					         P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스,마이너스 인터락 
					         P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
					      }
					      else
					      { // 1.1.2.2. 언로더 T축이 회피 위치를 넘지 않았을 경우 → 언로더 Z축 구동 가능.
					         P_IL_Popup_Motor = 0;												// 팝업모터 초기화
					         P_IL_Robot_Bit = 0;												// 인터락 비트 초기화
					         P_IL_Outer_Status = N_IL_Normal_Pos;								// Normal Pos
					      }
					   }
					}
					else if( P_Motor_Current_Pos(N_UNLOADER_X) >= P_Recipe_M46_POS(2) + P_IL_In_Offset(13) )      // 언로더 하강위치에서 1차진입 위치를 넘어간다면   P_IL_In_Offset(13) = 1
					{ // 1.2. 언로더 X축이 스택 진입 전 위치를 넘었을 경우.
						if( P_IL_Motor_Page == N_UNLOADER_X )									// 언로더 X 선택되었을 경우
						{ // 1.2.1. 언로더 X축 선택 시 구동 불가.
						   P_IL_Popup_Motor = N_MAIN_Z;											// 인터락 팝업 모터 추가
						   P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락
						   P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
						}
						// [ 참조 : 26.10.02 인터락 조건 추가 ]
						if( P_IL_Motor_Page == N_UNLOADER_T )
						{ // 1.2.2. 언로더 T축 선택 시 구동 불가.
						   P_IL_Popup_Motor = N_MAIN_Z;											// 인터락 팝업 모터 추가
						   P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
						   P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
						}
						else
						{ // 1.2.3. 언로더 Z축 선택.
							P_IL_Popup_Motor = 0;												// 팝업모터 초기화
							P_IL_Robot_Bit = 0;													// 인터락 비트 초기화
							P_IL_Outer_Status = N_IL_Normal_Pos;								// Normal Pos
						}
					}
					else
					{ // 1.3. 언로더 X축이 대기위치와 스택 진입 전 위치 사이일 경우. 
					   P_IL_Popup_Motor = 0;													// 팝업모터 초기화
					   P_IL_Robot_Bit = 0;														// 인터락 비트 초기화
					   P_IL_Outer_Status = N_IL_Normal_Pos;										// Normal Pos
					}
				}
				else if( P_Motor_Current_Pos(N_UNLOADER_Z) > P_Recipe_M47_POS(2) + P_IL_In_Offset(18) )			// 언로더 Z축이 스택 진입 상승 위치보다 적을때 ( 대기위치 ~ 상승위치 사이 ) P_IL_In_Offset(18) = 1
				{ // 2. 언로더 Z축이 스택진입상승 위치보다 밑에 있을 경우.
					if( P_Motor_Current_Pos(N_UNLOADER_X) <= P_Recipe_M46_POS(1) + P_IL_In_Offset(16) )			// 1차 언로더 X가 대기위치일때      P_IL_In_Offset(16) = 5
					{ // 2.1. 언로더 X축이 대기 위치 일 경우.
						if( P_IL_Motor_Page == N_UNLOADER_T )									// 언로더 T 선택되었을 경우
						{ // 2.1.1. 언로더 T축 선택 시 구동 불가.
						   P_IL_Popup_Motor = N_2nd_UNLOADER;									// 인터락 팝업 모터 추가
						   P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스,마이너스 인터락 
						   P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
						} 
						else
						{ // 2.1.2. 언로더 X축, Z축 선택.
							P_IL_Popup_Motor = 0;												// 팝업모터 초기화
							P_IL_Robot_Bit = 0;													// 인터락 비트 초기화
							P_IL_Outer_Status = N_IL_Upper_Pos;									// N_IL_Upper_Pos
						}
					}
					else if( P_Motor_Current_Pos(N_UNLOADER_X) > P_Recipe_M46_POS(2) + P_IL_In_Offset(13) )		// 언로더 하강위치에서 1차진입 위치를 넘어간다면   P_IL_In_Offset(13) = 1
					{ // 2.2. 언로더 X축이 스택 진입 전 위치를 넘어갔을 경우.
						if( P_IL_Motor_Page == N_UNLOADER_X )		// 언로더 X 선택되었을 경우
						{ // 2.2.1. 언로더 X축 선택 시 구동 불가.
						   P_IL_Popup_Motor = N_MAIN_Z;											// 인터락 팝업 모터 추가
						   P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락
						   P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
						}     
						else if( P_IL_Motor_Page == N_UNLOADER_T ) // 언로더 T 선택되었을 경우		[ 참조 : 26.10.02 인터락 조건 추가 ]
						{ // 2.2.2. 언로더 T축 선택 시 구동 불가.
						   P_IL_Popup_Motor = N_MAIN_Z;										// 인터락 팝업 모터 추가
						   P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스,마이너스 인터락 
						   P_IL_Outer_Status = IL_Out_Close;								// 외부 인터락 닫기
						}
						else
						{ // 2.2.3. 언로더 Z축 선택.
							P_IL_Popup_Motor = 0;											// 팝업모터 초기화
							P_IL_Robot_Bit = 0;												// 인터락 비트 초기화
							P_IL_Outer_Status = N_IL_Upper_Pos;								// N_IL_Upper_Pos
						}
				   }
				   else
				   { // 2.3. 언로더 X축이 대기위치와 스택 진입 전 위치 사이일 경우.
				      P_IL_Popup_Motor = 0;													// 팝업모터 초기화
				      P_IL_Robot_Bit = 0;													// 인터락 비트 초기화
				      P_IL_Outer_Status = N_IL_Upper_Pos;									// N_IL_Upper_Pos
				   }
				}
				else   // 언로더 Z가 스택 위치이면서 더 높게 있다면
				{ // 3. 언로더 Z축이 스택진입상승 위치보다 위에 있을 경우.
				   if( P_Motor_Current_Pos(N_UNLOADER_X) <= P_Recipe_M46_POS(1) + P_IL_In_Offset(16) )         // 1차 언로더 X가 대기위치일때      P_IL_In_Offset(16) = 5
				   { // 3.1. 언로더 X축이 대기위치 일 경우.
				      if( P_IL_Motor_Page == N_UNLOADER_T )   // 언로더 T 선택되었을 경우
				      { // 3.1.1. 언로더 T축 선택 시 구동 불가.
				         P_IL_Popup_Motor = N_2nd_UNLOADER;									// 인터락 팝업 모터 추가
				         P_IL_Robot_Bit = Hex_IL_Plus										// 플러스 인터락 
				         P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
				      }
				      else
				      { // 3.1.2. 언로더 X축, Z축 선택 시 구동 가능.
				         P_IL_Popup_Motor = 0;												// 팝업모터 초기화
				         P_IL_Robot_Bit = 0;												// 인터락 비트 초기화
				         P_IL_Outer_Status = N_IL_Upper_Pos;								// N_IL_Upper_Pos
				      }
				   }
				   else if( P_Motor_Current_Pos(N_UNLOADER_X) > P_Recipe_M46_POS(2) + P_IL_In_Offset(13) )		// 언로더 하강위치에서 1차진입 위치를 넘어간다면   P_IL_In_Offset(13) = 1
				   { // 3.2. 언로더 X축이 스택 진입 전 위치를 넘어갔을 경우.
				      if( P_IL_Motor_Page == N_UNLOADER_T )									// 언로더 T 선택되었을 경우
				      { // 3.2.1. 언로더 T축 선택 시 구동 불가.
				         P_IL_Popup_Motor = N_MAIN_Z;										// 인터락 팝업 모터 추가
				         P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스,마이너스 인터락 
				         P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
				      }
				      else
				      { // 3.2.2. 언로더 X축, Z축 선택 시 구동 가능.
				         P_IL_Popup_Motor = 0;												// 팝업모터 초기화
				         P_IL_Robot_Bit = 0;												// 인터락 비트 초기화
				         P_IL_Outer_Status = N_IL_Stack_Pos;								// N_IL_Upper_Pos
				      }
				   }
				}
		      //if( P_Motor_Current_Pos(N_UNLOADER_X) >= P_Recipe_M46_POS(1) - 0.5 && P_Motor_Current_Pos(N_UNLOADER_X) <= P_Recipe_M46_POS(1) + 0.5)      // 언로더 X가 대기위치라면
		      //{   //  언로더가 X 대기위치, 언로더 Z축 상승 
		      //   if( P_Motor_Current_Pos(N_UNLOADER_Z) <= P_Recipe_M47_POS(2) )           // 언로더 Z축이 상승해 있다면
		      //      P_IL_Outer_Status = N_IL_Upper_Pos;                           // 상승위치
		      //   else
		      //   {   // 언로더 X대기위치 이면서, 언로더 Z축이 하강위치라면
		      //      if( P_IL_Motor_Page == N_UNLOADER_T )                        // 언로더 T축
		      //      {
		      //         P_IL_Robot_Bit = Hex_IL_Plus;                              // 플러스 인터락 ( 대기위치라면 2차 언로더랑 충돌위험이있으므로 )
		      //         P_IL_Outer_Status = IL_Out_Close;                           // 외부 인터락 닫기
		      //         P_IL_Popup_Motor = N_UNLOADER_T;                           // 인터락 팝업 모터 추가   
		      //      }
		      //      else                                                   // 현재 선택된 모터가 T축이 아니라면            
		      //         P_IL_Outer_Status = N_IL_Normal_Pos;
		      //   }
		      //}
		      //else   // 언로더가 X 대기위치가 아니라면
		      //{   // 언로더 X가 대기위치가 아니고 하강 했다면
		      //   if( P_Motor_Current_Pos(N_UNLOADER_Z) >= P_Recipe_M47_POS(2) )            // 언로더 Z축이 하강해 있다면
		      //   {
		      //      if( P_Motor_Current_Pos(N_UNLOADER_X) < P_Recipe_M46_POS(2))         // X 위치가 1차 진입 전이라면
		      //         P_IL_Outer_Status = N_IL_Normal_Pos;                        // 노말
		    //
		      //      else   // X위치가 1차 진입위치를 초과한다면 X 인터락 걸어버리자
		      //      {
		      //         if( P_IL_Motor_Page == N_UNLOADER_X )                        // 언로더 X축
		      //         {
		      //            P_IL_Robot_Bit = Hex_IL_Plus;                           // 플러스 인터락 (전진불가)
		      //            P_IL_Outer_Status = IL_Out_Close;                        // 외부 인터락 닫기
		      //            P_IL_Popup_Motor = N_UNLOADER_X ;                        // 인터락 팝업 모터 추가
		      //         }
		      //         else                                                // 선택된 모터가 X축이 아니라면
		      //            P_IL_Outer_Status = N_IL_Normal_Pos;                     // 노말모드
		      //      }
		      //   }
		      //   else   // 언로더가 상승해 있다면
		      //   {   // 언로더가 X가 대기위치가 아니고 상승해 있다면
		      //      if( P_Motor_Current_Pos(N_UNLOADER_X) > P_Recipe_M46_POS(2))         // 언로더가 1차 진입 위치를 넘어간다면                                    
		      //      {
		      //         if( P_Motor_Current_Pos(N_UNLOADER_T) ~ P_Recipe_M48_POS(1) )      // 언로더 T축이 정위치라면
		      //         {
		      //            if( P_IL_Motor_Page == N_UNLOADER_T )                     // 언로더 T축
		      //            {
		      //               P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;            // 플러스 인터락 ( 대기위치라면 2차 언로더랑 충돌위험이있으므로 )
		      //               P_IL_Outer_Status = IL_Out_Close;                     // 외부 인터락 닫기
		      //               P_IL_Popup_Motor = N_UNLOADER_T;                     // 인터락 팝업 모터 추가                        
		      //            }
		      //            else                                             // 선택된 모터가 T축이 아니라면
		      //               P_IL_Outer_Status = N_IL_Stack_Pos;                     // Stack Pos
		      //         }
		      //         else                                                // 언로더T가 정위치가 아니라면
		      //         {
		      //            if( P_IL_Motor_Page == N_UNLOADER_X )                     // 언로더 X축
		      //            {
		      //               P_IL_Robot_Bit = Hex_IL_Plus;                        // 플러스 인터락 (전진불가)
		      //               P_IL_Outer_Status = IL_Out_Close;                     // 외부 인터락 닫기
		      //               P_IL_Popup_Motor = N_UNLOADER_T ;                     // 인터락 팝업 모터 추가
		      //            }
		      //            else                                             // 선택된 모터가 X축이 아니라면
		      //               P_IL_Outer_Status = N_IL_Stack_Pos;                     // Stack Pos
		      //         }
		      //      }
		      //      else   // 언로더 X가 1차 진입위치 전이라면
		      //         P_IL_Outer_Status = N_IL_Upper_Pos;
		      //   }
		      //}
			break;   
			case N_IL_Robot_Sheet_Paper:   // 16번로봇 시트페이퍼 X 35
				if(P_Motor_Current_Pos(N_SHEET_PAPER_X) > P_Recipe_M35_POS(2) )				// 티칭위치보다 넘어간다면
				{
				   P_IL_Robot_Bit = Hex_IL_Plus;											// 시트페이퍼 플러스 방향 인터락
				   P_IL_Outer_Status = IL_Out_Close;
				   P_IL_Popup_Motor = N_SHEET_PAPER_X ;										// 인터락 팝업 모터 추가
				}
				else
					P_IL_Outer_Status = N_IL_Normal_Pos;
			break;
		}
	}
   // =========================================================================================================================================
	// 내부에서 아우터 상태를 변경할 때, 감지 및 초기화 하는 구간
	if(P_IL_Outer_Status != L_Old_Outer_IL_Status)
	{
		P_Limit_PosData(Hex_IL_Plus) = N_Nan;
		P_Limit_PosData(Hex_IL_Minus) = N_Nan;
		P_Collision_Risk_Motor(Hex_IL_Plus) = 0;
		P_Collision_Risk_Motor(Hex_IL_Minus) = 0;
		P_Plus_IL_Offset = 0;
		P_Minus_IL_Offset = 0;
		P_IL_Robot_Bit = 0;
	}
	L_Old_Outer_IL_Status = P_IL_Outer_Status;

	// <<<<<<<<<<<<<<<<<<<<<< 외부 유닛 별 인터락 감시 구역 >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
	// 4. 외부 로봇 인터락 감시 ==================================================================================================================	
	if( P_IL_Outside_Home_Chk_Complete == 1 )		// [ 참조 : 26.06.19 모터 인터락 수정 ]
	{
		switch ( P_IL_Motor_Page )
		{
			case N_1st_Picker_CA_T:	
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				
					//================================ 미사용 위치 인터락 ===========================================
						P_No1_Recipe_Pos_IL(N_1st_Picker_CA_T) = 0;			// 인터락
						P_No2_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No3_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No4_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No5_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No6_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No7_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No8_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No9_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
						P_No10_Recipe_Pos_IL(N_1st_Picker_CA_T) = 1;			// 인터락
			break;
			case N_1st_PnP_CA_T:		// 양극 1차 PNP T축 외부 인터락
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				//if(P_IL_Outer_Status != IL_Out_Close)	
				if(P_IL_Outer_Status != IL_Out_Close && P_IL_Outer_Status != N_IL_Belt_Down_Pos && P_IL_Outer_Status != N_IL_Align_Down_Pos )		// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{ 
				//================================ 1번위치 - 대기위치 ( 45도 ) ================================
					// ↓ 양극 1차 PNP T축 대기 위치 || 양극 1차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(1) || P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5 )				
						P_No1_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;		// 인터락	
					else
						P_No1_Recipe_Pos_IL(N_1st_PnP_CA_T) = 0;		// 인터락 해제
				//================================== 2번위치 - 벨트위치 ( 0도 ) ================================
					// ↓ 양극 1차 PNP T축 벨트 위치 || 반대열 1차 PNP T축 < 20º || 반대열 Auto 상태 || 양극 1차 PNP Z축 ≥ 대기위치 + 0.5º || 격벽 하강
					if(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(2) || P_OP_Side_Ca_PNP_Pos  < 20 || P_OP_Side_PMAC_Cur_Mode == F_Current_Automatic || P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5 || M_X_Cathode_Belt_Partition_Down_Sensor == 1)	
						P_No2_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;		// 인터락
					else
						P_No2_Recipe_Pos_IL(N_1st_PnP_CA_T) = 0;		// 인터락 해제
				//================================ 3번위치 - 얼라인위치 ( 90도 ) ================================
					// ↓ 양극 1차 PNP T축 얼라인 위치 || 양극 2차 PNP T축 < 30º || 양극 NG PNP T축 > 대기 위치 + 40º || 양극 1차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(3) || P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 30 || P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 40 || P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5)	
						P_No3_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;		// 인터락
					else
						P_No3_Recipe_Pos_IL(N_1st_PnP_CA_T) = 0;		// 인터락 해제
				//================================ 미사용 위치 인터락 ===========================================
					P_No4_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락

				}
				else
				{
					P_No1_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_CA_T) = 1;			// 인터락
				}
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page) - 90;		// 절대위치 변환 시 양극 얼라인이 0도가 되고 1차 PNP는 엔코더는 -90 Offset을 해줘서 기준 절대위치 셋팅 
				//if(P_IL_Outer_Status == N_IL_Normal_Pos || P_IL_Outer_Status == N_IL_Belt_Pos || P_IL_Outer_Status == N_IL_Align_Pos)
				if(P_IL_Outer_Status == N_IL_Normal_Pos || P_IL_Outer_Status == N_IL_Belt_Pos || P_IL_Outer_Status == N_IL_Align_Pos || P_IL_Outer_Status == N_IL_Belt_Down_Pos || P_IL_Outer_Status == N_IL_Align_Down_Pos )	// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{
					// ================================ 플러스 간섭 요인 : <<Ca 2nd PNP>> ==================================//
					P_Plus_IL_Offset = P_Ca_1st_Plus_IL_Offset;							// 플러스 방향 오프셋 거리 -40
					P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;				// P 방향 충돌 위험 모터 설정 << 양 2차 PNP >>
					P_Limit_PosData(Hex_IL_Plus) = P_Motor_Current_Pos(N_2nd_PnP_CA_T) + P_Plus_IL_Offset;		// 절대 위치와 비교 될 P Limit 
					
					// ================================ 마이너스 간섭 요인 : <<OP Ca 1st PNP>> =============================//

					if(P_OP_Side_PMAC_Cur_Mode == F_Current_Automatic)
					{
						P_Minus_IL_Offset = 0;											// 마이너스 방향 오프셋 거리
						P_Collision_Risk_Motor(Hex_IL_Minus) = 51;						// M 방향 충돌 위험 모터 설정 << 반대 양 1차 PNP >>
						P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M01_POS(1) - 90;		// 절대 위치와 비교 될 M Limit  
					}
					else if(M_X_Cathode_Belt_Partition_Down_Sensor == 1)
					{
						P_Minus_IL_Offset = 0;
						P_Collision_Risk_Motor(Hex_IL_Minus) = 51;
						P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M01_POS(1) - 90 + P_Partition_1st_Avoid_Offset;
					}
					else
					{
						P_Minus_IL_Offset = P_Ca_1st_Minus_IL_Offset;					// 마이너스 방향 오프셋 거리
						P_Collision_Risk_Motor(Hex_IL_Minus) = 51;						// M 방향 충돌 위험 모터 설정 << 반대 양 1차 PNP >>
						P_Limit_PosData(Hex_IL_Minus) = (P_OP_Side_Ca_PNP_Pos * -1) - 90 + P_Minus_IL_Offset;		// 절대 위치와 비교 될 M Limit  
					}
				}

			break;


			case N_1st_PnP_CA_Z:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				if(P_IL_Outer_Status != IL_Out_Close) //[참조 : 260702 릴컷 또는 NG box 도어 열릴 시 Z축 레시피 이동 불가하도록 수정]
				{ 
				//================================ 1번위치 - 대기 상승 ================================
					// ↓ 
					if(P_Cathode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M17_POS(1))
						P_No1_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;
					else
						P_No1_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 0;
				//================================ 2번위치 - 대기 하강 ================================
					// ↓ 양극 1차 PNP T축 !~ 대기 위치 || 양극 1차 PNP Z축 대기 하강
//					if(!(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(1)) || P_Cathode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M17_POS(2))		
//						P_No2_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;
//					else
//						P_No2_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 0;
				//================================ 3번위치 - 벨트 상승 ================================
					// ↓ 양극 1차 PNP T축 !~ 벨트 위치 || 양극 1차 PNP Z축 벨트 상승
					if(!(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(2)) || P_Cathode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M17_POS(3))		
						P_No3_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;
					else
						P_No3_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 0;
				//================================ 4번위치 - 벨트 하강 ================================
					// ↓ 양극 1차 PNP T축 !~ 벨트 위치 || 양극 1차 PNP Z축 벨트 하강
					if(!(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(2)) || P_Cathode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M17_POS(4))		
						P_No4_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;
					else
						P_No4_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 0;
				//================================ 5번위치 - 얼라인 상승 ================================
					// ↓ 양극 1차 PNP T축 !~ 얼라인 위치 || 양극 1차 PNP Z축 얼라인 상승
					if(!(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(3)) || P_Cathode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M17_POS(5))		
						P_No5_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;
					else
						P_No5_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 0;
				//================================ 6번위치 - 얼라인 하강 ================================
					// ↓ 양극 1차 PNP T축 !~ 얼라인 위치 || 양극 1차 PNP Z축 얼라인 하강
					if(!(P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ P_Recipe_M01_POS(3)) || P_Cathode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M17_POS(6))		
						P_No6_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;
					else
						P_No6_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 0;

				// 안쓰는 위치 
					P_No7_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
			     }
				 else 
				 {
					P_No1_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_CA_Z) = 1;			// 인터락
				 }
			break;
			
			case N_1st_Picker_AN_T:	
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				
					//================================ 미사용 위치 인터락 ===========================================
						P_No1_Recipe_Pos_IL(N_1st_Picker_AN_T) = 0;			// 인터락
						P_No2_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No3_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No4_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No5_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No6_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No7_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No8_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No9_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
						P_No10_Recipe_Pos_IL(N_1st_Picker_AN_T) = 1;			// 인터락
			break;

			case N_1st_PnP_AN_T:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				//if(P_IL_Outer_Status != IL_Out_Close)
				if(P_IL_Outer_Status != IL_Out_Close && P_IL_Outer_Status != N_IL_Belt_Down_Pos && P_IL_Outer_Status != N_IL_Align_Down_Pos )		// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{ 
				//================================ 1번위치 - 대기위치 ( 45도 ) ================================
					// ↓ 음극 1차 PNP T축 대기 위치 || 음극 1차 PNP Z축 ≥ 대기위치 + 0.5
					if(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(1) || P_Motor_Current_Pos(N_1st_PnP_AN_Z) >= P_Anode_1st_Z_Ready_Up + 0.5 )				// 대기 위치라면,
						P_No1_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			
					else
						P_No1_Recipe_Pos_IL(N_1st_PnP_AN_T) = 0;
				//================================ 2번위치 - 벨트위치 ( 0도 ) ================================
					// ↓ 음극 1차 PNP T축 벨트 위치 || 반대열 1차 PNP T축 < 20º || 반대열 Auto 상태	음극 1차 PNP Z축 ≥ 대기위치 + 0.5º || 격벽 하강 ||
					if(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(2) || P_OP_Side_An_PNP_Pos < 20 || P_OP_Side_PMAC_Cur_Mode == F_Current_Automatic || P_Motor_Current_Pos(N_1st_PnP_AN_Z) >= P_Anode_1st_Z_Ready_Up + 0.5 || M_X_Anode_Belt_Partition_Down_Sensor == 1)		// 1차 벨트 위치에 있거나, 반대 1차가 벨트위치에 있으면 인터락
						P_No2_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;
					else
						P_No2_Recipe_Pos_IL(N_1st_PnP_AN_T) = 0;
				//================================ 3번위치 - 얼라인위치 ( 90도 ) ================================
					// ↓ 음극 1차 PNP T축 얼라인 위치 || 음극 2차 PNP T축 < 30º || 음극 NG PNP T측 > 대기 위치 + 40º || 음극 1차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(3) || P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 30 || P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(1) + 40 || P_Motor_Current_Pos(N_1st_PnP_AN_Z) >= P_Anode_1st_Z_Ready_Up + 0.5 )		// 1차가 얼라인에 있거나, 2차가 얼라인에 있으면, 
						P_No3_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 얼라인위치 인터락.
					else
						P_No3_Recipe_Pos_IL(N_1st_PnP_AN_T) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No4_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락

				}
				else
				{
					P_No1_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_AN_T) = 1;			// 인터락
				}
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page) - 90 ;			// 절대위치 변환 시 양극 얼라인이 0도가 되고 1차 PNP는 엔코더는 -90 Offset을 해줘서 기준 절대위치 셋팅 
				//if(P_IL_Outer_Status == N_IL_Normal_Pos || P_IL_Outer_Status == N_IL_Belt_Pos || P_IL_Outer_Status ==N_IL_Align_Pos)
				if(P_IL_Outer_Status == N_IL_Normal_Pos || P_IL_Outer_Status == N_IL_Belt_Pos || P_IL_Outer_Status == N_IL_Align_Pos || P_IL_Outer_Status == N_IL_Belt_Down_Pos || P_IL_Outer_Status == N_IL_Align_Down_Pos )	// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{
					// ================================ 플러스 간섭 요인 : <<An 2nd PNP>> ==================================//
					P_Plus_IL_Offset = P_An_1st_Plus_IL_Offset;								// 플러스 방향 오프셋 거리 
					P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_AN_T;					// P 방향 충돌 위험 모터 설정 << 음 2차 PNP >>
					P_Limit_PosData(Hex_IL_Plus) = P_Motor_Current_Pos(N_2nd_PnP_AN_T) + P_Plus_IL_Offset;		// 절대 위치와 비교 될 P Limit 
				
					// ================================ 마이너스 간섭 요인 : <<OP An 1st PNP>> =============================//
					if(P_OP_Side_PMAC_Cur_Mode == F_Current_Automatic)
					{
						P_Minus_IL_Offset = 0;				// 마이너스 방향 오프셋 거리
						P_Collision_Risk_Motor(Hex_IL_Minus) = 52;							// M 방향 충돌 위험 모터 설정 << 반대 음 1차 PNP >>
						P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M02_POS(1) - 90;			// 절대 위치와 비교 될 M Limit  
					}
					else if(M_X_Anode_Belt_Partition_Down_Sensor == 1)
					{
						P_Minus_IL_Offset = 0;
						P_Collision_Risk_Motor(Hex_IL_Minus) = 52;
						P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M02_POS(1) - 90 + P_Partition_1st_Avoid_Offset;
					}
					else
					{
						P_Minus_IL_Offset = P_An_1st_Minus_IL_Offset;						// 마이너스 방향 오프셋 거리
						P_Collision_Risk_Motor(Hex_IL_Minus) = 52;							// M 방향 충돌 위험 모터 설정 << 반대 음 1차 PNP >>
						P_Limit_PosData(Hex_IL_Minus) = (P_OP_Side_An_PNP_Pos * -1) - 90 + P_Minus_IL_Offset;		// 절대 위치와 비교 될 M Limit  
					}
				}

			break;

			case N_1st_PnP_AN_Z:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				if(P_IL_Outer_Status != IL_Out_Close) //[참조 : 260702 릴컷 또는 NG box 도어 열릴 시 Z축 레시피 이동 불가하도록 수정]
				{ 
				//================================ 1번위치 - 대기 상승 ================================
					// ↓ 음극 1차 PNP Z축 대기 상승
					if(P_Anode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M18_POS(1))		
						P_No1_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;
					else
						P_No1_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 0;
				//================================ 2번위치 - 대기 하강 ================================
					// ↓ 음극 1차 PNP T축 !~ 대기 위치 || 음극 1차 PNP Z축 대기 하강
//					if(!(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(1)) || P_Anode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M18_POS(2))		
//						P_No2_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;
//					else
//						P_No2_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 0;
				//================================ 3번위치 - 벨트 상승 ================================
					// ↓ 음극 1차 PNP T축 !~ 벨트 위치 || 음극 1차 PNP Z축 벨트 상승
					if(!(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(2)) || P_Anode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M18_POS(3))		
						P_No3_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;
					else
						P_No3_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 0;
				//================================ 4번위치 - 벨트 하강 ================================
					// ↓ 음극 1차 PNP T축 !~ 벨트 위치 || 음극 1차 PNP Z축 벨트 하강
					if(!(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(2)) || P_Anode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M18_POS(4))		
						P_No4_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;
					else
						P_No4_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 0;
				//================================ 5번위치 - 얼라인 상승 ================================
					// ↓ 음극 1차 PNP T축 !~ 얼라인 위치 || 음극 1차 PNP Z축 얼라인 상승
					if(!(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(3)) || P_Anode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M18_POS(5))		
						P_No5_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;
					else
						P_No5_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 0;
				//================================ 6번위치 - 얼라인 하강 ================================
					// ↓ 음극 1차 PNP T축 !~ 얼라인 위치 || 음극 1차 PNP Z축 얼라인 하강
					if(!(P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ P_Recipe_M02_POS(3)) || P_Anode_1st_PNP_Z_Real_Move_Pos ~ P_Recipe_M18_POS(6))		
						P_No6_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;
					else
						P_No6_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 0;
				// 안쓰는 위치 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
				}
				else 
				{
					P_No1_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_1st_PnP_AN_Z) = 1;			// 인터락
				}
			break;


			case N_2nd_PnP_CA_T:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				//if(P_IL_Outer_Status != IL_Out_Close)
				if(P_IL_Outer_Status != IL_Out_Close && P_IL_Outer_Status != N_IL_Align_Down_Pos && P_IL_Outer_Status != N_IL_Stack_Down_Pos )		// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{ 
				//================================ 1번위치 - 얼라인 위치  ================================
					// ↓ 양극 2차 PNP T축 얼라인 위치 || 양극 1차 PNP T축 > 50º || 양극 NG PNP T축 > 대기 위치 + 40º || 양극 2차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1) || P_Motor_Current_Pos(N_1st_PnP_CA_T) > 50 || P_Motor_Current_Pos(N_UNLOADER_Z) < P_Recipe_M47_POS(2) + 50 || P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 40 || P_Motor_Current_Pos(N_2nd_PnP_CA_Z) >= P_Cathode_2nd_Z_Ready_Up + 0.5 )
						P_No1_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;
					else
						P_No1_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 0;
				//================================ 2번위치 - 스택 위치 ================================
					// ↓ 양극 2차 PNP T축 스택 위치 || 양극 1차 PNP T축 > 50º || 파이널 롤러 X축 ＞ 양극 위치 || 양극 NG PNP T축 > 대기 위치 + 40º || 	양극 2차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(2) || P_Motor_Current_Pos(N_1st_PnP_CA_T) > 50 || P_Motor_Current_Pos(N_FINAL_ROLL_X) > (P_Recipe_M12_POS(2) + 0.1) || P_Motor_Current_Pos(N_UNLOADER_Z) <= P_Recipe_M47_POS(2) + 50 || P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 40 || P_Motor_Current_Pos(N_2nd_PnP_CA_Z) >= P_Cathode_2nd_Z_Ready_Up + 0.5 )	
						P_No2_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;
					else
						P_No2_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_2nd_PnP_CA_T) = 1;			// 인터락
				}
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);							// 절대위치 변환 시 양극 얼라인이 0도가 되고 1차 PNP는 엔코더는 -90 Offset을 해줘서 기준 절대위치 셋팅 
				switch(P_IL_Outer_Status)
				{
					//case N_IL_Normal_Pos:		// << N_IL_Normal_Pos >> 10도 이하 일 경우
					case N_IL_Normal_Pos:
					case N_IL_Align_Down_Pos:		// << N_IL_Normal_Pos >> 대기 위치 + 15도 이하 일 경우	[ 참조 : 26.10.02 인터락 조건 추가 ]
					// ================================ 플러스 간섭 요인 : <<Unloader,NG PNP>> ==================================//
						P_Plus_IL_Offset = P_Ca_2nd_T_Plus_IL_Offset(0);							// Offset value : 0, 2차 PNP가 얼라인 부근에서 플러스 이동 중 언로더와 NG PNP와의 간격 오프셋.
						if(P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M43_POS(1) + 35 )			// NG PNP가 2차 PNP 간섭 위치까지 들어올 경우.
						{
							//P_Limit_PosData(Hex_IL_Plus) = 10 + P_Plus_IL_Offset;					// 2차 PNP 위치가 이 값을 넘어갈 경우 정지.
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M03_POS(1) + 10 + P_Plus_IL_Offset;		// 2차 PNP 위치가 이 값을 넘어갈 경우 정지.	[ 참조 : 26.10.02 인터락 조건 추가 ]
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_NG_PnP_CA_T;
						}
						else if(P_Motor_Current_Pos(N_UNLOADER_Z) <= P_Recipe_M47_POS(2) + 50)		// 언로더 Z축이 스택 진입 상승 위치 + 50mm 하강보다 위에 있을 경우.
						{
							//P_Limit_PosData(Hex_IL_Plus) = 10 + P_Plus_IL_Offset;					// 2차 PNP 위치가 이 값을 넘어갈 경우 정지.
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M03_POS(1) + 10 + P_Plus_IL_Offset;		// 2차 PNP 위치가 이 값을 넘어갈 경우 정지.	[ 참조 : 26.10.02 인터락 조건 추가 ]
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_UNLOADER_Z;
						}
					// ================================ 마이너스 간섭 요인 : <<Ca 1st PNP>> =============================//
						P_Minus_IL_Offset = P_Ca_2nd_T_Minus_IL_Offset(0);							// Offset value : 35, 2차 PNP가 얼라인 부근에서 마이너스 이동 중 1차 PNP와의 간격 오프셋.
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_1st_PnP_CA_T) - 90 + P_Minus_IL_Offset;		// Ca 1st PNP 기준 왼쪽 물체 << 반대편 Ca 1st pnp >> 절대좌표 변환 
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_1st_PnP_CA_T;
						
					break;

					case N_IL_Upper_Pos:			// << N_IL_Upper_Pos >> 대기 위치 + 15도 ~ 스택 위치 - 35도 일 경우
					// ================================ 플러스 간섭 요인 : <<Final Roller>> ==================================//
						if(P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Recipe_M12_POS(2)+0.1)			// FR X가 음극 위치보다 살짝 스텍부 방향으로 더 들어와있는경우.
						{
							//P_Limit_PosData(Hex_IL_Plus) = 50 + P_Ca_2nd_T_Plus_IL_Offset(2);		// Offset value : 0, 2차 PNP가 얼라인과 스택 부근이 아닐 때 플러스 이동 중 파이널 롤러와의 간격 오프셋.
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M03_POS(1) + 50 + P_Ca_2nd_T_Plus_IL_Offset(2);		// Offset value : 0, 2차 PNP가 얼라인과 스택 부근이 아닐 때 플러스 이동 중 파이널 롤러와의 간격 오프셋.	[ 참조 : 26.10.02 인터락 조건 추가 ]
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
						}
					// ================================ 마이너스 간섭 요인 : <<Ca NG PNP, Ca 1st PNP >> =============================//
						P_Minus_IL_Offset = P_Ca_2nd_T_Minus_IL_Offset(1);							// Offset value : 40, 2차 PNP가 얼라인과 스택 부근이 아닐 때 마이너스 이동 중 NG PNP, 1차 PNP와의 간격 오프셋.
						if(P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 50)			// NG PNP가 대기위치보다 50도 초과할 경우.	 
						{ 
							P_Limit_PosData(Hex_IL_Minus) = P_Minus_IL_Offset						// Unloader Status 못벗어나게 해야함.
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_NG_PnP_CA_T;
						}
						//else if(P_Motor_Current_Pos(P_IL_Motor_Page) > 60)
						else if(P_Motor_Current_Pos(P_IL_Motor_Page) > P_Recipe_M03_POS(1) + 60)	// 2차 pnp가 60도 초과 일 경우.
						{
							if(P_Motor_Current_Pos(N_UNLOADER_Z) <= P_Recipe_M47_POS(2) + 50)		// 언로더 Z축이 스택 진입 상승 위치 + 50mm 하강보다 위에 있을 경우.
							{
								P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;				// Unloader Status 못벗어나게 해야함.
								P_Collision_Risk_Motor(Hex_IL_Minus) = N_UNLOADER_Z;
							}
						}
						else																		// 1차 PNP 위치를 마이너스 리밋으로 설정
						{
							P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_1st_PnP_CA_T) - 90 + P_Minus_IL_Offset
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_1st_PnP_CA_T;
						}
					break;

					//case N_IL_Stack_Pos:		// << N_IL_Stack_Pos >> 70도 이상 일 경우
					case N_IL_Stack_Pos:
					case N_IL_Stack_Down_Pos:		// << N_IL_Stack_Pos >> 스택 위치 -35도 이상 일 경우		[ 참조 : 26.10.02 인터락 조건 추가 ]
					// ================================ 플러스 간섭 요인 : <<Final Roller, Main Z, Clamp Z>> ==================================//	
						if(P_Motor_Current_Pos(N_FINAL_ROLL_X) <= P_Recipe_M12_POS(2) + 0.1)		// FR X가 음극 위치에 있을 경우 90도까지 가능.
						{
							//P_Z_Pos_Data = P_Motor_Current_Pos(N_MAIN_Z) + 1;
							P_Z_Pos_Data = P_Motor_Current_Pos(N_MAIN_Z);
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_MAIN_Z;
							// 현재 모터들이 Z축 리밋이 설정값보다 높다면 갱신하기.
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z2))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z2);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_CA_Z2;
							}
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z2))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z2);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_AN_Z2;
							}
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z1))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z1);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_CA_Z1;
							}
							
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z1))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z1);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_AN_Z1;
							}
							// 최종 plus 값이 0보다 낮으면 2차 PNP 진입가능.
							if(P_Z_Pos_Data < P_Recipe_M11_POS(1) + 0.5)
							{// Main Z가 대기위치 + 1 값 보다 높은 값을 가진다면,
								//P_Limit_PosData(Hex_IL_Plus) = 90.5 + P_Ca_2nd_T_Plus_IL_Offset(1);			// Offset value : 0.5
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M03_POS(2) + P_Ca_2nd_T_Plus_IL_Offset(1);			// Offset value : 0.5, 2차 PNP가 스택 부근에서 플러스 이동 중 파이널 롤러, 스택 테이블, 클램프와의 간격 오프셋.	// [ 참조 : 26.10.02 인터락 조건 추가 ]
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
							}
							else
							{
								P_Limit_PosData(Hex_IL_Plus) = P_Z_Var;									// Offset value : 60
							}
						}
						else																			// FR X가 음극 위치가 아닌 곳에 있을 경우.
						{
							//P_Limit_PosData(Hex_IL_Plus) = 50 + P_Ca_2nd_T_Plus_IL_Offset(2);			// Offset value : 0, 2차 PNP가 얼라인과 스택 부근이 아닐 때 플러스 이동 중 파이널 롤러와의 간격 오프셋.
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M03_POS(1) + 50 + P_Ca_2nd_T_Plus_IL_Offset(2);			// Offset value : 0, 2차 PNP가 얼라인과 스택 부근이 아닐 때 플러스 이동 중 파이널 롤러와의 간격 오프셋.
							if(P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Recipe_M12_POS(2))				// FR X가 음극 위치 외에 있는 경우에는		
							{
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
							}
						}
					// ================================ 마이너스 간섭 요인 : <<Unloader>> =============================//
						P_Minus_IL_Offset = P_Ca_2nd_T_Minus_IL_Offset(2);								// Offset value : 80
						//if(P_Motor_Current_Pos(N_UNLOADER_Z) <= 50 )									/*언로더가 2차 간섭위치만큼 올라와 있는경우면*/
						if(P_Motor_Current_Pos(N_UNLOADER_Z) <= (P_Recipe_M47_POS(2) + 50) )				// 언로더 Z축이 스택 진입 상승 위치 + 50mm 하강보다 위에 있을 경우.
						{
							P_Limit_PosData(Hex_IL_Minus) = P_Minus_IL_Offset;							// Offset값 이전에 인터락.
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_UNLOADER_Z;
						}
					break;

				}
			break;

			case N_2nd_PnP_CA_Z:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			 if(P_IL_Outer_Status != IL_Out_Close) //[참조 : 260702 릴컷 또는 NG box 도어 열릴 시 Z축 레시피 이동 불가하도록 수정]
			 { 
				//================================ 1번위치 - 대기 상승 ================================
					// ↓ 양극 2차 PNP Z축 대기 상승
					if(P_Cathode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M21_POS(1))		
						P_No1_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;
					else
						P_No1_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 0;
				//================================ 2번위치 - 얼라인 상승 ================================
					// ↓ 양극 2차 PNP T축 !~ 얼라인 위치 || 양극 2차 PNP Z축 얼라인 상승
					if(!(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || P_Cathode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M21_POS(2))		
						P_No2_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;
					else
						P_No2_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 0;
				//================================ 3번위치 - 얼라인 하강 ================================
					// ↓ 양극 2차 PNP T축 !~ 얼라인 위치 || 양극 2차 PNP Z축 얼라인 하강
					if(!(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || P_Cathode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M21_POS(3))		
						P_No3_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;
					else
						P_No3_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 0;
				//================================ 4번위치 - 스텍 상승 ================================
					// ↓ 양극 2차 PNP T축 !~ 스택 위치 || 양극 2차 PNP Z축 스택 상승
					if(!(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(2)) || P_Cathode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M21_POS(4))		
						P_No4_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;
					else
						P_No4_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 0;
				//================================ 5번위치 - 스텍 하강 ================================
					// ↓ 양극 2차 PNP T축 !~ 스택 위치 || 양극 2차 PNP Z축 스택 하강
					if(!(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(2)) || P_Cathode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M21_POS(5))		
						P_No5_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;
					else
						P_No5_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 0;
				//================================ 6번위치 - 얼라인 블로우 ================================
					// ↓ 양극 2차 PNP T축 !~ 얼라인 위치 || 얼라인 블로우 레시피 > 얼라인 하강 || 양극 2차 PNP Z축 얼라인 블로우
					if(!(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || !(P_Recipe_M21_POS(6) <= P_Recipe_M21_POS(3)) || P_Cathode_2nd_PNP_Z_Real_Move_Pos > P_Recipe_M21_POS(6))		
						P_No6_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;
					else
						P_No6_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 0;
				// 안쓰는 위치 인터락
					P_No7_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
				}
				else 
				{
				    P_No1_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
				    P_No2_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
				    P_No3_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
				    P_No4_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
				    P_No5_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_2nd_PnP_CA_Z) = 1;			// 인터락
				}
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Recipe_M21_POS(5) - P_Cathode_2nd_PNP_Z_Real_Move_Pos;		// Ca 2nd Z [#21] 하강 위치 - 현재 위치 시 절대위치 변환 가능
				if(P_IL_Outer_Status == N_IL_Normal_Pos )
				{}
				else if(P_IL_Outer_Status == N_IL_Upper_Pos)			// 대기 위치 + 15도 ~ 스택 위치 -35도. 
				{
				// ================================ 플러스 간섭 요인 : <<없음>> ==================================//
				// ================================ 마이너스 간섭 요인 : <<Unloader>> =============================//
					
					P_Minus_IL_Offset = P_Ca_2nd_Z_Minus_IL_Offset(0);			// Offset value : 50
					P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_UNLOADER_Z) - P_Recipe_M47_POS(2) + P_Minus_IL_Offset;		// 언로더 현재위치 - 언로더 상승위치 시 절대위치 변환 가능. 
					P_Collision_Risk_Motor(Hex_IL_Minus) = N_UNLOADER_Z;
		
				}
				//else if(P_IL_Outer_Status == N_IL_Stack_Pos )			// 스택 위치 -35도 이상.
				else if(P_IL_Outer_Status == N_IL_Stack_Pos || P_IL_Outer_Status == N_IL_Stack_Down_Pos )		// 스택 위치 -35도 이상.	[ 참조 : 26.10.02 인터락 조건 추가 ]
				{
				// ================================ 플러스 간섭 요인 : <<없음>> ==================================//
				// ================================ 마이너스 간섭 요인 : <<Main Z, Clamp, >> =============================//
					P_Minus_IL_Offset = P_Ca_2nd_Z_Minus_IL_Offset(1);						// Offset value : 5
					P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_MAIN_Z);			// Main Z 현재 위치 값에서 추가 offset mm보다 못내려가게 해놓음.
					P_Collision_Risk_Motor(Hex_IL_Minus) = N_MAIN_Z;
					// 현재 모터들이 Z축 리밋이 설정값보다 높다면 갱신하기.
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_CA_Z2))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_CA_Z2);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z2;
					}
					
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_AN_Z2))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_AN_Z2);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z2;
					}
					
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_CA_Z1))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_CA_Z1);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z1;
					}
					
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_AN_Z1))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_AN_Z1);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z1;
					}
					P_Limit_PosData(Hex_IL_Minus) = P_Limit_PosData(Hex_IL_Minus) + P_Minus_IL_Offset;
				}
			break;

			case N_2nd_PnP_AN_T:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				//if(P_IL_Outer_Status != IL_Out_Close)
				if(P_IL_Outer_Status != IL_Out_Close && P_IL_Outer_Status != N_IL_Align_Down_Pos && P_IL_Outer_Status != N_IL_Stack_Down_Pos )		// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{ 
				//================================ 1번위치 - 얼라인 위치  ================================
					// ↓ 음극 2차 PNP T축 얼라인 위치 || 음극 1차 PNP T축 > 50º || 음극 NG PNP T축 > 대기 위치 + 40º || 음극 2차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ P_Recipe_M04_POS(1) || P_Motor_Current_Pos(N_1st_PnP_AN_T) > 50 || P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(1) + 40 || P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Ready_Up + 0.5 )	
						P_No1_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					else
						P_No1_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 0;
				//================================ 2번위치 - 스택 위치 ================================
					// ↓ 음극 2차 PNP T축 스택 위치 || 음극 1차 PNP T축 > 50º || 파이널 롤러 X축 ＜ 양극 위치 || 음극 NG PNP T축 > 대기 위치 + 40º || 음극 2차 PNP Z축 ≥ 대기위치 + 0.5º
					if(P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ P_Recipe_M04_POS(2) || P_Motor_Current_Pos(N_1st_PnP_AN_T) > 50 || P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(3) - 0.1 || P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(1) + 40 || P_Motor_Current_Pos(N_2nd_PnP_AN_Z) >= P_Anode_2nd_Z_Ready_Up + 0.5 )
						P_No2_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					else
						P_No2_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No4_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No5_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No6_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No7_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No2_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No3_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No4_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No5_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No6_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;
					P_No7_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_2nd_PnP_AN_T) = 1;			// 인터락
				}
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);							// 2차 PNP는 기본 엔코더값이 절대위치 값으로 적용됨.
		
				switch(P_IL_Outer_Status)
				{
					//case N_IL_Normal_Pos:		// << N_IL_Normal_Pos >> 10도 이하 일 경우
					case N_IL_Normal_Pos: 
					case N_IL_Align_Down_Pos:		// << N_IL_Normal_Pos >> 대기 위치 + 15도 이하 일 경우	[ 참조 : 26.10.02 인터락 조건 추가 ]
					// ================================ 플러스 간섭 요인 : <<NG PNP>> ==================================//
						P_Plus_IL_Offset = P_An_2nd_T_Plus_IL_Offset(0);					// Offset value : 0
						if(P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M42_POS(1) + 35)	// NG PNP가 대기위치 + 35도 보다 앞에 있을 경우.
						{
							//P_Limit_PosData(Hex_IL_Plus) = 10 + P_Plus_IL_Offset;			// 2차 PNP T축이 10도 + Offset 이상으로 움직이지 못함.
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M04_POS(1) + 10 + P_Plus_IL_Offset;			// 2차 PNP T축이 대기 위치 + 10도 + Offset 이상으로 움직이지 못함.
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_NG_PnP_AN_T;
						}

					// ================================ 마이너스 간섭 요인 : <<An 1st PNP>> =============================//
						P_Minus_IL_Offset = P_An_2nd_T_Minus_IL_Offset(0);					// Offset value : 35
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_1st_PnP_AN_T) - 90 + P_Minus_IL_Offset;		// An 2nd PNP 기준 왼쪽 물체 << An 1st pnp >> 절대좌표 변환. 2차 PNP T축이 Offset 이하로 움직이지 못함.
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_1st_PnP_AN_T;

					break;

					case N_IL_Upper_Pos:			// << N_IL_Upper_Pos >> 대기 위치 +15도 ~ 스택 위치 - 35도 일 경우
					// ================================ 플러스 간섭 요인 : <<Final Roller>> ==================================//
						
						if(P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(3)- 0.1)	// FR X가 양극 위치 보다 음극 방향에 있을 경우.
						{
							if(P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(2) + 0.1)		// FR X가 음극 위치보다 음극 방향에 있을 경우.
							{
								//P_Limit_PosData(Hex_IL_Plus) = 30 + P_An_2nd_T_Plus_IL_Offset(2);			// Offset value : 0
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M04_POS(1) + 30 + P_An_2nd_T_Plus_IL_Offset(2);			// Offset value : 0, 대기 위치 + 30도 + Offset 이상으로 2차 PNP가 움직이지 못함.
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
							}
							else															// FR X가 양극 위치 ~ 음극 위치 일 경우.
							{
								//P_Limit_PosData(Hex_IL_Plus) = 50 + P_An_2nd_T_Plus_IL_Offset(2);			// Offset value : 0
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M04_POS(1) + 50 + P_An_2nd_T_Plus_IL_Offset(2);			// Offset value : 0, 대기 위치 + 50도 + Offset 이상으로 2차 PNP가 움직이지 못함.
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
							}
						}					
					// ================================ 마이너스 간섭 요인 : <<An NG PNP, An 1st PNP>> =============================//
						if(P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(1) + 50)	// NG PNP가 대기 위치 + 50도 초과일 경우. 
						{
							P_Minus_IL_Offset = P_An_2nd_T_Minus_IL_Offset(1)				// Offset value : 35
							P_Limit_PosData(Hex_IL_Minus) = P_Minus_IL_Offset				// Offset 밑으로 이동할 수 없음. 
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_NG_PnP_AN_T;
						}
						else																// NG PNP가 대기 위치 + 50도를 넘기지 않을 경우.
						{// 1차 PNP 위치를 마이너스 리밋으로 설정
							P_Minus_IL_Offset = P_An_2nd_T_Minus_IL_Offset(1);				// Offset value : 35
							P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_1st_PnP_AN_T) - 90 + P_Minus_IL_Offset;	// Offset 밑으로 이동할 수 없음.
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_1st_PnP_AN_T;
						}
					break;

					//case N_IL_Stack_Pos:		// << N_IL_Stack_Pos >> 70도 이상 일 경우
					case N_IL_Stack_Pos: 
					case N_IL_Stack_Down_Pos:		// << N_IL_Stack_Pos >> 스택 위치 - 35도 이상 일 경우		[ 참조 : 26.10.02 인터락 조건 추가 ]
					// ================================ 플러스 간섭 요인 : <<Final Roller, Main Z, Clamp Z>> ==================================//
						if(P_Motor_Current_Pos(N_FINAL_ROLL_X) >= P_Recipe_M12_POS(3) - 0.1)
						{// FR X가 양극 위치에 있을 경우 90도까지 가능.
							//P_Z_Pos_Data = P_Motor_Current_Pos(N_MAIN_Z) + 0.1;
							P_Z_Pos_Data = P_Motor_Current_Pos(N_MAIN_Z);
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_MAIN_Z;
							// 현재 모터들이 Z축 리밋이 설정값보다 높다면 갱신하기.
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z2))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z2);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_CA_Z2;
							}
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z2))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z2);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_AN_Z2;
							}
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z1))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z1);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_CA_Z1;
							}
							
							if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z1))
							{
								P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z1);
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_AN_Z1;
							}

							// 최종 plus 값이 0보다 낮으면 2차 PNP 진입가능.
							if(P_Z_Pos_Data < P_Recipe_M11_POS(1) + 0.5)		// 스택 테이블 및 클램프 중 가장 높은 값보다 스택 테이블 대기위치 보다 낮을 경우.
							{// Main Z가 대기위치 + 1 값 보다 높은 값을 가진다면,
								//P_Limit_PosData(Hex_IL_Plus) = 90.5 + P_An_2nd_T_Plus_IL_Offset(1);			// Offset value : 0
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M04_POS(1) + P_An_2nd_T_Plus_IL_Offset(1);			// Offset value : 0.5, 스택 위치 + Offset 만큼 이동할 수 있음.
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
							}
							else												// 스택 테이블 대기위치 + 0.5보다 위에 있을 경우.
							{
								P_Limit_PosData(Hex_IL_Plus) = P_Z_Var;			// Offset value : 60, 2차 PNP가 Offset 값을 넘기지 못함.
							}
						}
						else													// FR X가 양극 위치에서 음극 방향에 있을 경우.
						{
							//P_Limit_PosData(Hex_IL_Plus) = 50 + P_An_2nd_T_Plus_IL_Offset(2);			// Offset value : 0
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M04_POS(1) + 50 + P_An_2nd_T_Plus_IL_Offset(2);			// Offset value : 0, 2차 PNP가 대기 위치 + 50도 + Offset값을 넘기지 못함.
							if(P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(3))
							{// FR X가 양극 위치 외에 있는 경우에는
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
							}
						}
					// ================================ 마이너스 간섭 요인 : <<없음>> =============================//
					break;
				}
			break;

			case N_2nd_PnP_AN_Z:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			 if(P_IL_Outer_Status != IL_Out_Close) //[참조 : 260702 릴컷 또는 NG box 도어 열릴 시 Z축 레시피 이동 불가하도록 수정]
			 { 
			//================================ 1번위치 - 대기 상승 ================================
				// ↓ 음극 2차 PNP Z축 대기 상승
				if(P_Anode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M22_POS(1))		
					P_No1_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;
				else
					P_No1_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 0;
			//================================ 2번위치 - 얼라인 상승 ================================
				// ↓ 음극 2차 PNP T축 !~ 얼라인 위치 || 음극 2차 PNP Z축 얼라인 상승
				if(!(P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ P_Recipe_M04_POS(1)) || P_Anode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M22_POS(2))		
					P_No2_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;
				else
					P_No2_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 0;
			//================================ 3번위치 - 얼라인 하강 ================================
				// ↓ 음극 2차 PNP T축 !~ 얼라인 위치 || 음극 2차 PNP Z축 얼라인 하강
				if(!(P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ P_Recipe_M04_POS(1)) || P_Anode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M22_POS(3))		
					P_No3_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;
				else
					P_No3_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 0;
			//================================ 4번위치 - 스텍 상승 ================================
				// ↓ 음극 2차 PNP T축 !~ 스택 위치 || 음극 2차 PNP Z축 스택 상승
				if(!(P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ P_Recipe_M04_POS(2)) || P_Anode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M22_POS(4))		
					P_No4_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;
				else
					P_No4_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 0;
			//================================ 5번위치 - 스텍 하강 ================================
				// ↓ 음극 2차 PNP T축 !~ 스택 위치 || 음극 2차 PNP Z축 스택 하강
				if(!(P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ P_Recipe_M04_POS(2)) || P_Anode_2nd_PNP_Z_Real_Move_Pos ~ P_Recipe_M22_POS(5))		
					P_No5_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;
				else
					P_No5_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 0;
				//================================ 6번위치 - 얼라인 블로우 ================================
				// ↓ 음극 2차 PNP T축 !~ 얼라인 위치 || 얼라인 블로우 레시피 > 얼라인 하강 || 음극 2차 PNP Z축 얼라인 블로우
				if(!(P_Motor_Current_Pos(N_2nd_PnP_AN_Z) ~ P_Recipe_M04_POS(1)) || !(P_Recipe_M22_POS(6) <= P_Recipe_M22_POS(3)) || P_Anode_2nd_PNP_Z_Real_Move_Pos > P_Recipe_M22_POS(6))		
					P_No6_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;
				else
					P_No6_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 0;
			//	안쓰는 위치 인터락
				P_No7_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No8_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No9_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No10_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
			 }
			 else 
			 {
			    P_No1_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
			    P_No2_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
			    P_No3_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
			    P_No4_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
			    P_No5_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No6_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No7_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No8_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No9_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
				P_No10_Recipe_Pos_IL(N_2nd_PnP_AN_Z) = 1;			// 인터락
			 }
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Recipe_M22_POS(5) - P_Anode_2nd_PNP_Z_Real_Move_Pos;		// An 2nd Z [#22] 하강 위치 - 현재 위치 시 절대위치 변환 가능
				if(P_IL_Outer_Status == N_IL_Normal_Pos )
				{}
				//else if(P_IL_Outer_Status == N_IL_Stack_Pos )
				else if(P_IL_Outer_Status == N_IL_Stack_Pos || P_IL_Outer_Status == N_IL_Stack_Down_Pos )		// [ 참조 : 26.10.02 인터락 조건 추가 ]
				{
				// ================================ 플러스 간섭 요인 : <<없음>> ==================================//
				// ================================ 마이너스 간섭 요인 : <<Main Z, Clamp>> =============================//
					P_Minus_IL_Offset = 5;
					P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_MAIN_Z);			// Main Z 현재 위치 값에서 추가 offset mm보다 못내려가게 해놓음.
					P_Collision_Risk_Motor(Hex_IL_Minus) = N_MAIN_Z;
					// 현재 모터들이 Z축 리밋이 설정값보다 높다면 갱신하기.
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_CA_Z2))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_CA_Z2);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z2;
					}
					
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_AN_Z2))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_AN_Z2);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z2;
					}
					
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_CA_Z1))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_CA_Z1);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z1;
					}
					
					if(P_Limit_PosData(Hex_IL_Minus) < P_Motor_Current_Pos(N_Clamp_AN_Z1))
					{
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_Clamp_AN_Z1);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z1;
					}
					P_Limit_PosData(Hex_IL_Minus) = P_Limit_PosData(Hex_IL_Minus) + P_Minus_IL_Offset;
				}

			break;

			case N_Clamp_CA_Y1:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				if(P_IL_Outer_Status != IL_Out_Close)
				{
				//================================ 1번위치 - 언클램프 위치  ================================
					// ↓ 양극 클램프 Y축 언클램프 위치
					if(P_Motor_Current_Pos(N_Clamp_CA_Y1) ~ P_Recipe_M05_POS(1))	
						P_No1_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					else
						P_No1_Recipe_Pos_IL(N_Clamp_CA_Y1) = 0;
				//================================ 2번위치 - 클램프 위치 ================================
					// ↓ 양극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2 
					//if(P_Motor_Current_Pos(N_Clamp_CA_Y1) ~ P_Recipe_M05_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2)
					// [ 참조 : 26.10.02 인터락 조건 추가 ]
					// ↓ 양극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2 || 스택 테이블 Z축 ≥ 클램프 Z축 + abs(클램프 레시피 값) ← 절대 좌표계를 맞춤 + abs(클램프 레시피 값)
					if(P_Motor_Current_Pos(N_Clamp_CA_Y1) ~ P_Recipe_M05_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2||P_Motor_Current_Pos(N_MAIN_Z)>=P_Motor_Current_Pos(N_Clamp_CA_Z1)+abs(P_Recipe_M27_POS(2))+abs(P_Recipe_M27_POS(2)))
						P_No2_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					else
						P_No2_Recipe_Pos_IL(N_Clamp_CA_Y1) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No4_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No5_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No6_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No7_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;		// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No2_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No3_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No4_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No5_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No6_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;
					P_No7_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Clamp_CA_Y1) = 1;		// 인터락
				}

			break;

			case N_Clamp_AN_Y1:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

				if(P_IL_Outer_Status != IL_Out_Close)
				{
				//================================ 1번위치 - 언클램프 위치  ================================
					// ↓ 양극 클램프 Y축 언클램프 위치
					if(P_Motor_Current_Pos(N_Clamp_AN_Y1) ~ P_Recipe_M06_POS(1))	
						P_No1_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					else
						P_No1_Recipe_Pos_IL(N_Clamp_AN_Y1) = 0;
				//================================ 2번위치 - 클램프 위치 ================================
					// ↓ 음극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2
					//if(P_Motor_Current_Pos(N_Clamp_AN_Y1) ~ P_Recipe_M06_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2)
					// [ 참조 : 26.10.02 인터락 조건 추가 ]
					// ↓ 음극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2 || 스택 테이블 Z축 ≥ 클램프 Z축 + abs(클램프 레시피 값) ← 절대 좌표계를 맞춤 + abs(클램프 레시피 값)
					if(P_Motor_Current_Pos(N_Clamp_AN_Y1) ~ P_Recipe_M06_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2||P_Motor_Current_Pos(N_MAIN_Z)>=P_Motor_Current_Pos(N_Clamp_CA_Z1)+abs(P_Recipe_M28_POS(2))+abs(P_Recipe_M28_POS(2)))
						P_No2_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					else
						P_No2_Recipe_Pos_IL(N_Clamp_AN_Y1) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No4_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No5_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No6_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No7_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;		// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No2_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No3_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No4_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No5_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No6_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;
					P_No7_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Clamp_AN_Y1) = 1;		// 인터락
				}

			break;

			case N_Clamp_CA_Y2:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

				if(P_IL_Outer_Status != IL_Out_Close)
				{
				//================================ 1번위치 - 언클램프 위치  ================================
					// ↓ 양극 클램프 Y축 언클램프 위치
					if(P_Motor_Current_Pos(N_Clamp_CA_Y2) ~ P_Recipe_M07_POS(1))	
						P_No1_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;
					else
						P_No1_Recipe_Pos_IL(N_Clamp_CA_Y2) = 0;
				//================================ 2번위치 - 클램프 위치 ================================
					// ↓ 양극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2
					//if(P_Motor_Current_Pos(N_Clamp_CA_Y2) ~ P_Recipe_M07_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2)
					// [ 참조 : 26.10.02 인터락 조건 추가 ]
					// ↓ 양극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2 || 스택 테이블 Z축 ≥ 클램프 Z축 + abs(클램프 레시피 값) ← 절대 좌표계를 맞춤 + abs(클램프 레시피 값)
					if(P_Motor_Current_Pos(N_Clamp_CA_Y2) ~ P_Recipe_M07_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2||P_Motor_Current_Pos(N_MAIN_Z)>=P_Motor_Current_Pos(N_Clamp_CA_Z2)+abs(P_Recipe_M25_POS(2))+abs(P_Recipe_M25_POS(2)))

						P_No2_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;
					else
						P_No2_Recipe_Pos_IL(N_Clamp_CA_Y2) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;
					P_No4_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;
					P_No5_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;
					P_No6_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;
					P_No7_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Clamp_CA_Y2) = 1;		// 인터락
