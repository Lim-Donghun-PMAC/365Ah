// [1] PLC10 - 세파 Host ID  포인팅
// 젤리롤 정보
/* 
	0-9		: 셀 아이디											Sys.Udata[20252] - Sys.Udata[20256]
	10		: 드라이런 : 0 , 세파모드 : 1, 일반 : 2				u.user:$013C84.00.16   젤리롤 적층, 세파모드, 드라이런
	11(A)	: 젤리롤 결과 OK : 1 / NG : 2						u.user:$013C84.16.16   A열 젤리롤 결과(정상, NG,)
	12(B)	: 젤리롤 결과 OK : 1 / NG : 2						u.user:$013C88.00.16   B열 젤리롤 결과(정상, NG,)
	13		: Sample Type (loss : 1, qc : 2)					u.user:$013C88.16.16   샘플 타입(qc 또는 loss)
	14(A)	: NG 종류 3가지 (완적층 : 1, 중간배출 : 2, 세파 : 3)	u.user:$013C8C.00.16   A열 NG 타입(완젤리롤, 중간배출, 세파)
	15(B)	: NG 종류 3가지 (완적층 : 1, 중간배출 : 2, 세파 : 3)	u.user:$013C8C.16.16   B열 NG 타입(완젤리롤, 중간배출, 세파)
	16-17	: 정상 배출시 젤리롤 두께								Sys.Udata[20260]
	18-19	: 중간 배출시 젤리롤 두께								Sys.Udata[20261]
*/
ptr	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(10)->*;					// 기존 : P_Stack_Work_Host_1;
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(0)->Sys.Udata[20252];		// Sheet 1,	 Sheet 2	// Sheet 3,	 Sheet 4	
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(1)->Sys.Udata[20253];		// Sheet 5,	 Sheet 6	// Sheet 7,	 Sheet 8
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(2)->Sys.Udata[20254];		// Sheet 9,	 Sheet 10	// Sheet 11, Sheet 12
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(3)->Sys.Udata[20255];		// Sheet 13, Sheet 14	// Sheet 15, Sheet 16
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(4)->Sys.Udata[20256];		// Sheet 17, Sheet 18	// Sheet 19, Sheet 20
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(5)->Sys.Udata[20257];		// u.user:$013C84.00.16 (M_Stack_Host_ID_Buffer_Mode)  , u.user:$013C84.16.16 (M_Stack_Host_ID_JR_Result)
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(6)->Sys.Udata[20258];		// u.user:$013C88.00.16 (M_Stack_Host_ID_JR_Result) , u.user:$013C88.16.16 (M_Stack_Host_ID_Sample_Type)
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(7)->Sys.Udata[20259];		// u.user:$013C8C.00.16 (M_Stack_Host_ID_NG_Type)  , u.user:$013C8C.16.16 (M_Stack_Host_ID_NG_Type)
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(8)->Sys.Udata[20260];		// Sys.Udata[20260]
M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(9)->Sys.Udata[20261];		// Sys.Udata[20261]

// 젤리롤 결과 정보 
ptr M_Stack_Host_ID_Buffer_Mode->u.user:$013C84.00.16;		// 젤리롤 적층, 세파모드, 드라이런
ptr M_Stack_Host_ID_Sample_Type->u.user:$013C88.16.16;		// 샘플 타입(qc 또는 loss)
#ifdef F_Def_Stack_A
	ptr M_Stack_Host_ID_JR_Result->u.user:$013C84.16.16;	// A열 젤리롤 결과(정상, NG,)
	ptr M_Stack_Host_ID_NG_Type->u.user:$013C8C.00.16;		// A열 NG 타입(완젤리롤, 중간배출, 세파)
#else
	ptr M_Stack_Host_ID_JR_Result->u.user:$013C88.00.16;	// B열 젤리롤 결과(정상, NG,)
	ptr M_Stack_Host_ID_NG_Type->u.user:$013C8C.16.16;		// B열 NG 타입(완젤리롤, 중간배출, 세파)
#endif


