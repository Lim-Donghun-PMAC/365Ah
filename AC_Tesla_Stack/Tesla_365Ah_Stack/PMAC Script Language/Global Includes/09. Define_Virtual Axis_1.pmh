// 음극 클램프 Submaster
                        
Motor[55].Ctrl		= Sys.PidCtrl // only need simple PID loop
Motor[55].ServoCtrl	= 1
Motor[55].pDac		= Sys.Idata[55].a 
Motor[55].pAmpEnable = 0
Motor[55].pAmpFault	= 0
Motor[55].pLimits	= 0
Motor[55].CaptureMode= 1 // software capture 
Motor[55].pEnc=EncTable[55].a
Motor[55].pEnc2=EncTable[55].a
// needed gains
Motor[55].Servo.Kp	= 1 
Motor[55].Servo.Kvfb = 0 
Motor[55].Servo.Kvff = 0
Motor[55].Servo.Kaff = 0
Motor[55].Servo.Ki	= 0.001
Motor[55].servo.MaxGainFactor=28000
Motor[55].servo.MaxPosErr=10000
Motor[55].MaxSpeed=0
Motor[55].InvAmax = 0;
Motor[55].InvDmax = 0;
Motor[55].InvJmax = 0;
Motor[55].JogTa=100
Motor[55].JogTs=50
Motor[55].JogSpeed=10
Motor[55].MaxDac=32767
Motor[55].PosSf=1
Motor[55].Pos2Sf=1
// process Dac data
EncTable[55].type		= 1
EncTable[55].ScaleFactor = 1/65536
EncTable[55].pEnc		= Sys.Idata[55].a
EncTable[55].index4		= 1

