									&P_PMAC_Homing_CHK(N_2nd_PnP_CA_Z)&P_PMAC_Homing_CHK(N_2nd_PnP_AN_Z)	


#define Stak_Home_Complete			P_PMAC_Homing_CHK(N_Clamp_CA_Y1)&P_PMAC_Homing_CHK(N_Clamp_AN_Y1)&P_PMAC_Homing_CHK(N_Clamp_CA_Y2)&P_PMAC_Homing_CHK(N_Clamp_AN_Y2)\
									&P_PMAC_Homing_CHK(N_MAIN_Z)&P_PMAC_Homing_CHK(N_FINAL_ROLL_X)&P_PMAC_Homing_CHK(N_FINAL_ROLL_Z)\
									&P_PMAC_Homing_CHK(N_Clamp_CA_Z2)&P_PMAC_Homing_CHK(N_Clamp_AN_Z2)&P_PMAC_Homing_CHK(N_Clamp_CA_Z1)&P_PMAC_Homing_CHK(N_Clamp_AN_Z1)


#define Align_Home_Complete			P_PMAC_Homing_CHK(N_Align_CA_X)&P_PMAC_Homing_CHK(N_Align_CA_Y)&P_PMAC_Homing_CHK(N_Align_CA_T)&P_PMAC_Homing_CHK(N_Align_AN_X)&P_PMAC_Homing_CHK(N_Align_AN_Y)&P_PMAC_Homing_CHK(N_Align_AN_T)

#define Ecat_Other_Home_Complete	P_PMAC_Homing_CHK(N_EPC_SENSOR)&P_PMAC_Homing_CHK(N_STACK_VISION)&P_PMAC_Homing_CHK(N_SHEET_PAPER_X)&P_PMAC_Homing_CHK(N_NG_PnP_CA_T)&P_PMAC_Homing_CHK(N_NG_PnP_AN_T)&P_PMAC_Homing_CHK(N_NG_PnP_CA_Z)\
									&P_PMAC_Homing_CHK(N_NG_PnP_AN_Z)&P_PMAC_Homing_CHK(N_UNLOADER_X)&P_PMAC_Homing_CHK(N_UNLOADER_Z)&P_PMAC_Homing_CHK(N_UNLOADER_T)



