//=========================================================
//10.Stack MSA 2차 스텍 -> 얼라인 이동 
//=========================================================
sub: MSA_Stack_2nd_Align_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) == N_Ready_Step )											//Stack MSA 2차 스텍 -> 얼라인 이동 Ready Step
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		P_Slave3_Motion_Command = 2;																						// 음극 2차 PNP Stack -> Align 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{
		P_Slave8_Motion_Command = 2;																						// 양극 2차 PNP Stack -> Align 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) = 1;													// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) == 1  )
{

	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		if (P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 0 + P_Motor_Ready_Pos_Inpos_200um )	// 음극 2차 PNP Stack -> Align 위치 확인
		{
			if( Motor[N_2nd_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time  )										// 음극 2차 PNP 속도 0 확인 
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}		
		}
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{																													
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 0 - P_Motor_Ready_Pos_Inpos_200um &&  P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 0 + P_Motor_Ready_Pos_Inpos_200um )	// 양극 2차 PNP Stack -> Align 위치 확인
		{
			if( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )										// 양극 2차 PNP 속도 0 확인 			
			{																											
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
			}		
		}
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_2nd_Align_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Move) = 1;													// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//11.Stack MSA 카운트 
//=========================================================
sub: MSA_Stack_MSA_Move_Cnt(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) == N_Ready_Step )											//Stack MSA 카운트 Ready Step	
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{
		 P_Current_MSA_Run_Num(F_Anode_Stack_MSA)++;																				// 현재 진행한 횟수 증가
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) = 1;														// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )			// 양극 Stack MSA 모드일 경우
	{
		 P_Current_MSA_Run_Num(F_Cathode_Stack_MSA)++;																			// 현재 진행한 횟수 증가
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) = 1;														// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) == 1 )
{	
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		if(  P_Current_MSA_Run_Num(F_Anode_Stack_MSA) < P_MSA_Run_Repeat_Num(F_Anode_Stack_MSA) )										// 음극 스텍 MSA Total 횟수 미달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) = N_Not_Complete_Step;							// 반환값 : Not COMPLETE															
		}
		else if(  P_Current_MSA_Run_Num(F_Anode_Stack_MSA) == P_MSA_Run_Repeat_Num(F_Anode_Stack_MSA) )								// 음극 스텍  MSA Total 횟수 도달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) = N_Complete_Step;								// 반환값 : COMPLETE
		}																				
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{		
		if(  P_Current_MSA_Run_Num(F_Cathode_Stack_MSA) < P_MSA_Run_Repeat_Num(F_Cathode_Stack_MSA) )									// 양극 스텍 MSA Total 횟수 미달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) = N_Not_Complete_Step;							// 반환값 : Not COMPLETE															
		}
		else if( P_Current_MSA_Run_Num(F_Cathode_Stack_MSA) == P_MSA_Run_Repeat_Num(F_Cathode_Stack_MSA) )								// 양극 스텍 MSA Total 횟수 도달 시 
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) = N_Complete_Step;								// 반환값 : COMPLETE
		}
	}
}
if (P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) == N_Not_Complete_Step)									// 스텍 MSA Total 횟수 미달 경우	
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) = 2;												// Complete Bit 2 
	rtn = N_COMPLETE;	
}
else if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_MSA_Move_Cnt) == N_Complete_Step)									// 스텍 MSA Total 횟수 도달했을 경우
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) = 1;												// Complete Bit 1
	rtn = N_COMPLETE;	
}
return;


#ifdef F_MSA_Discharge_Use
//↓ MSA배출 모드 사용 시
//MSA 횟수 도달 후 진입 
//=========================================================
//12. Stack MSA 2차 PNP 얼라인 하강(MSA 완료)
//=========================================================
sub: MSA_Stack_Discharge_2nd_Align_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) == N_Ready_Step )							//Stack MSA 2차 PNP 얼라인 하강 Ready Step
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		P_Slave17_Motion_Command = 5;																						// 음극 2차 PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{
		P_Slave18_Motion_Command = 5;																						// 양극 2차 PNP 얼라인 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )				// 음극 Stack MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 2차 얼라인 하강 확인 	
		{
			if( Motor[N_2nd_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 									// 음극 2차 PNP 속도 0 확인 																								
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = N_Complete_Step;				// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um )	// 양극 2차 얼라인 하강 확인 
		{
			if( Motor[N_2nd_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 									// 양극 2차 PNP 속도 0 확인 																							
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = N_Complete_Step;				// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;


//=========================================================
//13. Stack MSA 2차 PNP s얼라인 파기 (MSA 완료)
//=========================================================
sub: MSA_Stack_Discharge_2nd_Align_Blow_ON(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) == N_Ready_Step )								//Stack MSA 2차 얼라인 파기 Ready Step 
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{
		P_Slave17_Motion_Command = 12;																						//음극 2차 PNP 파기
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화
		//M_Y_Anode_AT_Vac_Ejector_Vac_On = 1;																			
		//M_Y_Anode_AT_Vac_Ejector_Vac_Off = 0; 	
		//M_Y_Anode_2nd_Vac_Sol_On = 0;								
		//M_Y_Anode_2nd_Vac_Sol_Off = 1;	
		
		//M_Y_Anode_2nd_Vac_Sol_On = 0;    
		//M_Y_Anode_2nd_Vac_Sol_Off = 1;    
		//M_Y_Anode_2nd_Release_Sol_On = 1;
		//M_Y_Anode_2nd_Release_Sol_Off = 0;
			
		//M_X_Anode_AT_Vac_Sensor = 1; //임시 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = 1;										// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )		// 양극 Stack MSA 모드일 경우
	{
		P_Slave18_Motion_Command = 12;																						//양극 2차 PNP 파기
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화 
		//M_Y_Cathode_AT_Vac_Ejector_Vac_On = 1;																			
		//M_Y_Cathode_AT_Vac_Ejector_Vac_Off = 0; 	
		//M_Y_Cathode_2nd_Vac_Sol_On = 0;																				
		//M_Y_Cathode_2nd_Vac_Sol_Off = 1;	
		
		//M_Y_Cathode_2nd_Vac_Sol_On = 0;    
		//M_Y_Cathode_2nd_Vac_Sol_Off = 1;
		//M_Y_Cathode_2nd_Release_Sol_On = 1;
		//M_Y_Cathode_2nd_Release_Sol_Off = 0;	
			
		//M_X_Cathode_AT_Vac_Sensor = 1; //임시 
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = 1;										// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{
		if ( M_X_Anode_2nd_PNP_Vac_Sensor == 0 && M_X_Anode_AT_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time)			// 음극 얼라인 흡착 확인 
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = N_Complete_Step;							// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우
	{																														
		if ( M_X_Cathode_2nd_PNP_Vac_Sensor == 0 && M_X_Cathode_AT_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time)   // 양극 얼라인 흡착 확인 
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = N_Complete_Step;						  // 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//14. Stack MSA 2차 PNP 얼라인 상승 (MSA 완료)
//=========================================================
sub: MSA_Stack_Discharge_2nd_Align_Up_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) == N_Ready_Step )								//Stack MSA 2차 PNP 얼라인 상승 Ready Step
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{																														
		P_Slave17_Motion_Command = 6;																						//음극 2차 PNP 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화 																							
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = 1;										// 다음 스텟 머신으로 이동.
	}																														
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우
	{																														
		P_Slave18_Motion_Command = 6;																						//양극 2차 PNP 얼라인 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화 																							
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = 1;										// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z)  > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um )  	// 음극 2차 PNP 스텍 상승 위치 확인
		{
			if( Motor[N_2nd_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 2차 PNP 속도 0 확인
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우
	{																														
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um )  // 양극 2차 PNP 스텍 상승 위치 확인
		{
			if( Motor[N_2nd_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 2차 PNP 속도 0 확인
			{																								
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																											// 반환값 : COMPLETE
}
return;

//=========================================================
//15. Stack MSA 2차 스텍 위치 이동 (MSA 완료)
//=========================================================
sub: MSA_Stack_Discharge_2nd_Stack_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) == N_Ready_Step )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{																														
		P_Slave3_Motion_Command = 1;																						// 음극 2차 PNP T축 Align -> Stack 이동 모션 커멘드	
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화																																																																						
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )			 // 양극 Stack MSA 모드일 경우
	{
		P_Slave8_Motion_Command = 1;																						// 양극 2차 PNP T축 Align -> Stack 이동 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																							// 체크 타이머 초기화		
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) 	// 음극 2차 PNP Stack 위치 확인	
		{
			if( Motor[N_2nd_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 음극 2차 PNP 속도 0 확인 																						
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )		  // 양극 Stack MSA 모드일 경우
	{																														 
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 90 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 90 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 2차 PNP Stack 위치 확인	
		{
			if( Motor[N_2nd_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 										// 양극 2차 PNP 속도 0 확인 																				
			{																										
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) = N_Complete_Step;					// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Stack_Move) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

