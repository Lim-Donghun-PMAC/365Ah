#define N_Enable_Cycle_Stop		1
#define N_Disable_Cycle_Stop	2
global P_Discharge_Possibility_Bit(N_Act_Define_Limit)				// 액션모듈 중간 정지 비트. ( 1 : 중간 정지 가능, 2 : 중간 정지 불가능 )
