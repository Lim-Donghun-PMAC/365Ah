//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.11.17 
// 음,양극 Vac에러 발생 시, 인포지션 밴드 trg 동기화 구문 삭제 - [ 참조 : 25.11.17 음,양극 Run Error 발생 시, 인포지션 밴드 삭제, 배열값 변경 함수 추가 ]

//=======================================================================================================
// 프로그램 목록. - Execute 생산모드관리에서 사용되는 서브프로그램.
// 1.Sub_Vision_Result
//	각각의 상황에서 체크해야할 비전연산결과를 체크하여 우선처리해야할 비전결과를 보고하는 서브프로그램.
// 2. Mode Init Program
//	모드의 모션배열값과 인포지션을 변경해주는 서브프로그램.
//	2.1) Sub_Init_Wait_Mode_Array :	Wait모드의 인포지션을 변경해준다.
//  2.2) Sub_Init_Run_Mode_Array : 음극런, 양극런 모드의 모션값과 인포지션을 변경해준다.
//---------------------------------------------------------------------------------------------------------------//


// 1. Sub_Vision_Result				-------------------------------------------------------------------------//
open subprog Sub_Vision_Result( void )
	// 비전촬상결과를 보고하는 서브프로그램.
	// 음극런중, 양극런중, 음극런시작전, 양극런시작전 4가지의 각각의 경우에서 감시해야할 비전결과 중 최우선 처리해야할 비전결과를 보고.
	// List	//
	// 1) Sub_Vision_Result.Anode_Run(&Result)
	// 2) Sub_Vision_Result.Cathode_Run(&Result)
	// 3) Sub_Vision_Result.Anode_Run_Start(&Result)
	// 4) Sub_Vision_Result.Cathode_Run_Start(&Result)
	
	sub:Anode_Run(&Result)	// 음극 런 중 감시해야할 Vision NG
		// Stack Table NG Flag 존재 시 라스트런 진입가능하도록.
		local L_Align_NG_Result=0;	// 얼라인 NG결과값.  1: 有 , 0 : 無
		local L_Surface_NG_Result=0;	// 표면검사 NG결과값. 1: 有 , 0 : 無
		// 양극얼라인결과. - 양극얼라인테이블 시트 데이터.
		Result = 0;
		if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Align_NG )
			L_Align_NG_Result = 1;	// NG
		else
			L_Align_NG_Result = 0;	 // OK		
		// 음극 표면검사결과. - 음극 2차P&P 시트 데이터.
		if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Surf_NG )	
			L_Surface_NG_Result = 1;	// NG
		else
			L_Surface_NG_Result = 0;	// OK 	
		// Stack NG결과. - 스택테이블 시트데이터.
		if( Sys_Stack_Sheet_LO_Vision_BYTE & Hex_Stack_NG ) // StackNG 또는 TimeOut이면
		{
			if( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )					// [ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
				P_Stack_Table_NG_Flag = 1;	// Stack NG 존재 시 플래그 On. -> 배출할때마다 플래그 Off하는것으로 하자.ㅠ
			else if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )
				P_Buf_Stack_NG_Flag = 1;
		}

		if(P_Buf_Stack_NG_Flag == 1 && M_Function_BTN_2.Stack_Vision_NG_Enable == 0)
		{// [ 참조 : 250811 Sepa모드 후 Stacking 시 중간배출 무시 기능 on/off 시점에 따라 중간배출이 되지않고 완적층 후 배출되는 현상 수정]
			P_Buf_Stack_NG_Flag = 0;
			P_Stack_Table_NG_Flag = 1;
		}


		// 결과값 리턴.
		if( P_Stack_Table_NG_Flag )		// 1순위 : 스택 NG.			
			Result = F_Vision_Result_Stack_NG;
		else if( L_Surface_NG_Result )	// 2순위 : 표면검사 NG 
			Result = F_Vision_Result_Surface_NG;
		else if( L_Align_NG_Result )	// 3순위 : 얼라인 NG
		{
			if( P_Cathode_Count < P_Cathode_Recipe_Count )
				Result = F_Vision_Result_Align_NG;
			else
				Result = F_Vision_Result_OK				// 마지막 얼라인 ng는 무시 후 젤리롤 배출 후 제거하기 위해
		}
		else	// 아무것도 없을 때.
			Result = F_Vision_Result_OK;
	return	
	
	sub:Cathode_Run(&Result)	// 양극 런 중 감시해야할 Vision NG
		// Stack Table NG Flag 존재 시 OK 처리로?
		local L_Align_NG_Result=0;	// 얼라인 NG결과값.  1: 有 , 0 : 無
		local L_Surface_NG_Result=0;	// 표면검사 NG결과값. 1: 有 , 0 : 無
		Result = 0;
		// 음극얼라인결과. - - 음극얼라인테이블 시트 데이터.
		if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Align_NG )
			L_Align_NG_Result = 1;  // NG	
		else
			L_Align_NG_Result = 0;	 // OK
		// 양극 표면검사결과. - 양극2차P&P 시트 데이터.	
		if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Surf_NG )	
			L_Surface_NG_Result = 1;	// NG	
		else
			L_Surface_NG_Result =	0;	// OK	
		// Stack NG결과. - 스택테이블 시트데이터.
		if( Sys_Stack_Sheet_LO_Vision_BYTE & Hex_Stack_NG ) // StackNG 또는 TimeOut이면
		{
			if( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )					// [ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
				P_Stack_Table_NG_Flag = 1;	// Stack NG 존재 시 플래그 On. -> 배출할때마다 플래그 Off하는것으로 하자.ㅠ	

			else if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )
				P_Buf_Stack_NG_Flag = 1;
		}

		if(P_Buf_Stack_NG_Flag == 1 && M_Function_BTN_2.Stack_Vision_NG_Enable == 0)
		{// [ 참조 : 250811 Sepa모드 후 Stacking 시 중간배출 무시 기능 on/off 시점에 따라 중간배출이 되지않고 완적층 후 배출되는 현상 수정]
			P_Buf_Stack_NG_Flag = 0;
			P_Stack_Table_NG_Flag = 1;
		}

		// 결과값 리턴.
		//if( P_Stack_Table_NG_Flag )		// 1순위 : 스택 NG. // - [ 참조 : 240408 양극 Stack Ng 감시 구문 삭제]			
		//	//Result = F_Vision_Result_Stack_NG;
		if( L_Surface_NG_Result )	// 2순위 : 표면검사 NG 
			Result = F_Vision_Result_Surface_NG;
		else if( L_Align_NG_Result )	// 3순위 : 얼라인 NG
			Result = F_Vision_Result_Align_NG;
		else	// 아무것도 없을 때.
			Result = F_Vision_Result_OK;

	return

	// [참조 : 26.09.21 Vision OK, NG 수정 ]
	sub:Anode_Run_Start(&Result)	// 음극런 시작 전 감시해야할 Vision NG - 양극Align, 양극Surface.	
		// Stack Table NG Flag 존재 시 라스트런 진입가능하도록.
		local L_Align_NG_Result=0;	// 얼라인 NG결과값.  1: 有 , 0 : 無
		local L_Surface_NG_Result=0;	// 표면검사 NG결과값. 1: 有 , 0 : 無
		// 양극얼라인결과. - 양극얼라인테이블 시트 데이터.
		Result = 0;
		// 1. 양극 얼라인 결과
		if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Align_NG )
			L_Align_NG_Result = 1;	// NG
		else if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Align_OK )	// [참조 : 26.10.11 Vision OK, NG 원복 + OK 신호 추가 ]
			L_Align_NG_Result = 0;	 // OK		
		else	// OK : 0 NG : 0  --> time out 처리
			L_Align_NG_Result = 1;	// NG

		// 2. 양극 표면검사결과
		if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Surf_NG )	
			L_Surface_NG_Result = 1;	// NG
		else if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Surf_OK )		// [참조 : 26.10.11 Vision OK, NG 원복 + OK 신호 추가 ]
			L_Surface_NG_Result = 0;	// OK 	
		else	// OK : 0 NG : 0  --> time out 처리
			L_Surface_NG_Result = 1;	// NG

		// 3. Stack NG결과 
		if( Sys_Stack_Sheet_LO_Vision_BYTE & Hex_Stack_NG ) // StackNG 또는 TimeOut이면
		{
			if( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )					// [ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
				P_Stack_Table_NG_Flag = 1;	// Stack NG 존재 시 플래그 On. -> 배출할때마다 플래그 Off하는것으로 하자.ㅠ
			else if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )
				P_Buf_Stack_NG_Flag = 1;
		}
		// ↓ Stack NG : 0 OK : O 문제일때 주석 해제 후 사용 
		//else if( Sys_Stack_Sheet_LO_Vision_BYTE & Hex_Stack_OK ){}				// [참조 : 26.10.11 Vision OK, NG 원복 + OK 신호 추가 ]
		//else{	// OK : 0 NG : 0  --> time out 처리 
		//	if( P_Anode_Count != 0 ){	
		//		if( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )					// [ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
		//			P_Stack_Table_NG_Flag = 1;	// Stack NG 존재 시 플래그 On. -> 배출할때마다 플래그 Off하는것으로 하자.ㅠ
		//		else if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )
		//			P_Buf_Stack_NG_Flag = 1;
		//	}
		//}
		if(P_Buf_Stack_NG_Flag == 1 && M_Function_BTN_2.Stack_Vision_NG_Enable == 0)
		{// [ 참조 : 250811 Sepa모드 후 Stacking 시 중간배출 무시 기능 on/off 시점에 따라 중간배출이 되지않고 완적층 후 배출되는 현상 수정]
			P_Buf_Stack_NG_Flag = 0;
			P_Stack_Table_NG_Flag = 1;
		}

		// 결과값 리턴.
		if( P_Stack_Table_NG_Flag )		// 1순위 : 스택 NG.			
			Result = F_Vision_Result_Stack_NG;
		else if( L_Surface_NG_Result )	// 2순위 : 표면검사 NG 
			Result = F_Vision_Result_Surface_NG;
		else if( L_Align_NG_Result )	// 3순위 : 얼라인 NG
		{
			if( P_Cathode_Count < P_Cathode_Recipe_Count )
				Result = F_Vision_Result_Align_NG;
			else
				Result = F_Vision_Result_OK				// 마지막 얼라인 ng는 무시 후 젤리롤 배출 후 제거하기 위해
		}
		else	// 아무것도 없을 때.
			Result = F_Vision_Result_OK;
	return
	
	sub:Cathode_Run_Start(&Result)	// 양극런 시작 전 감시해야할 Vision NG - 음극Align, 음극Surface.
			// Stack Table NG Flag 존재 시 OK 처리로?
		local L_Align_NG_Result=0;	// 얼라인 NG결과값.  1: 有 , 0 : 無
		local L_Surface_NG_Result=0;	// 표면검사 NG결과값. 1: 有 , 0 : 無
		Result = 0;
		// 1. 음극 얼라인 결과
		if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Align_NG )
			L_Align_NG_Result = 1;  // NG	
		else if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Align_OK )		// [참조 : 26.10.11 Vision OK, NG 원복 + OK 신호 추가 ]
			L_Align_NG_Result = 0;	 // OK
		else // OK : 0 NG : 0 --> Timeout
			L_Align_NG_Result = 1;  // NG

		// 2. 양극 표면검사 결과	
		if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Surf_NG )	
			L_Surface_NG_Result = 1;	// NG	
		else if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Surf_OK )		// [참조 : 26.10.11 Vision OK, NG 원복 + OK 신호 추가 ]
			L_Surface_NG_Result =	0;	// OK	
		else // OK : 0 NG : 0 --> Timeout
			L_Surface_NG_Result = 1;	// NG	

		// 3. Stack NG결과. 
		if( Sys_Stack_Sheet_LO_Vision_BYTE & Hex_Stack_NG ) // StackNG 또는 TimeOut이면
		{
			if( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )					// [ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
				P_Stack_Table_NG_Flag = 1;	// Stack NG 존재 시 플래그 On. -> 배출할때마다 플래그 Off하는것으로 하자.ㅠ	

			else if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )
				P_Buf_Stack_NG_Flag = 1;
		}
		// ↓ Stack NG : 0 OK : O 문제일때 주석 해제 후 사용 
		//else if( Sys_Stack_Sheet_LO_Vision_BYTE & Hex_Stack_OK ){}				// [참조 : 26.10.11 Vision OK, NG 원복 + OK 신호 추가 ]
		//else {		// OK : 0 NG : 0 --> Timeout
		//	if( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )					// [ 참조 : 25.09.12 중간 배출 무시 조건 추가 ]
		//		P_Stack_Table_NG_Flag = 1;	// Stack NG 존재 시 플래그 On. -> 배출할때마다 플래그 Off하는것으로 하자.ㅠ	
		//
		//	else if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )
		//		P_Buf_Stack_NG_Flag = 1;
		//}

		if(P_Buf_Stack_NG_Flag == 1 && M_Function_BTN_2.Stack_Vision_NG_Enable == 0)
		{// [ 참조 : 250811 Sepa모드 후 Stacking 시 중간배출 무시 기능 on/off 시점에 따라 중간배출이 되지않고 완적층 후 배출되는 현상 수정]
			P_Buf_Stack_NG_Flag = 0;
			P_Stack_Table_NG_Flag = 1;
		}

		// 결과값 리턴.
		//if( P_Stack_Table_NG_Flag )		// 1순위 : 스택 NG. // - [ 참조 : 240408 양극 Stack Ng 감시 구문 삭제]			
		//	//Result = F_Vision_Result_Stack_NG;
		if( L_Surface_NG_Result )	// 2순위 : 표면검사 NG 
			Result = F_Vision_Result_Surface_NG;
		else if( L_Align_NG_Result )	// 3순위 : 얼라인 NG
			Result = F_Vision_Result_Align_NG;
		else	// 아무것도 없을 때.
			Result = F_Vision_Result_OK;
	return	
close
//-----------------------------------------------------------------------------------------------------------//

// 2.1) Wait Mode Init Program					-------------------------------------------------------------------------//
open subprog Sub_Init_Wait_Mode_Array( Trg, &Result )
	//P_In_Position(F_Wait_Command) = Trg;
	P_In_Position(F_Dynamic_Wait_Command) = Trg;
	
	Result = 1;
close
//-----------------------------------------------------------------------------------------------------------//

// 2.2) Run Mode Init Program					-------------------------------------------------------------------------//
open subprog Sub_Init_Run_Mode_Array(void)
// 런모드 배열 및 인포지션 설정 프로그램.
// 2.2.1) Sub_Init_Run_Mode_Array.Anode_Run( Type, Trg, &Result )
// case - F_Normal_Run, F_Sepa_Run, F_Dry_Run, F_NG
// 2.2.2) Sub_Init_Run_Mode_Array.Cathode_Run( Type, Trg, &Result )
// case - F_Normal_Run, F_Last_Run, F_Sepa_Run, F_Sepa_Last_Run, F_Dry_Run, F_Dry_Last_Run, F_NG

sub:Anode_Run( Type, Trg, &Result )
	switch(Type)
	{
		case F_Normal_Run :		// 일반 런.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Anode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.
				// 2.1) Init
				
				P_Slave1_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave10_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave16_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Anode_Run_Motion_Array(0),100,1 = 0;

				// 2.2) 입력.
				//////음극 1차 P&P //////
				P_Slave16_Anode_Run_Motion_Array(0)=5;		//P_Slave1_Anode_Run_Motion_Array(0)=5;		// Belt하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Anode_Run_Motion_Array(8)=13;		//P_Slave1_Anode_Run_Motion_Array(8)=13;	// Belt 흡착		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Anode_Run_Motion_Array(15)=6;		//P_Slave1_Anode_Run_Motion_Array(15)=6;	// Belt상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave16_Anode_Run_Motion_Array(22)=1;		// Belt -> A/S 이동.											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave1_Anode_Run_Motion_Array(22) = 1;	// Belt -> A/S 이동.											
				//////음극 Picker T //////
				//P_Slave2_Anode_Run_Motion_Array(22)=1;	//PickerT좌표계 PNP에 묶음으로 인하여 Run Mode 배열 주석 처리  [ 참조 : 26.08.14 PickerT 모션 변경 ]		// 180 Deg 회전.		[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				//////음극 2차 P&P //////
				P_Slave17_Anode_Run_Motion_Array(0)=5;		//P_Slave3_Anode_Run_Motion_Array(0)=5;		// A/S하강		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(8)=10;		//P_Slave3_Anode_Run_Motion_Array(8)=10;	// A/S흡착		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(15)=6;		//P_Slave3_Anode_Run_Motion_Array(15)=6;	// A/S상승		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.										// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave3_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.
				//////음극 클램프 //////
				//[ 참조 : 26.02.25 클램프, 스텍테이블, 드라이빙 롤러 모션 배열 변경(타임테이블 일치화) ]
				P_Slave4_Anode_Run_Motion_Array(1)=2;		// Clamp On.
				P_Slave4_Anode_Run_Motion_Array(14) = 3;	// 극판 두께만큼 하강
				//////FINAL ROLL //////
				P_Slave5_Anode_Run_Motion_Array(21)=2;		// 양극방향  이동
				if( P_First_Sepa_Driving_Use == 1 )			// 드라이빙 사용 
					P_Slave15_Anode_Run_Motion_Array(P_Anode_Run_DR) = 2;	// 드라이빙
					
				//////STACK TABLE //////
				P_Slave6_Anode_Run_Motion_Array(13) = 2;	// 극판 두께만큼 하강
				//////양극 클램프 //////
				P_Slave7_Anode_Run_Motion_Array(29)=1;		// Clamp Off
				//////양극 2차 P&P //////
				P_Slave18_Anode_Run_Motion_Array(0)=3; 		// P_Slave8_Anode_Run_Motion_Array(0)=3;	Stack 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(8)=11; 	// P_Slave8_Anode_Run_Motion_Array(8)=11;	Stack 블로우.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(15)=4;		// P_Slave8_Anode_Run_Motion_Array(15)=4;	Stack 상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(22)=2;		// Stack -> A/S 이동											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave8_Anode_Run_Motion_Array(22)=2;		// Stack -> A/S 이동	
				//////양극 1차 P&P //////
				P_Slave19_Anode_Run_Motion_Array(0)=3;		// P_Slave10_Anode_Run_Motion_Array(0)=3;	A/S 하강.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(8)=12;		// P_Slave10_Anode_Run_Motion_Array(8)=12;	A/S 블로우		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(15)=4;		// P_Slave10_Anode_Run_Motion_Array(15)=4;	A/S 상승			// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(22)=2;		// belt 이동													// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave10_Anode_Run_Motion_Array(22)=2;		// belt 이동	
			// 3) 결과값 리턴.
				Result = F_Result_Complete;

				P_Anode_Cur_Mode = F_Normal_Run;
		break;
		case F_Sepa_Run :		// 세파 런.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Anode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.
				// 2.1) Init
				P_Slave1_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave10_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave16_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave17_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave19_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave15_Anode_Run_Motion_Array(0),100,1 = 0;
				// 2.2) 입력.
				//////음극 1차 P&P //////
				//////음극 2차 P&P //////
				P_Slave3_Anode_Run_Motion_Array(22)=1;		// A/S -> Stack 이동.
				P_Slave17_Anode_Run_Motion_Array(22) = 1;	// A/S -> Stack 이동.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				//////음극 클램프 //////
				P_Slave4_Anode_Run_Motion_Array(1)=2;		// Clamp On.
				P_Slave4_Anode_Run_Motion_Array(14)=3;		// 극판 두께만큼 하강
				//////FINAL ROLL //////
				P_Slave5_Anode_Run_Motion_Array(21)=2;		// 양극방향  이동
				P_Slave15_Anode_Run_Motion_Array(P_Anode_Run_DR) = 2;	// 드라이빙
				//////STACK TABLE //////
				P_Slave6_Anode_Run_Motion_Array(13) = 2;	// 극판 두께만큼 하강
				//////양극 클램프 //////
				P_Slave7_Anode_Run_Motion_Array(29)=1;		// Clamp Off
				//////양극 2차 P&P //////
				P_Slave18_Anode_Run_Motion_Array(0)=3; 		// P_Slave8_Anode_Run_Motion_Array(0)=3; Stack 하강.	// [ 참 조 : 2025.11.24 Z축 분리 ]

				// [ 참조 : 2025.07.25 Sepa Blow 모션 추가 ]	
				P_Slave18_Anode_Run_Motion_Array(8) = 13; 	// P_Slave8_Anode_Run_Motion_Array(8)=13;	세파모드 블로우.	// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(15) = 4;	// P_Slave8_Anode_Run_Motion_Array(15)=4;	Stack 상승.		// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave18_Anode_Run_Motion_Array(22) = 2;	// Stack -> A/S 이동											// [ 참 조 : 2025.11.24 Z축 분리 ]
				P_Slave8_Anode_Run_Motion_Array(22) = 2;	// Stack -> A/S 이동
				//////양극 1차 P&P //////
				//////양극 1차 P&P //////	
			// 3) 결과값 리턴.
				Result = F_Result_Complete;		

				P_Anode_Cur_Mode = F_Sepa_Run;
		break;
		case F_Dry_Run :		// 드라이 런.
			// 1) 모드 Inposition 트리거 지정.
				P_In_Position(F_Half_Anode_Run_Command) = Trg;
			// 2) 모션 배열값 갱신.
				// 2.1) Init
				P_Slave1_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave2_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
				P_Slave3_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave4_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave5_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave6_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave7_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave8_Anode_Run_Motion_Array(0),100,1 = 0;
				P_Slave9_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
