		P_Cathode_NG_TR_Align_Pick_Up_Status = F_Status_IDLE;
	break;

	case 1 :
		P_Cathode_NG_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		if(L_Cathode_NG_Pick_Timer < P_Check_Vac_Time)
		{
			if(Sys_Cathode_Align_Sheet_Data != 0)
			{
				P_Cathode_NG_TR_Align_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_Cathode_NG_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 91
			P_Sheet_Err(12)++
			P_Cathode_NG_TR_Align_Pick_Up_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Cathode_NG_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		L_Cathode_Func_Return(4) = 0;

		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_Align_Table, N_Sheet_Data_NG_TR, &L_Cathode_Func_Return(4))

		if(L_Cathode_Func_Return(4))
		{
			L_Cathode_Func_Return(4) = 0;

			Sys_Cathode_NG_TR_Sheet_Data = Sys_Cathode_Align_Sheet_Data;
			Sys_Cathode_Align_Sheet_Data = 0;

			P_Cathode_NG_TR_Align_Pick_Up_State_Machine = N_Complete_Step;
		}
