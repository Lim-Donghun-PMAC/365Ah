return;

sub:Coord_Progrunning_Check(&rtn)
		// 마스터
		local Coord_Progrunning_Check_Num = 1;	
		// 서브
		local Coord_Progrunning_Check_Last_Num = 34;
		
		while( Coord_Progrunning_Check_Num <= Coord_Progrunning_Check_Last_Num )
		{
			if(!(Coord[Coord_Progrunning_Check_Num].ProgRunning))	// ProgRunning 꺼졌는지 확인
			{
				rtn = N_FALSE;
				break;
			}
			if( Coord_Progrunning_Check_Num == 1)	// 2번~7번 좌표계 공백
			{
				Coord_Progrunning_Check_Num = 8;
			}
			else if(Coord_Progrunning_Check_Num == 8) // 9번~10번 좌표계 공백
			{
				Coord_Progrunning_Check_Num = 11;
			}
			else
			{
				Coord_Progrunning_Check_Num++;
			}
		}
		rtn = N_TRUE;
return;

	//타임베이스 on 체크 
sub:Timbase_ON_Check(&rtn)
		// 마스터
		local Timebase_ON_Check_Num = 1;	
		// 서브
		local sub_ON_Check_Num = Sys.MaxCoords;
		
		while(sub_ON_Check_Num >= 1 )
		{
			if(Coord[sub_ON_Check_Num].pDesTimeBase != Coord[Timebase_ON_Check_Num].pDesTimeBase)	// Time base 비교
			{
				rtn = N_FALSE;
				break;
			}

			if(sub_ON_Check_Num == 11)	// 9번~10번 좌표계 공백
			{
				sub_ON_Check_Num = 8;
			}
			else if(sub_ON_Check_Num == 8) // 2번~7번 좌표계 공백
			{
				sub_ON_Check_Num = 1;
			}
			else
			{
				sub_ON_Check_Num --;
			}
		}

		rtn = N_TRUE;

return;

sub:Mode_Flag_Check(Void)
	// 우선 순위에 따른 버퍼모드, 진행여부 결정
	// 1) 버튼이 전부 안눌려졌고, ARC 세파모드 진행 요청이 없을 때,
	//[ 참조 : 25.07.04 모드 체크 함수 추가 ]
	if( P_Com_User_Sepa_Consume_Mode_Flag != N_TRUE && P_Com_ARC_Sepa_Consume_Mode_Flag != N_TRUE && P_Com_EPC_Sepa_Consume_Mode_Flag != 1 && P_Com_Dry_Mode_Flag != N_TRUE  )
	{
		P_Buffer_Mode_Status_Sequence = N_Normal_Status_Sequence;	//일반모드
	}
	// ( 사용자 세파모드 ON, ARC 세파모드 ON ) 이거나 세파모드 이후 ARC 진행 Flag ON 이라면,
	else if( (P_Com_User_Sepa_Consume_Mode_Flag == N_TRUE && P_Com_ARC_Sepa_Consume_Mode_Flag == N_TRUE) || P_Com_User_Sepa_After_ARC_Mode_Continue_Flag == N_TRUE )
	{
		P_Buffer_Mode_Status_Sequence = N_Sepa_Consume_Status_Sequence;	// 세파모드
		P_Com_User_Sepa_After_ARC_Mode_Continue_Flag = N_TRUE;			// 세파모드 이후 ARC 진행 Flag
		P_Com_After_Sepa_Mode_Status  = F_Status_STOPPED;				// 계속 적층 진행 여부 [Stopped]
	}
	// 사용자 세파모드 ON
 	else if( P_Com_User_Sepa_Consume_Mode_Flag == N_TRUE )			
	{
		P_Buffer_Mode_Status_Sequence = N_Sepa_Consume_Status_Sequence;	// 세파모드
		P_Com_After_Sepa_Mode_Status  = F_Status_STOPPED;				// 계속 적층 진행 여부 [Stopped]
	}
	// ARC 세파모드 ON
	else if( P_Com_ARC_Sepa_Consume_Mode_Flag == N_TRUE)
	{
		P_Buffer_Mode_Status_Sequence = N_Sepa_Consume_Status_Sequence;	// 세파모드
		P_Com_After_Sepa_Mode_Status  = F_Status_EXECUTE;				// 계속 적층 진행 여부 [Execute]
	}
	// EPC 세파모드 ON
	else if( P_Com_EPC_Sepa_Consume_Mode_Flag == N_TRUE )
	{
		P_Buffer_Mode_Status_Sequence = N_Sepa_Consume_Status_Sequence; // 세파모드
		P_Com_After_Sepa_Mode_Status  = F_Status_EXECUTE;				// 계속 적층 진행 여부 [Execute]
	}
	// 드라이런 모드 ON
	else if ( P_Com_Dry_Mode_Flag == N_TRUE )							
	{
		P_Buffer_Mode_Status_Sequence = N_Dryrun_Status_Sequence;		// 드라이런 모드
	}

	// 
	if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )										// Normal Run
	{
		P_AN_Clamp_Cell_Down_Pos = P_Recipe_M26_POS(4) - ( P_Anode_Thickness + P_Sepa_Thickness );
		P_CA_Clamp_Cell_Down_Pos = P_Recipe_M25_POS(4) - ( P_Cathode_Thickness + P_Sepa_Thickness );
	}
	else if( P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence )							// Sepa Run
	{
		P_AN_Clamp_Cell_Down_Pos = P_Recipe_M26_POS(4) - P_Sepa_Thickness;
		P_CA_Clamp_Cell_Down_Pos = P_Recipe_M25_POS(4) - P_Sepa_Thickness;
	}
	else
	{
		P_AN_Clamp_Cell_Down_Pos = P_Clamp_2nd_Vector_Z;
		P_CA_Clamp_Cell_Down_Pos = P_Clamp_2nd_Vector_Z;
	}

return;

//타임베이스 off 체크 
sub:Timbase_OFF_Check(&rtn)
		// 마스터
		local Timebase_OFF_Check_Num = 1;

		while(Timebase_OFF_Check_Num <= 34)
		{
			if(Coord[Timebase_OFF_Check_Num].pDesTimeBase == Coord[Timebase_OFF_Check_Num].pDesTimeBase)
			{
				if(Timebase_OFF_Check_Num == 1) // 2번~7번 좌표계 공백
				{
					Timebase_OFF_Check_Num = 8;
				}
				else if(Timebase_OFF_Check_Num == 8) // 9번~10번 좌표계 공백
				{
					Timebase_OFF_Check_Num = 11;
				}
				else
				{
					Timebase_OFF_Check_Num ++;
				}
			}
			else
			{
				rtn = N_FALSE;
				break;
			}
		}
		rtn = N_TRUE;	

return;
close



