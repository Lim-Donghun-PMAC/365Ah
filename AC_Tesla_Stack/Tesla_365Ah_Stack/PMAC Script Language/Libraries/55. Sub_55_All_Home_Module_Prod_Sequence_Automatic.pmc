//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 26.02.03
// 모듈화 홈프로그램 리뉴얼 
// 코드 제어 구조 일원화, 모듈화 홈 작업 진행 - [ 참조 : 26.02.03 홈 모듈화 프로그램 리뉴얼 ]


open subprog Sub_Manual_All_Home_Prod_Sequnce(void)

			 
// 1) Search    -  검색창에 Search 만 검색하시면 ↓ 하단부 함수 Start 부분 쉽게 찾기 가능
//-----------------------------------------------------------------------------------------------------------------------------
// [Set]							// [Execute]					//  [Precondition]	
//-----------------------------------------------------------------------------------------------------------------------------
//[Manual All Home 모듈]
// Set_Manual_All_Home				// Execute_All_Home			// Precondition_All_Home				// 매뉴얼 올 홈 


//========================================================//
// 1.1) Set_
//========================================================//
	sub:Set_Manual_All_Home(Mode,&Set_Manual_All_Home_RTN)

		//=========================================//
		// 1.0)Init
		//=========================================//
		
		Set_Manual_All_Home_RTN = 0;	

		switch(Mode)
		{
			// 1.1) 젤리롤 생산 중 (즉 적층 중 일떄)
			case N_JellyRoll_Enable : 
	
				//1.1.1 시퀀스 배열
				P_AH_Seq_arr(0)  = Mode;										
				P_AH_Seq_arr(1)  = N_SEQ_AH_No_1;		
				P_AH_Seq_arr(2)  = N_SEQ_AH_No_2;		
				P_AH_Seq_arr(3)  = N_SEQ_AH_No_3;		
				P_AH_Seq_arr(4)  = N_SEQ_AH_No_4;		
				P_AH_Seq_arr(5)  = N_SEQ_AH_No_5;		
				P_AH_Seq_arr(6)  = N_SEQ_AH_No_6;						
				P_AH_Seq_arr(7)  = N_SEQ_AH_No_7;		
					
				P_AH_Seq_arr(8)  = N_COMPLETE;

				Set_Manual_All_Home_RTN = N_TRUE;
			break;

			// 1.2) 젤리롤 비 적층 중일떄 
			case N_JellyRoll_Disable : 
	
				//1.1.1 시퀀스 배열
				P_AH_Seq_arr(0)  = Mode;										
				P_AH_Seq_arr(1)  = N_SEQ_AH_No_1;			
				P_AH_Seq_arr(2)  = N_SEQ_AH_No_2;			
				P_AH_Seq_arr(3)  = N_SEQ_AH_No_3;			
				P_AH_Seq_arr(4)  = N_SEQ_AH_No_4;			
				P_AH_Seq_arr(5)  = N_SEQ_AH_No_5;			
				P_AH_Seq_arr(6)  = N_SEQ_AH_No_6;			
				P_AH_Seq_arr(7)  = N_SEQ_AH_No_7;		
				P_AH_Seq_arr(8)  = N_SEQ_AH_No_8;	
					
				P_AH_Seq_arr(9)  = N_COMPLETE;			
				
				Set_Manual_All_Home_RTN = N_TRUE;
			break;

			// 1.3) 홈체크가 꺼져있을 경우 
			case N_New_Non_Homing_CHK : 
	
				//1.1.1 시퀀스 배열
				P_AH_Seq_arr(0)  = Mode;										
				P_AH_Seq_arr(1)  = N_SEQ_AH_No_1;		
				P_AH_Seq_arr(2)  = N_SEQ_AH_No_2;		
				P_AH_Seq_arr(3)  = N_SEQ_AH_No_3;		
				P_AH_Seq_arr(4)  = N_SEQ_AH_No_4;		
				P_AH_Seq_arr(5)  = N_SEQ_AH_No_5;		
				P_AH_Seq_arr(6)  = N_SEQ_AH_No_6;		
				P_AH_Seq_arr(7)  = N_SEQ_AH_No_7;		
				P_AH_Seq_arr(8)  = N_SEQ_AH_No_8;			
				P_AH_Seq_arr(9)  = N_SEQ_AH_No_9;	
						
				P_AH_Seq_arr(10) = N_COMPLETE;			
						
																							
				Set_Manual_All_Home_RTN = N_TRUE;								
			break;
			
			// [참 조 : NG PNP 위치 센서 추가 하여 언로더 간섭 여부 회피 2026.04.16]
			case N_New_Non_Homing_CHK2:
				P_AH_Seq_arr(0)  = Mode;										
				P_AH_Seq_arr(1)  = N_SEQ_AH_No_1;		
				P_AH_Seq_arr(2)  = N_SEQ_AH_No_2;		
				P_AH_Seq_arr(3)  = N_SEQ_AH_No_3;		
				P_AH_Seq_arr(4)  = N_SEQ_AH_No_4;		
				P_AH_Seq_arr(5)  = N_SEQ_AH_No_5;		
				P_AH_Seq_arr(6)  = N_SEQ_AH_No_6;		
				P_AH_Seq_arr(7)  = N_SEQ_AH_No_7;		
				P_AH_Seq_arr(8)  = N_SEQ_AH_No_8;			
				P_AH_Seq_arr(9) = N_COMPLETE;	
				Set_Manual_All_Home_RTN = N_TRUE;	
			break;																

			case N_NRT_Dry_Enable:

				P_AH_Seq_arr(0)  = Mode;										
				P_AH_Seq_arr(1)  = N_SEQ_AH_No_1;		
				P_AH_Seq_arr(2)  = N_SEQ_AH_No_2;		
				P_AH_Seq_arr(3)  = N_SEQ_AH_No_3;		
				P_AH_Seq_arr(4)  = N_SEQ_AH_No_4;		
				P_AH_Seq_arr(5)  = N_SEQ_AH_No_5;		
				P_AH_Seq_arr(6)  = N_SEQ_AH_No_6;			
				P_AH_Seq_arr(7)  = N_SEQ_AH_No_7;	
					
				P_AH_Seq_arr(8)  = N_COMPLETE;																					
				Set_Manual_All_Home_RTN = N_TRUE;
			break;


			default : 
			
			break;
		}

	return

//===========================================================================//
// 1.2) Management_All_Home - 시퀀스 실행 관리 함수 _ 인덱스에 맞는 동작 가져오기
//===========================================================================//
	sub:Management_All_Home(Mode,Index,&data,&Management_All_Home_RTN)
		
		Management_All_Home_RTN = 0;
		if ( P_AH_Seq_arr(0) == Mode )									// 1) 실행 전 모드 체크
		{																				
			if ( P_AH_Seq_arr(Index) == N_COMPLETE )					// 1.1) 인덱스 배열값이 완료 일 경우
			{																			 
				data = N_COMPLETE;										// 1.1.1) 데이터 완료값 반환
				Management_All_Home_RTN = N_EXCEPT;						// 1.1.2) 예외값 반환
			}																			
			else if ( P_AH_Seq_arr(Index) != 0 )						// 1.1.3) 완료도 아니고 0값도 아닐 경우
			{																			 
				data = P_AH_Seq_arr(Index);								// 1.1.4) 인덱스 배열값 반환
				Management_All_Home_RTN = N_TRUE;						// 1.1.5) True 반환
			}															
			else														
			{															
				data = 0;												// 1.1.6) 인덱스 배열값 0값 반환
				Management_All_Home_RTN = N_FALSE;						// 1.1.7) False  반환
			}															
		}

	return

//===========================================================================//
// 1.3) Execute_All_Home - 동작
//===========================================================================//
	sub:Execute_All_Home(Mode,Index,&Execute_All_Home_RTN) 

		Execute_All_Home_RTN = 0;
		switch( Mode )	// 모드구분.
		{
			//-------------------------------------------------------------------------------------------------------------------------------------------------//
			case N_JellyRoll_Enable :		
				
				// 기존 모듈에서는 P_Module_Act_All_Home_Command_Array(F_Home_Act)	= F_ACT_STATUS_ENABLE; 이런식으로 사용하였지만
				// Home 커맨드는 같은데 Mode 마다 만들면 너무 비효율 적이라 이 부분은 변경함.
				switch(Index)	// 요거는 인덱스 
				{
					
					case 1:		// 첫번째 - 1차 PNP Home 
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Home_Act);		// 양극 1차 Z 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Home_Act);		// 음극 1차 Z 홈
							call Timer.msec(500);	// z상승 딜레이 타임
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_T,F_Home_Act);		// 양극 1차 T 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_T,F_Home_Act);		// 음극 1차 T 홈
							
							

							Execute_All_Home_RTN = N_TRUE;		
					break;		
		
					case 2:		// 두번째 - 	NG PNP Home

							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_Z,F_Home_Act);		// 양극 NG Z 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_Z,F_Home_Act);		// 음극 NG Z 홈
							call Timer.msec(500);	// z상승 딜레이 타임
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_T,F_Home_Act);		// 양극 NG T 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_T,F_Home_Act);		// 음극 NG T 홈

							Execute_All_Home_RTN = N_TRUE;		
					break;

					case 3:		// 세번째 - 2nd PNP Home, 피커 홈
							
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Home_Act);		// 양극 2차 Z 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Home_Act);		// 음극 2차 Z 홈
							call Timer.msec(500);	// z상승 딜레이 타임
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_T,F_Home_Act);		// 양극 2차 T 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_T,F_Home_Act);		// 음극 2차 T 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_CA_T,F_Home_Act);		// 양극 피커 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_AN_T,F_Home_Act);		// 음극 피커 홈

							Execute_All_Home_RTN = N_TRUE;		 
					break;

					case 4:		// 네번째 - 언로더 X Home
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_X,F_Home_Act);			// 언로더 X 홈
							Execute_All_Home_RTN = N_TRUE;		
					break;

					case 5 :	// 다섯번째 - 언로더 T Home
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_T,F_Home_Act);			// 언로더 T 홈
							
							Execute_All_Home_RTN = N_TRUE;
					break;

					case 6:		//여섯번째 -  언로더 그립 여부

							call All_Home_Act_Module.AH_Unit_Cmd(N_Unloader_Grip,F_DIO_Act);	// 언로더 그립
							
							
							Execute_All_Home_RTN = N_TRUE;		
					break;

					case 7 :	// 일곱번째 - 언로더 Z  Home
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_Z,F_Home_Act);			// 언로더 X 홈
							Execute_All_Home_RTN = N_TRUE;
					break;


					default:	
						Execute_All_Home_RTN = N_FALSE;	
					break;
				}	
			break;

			//-------------------------------------------------------------------------------------------------------------------------------------------------//
			case N_JellyRoll_Disable :		
					
				switch(Index)	// 요거는 인덱스 
				{
					case 1:		// 첫번째 - Clamp Y, Z Home
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z2,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z2,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z1,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z1,F_Home_Act);		// Act 시작
						call Timer.msec(500);		// z상승 딜레이 타임
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y1,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y1,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y2,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y2,F_Home_Act);		// Act 시작
	
						if( P_Motor_Current_Pos(N_FINAL_ROLL_X) >= P_Recipe_M12_POS(2) + 0.5)// 전체 홈 추가
						{	// 파이널롤러 X가 배출위치가 아니라면
							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Minus_Act);	// Act 시작
							P_FR_Cmd_Check_Flag = 1;
						}
						Execute_All_Home_RTN = N_TRUE;	
					break;

					case 2:		// 두번째 -  FR Z Home , 1st H , SheetPaper H 

						//call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_X,F_Home_Act);	// Act 시작
						//call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Home_Act);	// Act 시작

						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Home_Act);	// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Home_Act);	// Act 시작
						call Timer.msec(500);		// z상승 딜레이 타임
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_T,F_Home_Act);	// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_T,F_Home_Act);	// Act 시작
						
						
						call All_Home_Act_Module.AH_Unit_Cmd(N_SHEET_PAPER_X,F_Home_Act);	// Act 시작

						Execute_All_Home_RTN = N_TRUE;		
					break;		
		
						
					case 3:		// 세번째 - 	NG PNP Home

							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_Z,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_Z,F_Home_Act);		// Act 시작
							call Timer.msec(500);		// z상승 딜레이 타임
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_T,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_T,F_Home_Act);		// Act 시작
						

							Execute_All_Home_RTN = N_TRUE;		

					break;

					case 4:		// 네번째 - 2nd PNP Home , 피커 홈	

							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Home_Act);	// Act 시작
							call Timer.msec(500);		// z상승 딜레이 타임
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_T,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_T,F_Home_Act);	// Act 시작

							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_CA_T,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_AN_T,F_Home_Act);		// Act 시작

							Execute_All_Home_RTN = N_TRUE;	
					break;

					case 5:		// 다섯번째 - 언로더 X Home
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_X,F_Home_Act);		// Act 시작
							Execute_All_Home_RTN = N_TRUE;
					break;

					case 6:		// 여섯번째 - 언로더 T 홈 , FR X 홈 
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_T,F_Home_Act);

							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_X,F_Home_Act);		// Act 시작

							Execute_All_Home_RTN = N_TRUE;		
					break;

					case 7:		// 일곱번째 - 언로더 그립 여부 

							call All_Home_Act_Module.AH_Unit_Cmd(N_Unloader_Grip,F_DIO_Act);	// Act 시작

							Execute_All_Home_RTN = N_TRUE;
					break;

					case 8 :	// 여덟번째 - 언로더 Z 홈, 메인 Z 홈
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_Z,F_Home_Act);	
							call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Home_Act);				// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Home_Act);	// Act 시작
							
							Execute_All_Home_RTN = N_TRUE;
					break;

					default:	
						Execute_All_Home_RTN = N_FALSE;	
					break;
				}	
			break;

			//-------------------------------------------------------------------------------------------------------------------------------------------------//
			case N_New_Non_Homing_CHK :		
					
				switch(Index)	
				{
					case 1:		// 첫번째 - 	Main Z, FR Z, 1st Z Minus, 2nd Z Minus  , N_SHEET_PAPER_X
						
							call All_Home_Act_Module.AH_Unit_Cmd(N_SHEET_PAPER_X,F_Minus_Act);	// Act 시작    [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
							call Timer.msec(500);
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Minus_Act);			// Act 시작

							Execute_All_Home_RTN = N_TRUE;		
					break;		
		
					// 2. [ ALL_Home - Npn Homing CHK ]			
					case 2:		// 두번째 - 클램프 Y 홈  Clamp Y Home ( Clamp Y 는 Minus 없음 ) , 1차 PNP T, Z 홈
							
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y1,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y1,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y2,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y2,F_Home_Act);		// Act 시작

							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_T,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_T,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Home_Act);	// Act 시작
							
							Execute_All_Home_RTN = N_TRUE;
					break;

					case 3:		// 세번째 - NG PNP Home
						 	call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_Z,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_Z,F_Home_Act);		// Act 시작	
							call Timer.msec(500);
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_T,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_T,F_Home_Act);		// Act 시작

							Execute_All_Home_RTN = N_TRUE;		
					break;

					case 4:		// 네번째 - 2nd PNP Home
									
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_T,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_T,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Home_Act);		// Act 시작

							Execute_All_Home_RTN = N_TRUE;		
						
					break;

					case 5:		// 다섯번째 - 언로더 X, 피커 Home
						
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_X,F_Home_Act);			// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_CA_T,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_AN_T,F_Home_Act);		// Act 시작
							 
							Execute_All_Home_RTN = N_TRUE;
					break;

					case 6:		// 여섯번째 - 언로더 T Home , 얼라인 X,Y,T 홈
							
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_T,F_Home_Act);			// Act 시작

							call All_Home_Act_Module.AH_Unit_Cmd(N_Align_CA_X,F_Home_Act);				// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Align_CA_Y,F_Home_Act);				// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Align_CA_T,F_Home_Act);				// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Align_AN_X,F_Home_Act);				// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Align_AN_Y,F_Home_Act);				// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Align_AN_T,F_Home_Act);				// Act 시작

							Execute_All_Home_RTN = N_TRUE;		
					break;

					case 7:		// 일곱번째 - Clamp Home ,언로더 그립
							

							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z2,F_Home_Act);			// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z2,F_Home_Act);			// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z1,F_Home_Act);			// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z1,F_Home_Act);			// Act 시작

							call All_Home_Act_Module.AH_Unit_Cmd(N_Unloader_Grip,F_DIO_Act);		// Act 시작

							Execute_All_Home_RTN = N_TRUE;
					break;

					case 8:		// 여덟번째 - 언로더 Z , FR X Home
							
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_Z,F_Home_Act);				// Act 시작		
							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_X,F_Home_Act);			// Act 시작

							Execute_All_Home_RTN = N_TRUE;
					break;

					case 9 :	// 아홉번째 - FR - Z Home StackTable N_SHEET_PAPER_X home
							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Home_Act);			// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Home_Act);					// Act 시작
							call Timer.msec(500);
							call All_Home_Act_Module.AH_Unit_Cmd(N_SHEET_PAPER_X,F_Home_Act);			// Act 시작  [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]

							Execute_All_Home_RTN = N_TRUE;
					break;

					default:	
						Execute_All_Home_RTN = N_FALSE;	
					break;
				}	
			break;
			// [참 조 : NG PNP 위치 센서 추가 하여 언로더 간섭 여부 회피 2026.04.16]
			case N_New_Non_Homing_CHK2:
				switch(Index)
				{
					case 1:		// 첫번째 - 	Main Z, FR Z, 1st Z Minus, 2nd Z N_SHEET_PAPER_X, Minus 
						
							call All_Home_Act_Module.AH_Unit_Cmd(N_SHEET_PAPER_X,F_Minus_Act);	// Act 시작   [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
							call Timer.msec(500);
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Minus_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_Z, F_Minus_Act);
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_Z, F_Minus_Act);
							call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Minus_Act);			// Act 시작

							Execute_All_Home_RTN = N_TRUE;		
					break;		
		
					// 2. [ ALL_Home - Npn Homing CHK ]			
					case 2:		// 두번째 - 클램프 Y 홈  Clamp Y Home ( Clamp Y 는 Minus 없음 ) , 1차 PNP T, Z 홈
							
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y1,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y1,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y2,F_Home_Act);		// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y2,F_Home_Act);		// Act 시작

							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_T,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_T,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Home_Act);	// Act 시작
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Home_Act);	// Act 시작
							
							if(P_Home_First_Move == 3)
							{
								call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_T, F_Home_Act);
							}
							Execute_All_Home_RTN = N_TRUE;
					break;

					case 3:		// 세번째 - 얼라인 홈, 1차 피커 T 및 언로더 X축 위치에 따른 분기
						call All_Home_Act_Module.AH_Unit_Cmd(N_Align_CA_X,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Align_CA_Y,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Align_CA_T,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Align_AN_X,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Align_AN_Y,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Align_AN_T,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_CA_T,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_AN_T,F_Home_Act);		// Act 시작

						if( P_Home_First_Move == 2 || P_Home_First_Move == 3)
						{
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_Z, F_Plus_Act);
						}
						else if(P_Home_First_Move == 1)
						{
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_T, F_Minus_Act);
						}
	
						Execute_All_Home_RTN = N_TRUE;		
					break;

					case 4:		// 네번째 - 언로더 T Home , 얼라인 X,Y,T 홈

						if( P_Home_First_Move == 2 || P_Home_First_Move == 3)
						{
							call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_T, F_Minus_Act);
						}
						else if(P_Home_First_Move == 1)
						{
							
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_T, F_Home_Act);
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_T, F_Home_Act);
						}	
						//call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_T,F_Home_Act);			// Act 시작

						Execute_All_Home_RTN = N_TRUE;		
					break;

					case 5:		// 다섯번째 - Clamp Home , 언로더 그립
						if( P_Home_First_Move == 2 || P_Home_First_Move == 3)
						{
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_T, F_Home_Act);
							call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_T, F_Home_Act);
						}
						call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_X,F_Home_Act);	
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z2,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z2,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z1,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z1,F_Home_Act);			// Act 시작

						call All_Home_Act_Module.AH_Unit_Cmd(N_Unloader_Grip,F_DIO_Act);		// Act 시작

							Execute_All_Home_RTN = N_TRUE;
					break;

					case 6:		// 여섯번째 - 언로더 Z, 2차 PNP Z 
						call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_Z,F_Home_Act);				// Act 시작

						Execute_All_Home_RTN = N_TRUE;		
					break;

					case 7:
						if(P_Home_First_Move != 3)
						{
							call All_Home_Act_Module.AH_Unit_Cmd(N_UNLOADER_T,F_Home_Act);
						}

						call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_Z,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_Z,F_Home_Act);		// Act 시작
						call Timer.msec(500);
						call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_CA_T,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_NG_PnP_AN_T,F_Home_Act);		// Act 시작

						call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_X,F_Home_Act);	// Act 시작
						Execute_All_Home_RTN = N_TRUE;
					break;

					case 8:
						call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Home_Act);					// Act 시작
						call Timer.msec(500);
						call All_Home_Act_Module.AH_Unit_Cmd(N_SHEET_PAPER_X,F_Home_Act);			// Act 시작   [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
						Execute_All_Home_RTN = N_TRUE;
					break;

					default:	
						Execute_All_Home_RTN = N_FALSE;	
					break;
				}
			break;

			case N_NRT_Dry_Enable:
				switch(Index)	
				{
					case 1:		// 첫번째 - 	Main Z, FR Z, 1st Z Minus  Clamp Y Home ( Clamp Y 는 Minus 없음 )				
						call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Minus_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Minus_Act);	// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Minus_Act);	// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Minus_Act);	// Act 시작
						
						Execute_All_Home_RTN = N_TRUE;		
					break;		
						
					case 2:	// 두번째 - 클램프 홈(H)
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y1,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y1,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Y2,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Y2,F_Home_Act);		// Act 시작
						Execute_All_Home_RTN = N_TRUE;	
					break;

					case 3:	// 세번째 - 양,음극 1st, 2nd Z(H)
						call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_Z,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_Z,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_Z,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_Z,F_Home_Act);		// Act 시작
						Execute_All_Home_RTN = N_TRUE;	
					break;

					case 4:	// 네번째 - 양,음극 1st,2nd T(H)
						call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_CA_T,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_2nd_PnP_AN_T,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_CA_T,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_1st_PnP_AN_T,F_Home_Act);		// Act 시작
						Execute_All_Home_RTN = N_TRUE;	
					break;

					case 5:	// 다섯번째 - 양,음극 clamp (H) , FR X ( H )
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z2,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z2,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_CA_Z1,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_Clamp_AN_Z1,F_Home_Act);			// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_X,F_Home_Act);		// Act 시작
						Execute_All_Home_RTN = N_TRUE;
					break;

					case 6:	// 여섯번째 - FR Z (H), Picker (H)
						//if( Sys_Cathode_1st_Sheet_LO4BYTE == 0 )									// 양극 1차 PNP 극판 Data가 없다면
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_CA_T,F_Home_Act);		// Act 시작
						//if( Sys_Anode_1st_Sheet_LO4BYTE == 0 )										// 음극 1차 PNP 극판 Data가 없다면
							call All_Home_Act_Module.AH_Unit_Cmd(N_1st_Picker_AN_T,F_Home_Act);		// Act 시작
						call All_Home_Act_Module.AH_Unit_Cmd(N_FINAL_ROLL_Z,F_Home_Act);		// Act 시작
						Execute_All_Home_RTN = N_TRUE;
					break;	

					case 7:	// 일곱번째 - Main Z (H)
						call All_Home_Act_Module.AH_Unit_Cmd(N_MAIN_Z,F_Home_Act);				// Act 시작
						Execute_All_Home_RTN = N_TRUE;
					break;
				}
			break;

			Default : 
				Execute_All_Home_RTN = N_FALSE;	
			break;
		}

	return
//===========================================================================//
// 1.4) Precondition_All_Home - 사전 조건 스킵 변수 부여, 감시 다음 시퀀스 실행 조건 보기
//===========================================================================//

	sub:Precondition_All_Home(Mode,Index,&Precondition_All_Home_RTN)	
		// 실행 될 시퀀스의 실행 조건 입력 _ 실행 완료 상태 혹은 실행 스킵 상태를 확인
		//local L_All_Home_Index_Cond = P_AH_Seq_arr(Index);									// 다음 시작해야 할 동작
		Precondition_All_Home_RTN = 0;															// 반환값 초기화.	
		switch(Mode)
		{
			case N_JellyRoll_Enable :		
				Switch(Index)
				{
					case N_SEQ_Execute_First_Sepa_Mode_No_1 : 
						Precondition_All_Home_RTN = N_TRUE;
					break;		
								
					case 2 :	// 첫번째 시퀀스의 결과값 : 1st Home check
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));		// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_1st_PnP_CA_T) & P_AH_Indvi_rtn(N_1st_PnP_AN_T) & P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 3:		// 두번째 시퀀스의 결과값 : NG Home Check
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_Z));		// Act 행동 완료 감시
							
							if( P_AH_Indvi_rtn(N_NG_PnP_CA_T) & P_AH_Indvi_rtn(N_NG_PnP_AN_T) & P_AH_Indvi_rtn(N_NG_PnP_CA_Z) & P_AH_Indvi_rtn(N_NG_PnP_AN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 4:		// 세번째 시퀀스의 결과값 : 2nd Home Check , 피커 
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_CA_T));	// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_AN_T));	// Act 행동 완료 감시

							if( P_AH_Indvi_rtn(N_2nd_PnP_CA_T) & P_AH_Indvi_rtn(N_2nd_PnP_AN_T) & P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z) )
							{
								if( P_AH_Indvi_rtn(N_1st_Picker_CA_T) & P_AH_Indvi_rtn(N_1st_Picker_AN_T) )
									Precondition_All_Home_RTN = N_TRUE;
							}
					break;

					case 5:		// 네번째 시퀀스의 결과값 : 언로더 X Home Check  
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_X,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_X));			// Act 행동 완료 감시
							
							if( P_AH_Indvi_rtn(N_UNLOADER_X) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 6:		// 다섯번째 시퀀스의 결과값 : 언로더 T 체크
							
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_T,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_T));			// Act 행동 완료 감시
							
							if( P_AH_Indvi_rtn(N_UNLOADER_T) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 7:		// 여섯번째 시퀀스의 결과값 : 언로더 그립 여부 추가

								call All_Home_Act_Module.AH_Unit_Verify(N_Unloader_Grip,F_DIO_Act,&P_AH_Indvi_rtn(N_Unloader_Grip));	// Act 행동 완료 감시
								if( P_AH_Indvi_rtn(N_Unloader_Grip) )
								{
									Precondition_All_Home_RTN = N_TRUE;
								}
	
					break;

					case 8:		// 일곱번째 시퀀스 결과값 : 언로더 Z 홈체크
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_Z,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_Z));			// Act 행동 완료 감시
							if( P_AH_Indvi_rtn(N_UNLOADER_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					default :
						Precondition_All_Home_RTN = N_TRUE;	
					break;
				}
			break;
//----------------------------------------------------------------------------------------------------------------------------
			case N_JellyRoll_Disable :		
				Switch(Index)
				{
					case N_SEQ_Execute_First_Sepa_Mode_No_1 : 
						Precondition_All_Home_RTN = N_TRUE;
					break;
					
					case 2:		// 첫번째 시퀀스의 결과값: Clamp Y,Z Home
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z1));		// Act 행동 완료 감시

							if( P_FR_Cmd_Check_Flag == 1 )	// 전체 홈 추가
							{	// 파이널롤러 X가 배출위치가 아니라면
								call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));
							}
							else
							{
								P_AH_Indvi_rtn(N_FINAL_ROLL_Z) = 1;
							}

							if( P_AH_Indvi_rtn(N_Clamp_CA_Y1) & P_AH_Indvi_rtn(N_Clamp_AN_Y1) & P_AH_Indvi_rtn(N_Clamp_CA_Y2) & P_AH_Indvi_rtn(N_Clamp_AN_Y2))
							{
								if( P_AH_Indvi_rtn(N_Clamp_CA_Z2) & P_AH_Indvi_rtn(N_Clamp_AN_Z2) & P_AH_Indvi_rtn(N_Clamp_CA_Z1) & P_AH_Indvi_rtn(N_Clamp_AN_Z1))
								{
									if( P_AH_Indvi_rtn(N_FINAL_ROLL_Z))
									{
										P_FR_Cmd_Check_Flag = 0;
										Precondition_All_Home_RTN = N_TRUE;
								
									}
								}
							}
					break;		

					case 3 :	// 두번째 시퀀스의 결과값 :  FR Z Home Check

							//call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_X,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_X));		// Act 행동 완료 감시
							//call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));		// Act 행동 완료 감시

							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));		// Act 행동 완료 감시

							call All_Home_Act_Module.AH_Unit_Verify(N_SHEET_PAPER_X,F_Home_Act,&P_AH_Indvi_rtn(N_SHEET_PAPER_X));	// Act 행동 완료 감시

							//if( P_AH_Indvi_rtn(N_FINAL_ROLL_Z) )
							//{
								if( P_AH_Indvi_rtn(N_1st_PnP_CA_T) & P_AH_Indvi_rtn(N_1st_PnP_AN_T) & P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z) )
								{
									if( P_AH_Indvi_rtn(N_SHEET_PAPER_X) )
										Precondition_All_Home_RTN = N_TRUE;
								}
							//}
					break;
								
					case 4 :	// 세번째 시퀀스의 결과값 : NG Home Check
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_Z));		// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_NG_PnP_CA_T) & P_AH_Indvi_rtn(N_NG_PnP_AN_T) & P_AH_Indvi_rtn(N_NG_PnP_CA_Z) & P_AH_Indvi_rtn(N_NG_PnP_AN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 5:		// 네번째 시퀀스의 결과값 : 2nd Home Check, 피커 홈
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_CA_T));	// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_AN_T));	// Act 행동 완료 감시

							if( P_AH_Indvi_rtn(N_2nd_PnP_CA_T) & P_AH_Indvi_rtn(N_2nd_PnP_AN_T) & P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z) )
							{
								if( P_AH_Indvi_rtn(N_1st_Picker_CA_T) & P_AH_Indvi_rtn(N_1st_Picker_AN_T) )
									Precondition_All_Home_RTN = N_TRUE;
							}
								
					break;

					case 6:		// 다섯번째 시퀀스의 결과값 : 언로더 X
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_X,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_X));			// Act 행동 완료 감시
							
							if( P_AH_Indvi_rtn(N_UNLOADER_X) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 7:		// 여섯번째 시퀀스의 결과값 : 언로더 T , FR X 홈
							
							call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_X,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_X));
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_T,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_T));			// Act 행동 완료 감시

								if( P_AH_Indvi_rtn(N_FINAL_ROLL_X) & P_AH_Indvi_rtn(N_UNLOADER_T) )
									Precondition_All_Home_RTN = N_TRUE;
									
								
					break;

					case 8:		// 일곱번째 시퀀스의 결과값 : 언로더 그립 								

							call All_Home_Act_Module.AH_Unit_Verify(N_Unloader_Grip,F_DIO_Act,&P_AH_Indvi_rtn(N_Unloader_Grip));	// Act 행동 완료 감시
							if( P_AH_Indvi_rtn(N_Unloader_Grip) ) 
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
									
					break;

					case 9:		// 여덟번째 시퀀스의 결과값 : 언로더 Z, 메인 Z
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_Z,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_Z));				// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_MAIN_Z));	
							call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));		// Act 행동 완료 감시

							if( P_AH_Indvi_rtn(N_UNLOADER_Z) & P_AH_Indvi_rtn(N_MAIN_Z) & P_AH_Indvi_rtn(N_FINAL_ROLL_Z))
								Precondition_All_Home_RTN = N_TRUE;
					break;

					default :
						Precondition_All_Home_RTN = N_TRUE;	
					break;
				}
			break;

			case N_New_Non_Homing_CHK :		
				Switch(Index)
				{
					case N_SEQ_Execute_First_Sepa_Mode_No_1 : 
						Precondition_All_Home_RTN = N_TRUE;
					break;		
								
					case 2 :	// 첫번째 시퀀스의 결과값 : Main Z, FR Z, 1st Z Minus Check Clamp Y Home Check
							call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_MAIN_Z));				// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));	// Act 행동 완료 감시	
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));	// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));	// Act 행동 완료 감시	
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));	// Act 행동 완료 감시				
							call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));	// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_SHEET_PAPER_X,F_Minus_Act,&P_AH_Indvi_rtn(N_SHEET_PAPER_X));	// Act 행동 완료 감시  [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
							
								if( P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z) & P_AH_Indvi_rtn(N_FINAL_ROLL_Z) & P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z)&P_AH_Indvi_rtn(N_SHEET_PAPER_X)&P_AH_Indvi_rtn(N_MAIN_Z) )
									Precondition_All_Home_RTN = N_TRUE;
										
					break;
								
					case 3 :	// 두번째 시퀀스의 결과값 : Clamp Y Home Check, 1st PNP Home 
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y2));		// Act 행동 완료 감시
							
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));		// Act 행동 완료 감시

							if( P_AH_Indvi_rtn(N_Clamp_CA_Y1) & P_AH_Indvi_rtn(N_Clamp_AN_Y1) & P_AH_Indvi_rtn(N_Clamp_CA_Y2) & P_AH_Indvi_rtn(N_Clamp_AN_Y2))
							{
								if( P_AH_Indvi_rtn(N_1st_PnP_CA_T) & P_AH_Indvi_rtn(N_1st_PnP_AN_T) & P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z))
								{
									Precondition_All_Home_RTN = N_TRUE;
								}
							}
					break;

					case 4:		// 세번째 시퀀스의 결과값 : NG Home Check
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_Z));		// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_NG_PnP_CA_T) & P_AH_Indvi_rtn(N_NG_PnP_AN_T) & P_AH_Indvi_rtn(N_NG_PnP_CA_Z) & P_AH_Indvi_rtn(N_NG_PnP_AN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 5:		// 네번째 시퀀스의 결과값 : 2nd Home Check
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));		// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_2nd_PnP_CA_T) & P_AH_Indvi_rtn(N_2nd_PnP_AN_T) & P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 6:		// 다섯번째 시퀀스의 결과값 : 언로더 X Home Check , 피커 홈체크
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_X,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_X));				// Act 행동 완료 감시							
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_CA_T));	// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_AN_T));	// Act 행동 완료 감시
							
							if( P_AH_Indvi_rtn(N_UNLOADER_X) & P_AH_Indvi_rtn(N_1st_Picker_CA_T) & P_AH_Indvi_rtn(N_1st_Picker_AN_T))
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
					break;

					case 7:		// 여섯번째 시퀀스의 결과값 : 언로더 T, 얼라ㅓ인 X,Y,T Home
							
							call All_Home_Act_Module.AH_Unit_Verify(N_Align_CA_X,F_Home_Act,&P_AH_Indvi_rtn(N_Align_CA_X));			// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Align_CA_Y,F_Home_Act,&P_AH_Indvi_rtn(N_Align_CA_Y));			// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Align_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_Align_CA_T));			// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Align_AN_X,F_Home_Act,&P_AH_Indvi_rtn(N_Align_AN_X));			// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Align_AN_Y,F_Home_Act,&P_AH_Indvi_rtn(N_Align_AN_Y));			// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Align_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_Align_AN_T));			// Act 행동 완료 감시

							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_T,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_T));			// Act 행동 완료 감시

							if( P_AH_Indvi_rtn(N_Align_CA_X) & P_AH_Indvi_rtn(N_Align_CA_Y) & P_AH_Indvi_rtn(N_Align_CA_T) & P_AH_Indvi_rtn(N_UNLOADER_T) )
							{
								if( P_AH_Indvi_rtn(N_Align_AN_X) & P_AH_Indvi_rtn(N_Align_AN_Y) & P_AH_Indvi_rtn(N_Align_AN_T) )
								{
									Precondition_All_Home_RTN = N_TRUE;
								}
							}
							
					break;

					case 8:		// 일곱번째 시퀀스의 결과값 : Clamp Home Check , 언로더 그립
	
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z2));		// Act 행동 완료 감시
							
							call All_Home_Act_Module.AH_Unit_Verify(N_Unloader_Grip,F_DIO_Act,&P_AH_Indvi_rtn(N_Unloader_Grip));	// Act 행동 완료 감시

								if( P_AH_Indvi_rtn(N_Clamp_CA_Z1) & P_AH_Indvi_rtn(N_Clamp_AN_Z1) & P_AH_Indvi_rtn(N_Clamp_CA_Z2) & P_AH_Indvi_rtn(N_Clamp_AN_Z2) & P_AH_Indvi_rtn(N_Unloader_Grip))
									Precondition_All_Home_RTN = N_TRUE;
					break;

					case 9:	// 여덟번째 시퀀스의 결과값 : 언로더Z,  FR X Home
							
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_Z,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_Z));						
							call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_X,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_X));		// Act 행동 완료 감시
							
							if( P_AH_Indvi_rtn(N_FINAL_ROLL_X) & P_AH_Indvi_rtn(N_UNLOADER_Z) )
							{
									Precondition_All_Home_RTN = N_TRUE;
							}
					break;

					case 10:	// 아홉번째 시퀀스의 결과값 : FR Z Home Check, StackTable
						call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));		// Act 행동 완료 감시	
						call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_MAIN_Z));					// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_SHEET_PAPER_X,F_Home_Act,&P_AH_Indvi_rtn(N_SHEET_PAPER_X));	//[ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
							
							if( P_AH_Indvi_rtn(N_MAIN_Z) & P_AH_Indvi_rtn(N_FINAL_ROLL_Z) & P_AH_Indvi_rtn(N_SHEET_PAPER_X))
								Precondition_All_Home_RTN = N_TRUE;
					break;

					default :
						Precondition_All_Home_RTN = N_TRUE;	
					break;
				}
			break;

			// [참 조 : NG PNP 위치 센서 추가 하여 언로더 간섭 여부 회피 2026.04.16]
			case N_New_Non_Homing_CHK2 :		
				Switch(Index)
				{
					case N_SEQ_Execute_First_Sepa_Mode_No_1 : 
						Precondition_All_Home_RTN = N_TRUE;
					break;		
								
					case 2 :	// 첫번째 시퀀스의 결과값 : Main Z, FR Z, 1st Z Minus Check Clamp Y F_Minus_Act Check

						call All_Home_Act_Module.AH_Unit_Verify(N_SHEET_PAPER_X,F_Minus_Act,&P_AH_Indvi_rtn(N_SHEET_PAPER_X));	// Act 시작   [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
						call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));	// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));	// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));	// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));	// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));	// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_Z, F_Minus_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_Z));
						call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_Z, F_Minus_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_Z));
						call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_MAIN_Z));			// Act 시작
								
						if( P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z) & P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z) & P_AH_Indvi_rtn(N_NG_PnP_CA_Z) & P_AH_Indvi_rtn(N_NG_PnP_AN_Z))
						{
							if(P_AH_Indvi_rtn(N_FINAL_ROLL_Z) & P_AH_Indvi_rtn(N_SHEET_PAPER_X) & P_AH_Indvi_rtn(N_MAIN_Z))
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
						}

					break;
								
					case 3 :	// 두번째 시퀀스의 결과값 : Clamp Y Home Check, 1st PNP Home 
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y2));		// Act 행동 완료 감시
							
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));		// Act 행동 완료 감시
							if(P_Home_First_Move == 3)
							{
								call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_T,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_T));
							}

							if( P_AH_Indvi_rtn(N_Clamp_CA_Y1) & P_AH_Indvi_rtn(N_Clamp_AN_Y1) & P_AH_Indvi_rtn(N_Clamp_CA_Y2) & P_AH_Indvi_rtn(N_Clamp_AN_Y2))
							{
								if( P_AH_Indvi_rtn(N_1st_PnP_CA_T) & P_AH_Indvi_rtn(N_1st_PnP_AN_T) & P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z))
								{
									if(P_Home_First_Move == 3)
									{
										if(P_AH_Indvi_rtn(N_UNLOADER_T))
										{
											Precondition_All_Home_RTN = N_TRUE;
										}
									}
									else
									{
										Precondition_All_Home_RTN = N_TRUE;										
									}

								}
							}
					break;

					case 4:		// 세번째 시퀀스의 결과값 : 언로더 X 피커 H
						call All_Home_Act_Module.AH_Unit_Verify(N_Align_CA_X,F_Home_Act,&P_AH_Indvi_rtn(N_Align_CA_X));				// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Align_CA_Y,F_Home_Act,&P_AH_Indvi_rtn(N_Align_CA_Y));				// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Align_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_Align_CA_T));				// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Align_AN_X,F_Home_Act,&P_AH_Indvi_rtn(N_Align_AN_X));				// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Align_AN_Y,F_Home_Act,&P_AH_Indvi_rtn(N_Align_AN_Y));				// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Align_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_Align_AN_T));				// Act 행동 완료 감시				
						call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_CA_T));	// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_AN_T));	// Act 행동 완료 감시

						if( P_Home_First_Move == 2 || P_Home_First_Move == 3)
						{
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_Z, F_Plus_Act, &P_AH_Indvi_rtn(N_UNLOADER_Z));
						}
						else if(P_Home_First_Move == 1)
						{
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_T, F_Minus_Act, &P_AH_Indvi_rtn(N_NG_PnP_CA_T));
						}

						if(P_AH_Indvi_rtn(N_1st_Picker_CA_T) & P_AH_Indvi_rtn(N_1st_Picker_AN_T))
						{
							if(P_AH_Indvi_rtn(N_Align_AN_X) & P_AH_Indvi_rtn(N_Align_AN_Y) & P_AH_Indvi_rtn(N_Align_AN_T) & P_AH_Indvi_rtn(N_Align_CA_X) & P_AH_Indvi_rtn(N_Align_CA_Y) & P_AH_Indvi_rtn(N_Align_CA_T))
							{
								if((P_Home_First_Move == 2 || P_Home_First_Move == 3))
								{
									if(P_AH_Indvi_rtn(N_UNLOADER_Z))
									{
										Precondition_All_Home_RTN = N_TRUE;
									}
								}
								else if(P_Home_First_Move == 1 && P_AH_Indvi_rtn(N_NG_PnP_CA_T))
								{
									Precondition_All_Home_RTN = N_TRUE;
								}
							}
						}
					break;

					case 5:		// 네번째 시퀀스의 결과값 : 언로더T,  얼라인 X,Y,T
						if( P_Home_First_Move == 2 || P_Home_First_Move == 3)
						{
							call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_T, F_Minus_Act, &P_AH_Indvi_rtn(N_NG_PnP_CA_T));

							if(P_AH_Indvi_rtn(N_NG_PnP_CA_T))
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
						}
						else if(P_Home_First_Move == 1)
						{
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_T, F_Home_Act, &P_AH_Indvi_rtn(N_2nd_PnP_CA_T));
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_T, F_Home_Act, &P_AH_Indvi_rtn(N_2nd_PnP_AN_T));
							if(P_AH_Indvi_rtn(N_2nd_PnP_CA_T) & P_AH_Indvi_rtn(N_2nd_PnP_AN_T))
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
						}
							
					break;

					case 6:		// 다섯번째 시퀀스의 결과값 : 클램프 Z, 언로더 그립
						if( P_Home_First_Move == 2 || P_Home_First_Move == 3)
						{
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_T, F_Home_Act, &P_AH_Indvi_rtn(N_2nd_PnP_CA_T));
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_T, F_Home_Act, &P_AH_Indvi_rtn(N_2nd_PnP_AN_T));
						}
						call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_X,F_Home_Act, &P_AH_Indvi_rtn(N_UNLOADER_X));
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z1));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z1));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z2));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z2));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Unloader_Grip,F_DIO_Act,&P_AH_Indvi_rtn(N_Unloader_Grip));	// Act 행동 완료 감시

						if( P_AH_Indvi_rtn(N_Clamp_CA_Z1) & P_AH_Indvi_rtn(N_Clamp_AN_Z1) & P_AH_Indvi_rtn(N_Clamp_CA_Z2) & P_AH_Indvi_rtn(N_Clamp_AN_Z2) & P_AH_Indvi_rtn(N_Unloader_Grip) & P_AH_Indvi_rtn(N_UNLOADER_X))
						{
							if((P_Home_First_Move == 2 || P_Home_First_Move == 3))
							{
								if(P_AH_Indvi_rtn(N_2nd_PnP_AN_T) & P_AH_Indvi_rtn(N_2nd_PnP_CA_T))
								{
									Precondition_All_Home_RTN = N_TRUE;
								}
							}
							else
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
						}
					break;

					case 7:		// 여섯번째 시퀀스의 결과값 : 언로더 Z
						call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Home_Act, &P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));		// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Home_Act, &P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));		// Act 시작
						call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_Z,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_Z));	
								
							if( P_AH_Indvi_rtn(N_UNLOADER_Z) & P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z))
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
					break;

					case 8:		// 일곱번째 시퀀스의 결과값 : NG PNP Home
						call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_T));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_T));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_CA_Z));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_NG_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_NG_PnP_AN_Z));		// Act 행동 완료 감시
						
						call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_X,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_X));
						if(P_Home_First_Move != 3)
						{
							call All_Home_Act_Module.AH_Unit_Verify(N_UNLOADER_T,F_Home_Act,&P_AH_Indvi_rtn(N_UNLOADER_T));
						}
	
						if( P_AH_Indvi_rtn(N_NG_PnP_CA_T) & P_AH_Indvi_rtn(N_NG_PnP_AN_T) & P_AH_Indvi_rtn(N_NG_PnP_CA_Z) & P_AH_Indvi_rtn(N_NG_PnP_AN_Z) & P_AH_Indvi_rtn(N_FINAL_ROLL_X))
						{
							if(P_Home_First_Move != 3 && P_AH_Indvi_rtn(N_UNLOADER_T))
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
							else if(P_Home_First_Move == 3)
							{
								Precondition_All_Home_RTN = N_TRUE;
							}
						}

					break;

					case 9:	// 여덟번째 시퀀스의 결과값 : 2차 PNP
						call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));		// Act 행동 완료 감시	
						call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_MAIN_Z));					// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_SHEET_PAPER_X,F_Home_Act,&P_AH_Indvi_rtn(N_SHEET_PAPER_X));
							
						if( P_AH_Indvi_rtn(N_MAIN_Z) & P_AH_Indvi_rtn(N_FINAL_ROLL_Z) & P_AH_Indvi_rtn(N_SHEET_PAPER_X))	// [ 참조 : 2026.05.29 Sheetpaper 마지막에 홈 처리 ]
								Precondition_All_Home_RTN = N_TRUE;	
					break;

					default :
						Precondition_All_Home_RTN = N_TRUE;	
					break;
				}
			break;

			case N_NRT_Dry_Enable:

				Switch(Index)
				{
					case 1:		Precondition_All_Home_RTN = N_TRUE;

					case 2:		// 첫번째 시퀀스의 결과값 : 스텍테이블, 파이널롤러Z, 양,음극 1st Z(-) 
							call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_MAIN_Z));				// Act 행동 완료 감시							
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));	// Act 행동 완료 감시	
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));	// Act 행동 완료 감시			
							call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Minus_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));	// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_MAIN_Z) & P_AH_Indvi_rtn(N_FINAL_ROLL_Z) )
							{
								if( P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z))
									Precondition_All_Home_RTN = N_TRUE;
							}			
					break;

					case 3:		// 두번째 시퀀스의 결과값 : 클램프Y(H) 클램프 Y는 Minus리밋이없음
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y1));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y1));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Y2));		// Act 행동 완료 감시
						call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Y2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Y2));		// Act 행동 완료 감시
						
						if( P_AH_Indvi_rtn(N_Clamp_CA_Y1) & P_AH_Indvi_rtn(N_Clamp_AN_Y1) & P_AH_Indvi_rtn(N_Clamp_CA_Y2) & P_AH_Indvi_rtn(N_Clamp_AN_Y2))
									Precondition_All_Home_RTN = N_TRUE;
					break;

					case 4:		// 세번째 시퀀스의 결과값 : 양,음극 1st,2nd Z(H)
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_Z));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_Z));		// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_2nd_PnP_CA_Z) & P_AH_Indvi_rtn(N_2nd_PnP_AN_Z) & P_AH_Indvi_rtn(N_1st_PnP_CA_Z) & P_AH_Indvi_rtn(N_1st_PnP_AN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;
					
					case 5:		// 네번째 시퀀스의 결과값 : 양,음극 1st,2nd T(H)
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_2nd_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_2nd_PnP_AN_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_CA_T));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_1st_PnP_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_PnP_AN_T));		// Act 행동 완료 감시
						
							if( P_AH_Indvi_rtn(N_2nd_PnP_CA_T) & P_AH_Indvi_rtn(N_2nd_PnP_AN_T) & P_AH_Indvi_rtn(N_1st_PnP_CA_T) & P_AH_Indvi_rtn(N_1st_PnP_AN_T) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 6:	// 다섯번째 시퀀스의 결과값 : 양,음극 clamp (H) , FR X ( H )
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z1,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z1));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_CA_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_CA_Z2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_Clamp_AN_Z2,F_Home_Act,&P_AH_Indvi_rtn(N_Clamp_AN_Z2));		// Act 행동 완료 감시
							call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_X,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_X));		// Act 행동 완료 감시	

								if( P_AH_Indvi_rtn(N_FINAL_ROLL_X) )
								{
									if( P_AH_Indvi_rtn(N_Clamp_CA_Z1) & P_AH_Indvi_rtn(N_Clamp_AN_Z1) & P_AH_Indvi_rtn(N_Clamp_CA_Z2) & P_AH_Indvi_rtn(N_Clamp_AN_Z2) )
										Precondition_All_Home_RTN = N_TRUE;
								}
					break;

					case 7:		// 여섯번째 시퀀스의 결과값 : FR Z (H)
						call All_Home_Act_Module.AH_Unit_Verify(N_FINAL_ROLL_Z,F_Home_Act,&P_AH_Indvi_rtn(N_FINAL_ROLL_Z));	// Act 행동 완료 감시	

//						if( Sys_Cathode_1st_Sheet_LO4BYTE == 0 )									// 양극 1차 PNP 극판 Data가 없다면
								call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_CA_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_CA_T));	// Act 행동 완료 감시
//							else
//								P_AH_Indvi_rtn(N_1st_Picker_CA_T) = 1;

//							if( Sys_Anode_1st_Sheet_LO4BYTE == 0 )										// 음극 1차 PNP 극판 Data가 없다면
								call All_Home_Act_Module.AH_Unit_Verify(N_1st_Picker_AN_T,F_Home_Act,&P_AH_Indvi_rtn(N_1st_Picker_AN_T));	// Act 행동 완료 감시
//							else
//								P_AH_Indvi_rtn(N_1st_Picker_AN_T) = 1;

							if( P_AH_Indvi_rtn(N_FINAL_ROLL_Z) & P_AH_Indvi_rtn(N_1st_Picker_CA_T) & P_AH_Indvi_rtn(N_1st_Picker_AN_T) )
								Precondition_All_Home_RTN = N_TRUE;
					break;

					case 8:		// 일곱번째 시퀀스 값 : Main Z (H)
						call All_Home_Act_Module.AH_Unit_Verify(N_MAIN_Z,F_Home_Act,&P_AH_Indvi_rtn(N_MAIN_Z));	// Act 행동 완료 감시	

							if( P_AH_Indvi_rtn(N_MAIN_Z) )
								Precondition_All_Home_RTN = N_TRUE;
					break;
				}
			break;

			default :	
				
			break;
		}
	return
close



