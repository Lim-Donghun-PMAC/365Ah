	// 6.런모드 선택 _ 양극런&음극런 / 파이널롤러 Z축/ 메인 Z축 / 양극얼라인 / 음극 얼라인 
	sub:Select_Run_Mode(Unit,&rtn)
		rtn = 0;
		switch( Unit )
		{
			case N_Cathode_1st_Picker_T :
			case N_Cathode_Clamp_Unit :
			case N_Cathode_1st_PNP_Unit :
			case N_Cathode_2nd_PNP_Unit :
							P_Cathode_Run_Command_Flag = 1;				//양극런 진입
							//P_Single_Run_Mode_Flag = 1;
							rtn = N_TRUE;								// 반환값 업데이트. [TRUE]		
			break;
			
			case N_Clamp_FR_Run : 
			case N_Anode_1st_Picker_T :
			case N_Anode_Clamp_Unit :
			case N_Anode_1st_PNP_Unit :	
			case N_Anode_2nd_PNP_Unit :	
			case N_Finall_Roller_X_Unit :
							P_Anode_Run_Command_Flag = 1;				//음극런 진입
							//P_Single_Run_Mode_Flag = 1;
							rtn = N_TRUE;								// 반환값 업데이트. [TRUE]		
			break;
		
			case N_Cathode_Align_Unit :						
				//P_Cathode_AT_Motion_Flag = 1;							//양극 얼라인 모션
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;
			
			case N_Anode_Align_Unit :						
				//P_Anode_AT_Motion_Flag = 1;							//음극 얼라인 모션
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;
			
			case N_Finall_Roller_Z_Unit :						
				//P_Final_Roll_Z_Motion_Flag = 1;						//파이널롤러 Z축 모션
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Stack_Table_Unit :
				//P_Main_Z_Motion_Flag = 1;								//메인Z축 모션
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Sheet_Paper_Unit :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Cathode_NG_PNP_Total_Unit :
			case N_Cathode_NG_PNP_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_Cathode_NG_PNP_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_NG_PNP_Total_Unit :
			case N_Anode_NG_PNP_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_Anode_NG_PNP_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break;

			case N_1st_UND_X :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_Z :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break

			case N_1st_UND_T :
				rtn = N_TRUE;											// 반환값 업데이트. [TRUE]		
			break
		}

	return

	// 7. 런모드 진행.
	sub:Run_Execute(&Run_Execute_RTN)
		/* 
			P_Single_Run_Mode_Flag = 1						런모드. (양,음극 1,2차 PNP, Clamp) [연동]
			
			P_Sheet_Paper_Motion_Flag = 1					시트페이퍼 연속 동작

			P_Cathode_Align_Motion_State_Machine = 1		양극 얼라인 연속 동작

			P_Anode_Align_Motion_State_Machine = 1			음극 얼라인 연속 동작

			P_NG_PNP_Uint_State_Machine = 1					NG PNP 연속 동작

		*/
		Run_Execute_RTN = 0;

		// 1. 유닛 단동 실행
		if ( P_Single_Run_Mode_Flag == 1 )											// 런모드 실행 Flag On 일 경우.														
		{
			if ( P_Single_Run_Mode_Flag != P_Old_Single_Run_Mode_Flag || P_Current_Mode != P_Old_Current_Mode )	// Edge 상태 확인.
			{

				P_Position_Calc_Status = F_Status_Nonseatus;						// 모터 위치 계산 상태 초기화.
				P_Init_Result(0),N_Mode_Total_EA,1 = 0;								// 모드 배열 초기화 결과값 초기화.
				P_Vision_Result(0),N_Vision_Total_EA,1 = 0;							// 비전 결과값 초기화.			24.01.31 추가.
				P_Vision_Result_Get_First_Cycle(0),N_Vision_Total_EA,1 = 0;			// 비전 결과값 get 사이클 카운트 변수 초기화.

				P_Old_Current_Mode = P_Current_Mode;								// 모드값 동기화.
				P_Old_Single_Run_Mode_Flag = P_Single_Run_Mode_Flag;				// 런모드 플래그 이전값 동기화.
			}
		
			switch ( P_Current_Mode )
			{
				case F_Half_Cathode_Run_Mode :										// 양극 Half Run 모드.
					if ( P_Master_Motion_Trigger >= 83 && P_Master_Motion_Trigger < 85 )	// Trigger 확인.
					{
						if ( P_Init_Result(N_Anode_Run) < F_Result_Complete )		// 음극 런모드 Array 완료 전 일 경우.
						{
							call Sub_Init_Run_Mode_Array.Anode_Run(F_Dry_Run,89,&P_Init_Result(N_Anode_Run));
							//call Sub_Init_Run_Mode_Array.Anode_Run(F_Normal_Run,89,&P_Init_Result(N_Anode_Run));	// 음극 런모드 Array 초기화.
							if ( P_Init_Result(N_Anode_Run) == F_Result_Complete )	// 음극 런모드 Array 완료 일 경우.
							{
								P_Mode_Command = F_Half_Anode_Run_Command;			// 음극 런모드 실행.
							}
						}
					}
				break;
				
				case F_Half_Anode_Run_Mode :										// 음극 Half Run 모드.
					if ( P_Master_Motion_Trigger >= 40 && P_Master_Motion_Trigger < 42 )	// Trigger 확인.
					{
						if ( P_Init_Result(N_Cathode_Run) < F_Result_Complete	)	// 양극 런모드 Array 완료 전 일 경우.
						{
							call Sub_Init_Run_Mode_Array.Cathode_Run(F_Dry_Run,44,&P_Init_Result(N_Cathode_Run));
							//call Sub_Init_Run_Mode_Array.Cathode_Run(F_Normal_Run,44,&P_Init_Result(N_Cathode_Run));// 양극런모드 Array 초기화.
							if ( P_Init_Result(N_Cathode_Run) == F_Result_Complete )// 양극 런모드 Array 완료 일 경우.
							{
								P_Mode_Command = F_Half_Cathode_Run_Command;		// 양극 런모드 실행.
							}
						}
					}
				break;
				
				case F_Wait_Mode :													// Wait 모드.
					if ( P_Cathode_Run_Command_Flag == 1 )							// 양극 런 진입 Flag On 일 경우.
					{
						if ( P_Master_Motion_Trigger >= 40 && P_Master_Motion_Trigger < 42 ) // Trigger 확인.
						{
							if ( P_Init_Result(N_Cathode_Run) < F_Result_Complete )	// 양극 런모드 Array 완료 전 일 경우.
							{
								//call Sub_Init_Run_Mode_Array.Cathode_Run(F_Dry_Run,44,&P_Init_Result(N_Cathode_Run));
								call Sub_Init_Run_Mode_Array.Cathode_Run(F_Normal_Run,44,&P_Init_Result(N_Cathode_Run)); // 일반 양극런.		
								if ( P_Init_Result(N_Cathode_Run) == F_Result_Complete )	// 양극 런모드 Array 완료 일 경우.
								{
									if( P_Master_Motion_Trigger <= P_In_Position(F_Half_Cathode_Run_Command) - P_In_Pos_Trg )	// 양극 런 In position 확인.
									{
										P_Cathode_Run_Command_Flag = 0;				// 양극 런 진입 Flag 초기화.
										P_Mode_Command = F_Half_Cathode_Run_Command;// 양극 런모드 실행.
									}
								}
							}
						}
					}
		
		
					if ( P_Anode_Run_Command_Flag == 1 )							// 음극 런 진입 Flag On 일 경우.
					{
						if ( P_Master_Motion_Trigger >= 84 && P_Master_Motion_Trigger < 86 )	// Trigger 확인.
						{
							if ( P_Init_Result(N_Anode_Run) < F_Result_Complete	)	// 음극 런모드 Array 완료 전 일 경우.
							{
								//call Sub_Init_Run_Mode_Array.Anode_Run(F_Dry_Run,89,&P_Init_Result(N_Anode_Run));
								call Sub_Init_Run_Mode_Array.Anode_Run(F_Normal_Run,89,&P_Init_Result(N_Anode_Run));	// 음극런 배열 초기화.	
								if ( P_Init_Result(N_Anode_Run) == F_Result_Complete )	// 음극 런모드 Array 완료 일 경우.
								{
									if( P_Master_Motion_Trigger <= P_In_Position(F_Half_Anode_Run_Command) - P_In_Pos_Trg )	// 음극 런 In position 확인.
									{
										P_Anode_Run_Command_Flag = 0;				// 음극 런 진입 Flag 초기화.
										P_Mode_Command = F_Half_Anode_Run_Command;	// 음극 런모드 실행.								
									}
								}
							}
						}
					}
				break;				
			}				
		}			
		else if ( P_Sheet_Paper_Motion_Flag == 1 )						// Sheet Paper 모션 플래그
		{
			P_Sheet_Paper_Motion_Flag = 0								// 재진입 방지.
			P_Slave11_Motion_Command = 88
		}

		
		// 2. 양극 얼라인 단동, 반복 움직임
		switch ( P_Cathode_Align_Motion_State_Machine )
		{
			case 1 : // 얼라인 무브 동작 활성화.
				if( P_Single_Run_Align_Timer > 500 )					// 딜레이 시간 확인.
				{		
					P_Single_Run_Align_Timer = 0;						// 타이머 초기화.
					P_Cathode_Align_Stage_X_mm=5;						// 구동 위치 업데이트.
					P_Cathode_Align_Stage_Y_mm=5;						// 구동 위치 업데이트.
					P_Cathode_Align_Stage_T_mm= P_Align_Test_Pos; //1.5;						// 구동 위치 업데이트.
		
					P_Cathode_Align_Table_Move = F_Align_Move_Mode;		// 얼라인 무브 동작 플래그.
					cmd"&2b2r";											// 좌표계 활성화.
		
					P_Cathode_Align_Motion_State_Machine = 2;			// 다음 스텟 머신으로 이동.
				}
				else If(P_Single_Run_Stop_Command == 1 || M_X_BTN_CMD_Auto_Stop == 1)
				{
					P_Cathode_Align_Motion_State_Machine = 0
				}
			break;
		
			case 2 : // 얼라인 대기 위치 동작 확성화.
				if( P_Single_Run_Align_Timer > 500 )					// 딜레이 시간 확인.
				{
					P_Single_Run_Align_Timer = 0;						// 타이머 초기화.
		
					P_Cathode_Align_Table_Move = F_Start_Position_Move_Mode;	//	얼라인 대기 위치 동작 플래그.
					cmd"&2b2r";											// 좌표계 활성화.
		
					P_Cathode_Align_Motion_State_Machine = 1;			// 이전 스텟 머신으로 이동.
				}
				else If(P_Single_Run_Stop_Command == 1 || M_X_BTN_CMD_Auto_Stop == 1)
				{
					P_Cathode_Align_Motion_State_Machine = 0
				}
			break;
		}	
		
		// 3. 음극 얼라인 단동, 반복 움직임
		switch ( P_Anode_Align_Motion_State_Machine )
		{		
			case 1 : // 얼라인 무브 동작 활성화.
				if( P_Single_Run_Align_Timer2 > 500 )					// 딜레이 시간 확인.
				{		
					P_Single_Run_Align_Timer2 = 0;						// 타이머 초기화.
					P_Anode_Align_Stage_X_mm=5;							// 구동 위치 업데이트.
					P_Anode_Align_Stage_Y_mm=5;							// 구동 위치 업데이트.
					P_Anode_Align_Stage_T_mm=P_Align_Test_Pos;//1.5;						// 구동 위치 업데이트.
					
					P_Anode_Align_Table_Move = F_Align_Move_Mode;		//	얼라인 무브 동작 플래그.
					cmd"&3b3r";											// 좌표계 활성화.
		
					P_Anode_Align_Motion_State_Machine = 2;				// 다음 스텟 머신으로 이동.
				}
				else If(P_Single_Run_Stop_Command == 1 || M_X_BTN_CMD_Auto_Stop == 1)
				{
					P_Anode_Align_Motion_State_Machine = 0
				}

			break;
		
			case 2 : // 얼라인 대기 위치 동작 확성화.	
				if( P_Single_Run_Align_Timer2 > 500 )					// 딜레이 시간 확인.
				{
					P_Single_Run_Align_Timer2 = 0;						// 타이머 초기화.
		
					P_Anode_Align_Table_Move = F_Start_Position_Move_Mode;	//	얼라인 대기위치 동작 플래그.
					cmd"&3b3r";											// 좌표계 활성화.
		
					P_Anode_Align_Motion_State_Machine = 1;				// 이전 스텟 머신으로 이동.
				}
				else If(P_Single_Run_Stop_Command == 1 || M_X_BTN_CMD_Auto_Stop == 1)
				{
					P_Anode_Align_Motion_State_Machine = 0
				}
			break;
		}
			
		// 3. NG PNP 단동 동작, 반복 움직임		
		switch( P_NG_PNP_Uint_State_Machine )
		{
			case 1 : // 배열 업데이트.
				P_NG_PNP_Motion_Cnt = 1									// 모션 카운트 초기화.
				P_NG_PNP_Motion_arr(0) = 6								// 횟수 배열 업데이트.
				P_NG_PNP_Motion_arr(1) = N_NG_PNP_NG_To_Align_Motion	// NG Box → Align.
				P_NG_PNP_Motion_arr(2) = N_NG_PNP_Align_Down_Motion		// Align Down.
				P_NG_PNP_Motion_arr(3) = N_NG_PNP_Align_Vac				// Align Vac.
				P_NG_PNP_Motion_arr(4) = N_NG_PNP_Align_UP_Motion		// Align Up.
				P_NG_PNP_Motion_arr(5) = N_NG_PNP_Align_To_NG_Motion	// Align → NG Box.
				P_NG_PNP_Motion_arr(6) = N_NG_PNP_NG_Blow				// NG Box Blow.
				
				P_NG_PNP_Uint_State_Machine++;							// 다음 스텟 머신으로 이동.
			break;
			
			case 2 : // Cmd 실행.
				if( P_Single_Run_Unit == N_Cathode_NG_PNP_Total_Unit )	// 양극 NG PNP 선택.
				{
					P_Slave12_Motion_Command = P_NG_PNP_Motion_arr(P_NG_PNP_Motion_Cnt)	// Cmd 실행.
				}
				else if ( P_Single_Run_Unit == N_Anode_NG_PNP_Total_Unit )	// 음극 NG PNP 선택.
				{
					P_Slave13_Motion_Command = P_NG_PNP_Motion_arr(P_NG_PNP_Motion_Cnt)	// Cmd 실행.
				}
				P_NG_PNP_Motion_Cnt++									// 모션 카운트 증가.
				P_NG_PNP_Motion_arr(0)--								// 횟수 배열 감소.
				P_Single_Run_Timer = 0;									// 타이머 초기화.
				P_NG_PNP_Uint_State_Machine++;							// 다음 스텟 머신으로 이동.
			break;
			
			case 3: // Cmd 완료 확인.
				if( P_Single_Run_Timer > 500 && Motor[N_NG_PnP_CA_T].DesVelZero == 1 && Motor[N_NG_PnP_CA_Z].DesVelZero == 1 && Motor[N_NG_PnP_AN_T].DesVelZero == 1 && Motor[N_NG_PnP_AN_Z].DesVelZero == 1)	// cmd 실행 확인.
				{
					if( P_NG_PNP_Motion_arr(0) == 0 )					// 횟수 배열이 0일 경우.
					{
						P_NG_PNP_Uint_State_Machine = 1;				// 배열 업데이트.
					}
					else												// 횟수 배열이 0이 아닐 경우.
					{
						P_NG_PNP_Uint_State_Machine = 2;				// 이전 스텟 머신으로 이동.
					}
				}
				else If(P_Single_Run_Stop_Command == 1 || M_X_BTN_CMD_Auto_Stop == 1)
				{
					P_NG_PNP_Uint_State_Machine = 4
				}

			break;

			case 4 :
				if( P_Single_Run_Timer > 500 && Motor[N_NG_PnP_CA_T].DesVelZero == 1 && Motor[N_NG_PnP_CA_Z].DesVelZero == 1 && Motor[N_NG_PnP_AN_T].DesVelZero == 1 && Motor[N_NG_PnP_AN_Z].DesVelZero == 1)	// cmd 실행 확인.
				{
					if( P_NG_PNP_Motion_arr(0) == 0 )					// 횟수 배열이 0일 경우.
					{
						P_NG_PNP_Uint_State_Machine = 0;				// 배열 업데이트.
					}
				}
			break;

		}
	return

	// 8.인터락
	sub:Interlock(Unit,&Interlock_RTN)
		/*
			[양극]							[음극]						[1차 언로더]
			N_Cathode_1st_PNP_Unit 			N_Anode_1st_PNP_Unit		N_1st_UND_X			
			N_Cathode_2nd_PNP_Unit			N_Anode_2nd_PNP_Unit		N_1st_UND_Z			
			N_Cathode_1st_Picker_T			N_Anode_1st_Picker_T		N_1st_UND_T		
			N_Cathode_NG_PNP_T				N_Anode_NG_PNP_T			
			N_Cathode_NG_PNP_Z				N_Anode_NG_PNP_Z		
			N_Cathode_NG_PNP_Total_Unit		N_Anode_NG_PNP_Total_Unit
			N_Cathode_Align_Unit			N_Anode_Align_Unit
			N_Cathode_Clamp_Unit			N_Anode_Clamp_Unit		
			[파이널 롤러]					[스텍]							
			N_Finall_Roller_X_Unit			N_Stack_Table_Unit				
			N_Finall_Roller_Z_Unit			N_Sheet_Paper_Unit				
		*/
		Interlock_RTN = 0;			// 반환값 초기화.
		switch(Unit)
		{
			case N_Cathode_1st_PNP_Unit :								// 양극 1차 PNP.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ (P_Recipe_M03_POS(2)/10) )	// 양극 2차 PNP Stack 위치.
				if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ 90 )						// 양극 2차 PNP Stack 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Anode_1st_PNP_Unit :	 								// 음극 1차 PNP.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ (P_Recipe_M04_POS(2)/10) )	// 음극 2차 PNP Stack 위치.
				if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ 90 )						// 음극 2차 PNP Stack 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Cathode_2nd_PNP_Unit :								// 양극 2차 PNP.
				//if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ (P_Recipe_M12_POS(1)/10) && P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ (P_Recipe_M01_POS(1)/10) && P_Motor_Current_Pos(N_UNLOADER_Z) ~ (P_Recipe_M47_POS(2)/10) )	// 파이널 롤러 음극 위치 && 양극 1차 PNP 대기 위치 && 1차 언로더 Z축 대기 위치.
				if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ -197 && P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ 45 && P_Motor_Current_Pos(N_UNLOADER_Z) ~ 69 )	// 파이널 롤러 음극 위치 && 양극 1차 PNP 대기 위치 && 1차 언로더 Z축 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Anode_2nd_PNP_Unit :	 								// 음극 2차 PNP.
				//if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ (P_Recipe_M12_POS(2)/10) && P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ (P_Recipe_M02_POS(1)/10) )	// 파이널 롤러 양극 위치 && 음극 1차 PNP 대기 위치.
				if ( P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ 168 && P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ 45)		// 파이널 롤러 양극 위치 && 음극 1차 PNP 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.

			break;

			case N_Cathode_Clamp_Unit :									// 양극 클램프.
			case N_Anode_Clamp_Unit :									// 음극 클램프.
				//if ( P_Motor_Current_Pos(N_MAIN_Z) ~ (P_Recipe_M11_POS(x)/10) )
				if ( P_Motor_Current_Pos(N_MAIN_Z) ~ -30 )					// 워크 테이블 -30mm
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Finall_Roller_X_Unit :								// 파이널 롤러 X축.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ (P_Recipe_M03_POS(1)/10) && P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ (P_Recipe_M04_POS(1)/10) && P_Motor_Current_Pos(N_UNLOADER_X) ~ (P_Recipe_M46_POS(1)/10) && P_Motor_Current_Pos(N_UNLOADER_Z) ~ (P_Recipe_M47_POS(2)/10) )	// 양,음극 2차 PNP 대기 위치, 1차 언로더 X축,Z축 대기 위치.
				if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ 0 && P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ 0 && P_Motor_Current_Pos(N_UNLOADER_X) ~ -5.4 && P_Motor_Current_Pos(N_UNLOADER_Z) ~ 69 )	// 양,음극 2차 PNP 대기 위치, 1차 언로더 X축,Z축 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Finall_Roller_Z_Unit :								// 파이널 롤러 Z축.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ (P_Recipe_M04_POS(1)/10)  )	// 음극 2차 PNP 대기 위치.
				if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ 0 )						// 음극 2차 PNP 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Sheet_Paper_Unit :									// Sheet Paper.
					Interlock_RTN = N_FALSE;							// 구동 가능.
			break;

			case N_Cathode_NG_PNP_Total_Unit :							// 양극 NG PNP 전체.
			case N_Cathode_NG_PNP_T :									// 양극 NG PNP T축.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ (P_Recipe_M03_POS(2)/10) && P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ (P_Recipe_M01_POS(1)/10) )	// 양극 2차 PNP Stack 위치 && 양극 1차 PNP Align 위치 아닌 곳.
				if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ 90 && P_Motor_Current_Pos(N_1st_PnP_CA_T) ~ 45 )	// 양극 2차 PNP Stack 위치 && 양극 1차 PNP Align 위치 아닌 곳.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Cathode_NG_PNP_Z :									// 양극 NG PNP Z축.
					Interlock_RTN = N_FALSE;							// 구동 가능.
			break;

			case N_Anode_NG_PNP_Total_Unit :							// 음극 NG PNP 전체.
			case N_Anode_NG_PNP_T :										// 음극 NG PNP T축.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ (P_Recipe_M03_POS(2)/10) )
				//if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ (P_Recipe_M04_POS(2)/10) && P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ (P_Recipe_M02_POS(1)/10) )	// 음극 2차 PNP Stack 위치 && 음극 1차 PNP Align 위치 아닌 곳.
				if ( P_Motor_Current_Pos(N_2nd_PnP_AN_T) ~ 90 && P_Motor_Current_Pos(N_1st_PnP_AN_T) ~ 45 )	// 음극 2차 PNP Stack 위치 && 음극 1차 PNP Align 위치 아닌 곳.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Anode_NG_PNP_Z :										// 음극 NG PNP Z축.
					Interlock_RTN = N_FALSE;							// 구동 가능.
			break;

			case N_Cathode_Align_Unit :									// 양극 얼라인 테이블.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) ~ (P_Recipe_M21_POS(1)/10) )	// 양극 2차 PNP Z축 대기 위치.
				if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) ~ 24 )						// 양극 2차 PNP Z축 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Anode_Align_Unit :									// 음극 얼라인 테이블.
				//if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) ~ (P_Recipe_M22_POS(1)/10) )	// 음극 2차 PNP Z축 대기 위치.
				if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) ~ 24 )						// 음극 2차 PNP Z축 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break;

			case N_Cathode_1st_Picker_T :								// 양극 Picker T축.
					Interlock_RTN = N_FALSE;							// 구동 가능.	
			break

			case N_Anode_1st_Picker_T :									// 음극 Picker T축.							
					Interlock_RTN = N_FALSE;							// 구동 가능.	
			break;

			case N_Stack_Table_Unit :						
					Interlock_RTN = N_FALSE;							// 구동 가능.	
			break;

			case N_1st_UND_X :											// 1차 언로더 X축.
				//if ( Motor[11].MinusLimit == 1 && P_Motor_Current_Pos(N_UNLOADER_Z) ~ -9.79 )	// 워크 테이블 Z축 -Limit && 1차 언로더 Z축 스텍 진입 위치.
				//if ( Motor[11].MinusLimit == 1 && P_Motor_Current_Pos(N_UNLOADER_Z) ~ (P_Recipe_M47_POS(1)/10) && P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ (P_Recipe_M12_POS(3)/10) )	// 워크 테이블 Z축 -Limit && 1차 언로더 Z축 스텍 진입 && 파이널 롤러 배출 위치.
				if ( P789 == 1 && P_Motor_Current_Pos(N_UNLOADER_Z) ~ -9.79 && P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ -197 )	// 워크 테이블 Z축 -Limit && 1차 언로더 Z축 스텍 진입 && 파이널 롤러 배출 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break

			case N_1st_UND_Z :											// 1차 언로더 Z축.
				//if ( P_Motor_Current_Pos(N_UNLOADER_X) < (P_Recipe_M46_POS(1)/10) + 110 +  && P_Motor_Current_Pos(N_UNLOADER_T) ~ (P_Recipe_M48_POS(1)/10) )// 1차 언로더 X축 110mm 이전 && T축 대기 위치.
				if ( P_Motor_Current_Pos(N_UNLOADER_X) < 110 && P_Motor_Current_Pos(N_UNLOADER_T) ~ -2.817 )	// 1차 언로더 X축 110mm 이전 && T축 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break

			case N_1st_UND_T :											// 1차 언로더 T축.
				//if ( P_Motor_Current_Pos(N_UNLOADER_X) ~ (P_Recipe_M46_POS(1)/10) && P_Motor_Current_Pos(N_UNLOADER_Z) ~ (P_Recipe_M47_POS(2)/10) )	// 1차 언로더 X축 대기위치, Z축 대기 위치.
				if ( P_Motor_Current_Pos(N_UNLOADER_X) ~ -5.4 && P_Motor_Current_Pos(N_UNLOADER_Z) ~ 69 )			// 1차 언로더 X축 대기위치, Z축 대기 위치.
					Interlock_RTN = N_FALSE;							// 구동 가능.
				else													// 단동 시 회피 필요 기구물의 위치가 변경 될 경우.
					Interlock_RTN = N_TRUE;								// 구동 불가.
			break
		}
	return

