			P_Tact_Time_Head_Address(N_Anode_2nd_Vac) = &P_Tact_Time_Anode_2nd_PNP_Vac_Array(0);		// Tact Time 배열 P변수 주소값 업데이트.
			call Tack_Time.Transmission_Tact_Time(P_Tact_Time_Head_Address(N_Anode_2nd_Vac),P_Tack_Time_Save_Time(N_Anode_2nd_Vac))	// Tact Time 배열에 저장.
			P_Old_Tact_Time_Check(N_Anode_2nd_Vac) = 1;							// 재진입 방지.
		}
	}
	else if ( M_Y_Anode_2nd_Vac_Sol_On == 0 )
	{
		P_Tact_Time_Timer(N_Anode_2nd_Vac) = 0;									// Tact Time 타이머 초기화.
		P_Old_Tact_Time_Check(N_Anode_2nd_Vac) = 0;								// 재진입 방지.
	}
}
