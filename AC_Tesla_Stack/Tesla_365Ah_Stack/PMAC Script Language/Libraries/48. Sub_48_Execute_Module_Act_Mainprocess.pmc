	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_EPC_Judge) == F_ACT_STATUS_ENABLE )						// 이전 Command가 Enable 일 경우.
		{
			P_OLD_Module_Act_Execute_Command_Array(N_Act_EPC_Judge) = F_ACT_STATUS_INITIAL;							// 엣지 변수 초기화
		}
	}

//===========================================================================================		
// 리턴값 
//===========================================================================================	
	rtn = N_TRUE;
//===========================================================================================
	return
close



