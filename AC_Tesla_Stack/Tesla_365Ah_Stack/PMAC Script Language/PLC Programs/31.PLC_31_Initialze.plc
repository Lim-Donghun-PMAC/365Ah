P_System_Setting_Flag = 1;

open plc 31

#define	L_System_Timer				Sys.Time			// 시스템 타이머
local L_Time_Cycle_Up_Count_Start_Time;					// plc[31].Ldata.L[0] 시간 체크 시작 시간
local L_Time_Cycle_Up_Count_End_Time;					// plc[31].Ldata.L[1] 시간 체크 종료 시간
local L_Time_Cycle_Up_Count_Delta_Time;					// plc[31].Ldata.L[2] 시작과 종료 시간 사이의 시간
local L_Flag_Cycle_Up_Count_Init_Flag;					// plc[31].Ldata.L[3] 타이머 초기화 플래그

local L_Index;											// plc[31].Ldata.L[4]
local L_Ecat_Wait_Timer;								// plc[31].Ldata.L[5]
local L_Slave_Index;									// plc[31].Ldata.L[6] 슬레이브 인덱스
local L_Slave_Max_Index;								// plc[31].Ldata.L[7] 슬레이브 최대 인덱스

local L_rtn;

local L_Set_QueueSize;


////========================================================================================================================
//// 00. 다이나믹 로컬 타이머 함수	
////========================================================================================================================
//// 00.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	// 시간 체크
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}
// 시간 업데이트
if(L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{	

	L_Ecat_Wait_Timer = L_Ecat_Wait_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
////========================================================================================================================


// 가상축 모드일 경우 FatalFeLimit = 0 
local L_Num = 1;								// 모터 번호 업데이트.
#ifdef F_Virtual_Axis_Test
	while(L_Num < 50)							// 모터 번호가 50개 전일 경우.
	{
		motor[L_Num].FatalFeLimit = 0			// 모터 FalalFeLimit 초기화.
		L_Num++;								// 다음 모터로.
	}
#endif




//// System, Motor, Coord Setting

if(P_System_Setting_Flag == 1)
{
	P_System_Setting_Flag = 0;
	// Kill C Program
	system "killall -9 mc.out"; //프로세스 강제 종료

	system "killall -e Manual.out"; //이름이 정확히 일치할 때만 종료

	// Motor & Coord Setup
	Sys.CamEnable = 5;

	// 좌표계 초기값 설정
	Coord[1].TimeBaseSlew = 0.0005;
	L_Index = 1;

	while(L_Index < Sys.MaxCoords)
	{
		Coord[L_Index].TimeBaseSlew = Coord[1].TimeBaseSlew;
		Coord[L_Index].pDesTimeBase = Coord[L_Index].DesTimeBase.a;
		Coord[L_Index].DesTimeBase = Sys.ServoPeriod;
		Coord[L_Index].FeedTime = 1000;
		L_Index++;
	}

	Coord[1].SyncOps = 8192*2
	Coord[2].SyncOps = 8192*2
	Coord[3].SyncOps = 8192*2
	Coord[11].SyncOps = 8192*2
	Coord[12].SyncOps = 8192*2
	Coord[13].SyncOps = 8192*2
	Coord[14].SyncOps = 8192*2
	Coord[15].SyncOps = 8192*2
	Coord[16].SyncOps = 8192*2
	Coord[17].SyncOps = 8192*2
	Coord[18].SyncOps = 8192*2
	Coord[19].SyncOps = 8192*2
	Coord[20].SyncOps = 8192*2
	Coord[21].SyncOps = 8192*2
	Coord[22].SyncOps = 8192*2
	Coord[23].SyncOps = 8192*2
	Coord[24].SyncOps = 8192*2
	Coord[25].SyncOps = 8192*2
	Coord[26].SyncOps = 8192*2
	Coord[27].SyncOps = 8192*2
	Coord[28].SyncOps = 8192*2
	Coord[29].SyncOps = 8192*2
	Coord[30].SyncOps = 8192*2
	Coord[31].SyncOps = 8192*2
	Coord[32].SyncOps = 8192*2
	Coord[33].SyncOps = 8192*2
	Coord[34].SyncOps = 8192*2
	Coord[35].SyncOps = 8192*2
	Coord[36].SyncOps = 8192*2
	Coord[37].SyncOps = 8192*2
	Coord[38].SyncOps = 8192*2
	Coord[39].SyncOps = 8192*2
	Coord[40].SyncOps = 8192*2
	Coord[41].SyncOps = 8192*2
	Coord[4].SyncOps = 0
	Coord[5].SyncOps = 0
	Coord[6].SyncOps = 0
	Coord[7].SyncOps = 0
	Coord[8].SyncOps = 0
	Coord[9].SyncOps = 0
	Coord[10].SyncOps = 0

//	// pvt 사용 좌표계는 SegMoveTime 설정

//	// Analog I/O 설정을 왜 여기서 하는가 ?

//	// Background C App Execute
	system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/mc.out -u";
	
	call Timer.msec(10);
	
	#ifdef F_Def_Stack_A
		system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/mc.out -a";
	#else	// F_Def_Stack_B
		system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/mc.out -b";
	#endif 
	
	call Timer.msec(10);
	
	system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/Manual.out";
	
//	call Timer.msec(10);
//	//Sys_Auto_Read = 1;		// mc_protocol 자동 읽기 
//	// M_Y_to_MC_Protocol_Connected = 1; 
//	// [ 참조 : 2025.09.12 Log 추가 ]
//	//system "date -s '%d-%d-%d %d:%d:%d'", P_Log_Data_Y,P_Log_Data_M,P_Log_Data_D,P_Log_Data_H,P_Log_Data_m,P_Log_Data_s;		// PLC 현재 시간 동기화 


//	enable plc 7;
//	enable plc 0,1,2,3,4,5,6,8,9,10,12,13,14,15,17,19,21,22,23,24,25,26,28,30;
	enable plc 7;
	enable bgcplc 0;	// P_Motor_Current_Pos 업데이트 CPLC  
//	//enable rticplc;		// [ 참조 : 2025.09.12 Log 추가 ]

//	// 모듈화 고정 모드 추가 / 일반모드만 사용 - [ 참조 : 25.12.23 상태별 적용되는 모듈화의 Main Buffer Mode 업데이트 구간 추가 ]
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Exist_Insp_Module)=N_Normal_Status_Sequence;	
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Remove_NG_PNP)=N_Normal_Status_Sequence;		
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Remove_Align)=N_Normal_Status_Sequence;			
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Remove_2TR)=N_Normal_Status_Sequence;		
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Supply_1TR)=N_Normal_Status_Sequence;			
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Supply_Align)=N_Normal_Status_Sequence;			
	P_Buffer_Mode_Module_Status_Sequence(N_Hold_Supply_2TR)=N_Normal_Status_Sequence;		

//	// PNP Z축 계산 Prog -->  PMAC Power ON 됐을 시 
//	call Initialize.PNP_Z_Axis_Recipe_to_Cnt(&L_rtn);			//모터 위치 레시피에 따른 모터 카운트 계산 함수 호출	

//	//disable plc 31;
//	#ifdef  F_Virtual_Axis_Test
//	M_AI_Upper_Sepa_Sensing = N_Reel_MAX;
//	M_AI_Lower_Sepa_Sensing = N_Reel_MAX;
//	#endif

	P_Ecat_Setting_Flag = 1;
}



if(P_Ecat_Setting_Flag == 1)
{
	P_Ecat_Setting_Flag = 0;
	P_Ecat_Connect_Result = 0
	P_Ecat_Activation_State_Machine = 1;
}	

switch(P_Ecat_Activation_State_Machine)
{
	case 0 :

	break;

	case 1 :
		P_PLC31_Ecat_Retry_Cnt = 0;
		P_Ecat_Slave_Error = 0;
		P_Ecat_Activation_State_Machine++;
	break;

	case 2 :
		ECAT[0].Enable = 0;
		L_Ecat_Wait_Timer = 0;

		P_Ecat_Activation_State_Machine++;
	break;

	case 3 :	// Ecat Reset
		if(L_Ecat_Wait_Timer > 1000)
		{
			Ldata.CmdStatus = 1;
			cmd "ecat reset";
			sendallcmds
			while(Ldata.CmdStatus > 0) {}

			L_Ecat_Wait_Timer = 0;
			P_Ecat_Activation_State_Machine++;
		}
	break;

	case 4 :	// Ecat 활성화
		if(L_Ecat_Wait_Timer > 4000)
		{
			if(ECAT[0].MasterReady == 1)
			{
				ECAT[0].Enable = 1;
				L_Ecat_Wait_Timer = 0;
				P_Ecat_Activation_State_Machine++;
			}
			else
			{
				if(P_PLC31_Ecat_Retry_Cnt < 5)
				{
					P_PLC31_Ecat_Retry_Cnt++;
					P_Ecat_Activation_State_Machine = 3;
				}
				else
				{
					P_Ecat_Connect_Result = 2;			// Ecat 활성화 리트라이 횟수 초과
					P_Ecat_Activation_State_Machine = 0;
				}


			}
		}
	break;

	case 5 :	// Ecat 활성화 확인 
		//if(L_Ecat_Wait_Timer > 5000)
		//{
			if(ECAT[0].Enable == 1 && ECAT[0].MasterState == 8)
			{
				P_Ecat_Activation_State_Machine++;
			}
		//}
	break;

	case 6 :	// Slave 활성화 확인
		L_Slave_Index = 0;
		while(L_Slave_Index < N_Ecat_Slave_Max_Index)
		{
			if(ECAT[0].Slave[L_Slave_Index].State != 8)
			{
				P_Ecat_Slave_Error = L_Slave_Index;
				break;
			}
			L_Slave_Index++;
		}

		if(P_Ecat_Slave_Error != 0)
		{
			P_Ecat_Connect_Result = 3;
		}
		else
		{
			P_Ecat_Connect_Result = 1;
			P_Ecat_Activation_State_Machine = 0;
		}
	break;
}



if(P_Ecat_Connect_Result == 1)
{
	P_Ecat_Connect_Result = 0

	cmd "#*k";		// 전체 모터 킬

	#ifndef F_Def_SetUp
		// PLC 활성화 
		enable plc 0,1,2,3;
		enable plc 4,6,8,9;
		enable plc 10,12,13,14;		// 12번 모니터링 PLC 추가 , 19번 홈 PLC 추가

		enable plc 15,16,17,18,19;
		enable plc 21,23,24,28;

		enable plc 26
		//enable plc 25;				// Nand Flash Memory PLC
		enable plc 27;					//인터락 프로그램 활성화 (환경안전검수용 인터락 활성화로 인해 PLC27 상시 온)
		//enable plc 26,27;
		enable bgcplc 1;				// [ 참조 : 26.10.26 알람 리팩토링 추가 ]

		call Timer.msec(100);			// enable plc delay time
		
		#ifdef NAND_MEMORY_USE
			P_Servo_Gain_Load_Command = F_Command_Start;			// [ 이재욱 ] Nand Memory Data Load cmd
			call Timer.msec(1000);			// enable plc delay time
		#endif
		
		//260320 프로그램 다운로드 시 시트페이퍼 실린더 전진
		M_Y_First_Sheet_Paper_Plate_FWD_Sol = 1
		M_Y_First_Sheet_Paper_Plate_BWD_Sol = 0

		M_Y_FR_Clamping_Sub_Roller_Clamp = 1	
		M_Y_FR_Clamping_Sub_Roller_Unclamp = 0
		M_Y_FR_Sepa_Clamp = 1
		M_Y_FR_Sepa_UnClamp	= 0

		M_Y_Vision_Anode_Align_Ready = 1;																	// 음극 얼라인 비젼 레디 트리거 발생
		M_Y_Vision_Cathode_Align_Ready = 1;																	// 양극 얼라인 비젼 레디 트리거 발생
		M_Y_Vision_Stack_Ready = 1;																			// 스텍 테이블 비젼 레디 트리거 발생

		// [ 참조 : 26.11.18 프로그램 다운로드 시 ARC 유닛 출력 ON ]
		// ARC 해당 유닛이 회피 위치에 있을 경우 출력 ON (회피 위치에 있을 경우 출력하지 않음)
		// 상부 ARC 유닛 회피 위치
		if ( M_X_Sepa_Upper_ARC_Up_Sensor == 1 )
		{
			M_Y_Sepa_ARC_Upper_Up_Sol = 1;
			M_Y_Sepa_ARC_Upper_Dn_Sol = 0;
		}
		if ( M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front == 1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear == 1 )
		{
			M_Y_Sepa_ARC_Upper_UnTilting_Sol = 1;
			M_Y_Sepa_ARC_Upper_Tilting_Sol = 0;
		}
		if ( M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor == 1 )
		{
			M_Y_Sepa_ARC_Upper_Cutting_BWD_Sol = 1;
			M_Y_Sepa_ARC_Upper_Cutting_FWD_Sol = 0;
		}
		if ( M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor == 1 )
		{
			M_Y_Sepa_ARC_Upper_Stopper_BWD_Sol = 0;
			M_Y_Sepa_ARC_Upper_Stopper_FWD_Sol = 1;
		}
		if ( M_X_ARC_NP_Upper_Plate_Vac_On == 1 )
		{
			M_Y_Sepa_Upper_ARC_Ejector_Vac_On = 1;
			M_Y_Sepa_Upper_ARC_Ejector_Vac_Off = 0;
		}
		// 하부 ARC 유닛 회피 위치
		if ( M_X_Sepa_Lower_ARC_Dn_Sensor == 1 )
		{
			M_Y_Sepa_ARC_Lower_Up_Sol = 0;
			M_Y_Sepa_ARC_Lower_Dn_Sol = 1;
		}
		if ( M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front == 1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear == 1 )
		{
			M_Y_Sepa_ARC_Lower_UnTilting_Sol = 1;
			M_Y_Sepa_ARC_Lower_Tilting_Sol = 0;
		}
		if ( M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor == 1 )
		{
			M_Y_Sepa_ARC_Lower_Cutting_BWD_Sol = 1;
			M_Y_Sepa_ARC_Lower_Cutting_FWD_Sol = 0;
		}
		if ( M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor == 1 )
		{
			M_Y_Sepa_ARC_Lower_Stopper_BWD_Sol = 0;
			M_Y_Sepa_ARC_Lower_Stopper_FWD_Sol = 1;
		}
		if ( M_X_ARC_NP_Lower_Plate_Vac_On == 1 )
		{
			M_Y_Sepa_Lower_ARC_Ejector_Vac_On = 1;
			M_Y_Sepa_Lower_ARC_Ejector_Vac_Off = 0;
		}

		// [ 참조 : 2026.03.31 Phasing Found ABS Type ADD ]
		P_PWM_Phasing_Start(N_1st_PnP_CA_T) = N_TRUE;
		P_PWM_Phasing_Start(N_1st_PnP_AN_T) = N_TRUE;
		P_PWM_Phasing_Start(N_2nd_PnP_CA_T) = N_TRUE;
		P_PWM_Phasing_Start(N_2nd_PnP_AN_T) = N_TRUE;
	#else
		enable plc 0,12,24;//,25;

	#endif

	M_Y_Unwinder_Upper_Laser_Point = 1	
	M_Y_Unwinder_Lower_Laser_Point = 1 

	#ifndef	NAND_MEMORY_USE
		disable plc 31;
	#endif
}

#ifdef NAND_MEMORY_USE
	if( P_Servo_Gain_Load_Flag == 5 )	// complete 
	{
		P_Servo_Gain_Load_Flag = 0;
		call Timer.msec(1000);			// enable plc delay time
		P_PWM_AbsPhasePosOffset_Change_State_Machine = 1;
	}
	
	switch ( P_PWM_AbsPhasePosOffset_Change_State_Machine )
	{
		case 0 :	break;
		
		case 1 :
			if ( P_ABS_Phasing_Data(1) != 0 && P_ABS_Phasing_Data(2) != 0 && P_ABS_Phasing_Data(3) != 0 && P_ABS_Phasing_Data(4) != 0 )
			{
				if ( Motor[1].AmpEna == 0 && Motor[2].AmpEna == 0 && Motor[3].AmpEna == 0 && Motor[4].AmpEna == 0 )	// 혹시 몰라서,,,
				{
					Motor[1].AbsPhasePosOffset= -(P_ABS_Phasing_Data(1)*Motor[1].AbsPhasePosSf)%2048;
					Motor[2].AbsPhasePosOffset= -(P_ABS_Phasing_Data(2)*Motor[2].AbsPhasePosSf)%2048;
					Motor[3].AbsPhasePosOffset= -(P_ABS_Phasing_Data(3)*Motor[3].AbsPhasePosSf)%2048;
					Motor[4].AbsPhasePosOffset= -(P_ABS_Phasing_Data(4)*Motor[4].AbsPhasePosSf)%2048;
					call Timer.msec(100);
					P_PWM_AbsPhasePosOffset_Change_State_Machine ++;
				}
				else
				{
					P_PWM_AbsPhasePosOffset_Change_State_Machine = 444;
				}
			}
			else
			{
				P_PWM_AbsPhasePosOffset_Change_State_Machine = 444;
			}
		break;
	
		case 2 :
			if ( Motor[1].AbsPhasePosOffset ~ -(P_ABS_Phasing_Data(1)*Motor[1].AbsPhasePosSf)%2048 )
			{
				P_AbsPhasePosOffset_Change_Complete |= Hex_Ca_1st_Phasing_OK;
				P_PWM_Phasing_Start(N_1st_PnP_CA_T) = N_TRUE;
			}
	
			if ( Motor[2].AbsPhasePosOffset ~ -(P_ABS_Phasing_Data(2)*Motor[2].AbsPhasePosSf)%2048 )
			{
				P_AbsPhasePosOffset_Change_Complete |= Hex_An_1st_Phasing_OK;
				P_PWM_Phasing_Start(N_1st_PnP_AN_T) = N_TRUE;
			}
	
			if ( Motor[3].AbsPhasePosOffset ~ -(P_ABS_Phasing_Data(3)*Motor[3].AbsPhasePosSf)%2048 )
			{
				P_AbsPhasePosOffset_Change_Complete |= Hex_Ca_2nd_Phasing_OK;
				P_PWM_Phasing_Start(N_2nd_PnP_CA_T) = N_TRUE;
			}
	
			if ( Motor[4].AbsPhasePosOffset ~ -(P_ABS_Phasing_Data(4)*Motor[4].AbsPhasePosSf)%2048 )
			{
				P_AbsPhasePosOffset_Change_Complete |= Hex_An_2nd_Phasing_OK;
				P_PWM_Phasing_Start(N_2nd_PnP_AN_T) = N_TRUE;
			}
			P_PWM_AbsPhasePosOffset_Change_State_Machine = 999;
		break;
	
		case 444 :
			P_PWM_AbsPhasing_Fail = 1;
			disable plc 31;
		break;
	
		case 999 :
			P_PWM_AbsPhasing_Complete = 1;
			disable plc 31;
		break;
	
		default :		break;
	}
#endif



call Sub_Automation_Circular_Queue.SizeQueue(N_Circluar_Queue_UseSize,&L_Set_QueueSize); 


//disable plc 31;

close

