open plc 30

#define	L_System_Timer				Sys.Time			// 시스템 타이머
// --------------------User Code Goes Here------------------------
Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[30].ldata.L[0]	시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[30].ldata.L[1]	시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[30].ldata.L[2]	시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[30].ldata.L[3]	타이머 초기화 플래그

//test
local L_Reentry;										// Plc[30].ldata.L[4]
local L_Vac_Status_Old(5);								// Plc[30].ldata.L[5]
local L_Vision_Status_Old(10);							// Plc[30].ldata.L[6]
local L_Motor_Num;										// Plc[30].ldata.L[7]
local L_Modbus_Connect_Check_Timer;						// Plc[30].ldata.L[8]
local L_Modbus_HeartBit;								// Plc[30].ldata.L[9]
// Ecat_Reconnecting
local L_Ecat_Reconn_Slave_Index;						// Plc[30].ldata.L[10]
// MC Reconnecting
local L_MC_Protocol_MNTR_Timer;							// Plc[30].ldata.L[11]
local L_X_Trigger_1s_Cycle_HeartBit;					// Plc[30].ldata.L[12]
local L_Old_MC_Protocol_HeartBit;						// Plc[30].ldata.L[13]
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if(L_Flag_Cycle_Up_Count_Init_Flag == 0)
{
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 00.2) 시간 체크
if(L_Flag_Cycle_Up_Count_Init_Flag == 1)
{
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * 1000
	if(L_Time_Cycle_Up_Count_Delta_Time < 0)
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}
// 00.3) 시간 업데이트
if(L_Time_Cycle_Up_Count_Delta_Time > 0.1)
{
	
	//여기에 원하는 타이머 추가 
	//P_Modbus_Delay_Timer = P_Modbus_Delay_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	//L_MC_Protocol_MNTR_Timer = L_MC_Protocol_MNTR_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}

//========================================================================================================================
if( L_Motor_Num < 50 )
{
	// 모터 현재 속도
	P_VEL_Data_M(L_Motor_Num) = (Motor[L_Motor_Num].FltrVel/Sys.ServoPeriod)/16*1000
	P_POS_Data_M(L_Motor_Num) = ((Motor[L_Motor_Num].ActPos - Motor[L_Motor_Num].HomePos) / ( Motor[L_Motor_Num].PosSf ));
	//P_Motor_Current_Pos(L_Motor_Num) =	((Motor[L_Motor_Num].ActPos - Motor[L_Motor_Num].HomePos) / ( Motor[L_Motor_Num].PosSf )) / P_Axis_Scale_Value(L_Motor_Num)
	L_Motor_Num++;
}
else
{
	L_Motor_Num = 1;
}	




if( P_Vision_Status(N_Vis_Anode_Stack) == F_True && P_Vision_Status(N_Vis_Anode_Stack) != L_Vision_Status_Old(N_Vis_Anode_Stack) )
{	
	P_Vision_Status(N_Vis_Anode_Stack) = F_False;

	//P_Vision_Result(N_Vis_Anode_Run) = F_Vision_Result_Stack_NG;
	Sys_Stack_Sheet_LO_Vision_BYTE |= Hex_Stack_NG;
//	P_Stack_Table_NG_Flag = 1;
	P_Vision_Result_ &= $f0;
	P_Vision_Result_ |= $4;
}
L_Vision_Status_Old(N_Vis_Anode_Stack) = P_Vision_Status(N_Vis_Anode_Stack);

if( P_Vision_Status(N_Vis_Cathode_Stack) == F_False && P_Vision_Status(N_Vis_Cathode_Stack) != L_Vision_Status_Old(N_Vis_Cathode_Stack) )
{	
	P_Vision_Status(N_Vis_Cathode_Stack) = F_True;
	//P_Vision_Result(N_Vis_Cathode_Run) = F_Vision_Result_Stack_NG;
	Sys_Stack_Sheet_LO_Vision_BYTE |= Hex_Stack_NG;
//	P_Stack_Table_NG_Flag = 1;
	P_Vision_Result_ &= $0f;
	P_Vision_Result_ |= $40;
}
L_Vision_Status_Old(N_Vis_Cathode_Stack) = P_Vision_Status(N_Vis_Cathode_Stack);

local L_Stop_On_Old;

if( P_Stop_On == F_True && P_Stop_On != L_Stop_On_Old )
{
	P_Stop_On = F_False;
	if ( P_Master_Motion_Trigger == P_TEST_Master_Trigger_Time ) 
		P_PMAC_Commands = F_Command_Stop;
}
L_Stop_On_Old = P_Stop_On;

local L_Index = 1;
if( M_X_BTN_Machine_READY == F_True )
{
	P_Jelly_Roll_Recipe_Count = 10;
	M_X_BTN_Machine_READY = F_False;
	if( L_Reentry == 0)
	{
		P_Buffer_Mode_Status_Sequence = N_Normal_Status_Sequence;
		L_Reentry = 1;
	}
	P_PMAC_Commands = F_Command_Reset;
}	

if( M_X_BTN_Machine_START == F_True )
{	
	M_X_BTN_Machine_START = F_False;
	P_Execute_DryRun_Stop_Timer = 0;
	P_Cathode_Cur_Mode = 0;
	P_Anode_Cur_Mode = 0;	
	P_PMAC_Commands = F_Command_Start;
}	

if( M_X_BTN_Machine_STOP == F_True )
{
	//P_Execute_Manage_Mode = F_False;
	M_X_BTN_Machine_STOP = F_False;
	//P_Master_Motion_Program_Flag = F_False;
	//P_Sub_Master_Motion_Program_Flag(0),14 = F_False;
	//P_Slave_Motion_Program_Flag(0),14 = F_False;
	P_PMAC_Commands = F_Command_Stop;	// Stop로 이동.
}	


if( M_X_BTN_Machine_RESET == F_True )
{
	M_X_BTN_Machine_RESET = F_False;
	P_Anode_Count = 0;
	P_Cathode_Count = 0;
	P_Current_Mode = 0;
	P_PMAC_Homing_CHK(0),49=0;
	P_Stack_Judgement_Memory = 0;
	P_Master_Motion_Trigger = 0;
	P_Stack_Table_NG_Flag = 0;
	//P_Completion_Watch_Variable(0),N_Serach_Limit,1 = 1;
	local L_Num = 1;
	while(L_Num<50)
	{
		motor[L_Num].FatalFeLimit = 0
		L_Num++;
	}
	P_PMAC_Commands = F_Command_Clear;
}

if( P_Sepa_First_Sheet_Motion_On == F_True )
{
	P_Sepa_First_Sheet_Motion_On = F_False;
	P_Sepa_First_Sheet_Motion_StateMachine = 1;
}

switch(P_Sepa_First_Sheet_Motion_StateMachine)
{
	case 0 :
		P_Sepa_First_Sheet_Motion_Status = F_Status_IDLE;
	break;

	case 1 :
		P_Sepa_First_Sheet_Motion_Status = F_Status_EXECUTE;
		P_Slave5_Motion_Command = N_FR_Cathode_Move_Motion;
		P_Sepa_First_Sheet_Motion_StateMachine++;
	break;

	case 2 :
		if( Motor[12].DesPos - Motor[12].HomePos == 168000 )
		{
			P_Slave4_Motion_Command = N_Clamp_On_Motion;
			P_Sepa_First_Sheet_Motion_StateMachine++;
		}
	break;

	case 3 :
		if( Motor[6].DesPos - Motor[6].HomePos == 38000 )
		{
			P_Sepa_First_Sheet_Motion_StateMachine++;
			
		}
	break;

	case 4 :
		//P_Sepa_First_Sheet_Motion_StateMachine = 0;
		P_Sepa_First_Sheet_Motion_Status = F_Status_COMPLETE;
		//P_Execute_Manage_Mode = F_True;
	break;

	default :

	break;

}

