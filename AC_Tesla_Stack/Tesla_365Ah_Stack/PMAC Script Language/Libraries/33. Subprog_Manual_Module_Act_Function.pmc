		{	//파이널롤 모션 프로그램이 온이 아닐 경우 파이널롤 모션프로그램 실행 명령어 날림.
			cmd"&32b32r"
		}
		//양극 1차 Picker 모션 프로그램 온			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
		//if( Coord[29].ProgActive == 0 )
		//{	//음극 1차 Picker 모션 프로그램이 온이 아닐 경우 파이널롤 모션프로그램 실행 명령어 날림.
		//	cmd"&29b29r"
		//}
		rtn = 1;
	return

