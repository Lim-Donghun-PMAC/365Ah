					else																		// 벨트도 아니고 얼라인도 아니면
					{	
						if( P_Motor_Current_Pos(N_1st_PnP_AN_Z) >= P_Anode_1st_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
