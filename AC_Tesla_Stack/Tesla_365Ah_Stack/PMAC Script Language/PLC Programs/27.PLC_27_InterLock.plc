				//================================ 2번위치 - 클램프 위치 ================================
					// ↓ 음극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2
					//if(P_Motor_Current_Pos(N_Clamp_AN_Y2) ~ P_Recipe_M08_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2)
					// [ 참조 : 26.10.02 인터락 조건 추가 ]
					// ↓ 음극 클램프 Y축 클램프 위치 || 스택 테이블 Z축 > 대기 위치 + 0.2 || 스택 테이블 Z축 ≥ 클램프 Z축 + abs(클램프 레시피 값) ← 절대 좌표계를 맞춤 + abs(클램프 레시피 값)
					if(P_Motor_Current_Pos(N_Clamp_AN_Y2) ~ P_Recipe_M08_POS(2)||P_Motor_Current_Pos(N_MAIN_Z)>P_Recipe_M11_POS(1)+0.2||P_Motor_Current_Pos(N_MAIN_Z)>=P_Motor_Current_Pos(N_Clamp_AN_Z2)+abs(P_Recipe_M26_POS(2))+abs(P_Recipe_M26_POS(2)))
						P_No2_Recipe_Pos_IL(N_Clamp_AN_Y2) = 1;
					else
