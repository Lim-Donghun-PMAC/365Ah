// 프로그램 개정이력
//======================================================================================================
// 25.07.09 김성중 선임
// MSA 모듈화 프로그래밍 진행 - [ 참조 : 25.07.09 MSA 프로그램 신규 추가 ] 
// 25.07.28 김성중 선임 
// Cal, Cleaning 위치 이동, Align 탈착 모드 프로그래밍 진행 - [ 참조 : 25.07.28 Cal 프로그램 및 얼라인 탈착 모드 신규 추가 ] 

open subprog Subprog_Subprocess_VISION_Manual_Module(void)


// Align MSA Module Start--------------------------------------------------------------------------------------------------------------------------------
//=========================================================
//1. 얼라인 MSA Set 
//=========================================================
sub: MSA_Align_Set(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) == N_Ready_Step )														// 음극 얼라인 MSA 모드 Ready Step 
{
	if( Mode == N_MSA_Anode_Align ) // 음극 얼라인 MSA 모드일 경우
	{
		#ifdef F_Def_Stack_A // A열인 경우
		P_Modbus_A_VISION_MSA_Status = F_Status_EXECUTE	//A열 MSA 진행 중 상태 EXECUTE
		#endif

		#ifdef F_Def_Stack_B // B열인 경우
		P_Modbus_B_VISION_MSA_Status = F_Status_EXECUTE //B열 MSA 진행 중 상태 EXECUTE
		#endif

		P_Current_MSA_Run_Num(F_Anode_Align_MSA) = 0;																			// 음극 얼라인 MSA 현재 진행한 횟수 초기화
		call Manual_Module_Motor_Active.Anode_Align_MSA_Motion_Check(&P_Anode_Align_MSA_Motion_Check)									//얼라인 MSA 모터 활성화
		if ( P_Anode_Align_MSA_Motion_Check == 1)
		{
			P_Anode_Align_MSA_Motion_Check = 0;
			call Sub_Common_Function.Master_Motion_Program_On();															//마스터 모션, 서브마스터, 슬레이브 ON
		}
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) = 1;																// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align ) // 양극 얼라인 MSA 모드일 경우
	{
		#ifdef F_Def_Stack_A // A열인 경우
		P_Modbus_A_VISION_MSA_Status = F_Status_EXECUTE //A열 MSA 진행 중 상태 EXECUTE
		#endif

		#ifdef F_Def_Stack_B // A열인 경우
		P_Modbus_B_VISION_MSA_Status = F_Status_EXECUTE	//B열 MSA 진행 중 상태 EXECUTE
		#endif
		P_Current_MSA_Run_Num(F_Cathode_Align_MSA) = 0;																			// 양극 얼라인 MSA 현재 진행한 횟수 초기화
		call Manual_Module_Motor_Active.Cathode_Align_MSA_Motion_Check(&P_Cathode_Align_MSA_Motion_Check)								//얼라인 MSA 모터 활성화
		if ( P_Cathode_Align_MSA_Motion_Check == 1)																			//얼라인 MSA 모터 체크 완료 
		{
			P_Cathode_Align_MSA_Motion_Check = 0;
			call Sub_Common_Function.Master_Motion_Program_On();															//마스터 모션, 서브마스터, 슬레이브 ON
		}
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) = 1;																// 다음 스텟 머신으로 이동.
	}
	else																													
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) == 1 )												
{
	if( Mode == N_MSA_Anode_Align )	// 음극 얼라인 MSA 모드일 경우
	{
		call Manual_Module_Motor_Active.Anode_Align_MSA_Motion_ProgActive(&P_Anode_Align_MSA_Motion_ProgActive_Complete)				// 음극 얼라인 MSA 좌표계 활성화
		if ( P_Anode_Align_MSA_Motion_ProgActive_Complete == 1)																// 음극 얼라인 MSA 좌표계 활성화 완료
		{
			P_Anode_Align_MSA_Motion_ProgActive_Complete = 0;
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) = N_Complete_Step;											//다음 스텟 이동
		}
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{
		call Manual_Module_Motor_Active.Cathode_Align_MSA_Motion_ProgActive(&P_Cathode_Align_MSA_Motion_ProgActive_Complete)			// 양극 얼라인 MSA 좌표계 활성화
		if ( P_Cathode_Align_MSA_Motion_ProgActive_Complete == 1)															// 양극 얼라인 MSA 좌표계 활성화 완료
		{
			P_Cathode_Align_MSA_Motion_ProgActive_Complete = 0;
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) = N_Complete_Step;											//다음 스텟 이동
		}
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_SET) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_SET) = 1;															// 동작 완료 Bit On.
	rtn = N_COMPLETE;																										// 반환값 : COMPLETE
}
return;

//=========================================================
//2. 얼라인 MSA 모터 위치 확인
//=========================================================
sub: MSA_Motor_Pos_Chk(Mode,&rtn)
rtn = 0;
local L_individual_Anode_1st_PNP_return;
local L_individual_Anode_2nd_PNP_return;
local L_individual_Cathode_1st_PNP_return;
local L_individual_Cathode_2nd_PNP_return;
local L_individual_FR_return;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) == N_Ready_Step )											// 얼라인 MSA 모터 위치 확인 Ready Step 
{
	if( Mode == N_MSA_Anode_Align )	// 음극 얼라인 MSA 모드일 경우
	{
		if ( N_MSA_Anode_Align_Coord_Check == 1 )																			//모션 슬레이브 활성화 확인
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) = 1;												// 다음 스텟 머신으로 이동.
		}
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{
	   if ( N_MSA_Cathode_Align_Coord_Check == 1 )																			//모션 슬레이브 활성화 확인
		{
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) = 1;												// 다음 스텟 머신으로 이동.
		}
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) == 1 )
{
	if( Mode == N_MSA_Anode_Align || Mode == N_MSA_Cathode_Align )		// 음극 얼라인 MSA 모드일 경우
	{
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_1st_PNP,&P_Anode_1st_Unit_Status,&L_individual_Anode_1st_PNP_return);			//1차 PNP 대기 위치 확인 
		call Sub_Unit_Memory_Status.individual_mode(F_Anode_2nd_PNP,& P_Anode_2nd_Unit_Status,&L_individual_Anode_2nd_PNP_return);			//2차 PNP 대기 위치 확인 
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_1st_PNP,&P_Cathode_1st_Unit_Status,&L_individual_Cathode_1st_PNP_return);		//1차 PNP 대기 위치 확인
		call Sub_Unit_Memory_Status.individual_mode(F_Cathode_2nd_PNP,& P_Cathode_2nd_Unit_Status,&L_individual_Cathode_2nd_PNP_return);	//2차 PNP 대기 위치 확인
		call Sub_Unit_Memory_Status.individual_mode(F_Final_Roll,&P_FinalRoll_Unit_Status,&L_individual_FR_return);							//파이널롤 대기 위치 확인
		if ( L_individual_Anode_1st_PNP_return == 1 && L_individual_Anode_2nd_PNP_return == 1 &&L_individual_Cathode_1st_PNP_return == 1 && L_individual_Cathode_2nd_PNP_return == 1 && L_individual_FR_return == 1)
		{
			if( P_Anode_1st_Unit_Status == F_1st_PNP_Init_Up_Pos && P_Anode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_Cathode_1st_Unit_Status == F_1st_PNP_Init_Up_Pos && P_Cathode_2nd_Unit_Status == F_2nd_PNP_Align_Up_Pos && P_FinalRoll_Unit_Status == F_FR_Discharge_Pos  )	//대기 위치 확인
			{
				L_individual_Anode_1st_PNP_return = 0;
				L_individual_Anode_2nd_PNP_return = 0;
				L_individual_Cathode_1st_PNP_return = 0;
				L_individual_Cathode_2nd_PNP_return = 0;
				L_individual_FR_return = 0;
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) = N_Complete_Step;	
			}
		}
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_Motor_Pos_Check) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Motor_Pos_Check) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																								// 반환값 : COMPLETE
}
return;

//=========================================================
//3. 얼라인 MSA 1차 PNP 대기 위치 -> 벨트 이동 
//=========================================================
sub: MSA_Align_1st_Init_to_Belt_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) == N_Ready_Step )							// 얼라인 MSA 1차 PNP 대기 위치 -> 벨트 이동 Ready Step 
{
	if( Mode == N_MSA_Anode_Align )		// 음극 얼라인 MSA 모드일 경우
	{
		if( M_X_PLC_Anode_Sheet_Ready == 1 )																		//음극 극판 공급 레디 OK일 경우
		{
			P_Slave1_Motion_Command = 11;																			//음극 1차 PNP 대기->Belt 모션 커멘드
			P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) = 1;								// 다음 스텟 머신으로 이동.
		}
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{
		if( M_X_PLC_Cathode_Sheet_Ready == 1 )																		//양극 극판 공급 레디 OK일 경우
		{
			P_Slave10_Motion_Command =11;																			//양극 1차 PNP 대기->Belt 모션 커멘드 
			P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) = 1;								// 다음 스텟 머신으로 이동.
		}
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )	// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_T) < 0 + P_Motor_Ready_Pos_Inpos_200um ) //음극 1차 PNP 대기 상승 위치 확인
		{
			if ( Motor[N_1st_PnP_AN_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 																//음극 1차 PNP 속도 0 확인
			{
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) = N_Complete_Step;									// 다음 스텟 머신으로 이동.
			}
		}									
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_T) > 0 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_T) < 0 + P_Motor_Ready_Pos_Inpos_200um ) //양극 1차 PNP 대기 상승 위치 확인
		{
			if (  Motor[N_1st_PnP_CA_T].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time  ) 										//양극 1차 PNP 속도 0 확인
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) = N_Complete_Step;			// 다음 스텟 머신으로 이동.
			}
		}
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Init_to_Belt_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Init_to_Belt_Move) = 1;								// 동작 완료 Bit On.
	rtn = N_COMPLETE;																							// 반환값 : COMPLETE
}
return;

//=========================================================
//4. 얼라인 MSA 1차 PNP 벨트 하강
//=========================================================
sub: MSA_1st_PNP_Belt_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) == N_Ready_Step )							// 얼라인 MSA 1차 PNP 대기 위치 -> 벨트 이동 Ready Step
{
	if( Mode == N_MSA_Anode_Align )	 // 음극 얼라인 MSA 모드일 경우
	{
		P_Slave16_Motion_Command = 5;																			//음극 1차 PNP Belt 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave19_Motion_Command = 5;																			//양극 1차 PNP Belt 하강 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )	// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um &&  P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 1차 PNP 벨트 하강 위치 확인
		{
			if ( Motor[N_1st_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time  )  																	// 음극 1차 PNP 속도 0 확인
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) = N_Complete_Step;												// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{							
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um )	// 양극 1차 PNP 벨트 하강 위치 확인	
		{																					
			if ( Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time  )										// 양극 1차 PNP 속도 0 확인
			{																									
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) = N_Complete_Step;				// 다음 스텟 머신으로 이동.
			}
		}																													
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Belt_Down_Move) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																							// 반환값 : COMPLETE
}
return;

//=========================================================
//5. 얼라인 MSA 2차 PNP 얼라인 하강
//=========================================================
sub: MSA_2nd_PNP_Align_Down_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) == N_Ready_Step )							// 얼라인 MSA 2차 PNP 얼라인 하강 Ready Step
{
	if( Mode == N_MSA_Anode_Align )		// 음극 얼라인 MSA 모드일 경우 
	{
		P_Slave17_Motion_Command = 5;																			//음극 2차 PNP 얼라인 하강 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{
		P_Slave18_Motion_Command = 5;																			//양극 2차 PNP 얼라인 하강 모션 커멘드 
		P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) = 1;									// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우 
	{
		if ( P_Motor_Current_Pos(N_2nd_PnP_AN_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_AN_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 2차 PNP 얼라인 하강 위치 확인
		{
			if ( Motor[N_2nd_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 																		// 음극 2차 PNP 속도 0 확인
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) = N_Complete_Step;											// 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{			
		if ( P_Motor_Current_Pos(N_2nd_PnP_CA_Z) > 68.987 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_2nd_PnP_CA_Z) < 68.987 + P_Motor_Ready_Pos_Inpos_200um )	// 양극 2차 PNP 얼라인 하강 위치 확인
		{																											
			if ( Motor[N_2nd_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )											// 양극 2차 PNP 속도 0 확인
			{																										
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) = N_Complete_Step;				// 다음 스텟 머신으로 이동.
			}
		}																											
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_2nd_Align_Down_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_2nd_Align_Down_Move) = 1;									// 동작 완료 Bit On.
	rtn = N_COMPLETE;																								// 반환값 : COMPLETE
}
return;

//=========================================================
//6. 얼라인 MSA 1차 벨트 흡착 
//=========================================================
sub: MSA_Align_1st_Belt_Vacume_ON(Mode,&rtn)																		// 얼라인 MSA 1차 벨트 흡착  Ready Step
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) == N_Ready_Step )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		if( M_X_PLC_Anode_Sheet_Ready == 1 ) 
		{
			P_Slave16_Motion_Command = 13;																			//음극 1차 PNP 벨트 흡착 ON 커멘드
			P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화

			//M_Y_Anode_1st_Vac_Sol_On = 1;     
			//M_Y_Anode_1st_Vac_Sol_Off = 0;    
			//M_Y_Anode_1st_Release_Sol_On = 0; 
			//M_Y_Anode_1st_Release_Sol_Off = 1;

			//M_Y_Anode_1st_Vac_Sol_On = 1; 
			//M_Y_Anode_1st_Vac_Sol_Off = 0;																		
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) = 1;										// 다음 스텟 머신으로 이동.
		}
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우 
	{
		if( M_X_PLC_Cathode_Sheet_Ready == 1 ) 
		{
			P_Slave19_Motion_Command = 13;																			//양극 1차 PNP 벨트 흡착 ON 커멘드
			P_MSA_Chk_Pos_Timer = 0;																				//체크 타이머 초기화	

			//M_Y_Cathode_1st_Vac_Sol_On = 1;     
			//M_Y_Cathode_1st_Vac_Sol_Off = 0;    
			//M_Y_Cathode_1st_Release_Sol_On = 0; 
			//M_Y_Cathode_1st_Release_Sol_Off = 1;

			//M_Y_Cathode_1st_Vac_Sol_On = 1;
			//M_Y_Cathode_1st_Vac_Sol_Off = 0;																					
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) = 1;									// 다음 스텟 머신으로 이동
		}
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		if ( M_X_Anode_1st_PNP_Vac_Sensor == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time ) 						// 음극 1차 PNP 벨트 흡착 확인 
		{	
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) = N_Complete_Step;						// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우 
	{																														
		if ( M_X_Cathode_1st_PNP_Vac_Sensor == 1  && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time )						// 양극 1차 PNP 벨트 흡착 확인 
		{																													
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) = N_Complete_Step;						// 다음 스텟 머신으로 이동.
		}																													
	}
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Vacume_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Belt_Vacume_ON) = 1;										// 동작 완료 Bit On.
	rtn = N_COMPLETE;																								// 반환값 : COMPLETE
}
return;

