		}
	}
//=====================================================================================//
// 8) HOLD 2TR 제거 모듈  - READY STEP
//=====================================================================================//
	// 8.1.2 HOLD 2TR 제거 모듈  모듈 시퀀스 _ 동작 준비 스텝
	IF ( P_Hold_Remove_2TR_State_Machine == N_Ready_Step )
	{
		IF ( P_PLC02_HOLD_Module_Remove_2TR_Step_Flag == 1 || P_PLC02_Total_Step_Flag == 1 )
		{
			P_PLC02_HOLD_Module_Remove_2TR_Step_Flag = 0;
			// 8.1.2.0 시퀀스 Tact Time 측정.
			P_Hold_Remove_2TR_Timer = 0;
			// 8.1.2.1 시퀀스 인덱스 증가 _ 시퀀스 실행시킬 인덱스 번호 증가		
			P_Hold_Module_Error = 0;													// 초기화.
			P_Hold_Remove_2TR_Module_Status = F_Status_EXECUTE;							// HOLD 2TR 제거 모듈  진행 상태 업데이트.
			P_Hold_Remove_2TR_Seq_Index = P_Hold_Remove_2TR_Seq_Index + 1;
			P_Hold_Module_Error = 0;													// 초기화.
			// 8.1.2.2 시퀀스 겟 _ 실행시킬 동작 불러오기 
			call Sub_Hold_Automatic_Prod_Sequnce.Management_Hold_Remove_2TR(P_Buffer_Mode_Status_Sequence,P_Hold_Remove_2TR_Seq_Index,&L_Hold_Remove_2TR_Seq_Data,&P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Manage_Get_RTN))		
																
			// 8.1.2.3 시퀀스 겟 결과 _ 실행 가능 or 시퀀스 완료 or 오류 시퀀스 동작 실행 (실행 인터락 포함)
			IF ( P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Manage_Get_RTN) == N_TRUE )																													
			{
				P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Exe_Seq_RTN) = 0;

				call Sub_Hold_Automatic_Prod_Sequnce.Execute_Hold_Remove_2TR(P_Buffer_Mode_Status_Sequence, L_Hold_Remove_2TR_Seq_Data,&P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Exe_Seq_RTN) );
																																	
				IF ( P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Exe_Seq_RTN) == N_TRUE )		
				{																		
					P_Hold_Remove_2TR_State_Machine = N_Execute_Step;																									
				}		
				ELSE
				{																																		
					P_Hold_Remove_2TR_State_Machine = N_Error_Step;																						
				}
			}
			// 8.1.2.4. 시퀀스 완료 _ 시퀀스 완료
			ELSE IF ( P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Manage_Get_RTN) == N_EXCEPT )																		
			{
				P_Hold_Remove_2TR_State_Machine = N_Complete_Step;																						
			}																																	
			// 8.1.2.5 시퀀스 에러 _ 시퀀스 실행 불가능 ( 실행 인터락에 걸림 )																		  
			ELSE																																			
			{
				P_Hold_Remove_2TR_State_Machine = N_Error_Step;																							
			}	
		}	
	}
//=====================================================================================//
// 8) HOLD 2TR 제거 모듈  - EXECUTE STEP
//=====================================================================================//
	// 8.1.3. HOLD 2TR 제거 모듈  모듈 시퀀스 _ 동작 실행중 스텝
	IF ( P_Hold_Remove_2TR_State_Machine == N_Execute_Step )																						
	{	
	
		P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Pre_Seq_Complete_RTN) = 0;																					
		P_Hold_Remove_2TR_Self_Index = P_Hold_Remove_2TR_Seq_Index + 1;	
				
		Call Sub_Hold_Automatic_Prod_Sequnce.Precondition_Hold_Remove_2TR(P_Buffer_Mode_Status_Sequence,P_Hold_Remove_2TR_Self_Index,&P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Pre_Seq_Complete_RTN))		
		IF ( P_Except_Return_Array(N_PLC02_Hold_Remove_2TR_Pre_Seq_Complete_RTN) == N_TRUE )																	
		{	
			IF ( P_PMAC_Status == F_Status_STOPPING && P_HOLD_2TR_Remove_Possibility_Bit(P_Hold_Remove_2TR_Seq_Index) == N_Enable_Cycle_Stop )		// 배출 진행 중 Stopping 진행 및 정지 가능 할 경우.
			{
				P_Hold_Remove_2TR_State_Machine = N_Error_Step;						// 에러스텝 이동.()
			}
			ELSE
			{
				P_Hold_Remove_2TR_Tact_Time_Array(P_Hold_Remove_2TR_Seq_Index) = P_Hold_Remove_2TR_Timer;															// HOLD 2TR 제거 모듈  시퀀스 Tact Time 업데이트.
				P_Hold_Remove_2TR_Tact_Time_Array(0) = P_Hold_Remove_2TR_Tact_Time_Array(0) + P_Hold_Remove_2TR_Tact_Time_Array(P_Hold_Remove_2TR_Seq_Index);		// HOLD 2TR 제거 모듈  시퀀스 총 Tact Time 업데이트.
				P_Hold_Remove_2TR_State_Machine = N_Ready_Step;																						
			}
		}
		IF ( P_PMAC_Status == F_Status_STOPPING && P_HOLD_2TR_Remove_Possibility_Bit(P_Hold_Remove_2TR_Seq_Index) == N_Enable_Cycle_Stop )		// 배출 진행 중 Stopping 진행 및 정지 가능 할 경우.
		{
			P_Hold_Remove_2TR_State_Machine = N_Error_Step;		
		}		
		IF ( P_Hold_Module_Error != 0 )											// 액팅 모듈 중 Error 처리가 될 경우. (TimeOut, 스탑 포인트)		[ 참조 : 26.01.08 Hold 모듈 수정 ]
		{
			P_Hold_Remove_2TR_State_Machine = N_Error_Step;								// 모듈 정지.
		}	
	}

//=====================================================================================//
// 8) HOLD 2TR 제거 모듈  - Complte STEP
//=====================================================================================//
	// 8.1.4 HOLD 2TR 제거 모듈  모듈 시퀀스 _ 동작 완료 스텝
	IF ( P_Hold_Remove_2TR_State_Machine == N_Complete_Step )
	{
		P_EXECUTE_Status_Prod_Sequence(N_Hold_Remove_2TR) = F_Status_COMPLETE;			// HOLD 2TR 제거 모듈  모듈 상태 변경 _ 완료
		P_Hold_Remove_2TR_Module_Status = F_Status_COMPLETE;							// HOLD 2TR 제거 모듈  진행 상태 업데이트.
		P_Hold_Remove_2TR_Status = N_NoValue;											// HOLD 2TR 제거 모듈  기능 off
		P_Hold_Remove_2TR = 0;															// HOLD 2TR 제거 모듈 - 시퀀스 모듈 실행 확인 (사이클 정지에서 확인) (모듈 끝 : 0, 모듈 시작 : 1)	[ 참조 : 26.01.08 Hold 모듈 수정 ]
		P_Hold_Remove_2TR_State_Machine = 0;											// HOLD 2TR 제거 모듈  스텝 초기화
	}
//=====================================================================================//
// 8) HOLD 2TR 제거 모듈  - Error STEP
//=====================================================================================//
	// 8.1.5 HOLD 2TR 제거 모듈  모듈 시퀀스 _ 에러 처리 스텝
	IF ( P_Hold_Remove_2TR_State_Machine == N_Error_Step )
	{
		P_EXECUTE_Status_Prod_Sequence(N_Hold_Remove_2TR) = F_Status_ABORTED;			// HOLD 2TR 제거 모듈 상태 변경 _ 어볼트
		P_PMAC_Commands = F_Command_Stop;												// Commands Stop 발생.
		P_Stop_Cmd_Origin = 55
		P_Hold_Remove_2TR_Module_Status = F_Status_STOPPED;								// 2TR 진행 상태 업데이트.
		P_Hold_Remove_2TR_Status = N_FALSE;												// 기능 실패
		P_Hold_Remove_2TR = 0;															// HOLD 2TR 제거 모듈 - 시퀀스 모듈 실행 확인 (사이클 정지에서 확인) (모듈 끝 : 0, 모듈 시작 : 1)	[ 참조 : 26.01.08 Hold 모듈 수정 ]
		P_Hold_Remove_2TR_State_Machine = 0;											// 스텝 초기화
	}
}
ELSE
{
	P_Hold_Remove_2TR_State_Machine = 0;												// HOLD 2TR 제거 모듈  시퀀스 초기화
}

//========================================================================================================================================================
// 9) HOLD - 1TR 공급 모듈 
//========================================================================================================================================================
// 9.1 HOLD 1TR 공급 모듈   구동 시퀀스 - TRUE 일 경우 실행
IF ( P_Hold_Supply_1TR_Status == N_TRUE )							
{
	// 9.1.1 HOLD 1TR 공급 모듈  시퀀스 발생 변수
	IF ( L_Hold_Supply_1TR_Command_Occurs == 1 )							
	{		
		// 9.1.1.1) HOLD Align 제거 모듈  인덱스 초기화 
		P_Hold_Supply_1TR_Seq_Index = 0;										
		P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Set_Seq_Occurs_RTN) = 0;	

		// 9.1.1.2) 현재 모드에 맞는 배열값 셋
		call Sub_Hold_Automatic_Prod_Sequnce.Set_Hold_Supply_1TR(P_Buffer_Mode_Status_Sequence,&P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Set_Seq_Occurs_RTN))	 
		IF ( P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Set_Seq_Occurs_RTN) == N_TRUE )
		{
			L_Hold_Supply_1TR_Command_Occurs = 0;						// 커맨드 초기화
			P_Hold_Supply_1TR_Tact_Time_Array(0),20 = 0;				// HOLD 1TR 공급 모듈  시퀀스 총 Tact Time 초기화.	
			P_Hold_Supply_1TR_State_Machine = N_Ready_Step;				// HOLD 1TR 공급 모듈  구동 준비 스텝으로 이동		
		}
		// 9.1.1.3) 리턴값 오류시 - Error Step 이동
		ELSE
		{
			L_Hold_Supply_1TR_Command_Occurs = 0;						// HOLD 1TR 공급 모듈  커맨드 초기화
			P_Hold_Supply_1TR_State_Machine = N_Error_Step;				// HOLD 1TR 공급 모듈  모듈 구동 준비 스텝으로 이동
		}
	}
//=====================================================================================//
// 9) HOLD 1TR 공급 모듈  - READY STEP
//=====================================================================================//
	// 9.1.2 HOLD 1TR 공급 모듈  모듈 시퀀스 _ 동작 준비 스텝
	IF ( P_Hold_Supply_1TR_State_Machine == N_Ready_Step )
	{
		IF ( P_PLC02_HOLD_Module_Supply_1TR_Step_Flag == 1 || P_PLC02_Total_Step_Flag == 1 )
		{
			P_PLC02_HOLD_Module_Supply_1TR_Step_Flag = 0;
			// 9.1.2.0 시퀀스 Tact Time 측정.
			P_Hold_Supply_1TR_Timer = 0;
			// 9.1.2.1 시퀀스 인덱스 증가 _ 시퀀스 실행시킬 인덱스 번호 증가		
			P_Hold_Module_Error = 0;													// 초기화.
			P_Hold_Supply_1TR_Module_Status = F_Status_EXECUTE;							// HOLD 1TR 공급 모듈  진행 상태 업데이트.
			P_Hold_Supply_1TR_Seq_Index = P_Hold_Supply_1TR_Seq_Index + 1;
			// 9.1.2.2 시퀀스 겟 _ 실행시킬 동작 불러오기 
			call Sub_Hold_Automatic_Prod_Sequnce.Management_Hold_Supply_1TR(P_Buffer_Mode_Status_Sequence,P_Hold_Supply_1TR_Seq_Index,&L_Hold_Supply_1TR_Seq_Data,&P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Manage_Get_RTN))		
																
			// 9.1.2.3 시퀀스 겟 결과 _ 실행 가능 or 시퀀스 완료 or 오류 시퀀스 동작 실행 (실행 인터락 포함)
			IF ( P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Manage_Get_RTN) == N_TRUE )																													
			{
				P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Exe_Seq_RTN) = 0;

				call Sub_Hold_Automatic_Prod_Sequnce.Execute_Hold_Supply_1TR(P_Buffer_Mode_Status_Sequence, L_Hold_Supply_1TR_Seq_Data,&P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Exe_Seq_RTN) );
																																	
				IF ( P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Exe_Seq_RTN) == N_TRUE )		
				{																		
					P_Hold_Supply_1TR_State_Machine = N_Execute_Step;																									
				}		
				ELSE
				{																																		
					P_Hold_Supply_1TR_State_Machine = N_Error_Step;																						
				}
			}
			// 9.1.2.4. 시퀀스 완료 _ 시퀀스 완료
			ELSE IF ( P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Manage_Get_RTN) == N_EXCEPT )																		
			{
				P_Hold_Supply_1TR_State_Machine = N_Complete_Step;																						
			}																																	
			// 9.1.2.5 시퀀스 에러 _ 시퀀스 실행 불가능 ( 실행 인터락에 걸림 )																		  
			ELSE																																			
			{
				P_Hold_Supply_1TR_State_Machine = N_Error_Step;																							
			}	
		}	
	}
//=====================================================================================//
// 9) HOLD 1TR 공급 모듈  - EXECUTE STEP
//=====================================================================================//
	// 9.1.3. HOLD 1TR 공급 모듈  모듈 시퀀스 _ 동작 실행중 스텝
	IF ( P_Hold_Supply_1TR_State_Machine == N_Execute_Step )																						
	{	
	
		P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Pre_Seq_Complete_RTN) = 0;																					
		P_Hold_Supply_1TR_Self_Index = P_Hold_Supply_1TR_Seq_Index + 1;	
				
		Call Sub_Hold_Automatic_Prod_Sequnce.Precondition_Hold_Supply_1TR(P_Buffer_Mode_Status_Sequence,P_Hold_Supply_1TR_Self_Index,&P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Pre_Seq_Complete_RTN))		
		IF ( P_Except_Return_Array(N_PLC02_Hold_Supply_1TR_Pre_Seq_Complete_RTN) == N_TRUE )																	
		{	
			IF ( P_PMAC_Status == F_Status_STOPPING && P_HOLD_1TR_Supply_Possibility_Bit(P_Hold_Supply_1TR_Seq_Index) == N_Enable_Cycle_Stop )		// 배출 진행 중 Stopping 진행 및 정지 가능 할 경우.
			{
				P_Hold_Supply_1TR_State_Machine = N_Error_Step;						// 에러스텝 이동.()
			}
			ELSE
			{
				P_Hold_Supply_1TR_Tact_Time_Array(P_Hold_Supply_1TR_Seq_Index) = P_Hold_Supply_1TR_Timer;																// HOLD 1TR 공급 모듈  시퀀스 Tact Time 업데이트.
				P_Hold_Supply_1TR_Tact_Time_Array(0) = P_Hold_Supply_1TR_Tact_Time_Array(0) + P_Hold_Supply_1TR_Tact_Time_Array(P_Hold_Supply_1TR_Seq_Index);		// HOLD 1TR 공급 모듈  시퀀스 총 Tact Time 업데이트.
				P_Hold_Supply_1TR_State_Machine = N_Ready_Step;																						
			}
		}	
		IF ( P_PMAC_Status == F_Status_STOPPING && P_HOLD_1TR_Supply_Possibility_Bit(P_Hold_Supply_1TR_Seq_Index) == N_Enable_Cycle_Stop )		// 배출 진행 중 Stopping 진행 및 정지 가능 할 경우.
		{				
			P_Hold_Supply_1TR_State_Machine = N_Error_Step;						// 에러스텝 이동.()
		}
		IF ( P_Hold_Module_Error != 0 )											// 액팅 모듈 중 Error 처리가 될 경우. (TimeOut, 스탑 포인트)		[ 참조 : 26.01.08 Hold 모듈 수정 ]
		{			
			P_Hold_Supply_1TR_State_Machine = N_Error_Step;								// 모듈 정지.
		}
	}

//=====================================================================================//
// 9) HOLD 1TR 공급 모듈  - Complte STEP
//=====================================================================================//
	// 9.1.4 HOLD 1TR 공급 모듈  모듈 시퀀스 _ 동작 완료 스텝
	IF ( P_Hold_Supply_1TR_State_Machine == N_Complete_Step )
	{
		P_EXECUTE_Status_Prod_Sequence(N_Hold_Supply_1TR) = F_Status_COMPLETE;			// HOLD 1TR 공급 모듈  모듈 상태 변경 _ 완료
		P_Hold_Supply_1TR_Module_Status = F_Status_COMPLETE;							// HOLD 1TR 공급 모듈  진행 상태 업데이트.
		P_Hold_Supply_1TR_Status = N_NoValue;											// HOLD 1TR 공급 모듈  기능 off
		P_Hold_Supply_1TR = 0;															// HOLD 1TR 공급 모듈 - 시퀀스 모듈 실행 확인 (사이클 정지에서 확인) (모듈 끝 : 0, 모듈 시작 : 1)	[ 참조 : 26.01.08 Hold 모듈 수정 ]
		P_Hold_Supply_1TR_State_Machine = 0;											// HOLD 1TR 공급 모듈  스텝 초기화
	}
//=====================================================================================//
// 9) HOLD 1TR 공급 모듈  - Error STEP
//=====================================================================================//
	// 9.1.5 HOLD 1TR 공급 모듈  모듈 시퀀스 _ 에러 처리 스텝
	IF ( P_Hold_Supply_1TR_State_Machine == N_Error_Step )
	{
		P_EXECUTE_Status_Prod_Sequence(N_Hold_Supply_1TR) = F_Status_ABORTED;			// HOLD 1TR 공급 모듈 상태 변경
		P_PMAC_Commands = F_Command_Stop;												// Commands Stop 발생.	
		P_Stop_Cmd_Origin = 24
		P_Hold_Supply_1TR_Module_Status = F_Status_STOPPED;								// 1TR 공급 진행 상태 업데이트.
		P_Hold_Supply_1TR_Status = N_FALSE;												// 기능 실패
		P_Hold_Supply_1TR = 0;															// HOLD 1TR 공급 모듈 - 시퀀스 모듈 실행 확인 (사이클 정지에서 확인) (모듈 끝 : 0, 모듈 시작 : 1)	[ 참조 : 26.01.08 Hold 모듈 수정 ]
		P_Hold_Supply_1TR_State_Machine = 0;											// 스텝 초기화
	}
}
ELSE
{
	P_Hold_Supply_1TR_State_Machine = 0;												// HOLD 1TR 공급 모듈  시퀀스 초기화
}

