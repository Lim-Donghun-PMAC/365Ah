			if ( P_C_2nd_PNP_BWD_Abort_Calc_Bit == 1 && (P_C_2nd_PNP_BWD_Abort_Use_Bit | P_PNP_Abort_Use_Total_Bit))
			{
				// 1) 1차 P&P 전진 현재 위치, 속도 업데이트.
				P_C_2nd_PNP_BWD_Cur_Pos = (Motor[N_C_2nd_PNP_M_Num].ActPos - Motor[N_C_2nd_PNP_M_Num].HomePos) / N_Time_Scale;		// 현재 위치(mm).
				P_C_2nd_PNP_BWD_Cur_Vel = abs(Motor[N_C_2nd_PNP_M_Num].DesVel / Sys.ServoPeriod);		// 현재 속도(mm/s).
