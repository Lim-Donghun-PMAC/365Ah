// Modbus Program==================================================================================================
// [ 참조 : 2025.08.18 Modbus Reconnecting ]
/*
#ifdef F_Def_Stack_B
// Slave 모니터용
//local L_Modbus_HeartBit;
//local L_Modbus_Connect_Check_Timer;

// B열 상태 A열 Write값 넣어주기
 P_Modbus_B_Connect_State	= N_Modbus_Enable;
 P_Modbus_B_PMAC_Cur_Mode	= P_PMAC_Current_Mode;
 P_Modbus_B_PMAC_Cur_Status	= P_PMAC_Status;
 P_Modbus_B_Anode_1st_Pos	= F_Anode_1st_T_Axis;
 P_Modbus_B_Cathode_1st_Pos	= F_Cathode_1st_T_Axis;
 P_Modbus_B_All_Home_Status = P_AH_Home_Status;
 P_Modbus_B_VISION_MSA_Status = P_VISION_MSA_Status;
 P_Modbus_B_Anode_1st_HCK	= N_1st_PnP_AN_T_Home_Chk;
 P_Modbus_B_Cathode_1st_HCK	= N_1st_PnP_CA_T_Home_Chk;

call Modbus_Interface.ReadData();	
call Modbus_Interface.WriteData();

// ↓ 실제 장비 생기면 사라질 구문 ===================================================================================
call Modbus_Interface.Debug_Pos_WriteData();

p8000 = P_PMAC_Status;
p8001 = P_Current_Mode;
p8002 = P_Master_Motion_Trigger;
p8003 = (Sys_Cathode_NG_Place_Sheet_LO_Vision_BYTE&128/128)<<9 + (Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE&128/128)<<8 + (Sys_Cathode_2nd_Sheet_LO_Vision_BYTE&128/128)<<7 + (Sys_Cathode_Align_Sheet_LO_Vision_BYTE&128/128)<<6 + (Sys_Cathode_1st_Sheet_LO_Vision_BYTE&128/128)<<5 + (Sys_Anode_NG_Place_Sheet_LO_Vision_BYTE&128/128)<<4 + (Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE&128/128)<<3 + (Sys_Anode_2nd_Sheet_LO_Vision_BYTE&128/128)<<2 + (Sys_Anode_Align_Sheet_LO_Vision_BYTE&128/128)<<1 + (Sys_Anode_1st_Sheet_LO_Vision_BYTE&128/128)<<0;
//==================================================================================================================

// ===== Slave 모니터링 =============================================================================================
if ( P_Modbus_HeartBit != L_Modbus_HeartBit )											// 모드버스 heart bit != 이전 모드버스 하트비트 값
{
    L_Modbus_HeartBit = P_Modbus_HeartBit;												// 값 넣어줌
    L_Modbus_Connect_Check_Timer  = Sys.Time;											// 현재 시간 저장
	//P_Modbus_Reconnect_MNTR = 0;														// 모니터링 변수 초기화
    P_Modbus_Connect_Status = F_Status_EXECUTE;											// 모드버스 커넥트 상태 = Execute
}
else if ( (Sys.Time - L_Modbus_Connect_Check_Timer) > 5.0 )								// 모드버스 하트비트 = 이전 모드버스 하트비트 
{			//	↑ 5초 이상 요청 없음
     P_Modbus_Connect_Status = F_Status_STOPPED;										// 모드버스 커넥트 상태 = Stopped										
}

if( P_Modbus_Connect_Status == F_Status_STOPPED && P_Modbus_Delay_Timer > 5000 )		// 모드벼스 커넥트 상태가 Stopped이며 딜레이타임 5초 초과라면
{
	P_Modbus_Connected_Flag = 0;														// 모드 버스 커넥트
	call Modbus_Interface.ModBus_Connect();												// 모드버스 연결 함수 호출
	P_Modbus_Delay_Timer = 0;															// 딜레이 타이머 초기화
	P_Modbus_Reconnect_MNTR++;															// 모니터링 변수 증가
}

// ===== Master Heart Bit =============================================================================================
#else	// Master Modbus Heartbit ( A열 )
// [ 참조 : 2025.08.18 Modbus Reconnecting ]
if( P_Modbus_Delay_Timer >= 500 )														// A열 ( 마스터 or 서버 ) 500ms 주기마다
{
	P_Modbus_HeartBit ^= 1;																// 하트비트 
	P_Modbus_Delay_Timer = 0;															// 딜레이 타이머 초기화
}

// A열 상태 B열 Read값 넣어주기
 P_Modbus_A_Connect_State	= N_Modbus_Enable;
 P_Modbus_A_PMAC_Cur_Mode	= P_PMAC_Current_Mode;
 P_Modbus_A_PMAC_Cur_Status	= P_PMAC_Status;
 P_Modbus_A_Anode_1st_Pos	= F_Anode_1st_T_Axis;
 P_Modbus_A_Cathode_1st_Pos	= F_Cathode_1st_T_Axis;
 P_Modbus_A_All_Home_Status = P_AH_Home_Status;
 P_Modbus_A_VISION_MSA_Status = P_VISION_MSA_Status;
 P_Modbus_A_Anode_1st_HCK =	N_1st_PnP_AN_T_Home_Chk;
 P_Modbus_A_Cathode_1st_HCK = N_1st_PnP_CA_T_Home_Chk;

#endif

//=======================================================================================================//
// Ecat_Reconnecting Program //	[ 참조 : 25.09.12 Ecat Reconnecting Program 추가 ]
//=======================================================================================================//
if ( P_PMAC_Current_Mode == F_Current_Manual )								// 매뉴얼 상태.
{
	if ( P_EtherCat_Active_Status != F_Status_EXECUTE )						// 이더캣 활성화 진행 중이 아닐 경우.
	{
		if ( P_Ecat_Reconn_Bit == 1 && P_Old_Ecat_Reconn_Bit == 0 )			// 버튼을 누를 경우.
			P_Ecat_Reconn_Cmd_Flag = 1;										// 이더캣 활성화 플래그 발생.
	}
}
else
{
	P_EtherCat_Active_Status = 0;											// 이더캣 활성화 상태 초기화.
	P_Ecat_Reconn_State_Machine = 0;										// 어더캣 활성화 스텟머신 초기화.
	// 버튼 상태 UI 초기화.
}
P_Old_Ecat_Reconn_Bit = P_Ecat_Reconn_Bit									// 버튼 Edge 값 업데이트.

if ( P_Ecat_Reconn_Cmd_Flag == 1 )											// 이더캣 활성화 플래그.
{
	P_Ecat_Reconn_Cmd_Flag = 0;												// 재진입 방지.
	P_Ecat_Reconn_State_Machine = 1;										// 이더캣 활성화 스텟머신 실행.
}
//=======================================================================================================
// 이더캣 활성화 실행부 
//=======================================================================================================
switch ( P_Ecat_Reconn_State_Machine )										// 이더캣 활성화 스텟머신 실행 
{
	case 1 :// ECAT 비활성화 저장.
		P_Ecat_Reconn_Error_Buffer(0),Slave_Buffer_Index = 0;				// 이더캣 활성화 버퍼 초기화.
		L_Ecat_Reconn_Slave_Index = 0;										// Slave Index 초기화.
		P_Ecat_Reconn_Record_Cnt = 0;										// 이더캣 Slave 기록 Cnt 초기화.
		while(L_Ecat_Reconn_Slave_Index < Slave_Max_Index)					// Slave Index가 Max Index보다 작을 경우.
		{
			if ( ECAT[0].Slave[L_Ecat_Reconn_Slave_Index].State != 8 )		// Ecat Slave 비활성화 일 경우.
			{
				P_Ecat_Reconn_Error_Buffer(P_Ecat_Reconn_Record_Cnt) = L_Ecat_Reconn_Slave_Index;	// 이더캣 비활성화 Error 버퍼에 저장.
				P_Ecat_Reconn_Record_Cnt++;									// 이더캣 Slave 기록 Cnt 증가.
				L_Ecat_Reconn_Slave_Index++;								// Slave Index 증가.
			}
			else if ( ECAT[0].Slave[L_Ecat_Reconn_Slave_Index].State == 8 )	// 이더캣 활성화 일 경우.
				L_Ecat_Reconn_Slave_Index++;								// Slave Index 증가.
		}
		P_Ecat_Reconn_State_Machine++;										// 다음 스텟 머신으로 이동.
	break;


	case 2 :// ECAT 활성화 전 초기화.
		P_EtherCat_Active_Status = F_Status_EXECUTE;						// 이더캣 활성화 상태 업데이트.
		P_Ecat_Reconn_Time_Out_Timer =  Sys.Time;							// 이더캣 활성화 타임 아웃 체크 타이머.
		kill 33..48;														// 이더캣 모터 KILL.
		P_Ecat_Reconn_Active_Complete_Bit = 0;								// 이더캣 활성화 완료 비트 초기화.
		P_Ecat_Reconn_Active_Fail_Bit = 0;									// 이더캣 활성화 에러 비트 초기화.
		P_Ecat_Reconn_Time_Out_Bit = 0;										// 이더캣 활성화 타임 아웃 비트 초기화.
		P_Ecat_ReTry_Cnt = 0;												// 이더캣 활성화 재시도 카운트.
		P_Ecat_Reconn_Slave_Error_Bit = 0;									// 이더캣 Slave 활성화 애러 비트 초기화.
		L_Ecat_Reconn_Slave_Index = 0;										// 이더캣 Slave 활성화 인덱스 초기화.
		P_Ecat_Reconn_State_Machine_Buffer = 1;								// 이더캣 활성화 스텟머신 버퍼.
		P_Ecat_Reconn_State_Machine++;										// 다음 스텟 머신으로 이동.
	break;

	case 3 :// ECAT 연결 비활성화.
		ECAT[0].Enable = 0;  												// Disable ECAT
		P_Ecat_Active_Timer = Sys.Time;										// 이더캣 활성화 타이머 업데이트.
		P_Ecat_Disable_Delay_Time = P_Delay_Time;							// 2초 딜레이.
		P_Ecat_Reconn_State_Machine_Buffer = 2;								// 이더캣 활성화 스텟머신 버퍼.
		P_Ecat_Reconn_State_Machine++;										// 다음 스텟 머신으로 이동.
	break;
	
	case 4 :// ECAT Slave 재설정.
		P_Ecat_Reconn_State_Machine_Buffer = 3;								// 이더캣 활성화 스텟머신 버퍼.
		if ( ECAT[0].Enable == 0 && ECAT[0].MasterState != 8 && Sys.Time >= P_Ecat_Active_Timer + P_Ecat_Disable_Delay_Time )	//2초 딜레이 & Disable ECAT 확인		
		{
			cmd "ecat reset";												// ecat reset 실행.			
			P_Ecat_Active_Timer = Sys.Time;									// 이더캣 활성화 타이머 업데이트.
			P_Ecat_Reconn_State_Machine++;									// 다음 스텟 머신으로 이동.
		}
	break;
	
	case 5 :// ECAT Slave 재설정 완료 확인.
		P_Ecat_Reconn_State_Machine_Buffer = 4;								// 이더캣 활성화 스텟머신 버퍼.
		if ( Sys.Time >= P_Ecat_Active_Timer + P_Ecat_Reset_Delay_Time )	// 15초 딜레이 이후.
		{	
			if ( ECAT[0].MasterReady == 1 ) 								// ecat reset 완료 상태 확인. (1 : 미완료)
			{		
				Ecat[0].Enable = 1;  										// ECAT Network Activation		
				P_Ecat_Active_Timer = Sys.Time;								// 이더캣 활성화 타이머 업데이트.
				P_Ecat_ReTry_Cnt = 0;										// 이더캣 활성화 재시도 카운트.			
				P_Ecat_Reconn_State_Machine++;								// 다음 스텟 머신으로 이동.
			}				
			else 															// 타이머 이후에도 초기화 진행 중 상태라면
			{	
				if( P_Ecat_ReTry_Cnt < P_Ecat_ReTry_Limit )					// 리밋 카운트 미만 일 경우.
				{	
					P_Ecat_ReTry_Cnt++;										// 이더캣 활성화 재시도 카운트 증가.											
					P_Ecat_Active_Timer = Sys.Time;							// 이더캣 활성화 타이머 업데이트.
					P_Ecat_Disable_Delay_Time = 0;							// 딜레이 제거.
					P_Ecat_Reconn_State_Machine = 4;						// ecat reset 재시도.
				}
				else
					P_Ecat_Reconn_State_Machine = N_Error_Step;				// 활성화 에러 스텝 이동.
			}	
		}			
	break;
	
	case 6 :// ECAT 활성화 확인.
		P_Ecat_Reconn_State_Machine_Buffer = 5;								// 이더캣 활성화 스텟머신 버퍼.
		if(  Sys.Time <= P_Ecat_Active_Timer + P_Ecat_Active_Delay_Time )	// 15초 딜레이 이후. 
		{ // DelayTime 내
			if ( ECAT[0].Enable == 1 && ECAT[0].MasterState == 8 ) 			// 이더캣 활성화 상태 확인.
				P_Ecat_Reconn_State_Machine++;								// 다음 스텟 머신으로 이동.
		}
		else																// 딜레이 시간이 넘을 경우.
			P_Ecat_Reconn_State_Machine = N_Error_Step;						// 활성화 에러 스텝 이동
	break;
	
	case 7 :// Slave 활성화 확인.
		P_Ecat_Reconn_State_Machine_Buffer = 6;								// 이더캣 활성화 스텟머신 버퍼.
		while(L_Ecat_Reconn_Slave_Index < Slave_Max_Index)					// 이더캣 슬레이브 인덱스 확인.
		{
			if( ECAT[0].Slave[L_Ecat_Reconn_Slave_Index].State != 8 )		// 이더캣 슬레이브 정상 상태가 아니라면
			{ 
				P_Ecat_Reconn_Slave_Error_Bit = 1;							// 이더캣 에러 비트 On.
				P_Ecat_Reconn_Error_Slave_Index = L_Ecat_Reconn_Slave_Index;// 이더캣 슬레이브 비활성화 인덱스 저장.
				break;														// while문 탈출.
			}
			else															// 이더캣 정상 상태면 다음 슬레이브 검색.
				L_Ecat_Reconn_Slave_Index++;								// 이더캣 슬레이브 인덱스 증가.		
		}	
		if ( P_Ecat_Reconn_Slave_Error_Bit == 1 )							// 에러 비트가 발생된다면.
			P_Ecat_Reconn_State_Machine = N_Error_Step;						// 활성화 에러 스텝 이동.
		else
		{
			P_EtherCat_Active_Status = F_Status_COMPLETE;					// 이더캣 활성화 스텝 상태.
			kill 33..48;													// 이더캣 모터 KILL.
			P_Ecat_Reconn_State_Machine = N_Complete_Step;					// 완료 스텝 이동.
		}
	break;
	
	case N_Complete_Step :													// 활성화 완료 스텝.
		P_Ecat_Reconn_State_Machine_Buffer = N_Complete_Step;				// 이더캣 활성화 스텟머신 버퍼.
		P_Ecat_Reconn_Active_Complete_Bit = 1;								// 활성화 완료 비트 전달.
	break;
	
	case N_Error_Step :														// 활성화 실패 스텝. 
		P_Ecat_Reconn_State_Machine_Buffer = N_Error_Step;					// 이더캣 활성화 스텟머신 버퍼.
		P_Ecat_Reconn_Active_Fail_Bit = 1;									// 활성화 에러 비트 전달.
	break;
}

if ( P_Ecat_Reconn_Active_Complete_Bit == 1 )								// 이더캣 활성화 완료.
{
	P_Ecat_Reconn_Active_Complete_Bit = 0;									// 재진입 방지.
	P_EtherCat_Active_Status = 0;											// 이더캣 활성화 상태 초기화.
	P_Ecat_Reconn_State_Machine = 0;										// 활성화 스텟머신 초기화.
	// 버튼 램프 초기화.
	P_Ecat_Reconn_Bit_MNT = 1;												// 이더캣 활성화 상태 모니터 업데이트.
}

if ( P_Ecat_Reconn_Active_Fail_Bit == 1 || P_Ecat_Reconn_Time_Out_Bit == 1 )// 이더캣 실패 || 타임 아웃.
{
	if ( P_Ecat_Reconn_Active_Fail_Bit )									// 이더캣 활성화 실패 일 경우.
		P_Ecat_Reconn_Bit_MNT = 2;											// 이더캣 활성화 상태 모니터 업데이트.
	else																	// 이더캣 활성화 타임 아웃 일 경우.
		P_Ecat_Reconn_Bit_MNT = 3;											// 이더캣 활성화 상태 모니터 업데이트.
	P_Ecat_Reconn_Active_Fail_Bit = 0;										// 재진입 방지.
	P_Ecat_Reconn_Time_Out_Bit = 0;											// 재진입 방지.
	//M_Y_Alarm_ECAT_SoftWare_Error = 1;									// [이더캣 소프트웨어 통신오류] 소프트웨어 오류 알람 발생
	P_EtherCat_Active_Status = 0;											// 이더캣 활성화 상태 초기화.
	P_Ecat_Reconn_State_Machine = 0;										// 활성화 스텟머신 초기화.
	// 버튼 램프 초기화.
}

// 이더캣 활성화 타임 아웃 확인.
if ( (Sys.Time >= P_Ecat_Reconn_Time_Out_Timer + P_Ecat_Reconn_Time_Out_Delay_Time) && P_EtherCat_Active_Status == F_Status_EXECUTE )	// 이더캣 활성화 3분 넘게 걸릴 경우.
	P_Ecat_Reconn_Time_Out_Bit = 1;											// 타임 아웃 비트 발생.


// MC Protocol 끊어진 경우, 재 연결 가능 구문 [ 참조 : 2025.10.29 미비사항 추가 건 ]
if( Sys_MC_Protocol_HeartBit != L_Old_MC_Protocol_HeartBit )				// 하트비트가 변경된다면
{
	L_Old_MC_Protocol_HeartBit = Sys_MC_Protocol_HeartBit;					// MC Protocol 값 동기화
	L_MC_Protocol_MNTR_Timer = 0;
}

if( L_MC_Protocol_MNTR_Timer > 5000 )
{
	if( M_X_Trigger_1s_Cycle_HeartBit != L_X_Trigger_1s_Cycle_HeartBit )	// 하트비트엣지에 반응
	{
		if( P_Max_Try_Reconnect_MC > P_Cur_Try_Reconnect_MC )				// 최대 횟수 > 현재 카운팅 횟수
		{
			//system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/mc_protocol.out -u"
			//call Timer.sec(0.5);
			//if ( P_Select_Stack_Number == F_Stack_A )
			//	system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/mc_protocol.out -a"
			//else if ( P_Select_Stack_Number == F_Stack_B )
			//	system "/var/ftp/usrflash/Project/C\ Language/Background\ Programs/mc_protocol.out -b"
			P_Cur_Try_Reconnect_MC++;
			L_MC_Protocol_MNTR_Timer = 0;
		}
	}
}
L_X_Trigger_1s_Cycle_HeartBit = M_X_Trigger_1s_Cycle_HeartBit;
*/

// PVT 자동 계산 프로그램
if( P_PLC30_PVT_FWD_Calculation_Bit == N_TRUE )
{
	// Vel = 속도mu/s Time = 시간 ms Inclination = 계수 StartPos = 시작위치

	// 1번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_1st_Vel > 0)	// +방향으로 이동할 때
		P_PLC30_PVT_1st_Pos = P_PLC30_PVT_1st_Time * P_PLC30_PVT_1st_Inclination * P_PLC30_PVT_1st_Vel / 1000;		

	P_PLC30_PVT_1st_Cumulative_Pos = P_PLC30_PVT_1st_Pos + P_PLC30_PVT_StartPos;										// 1번째 누적거리

	// 2번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_1st_Vel == P_PLC30_PVT_2nd_Vel )		// 등속일때
		P_PLC30_PVT_2nd_Pos = P_PLC30_PVT_2nd_Time * P_PLC30_PVT_2nd_Vel / 1000;
	else if( P_PLC30_PVT_1st_Vel < P_PLC30_PVT_2nd_Vel )	// 가속이 생길때
		P_PLC30_PVT_2nd_Pos = ( P_PLC30_PVT_2nd_Vel - P_PLC30_PVT_1st_Vel ) * P_PLC30_PVT_2nd_Inclination * P_PLC30_PVT_2nd_Time / 1000 + P_PLC30_PVT_1st_Vel * P_PLC30_PVT_2nd_Time / 1000 ;
	else if( P_PLC30_PVT_2nd_Vel == 0 )					// 0으로 감속할때 ( 최종단계 )
		P_PLC30_PVT_2nd_Pos = ( P_PLC30_PVT_1st_Vel - P_PLC30_PVT_2nd_Vel ) * P_PLC30_PVT_2nd_Time / 1000 * P_PLC30_PVT_2nd_Inclination ;
	else												// 감속할때
		P_PLC30_PVT_2nd_Pos = ( P_PLC30_PVT_1st_Vel - P_PLC30_PVT_2nd_Vel ) * P_PLC30_PVT_2nd_Inclination * P_PLC30_PVT_2nd_Time / 1000 + P_PLC30_PVT_2nd_Vel * P_PLC30_PVT_2nd_Time / 1000;
	
	P_PLC30_PVT_2nd_Cumulative_Pos = P_PLC30_PVT_1st_Cumulative_Pos + P_PLC30_PVT_2nd_Pos;		// 2번째 누적거리
	// 3번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_2nd_Vel == P_PLC30_PVT_3rd_Vel )		// 등속일때
		P_PLC30_PVT_3rd_Pos = P_PLC30_PVT_3rd_Time * P_PLC30_PVT_3rd_Vel / 1000;
	else if( P_PLC30_PVT_2nd_Vel < P_PLC30_PVT_3rd_Vel )	// 가속이 생길때
		P_PLC30_PVT_3rd_Pos = ( P_PLC30_PVT_3rd_Vel - P_PLC30_PVT_2nd_Vel ) * P_PLC30_PVT_3rd_Inclination * P_PLC30_PVT_3rd_Time / 1000 + P_PLC30_PVT_3rd_Vel * P_PLC30_PVT_3rd_Time / 1000 ;
	else if( P_PLC30_PVT_3rd_Vel == 0 )					// 0으로 감속할때 ( 최종단계 )
		P_PLC30_PVT_3rd_Pos = ( P_PLC30_PVT_2nd_Vel - P_PLC30_PVT_3rd_Vel ) * P_PLC30_PVT_3rd_Time / 1000 * P_PLC30_PVT_3rd_Inclination ;
	else												// 감속할때
		P_PLC30_PVT_3rd_Pos = ( P_PLC30_PVT_2nd_Vel - P_PLC30_PVT_3rd_Vel ) * P_PLC30_PVT_3rd_Inclination * P_PLC30_PVT_3rd_Time / 1000 + P_PLC30_PVT_3rd_Vel * P_PLC30_PVT_3rd_Time / 1000;

	P_PLC30_PVT_3rd_Cumulative_Pos = P_PLC30_PVT_2nd_Cumulative_Pos + P_PLC30_PVT_3rd_Pos;		// 3번째 누적거리
	// 4번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_3rd_Vel == P_PLC30_PVT_4th_Vel )		// 등속일때
		P_PLC30_PVT_4th_Pos = P_PLC30_PVT_4th_Time * P_PLC30_PVT_4th_Vel / 1000;
	else if( P_PLC30_PVT_3rd_Vel < P_PLC30_PVT_4th_Vel )	// 가속이 생길때
		P_PLC30_PVT_4th_Pos = ( P_PLC30_PVT_4th_Vel - P_PLC30_PVT_3rd_Vel ) * P_PLC30_PVT_4th_Inclination * P_PLC30_PVT_4th_Time / 1000 + P_PLC30_PVT_4th_Vel * P_PLC30_PVT_4th_Time / 1000 ;
	else if( P_PLC30_PVT_4th_Vel == 0 )					// 0으로 감속할때 ( 최종단계 )
		P_PLC30_PVT_4th_Pos = ( P_PLC30_PVT_3rd_Vel - P_PLC30_PVT_4th_Vel ) * P_PLC30_PVT_4th_Time / 1000 * P_PLC30_PVT_4th_Inclination ;
	else												// 감속할때
		P_PLC30_PVT_4th_Pos = ( P_PLC30_PVT_3rd_Vel - P_PLC30_PVT_4th_Vel ) * P_PLC30_PVT_4th_Inclination * P_PLC30_PVT_4th_Time / 1000 + P_PLC30_PVT_4th_Vel * P_PLC30_PVT_4th_Time / 1000;

	P_PLC30_PVT_4th_Cumulative_Pos = P_PLC30_PVT_3rd_Cumulative_Pos + P_PLC30_PVT_4th_Pos;		// 4번째 누적거리
	//  =================================================================================================================

	P_PLC30_PVT_Total_Pos = P_PLC30_PVT_1st_Pos + P_PLC30_PVT_2nd_Pos + P_PLC30_PVT_3rd_Pos + P_PLC30_PVT_4th_Pos;		// 총 누적 거리
}

if( P_PLC30_PVT_BWD_Calculation_Bit == N_TRUE )
{
	// Vel = 속도mu/s Time = 시간 ms Inclination = 계수  StartPos = 시작위치

	// 1번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_1st_Vel < 0)	// -방향으로 이동할 때
		P_PLC30_PVT_1st_Pos = P_PLC30_PVT_1st_Time * P_PLC30_PVT_1st_Inclination * P_PLC30_PVT_1st_Vel / 1000;		
	
	P_PLC30_PVT_1st_Cumulative_Pos = P_PLC30_PVT_1st_Pos + P_PLC30_PVT_StartPos;										// 1번째 누적거리

	// 2번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_1st_Vel == P_PLC30_PVT_2nd_Vel )		// 등속일때
		P_PLC30_PVT_2nd_Pos = P_PLC30_PVT_2nd_Time * P_PLC30_PVT_2nd_Vel / 1000;
	else if( P_PLC30_PVT_1st_Vel > P_PLC30_PVT_2nd_Vel )	// 가속이 생길때
		P_PLC30_PVT_2nd_Pos = ( P_PLC30_PVT_2nd_Vel - P_PLC30_PVT_1st_Vel ) * P_PLC30_PVT_2nd_Inclination * P_PLC30_PVT_2nd_Time / 1000 + P_PLC30_PVT_1st_Vel * P_PLC30_PVT_2nd_Time / 1000 ;
	else if( P_PLC30_PVT_2nd_Vel == 0 )						// 0으로 감속할때 ( 최종단계 )
		P_PLC30_PVT_2nd_Pos = ( P_PLC30_PVT_1st_Vel - P_PLC30_PVT_2nd_Vel ) * P_PLC30_PVT_2nd_Time / 1000 * P_PLC30_PVT_2nd_Inclination ;
	else													// 감속할때
		P_PLC30_PVT_2nd_Pos = ( P_PLC30_PVT_1st_Vel - P_PLC30_PVT_2nd_Vel ) * P_PLC30_PVT_2nd_Inclination * P_PLC30_PVT_2nd_Time / 1000 + P_PLC30_PVT_2nd_Vel * P_PLC30_PVT_2nd_Time / 1000;
	
	P_PLC30_PVT_2nd_Cumulative_Pos = P_PLC30_PVT_1st_Cumulative_Pos + P_PLC30_PVT_2nd_Pos;		// 2번째 누적거리
	// 3번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_2nd_Vel == P_PLC30_PVT_3rd_Vel )		// 등속일때
		P_PLC30_PVT_3rd_Pos = P_PLC30_PVT_3rd_Time * P_PLC30_PVT_3rd_Vel / 1000;
	else if( P_PLC30_PVT_2nd_Vel > P_PLC30_PVT_3rd_Vel )	// 가속이 생길때
		P_PLC30_PVT_3rd_Pos = ( P_PLC30_PVT_3rd_Vel - P_PLC30_PVT_2nd_Vel ) * P_PLC30_PVT_3rd_Inclination * P_PLC30_PVT_3rd_Time / 1000 + P_PLC30_PVT_3rd_Vel * P_PLC30_PVT_3rd_Time / 1000 ;
	else if( P_PLC30_PVT_3rd_Vel == 0 )					// 0으로 감속할때 ( 최종단계 )
		P_PLC30_PVT_3rd_Pos = ( P_PLC30_PVT_2nd_Vel - P_PLC30_PVT_3rd_Vel ) * P_PLC30_PVT_3rd_Time / 1000 * P_PLC30_PVT_3rd_Inclination ;
	else												// 감속할때
		P_PLC30_PVT_3rd_Pos = ( P_PLC30_PVT_2nd_Vel - P_PLC30_PVT_3rd_Vel ) * P_PLC30_PVT_3rd_Inclination * P_PLC30_PVT_3rd_Time / 1000 + P_PLC30_PVT_3rd_Vel * P_PLC30_PVT_3rd_Time / 1000;

	P_PLC30_PVT_3rd_Cumulative_Pos = P_PLC30_PVT_2nd_Cumulative_Pos + P_PLC30_PVT_3rd_Pos;		// 3번째 누적거리
	// 4번째 구간 계산 ==================================================================================================
	if( P_PLC30_PVT_3rd_Vel == P_PLC30_PVT_4th_Vel )		// 등속일때
		P_PLC30_PVT_4th_Pos = P_PLC30_PVT_4th_Time * P_PLC30_PVT_4th_Vel / 1000;
	else if( P_PLC30_PVT_3rd_Vel > P_PLC30_PVT_4th_Vel )	// 가속이 생길때
		P_PLC30_PVT_4th_Pos = ( P_PLC30_PVT_4th_Vel - P_PLC30_PVT_3rd_Vel ) * P_PLC30_PVT_4th_Inclination * P_PLC30_PVT_4th_Time / 1000 + P_PLC30_PVT_4th_Vel * P_PLC30_PVT_4th_Time / 1000 ;
	else if( P_PLC30_PVT_4th_Vel == 0 )					// 0으로 감속할때 ( 최종단계 )
		P_PLC30_PVT_4th_Pos = ( P_PLC30_PVT_3rd_Vel - P_PLC30_PVT_4th_Vel ) * P_PLC30_PVT_4th_Time / 1000 * P_PLC30_PVT_4th_Inclination ;
	else												// 감속할때
		P_PLC30_PVT_4th_Pos = ( P_PLC30_PVT_3rd_Vel - P_PLC30_PVT_4th_Vel ) * P_PLC30_PVT_4th_Inclination * P_PLC30_PVT_4th_Time / 1000 + P_PLC30_PVT_4th_Vel * P_PLC30_PVT_4th_Time / 1000;

	P_PLC30_PVT_4th_Cumulative_Pos = P_PLC30_PVT_3rd_Cumulative_Pos + P_PLC30_PVT_4th_Pos;		// 4번째 누적거리
	//  =================================================================================================================

	P_PLC30_PVT_Total_Pos = P_PLC30_PVT_1st_Pos + P_PLC30_PVT_2nd_Pos + P_PLC30_PVT_3rd_Pos + P_PLC30_PVT_4th_Pos;			// 총 누적 거리
}


close
 