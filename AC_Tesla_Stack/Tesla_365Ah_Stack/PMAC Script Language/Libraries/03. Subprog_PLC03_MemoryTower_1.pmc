// [ 참조 : 2025.09.30 Clamp 극판 하강 위치 추가]
open subprog Sub_Unit_Memory_Status(void)

sub: Initialize(&rtn)

if( P_Memory_Tower_Test == 0 )
{
	// Final Roll
		// N_FINAL_ROLL_X = 12
		P_Recipe_1st_MotorNo(N_FINAL_ROLL_X) = P_Recipe_M12_POS(1);			// 음극위치 or 세파 첫장 ( 대기위치 )
