//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.06.04 임동훈 선임
// 모듈화 프로그래밍 진행 (배출) - [ 참조 : 25.06.04 모듈화 프로그램 신규 추가 ] 
// 25.06.04 김형진 책임
// 모듈화 프로그래밍 진행 (ARC) - [ 참조 : 25.06.04 모듈화 프로그램 신규 추가 ] 

/*
1. Discharge Acting Module
2. ARC Acting Module
[search]	ㄴㄷㅁㄱ
//-- Discharge_Fine --//
//-- ARC_Fine --//
//--Supply_Fine--//
*/
open subprog Subprog_Subprocess_Act_Module(void)
	/*---------- Discharge_Fine ----------//
	- FR_Clamp_OFF						[실린더]		[파이널 롤러 언클램프]
	- FR_Clamp_ON						[실린더]		[파이널 롤러 클램프]
	- FR_Discharge_Pos					[모터]		[파이널 롤러 배출 위치]
	- FR_Stack_Pos						[모터]		[파이널 롤러 스텍 위치]
	- First_Unloadaer_UP				[모터]		[1차 언로더 상승 - 스텍 위치 이동]
	- First_Unloadaer_FWD				[모터]		[1차 언로더 전진 - 스텍 진입 이동]
	- First_Unloader_Grip_ON			[실린더]		[1차 언로더 그립 ON]
	- First_Unloader_Grip_OFF			[실린더]		[1차 언로더 그립 OFF]
	- First_Unloader_Grip_Cell_Pos		[모터]		[1차 언로더 셀 부착 위치 이동]
	- First_Unloader_BWD_Wait_Pos		[모터]		[1차 언로더 그립 후 후진을 위한 대기 위치 이동]
	- First_Unloader_Stack_BWD			[모터]		[1차 언로더 그립 후 후진 위치 이동]
	- First_Unloader_Stack_Down			[모터]		[1차 언로더 하강 위치 이동]
	- First_Unloader_Turn				[모터]		[1차 언로더 회피위치 이동 - 45도 위치 회전]
	- First_Unloader_Handover_Pos		[모터]		[1차 언로더 인계위치 이동 - 90도 위치 회전]
	- Cathode_Clamp_OFF					[모터]		[양극 클램프 OFF]
	- Sepa_Cutter_Heating				[실린더]		[세파 커티 열선 ON]
	- Sepa_Cutter_Cylinder_FWD			[실린더]		[세파 커터 전진]
	- Sepa_Cutter_Cylinder_BWD			[실린더]		[세파 커터 후진]
	- Main_Z_Init_Pos					[모터]		[메인Z축 대기 위치 이동]	  
	- After_Action_Init					[x]			[배출 후 액션 함수 초기화]
	- Sheet_Paper_BWD					[모터]		[시트 페이퍼 후진]
	- Sheet_Paper_Vacuum_ON				[실린더]		[시트 페이퍼 진공 ON]
	- Master_Coord_Pause				[x]			[ 마스터 좌표계 정지 ]
	- Master_Coord_Resume				[x]			[ 마스터 좌표계 재시작 ]
	---------------- PMAC ↔ PLC Interface ----------------
	- First_Unloader_Pos_Chk			[Interface]	[1차 언로더 위치 확인]
	- Unloader_Grip_ON					[Interface]	[언로더 그립 요청] (A열 : 2차 언로더, B열 : 3차 언로더)
	- Grip_Chk_First_Unloader_Grip_OFF	[실린더]		[1차 언로더 언그립] (A열 : 2차 언로더 확인, B열 : 3차 언로더 확인)
	- First_Unloader_Wait_Pos			[모터]		[1차 언로더 대기 위치 이동 - 0도 위치 회전]
	//------------------------------------*/

	// 파이널 롤러 언클램프.
	sub:FR_Clamp_OFF(&FR_Clamp_OFF_RTN)
		// 0.0) 반환값 초기화.
		FR_Clamp_OFF_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_FR_Clamp_OFF) = Sys.Time;																	// 타이머 설정.
			if ( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) == N_Normal_Status_Sequence )
			{
				P_Discharge_Vision_DIO_RTN = 0;																				// 반환값 초기화.	
				call Discharge_Sub_Prog.Discharge_Vision_DIO(&P_Discharge_Vision_DIO_RTN);									// 비전 인터페이스 신호.
			}
			else
				P_Discharge_Vision_DIO_RTN = F_TRUE;																		// 드라이런 및 세파모드일떄 반환값 트루 추가

			M_Y_FR_Sepa_Clamp_FWD_Sol = 0;																					// 파이널 롤러 언클램프.
			M_Y_FR_Sepa_Clamp_BWD_Sol = 1;																					// 파이널 롤러 언클램프.
			P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) = 1;														// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_FR_Clamp_OFF) + P_Act_Time_Out(N_Act_FR_Clamp_OFF) )						// 일정 시간 전에 완료 될 경우.
			{
				if( M_X_FR_Sepa_Clamp_Front_Sensor == 0 && M_X_FR_Sepa_Clamp_Rear_Sensor == 0 && M_X_FR_Sepa_UnClamp_Front_Sensor == 1 && M_X_FR_Sepa_UnClamp_Rear_Sensor == 1 && P_Discharge_Vision_DIO_RTN == F_TRUE )	// 완료 상태 확인 후
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_FR_Clamp_OFF) + P_Act_Delay_Time(N_Act_FR_Clamp_OFF) )				// 일정 딜레이 시간을 넘길 경우.
					{
						P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) = N_Complete_Step;								// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																											// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) = N_Error_Step;										// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) == N_Error_Step )											// 애러 상태 일 경우.
		{
			FR_Clamp_OFF_RTN = N_FALSE;																						// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_OFF) == N_Complete_Step )										// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_FR_Clamp_OFF) = 1;																		// 동작 완료 Bit On.
			FR_Clamp_OFF_RTN = N_COMPLETE;																					// 반환값 : COMPLETE
		}
	return
	
	// 파이널 롤러 클램프.
	sub:FR_Clamp_ON(&FR_Clamp_ON_RTN)
		// 0.0) 반환값 초기화.
		FR_Clamp_ON_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_FR_Clamp_ON) = Sys.Time;																	// 타이머 설정.
			M_Y_FR_Sepa_Clamp_FWD_Sol = 1;																					// 파이널 롤러 클램프.
			M_Y_FR_Sepa_Clamp_BWD_Sol = 0;																					// 파이널 롤러 클램프.
			P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) = 1;														// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_FR_Clamp_ON) + P_Act_Time_Out(N_Act_FR_Clamp_ON) )							// 일정 시간 전에 완료 될 경우.
			{
				if( M_X_FR_Sepa_Clamp_Front_Sensor == 1 && M_X_FR_Sepa_Clamp_Rear_Sensor == 1 && M_X_FR_Sepa_UnClamp_Front_Sensor == 0 && M_X_FR_Sepa_UnClamp_Rear_Sensor == 0 ) // 완료 상태 확인 후
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_FR_Clamp_ON) + P_Act_Delay_Time(N_Act_FR_Clamp_ON) )				// 일정 딜레이 시간을 넘길 경우.
					{
						P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) = N_Complete_Step;								// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																											// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) = N_Error_Step;											// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) == N_Error_Step )											// 애러 상태 일 경우.
		{
			FR_Clamp_ON_RTN = N_FALSE;																						// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Clamp_ON) == N_Complete_Step )										// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_FR_Clamp_ON) = 1;																		// 동작 완료 Bit On.
			FR_Clamp_ON_RTN = N_COMPLETE;																					// 반환값 : COMPLETE
		}
	return
	
	// 파이널 롤러 배출 위치 이동.
	sub:FR_Discharge_Pos(&FR_Discharge_Pos_RTN)
		// 0.0) 반환값 초기화.
		FR_Discharge_Pos_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) == N_Ready_Step )										// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_FR_Discharge_Pos) = Sys.Time;																// 타이머 설정.
			P_Final_Roll_Discharge_Status = F_Status_Nonseatus;																// 상태 초기화.
			P_Slave5_Motion_Command = N_FR_Discharge_Move_Motion;															// FR 배출 위치 Slave Motion Cmd		200ms
			P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) = 1;													// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_FR_Discharge_Pos) + P_Act_Time_Out(N_Act_FR_Discharge_Pos) )				// 일정 시간 전에 완료 될 경우.
			{
				if( P_Final_Roll_Discharge_Status == F_Status_COMPLETE )													// 모션 완료 일 경우.
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_FR_Discharge_Pos) + P_Act_Delay_Time(N_Act_FR_Discharge_Pos) )		// 일정 딜레이 시간을 넘길 경우.
					{
						P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) = N_Complete_Step;							// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																											// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) = N_Error_Step;									// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) == N_Error_Step )										// 애러 상태 일 경우.
		{
			FR_Discharge_Pos_RTN = N_FALSE;																					// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Discharge_Pos) == N_Complete_Step )									// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_FR_Discharge_Pos) = 1;																	// 동작 완료 Bit On.
			FR_Discharge_Pos_RTN = N_COMPLETE;																				// 반환값 : COMPLETE
		}
	return

	// 파이널 롤러 스텍 위치 이동.
	sub:FR_Stack_Pos(&FR_Stack_Pos_RTN)
		// 0.0) 반환값 초기화.
		FR_Stack_Pos_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_FR_Stack_Pos) = Sys.Time;																	// 타이머 설정.
			P_Final_Roll_Stack_Up_Pos_Status = F_Status_Nonseatus;															// 상태 초기화.
			P_Slave5_Motion_Command = N_FR_Stack_UP_Motion;																	// FR 상승 위치 Slave Motion Cmd		200ms
			P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) = 1;														// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_FR_Stack_Pos) + P_Act_Time_Out(N_Act_FR_Stack_Pos) )						// 일정 시간 전에 완료 될 경우.
			{
				if( P_Final_Roll_Stack_Up_Pos_Status == F_Status_COMPLETE )													// 모션 완료 일 경우.
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_FR_Stack_Pos) + P_Act_Delay_Time(N_Act_FR_Stack_Pos) )				// 일정 딜레이 시간을 넘길 경우.
					{
						P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) = N_Complete_Step;								// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																											// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) = N_Error_Step;										// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) == N_Error_Step )											// 애러 상태 일 경우.
		{
			FR_Stack_Pos_RTN = N_FALSE;																						// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_FR_Stack_Pos) == N_Complete_Step )										// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_FR_Stack_Pos) = 1;																		// 동작 완료 Bit On.
			FR_Stack_Pos_RTN = N_COMPLETE;																					// 반환값 : COMPLETE
		}
	return
	
	// 1차 언로더 상승 (스텍 위치 이동)
	sub:First_Unloadaer_UP(&First_Unloadaer_UP_RTN)
		// 0.0) 반환값 초기화.
		First_Unloadaer_UP_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) == N_Ready_Step )									// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_First_Unloader_UP) = Sys.Time;																// 타이머 설정.
			P_First_Unloader_Stack_Up_Status = F_Status_Nonseatus;															// 상태 초기화.
			P_Slave14_Motion_Command = N_1st_UND_Stack_UP_Motion;															// 언로더 스텍위치 Slave Cmd.				200ms
			M_Y_ST_Center_Cyl_Dn_Sol = 1;																					// 스텍 테이블 하강 IO ON
			M_Y_ST_Center_Cyl_Up_Sol = 0;																					// 스텍 테이블 상승 IO OFF
			P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) = 1;													// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_UP) + P_Act_Time_Out(N_Act_First_Unloader_UP) )				// 일정 시간 전에 완료 될 경우.
			{
				// 스텍 테이블 하강 IO 입력 센서 확인 추가.
				if( P_First_Unloader_Stack_Up_Status == F_Status_COMPLETE )													// 모션 완료 일 경우 + IO 입력 완료 될 경우.
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_First_Unloader_UP) + P_Act_Delay_Time(N_Act_First_Unloader_UP) )	// 일정 딜레이 시간을 넘길 경우.
					{
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																											// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) = N_Error_Step;									// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) == N_Error_Step )									// 애러 상태 일 경우.
		{
			First_Unloadaer_UP_RTN = N_FALSE;																				// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_UP) == N_Complete_Step )									// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_UP) = 1;																// 동작 완료 Bit On.
			First_Unloadaer_UP_RTN = N_COMPLETE;																			// 반환값 : COMPLETE
		}
	return
	
	// 1차 언로더 전진 (스텍 진입 이동)
	sub:First_Unloadaer_FWD(&First_Unloadaer_FWD_RTN)
		// 0.0) 반환값 초기화.
		First_Unloadaer_FWD_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) == N_Ready_Step )									// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_First_Unloader_FWD) = Sys.Time;															// 타이머 설정.
			if ( M_X_ST_Center_CYL_Dn_Sensor == 1 && M_X_ST_Center_CYL_Up_Sensor == 0 && M_X_1st_Unloader_Grip_Detect_Sensor == 0 && M_X_1st_Unloader_UnGrip_Detect_Sensor == 1 )	// 스텍테이블 하강, 1차 언로더 언그립 상태 확인 후 전진
			{
				P_First_Unloader_Stack_FWD_Status = F_Status_Nonseatus;														// 상태 초기화.
				P_Slave14_Motion_Command = N_1st_UND_Stack_FWD_Motion;														// 언로더 진입 Slave Cmd.			500ms + 200ms = 700ms
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) = 1;												// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_FWD) + P_Act_Time_Out(N_Act_First_Unloader_FWD) )			// 일정 시간 전에 완료 될 경우.
			{
				if( P_First_Unloader_Stack_FWD_Status == F_Status_COMPLETE )												// 모션 완료 일 경우.
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_First_Unloader_FWD) + P_Act_Delay_Time(N_Act_First_Unloader_FWD) )	// 일정 딜레이 시간을 넘길 경우.
					{
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																											// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) = N_Error_Step;									// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) == N_Error_Step )									// 애러 상태 일 경우.
		{
			First_Unloadaer_FWD_RTN = N_FALSE;																				// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_FWD) == N_Complete_Step )								// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_FWD) = 1;																// 동작 완료 Bit On.
			First_Unloadaer_FWD_RTN = N_COMPLETE;																			// 반환값 : COMPLETE
		}
	return
	
	// 1차 언로더 그립 ON
	sub:First_Unloader_Grip_ON(&First_Unloader_Grip_ON_RTN)
		// 0.0) 반환값 초기화.
