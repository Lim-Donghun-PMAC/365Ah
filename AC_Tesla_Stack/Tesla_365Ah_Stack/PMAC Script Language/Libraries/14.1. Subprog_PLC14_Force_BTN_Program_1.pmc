	sub:Normal_Mode_Address_Config(void)
		
		// GPIO #0
		cmd"M%d->Ecat[0].IO[%d].Data.%d.1",P_Force_BTN_0th_Gpio_M_Variable_Num+P_Force_BTN_Address_Count,P_Force_BTN_0th_Gpio_Board_IO_Num,P_Force_BTN_Address_Count
