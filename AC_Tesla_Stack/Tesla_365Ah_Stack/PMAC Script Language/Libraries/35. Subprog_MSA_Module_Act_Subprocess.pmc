//=========================================================
//8. 얼라인 MSA 1차 벨트 상승
//=========================================================
sub: MSA_1st_PNP_Belt_Up_Move(Mode,&rtn)
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) == N_Ready_Step )								// 얼라인 MSA 1차 벨트 상승 Ready Step
{
	if( Mode == N_MSA_Anode_Align )				// 음극 얼라인 MSA 모드일 경우
	{
		P_Slave16_Motion_Command = 6;																				//음극 1차 PNP 벨트 상승 모션 커멘드	
		P_MSA_Chk_Pos_Timer = 0;																					//체크 타이머 초기화													
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Align )		// 양극 얼라인 MSA 모드일 경우
	{
		P_Slave19_Motion_Command = 6;																				// 양극 1차 PNP 벨트 상승 모션 커멘드
		P_MSA_Chk_Pos_Timer = 0;																					//체크 타이머 초기화
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) = 1;											// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) == 1 )
{
	if( Mode == N_MSA_Anode_Align )			// 음극 얼라인 MSA 모드일 경우
	{
		if ( P_Motor_Current_Pos(N_1st_PnP_AN_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_AN_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um ) // 음극 1차 PNP 벨트 상승 위치 확인
		{
			if ( Motor[N_1st_PnP_AN_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time)														 // 음극 1차 PNP 속도 0 확인
			{	
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) = N_Complete_Step;								  // 다음 스텟 머신으로 이동.
			}
		}	
	}
	else if( Mode == N_MSA_Cathode_Align )	// 양극 얼라인 MSA 모드일 경우
	{				
		if ( P_Motor_Current_Pos(N_1st_PnP_CA_Z) > 38.542 - P_Motor_Ready_Pos_Inpos_200um && P_Motor_Current_Pos(N_1st_PnP_CA_Z) < 38.542 + P_Motor_Ready_Pos_Inpos_200um ) // 양극 1차 PNP 벨트 상승 위치 확인
		{																									
			if (  Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && P_MSA_Chk_Pos_Timer > P_MSA_Chk_Pos_Time)								// 양극 1차 PNP 속도 0 확인
			{																												
				P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) = N_Complete_Step;						// 다음 스텟 머신으로 이동.
			}
		}		
	}		
}

if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Align_1st_Belt_Up_Move) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_1st_Belt_Up_Move) = 1;											// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

//=========================================================
