	// N_Anode_2nd_Vac - 양극 2차 P&P [흡착 ON → 입력 센서 ON]
	// M_Y_To_M_X
	//--------------------------------------------------------------------------------//
	if ( M_Y_Anode_2nd_Vac_Sol_On == 1 && M_Y_Anode_2nd_Vac_Sol_Off == 0 && P_Old_Tact_Time_Check(N_Anode_2nd_Vac) == 0 )		// 흡착 IO ON.
	{
		if ( M_X_Anode_2nd_PNP_Vac_Sensor == 1 )								// 입력 센서 들어올 경우.
		{
