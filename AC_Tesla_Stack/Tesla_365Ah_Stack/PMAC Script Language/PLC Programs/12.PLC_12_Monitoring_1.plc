//PNP Z축 레시피 관리 프로그램					//[ 참조 : 2025.08.27 PNP Z축 레시피 관리 프로그램 추가 ]
//=========================================================================================================================
// [ UI → PMAC ]
if ( P_PMAC_Current_Mode == F_Current_Manual )								//메뉴얼일 경우
{
	L_PNP_Z_Recipe_Change = 0;
	call Initialize.PNP_Z_Axis_Recipe_Monitoring(&L_PNP_Z_Recipe_Change);	//Z축 PNP 레시피 변경 모니터링 함수 
	if( L_PNP_Z_Recipe_Change == 1 )										//Z축 PNP 레시피 변경 없을 경우 True
	{
		//Z축 PNP 레시피 변경이 되지 않았기 때문에 패스 
	}
	else if ( L_PNP_Z_Recipe_Change == 0 )									//Z축 PNP 레시피 변경되었을 경우 True
	{
		call Initialize.PNP_Z_Axis_Recipe_to_Cnt(&L_PNP_Z_Cnt_Read);		//모터 위치 레시피에 따른 모터 카운트 계산 함수 호출	
		if(L_PNP_Z_Cnt_Read == 1)											//모터 카운트 값 계산 완료 
		{
			L_PNP_Z_Cnt_Read = 0;
		}
	}
}
//=========================================================================================================================
// [ PMAC → UI ]
if ( P_PMAC_Current_Mode == F_Current_Manual || P_PMAC_Current_Mode == F_Current_Automatic )	//메뉴얼, 오토 상태일 경우 
{
	L_PNP_Z_Count_Change = 0;
	call Initialize.PNP_Z_Axis_Cnt_to_Recipe(&L_PNP_Z_Count_Change)								//모터 카운트 → 레시피 값 전환 함수 호출
	if ( L_PNP_Z_Count_Change == 1 )															//리턴값 True
	{
		L_PNP_Z_Count_Change = 0;																//리턴값 초기화
	}
}
// 삼각함수 및 제곱근 계산은 C 컴파일로 미리 읽어 부하율 감소 [ 참조 : CPU 최적화 진행 ]
