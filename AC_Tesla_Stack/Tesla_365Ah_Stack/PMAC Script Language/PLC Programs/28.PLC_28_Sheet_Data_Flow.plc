//	}
//}

// 음극 데이터 전달 I/O 리셋
if(M_Y_Vision_Anode_Data_Transfer_Trigger == 1)
{
	if(L_Anode_PMAC_to_VISION_Align_Passing_Reset_Timer > 400)
	{
		M_Y_Vision_Anode_Data_Transfer_Trigger = 0;
	}
}

// 양극 얼라인, 표면검사 NG I/O 초기화 
