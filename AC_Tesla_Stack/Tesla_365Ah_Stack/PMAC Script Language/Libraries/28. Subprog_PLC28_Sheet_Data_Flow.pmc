open subprog Sheet_Data_Flow
	sub: Anode_Move_Sheet_Data(Object, Target, &rtn)

		if(Target == N_Sheet_Data_1st_TR)
		{
			// 벨트 버퍼 ( 리턴 용 ) 
			M_ASCII_Anode_Sheet_Belt_Buffer(0) = Sys.Udata[10000];
			M_ASCII_Anode_Sheet_Belt_Buffer(1) = Sys.Udata[10001];
			M_ASCII_Anode_Sheet_Belt_Buffer(2) = Sys.Udata[10002];
			M_ASCII_Anode_Sheet_Belt_Buffer(3) = Sys.Udata[10003];
			M_ASCII_Anode_Sheet_Belt_Buffer(4) = Sys.Udata[10004];
			M_ASCII_Anode_Sheet_Belt_Buffer(5) = Sys.Udata[10005];
			M_ASCII_Anode_Sheet_Belt_Buffer(6) = Sys.Udata[10006];

			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR) =	  M_ASCII_Anode_Sheet_Belt_Buffer(0);
			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 1) = M_ASCII_Anode_Sheet_Belt_Buffer(1);
			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 2) = M_ASCII_Anode_Sheet_Belt_Buffer(2);
			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 3) = M_ASCII_Anode_Sheet_Belt_Buffer(3);
			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 4) = M_ASCII_Anode_Sheet_Belt_Buffer(4);
			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 5) = M_ASCII_Anode_Sheet_Belt_Buffer(5);
			M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 6) = M_ASCII_Anode_Sheet_Belt_Buffer(6);

			rtn = 1;
		}
		else
		{
			if(Object > -1 && Target > -1)
			{

				M_ASCII_Anode_Sheet_Buffer(Target) = M_ASCII_Anode_Sheet_Buffer(Object);
				M_ASCII_Anode_Sheet_Buffer(Target + 1) = M_ASCII_Anode_Sheet_Buffer(Object + 1);
				M_ASCII_Anode_Sheet_Buffer(Target + 2) = M_ASCII_Anode_Sheet_Buffer(Object + 2);
				M_ASCII_Anode_Sheet_Buffer(Target + 3) = M_ASCII_Anode_Sheet_Buffer(Object + 3);
				M_ASCII_Anode_Sheet_Buffer(Target + 4) = M_ASCII_Anode_Sheet_Buffer(Object + 4);
				M_ASCII_Anode_Sheet_Buffer(Target + 5) = M_ASCII_Anode_Sheet_Buffer(Object + 5);
				M_ASCII_Anode_Sheet_Buffer(Target + 6) = M_ASCII_Anode_Sheet_Buffer(Object + 6);

				if(Target == N_Sheet_Data_Align_Table)
				{
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision) = M_ASCII_Anode_Sheet_Buffer(Object);
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 1) = M_ASCII_Anode_Sheet_Buffer(Object + 1);
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 2) = M_ASCII_Anode_Sheet_Buffer(Object + 2);
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 3) = M_ASCII_Anode_Sheet_Buffer(Object + 3);
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 4) = M_ASCII_Anode_Sheet_Buffer(Object + 4);
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 5) = M_ASCII_Anode_Sheet_Buffer(Object + 5);
					M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 6) = M_ASCII_Anode_Sheet_Buffer(Object + 6);

					// Vision에 전달할 데이터 P변수로 전환
					P_Anode_Align_Vision_Sheet_1 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision);
					P_Anode_Align_Vision_Sheet_2 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 1)
					P_Anode_Align_Vision_Sheet_3 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 2)
					P_Anode_Align_Vision_Sheet_4 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 3)
					P_Anode_Align_Vision_Sheet_5 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 4)
					P_Anode_Align_Vision_Sheet_6 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 5)
					P_Anode_Align_Vision_Sheet_7 = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 6)
				}

				if(Target == N_Sheet_Data_Stack_Table)
				{
					// 스택 테이블에 첫장 쌓을 때 
					if(P_Anode_Count == 1)
					{
						M_ASCII_First_Sheet_Buffer(0) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table);
						M_ASCII_First_Sheet_Buffer(1) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 1);
						M_ASCII_First_Sheet_Buffer(2) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 2);
						M_ASCII_First_Sheet_Buffer(3) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 3);
						M_ASCII_First_Sheet_Buffer(4) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 4);
						M_ASCII_First_Sheet_Buffer(5) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 5);
						M_ASCII_First_Sheet_Buffer(6) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 6);
					}

					// 스택 테이블에 마지막장 쌓을 때
					if(P_Anode_Count == P_Anode_Recipe_Count)
					{
						M_ASCII_Last_Sheet_Buffer(0) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table);
						M_ASCII_Last_Sheet_Buffer(1) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 1);
						M_ASCII_Last_Sheet_Buffer(2) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 2);
						M_ASCII_Last_Sheet_Buffer(3) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 3);
						M_ASCII_Last_Sheet_Buffer(4) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 4);
						M_ASCII_Last_Sheet_Buffer(5) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 5);
						M_ASCII_Last_Sheet_Buffer(6) = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_Stack_Table + 6);
					}
				}
				rtn = 1;
			}
			else
			{
				rtn = 0;
			}
		}
	return;

	sub: Cathode_Move_Sheet_Data(Object, Target, &rtn)
		
		local L_Count = 0;
		if(Target == N_Sheet_Data_1st_TR)
		{
			// 벨트 버퍼 ( 리턴용 )
			M_ASCII_Cathode_Sheet_Belt_Buffer(0) = Sys.Udata[10008];
			M_ASCII_Cathode_Sheet_Belt_Buffer(1) = Sys.Udata[10009];
			M_ASCII_Cathode_Sheet_Belt_Buffer(2) = Sys.Udata[10010];
			M_ASCII_Cathode_Sheet_Belt_Buffer(3) = Sys.Udata[10011];
			M_ASCII_Cathode_Sheet_Belt_Buffer(4) = Sys.Udata[10012];
			M_ASCII_Cathode_Sheet_Belt_Buffer(5) = Sys.Udata[10013];
			M_ASCII_Cathode_Sheet_Belt_Buffer(6) = Sys.Udata[10014];

			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR) =		M_ASCII_Cathode_Sheet_Belt_Buffer(0);
			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 1) = M_ASCII_Cathode_Sheet_Belt_Buffer(1);
			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 2) = M_ASCII_Cathode_Sheet_Belt_Buffer(2);
			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 3) = M_ASCII_Cathode_Sheet_Belt_Buffer(3);
			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 4) = M_ASCII_Cathode_Sheet_Belt_Buffer(4);
			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 5) = M_ASCII_Cathode_Sheet_Belt_Buffer(5);
			M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 6) = M_ASCII_Cathode_Sheet_Belt_Buffer(6);

			rtn = 1;
		}
		else
		{
			if(Object > -1 && Target > -1)
			{
				M_ASCII_Cathode_Sheet_Buffer(Target) = M_ASCII_Cathode_Sheet_Buffer(Object);
				M_ASCII_Cathode_Sheet_Buffer(Target + 1) = M_ASCII_Cathode_Sheet_Buffer(Object + 1);
				M_ASCII_Cathode_Sheet_Buffer(Target + 2) = M_ASCII_Cathode_Sheet_Buffer(Object + 2);
				M_ASCII_Cathode_Sheet_Buffer(Target + 3) = M_ASCII_Cathode_Sheet_Buffer(Object + 3);
				M_ASCII_Cathode_Sheet_Buffer(Target + 4) = M_ASCII_Cathode_Sheet_Buffer(Object + 4);
				M_ASCII_Cathode_Sheet_Buffer(Target + 5) = M_ASCII_Cathode_Sheet_Buffer(Object + 5);
				M_ASCII_Cathode_Sheet_Buffer(Target + 6) = M_ASCII_Cathode_Sheet_Buffer(Object + 6);

				if(Target == N_Sheet_Data_Align_Table)
				{
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision) = M_ASCII_Cathode_Sheet_Buffer(Object);
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 1) = M_ASCII_Cathode_Sheet_Buffer(Object + 1);
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 2) = M_ASCII_Cathode_Sheet_Buffer(Object + 2);
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 3) = M_ASCII_Cathode_Sheet_Buffer(Object + 3);
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 4) = M_ASCII_Cathode_Sheet_Buffer(Object + 4);
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 5) = M_ASCII_Cathode_Sheet_Buffer(Object + 5);
					M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 6) = M_ASCII_Cathode_Sheet_Buffer(Object + 6);

					// Vision에 전달할 데이터 P변수로 전환
					P_Cathode_Align_Vision_Sheet_1 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision);
					P_Cathode_Align_Vision_Sheet_2 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 1)
					P_Cathode_Align_Vision_Sheet_3 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 2)
					P_Cathode_Align_Vision_Sheet_4 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 3)
					P_Cathode_Align_Vision_Sheet_5 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 4)
					P_Cathode_Align_Vision_Sheet_6 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 5)
					P_Cathode_Align_Vision_Sheet_7 = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_Align_Table_Vision + 6)
				}

				rtn = 1;
			}
			else
			{
				rtn = 0;
			}
		}
	return;

	sub: Anode_Cell_Exist(Target)
		switch(Target)
		{
			case N_Sheet_Data_1st_TR:
				if(Sys_Anode_1st_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Anode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Anode_1P = 1;		// UI 모니터링 용
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Anode_1st_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Anode_1P = 0;
				}
			break;

			case N_Sheet_Data_2nd_TR:
				if(Sys_Anode_2nd_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Anode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Anode_2P = 1;
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Anode_2nd_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Anode_2P = 0;
				}
			break;

			case N_Sheet_Data_Align_Table:
				if(Sys_Anode_Align_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Anode_AT = 1;
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Anode_Align_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Anode_AT = 0;
				}
			break;

			case N_Sheet_Data_NG_TR:
				if(Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Anode_NG_TR = 1;
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Anode_NG_TR = 0;
				}
			break;
		}
	return;

	sub: Cathode_Cell_Exist(Target)
		switch(Target)
		{
			case N_Sheet_Data_1st_TR:
				if(Sys_Cathode_1st_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Cathode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Cathode_1P = 1;		// UI 모니터링 용
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Cathode_1st_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Cathode_1P = 0;
				}
			break;

			case N_Sheet_Data_2nd_TR:
				if(Sys_Cathode_2nd_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Cathode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Cathode_2P = 1;
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Cathode_2nd_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Cathode_2P = 0;
				}
			break;

			case N_Sheet_Data_Align_Table:
				if(Sys_Cathode_Align_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Cathode_AT = 1;
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Cathode_Align_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Cathode_AT = 0;
				}
			break;

			case N_Sheet_Data_NG_TR :
				if(Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE != 0)
				{
					if(Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
					{
						P_Current_Cell_Memory_Cathode_NG_TR = 1;
					}
					else
					{
						// [참조 : 260108 극판데이터 값이 잘 못 들어가 있을 경우 존재 bit를 넣어 극판이 없는데 있다고 판단해서 동작할 수 있어 삭제]
//						if(P_PMAC_Current_Mode == F_Current_Manual)
//						{
//							Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//						}

					}
				}
				else
				{
					P_Current_Cell_Memory_Cathode_NG_TR = 0;
				}
			break;
		}
	return;
close
