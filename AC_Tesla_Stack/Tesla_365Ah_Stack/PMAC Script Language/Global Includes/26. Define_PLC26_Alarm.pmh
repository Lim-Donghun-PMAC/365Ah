// 알람변수정의 추가 - [ 참조 : 2025.08.26 알람변수정의 추가 ]
#define N_Alarm_None					0
#define N_High_Alarm_Emergency_Stop     1  // 중알람 즉시 정지
#define N_High_Alarm_Cycle_Stop         2  // 중알람 사이클 정지
#define N_Low_Alarm                     3  // 경알람 경고
#define N_Priority_None					4	// P_Compare_Priority 알람 없음 값

#define N_Alarm_Arr_Length 100

//========================//
// 알람 프로그램 변수 선언 //
//========================//
global P_Alarm_Arr(N_Alarm_Arr_Length);					// 알람 버퍼
P_Alarm_Arr(0), N_Alarm_Arr_Length = 0;

global P_Alarm_Occur_Flag = 0;							// 알람 타입 확인 플래그
global P_Alarm_Occur_Index_Flag(N_Priority_None);		// 알람 타입 플래그 
P_Alarm_Occur_Index_Flag(0), N_Priority_None = 0;

global P_Alarm_Wait_Time = 2000;						// PLC 터치 패널의 시스템 상 순서를 위해 2초 딜레이 후 전송
global P_Alarm_Delay_Timer = 0; 

global P_Compare_Priority = N_Priority_None;			// 알람 타입 비교를 위해 기본값을 4로 지정 ( 경알람 : 3, 중알람 : 2, 즉시 정지 : 1 )

global P_Alarm_Report = 0;							// 나머지 알람 시작 변수
//
global P_Alarm_Num = 0;								// 알람 M변수 번호
global P_Alarm_Index = 0;								// 현재 처리중인 알람 인덱스
global P_First_Alarm_Flag = 0;						// 첫번째 알람 플래그

// 260715 첫번째 발생한 알람 로그 추가
global P_First_Alarm_Log(30)
P_First_Alarm_Log(0),30 = 0

global P_Servo_Alarm_Check = 0;
global P_Ecat_Servo_Alarm_Check = 0;

// → bgcplc01.h 와 값 동일하게 유지할 것
#define N_Alarm_Num_Max				670					// 알람 번호 최대 개수 ( P_Alarm_duplicate_Check_Arr 크기 )
#define N_Alarm_Max_Cnt				50					// 알람 큐 최대 개수 ( Sys.Udata[2500 ~ 2599] = N_Queue_Byte * N_Alarm_Max_Buf )
#define N_Alarm_Req_Time_Udata		3000				// 알람 번호별 발생 시간 저장 Sys.Udata[3000 ~ 3669]

#define def_Ecat_Drive_Alarm_Bit	$8					// Ecat 모터 드라이브 알람 비트 ( Statusword )

ptr M_SysTimer -> Sys.RunTime;							// CPLC에서 사용하기 위함 ( timer )

global P_Alarm_Count = 0;								// Alarm Count 
global P_Alarm_Get_Flag = 0;							// GetFlag 
global P_Alarm_Sort_Time = 0;							// CPLC Timer
//global P_Alarm_Var = 0;								// M변수의 넘버
global P_Alarm_Frist_Flag = 0;							// 초기값 변수
global P_Alarm_Delay_time = 0;							// 2초 딜레이 타이머

global P_Alarm_duplicate_Check_Arr(N_Alarm_Num_Max);	// 알람 중복 확인용 배열 ( 0 : 미발생, 1~3 : 발생 요청된 알람 Type ) [ 참조 : 26.10.19 알람 큐 RTI 경합 수정 ]
P_Alarm_duplicate_Check_Arr(0), N_Alarm_Num_Max = 0;

global P_Alarm_Time_Log(N_Alarm_Max_Cnt);				// Time Log 
P_Alarm_Time_Log(0),N_Alarm_Max_Cnt = 0;

global P_Alarm_Log(N_Alarm_Max_Cnt);					// 알람 로그
P_Alarm_Log(0),N_Alarm_Max_Cnt = 0;

#define N_Queue_Byte		4
#define N_Alarm_Max_Buf		100
#define def_uint32_max		4294967296

global P_Old_Drive_Alarm(50);
P_Old_Drive_Alarm(0), 50 = 0;
