// 양극 데이터 전달 I/O 리셋
if(M_Y_Vision_Cathode_Data_Transfer_Trigger == 1)
{
	if(L_Cathode_PMAC_to_VISION_Align_Passing_Reset_Timer > 400)
	{
		M_Y_Vision_Cathode_Data_Transfer_Trigger = 0;
	}
}


// 극판 데이터 버튼 관련 모듈
// I/O Reset
if( P_Anode_Data_Delete_Vision_To_PMAC_Get_Flag == 1 )	
{
	P_Anode_Data_Delete_Vision_To_PMAC_Get_Flag = 0;		//초기화
	P_Anode_Align_Data_Delete_Set_Flag = 0;		//초기화
	P_Anode_2nd_PNP_Data_Delete_Set_Flag = 0;		//초기화
}
if( P_Cathode_Data_Delete_Vision_To_PMAC_Get_Flag == 1 )	
{
	P_Cathode_Data_Delete_Vision_To_PMAC_Get_Flag = 0;		//초기화
	P_Cathode_Align_Data_Delete_Set_Flag = 0;		//초기화
	P_Cathode_2nd_PNP_Data_Delete_Set_Flag = 0;		//초기화
}

// 극판 데이터 제거 버튼 
if(P_PMAC_Current_Mode == F_Current_Manual)
{
	// 음극 1차 P&P
	if(P_BTN_Anode_1st_TR_Buffer_Clear == 1 && P_Old_BTN_Anode_1st_TR_Buffer_Clear == 0)
	{
		if(Sys_Anode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Anode_1st_PNP_Vac_Sensor != 1)
			{
				Sys_Anode_1st_Sheet_Data = 0;
				
				// 참조 260604 1차 피커 홈 버그로 인한 극판 뒤집힘 수정
				//PickerT 단방향위치로 변경으로 홈 오프셋 변경부 주석. [ 참조 : 26.09.11 PickerT 모션 변경에 따른 동작 횟수 감시 삭제 ]
				//P_An_Picker_T_Turn_Cnt = 0
				//P_An_Picker_T_Home_Type = 0
			}
		}
		else
		{
			if(M_X_Anode_1st_PNP_Vac_Sensor == 1)
			{
				Sys_Anode_1st_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 음극 2차 P&P
	if(P_BTN_Anode_2nd_TR_Buffer_Clear == 1 && P_Old_BTN_Anode_2nd_TR_Buffer_Clear == 0)
	{
		if(Sys_Anode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Anode_2nd_PNP_Vac_Sensor != 1)
			{
				Sys_Anode_2nd_Sheet_Data = 0;
				P_Anode_2nd_PNP_Data_Delete_Set_Flag = 1;
			}
		}
		else
		{
			if(M_X_Anode_2nd_PNP_Vac_Sensor == 1)
			{
				Sys_Anode_2nd_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 음극 얼라인 테이블
	if(P_BTN_Anode_Align_Buffer_Clear == 1 && P_Old_BTN_Anode_Align_Buffer_Clear == 0)
	{
		if(Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Anode_AT_Vac_Sensor != 1)
			{
				Sys_Anode_Align_Sheet_Data = 0;
				P_Anode_Align_Data_Delete_Set_Flag = 1;
			}
		}
		else
		{
			if(M_X_Anode_AT_Vac_Sensor == 1)
			{
				Sys_Anode_Align_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 음극 NG P&P
	if(P_BTN_Anode_NG_TR_Buffer_Clear == 1 && P_Old_BTN_Anode_NG_TR_Buffer_Clear == 0)
	{
		if(Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Anode_NG_PNP_Vac_Sensor != 1)
			{
				Sys_Anode_NG_TR_Sheet_Data = 0;
			}
		}
		else
		{
			if(M_X_Anode_NG_PNP_Vac_Sensor == 1)
			{
				Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 양극 1차 P&P
	if(P_BTN_Cathode_1st_TR_Buffer_Clear == 1 && P_Old_BTN_Cathode_1st_TR_Buffer_Clear == 0)
	{
		if(Sys_Cathode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Cathode_1st_PNP_Vac_Sensor != 1)
			{
				Sys_Cathode_1st_Sheet_Data = 0;
				
				// 참조 260604 피커 홈 타임 초기화 부분 추가
				//PickerT 단방향위치로 변경으로 홈 오프셋 변경부 주석. [ 참조 : 26.09.11 PickerT 모션 변경에 따른 동작 횟수 감시 삭제 ]
				//P_Ca_Picker_T_Turn_Cnt = 0
				//P_Ca_Picker_T_Home_Type = 0
			}
		}
		else
		{
			if(M_X_Cathode_1st_PNP_Vac_Sensor == 1)
			{
				Sys_Cathode_1st_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 양극 2차 P&P
	if(P_BTN_Cathode_2nd_TR_Buffer_Clear == 1 && P_Old_BTN_Cathode_2nd_TR_Buffer_Clear == 0)
	{
		if(Sys_Cathode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Cathode_2nd_PNP_Vac_Sensor != 1)
			{
				Sys_Cathode_2nd_Sheet_Data = 0;
				P_Cathode_2nd_PNP_Data_Delete_Set_Flag = 1;
			}
		}
		else
		{
			if(M_X_Cathode_2nd_PNP_Vac_Sensor == 1)
			{
				Sys_Cathode_2nd_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 양극 얼라인 테이블
	if(P_BTN_Cathode_Align_Buffer_Clear == 1 && P_Old_BTN_Cathode_Align_Buffer_Clear == 0)
	{
		if(Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Cathode_AT_Vac_Sensor != 1)
			{
				Sys_Cathode_Align_Sheet_Data = 0;
				P_Cathode_Align_Data_Delete_Set_Flag = 1;
			}
		}
		else
		{
			if(M_X_Cathode_AT_Vac_Sensor == 1)
			{
				Sys_Cathode_Align_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}

	// 양극 NG P&P
	if(P_BTN_Cathode_NG_TR_Buffer_Clear == 1 && P_Old_BTN_Cathode_NG_TR_Buffer_Clear == 0)
	{
		if(Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
		{
			if(M_X_Cathode_NG_PNP_Vac_Sensor != 1)
			{
				Sys_Cathode_NG_TR_Sheet_Data = 0;
			}
		}
		else
		{
			if(M_X_Cathode_NG_PNP_Vac_Sensor == 1)
			{
				Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE = Hex_Cell_Existence
			}
		}
	}
}

P_Old_BTN_Anode_1st_TR_Buffer_Clear = P_BTN_Anode_1st_TR_Buffer_Clear;
P_Old_BTN_Anode_2nd_TR_Buffer_Clear = P_BTN_Anode_2nd_TR_Buffer_Clear;
P_Old_BTN_Anode_Align_Buffer_Clear = P_BTN_Anode_Align_Buffer_Clear;
P_Old_BTN_Anode_NG_TR_Buffer_Clear = P_BTN_Anode_NG_TR_Buffer_Clear;
P_Old_BTN_Cathode_1st_TR_Buffer_Clear = P_BTN_Cathode_1st_TR_Buffer_Clear;
P_Old_BTN_Cathode_2nd_TR_Buffer_Clear = P_BTN_Cathode_2nd_TR_Buffer_Clear;
P_Old_BTN_Cathode_Align_Buffer_Clear = P_BTN_Cathode_Align_Buffer_Clear;
P_Old_BTN_Cathode_NG_TR_Buffer_Clear = P_BTN_Cathode_NG_TR_Buffer_Clear;

//극판 메모리 관리 실행 [ 참조 : 2025.08.26 자동 생산 상태 관리 프로그램 추가]
// 극판 현황 관리 => Sys_Anode_1st_Sheet_LO_Vision_BYTE 데이터 중 Hex_Cell_Existence하는지 여부에 따라 UI를 켜주고 꺼줌.  
IF ( P_SM_Cell_Memory_Management == 0 )
{

}
// 음극부 극판 메모리 UI 영역
IF ( P_SM_Cell_Memory_Management == 1 )
{
	if(L_Sheet_Info_Update > 100)
	{
		L_Sheet_Info_Update = 0;
	
		call Sheet_Data_Flow.Anode_Cell_Exist(N_Sheet_Data_1st_TR);
		call Sheet_Data_Flow.Anode_Cell_Exist(N_Sheet_Data_2nd_TR);
		call Sheet_Data_Flow.Anode_Cell_Exist(N_Sheet_Data_Align_Table);
		call Sheet_Data_Flow.Anode_Cell_Exist(N_Sheet_Data_NG_TR);
	

		call Sheet_Data_Flow.Cathode_Cell_Exist(N_Sheet_Data_1st_TR);
		call Sheet_Data_Flow.Cathode_Cell_Exist(N_Sheet_Data_2nd_TR);
		call Sheet_Data_Flow.Cathode_Cell_Exist(N_Sheet_Data_Align_Table);
		call Sheet_Data_Flow.Cathode_Cell_Exist(N_Sheet_Data_NG_TR);
	
	}
}

// Status Clear 버튼 누르면 Sheet에 Maint NG
if( P_Status_Clear_Sheet_Maint_Check == 1 )
{
	P_Status_Clear_Sheet_Maint_Check = 0;

	if( Sys_Anode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )				// 음극 얼라인 Sheet 존재하면	
	{
		Sys_Anode_Align_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;					// 음극 얼라인 Sheet Maint NG
	}

	if( Sys_Anode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )				// 음극 2차 PNP Sheet 존재하면	
	{
		Sys_Anode_2nd_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;		 				// 음극 2차 PNP Sheet Maint NG
	}

	// [참조 : 260108 1차 PNP 극판 데이터에 NG 심었을 경우 얼라인 공급 후 NG  PNP가 제거하는데 이때 비전 판정이 OK였으면 OK난 극판을 버려 인덱스 불량 발생하여 수정]
//	if( Sys_Anode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )				// 음극 1차 PNP Sheet 존재하면	
//	{
//		Sys_Anode_1st_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;		 				// 음극 1차 PNP Sheet Maint NG
//	}


	if( Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )				// 음극 NG PNP Sheet 존재하면
	{
		Sys_Anode_NG_TR_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;					// 음극 NG PNP Sheet Maint NG
	}

	if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )			// 양극 얼라인 Sheet 존재하면	
	{
		Sys_Cathode_Align_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;					// 양극 얼라인 Sheet Maint NG
	}

	if( Sys_Cathode_2nd_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )				// 양극 2차 PNP Sheet 존재하면	
	{
		Sys_Cathode_2nd_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;					// 양극 2차 PNP Sheet Maint NG
	}

	// [참조 : 260108 1차 PNP 극판 데이터에 NG 심었을 경우 얼라인 공급 후 NG  PNP가 제거하는데 이때 비전 판정이 OK였으면 OK난 극판을 버려 인덱스 불량 발생하여 수정]
//	if( Sys_Cathode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )				// 양극 1차 PNP Sheet 존재하면	
//	{
//		Sys_Cathode_1st_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;		   			// 양극 1차 PNP Sheet Maint NG
//	}


	if( Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )			// 양극 NG PNP Sheet 존재하면
	{
		Sys_Cathode_NG_TR_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;					// 양극 NG PNP Sheet Maint NG
	}
}


P_MNTR_PLC28_Task_Time(1) = (Sys.Time - P_MNTR_PLC28_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC28_Task_Time(1) > P_MNTR_PLC28_Task_Max_Time )
{
	P_MNTR_PLC28_Task_Max_Time = P_MNTR_PLC28_Task_Time(1);
}

// 테스트용 프로그램
if( P_Sheet_Clear == 1 )
{
	P_Sheet_Clear = 0

	Sys_Cathode_1st_Sheet_Data = 0
	Sys_Cathode_Align_Sheet_Data = 0
	Sys_Cathode_2nd_Sheet_Data = 0
	Sys_Cathode_NG_TR_Sheet_Data = 0

	Sys_Anode_1st_Sheet_Data = 0
	Sys_Anode_Align_Sheet_Data = 0
	Sys_Anode_2nd_Sheet_Data = 0
	Sys_Anode_NG_TR_Sheet_Data = 0
}

close
