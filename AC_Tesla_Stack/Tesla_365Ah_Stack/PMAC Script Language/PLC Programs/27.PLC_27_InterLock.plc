			case N_IL_Robot_CA_2nd_PNP:      // 양극 2차 pnp 로봇 3,21
				If ( M_X_PLC_Cathode_ReelCut_Door_Interlock == 0 || M_X_PLC_Cathode_Small_Door_Close_Signal == 0)		// 릴컷 도어 || 작은 문이 열려 있을 경우. [ 0 : Open, 1 : Close ]
				{
					if( P_IL_Motor_Page == N_2nd_PnP_CA_T  || P_IL_Motor_Page == N_2nd_PnP_CA_Z  )	// 1차 T, 피커 T 
