		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_Clamp_On) == F_ACT_STATUS_ENABLE )							// 이전 Command가 Enable 일 경우.
		{
			P_OLD_Module_Act_Execute_Command_Array(N_Act_Clamp_On) = F_ACT_STATUS_INITIAL;							// 엣지 변수 초기화
		}
	}
//=========================================================//
// 6) [세파첫장 모듈 - Vision 촬상 ]
//=========================================================// 
	if( P_Module_Act_Execute_Command_Array(N_Act_Vision_Check) == F_ACT_STATUS_ENABLE )
	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_Vision_Check) != F_ACT_STATUS_ENABLE )						// 이전 Command가 Enable이 아닐 경우.												
