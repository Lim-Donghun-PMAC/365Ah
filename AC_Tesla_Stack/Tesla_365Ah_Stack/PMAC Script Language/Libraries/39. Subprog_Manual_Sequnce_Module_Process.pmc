			#endif
		}
	break;

	case N_MSA_Cathode_Stack:
		switch(data)
		{
					case N_SEQ_Normal_MSA_No_1:		// 카운트 초기화 및 모터 서보 체크
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Set) = F_ACT_STATUS_ENABLE;										
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_2:		// 모터 위치 확인
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Motor_Pos_Check) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_3:		// 모터 위치 확인
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_Align_Down_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_4:		// 모터 위치 확인
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_PNP_Vacume_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_5:		// 모터 위치 확인
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_Align_Up_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_6:		// 2차 Stack Table 위치 이동
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_Stack_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_7:		// 2차 Stack Down 
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_Stack_Down_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_8:		// Stack Vision Trigger ON
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Vision_Trg_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_9:		// 2차 Stack UP
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_Stack_Up_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_10:		// 2차 스텍 이동
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_2nd_Align_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_11:		// 카운트 증가 및 종료 확인
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_MSA_Move_Cnt) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;
			#ifdef F_MSA_Discharge_Use
			//↓ MSA배출 모드 사용 시
			case N_SEQ_Normal_MSA_No_12:		// 2차 PNP 얼라인 하강(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_13:	// 2차 PNP 얼라인 파기(MSA 완료) 
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_14:	// 2차 PNP 얼라인 상승(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;

			break;

			case N_SEQ_Normal_MSA_No_15:	// 2차 PNP 스텍 위치 이동(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_2nd_Stack_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_16:	// NG PNP 얼라인 이동(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_NG_PNP_Align_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_17:	// NG PNP 얼라인 하강(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_NG_PNP_Align_Down_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_18:	// NG PNP 얼라인 흡착(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_NG_PNP_Vacume_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_19:	// NG PNP 얼라인 상승(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_NG_PNP_Align_Up_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_20:	// NG PNP NGBox 이동(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_21:	// NG PNP NGBox 파기(MSA 완료) 
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_22:	// 2차 PNP 얼라인 테이블 이동(MSA 완료)
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Stack_Discharge_2nd_Align_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;
			#endif
		}
	break;
}
return;

//========================================================//
// 1. 얼라인 탈착 모드 SET
//========================================================//
sub: Set_Align_Take_off(Mode,&rtn)
	 
	P_Module_Manual_Align_Take_Off_Act_Command_Array(0),N_Align_Take_Off_Index_EA = 0;			//얼라인 탈착 모드 도중 Stop 시 배열 초기화가 안되어 Ready 구문이 안타는 상황 발생하여 초기화 해줌
	P_Align_Take_Off_Module_Complete_Bit(0),N_Align_Take_Off_Index_EA = 0;						//얼라인 탈착 모드 모듈 Complete 비트
	P_Module_Align_Take_Off_Act_State_Machine_Array(0),N_Align_Take_Off_Index_EA = 0;			//얼라인 탈착 모드 모듈 스텝 머신

	switch(Mode)
	{
		Case N_Align_AN_Take_Off : 

			P_Buffer_Seqdata_Align_Take_Off_Array(0)  = Mode;							
			P_Buffer_Seqdata_Align_Take_Off_Array(1)  = N_SEQ_Normal_Align_Take_Off_No_1;		//1) 대기위치 확인, 음극 2차 PNP 이동 속도 설정 및 레시피 위치 받아옴 
			P_Buffer_Seqdata_Align_Take_Off_Array(2)  = N_SEQ_Normal_Align_Take_Off_No_2;		//2) 파이널롤러 양극 방향 이동 및 확인 	
			P_Buffer_Seqdata_Align_Take_Off_Array(3)  = N_SEQ_Normal_Align_Take_Off_No_3;		//3) 음극 2차 PNP T축 스텍 위치 이동 및 확인 && 음극 얼라인 테이블 모터 킬 및 잡 체인지 해제     
			
			P_Buffer_Seqdata_Align_Take_Off_Array(4) = N_COMPLETE;					
			
			rtn = N_TRUE;		
		break; 


		Case N_Align_CA_Take_Off :
			
			P_Buffer_Seqdata_Align_Take_Off_Array(0)  = Mode;							
			P_Buffer_Seqdata_Align_Take_Off_Array(1)  = N_SEQ_Normal_Align_Take_Off_No_1;		//1) 대기위치 확인, 음극 2차 PNP 이동 속도 설정 및 레시피 위치 받아옴 
			P_Buffer_Seqdata_Align_Take_Off_Array(2)  = N_SEQ_Normal_Align_Take_Off_No_2;		//2) 파이널롤러 양극 방향 이동 및 확인 	
			P_Buffer_Seqdata_Align_Take_Off_Array(3)  = N_SEQ_Normal_Align_Take_Off_No_3;		//3) 양극 2차 PNP T축 스텍 위치 이동 및 확인 && 양극 얼라인 테이블 모터 킬 및 잡 체인지 해제  
			
			P_Buffer_Seqdata_Align_Take_Off_Array(4) = N_COMPLETE;					
	
			rtn = N_TRUE;		

		break;


		default:
			rtn = N_FALSE;
		break;
	}
return;

sub: Management_Align_Take_Off(Mode,Index,&data,&rtn)

	rtn = 0;
	if ( P_Buffer_Seqdata_Align_Take_Off_Array(0) == Mode )							//  실행 전 모드 체크
	{																	
		if ( P_Buffer_Seqdata_Align_Take_Off_Array(Index) == N_COMPLETE )			// 인덱스 배열값이 완료 일 경우
		{																 
			data = N_COMPLETE;														// 데이터 완료값 반환
			rtn = N_EXCEPT;															// 예외값 반환
		}																
		else if ( P_Buffer_Seqdata_Align_Take_Off_Array(Index) != 0 )				// 완료도 아니고 0값도 아닐 경우
		{																 
			data = P_Buffer_Seqdata_Align_Take_Off_Array(Index);					// 인덱스 배열값 반환
			rtn = N_TRUE;															// True 반환
		}																
		else															
		{																
			data = 0;																// 인덱스 배열값 0값 반환
			rtn = N_FALSE;															// False  반환
		}															
	}
return;

sub: Precondition_Align_Take_Off(Mode,Index,&rtn)									// 얼라인 테이블 탈착 모드 이전 상태 확인 
rtn = 0;
switch( Mode )
{
//------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// 2. 양/음극 얼라인 탈착 모드 인덱스 반환
//------------------------------------------------------------------------------------------------------------------------------------------------------------------------	
	Case N_Align_AN_Take_Off:
		switch( Index )
		{
			case N_SEQ_Normal_Align_Take_Off_No_1:									
				rtn = N_TRUE;
			break;
			
			case N_SEQ_Normal_Align_Take_Off_No_2:
				if( P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_Ready_Pos_Check) && P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_Ready_Pos_Set))			
				{
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_Align_Take_Off_No_3:
				if( P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_FR_Move) )
				{
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_Align_Take_Off_No_4:
				if( P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_2nd_PNP_Stack_Move) )
				{
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_Align_Take_Off_No_5:
		
				rtn = N_TRUE;
			break;
		
		}
	break;

	Case N_Align_CA_Take_Off:
				switch( Index )
		{
			case N_SEQ_Normal_Align_Take_Off_No_1:									
				rtn = N_TRUE;
			break;
			
			case N_SEQ_Normal_Align_Take_Off_No_2:
				if( P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_Ready_Pos_Check) && P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_Ready_Pos_Set))			
				{
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_Align_Take_Off_No_3:
				if( P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_FR_Move) )
				{
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_Align_Take_Off_No_4:
				if( P_Align_Take_Off_Module_Complete_Bit(N_Align_Take_Off_2nd_PNP_Stack_Move) )
				{
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_Align_Take_Off_No_5:
		
				rtn = N_TRUE;
			break;
		}
	break;
}
return;



sub:Execute_Align_Take_Off(Mode,data,&rtn)
rtn = 0;
switch( Mode )
{
//------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 
// 3. 양/음극 얼라인 탈착 모드 커멘드 배열 
//------------------------------------------------------------------------------------------------------------------------------------------------------------------------	
	case N_Align_AN_Take_Off:
		switch(data)
		{
			case N_SEQ_Normal_Align_Take_Off_No_1:		//대기위치 확인 & 음극 2차 PNP 이동 속도 설정 및 레시피 위치 받아옴 
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_Ready_Pos_Check) = F_ACT_STATUS_ENABLE;		
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_Ready_Pos_Set) = F_ACT_STATUS_ENABLE;								
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_Align_Take_Off_No_2:		// 파이널롤러 회피 방향 이동 및 확인 
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_FR_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_Align_Take_Off_No_3:		// 음극 2차 PNP T축 스텍 위치 이동 및 확인 && 음극 얼라인 테이블 모터 킬 및 잡체인지 해제
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;
		}
	break;

	case N_Align_CA_Take_Off:
		switch(data)
		{
			case N_SEQ_Normal_Align_Take_Off_No_1:		//대기위치 확인 & 음극 2차 PNP 이동 속도 설정 및 레시피 위치 받아옴 
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_Ready_Pos_Check) = F_ACT_STATUS_ENABLE;		
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_Ready_Pos_Set) = F_ACT_STATUS_ENABLE;								
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_Align_Take_Off_No_2:		// 파이널롤러 회피 방향 이동 및 확인 
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_FR_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_Align_Take_Off_No_3:		// 양극 2차 PNP T축 스텍 위치 이동 및 확인 && 양극 얼라인 테이블 모터 킬 및 잡체인지 해제
				P_Module_Manual_Align_Take_Off_Act_Command_Array(N_Align_Take_Off_2nd_PNP_Stack_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;
		}
	break;
}
return;
close



