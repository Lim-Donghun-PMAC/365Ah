			P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_1st_Move) = F_ACT_STATUS_ENABLE;						// 변수 업데이트.
			P_Module_Act_Execute_State_Machine_Array(N_Act_FR_1st_Move) = N_Ready_Step;								// 스텝 머신 실행.
		}	

		L_Subprog_Act_EXECUTE_FR_1st_Move = 0;																		// 반환값 초기화.
		call Subprog_Subprocess_Execute_Act_Module.FR_1st_Move(&L_Subprog_Act_EXECUTE_FR_1st_Move);					// 실행 함수 호출.
		IF ( L_Subprog_Act_EXECUTE_FR_1st_Move == N_COMPLETE )														// 실행 함수 호출 완료 되었을 경우.
		{
			P_Module_Act_Execute_Command_Array(N_Act_FR_1st_Move) = F_ACT_STATUS_DISABLE;							// 시퀀스 완료 시 상태 비활성화.
		}
		ELSE IF ( L_Subprog_Act_EXECUTE_FR_1st_Move == N_FALSE )													// 실행 함수 호출 실패 되었을 경우.
		{
			//P_Suspend_Anode_1TR_Cell_Supply_State_Machine = N_Error_Step; 										// 스탑포인트 에러 처리 할 것 
			P_Module_Act_Execute_Command_Array(N_Act_FR_1st_Move) = F_ACT_STATUS_ALARM;								// 동작 에러.
		}
	}
	else
	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_1st_Move) == F_ACT_STATUS_ENABLE )						// 이전 Command가 Enable 일 경우.
		{
			P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_1st_Move) = F_ACT_STATUS_INITIAL;						// 엣지 변수 초기화
		}
	}

//=========================================================//
// 3) [세파첫장 모듈 - 파이널 롤러 2차 이동 ]
//=========================================================// 
	if( P_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) == F_ACT_STATUS_ENABLE )
	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) != F_ACT_STATUS_ENABLE )						// 이전 Command가 Enable이 아닐 경우.												
		{
			P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) = F_ACT_STATUS_ENABLE;						// 변수 업데이트.
			P_Module_Act_Execute_State_Machine_Array(N_Act_FR_2nd_Move) = N_Ready_Step;								// 스텝 머신 실행.
		}	

		L_Subprog_Act_EXECUTE_FR_2nd_Move = 0;																		// 반환값 초기화.
		call Subprog_Subprocess_Execute_Act_Module.FR_2nd_Move(&L_Subprog_Act_EXECUTE_FR_2nd_Move);					// 실행 함수 호출.
		IF ( L_Subprog_Act_EXECUTE_FR_2nd_Move == N_COMPLETE )														// 실행 함수 호출 완료 되었을 경우.
		{
			P_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) = F_ACT_STATUS_DISABLE;							// 시퀀스 완료 시 상태 비활성화.
		}
		ELSE IF ( L_Subprog_Act_EXECUTE_FR_2nd_Move == N_FALSE )													// 실행 함수 호출 실패 되었을 경우.
		{
			//P_Suspend_Anode_1TR_Cell_Supply_State_Machine = N_Error_Step; 										// 스탑포인트 에러 처리 할 것 
			P_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) = F_ACT_STATUS_ALARM;								// 동작 에러.
		}
	}
	else
	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) == F_ACT_STATUS_ENABLE )						// 이전 Command가 Enable 일 경우.
		{
			P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_2nd_Move) = F_ACT_STATUS_INITIAL;						// 엣지 변수 초기화
		}
	}

//=========================================================//
// 4) [세파첫장 모듈 - 파이널 롤러 하강 ]
//=========================================================// 
	if( P_Module_Act_Execute_Command_Array(N_Act_FR_Down) == F_ACT_STATUS_ENABLE )
	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_FR_Down) != F_ACT_STATUS_ENABLE )							// 이전 Command가 Enable이 아닐 경우.												
