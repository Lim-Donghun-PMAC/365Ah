#define M_Anode_2nd_PNP_Vac_Alarm										P145
#define M_Anode_NG_PNP_Vac_Alarm										P146
#define M_Anode_Align_Vac_Alram											P147

#define M_Cathode_1st_PNP_Blow_Alarm									P150
#define M_Cathode_2nd_PNP_Blow_Alarm									P151
