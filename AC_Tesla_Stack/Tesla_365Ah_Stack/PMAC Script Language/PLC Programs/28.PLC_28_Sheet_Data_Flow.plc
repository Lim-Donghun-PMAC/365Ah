//------------------------------------------------------------------------------------------------------------------------
// [7]. 양극 NG P&P가 Ng place에 파기시
// NG P&P -> NG Place
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_NG_TR_NG_Place_Down_Flag == 1)
{
	P_Cathode_NG_TR_NG_Place_Down_Flag = 0;

	L_Cathode_NG_Place_Timer = 0;
	P_Cathode_NG_TR_NG_Place_Down_State_Machine = 1;
	P_Cathode_NG_TR_NG_Place_Down_Status = F_Status_STARTING;
}

switch(P_Cathode_NG_TR_NG_Place_Down_State_Machine)
{
	case 0 :
		P_Cathode_NG_TR_NG_Place_Down_Status = F_Status_IDLE;
	break;

	case 1 :
		P_Cathode_NG_TR_NG_Place_Down_Status = F_Status_EXECUTE;
		if(L_Cathode_NG_Place_Timer < P_Check_Vac_Time)
		{
			if(Sys_Cathode_NG_TR_Sheet_Data != 0)
			{
				P_Cathode_NG_TR_NG_Place_Down_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 92
			P_Sheet_Err(13)++
			P_Cathode_NG_TR_NG_Place_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Cathode_NG_TR_NG_Place_Down_Status = F_Status_EXECUTE;
		L_Cathode_Func_Return(5) = 0;

		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_NG_TR, N_Sheet_Data_NG_Place, &L_Cathode_Func_Return(5))

		if(L_Cathode_Func_Return(5))
		{
			L_Cathode_Func_Return(5) = 0;
			Sys_Cathode_NG_Place_Sheet_Data = Sys_Cathode_NG_TR_Sheet_Data;
			Sys_Cathode_NG_TR_Sheet_Data = 0;
			P_Send_Cathode_NG_Code_Flag = 1;
			P_Cathode_NG_TR_NG_Place_Down_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Cathode_NG_TR_NG_Place_Down_Status = F_Status_STOPPED;

	break;

	Case N_Complete_Step : 
		P_Cathode_NG_TR_NG_Place_Down_Status = F_Status_COMPLETE;

	break;
	
	default: break;
}
//------------------------------------------------------------------------------------------------------------------------
// [8]. 양극 2차 P&P 얼라인테이블 파기시
// 2차 P&P -> Align Table
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_2nd_TR_Align_Down_Flag == 1)
{
	P_Cathode_2nd_TR_Align_Down_Flag = 0;
	
	L_Cathode_2nd_Align_Down_Timer = 0;				//[ 참조 : 26.10.22 오타 수정 ]
	P_Cathode_2nd_TR_Align_Down_State_Machine = 1;
	P_Cathode_2nd_TR_Align_Down_Status = F_Status_STARTING;
}

switch(P_Cathode_2nd_TR_Align_Down_State_Machine)
{
	case 0:
		P_Cathode_2nd_TR_Align_Down_Status = F_Status_IDLE;
	break;

	case 1:
		P_Cathode_2nd_TR_Align_Down_Status = F_Status_EXECUTE;
		if(L_Cathode_2nd_Align_Down_Timer < P_Check_Vac_Time)	//[ 참조 : 26.10.22 오타 수정 ]
		{
			if(Sys_Cathode_2nd_Sheet_Data != 0)
			{
				P_Cathode_2nd_TR_Align_Down_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 93
			P_Sheet_Err(14)++
			P_Cathode_2nd_TR_Align_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2:
		P_Cathode_2nd_TR_Align_Down_Status = F_Status_EXECUTE;
		L_Cathode_Func_Return(6) = 0;
		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_2nd_TR, N_Sheet_Data_Align_Table, &L_Cathode_Func_Return(6));

		if(L_Cathode_Func_Return(6))
		{
			L_Cathode_Func_Return(6) = 0;
			Sys_Cathode_Align_Sheet_Data = Sys_Cathode_2nd_Sheet_Data;
			Sys_Cathode_2nd_Sheet_Data = 0;
			//P_Send_Cathode_NG_Code_Flag = 1;
			P_Cathode_2nd_TR_Align_Down_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Cathode_2nd_TR_Align_Down_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Cathode_2nd_TR_Align_Down_Status = F_Status_COMPLETE;
	break;
	
	default: break;
}

//------------------------------------------------------------------------------------------------------------------------
// [9]. 양극 1차 P&P 얼라인테이블 픽업시
// Align Table -> 1차 P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_1st_TR_Align_Pick_Up_Flag == 1)
{
	P_Cathode_1st_TR_Align_Pick_Up_Flag = 0;
	
	L_Cathode_1st_Align_Pick_Timer = 0;
	P_Cathode_1st_TR_Align_Pick_Up_State_Machine = 1;
	P_Cathode_1st_TR_Align_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Cathode_1st_TR_Align_Pick_Up_State_Machine)
{
	case 0:
		P_Cathode_1st_TR_Align_Pick_Up_Status = F_Status_IDLE;
	break;

	case 1:
		P_Cathode_1st_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		if(L_Cathode_1st_Align_Pick_Timer < P_Check_Vac_Time)
		{
			if(Sys_Cathode_Align_Sheet_Data != 0)
			{
				P_Cathode_1st_TR_Align_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 38
			P_Sheet_Err(15)++
			P_Cathode_1st_TR_Align_Pick_Up_State_Machine = N_Error_Step;
		}
	break;

	case 2:
		P_Cathode_1st_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		L_Cathode_Func_Return(7) = 0;
		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_Align_Table, N_Sheet_Data_1st_TR,&L_Cathode_Func_Return(7));

		if(L_Cathode_Func_Return(7))
		{
			L_Cathode_Func_Return(7) = 0;
			Sys_Cathode_1st_Sheet_Data = Sys_Cathode_Align_Sheet_Data;
			Sys_Cathode_Align_Sheet_Data = 0;
			
			P_Cathode_1st_TR_Align_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Cathode_1st_TR_Align_Pick_Up_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Cathode_1st_TR_Align_Pick_Up_Status = F_Status_COMPLETE;
	break;
	
	default: break;
}
//===============================================================================================================================================

//===============================================================================================================================================
// MES 보고 영역
//===============================================================================================================================================
// 1. 젤리롤 수량 완료 후 재 가동 시, 얼라인에 있는 죽은 극판 제거를 위해 Starting시 Align에 극판이 있다면, Maint NG비트 살려줘야함.
// 2. Retry NG 시 Surf NG에 대한 비트 살릴때 1차에 Maint NG도 함께 살림
// 3. Belt NG 시 Maint NG 비트 살림
// 4. 강제로 Sheet Data를 On 할 경우, Maint NG비트를 살림

// 음극 데이터 MES 보고
// [ 참조: 26.01.26 Vision 판정 MES 보고 수정 ]
if(P_Send_Anode_NG_Code_Flag == 1)
{
	if(Sys_Anode_NG_Place_Sheet_LO_Vision_BYTE & Hex_Maint_NG)
	{	
		P_Anode_NG_Code = N_Maint_NG_Code;
		P_Send_Anode_NG_Code_To_PLC = P_Receive_Anode_NG_Code_From_PLC;
		P_Anode_Vision_NG_To_PLC_Flag = 1;
	}
	else
	{
		if(Sys_Anode_NG_Place_Sheet_LO_Vision_BYTE & Hex_Vision_Timeout)
		{
			P_Anode_NG_Code = N_TimeOut_NG_Code;
		}
		else
		{
			P_Anode_NG_Code = P_Anode_Vision_To_NG_Code;
		}
		P_Anode_Vision_NG_To_PLC_Flag = 1;
	}
	P_Send_Anode_NG_Code_Flag = 0;
	L_Anode_NG_Code_Delay_Timer = 0;
}

// 양극 데이터 MES 보고
// [ 참조: 26.01.26 Vision 판정 MES 보고 수정 ]
if(P_Send_Cathode_NG_Code_Flag == 1)
{
	if(Sys_Cathode_NG_Place_Sheet_LO_Vision_BYTE & Hex_Maint_NG)
	{
		P_Cathode_NG_Code = N_Maint_NG_Code;
		P_Send_Cathode_NG_Code_To_PLC = P_Receive_Cathode_NG_Code_From_PLC;
		P_Cathode_Vision_NG_To_PLC_Flag = 1;
	}
	else
	{
		if(Sys_Cathode_NG_Place_Sheet_LO_Vision_BYTE & Hex_Vision_Timeout)
		{
			P_Cathode_NG_Code = N_TimeOut_NG_Code;
		}
		else
		{
			P_Cathode_NG_Code = P_Cathode_Vision_To_NG_Code;
		}
		P_Cathode_Vision_NG_To_PLC_Flag = 1;
	}
	P_Send_Cathode_NG_Code_Flag = 0;
	L_Cathode_NG_Code_Delay_Timer = 0;
}

// 음극 시트 NG To PLC 플래그
// [ 참조: 26.01.26 Vision 판정 MES 보고 수정 ]
if(P_Anode_Vision_NG_To_PLC_Flag == 1)
{
	// 300ms 후에
	if(L_Anode_NG_Code_Delay_Timer >= N_NG_Data_Shift_Delay_Time)
	{
		M_Y_PLC_Anode_Sheet_NG = 1;
		L_Anode_NG_Code_Delay_Timer = 0;
		P_Anode_Vision_NG_To_PLC_Flag = 0;
	}
}

// 양극 시트 NG To PLC 플래그
// [ 참조: 26.01.26 Vision 판정 MES 보고 수정 ]
if(P_Cathode_Vision_NG_To_PLC_Flag == 1)
{
	if(L_Cathode_NG_Code_Delay_Timer >= N_NG_Data_Shift_Delay_Time)
	{
		M_Y_PLC_Cathode_Sheet_NG = 1;
		L_Cathode_NG_Code_Delay_Timer = 0;
		P_Cathode_Vision_NG_To_PLC_Flag = 0;
	}
}


// 음극 얼라인, 표면검사 NG I/O 초기화 
//if(M_Y_PLC_Anode_Align_NG == 1 || M_Y_PLC_Anode_Surf_NG == 1)
