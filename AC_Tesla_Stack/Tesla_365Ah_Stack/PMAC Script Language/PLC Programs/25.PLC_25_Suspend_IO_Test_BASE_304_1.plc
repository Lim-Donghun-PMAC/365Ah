//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.06.05 임동훈 선임
// [ 참조 : 25.06.05 Suspend Module 수정 ]
// 진공 파기 모듈 테스트용 코드 추가 [ 참조 : 25.07.02 옵저버 추가 ]
open plc 25
#define	L_System_Timer				Sys.Time			// 시스템 타이머
Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[25].ldata.L[0]	시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[25].ldata.L[1]	시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[25].ldata.L[2]	시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[25].ldata.L[3]	타이머 초기화 플래그
local	L_Reentry(8)
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_PLC01_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_PLC01_System_Timer;
}

// 00.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_PLC01_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{
	// [ 참조 : 25.07.02 옵저버 추가 ]
	P_Test_Vacuum_Timer(0) = P_Test_Vacuum_Timer(0) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(1) = P_Test_Vacuum_Timer(1) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(2) = P_Test_Vacuum_Timer(2) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(3) = P_Test_Vacuum_Timer(3) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(4) = P_Test_Vacuum_Timer(4) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(5) = P_Test_Vacuum_Timer(5) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(6) = P_Test_Vacuum_Timer(6) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Vacuum_Timer(7) = P_Test_Vacuum_Timer(7) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(0) = P_Test_Blow_Timer(0) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(1) = P_Test_Blow_Timer(1) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(2) = P_Test_Blow_Timer(2) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(3) = P_Test_Blow_Timer(3) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(4) = P_Test_Blow_Timer(4) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(5) = P_Test_Blow_Timer(5) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(6) = P_Test_Blow_Timer(6) + L_Time_Cycle_Up_Count_Delta_Time;
	P_Test_Blow_Timer(7) = P_Test_Blow_Timer(7) + L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
// 모니터링 UI Test
// IO 출력에 따른 입력 변화.
// 추후 삭제 예정

// 파이널 롤러 클램프, 언클램프
if( M_Y_SOL_Final_Roll_Sepa_Clamp == 1 && M_Y_SOL_Final_Roll_Sepa_UnClamp == 0 )
{
	M_X_SOL_Final_Roll_Sepa_Clamp = 1;
	M_X_SOL_Final_Roll_Sepa_UnClamp = 0;
}
else
{
	M_X_SOL_Final_Roll_Sepa_Clamp = 0;
	M_X_SOL_Final_Roll_Sepa_UnClamp = 1;
}
// 1차 언로더 그립, 언그립
if( M_Y_1st_Unloader_Grip_Sol == 1 && M_Y_1st_Unloader_UnGrip_Sol == 0 )
{
	M_X_1st_Unloader_Grip_Pressure_Sensor = 1;
	M_X_1st_Unloader_UnGrip_Detect_Sensor = 0;
}
else
{
	M_X_1st_Unloader_Grip_Pressure_Sensor = 0;
	M_X_1st_Unloader_UnGrip_Detect_Sensor = 1;
}
// 시트 페이퍼 진공 ON, OFF
if( M_Y_First_Sheet_Paper_Plate_Ejector_Vac_On == 1 && M_Y_First_Sheet_Paper_Plate_Ejector_Vac_Off == 0 )
{
	M_X_First_Sheet_Paper_Plate_Vac_Sensor = 1;
}
else
{
	M_X_First_Sheet_Paper_Plate_Vac_Sensor = 0;
}
// 커터 전진, 후진
if( M_Y_FR_Sepa_Cutter_Dn_Sol == 1 && M_Y_FR_Sepa_Cutter_Up_Sol == 0 )
{
	M_X_FR_Sepa_Cutter_Dn_Sensor = 1;
	M_X_FR_Sepa_Cutter_Up_Sensor = 0;
}
else
{
	M_X_FR_Sepa_Cutter_Dn_Sensor = 0;
	M_X_FR_Sepa_Cutter_Up_Sensor = 1;
}
// 스텍 테이블 상승, 하강
if( M_Y_ST_Center_Cyl_Up_Sol == 1 && M_Y_ST_Center_Cyl_Dn_Sol == 0 )
{
	M_X_ST_Center_CYL_Up_Sensor = 1;
	M_X_ST_Center_CYL_Dn_Sensor = 0;
}
else
{
	M_X_ST_Center_CYL_Up_Sensor = 0;
	M_X_ST_Center_CYL_Dn_Sensor = 1;
}

if ( M_Y_Final_Roll_Heating == 1 )
{
	M_X_Final_Roll_Heating = 1;
}
else
	M_X_Final_Roll_Heating = 0;


if( M_Y_Discharge_Avoid_Complete == 1 )
{
	M_X_Discharge_Avoid_Complete_Ack = 1;
	M_X_PLC_Unloader_Ready_Pos = 1;
}
else
{
	M_X_Discharge_Avoid_Complete_Ack = 0;
	M_X_PLC_Unloader_Ready_Pos = 0;	
}
if( M_Y_PLC_Unloader_Grip_Request == 1 )
{
	M_X_PLC_Unloader_Grip = 1;
	M_X_PLC_Unloader_Grip_Request_Ack = 1;
}
else if( M_Y_PLC_Unloader_Grip_Request == 0 && P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON) == N_Complete_Step )
{
	M_X_PLC_Unloader_Grip = 0;
	M_X_PLC_Unloader_Grip_Request_Ack = 0;
}

if ( M_Y_1st_Unloader_UnGrip_Complete == 1 )
{
	M_X_1st_Unloader_UnGrip_Ack = 1;
}
else
{
	M_X_1st_Unloader_UnGrip_Ack = 0;
}
M_X_PLC_to_1st_Avoid_Request = 1;


// [ 참조 : 25.07.02 옵저버 추가 ]
// 양극 1차  흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_1st_Cathode) == 1 && L_Reentry(0) == 0 )
{
	L_Reentry(0) = 1;
	P_Test_Vacuum_Timer(0) = 0;
}
else if( P_PLC12_Blow_MNTR(N_1st_Cathode) == 1 && L_Reentry(0) == 1 )
{
	L_Reentry(0) = 0;
	P_Test_Blow_Timer(0) = 0;
}
// 양극 2차  흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_2nd_Cathode) == 1 && L_Reentry(1) == 0 )
{
	L_Reentry(1) = 1;
	P_Test_Vacuum_Timer(1) = 0;
}
else if( P_PLC12_Blow_MNTR(N_2nd_Cathode) == 1 && L_Reentry(1) == 1 )
{
	L_Reentry(1) = 0;
	P_Test_Blow_Timer(1) = 0;
}
// 양극 NG  흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_NG_Cathode) == 1 && L_Reentry(2) == 0 )
{
	L_Reentry(2) = 1;
	P_Test_Vacuum_Timer(2) = 0;
}
else if( P_PLC12_Blow_MNTR(N_NG_Cathode) == 1 && L_Reentry(2) == 1 )
{
	L_Reentry(2) = 0;
	P_Test_Blow_Timer(2) = 0;
}
// 양극 얼라인 흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_Align_Cathode) == 1 && L_Reentry(3) == 0 )
{
	L_Reentry(3) = 1;
	P_Test_Vacuum_Timer(3) = 0;
}
else if( P_PLC12_Blow_MNTR(N_Align_Cathode) == 1 && L_Reentry(3) == 1 )
{
	L_Reentry(3) = 0;
	P_Test_Blow_Timer(3) = 0;
}
// 음극 1차  흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_1st_Anode) == 1 && L_Reentry(4) == 0 )
{
	L_Reentry(4) = 1;
	P_Test_Vacuum_Timer(4) = 0;
}
else if( P_PLC12_Blow_MNTR(N_1st_Anode) == 1 && L_Reentry(4) == 1 )
{
	L_Reentry(4) = 0;
	P_Test_Blow_Timer(4) = 0;
}
// 음극 2차 흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_2nd_Anode) == 1 && L_Reentry(5) == 0 )
{
	L_Reentry(5) = 1;
	P_Test_Vacuum_Timer(5) = 0;
}
else if( P_PLC12_Blow_MNTR(N_2nd_Anode) == 1 && L_Reentry(5) == 1 )
{
	L_Reentry(5) = 0;
	P_Test_Blow_Timer(5) = 0;
}
// 음극 NG 흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_NG_Anode) == 1 && L_Reentry(6) == 0 )
{
	L_Reentry(6) = 1;
	P_Test_Vacuum_Timer(6) = 0;
}
else if( P_PLC12_Blow_MNTR(N_NG_Anode) == 1 && L_Reentry(6) == 1 )
{
	L_Reentry(6) = 0;
	P_Test_Blow_Timer(6) = 0;
}
// 움극 얼라인 흡착 , 블로우
if( P_PLC12_Vacuum_MNTR(N_Align_Anode) == 1 && L_Reentry(7) == 0 )
{
	L_Reentry(7) = 1;
	P_Test_Vacuum_Timer(7) = 0;
}
else if( P_PLC12_Blow_MNTR(N_Align_Anode) == 1 && L_Reentry(7) == 1 )
{
	L_Reentry(7) = 0;
	P_Test_Blow_Timer(7) = 0;
}


// 양극 1차 흡착, 블로우 IO 
if( L_Reentry(0) == 1 && P_Test_Vacuum_Timer(0) > P_Vac_Test_Set_Time(0) )
{
	M_X_Cathode_1st_PNP_Vac_Sensor = 1;
}
else if(  L_Reentry(0) == 0 && P_Test_Blow_Timer(0) > P_Blow_Test_Set_Time(0) )
{
	M_X_Cathode_1st_PNP_Vac_Sensor = 0;
}
// 양극 2차 흡착, 블로우 IO 
if( L_Reentry(1) == 1 && P_Test_Vacuum_Timer(1) > P_Vac_Test_Set_Time(1) )
{
	M_X_Cathode_2nd_PNP_Vac_Sensor = 1;
}
else if(  L_Reentry(1) == 0 && P_Test_Blow_Timer(1) > P_Blow_Test_Set_Time(1) )
{
	M_X_Cathode_2nd_PNP_Vac_Sensor = 0;
}
// 양극 NG 흡착, 블로우 IO 
if( L_Reentry(2) == 1 && P_Test_Vacuum_Timer(2) > P_Vac_Test_Set_Time(2) )
{
	M_X_Cathode_NG_PNP_Vac_Sensor = 1;
}
else if(  L_Reentry(2) == 0 && P_Test_Blow_Timer(2) > P_Blow_Test_Set_Time(2) )
{
	M_X_Cathode_NG_PNP_Vac_Sensor = 0;
}
// 양극 얼라인 흡착, 블로우 IO 
if( L_Reentry(3) == 1 && P_Test_Vacuum_Timer(3) > P_Vac_Test_Set_Time(3) )
{
	M_X_Cathode_AT_Vac_Sensor = 1;
}
else if(  L_Reentry(3) == 0 && P_Test_Blow_Timer(3) > P_Blow_Test_Set_Time(3) )
{
	M_X_Cathode_AT_Vac_Sensor = 0;
}
// 음극 1차 흡착, 블로우 IO 
if( L_Reentry(4) == 1 && P_Test_Vacuum_Timer(4) > P_Vac_Test_Set_Time(4) )
{
	M_X_Anode_1st_PNP_Vac_Sensor = 1;
}
else if(  L_Reentry(4) == 0 && P_Test_Blow_Timer(4) > P_Blow_Test_Set_Time(4) )
{
	M_X_Anode_1st_PNP_Vac_Sensor = 0;
}
// 음극 2차 흡착, 블로우 IO 
if( L_Reentry(5) == 1 && P_Test_Vacuum_Timer(5) > P_Vac_Test_Set_Time(5) )
{
	M_X_Anode_2nd_PNP_Vac_Sensor = 1;
}
else if(  L_Reentry(5) == 0 && P_Test_Blow_Timer(5) > P_Blow_Test_Set_Time(5) )
{
	M_X_Anode_2nd_PNP_Vac_Sensor = 0;
}
// 음극 NG 흡착, 블로우 IO 
if( L_Reentry(6) == 1 && P_Test_Vacuum_Timer(6) > P_Vac_Test_Set_Time(6) )
{
	M_X_Anode_NG_PNP_Vac_Sensor = 1;
}
else if(  L_Reentry(6) == 0 && P_Test_Blow_Timer(6) > P_Blow_Test_Set_Time(6) )
{
	M_X_Anode_NG_PNP_Vac_Sensor = 0;
}
// 음극 얼라인 흡착, 블로우 IO 
if( L_Reentry(7) == 1 && P_Test_Vacuum_Timer(7) > P_Vac_Test_Set_Time(7) )
{
	M_X_Anode_AT_Vac_Sensor = 1;
}
else if(  L_Reentry(7) == 0 && P_Test_Blow_Timer(7) > P_Blow_Test_Set_Time(7) )
{
	M_X_Anode_AT_Vac_Sensor = 0;
}
close
