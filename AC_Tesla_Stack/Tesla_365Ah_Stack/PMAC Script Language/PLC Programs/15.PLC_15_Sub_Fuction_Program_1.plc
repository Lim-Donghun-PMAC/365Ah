//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.04 김준수 선임
// 모듈화 Cycle Stop 

open plc 15

#define	L_System_Timer				Sys.Time		// 시스템 타이머

Local L_PLC15_Time_Cycle_Up_Count_Start_Time;		// Plc[15].ldata.L[0]	시간 체크 시작 시간
Local L_PLC15_Time_Cycle_Up_Count_End_Time;			// Plc[15].ldata.L[1]	시간 체크 종료 시간
Local L_PLC15_Time_Cycle_Up_Count_Delta_Time;		// Plc[15].ldata.L[2]	시작과 종료 시간 사이의 시간
Local L_PLC15_Flag_Cycle_Up_Count_Init_Flag;		// Plc[15].ldata.L[3]	타이머 초기화 플래그
local L_Sub_Interval_Timer;							// Plc[15].ldata.L[4]	서브 프로그램 인터벌 타이머
local L_Sub_Set_Interval_Time=5;					// Plc[15].ldata.L[5]	서브 프로그램 리드 주기 타임
local L_Auto_Sub_Program_Active;					// Plc[15].ldata.L[6]	서브 프로그램 활성화

// 결과값 로컬변수 선언
local L_PLC15_Stopping_CycleStop_Check_Rtn;			// Plc[15].ldata.L[7]
local L_PLC15_Stopping_CycleStop_ActionCmd_Rtn;		// Plc[15].ldata.L[8]
local L_PLC15_Stopping_CycleStop_MNTR_Rtn;			// Plc[15].ldata.L[9]
local L_PLC15_Stopping_CycleStop_Bit_Add_Rtn;		// Plc[15].ldata.L[10]

// 동기화 ( 올드 ) 변수
local L_Old_Stopping_CycleStop_Assy_Bit;			// Plc[15].ldata.L[11]

// 모니터링 변수 
local L_PLC15_Stopping_CycleStop_Precondtion_MNTR;	// Plc[15].ldata.L[12]
local L_CycleStop_Seq_Data;							// Plc[15].ldata.L[13]

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_PLC15_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_PLC15_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_PLC15_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_PLC15_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 00.2) 시간 체크
if( L_PLC15_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_PLC15_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_PLC15_Time_Cycle_Up_Count_Delta_Time = (L_PLC15_Time_Cycle_Up_Count_End_Time - L_PLC15_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_PLC15_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_PLC15_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if (L_PLC15_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	L_PLC15_Time_Cycle_Up_Count_Start_Time = L_PLC15_Time_Cycle_Up_Count_End_Time;
	L_PLC15_Time_Cycle_Up_Count_Delta_Time = 0;
}
//-----------------------------------------------------------------------------------------------------//

if( P_Stopping_CycleStop_Cmd == F_Command_Start )									// 스탑 모듈 실행 - PLC01 Queue 
{																					  
	P_Stopping_CycleStop_Cmd = 0;													// 스탑 모듈 - 커맨드 초기화 (재진입 방지) 
	P_EXECUTE_Status_Prod_Sequence(N_CycleStop_Module) = F_Status_STARTING;			// 스탑 모듈 - 시작 상태 대입																		  

	P_Except_Return_Array(N_PLC15_CycleStop_Set_Seq_Occurs_RTN) = 0;				// 결과 변수 초기화
	call Sub_Automatic_Prod_Sequnce.Set_CycleStop(P_Buffer_Mode_Status_Sequence,&P_Except_Return_Array(N_PLC15_CycleStop_Set_Seq_Occurs_RTN))	 
	if( P_Except_Return_Array(N_PLC15_CycleStop_Set_Seq_Occurs_RTN) == N_TRUE )
	{
		P_Stopping_CycleStop_Seq_Index = 0;
		P_Stopping_CycleStop_State_Machine = N_Ready_Step;							// Cycle Stop모듈 구동 준비 스텝으로 이동		
	}
}	

if( P_Stopping_CycleStop_State_Machine == N_Ready_Step )							// 레디 스텝
{
	P_Stopping_CycleStop_Module_Status = F_Status_EXECUTE;							// CycleStop 진행 상태 업데이트.
	P_Stopping_CycleStop_Seq_Index = P_Stopping_CycleStop_Seq_Index + 1;			// 인덱스 번호 증가.
	
	P_Except_Return_Array(N_PLC15_CycleStop_Manage_Get_RTN) = 0;					// 결과 변수 초기화
	//	↓ 인덱스 업하여 완료를 확인하는 구간
	call Sub_Automatic_Prod_Sequnce.Management_PLC15_Index_Check(P_Buffer_Mode_Status_Sequence, P_Stopping_CycleStop_Seq_Index,&L_CycleStop_Seq_Data,&P_Except_Return_Array(N_PLC15_CycleStop_Manage_Get_RTN))		
	if( P_Except_Return_Array(N_PLC15_CycleStop_Manage_Get_RTN) == N_TRUE )			// 값이 있다면
	{
		P_Stopping_CycleStop_State_Machine = N_Execute_Step;						// Execute_Step 행위 처리 
	}
	else if( P_Except_Return_Array(N_PLC15_CycleStop_Manage_Get_RTN) == N_EXCEPT )	// 완료
	{
		P_Stopping_CycleStop_State_Machine = N_Complete_Step;						// 완료
	}
}

if( P_Stopping_CycleStop_State_Machine == N_Execute_Step )							// 행위처리 스텝
{
	P_Except_Return_Array(N_PLC15_CycleStop_Exe_Seq_RTN) = 0;						// 결과변수 초기화
	// ↓ 스탑 행위 함수 시작 [ 김준수 선임 ]
	call Sub_Common_Function_Cycle_Stop.CycleStop_Execute(P_Stopping_CycleStop_Seq_Index,&P_Except_Return_Array(N_PLC15_CycleStop_Exe_Seq_RTN));
	if( P_Except_Return_Array(N_PLC15_CycleStop_Exe_Seq_RTN) == N_TRUE )			// 결과값을 리턴받았다면
	{
		P_Stopping_CycleStop_State_Machine = N_Ready_Step;							// 레디스텝으로 이동
	}
}
else if( P_Stopping_CycleStop_State_Machine == N_Complete_Step )					// 완료스텝
{
	P_Stopping_CycleStop_Module_Status = F_Status_COMPLETE;							// 완료상태 
	P_EXECUTE_Status_Prod_Sequence(N_CycleStop_Module) = F_Status_COMPLETE;			// 완료상태
	P_Stopping_CycleStop_State_Machine = 0;											// 스텟머신 초기화
}

if( P_Stopping_CycleStop_Init_Flag == N_TRUE )
{
	P_Stopping_CycleStop_Init_Flag = N_FALSE;
	P_Stopping_CycleStop_Module_Status = F_Status_IDLE;								// IDLE 상태
	P_EXECUTE_Status_Prod_Sequence(N_CycleStop_Module) = F_Status_IDLE;				// IDLE 상태
}
close
