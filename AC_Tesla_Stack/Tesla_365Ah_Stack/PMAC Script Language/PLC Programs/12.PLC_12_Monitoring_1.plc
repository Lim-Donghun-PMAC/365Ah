// 드라이런 후 리셋팅 부 홈 재 접속
if( P_Stop_CycleStop_Position == N_Equipment_Initial_Ready_Pos )								// 드라이런 후 리셋팅 시 
{
	P_Stop_CycleStop_Position = 0;																// 초기화
	P_PMAC_Homing_CHK(1),48 = 0;																// 모터 홈 상태 초기화.
	P_Stack_Judgement_Memory = 0;																// HOME RESET 버튼 추가.
}

// 마지막 공정 시 초기화 부분에서 스텍비전이 카운팅 되는 부분이 생겨 버퍼를 초기화 시켜주는 란
// 초기화를 하지 않아야 한다면, 스텍비전 부분에서 마지막 공정부분을 봐주면 될듯싶다.
if( P_PLC12_Continuous_Buffer_Reset_Flag == 1)
{
	P_PLC12_Continuous_Buffer_Reset_Flag = 0;					// 초기화
	P_Anode_Align_NG_Array(0),N_Queue_Max_Size = 0;				// 음극 얼라인 NG 횟수 초기화 
	P_Cathode_Align_NG_Array(0),N_Queue_Max_Size = 0;			// 양극 얼라인 NG 횟수 초기화 
	P_Anode_Surface_NG_Array(0),N_Queue_Max_Size = 0;				// 음극 리트라이 NG 횟수 초기화
	P_Cathode_Surface_NG_Array(0),N_Queue_Max_Size = 0;			// 양극 리트라이 NG 횟수 초기화
	P_Stack_NG_Array(0),N_Queue_Max_Size = 0;					// 스텍 비전 NG 횟수 초기화
}

// QCP Save Data [ 참조 : 2025.10.29 미비사항 추가 건 ]
if( M_X_Trg_SV_Enable_From_PLC == N_TRUE && L_X_Trg_SV_Enable_From_PLC == 0 )		// 버튼이 눌렸을 시
{
	L_X_SV_Enable_Timer = 0;														// 타이머 초기화
	L_X_Trg_SV_Enable_From_PLC = N_TRUE;											// 재진입 방지
	M_Y_Trg_SV_Receive_Complete_To_PLC = N_TRUE;									// Save Qcp 요청 받음 신호 On
}
else if( M_X_Trg_SV_Enable_From_PLC == 0 && L_X_Trg_SV_Enable_From_PLC == N_TRUE )	// 신호가 꺼졌을 시 재진입 방지 변수가 on되었다면
{
	L_X_Trg_SV_Enable_From_PLC = 0;													// 재진입 방지 변수 off
}
if( M_Y_Trg_SV_Receive_Complete_To_PLC == N_TRUE )
{
	if( L_X_SV_Enable_Timer > 100 )
	{
		P_SV_Read_Enable_Flag = 0;													// 읽기 허가 플래그 on
		M_Y_Trg_SV_Receive_Complete_To_PLC = 0;										// 출력신호 off
	}
}

// PLC Trans IN , OUT OFF	→ Monitoring prog에서 OFF 시키자. [ 참조 : Trans IN, OUT 시점 추가 ]
if( M_X_PLC_Trans_IN_Ack == N_TRUE )
	M_Y_PLC_Trans_IN_Signal = 0;
//if( M_X_PLC_Trans_OUT_Ack == N_TRUE )		// 트랜스 아웃 신호 필요 없다고 함.
//	M_Y_PLC_Trans_OUT_Signal = 0;

close

/*	Stack 알고리즘 사용으로 변경함
 // Status Event MNTR====================================================================================================================================================
 if( L_PLC12_Cmd_Event_Status == F_Status_STARTING )																				// Status Event MNTR 시작
 {
	if( L_PMAC_Status != L_PLC12_Old_PMAC_Status )																						// 상태가 변할때 
	{
		L_PLC12_Cmd_Status_Chk_Rtn = 0;																								// 결과 변수 초기화
		call Pattern_Funtion.Status_Check(L_PMAC_Status,&L_Observser_MNTR_Arry(N_Status),&L_PLC12_Cmd_Status_Chk_Rtn);				// 상태 체크 변수 
		if( L_PLC12_Cmd_Status_Chk_Rtn == N_TRUE )
			L_PLC12_Cmd_Data_Event_Status = F_Status_STARTING;																		// Data Event MNTR 시작
		else
			L_PLC12_Cmd_Data_Event_Status = F_Status_STOPPING;																		// Data Event MNTR 중지

		L_PLC12_Old_PMAC_Status = L_PMAC_Status;																							// Privit 상태 변수 동기화
	}
 }
 //======================================================================================================================================================================

 // Data Event MNTR======================================================================================================================================================
 if( L_PLC12_Cmd_Data_Event_Status == F_Status_STARTING )															// Data Event MNTR 시작
 {
	L_PLC12_Cmd_Data_Chk_Rtn = 0;
	call Pattern_Funtion.Data_Check(L_Observser_MNTR_Arry(N_Status),&L_Observser_MNTR_Arry(N_Queue_Data),&L_Observser_MNTR_Arry(N_Step_Data),&L_Observser_MNTR_Arry(N_Index_Data),&L_PLC12_Cmd_Data_Chk_Rtn);	// 데이터 함수 호출 
	if( L_PLC12_Cmd_Data_Chk_Rtn == N_TRUE )
	{
		L_PLC12_Cmd_Update_Status = F_Status_STARTING;																// 업데이트 시작
	}
	else
	{
		L_PLC12_Cmd_Update_Status = F_Status_STOPPING;																// 업데이트 중지
	}
 }
 //======================================================================================================================================================================

  // Data Update MNTR====================================================================================================================================================
 if( L_PLC12_Cmd_Update_Status == F_Status_STARTING )																// Data Update 시작
 {
	P_PLC12_Observser_MNTR(N_Status) = L_Observser_MNTR_Arry(N_Status);												// Monitoring (P변수) 상태 업데이트
	P_PLC12_Observser_MNTR(N_Queue_Data) = L_Observser_MNTR_Arry(N_Queue_Data);										// Monitoring (P변수) 큐 업데이트
	P_PLC12_Observser_MNTR(N_Step_Data) = L_Observser_MNTR_Arry(N_Step_Data);										// Monitoring (P변수) 스텝 업데이트
	P_PLC12_Observser_MNTR(N_Index_Data) = L_Observser_MNTR_Arry(N_Index_Data);										// Monitoring (P변수) 모듈화 Index 업데이트
 }
 //======================================================================================================================================================================

