sub: ARC_NamePlate_Ready_Status(&rtn)	// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
	local L_Return = 0;
	//local L_Upper_ARC_Home = M_X_Sepa_Driving_Roll_UnClamp_Sensor & M_X_Sepa_Upper_ARC_Up_Sensor & M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front & M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear & M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor & M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor & M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor;
	//local L_Lower_ARC_Home = M_X_Sepa_Driving_Roll_UnClamp_Sensor & M_X_Sepa_Lower_ARC_Dn_Sensor & M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front & M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear & M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor & M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor & M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor;
	// 플레이트 후진 & 언틸팅 & 커터 후진 센서 확인.
	local L_Upper_ARC_Home = M_X_Sepa_Upper_ARC_Up_Sensor & M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front & M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear & M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor & M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor & M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor;
	local L_Lower_ARC_Home = M_X_Sepa_Lower_ARC_Dn_Sensor & M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front & M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear & M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor & M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor & M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor;
	local L_Return_Data(2) = 0;
	// 상부 하부 구간 나눈 이유
	// PLC ARC READY 신호를 줄지 말지 상부 하부 홈으로 체크하기 위해
	// 3 & 5 주어
	if( L_Upper_ARC_Home )
		L_Return_Data(N_Upper) = N_Upper_Complete;								// ARC Ready BTN 
	if( L_Lower_ARC_Home )
		L_Return_Data(N_Lower) = N_Lower_Complete;								// ARC Ready BTN

	//  3 & 5 = 1 = N_TRUE
	L_Return = L_Return_Data(N_Upper) & L_Return_Data(N_Lower);					// 리턴 데이터

	if( L_Return != N_TRUE )													// 트루가 아니라면
	{
		if( L_Return_Data(N_Upper) == N_Upper_Complete )						// 어퍼값인지
			rtn = N_Upper_Complete;
		else if( L_Return_Data(N_Lower) == N_Lower_Complete )					// 로어값인지
			rtn = N_Lower_Complete;
		else																	// 두개도 아니라면 실패
			rtn = N_FALSE;
	}
	else 
		rtn = L_Return;
return;

sub: ARC_Ready_Check()	// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
	local L_Return = 0;
	call ARC_Motion_State_Function.ARC_NamePlate_Ready_Status(&L_Return);
	
	//if( M_X_ARC_NP_Auto_Reel_Change_Upper )											// 상부 선택이 되어있다면
	//{
		if( L_Return == N_Upper_Complete || L_Return == N_TRUE )					// ARC 기구물 Home Check
		{
			if( M_X_ARC_NP_Upper_Plate_Vac_On == N_TRUE )						// 베큠 on 감지시
			{							
				P_ARC_Ready_Flag(N_Upper) = N_TRUE;									// Ready
				P_Sepa_Initial_Tickness = P_AVRG_Upper_Sepa_Thickness_mm;			// 세파 소요량 계산을 위한 풀 젤리롤 두께
			}
		}
	//}
	
	//if( M_X_ARC_NP_Auto_Reel_Change_Lower )											// 하부 선택이 되어있다면
	//{
		if( L_Return == N_Lower_Complete || L_Return == N_TRUE )					// ARC 기구물 Home Check
		{
			if( M_X_ARC_NP_Lower_Plate_Vac_On == N_TRUE )							// 베큠 on 감지시
			{
				P_ARC_Ready_Flag(N_Lower) = N_TRUE;									// Ready 
				P_Sepa_Initial_Tickness = P_AVRG_Lower_Sepa_Thickness_mm;			// 세파 소요량 계산을 위한 풀 젤리롤 두께
			}
		}
	//}
return;

sub: Monitoring_ARC_Ready_Flag()	// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
	local L_Return = 0;
	call ARC_Motion_State_Function.ARC_NamePlate_Ready_Status(&L_Return);	
	
	if( P_ARC_Ready_Flag(N_Upper) == N_TRUE )										// 레디플래그가 켜져있다면
	{
		if( L_Return == N_FALSE || M_X_ARC_NP_Upper_Plate_Vac_On != N_TRUE )		// 레디 조건이 맞지 않는다면
			P_ARC_Ready_Flag(N_Upper) = N_FALSE;									// 레디플래그 off
	}
	
	if( P_ARC_Ready_Flag(N_Lower) == N_TRUE )										// 레디플래그가 켜져있다면
	{
		if( L_Return == N_FALSE || M_X_ARC_NP_Lower_Plate_Vac_On != N_TRUE )		// 레디 조건이 맞지 않는다면
			P_ARC_Ready_Flag(N_Lower) = N_FALSE;									// 레디플래그 off
	}
return;


sub: Inspec_Sens( unit,upper_sens,lower_sens )

	switch(unit)
	{
		case N_UNWINDER_UPPER:
			if( P_AVRG_Upper_Sepa_Thickness_mm <= P_ARC_Upper_Request_Sepa_Thickness_mm )														// 상부 세파 두께가 교체가 필요 할 경우.
			{
				#ifdef F_Debug_Mode			// 테스트 모드일때
					if( P_AVRG_Lower_Sepa_Thickness_mm <= P_ARC_Lower_Request_Sepa_Thickness_mm )												// 하단 세파 두께가 교체 두께보다 적거나 같다면
					{
						// Lower 잔량 부족 Flag ON.
						P_Spool_Lack_Flag = N_TRUE;
						P_Suspend_ARC_Request_Flag = 0;		// 안전하게 초기화
					}
					else 
					{
						P_Suspend_ARC_Request_Flag = 1;																		// ARC 요구 플래그 on
						P_Spool_Lack_Flag = N_FALSE;
					}
				#else						// 실제 장비일때
					P_Suspend_ARC_Request_Flag = 1;																			// ARC 요구 플래그 on
					if( P_AVRG_Lower_Sepa_Thickness_mm <= P_ARC_Lower_Request_Sepa_Thickness_mm )												// 하단 세파 두께가 교체 두께보다 적거나 같다면 (교체 불가)
					{
						P_Spool_Lack_Flag = N_TRUE;																			// 하단 세파 잔량 부족 플래그 on
					}
					else																									// 하단 세파 두께가 교체 두께보다 많을 경우 (교체 가능)
					{
						P_Spool_Lack_Flag = N_FALSE;																		// 하단 세파 잔량 부족 플래그 off
						// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
						if( P_ARC_Ready_Flag(N_Lower) == N_TRUE && M_Y_Lower_Unwinder_Lock_Sol == N_TRUE )					// 하단 ARC Ready Flag On 확인 후 
						{
							P_Spool_Ready_Enable_Flag = N_TRUE;																// 언와인더 준비 완료 on
						}
						else																								// 하부 준비가 되어있지 않을 경우
						{
							P_Spool_Ready_Enable_Flag = N_FALSE;															// 언와인더 준비 완료 off
						}
					}
				#endif
			}
			else 																											// 상부 세파 두께가 교체가 필요 하지 않을 경우.
			{
				P_Suspend_ARC_Request_Flag = 0;
				P_Spool_Lack_Flag = N_FALSE;
				P_Spool_Ready_Enable_Flag = N_TRUE;			// [ 참조 : 26.04.28 연속 생산 시 ARC 레디 플래그로 인해 스탑나는 버그 수정 ]
			}
		break;

		case N_UNWINDER_LOWER:
			if( P_AVRG_Lower_Sepa_Thickness_mm <= P_ARC_Lower_Request_Sepa_Thickness_mm )														// 하부 세파 두께가 교체가 필요 할 경우.
			{
				#ifdef F_Debug_Mode			// 테스트 모드일때
					if( P_AVRG_Upper_Sepa_Thickness_mm <= P_ARC_Upper_Request_Sepa_Thickness_mm )												// 상단 세파 두께가 교체 두께보다 적거나 같다면
					{
						// Lower 잔량 부족 Flag ON.
						P_Spool_Lack_Flag = N_TRUE;
						P_Suspend_ARC_Request_Flag = 0;		// 안전하게 초기화
					}
					else
					{
						P_Spool_Lack_Flag = N_FALSE;
						P_Suspend_ARC_Request_Flag = 1;																							// ARC 요구 플래그 on
					}
				#else						// 실제 장비일때
					P_Suspend_ARC_Request_Flag = 1;																			// ARC 요구 플래그 on
					if( P_AVRG_Upper_Sepa_Thickness_mm <= P_ARC_Upper_Request_Sepa_Thickness_mm )												// 상단 세파 두께가 교체 두께보다 적거나 같다면 (교체 불가)
					{
						P_Spool_Lack_Flag = N_TRUE;																			// 상단 세파 잔량 부족 플래그 on
					}
					else																									// 상단 세파 두께가 교체 두께보다 많을 경우 (교체 가능)
					{
						P_Spool_Lack_Flag = N_FALSE;																		// 상단 세파 잔량 부족 플래그 off
						// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
						if( P_ARC_Ready_Flag(N_Upper) == N_TRUE && M_Y_Upper_Unwinder_Lock_Sol == N_TRUE )					// 상단 ARC Ready Flag On 확인 후 
						{
							P_Spool_Ready_Enable_Flag = N_TRUE;																// 언와인더 준비 완료 on
						}
						else																								// 상부 준비가 되어있지 않을 경우
						{
							P_Spool_Ready_Enable_Flag = N_FALSE;															// 언와인더 준비 완료 off
						}
					}
				#endif
			}
			else
			{
				P_Suspend_ARC_Request_Flag = 0;
				P_Spool_Lack_Flag = N_FALSE;
				P_Spool_Ready_Enable_Flag = N_TRUE;			// [ 참조 : 26.04.28 연속 생산 시 ARC 레디 플래그로 인해 스탑나는 버그 수정 ]
			}
		break;
	}

return;

close

open subprog Suspend_Debug(void)
//=====================================================================================//
// 배출 - Error 발생 시 디버깅 함수 실행.		[ 참조 : 25.09.12 Suspend 디버깅 함수 추가 ]
//=====================================================================================//
	Sub:Discharge_Debug_Init(Index)
		P_Suspend_Discharge_Debug_Value(0),5 = 0;					// 초기화.
		call Suspend_Debug.Debug_Discharge_Index_Update(Index)
		P_Suspend_Discharge_Debug_Address(1) = &P_Module_Act_State_Machine_Array(P_Discharge_Debug_Index_1);	
		P_Suspend_Discharge_Debug_Address(2) = &P_Module_Act_State_Machine_Array(P_Discharge_Debug_Index_2);	
		P_Suspend_Discharge_Debug_Address(3) = &P_Module_Act_State_Machine_Array(P_Discharge_Debug_Index_3);																		 
		P_Suspend_Discharge_Debug_Address(4) = &P_Module_Act_State_Machine_Array(P_Discharge_Debug_Index_4);																		 
	return;
	
	Sub:Debug_Discharge_Index_Update(Index)
		Switch(Index)
		{
			case 1:
				P_Discharge_Debug_Index_1 = N_Act_FR_Clamp_OFF;
				P_Discharge_Debug_Index_2 = N_Act_Discharge_Master_Coord_Pause;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 2:
				P_Discharge_Debug_Index_1 = N_Act_FR_Discharge_Pos;
				P_Discharge_Debug_Index_2 = N_Act_First_Unloader_Grip_OFF;
				P_Discharge_Debug_Index_3 = N_Act_First_Unloader_UP;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 3:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_FWD;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 4:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Grip_Cell_Pos;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 5:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Grip_ON;
				P_Discharge_Debug_Index_2 = N_Act_Sheet_Paper_BWD;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 6:
				P_Discharge_Debug_Index_1 = N_Act_Cathode_Clamp_OFF;
				P_Discharge_Debug_Index_2 = N_Act_Sepa_Cutter_Heating;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 7:
				P_Discharge_Debug_Index_1 = N_Act_FR_Clamp_ON;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 8:
				P_Discharge_Debug_Index_1 = N_Act_Sepa_Cutter_Cylinder_FWD;
				P_Discharge_Debug_Index_2 = N_Act_Sheet_Paper_Vacuum_ON;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 9:
				P_Discharge_Debug_Index_1 = N_Act_Sepa_Cutter_Cylinder_BWD;
				P_Discharge_Debug_Index_2 = N_Act_First_Unloader_BWD_Wait_Pos;
				P_Discharge_Debug_Index_3 = N_Act_Discharge_Master_Coord_Resume;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 10:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_BWD;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 11:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Stack_Down;
				P_Discharge_Debug_Index_2 = N_Act_FR_Stack_Pos;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = N_Act_After_Action_Init;
			break;
			
			case 12:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Turn;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 13:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Pos_Chk;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 14:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Handover_Pos;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 15:
				P_Discharge_Debug_Index_1 = N_Act_Unloader_Grip_ON_to_Grip_Off;
				P_Discharge_Debug_Index_2 = 0;;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
			
			case 16:
				P_Discharge_Debug_Index_1 = N_Act_First_Unloader_Wait_Pos;
				P_Discharge_Debug_Index_2 = 0;
				P_Discharge_Debug_Index_3 = 0;
				P_Discharge_Debug_Index_4 = 0;
			break;
		}
	return;
																																
	Sub:Suspend_Discharge_Debug_Save(void)																						
		P_Suspend_Discharge_Debug_Value(1) = P(P_Suspend_Discharge_Debug_Address(1));		// 디버깅 변수에 업데이트.									
		P_Suspend_Discharge_Debug_Value(2) = P(P_Suspend_Discharge_Debug_Address(2));		// 디버깅 변수에 업데이트.							
		P_Suspend_Discharge_Debug_Value(3) = P(P_Suspend_Discharge_Debug_Address(3));		// 디버깅 변수에 업데이트.
		P_Suspend_Discharge_Debug_Value(4) = P(P_Suspend_Discharge_Debug_Address(4));		// 디버깅 변수에 업데이트.
	return;
																																
//=====================================================================================//										
// ARC - Error 발생 시 디버깅 함수 실행.		[ 참조 : 25.09.12 Suspend 디버깅 함수 추가 ]																 
//=====================================================================================//										
	Sub:ARC_Debug_Init(Index)
		P_Suspend_ARC_Debug_Value(0),5 = 0;					// 초기화.
		call Suspend_Debug.Debug_ARC_Index_Update(Index)
		P_Suspend_ARC_Debug_Address(1) = &P_Module_Act_State_Machine_Array(P_ARC_Debug_Index_1);	
		P_Suspend_ARC_Debug_Address(2) = &P_Module_Act_State_Machine_Array(P_ARC_Debug_Index_2);	
		P_Suspend_ARC_Debug_Address(3) = &P_Module_Act_State_Machine_Array(P_ARC_Debug_Index_3);																		 
		P_Suspend_ARC_Debug_Address(4) = &P_Module_Act_State_Machine_Array(P_ARC_Debug_Index_4);																		 
	return;
	
	Sub:Debug_ARC_Index_Update(Index)
		Switch(Index)
		{
			case 1:
				P_ARC_Debug_Index_1 = N_Act_ARC_Pre_Act;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 2:
				P_ARC_Debug_Index_1 = N_Dancer_Closed;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 3:
				P_ARC_Debug_Index_1 = N_Act_Use_Plate_FWD;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 4:
				P_ARC_Debug_Index_1 = N_Act_Replace_Plate_Blow_ON;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 5:
				P_ARC_Debug_Index_1 = N_Act_Use_Plate_Clamp_ON;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 6:
				P_ARC_Debug_Index_1 = N_Act_Use_Plate_Cutter_FWD;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 7:
				P_ARC_Debug_Index_1 = N_Act_Use_Plate_Cutter_BWD;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 8:
				P_ARC_Debug_Index_1 = N_Act_Use_Plate_Clamp_OFF;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 9:
				P_ARC_Debug_Index_1 = N_Act_Use_Plate_BWD;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 10:
				P_ARC_Debug_Index_1 = N_Act_Replace_Plate_Blow_OFF;
				P_ARC_Debug_Index_2 = N_Dancer_Open;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 11:
				P_ARC_Debug_Index_1 = N_Act_Spool_Change;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 12:
				P_ARC_Debug_Index_1 = N_Act_ARC_Post_Act;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
			case 13:
				P_ARC_Debug_Index_1 = N_Act_Previous_Spool_Remain_Winding;
				P_ARC_Debug_Index_2 = 0;
				P_ARC_Debug_Index_3 = 0;
				P_ARC_Debug_Index_4 = 0;
			break;
			
		}
	return;
																																
	Sub:Suspend_ARC_Debug_Save(void)																						
		P_Suspend_ARC_Debug_Value(1) = P(P_Suspend_ARC_Debug_Address(1));		// 디버깅 변수에 업데이트.									
		P_Suspend_ARC_Debug_Value(2) = P(P_Suspend_ARC_Debug_Address(2));		// 디버깅 변수에 업데이트.							
		P_Suspend_ARC_Debug_Value(3) = P(P_Suspend_ARC_Debug_Address(3));		// 디버깅 변수에 업데이트.
		P_Suspend_ARC_Debug_Value(4) = P(P_Suspend_ARC_Debug_Address(4));		// 디버깅 변수에 업데이트.
	return;		

//=====================================================================================//										
// Anode_1TR_Supply_Cell - Error 발생 시 디버깅 함수 실행. - [ 참조 : 2025.10.24 SUSPEND 배출 시, 음극 1TR 극판 공급모듈 추가 ]															 
//=====================================================================================//										
	Sub:An_1TR_Supply_Debug_Init(Index)
		P_Suspend_An_1TR_Supply_Debug_Value(0),5 = 0;					// 초기화.
		call Suspend_Debug.Debug_An_1TR_Supply_Cell_Index_Update(Index)
		P_Suspend_An_1TR_Supply_Debug_Address(1) = &P_Module_Act_State_Machine_Array(P_An_1TR_Supply_Debug_Index_1);	
		P_Suspend_An_1TR_Supply_Debug_Address(2) = &P_Module_Act_State_Machine_Array(P_An_1TR_Supply_Debug_Index_2);	
		P_Suspend_An_1TR_Supply_Debug_Address(3) = &P_Module_Act_State_Machine_Array(P_An_1TR_Supply_Debug_Index_3);																		 
		P_Suspend_An_1TR_Supply_Debug_Address(4) = &P_Module_Act_State_Machine_Array(P_An_1TR_Supply_Debug_Index_4);																		 
	return;
	
	Sub:Debug_An_1TR_Supply_Cell_Index_Update(Index)
		Switch(Index)
		{
			case 1:
				P_An_1TR_Supply_Debug_Index_1 = N_Act_1st_Anode_Mem_Pos  ;
				P_An_1TR_Supply_Debug_Index_2 = 0;
				P_An_1TR_Supply_Debug_Index_3 = 0;
				P_An_1TR_Supply_Debug_Index_4 = 0;
			break;
			
			case 2:
				P_An_1TR_Supply_Debug_Index_1 = N_Act_Motion_to_Belt;
				P_An_1TR_Supply_Debug_Index_2 = 0;
				P_An_1TR_Supply_Debug_Index_3 = 0;
				P_An_1TR_Supply_Debug_Index_4 = 0;
			break;
			
			case 3:
				P_An_1TR_Supply_Debug_Index_1 = N_Act_Motion_to_PickUp;
				P_An_1TR_Supply_Debug_Index_2 = 0;
				P_An_1TR_Supply_Debug_Index_3 = 0;
				P_An_1TR_Supply_Debug_Index_4 = 0;
			break;
			
			case 4:
				P_An_1TR_Supply_Debug_Index_1 = N_Act_Motion_to_Ready ;
				P_An_1TR_Supply_Debug_Index_2 = 0;
				P_An_1TR_Supply_Debug_Index_3 = 0;
				P_An_1TR_Supply_Debug_Index_4 = 0;
			break;
							
		}
	return;
																																
	Sub:Suspend_An_1TR_Supply_Debug_Save(void)																						
		P_Suspend_An_1TR_Supply_Debug_Value(1) = P(P_Suspend_An_1TR_Supply_Debug_Address(1));		// 디버깅 변수에 업데이트.									
		P_Suspend_An_1TR_Supply_Debug_Value(2) = P(P_Suspend_An_1TR_Supply_Debug_Address(2));		// 디버깅 변수에 업데이트.							
		P_Suspend_An_1TR_Supply_Debug_Value(3) = P(P_Suspend_An_1TR_Supply_Debug_Address(3));		// 디버깅 변수에 업데이트.
		P_Suspend_An_1TR_Supply_Debug_Value(4) = P(P_Suspend_An_1TR_Supply_Debug_Address(4));		// 디버깅 변수에 업데이트.
	return;		
		
close
