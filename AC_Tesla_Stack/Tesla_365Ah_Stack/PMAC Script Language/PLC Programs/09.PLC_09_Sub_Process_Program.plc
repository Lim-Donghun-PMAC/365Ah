	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}


//=========================================================================================================================
//	13. Automatic Mode - STOPPING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_STOPPING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )
	{	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
		// 프로그램이 실행되었음을 표시
		P_array_CF_Function_Start_Flag = 1;																			// 서브 프로그램 진입 플래그
		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;													// 서브 프로그램 스텟머신 활성화
	}
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;

			case N_PLC09_PackML_Num_1:			// 프로그램 시작
				P_array_CF_Function_Run_Flag = 1;																	// 서브프로그램이 시작됨을 알림

				P_Stop_Save_RTN(0),4 = 0;		// 디버깅 프로그램 반환값 초기화.	[ 참조 : 25.09.12 정지 디버깅 프로그램 추가 ]
				P_Stop_Debug_Flag = 1;			// 디버깅 프로그램 실행.

				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;											// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_2:			// EPC 보정 필요 사항?												// EPC 보정 스텍 촬상 신호 초기화
				//P_Virtical_EPC_Saved_Pos = P_Motor_Current_Pos(27);												// EPC 위치값 저장
				//if ( P_Stop_Save_Total_RTN )	// 디버깅 프로그램 실행 확인.	[ 참조 : 25.09.12 정지 디버깅 프로그램 추가 ]
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;											// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_3:			// STOP QUEUE 완료 확인 
				//[참조: 260223 stopping 진행중인데 stopped로 상태 변경되어 수정]
				if( P_PLC01_STOP_Queue_Complete_Flag == 1 )															// Stop Queue 종료 확인
				{
					//P_BTN_Mode_Change_Stop_Bit = 0;					// 초기화. (진행 중 Auto → Manual로 로터리 스위치를 돌릴 경우)
					P_PackML_Auto_Stop_Bit = 0;						// 초기화. (IDLE, RESETTING 진행 중 Auto → Manual로 로터리 스위치를 돌릴 경우)
					P_BTN_IDLE_Motor_Not_Pos = 0;					// 초기화. (IDLE 상태에서 모터 위치가 바뀔 경우)
					L_PLC09_Auto_Stopping_RTN = 0;
					call Sub_Common_Function.Master_Motion_Program_OFF(&L_PLC09_Auto_Stopping_RTN)					// 모션 OFF 함수 호출
					if( L_PLC09_Auto_Stopping_RTN == N_TRUE )
					{
						P_PLC01_STOP_Queue_Complete_Flag = 0;															// Stop Queue 종료 Flag 초기화
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;									// 다음 스텝으로 이동
					}
				}
				
			break;

			case N_PLC09_PackML_Num_4:			// 타임베이스 원복 
				L_PLC09_Auto_Stopping_RTN = 0;																		// 결과값 초기화
				call Sub_Common_Function.Timbase_OFF(&L_PLC09_Auto_Stopping_RTN);									// 타임베이스 off 함수 호출
				if(	L_PLC09_Auto_Stopping_RTN == N_TRUE )		
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5;										// 다음 스텝으로 이동
				
			break; 

			case N_PLC09_PackML_Num_5:			// 슬레이브 커맨드 초기화 
				L_PLC09_Auto_Stopping_RTN = 0;																		// 결과값 초기화
				call Sub_Common_Function.Slave_Motion_Command_Init(&L_PLC09_Auto_Stopping_RTN);						// 슬레이브 초기화 함수 호출
				if(	L_PLC09_Auto_Stopping_RTN == N_TRUE )
				{
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_6;										// 다음 스텝으로 이동
				}
			break; 

			case N_PLC09_PackML_Num_6:			// 마스터 팔로잉 및 캠테이블 종료  및 케스케이딩 종료
				P_System_Cascading_OFF_Cmd = F_Command_Start;														// 케스케이딩 OFF 커맨드 
			//	P_System_Master_Following_OFF_Cmd = F_Command_Start;												// 마스터팔로잉 OFF 커맨드 	
			//	P_System_CamTable_OFF_Cmd = F_Command_Start;														// 캠테이블 OFF 커맨드
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_7;											// 다음 스텝으로 이동
				//cmd"#19,20hmz"					// Picker T축 hmz 진행. [ 참조 : 25.08.01 PackML 버튼 프로그램 추가 ]
			break; 

			case N_PLC09_PackML_Num_7:			// 마스터 팔로잉 및 캠테이블 종료  및 케스케이딩 종료 확인
			//	if( P_System_Master_Following_OFF_Complete_Flag & P_System_CamTable_OFF_Complete_Flag & P_System_Cascading_OFF_Complete_Flag )
				if( P_System_Cascading_OFF_Complete_Flag == 1 )
				{
					//if ( P_Motor_Current_Pos(N_1st_Picker_CA_T) ~ 0 && P_Motor_Current_Pos(N_1st_Picker_AN_T) ~ 0 )		// Picker T축 현재 위치 확인. [ 참조 : 25.08.01 PackML 버튼 프로그램 추가 ]
					//{
						P_System_Master_Following_OFF_Complete_Flag = 0;
						P_System_CamTable_OFF_Complete_Flag = 0;
						P_System_Cascading_OFF_Complete_Flag = 0;
						// HOME PLC Script 초기화 필요 시 
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8;										// 다음 스텝으로 이동
					//}
				}
			break; 

			case N_PLC09_PackML_Num_8:			// 사이클 정지 모듈 종료 확인		[ 참조 : 26.01.19 사이클 정지 모듈 수정 ]
				if( P_Stopping_CycleStop_Module_Status != F_Status_EXECUTE )
				{
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_9;										// 다음 스텝으로 이동
				}
			break;

			case N_PLC09_PackML_Num_9:			// 종료
				P_Anode_Align_Blow = 0
				P_Cathode_Align_Blow = 0
				P_PLC12_Cathode_Sheet_Pick_Up_Flag = 0;
				P_PLC12_Anode_Sheet_Pick_Up_Flag = 0;
				P_Hold_Anode_Sheet_Pick_Up_Flag = 0;
				P_Hold_Cathode_Sheet_Pick_Up_Flag = 0;
				P_Sepa_To_Normal_Mode_Sync_Flag = 0;																	// [ 참조 : 26.07.31 Pause_Resume 수정 ]	
				// [ 참조 : 26.11.19 연속 NG 알람 시점 변경 ]
				P_Cathode_Align_Continuous_NG_Alarm_Flag = 0;
				P_Anode_Align_Continuous_NG_Alarm_Flag = 0;	
				P_Cathode_Retry_Continuous_NG_Alarm_Flag = 0;
				P_Anode_Retry_Continuous_NG_Alarm_Flag = 0;	

				M_Y_Resume_Stop_Signal = 0;
				// 260611 드라이빙 위치 값이 너무 커지면 터치에 표현되는 값을 넘어 hmz 추가
				CMD"#%d homez",N_DRIVING_ROLL;

				if(P_Buffer_Mode_Status_Sequence == N_Dryrun_Status_Sequence)
				{
					P_PLC15_Sub_Function_Dryrun_Active_Flag = 0;	// 드라이런 경과 시간 플래그 해제
				}

				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_10;											// 스텝 초기화
			break; 

			case N_PLC09_PackML_Num_10 :
				if( M_Y_Resume_Stop_Signal == 0)
				{			
					P_array_CF_Function_Run_Flag = 2;																	// 서브프로그램이 완료를 알림
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;											// 스텝 초기화
				}
				else
					M_Y_Resume_Stop_Signal = 0;
			break;
		}
	}
//------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//------------------------------------------------------------	
	// 3-1) 정상 종료 표시.		
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}

//=========================================================================================================================
//	01.14. Automatic Mode - STOPPED
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_STOPPED )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_STOPPED;
	}
}
//=========================================================================================================================
//	01.15. Automatic Mode - ABORTING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_ABORTING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인)
	{			
		P_array_CF_Function_Start_Flag = 1;																					// 서브 프로그램 진입 플래그
		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;															// 서브 프로그램 스텟머신 활성화
	}
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;

			case N_PLC09_PackML_Num_1:
				//P_Anode_NG_PNP_Vel_Zero_Set = 0			[ 참조 : 26.11.12 NG Box 신호에 따른 처리 수정 ]
				//P_Cathode_NG_PNP_Vel_Zero_Set = 0

				P_Execute_Manage_Mode = 0
				P_array_CF_Function_Run_Flag = 1;																			// 서브 프로그램 시작
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;													// 다음 스텝으로 이동
				// [ 참조 : 260224 Abort 발생 시 모터 Kill 처리]
				M_Y_Abort_Command = 1
				P_Seq_Abort = 1					// 모터 킬!

				M_Y_Sepa_Cutter_SSR_On = 0		// 열선 커터 off
			break;

			case 2 :
				// [ 참조 : 260224 Abort 발생 시 모터 Kill 처리]
				if( P_Seq_Abort == 0 )
				{
					Coord[1].DesTimeBase = Sys.ServoPeriod * ( 100 / 100 );
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;
				}
			break;

			//case N_PLC09_PackML_Num_2:				// 좌표계 OFF
			//	cmd"&1..60a"																								// 좌표계 OFF
			//	sendallcmds																									// 모든 커맨드문 버퍼를 비워냄
			//	while (Ldata.CmdStatus == 1) {}																				// 모든 커맨드문 버퍼가 비워질 때 까지 대기	
			//	P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;													// 다음 스텝으로 이동
			//break;
			//
			//case N_PLC09_PackML_Num_3:			// 모터 Kill
			//	//cmd"#*k";																									// 모터 전체 Off - kill 1..31전체 축 Servo Off
			//	cmd"#5..48k"
			//	sendallcmds																									// 모든 커맨드문 버퍼를 비워냄
			//	while (Ldata.CmdStatus == 1) {}																				// 모든 커맨드문 버퍼가 비워질 때 까지 대기	
			//	P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;													// 다음 스텝으로 이동
			//break; 

			case N_PLC09_PackML_Num_4:			// 마스터 팔로잉 및 캠테이블 종료  및 케스케이딩 종료
				P_System_Cascading_OFF_Cmd = F_Command_Start;																// 케스케이딩 OFF 커맨드 
			//	P_System_Master_Following_OFF_Cmd = F_Command_Start;														// 마스터팔로잉 OFF 커맨드 	
			//	P_System_CamTable_OFF_Cmd = F_Command_Start;																// 캠테이블 OFF 커맨드

				P_Stop_Save_RTN(0),4 = 0;	// 디버깅 프로그램 반환값 초기화.	[ 참조 : 25.09.12 정지 디버깅 프로그램 추가 ]
				P_Stop_Debug_Flag = 1;		// 디버깅 프로그램 실행.

				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5;													// 다음 스텝으로 이동
			break; 

			case N_PLC09_PackML_Num_5:			// 마스터 팔로잉 및 캠테이블 종료  및 케스케이딩 종료 확인
			//	if( P_System_Master_Following_OFF_Complete_Flag & P_System_CamTable_OFF_Complete_Flag & P_System_Cascading_OFF_Complete_Flag )
				if( P_System_Cascading_OFF_Complete_Flag == 1 )
				{
					// HOME PLC Script 초기화 필요 시 
					//if ( P_Stop_Save_Total_RTN )	// 디버깅 프로그램 실행 확인.	[ 참조 : 25.09.12 정지 디버깅 프로그램 추가 ]
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_6;												// 다음 스텝으로 이동
				}
			break; 

			case N_PLC09_PackML_Num_6:			// 마스터 모션 프로그램 플래그 OFF
				// [ 참조 : 260224 Abort 발생 시 모터 Kill 처리]
				if( Coord[1].DesTimeBase == Sys.ServoPeriod * ( 100 / 100 ) )
				{
					L_PLC09_Auto_Aborting_RTN = 0;
					call Sub_Common_Function.Master_Motion_Program_OFF(&L_PLC09_Auto_Aborting_RTN)								// 모션 OFF 함수 호출
					if( L_PLC09_Auto_Aborting_RTN == N_TRUE )
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_7;												// 다음 스텝으로 이동
				}
			break;

			case N_PLC09_PackML_Num_7:			// 타임 베이스 OFF
				L_PLC09_Auto_Aborting_RTN = 0;
				call Sub_Common_Function.Timbase_OFF(&L_PLC09_Auto_Aborting_RTN);											// 타임베이스 off 함수 호출
				if(	L_PLC09_Auto_Aborting_RTN == N_TRUE )	
				{
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8;												// 다음 스텝으로 이동
					L_PLC09_Auto_Aborting_Timer = 0
				}			
			break;

			case N_PLC09_PackML_Num_8:			// 스테이터스 클리어 후 종료
				if( L_PLC09_Auto_Aborting_Timer > 50 )
				{
					P_Anode_Align_Blow = 0
					P_Cathode_Align_Blow = 0
					P_PLC12_Cathode_Sheet_Pick_Up_Flag = 0;
					P_PLC12_Anode_Sheet_Pick_Up_Flag = 0;
					P_Hold_Anode_Sheet_Pick_Up_Flag = 0;
					P_Hold_Cathode_Sheet_Pick_Up_Flag = 0;

					//P_Completion_Watch_Variable(0),N_Serach_Limit,1 = 1;
					//P_Hold_NG_PNP_Remove,11 = 1;
					P_Status_Clear_Flag = 1;																					// 스테이터스 클리어 
	
					// [ 참조 : 260224 Abort 발생 시 모터 Kill 처리]
					P_Blocked_Abort = 0
					M_Y_Abort_Command = 0
					M_Y_Resume_Stop_Signal = 0;
					
					M_Y_FR_Clamping_Sub_Roller_Clamp = 1	
					M_Y_FR_Clamping_Sub_Roller_Unclamp = 0
					M_Y_FR_Sepa_Clamp = 1
					M_Y_FR_Sepa_UnClamp	= 0
					P_Sepa_To_Normal_Mode_Sync_Flag = 0;																	// [ 참조 : 26.07.31 Pause_Resume 수정 ]	

					if(P_Buffer_Mode_Status_Sequence == N_Dryrun_Status_Sequence)
					{
						P_PLC15_Sub_Function_Dryrun_Active_Flag = 0;		// 드라이런 경과 시간 플래그 해제
					}
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_9;													
				}
			break;

			case N_PLC09_PackML_Num_9:
				if( M_Y_Resume_Stop_Signal == 0 )
				{
					// 260611 드라이빙 위치 값이 너무 커지면 터치에 표현되는 값을 넘어 hmz 추가
					CMD"#%d homez",N_DRIVING_ROLL;

					P_array_CF_Function_Run_Flag = 2;
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;													// 스텝 초기화
				}
				else
					M_Y_Resume_Stop_Signal = 0;
			break;
		}
	}
	//-----------------------------------------------------------------------------------------------------
//------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//------------------------------------------------------------	
	// 3-1) 정상 종료 표시.		
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}
//=========================================================================================================================
//	01.16. Automatic Mode - ABORTED
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_ABORTED )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = F_Status_ABORTED;	
	}
}
//=========================================================================================================================
//	01.17. Automatic Mode - CLEARING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Automatic && P_PMAC_Status == F_Status_CLEARING )
{	
	IF ( P_array_CF_Function_Return_Flag != 1 )
	{
		P_PLC09_Common_Command_Flag = 1;
		P_PLC09_Status = P_Check_CLEARING_CF;	
	}
}

//[ 참조 : 25.07.04 EPC 프로그램 신규 추가 ]
//==============================================================================================================================================================
// 02. 메뉴얼 모드 ( MANUAL Mode )
//==============================================================================================================================================================
//=========================================================================================================================
// 02.1. MANUAL Mode - RESETTING ( 운전준비 )
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Manual && P_PMAC_Status == F_Status_RESETTING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )		// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
	{	
		P_array_CF_Function_Start_Flag = 1;																						// 서브 프로그램 진입 플래그																												
		//[참조 : 26.10.22 적층중 작업자가 레시피 변경하여 메모리 타워 오류 발생 시, 인터락 팝업 발생 ]																												
		P_Resetting_First_Approach_Start_Flag = 1;																				// Resetting 진입 확인용 플래그
		P_Resetting_Re_Entry_Step_Count = 0;	
		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;																// 서브 프로그램 스텟머신 활성화
		//P_array_CF_Function_State_Number = 7888;
	}
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;

//			case 7888 :
//				if( Motor[N_1st_PnP_CA_T].HomePos != P_DD_M_Home_ABS_Pos(N_1st_PnP_CA_T) )
//				{
//					P_PMAC_Commands = F_Command_Stop;
//					P_Stop_Cmd_Origin = 150	
//					P_array_CF_Function_State_Number = 444;
//				}
//				if( Motor[N_1st_PnP_AN_T].HomePos != P_DD_M_Home_ABS_Pos(N_1st_PnP_AN_T) )
//				{
//					P_PMAC_Commands = F_Command_Stop;
//					P_Stop_Cmd_Origin = 151	
//					P_array_CF_Function_State_Number = 444;
//				}
//				if( Motor[N_2nd_PnP_CA_T].HomePos != P_DD_M_Home_ABS_Pos(N_2nd_PnP_CA_T) )
//				{
//					P_PMAC_Commands = F_Command_Stop;
//					P_Stop_Cmd_Origin = 152	
//					P_array_CF_Function_State_Number = 444;
//				}
//				if( Motor[N_2nd_PnP_AN_T].HomePos != P_DD_M_Home_ABS_Pos(N_2nd_PnP_AN_T) )
//				{
//					P_PMAC_Commands = F_Command_Stop;
//					P_Stop_Cmd_Origin = 153	
//					P_array_CF_Function_State_Number = 444;
//				}
//				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;	
//			break;



			case N_PLC09_PackML_Num_1:			// 매뉴얼 - 리셋팅 시작 
				
				// 260617 언로더가 젤리롤을 물고 있는 상태에서 양극 2차 PNP가 얼라인보다 +방향에 위치할 경우 충돌 위험으로 알림창 띄움
			//	if(P_Suspend_Discharge_1st_Unloader_JR_Grip == 1 && P_Motor_Current_Pos(N_2nd_PnP_CA_T) >= P_Axis_Ready_Pos(3) + 5)
				// [ 참조 : 260709 양극 2차PNP T축이 대기위치 또는 스텍위치에서 P_Unloder_PNP_Home_IL_Pos 값 보다 벗어나있으면 충돌 위험으로 알림창 띄움 ]
				
				/* 
					턴온 되거나 프로그램 새로 다운로드 할 경우 언로더, 2차 PNP의 위치 확인
					Motor[x].HomeComplete와 홈을 한번 잡았을때 P변수로 확인
					언로더 X,Z,T 전부다 개별 홈 잡으라고 해야하나
				*/ 
				//if( Motor[N_UNLOADER_X].HomeComplete == 0 && Motor[N_UNLOADER_Z].HomeComplete == 0 && Motor[N_UNLOADER_T].HomeComplete == 0 )
				//{
				//	P_PMAC_Commands = F_Command_Stop;
				//	P_Stop_Cmd_Origin = 160;
				//	nop(memset(F_IL_Cdata,0,N_IL_memset_size));
				//	nop(sprintf(F_IL_Cdata," 1st Unloader  "));
				//	nop(sprintf(F_IL_Cdata2," Individual Homing first "));
				//	P_Y_Interlock_Popup_On_Request = 1;					
				//}

				//if( (P_Motor_Current_Pos(N_2nd_PnP_CA_T) >= P_Axis_Ready_Pos(3) + P_Unloder_PNP_Home_IL_Pos) && !(P_Motor_Current_Pos(N_2nd_PnP_CA_T) >= P_Recipe_M03_POS(2) - P_Unloder_PNP_Home_IL_Pos) )
				//{
				//	P_PMAC_Commands = F_Command_Stop;
				//	P_Stop_Cmd_Origin = 160;
				//	nop(memset(F_IL_Cdata,0,N_IL_memset_size));
				//	nop(sprintf(F_IL_Cdata," 2nd PNP "));
				//	nop(sprintf(F_IL_Cdata2," move to Align Table "));
				//	P_Y_Interlock_Popup_On_Request = 1;
				//}
				// 260611 드라이빙 위치 값이 너무 커지면 터치에 표현되는 값을 넘어 hmz 추가
				CMD"#%d homez",N_DRIVING_ROLL;

				P_Execute_Manage_Mode = 0

				P_Stop_Cmd_Origin = 888		//정지 후 재시작을 표현

				// Resetting 시 격벽 무조건 상승
				M_Y_An_Ca_Partition_Down_Sol = 0
				M_Y_An_Ca_Partition_Up_Sol = 1	

				// 세파 커터가 하강 상태일 경우 상승하고 진행하도록 추가
				M_Y_FR_Sepa_Cutter_Dn_Sol = 0;
				M_Y_FR_Sepa_Cutter_Up_Sol = 1;


				// [참조 : 260507 abort 발생 시 초기화 되지 않아 리셋팅 때 초기화 추가]
				M_Y_Vision_Anode_Save_Sheet_Data = 0
				M_Y_Vision_Cathode_Save_Sheet_Data = 0

				//[참조: 260223 stopping 진행중인데 stopped로 상태 변경되어 수정]
				P_PLC01_STOP_Queue_Complete_Flag = 0
				// [ 참조 : 260224 Abort 발생 시 모터 Kill 처리]
				M_Y_Abort_Command = 0
				P_Blocked_Abort = 0

				P_Cathode_NG_PNP_Vel_Zero_Set = 0
				P_Anode_NG_PNP_Vel_Zero_Set = 0

				// [260330 리셋팅 시 스탑포인트 변수 초기화] - abort 발생 시 초기화가 되지 않아 재가동 후 stop 시 스탑 포인트가 풀리지 않아 stopping 무한대기 수정
				P_Hold_Exist_Insp = 0 
				P_Hold_Remove_NG_PNP = 0   
				P_Hold_Remove_Align = 0   
				P_Hold_Remove_2TR = 0   
				P_Hold_Supply_1TR = 0 
				P_Hold_Supply_Align = 0  
				P_Hold_Supply_2TR = 0  
				P_Hold_Semi_Run = 0 


				M_Y_Vision_Anode_Align_Ready = 1;																	// 음극 얼라인 비젼 레디 트리거 발생
				M_Y_Vision_Cathode_Align_Ready = 1;																	// 양극 얼라인 비젼 레디 트리거 발생
				M_Y_Vision_Stack_Ready = 1;																			// 스텍 테이블 비젼 레디 트리거 발생
				
				P_SM_Cathode_Stack_MSA = 0
				P_SM_Anode_Stack_MSA = 0
				P_SM_Cathode_Align_MSA = 0
				P_SM_Anode_Align_MSA = 0
				//[참조 : 260724 2차 클리닝 위치 이동, 얼라인 탈착 모드 시퀀스 수정 ]
				P_Align_Take_Off_Stop_Signal = 0;			//메뉴얼 스탑 시 스탑 플래그 초기화
				P_2nd_PNP_Cleaning_Mode_Cmd = 0;
				P_Align_Take_Off_State_Machine = 0;
				P_Align_Take_Off_Seq_Index=0;
				M_Y_Cathode_AT_Zero_Clamp_Sol = 0;			//Resetting 시 얼라인 테이블 잠금 
				M_Y_Anode_AT_Zero_Clamp_Sol = 0;			//Resetting 시 얼라인 테이블 잠금 

				P_array_CF_Function_Run_Flag = 1;																				// 서브 프로그램 시작을 알리는 Flag
				P_Motion_Target_Position_Complete = 0;																			// 타켓 포지션 레시피값 함수호출 완료비트 초기화
				call Sub_Motion_Target_Position();																				// 타겟포지션에 레시피값 받아오는 함수 실행.
				if( P_Motion_Target_Position_Complete == 1 || P_PLC09_Test_Temp == 1 )										// 타겟포지션 레시피값 완료 비트 확인
				{
					if( P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence )			// 드라이런 모드가 아니라면
					{
						if( P_Tension_Ready_Pass == 0 )
						{
							#ifdef F_Def_Stack_NRT_Sepa_No_Discharge
								P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;
							#else
							if( P_PMAC_Homing_CHK(N_Align_CA_X) & P_PMAC_Homing_CHK(N_Align_CA_Y) & P_PMAC_Homing_CHK(N_Align_CA_T) & P_PMAC_Homing_CHK(N_Align_AN_X) & P_PMAC_Homing_CHK(N_Align_AN_Y) & P_PMAC_Homing_CHK(N_Align_AN_T) )	
							{	//  ↑ 얼라인 테이블 홈 체크 확인 추가
								L_PLC09_Manual_Resetting_RTN = 0;
								call Sub_Common_Function.PackML_Resetting_SheetID_Check(&L_PLC09_Manual_Resetting_RTN);					// 판정 된 얼라인 데이터 삭제 후 원점 복귀 하는 부분이 없으므로 처리하는 함수 
								if( L_PLC09_Manual_Resetting_RTN == N_TRUE )
								{
									P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;											// 다음 스텝으로 이동
								}
							}
							else // 얼라인 테이블 홈 체크가 없다면, 홈잡으러 가야하므로 다음스텝으로 이동
							{
								P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;												// 다음 스텝으로 이동
							}
							#endif
						}
						else if ( P_Tension_Ready_Pass == 1)
						{						
							cmd"#%d j/",N_UNWINDER_UPPER;
							cmd"#%d j/",N_UNWINDER_LOWER;
							cmd"#%d j/",N_SERVO_DANCER;
							P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;
						}
					}
					else
					{
						// 드라이런 모드라면, Spool j/
						cmd"#%d j/",N_UNWINDER_UPPER;
						cmd"#%d j/",N_UNWINDER_LOWER;
						cmd"#%d j/",N_SERVO_DANCER;
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;
					}																																													 
				}
				
			break;	
			
			case N_PLC09_PackML_Num_2:		// ARC 정위치 체크, 댄서 홈 동작 
				P_ARC_Home_Check_RTN = 0;
				call ARC_Motion_State_Function.ARC_Home_Check(&P_ARC_Home_Check_RTN)											// ARC 홈 상태 확인 함수 호출.
				// 임시 주석
				//P_ARC_Home_Check_RTN = N_TRUE
				if( P_ARC_Home_Check_RTN == N_TRUE )
				{
					// Sepa 걸면 텐션레디 보자
					if( P_PMAC_Homing_CHK(N_SERVO_DANCER) == 0 )																// 홈 체크 변수가 없다면 
					{
						// [ 참조 : 2026.02.12 텐션레디 추가 ]
						P_Tension_Ready_Pos_Cmd = F_Command_Start;																// 언와인더 풀어주는 모듈 시작
						P_array_CF_Function_State_Number = N_PLC09_PackML_Dancer_Pre_Wait_Num;									// 선행동작 대기 스텟머신으로 이동
					}
					else
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;												// 다음 스텝으로 이동
				}
				else
				{
					// ARC 매뉴얼 홈 필요 팝업
					//P_SepaArcing_Popup_Flag = 1;
					P_Suspend_ARC_Request_Flag = 0;																				// 수동으로 처리 
					P_PLC09_MNTR = 1;
					P_PMAC_Commands = F_Command_Stop;																			// ARC 홈 안되어있으면 사이클 스탑
					P_Stop_Cmd_Origin = 30
				}
			break;									
	//---------------Cascading 으로 인하여 Resetting 부분에서 처리 --------------------------------------//		
			case N_PLC09_PackML_Dancer_Pre_Wait_Num:		// 세파 찢어짐 방지 선행 동작 대기 구간
				if( P_Tension_Ready_Pos_Status == F_Status_COMPLETE )															// 선행 동작 완료
				{
					P_Tension_Ready_Pos_Status = F_Status_IDLE;
					P_array_CF_Function_State_Number = 3;																		// 3번 스텟머신으로 이동
				}
			break;
	
	// ------------------------------------------------------------------------------------------------//
		case N_PLC09_PackML_Num_3:		// 초기화 필요 부분 초기화
			P_Master_Motion_Program_Flag = 0;																					// 마스터 모션 Flag OFF 
			P_Master_Motion_CycleStop_Flag = 0;																					// 마스터 모션 사이클 정지 플래그 초기화
			
			call Sub_Common_Function.Timbase_OFF(&P_Common_Function_Timbase_OFF_Complete_Bit);									// 타임베이스 해제
			if( P_Common_Function_Timbase_OFF_Complete_Bit == N_TRUE )
			{
				P_Common_Function_Timbase_OFF_Complete_Bit = 0;
				if( P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence )													// 드라이런이 아닐때
				{
					if ( P_Tension_Ready_Pass == 0)
					{
						// Sepa 걸면 텐션레디 보자
						P_System_Cascading_ON_Cmd = F_Command_Start;																// 케스케이딩 커맨드 
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;													// 다음 스텝으로 이동
					}
					else if(P_Tension_Ready_Pass == 1 )
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5
				}
				else																											// 드라이런 이라면
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5;													// 5번 스텝으로 이동
			}
		break;

		case N_PLC09_PackML_Num_4:		// 케스케이딩 완료 확인
			// Sepa 걸면 텐션레디 보자
			if( P_System_Cascading_ON_Complete_Flag == 1 )																		// 케스케이딩 완료 확인 
			{
				P_System_Cascading_ON_Complete_Flag = 0;																		// 플래그 초기화
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5;														// 다음 스텝으로 이동
			}
		break;

		case N_PLC09_PackML_Num_5:		// [ FR Cutter UP ADD ]
			if( M_X_FR_Sepa_Cutter_Up_Sensor == 1 && M_X_FR_Sepa_Cutter_Dn_Sensor == 0 )
			{
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_6;
			}
			else
			{
				M_Y_FR_Sepa_Cutter_Up_Sol = 1;
				M_Y_FR_Sepa_Cutter_Dn_Sol = 0;
			}
		break;

		case N_PLC09_PackML_Num_6:		// [ 참 조 : 2025.11.04 Vision, EPC, Sheetpaper Home check 추가 ]
		    //[참조: 260602 프로그램 빌드 후 EPC 수동 홈 커멘드 실행 추가 ]
		    if ( Motor[N_EPC_SENSOR].HomeComplete == 0 )	//EPC HomeComplete가 0일 경우
			{
				M_Y_EPC_Vertical_Panel_Manual_Signal = 1  //EPC 자동 → 수동 요청
				P_Home_Command(N_EPC_SENSOR) = F_Command_Start //EPC 홈 커멘드 시작

				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_7;
			}
			else // EPC Homecomplete가 1일 경우 
			{
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8; //스텝 8로 이동 
			}
		break;

		case N_PLC09_PackML_Num_7:		// [ 참 조 : 2025.11.04 Vision, EPC, Sheetpaper Home check 추가 ]
		    //[참조: 260602 프로그램 빌드 후 EPC 수동 홈 커멘드 실행 추가 ]
		    if (P_PMAC_Homing_CHK(33) == 1 && Motor[N_EPC_SENSOR].HomeComplete == 1 )	// EPC 홈 체크 및 Home complete 확인 후
			{
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8;
			}
		break;

		case N_PLC09_PackML_Num_8:		// DD Motor Phase Found Check.
		// 가상축으로 페이징 켜도 상관없어서 추가
			if( Motor[N_1st_PnP_CA_T].PhaseFound != N_TRUE )
			{
				P_PWM_Phasing_Start(N_1st_PnP_CA_T) = N_TRUE;
			}
			if( Motor[N_1st_PnP_AN_T].PhaseFound != N_TRUE )
			{
				P_PWM_Phasing_Start(N_1st_PnP_AN_T) = N_TRUE;
			}
			if( Motor[N_2nd_PnP_CA_T].PhaseFound != N_TRUE )
			{
				P_PWM_Phasing_Start(N_2nd_PnP_CA_T) = N_TRUE;
			}
			if( Motor[N_2nd_PnP_AN_T].PhaseFound != N_TRUE )
			{
				P_PWM_Phasing_Start(N_2nd_PnP_AN_T) = N_TRUE;
			}

			P_array_CF_Function_State_Number = N_PLC09_PackML_Num_9;
		break;

		case N_PLC09_PackML_Num_9:
			if(Motor[N_1st_PnP_CA_T].PhaseFound & Motor[N_1st_PnP_AN_T].PhaseFound & Motor[N_2nd_PnP_CA_T].PhaseFound & Motor[N_2nd_PnP_AN_T].PhaseFound)
			{
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_10;
			}
		break;

		// ( P_Modbus_B_All_Home_Status != F_Status_STARTING && P_Modbus_B_All_Home_Status != F_Status_EXECUTE )
		case N_PLC09_PackML_Num_10:		// 모터 전체 홈 커맨드 및 EPC 수동 요청 DIO 처리
		// [ 참조 : 2025.11.06 A열 B열 Home 인터락 ]
		// [ 참조 : 2026.02.12 홈 변경 ]
		// 1차 PNP Home 변경되어 벨트로 안갈테니 반댓열이 무슨 상황이던간에 잡힐수있게 처리함
		// PLC 측에서 언로더 인터락 신호가 들어왔을 경우에 홈 진행 [ 참조: 1차,2차 언로더 회피 시퀀스 ]
			if(M_X_PLC_ULD_Home_Interlock_Signal == 1 || P_ULD_Home_Pass == 1)
			{
				M_Y_EPC_Vertical_Panel_Manual_Signal = 0;																	// EPC 0 수동 1 자동 전환요청 DIO
				P_AH_Home_Status = F_Status_IDLE;																			// 홈 상태 IDLE
				P_Resetting_All_Home_Command = F_Command_Start;																// 전체 홈 커맨드 
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_11;													// 다음 스텝으로 이동
			}
		break;

		case N_PLC09_PackML_Num_11:		// 전체 홈 완료 확인 후 가상축 서보 온
			if( P_AH_Home_Status == F_Status_COMPLETE )																			// 전체 홈 완료 되었다면
			{
				//call Sub_Common_Function.Virtual_Servo_On();																	// 가상축 서보 온 함수 호출
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_12;														// 다음 스텝으로 이동
			}
		break;

		case N_PLC09_PackML_Num_12:		// 가상축 서보 온 확인
			L_PLC09_Manual_Resetting_RTN = 0; 
			call Sub_Common_Function.Virtual_Servo_On_Chk(&L_PLC09_Manual_Resetting_RTN);										// 가상축 서보 온 체크 함수 호출
			//if( L_PLC09_Manual_Resetting_RTN == N_TRUE )																		// 리턴값이 참이라면	
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_13;														// 다음 스텝으로 이동
			
			//else																												// 리턴값이 거짓이라면
			//	P_PMAC_Commands = F_Command_Stop;																				// 사이클 스탑	
		break;

		case N_PLC09_PackML_Num_13:		// Suspend & Hold & Execute 초기화 부분
			
			Call Discharge_Sub_Prog.Interface_Init();																			// PMAC → PLC Interface 초기화.	
			P_Resetting_Init_Module_RTN = 0;		
			Call Sub_Main_Process_Init.Module(&P_Resetting_Init_Module_RTN);
			IF ( P_Resetting_Init_Module_RTN == 1 )
			{
				P_Resetting_Init_Module_RTN = 0;
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_14;
			}

		break;

		case N_PLC09_PackML_Num_14:		// Hold_모듈화 모드 Setting
							
				P_VISION_MSA_Status = 0;																						// 상태 초기화
				P_VISION_MSA_Seq_Index = 0;																						// 인덱스 초기화	
				P_Align_Take_Off_Status = 0;																					// 상태 초기화
				P_Align_Take_Off_Seq_Index = 0;																					// 인덱스 초기화		
				P_Execute_Module_Error = 0;																						// 모듈 정지 초기화		[ 참조 : 26.01.08 Execute 모듈 수정 ]	
				P_Suspend_ARC_Module_Error = 0;																					// 모듈 정지 초기화		[ 참조 : 26.01.08 Suspend 모듈 수정 ]	
				P_Suspend_1st_Supply_Error = 0;																					// 모듈 정지 초기화		[ 참조 : 26.01.08 Suspend 모듈 수정 ]	
				P_Hold_Module_Error = 0;																						// 모듈 정지 초기화		[ 참조 : 26.01.08 Hold 모듈 수정 ]
				P_Flag_Vac_Status_Initialize = 1;								// 흡착 블로우 초기화 
				P_Spool_Lack_Flag = N_FALSE;									// ARC 판단 FLAG 초기화
				P_Spool_Ready_Enable_Flag = N_FALSE;							// ARC 판단 FLAG 초기화
				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_15;														// 다음 스텝으로 이동
		break;

		case N_PLC09_PackML_Num_15:		// 위치 메모리 ON
			P_Memory_Tower_Search_Flag = 1;																						// 설비 위치 업데이트 플래그 on
			P_MemTow_integrated_return = 0;															
			L_PLC09_Manual_Resetting_Timer = 0;
			//[참조 : 26.10.22 적층중 작업자가 레시피 변경하여 메모리 타워 오류 발생 시, 인터락 팝업 발생 ]
			if( P_Resetting_First_Approach_Start_Flag == 1 )	// 리셋팅 첫진입이고,
			{
				if( P_Resetting_Re_Entry_Step_Count > 50 )	
				{
					P_Resetting_First_Approach_Start_Flag = 0;
					P_Resetting_Re_Entry_Step_Count = 0;
					// 임시 Test용 팝업 발생.
					nop(memset(F_IL_Cdata,0,N_IL_memset_size));						
					nop(sprintf(F_IL_Cdata," Recipe change needs to be  verified "));																	
					P_Y_Interlock_Popup_On_Request = 1;

					//call Alarm.Insert_Alarm(N_Alarm_Recipe_Change_Verification_Required, N_High_Alarm_Cycle_Stop);				// 레시피 변경 확인 필요 알람 발생
				}

				P_Resetting_Re_Entry_Step_Count++;
			}
			/*
				세파 라인 추가 필요
			*/
			P_array_CF_Function_State_Number = N_PLC09_PackML_Num_16;															// 다음 스텝으로 이동
		break;

		case N_PLC09_PackML_Num_16:		// 위치 메모리 확인 후 종료
			if( L_PLC09_Manual_Resetting_Timer > 100 )
			{
				//if( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos || P_Unit_integrated_Status == F_Equipment_Anode_Side_Pos || P_Unit_integrated_Status == F_Equipment_Cathode_Side_Pos || P_Unit_integrated_Status == F_Equipment_Isenable_Discharge_Pos )				
				if (  P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos || P_Unit_integrated_Status == F_Equipment_IDLE_Initial_Ready_Pos || P_Unit_integrated_Status == F_Equipment_IDLE_Anode_Side_Pos || P_Unit_integrated_Status == F_Equipment_IDLE_Cathode_Side_Pos || P_Unit_integrated_Status == F_Equipment_Discharge_Stop_Pos || P_Unit_integrated_Status == F_Equipment_Frist_Sepa_Runing_Stop_Pos)		// [ 참조 : 25.09.01 ]	[ 참조 : 26.05.28 세파 첫장 시 클램프 미진행 ]
				{
					if ( P_Unit_integrated_Status == F_Equipment_Initial_Ready_Pos )
					{
						P_Set_Cathode_Align_Zero_Pos = 1
						P_Set_Anode_Align_Zero_Pos = 1
					}

					P_array_CF_Function_Run_Flag = 2;																				// 서브프로그램 완료
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;														// 스텟머신 초기화
				}
				else
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_15;														// 위치메모리 새로 읽기
			}
		break;
		}

	}
//-----------------------------------------------------------------------------------------------------
//------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//------------------------------------------------------------	
	// 3-1) 정상 종료 표시.		
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}
//=========================================================================================================================
//	02.2 MANUAL-STOPPING
//=========================================================================================================================
IF ( P_array_CF_Mode_Name == F_Current_Manual && P_PMAC_Status == F_Status_STOPPING )
{	
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 명령부
//------------------------------------------------------------	
	IF( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )	// 프로그램 허용 플래그 (스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
	{	
		P_array_CF_Function_Start_Flag = 1;																					// 서브 프로그램 진입 플래그
		P_array_CF_Function_State_Number = N_PLC09_PackML_Num_1;															// 서브 프로그램 스텟머신 활성화
	}
	
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 실행부
//-----------------------------------------------------------			
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
	{
		switch( P_array_CF_Function_State_Number )
		{
			case N_PLC09_PackML_Num_0: break;
			
			case N_PLC09_PackML_Num_1:		// 매뉴얼-스타핑 시작
				P_array_CF_Function_Run_Flag = 1;																			// 서브 프로그램이 시작을 알림
				
				P_Stop_Save_RTN(0),4 = 0;	// 디버깅 프로그램 반환값 초기화.	[ 참조 : 25.09.12 정지 디버깅 프로그램 추가 ]
				P_Stop_Debug_Flag = 1;		// 디버깅 프로그램 실행.

				//[참조 : 26.10.22 적층중 작업자가 레시피 변경하여 메모리 타워 오류 발생 시, 인터락 팝업 발생 ]
				P_Resetting_First_Approach_Start_Flag = 0;																	// Resetting 진입 확인용 플래그 초기화
				P_Resetting_Re_Entry_Step_Count = 0;

				P_array_CF_Function_State_Number = N_PLC09_PackML_Num_2;													// 다음 스텝으로 이동
			break;

			case N_PLC09_PackML_Num_2:		// MSA 미동작 및 종료 확인
				//if( P_VISION_MSA_Status == F_Status_EXECUTE || P_VISION_MSA_Status_Prod_Sequence(N_PLC13_VISION_MSA) == F_Status_STARTING || P_Align_Take_Off_Status == F_Status_EXECUTE || P_Align_Take_Off_Status_Prod_Sequence(N_PLC13_Align_Take_Off) == F_Status_STARTING )		// MSA 실행중이라면 Stop point 까지 대기
				//{}
				//else
				//if( P_SM_Cathode_Stack_MSA == 0 && P_SM_Anode_Stack_MSA == 0 && P_SM_Cathode_Align_MSA == 0 && P_SM_Anode_Align_MSA == 0 )
				//{
					if( P_Suspend_Discharge_Module_Status != F_Status_EXECUTE )														// 배출 진행 중이 아닐 경우 모션 프로그램 종료. [ 참조 : 25.07.18 배출 프로그램 조건 수정 ]
					{
						/*
							Sepa Line 유저들 필요시 넣으세요
							Comp_Disable = 1;
						*/
						//if ( P_Stop_Save_Total_RTN )	// 디버깅 프로그램 실행 확인.	[ 참조 : 25.09.12 정지 디버깅 프로그램 추가 ]
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_3;													// 다음 스텝으로 이동
					}
				//}
			break;

			case N_PLC09_PackML_Num_3:
				if( P_Tension_Ready_State_Machine != 0 )	// 텐션레디 중 Stop Cmd가 온다면
				{
					CMD"#%d j/",P_Selected_Spool_Number;
					P_Tension_Ready_State_Machine = 0;
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;
				}
				else										// 텐션레디 진행중이 아니라면
				{
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_4;
				}
			break;

			case N_PLC09_PackML_Num_4:		// 모션 프로그램 OFF
				call Sub_Common_Function.Master_Motion_Program_OFF(&P_Master_Motion_Program_OFF_Complete_Bit);
				if( P_Master_Motion_Program_OFF_Complete_Bit == N_TRUE )
				{
					P_Master_Motion_Program_OFF_Complete_Bit = 0;
					// 배출 I/O 초기화
					L_PLC09_Manual_Stopping_RTN = 0;
					call Discharge_Sub_Prog.Discharge_PackML_Reset(&L_PLC09_Manual_Stopping_RTN);
					if( L_PLC09_Manual_Stopping_RTN == N_TRUE )
					{
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_5;
					}
				}
			break;

			case N_PLC09_PackML_Num_5:
				call Sub_Common_Function.Timbase_OFF(&P_Common_Function_Timbase_OFF_Complete_Bit);									// 타임베이스 해제
				if( P_Common_Function_Timbase_OFF_Complete_Bit == N_TRUE )
				{
					// Spool 좌표계 잡아야함. Spool 타임베이스 맞춰야 조그 속도 가능함
					P_Common_Function_Timbase_OFF_Complete_Bit = 0;
					Coord[1].DesTimeBase = Sys.ServoPeriod * ( 100 / 100 );
					P_System_Cascading_OFF_Cmd = F_Command_Start;
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_6;
				}
			break;

			case N_PLC09_PackML_Num_6:		// 홈 정지 명령 추가 
				if( P_System_Cascading_OFF_Complete_Flag == 1 )
				{
					P_System_Cascading_OFF_Complete_Flag = 0;
					if( P_AH_Home_Status == F_Status_Nonseatus || P_AH_Home_Status == F_Status_COMPLETE )
					{
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8;
					}
					else
					{
						// [ 참조 : 2025.08.18 홈 시퀀스 스탑 보안 ]
						P_Resetting_All_Home_Command = F_Command_Stop;							
						P_array_CF_Function_State_Number = N_PLC09_PackML_Num_7;
					}
				}
			break;

			case N_PLC09_PackML_Num_7:		// 홈 정지 명령 추가 
				if( P_AH_Home_Status == F_Status_STOPPED )
				{ 
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_8;
				}
			break;

			case N_PLC09_PackML_Num_8:		// Stopping 종료
					P_array_CF_Function_Run_Flag = 2;																				// 종료 
					P_array_CF_Function_State_Number = N_PLC09_PackML_Num_0;
			break;
			
	
		}
	}
//------------------------------------------------------------
// 3) 서브프로세스 프로그램 정상종료 및 알람 확인 상태부 ( Observe )
//------------------------------------------------------------	
	// 3-1) 정상 종료 표시.		
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag == 2 )
	{
		// 프로그램이 정상 종료되어 반환을 알림
		P_array_CF_Function_Return_Flag = 1;
	
	}
	// 3-2) 서브프로세스 프로그램 무한루프 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Time > N_Time_Over_Value )
	{
		// 서브프로그램이 무한루프 상태이므로 알람 발생
		// call Alarm
	}
	// 3-3) 서브프로세스 프로그램 내부 문제 알람.
	IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Local_Alarm_Code != 0 )
	{
		// 서브 프로그램에서 문제가 생겨서 알람이 발생
		// call Alarm
	}		
}


