//===============================================================================================
// Motor Page 넘버에 따른 인터락 설계
// 1. Motor Page Num 감지
// 2. Motor 자기 자신 로봇에 의한 외부 로봇 Set
// 3. 내부 로봇 인터락 감시
// 4. 외부 로봇 인터락 감시 
// 5. 레시피 인터락 감시 
// 6. 버튼에 따른 인터락 처리
// 7. 인터락 팝업 처리 
//===============================================================================================

// 1. 도어 인터락 PLC 터치에서 애초에 막음
global  P_InterLock_Motor_Num = 0;
global  P_Recipe_Move_IL_Loop = 12;
global	P_Z_Var = 60;

global	P_No1_Recipe_Pos_IL(53);
global	P_No2_Recipe_Pos_IL(53);
global	P_No3_Recipe_Pos_IL(53);
global	P_No4_Recipe_Pos_IL(53);
global	P_No5_Recipe_Pos_IL(53);
global	P_No6_Recipe_Pos_IL(53);
global	P_No7_Recipe_Pos_IL(53);
global	P_No8_Recipe_Pos_IL(53);
global	P_No9_Recipe_Pos_IL(53);
global	P_No10_Recipe_Pos_IL(53);

global P_Recipe_POS_Interock_M(50);
P_Recipe_POS_Interock_M(0),50,1 = 0

open plc 27

local L_Old_Motor_Page;
local L_Old_Outer_IL_Status;
local L_old_P;
local L_old_M;
local L_Motor_Num;
local L_High_Pos(2);
local L_Num(2);
local L_Use_FR_High_Pos(2);

// 반댓열 1차 PNP 절대 위치 변환 변수 대입
#ifdef F_Def_Stack_A
   P_OP_Side_Ca_PNP_Pos = P_Modbus_B_Cathode_1st_Pos;
   P_OP_Side_An_PNP_Pos = P_Modbus_B_Anode_1st_Pos;
   P_OP_Side_PMAC_Cur_Mode = P_Modbus_B_PMAC_Cur_Mode;
#else // F_Def_Stack_B
   P_OP_Side_Ca_PNP_Pos = P_Modbus_A_Cathode_1st_Pos;
   P_OP_Side_An_PNP_Pos = P_Modbus_A_Anode_1st_Pos;
   P_OP_Side_PMAC_Cur_Mode = P_Modbus_A_PMAC_Cur_Mode;
#endif
/*=========================================================search===========================
내부 인터락 [내 유닛에 관련된 부분 인터락]
//===========================================================================================
[1차 PNP] 		| N_IL_Robot_CA_1st_PNP		| N_IL_Robot_AN_1st_PNP		|
[2차 PNP]		| N_IL_Robot_CA_2nd_PNP		| N_IL_Robot_AN_2nd_PNP		|
[클램프 1]		| N_IL_Robot_CA_Clamp1		| N_IL_Robot_AN_Clamp1		|
[클램프 2]		| N_IL_Robot_CA_Clamp2		| N_IL_Robot_AN_Clamp2		|
[메인]			| N_IL_Robot_Main			| 							|
[파이널 롤]		| N_IL_Robot_Final_Roller	| 							|
[얼라인]			| N_IL_Robot_CA_Align		| N_IL_Robot_AN_Align		|
[NG]			| N_IL_Robot_CA_NG_PNP		| N_IL_Robot_AN_NG_PNP		|
[언로더]			| N_IL_Robot_1st_Unloader	|							|
[시트]			| N_IL_Robot_Sheet_Paper	|							|
//===========================================================================================
외부 인터락 [다른 유닛과 관련된 부분 인터락]
//===========================================================================================
[1차 T]			| case N_1st_PnP_CA_T		| case N_1st_PnP_AN_T		| 						|
[1차 Z]			| case N_1st_PnP_CA_Z		| case N_1st_PnP_AN_Z		| 						|
[피커 T]			| case N_1st_Picker_CA_T	| case N_1st_Picker_AN_T	| 						|
[2차 T]			| case N_2nd_PnP_CA_T		| case N_2nd_PnP_AN_T		| 						|
[2차 Z]			| case N_2nd_PnP_CA_Z		| case N_2nd_PnP_AN_Z		| 						|
[클램프 Y1]		| case N_Clamp_CA_Y1		| case N_Clamp_AN_Y1		| 						|
[클램프 Z1]		| case N_Clamp_CA_Z1		| case N_Clamp_AN_Z1		| 						|
[클램프 Y2]		| case N_Clamp_CA_Y2		| case N_Clamp_AN_Y2		| 						|
[클램프 Z2]		| case N_Clamp_CA_Z2		| case N_Clamp_AN_Z2		| 						|
[메인 Z]			| case N_MAIN_Z				| 							| 						|
[파이널 롤러]	| case N_FINAL_ROLL_X		| case N_FINAL_ROLL_Z		| 						|
[시트 페이퍼]	| case N_SHEET_PAPER_X		| 							| 						|
[양극 얼라인]	| case N_Align_CA_X			| case N_Align_CA_Y			| case N_Align_CA_T		|
[음극 얼라인]	| case N_Align_AN_X			| case N_Align_AN_Y			| case N_Align_AN_T		|
[양극 NG]		| case N_NG_PnP_CA_T		| case N_NG_PnP_AN_T		| 						|
[음극 NG]		| case N_NG_PnP_CA_Z		| case N_NG_PnP_AN_Z		| 						|
[언로더]			| case N_UNLOADER_X			| case N_UNLOADER_Z			| case N_UNLOADER_T		|
//===========================================================================================
*/

// 매뉴얼, 리셋팅 구간이 아닐때만 인터락 활성화.
// P_IL_ON_OFF_Flag = 1 인터락 프로그램 실행, P_IL_ON_OFF_Flag = 0 인터락 프로그램 미실행
//[참조 : 260730 환경안전검수용 인터락 활성화 버튼 추가]
if( P_PMAC_Current_Mode == F_Current_Manual && P_PMAC_Status != F_Status_RESETTING && ( P_X_PLC_Setup_Mode_Check == 0 || P_Interlock_On_Off_Flag == 1 ))      // 매뉴얼 모드일때만 PLC Script 읽기
{
	// 0. Motor Page Num 감지 ==================================================================================================================
	if( P_IL_Motor_Page != L_Old_Motor_Page )					// 모터 페이지가 변경 될 경우.
	{
		P_IL_Function_Cnt = 0;									// 함수 카운트 초기화.
		P_IL_Motor_Home_Chk_RTN = 0;							// 함수 반환값 초기화.
		// ↓ [ 참조 : 26.10.02 인터락 조건 추가 ]
		P_IL_Home_Chk_Edge = 0;									// 내부, 외부 모터 홈 확인 변수 Edge	
		P_Limit_PosData(Hex_IL_Plus) = N_Nan;
		P_Limit_PosData(Hex_IL_Minus) = N_Nan;
		P_Collision_Risk_Motor(Hex_IL_Plus) = 0;
		P_Collision_Risk_Motor(Hex_IL_Minus) = 0;
		P_Plus_IL_Offset = 0;
		P_Minus_IL_Offset = 0;
		P_IL_Robot_Bit = 0;
		// ↑ 모터 페이지 변경 시 초기화 해주기 위함. (같은 유닛끼리 변경 시 아우터 상태가 변경되지 않을 경우 엉뚱한 리밋값이 들어가며 팝업이 나타나는 현상을 막기 위함)
		L_Old_Motor_Page = P_IL_Motor_Page;						// Edge 변수.
		call IL_Robot_Define.Home_Motor_Define(L_Old_Motor_Page,&P_IL_Home_Chk_Motor_Update);		// 내부, 외부 인터락 모터 선언.
	}
	if( P_IL_Home_Chk_Motor_Update == 0 )						// 인터락 모터 미 선언.
	{
		P_IL_Inside_Home_Chk_Complete = 0;						// 내부 모터 홈 확인 변수 초기화.
		P_IL_Outside_Home_Chk_Complete = 0;						// 외부 모터 홈 확인 변수 초기화.
	}
	if( P_IL_Home_Chk_Motor_Update == N_IL_Moter_Update )		// 인터락 모터 선언.
	{
		if( P_Current_Homming_Status(P_IL_Motor_Page) != F_Status_STARTING )							// 홈을 잡는 중일 경우. (개별 홈을 잡을 때 Motor[x].HomeComplete 변수가 꺼지기 때문)
			call IL_Robot_Define.Home_Motor_Check(P_IL_Motor_Home_Chk_RTN, &P_IL_Motor_Home_Chk_RTN);	// 내부, 외부 관련 모터 HomeComplete 확인.
	}
	else if( P_IL_Home_Chk_Motor_Update == N_IL_Motor_Skip )	// 인터락 모터 HomeComplete 확인 미필요.
	{
		P_IL_Inside_Home_Chk_Complete = 1;						// 내부 모터 홈 확인 변수 ON.
		P_IL_Outside_Home_Chk_Complete = 1;						// 외부 모터 홈 확인 변수 ON.

		// Add : 얼라인 Recipe pos 인터락 Lamp 위하여 내부 로봇 감시 필요
		 P_IL_Coord_Robot = 0;									// 로봇 번호 초기화
		 P_IL_Robot_Bit = 0;									// 로봇 인터락 초기화
		 P_IL_Outer_Status = 0;									// 외부 상태 초기화
		 P_IL_Recipe_Bit = 0;									// Recipe Pos InterLock Init
		 P_IL_Popup_Motor = 0;									// 팝업모터 초기화            
		
		 P_Robot_Unit_Serch_Flag = 1;							// 서치 플래그 온
	}
   // 1. Motor Page Num 감지 ==================================================================================================================
	if( P_IL_Motor_Home_Chk_RTN == 1 )							// 내부, 외부 관련 모터 HomeComplete 확인 (모터 페이지 변경되었을 때 무조건 한번 확인 후 인터락 시작하기 위함)
	{
		if( P_IL_Motor_Page == 0 )								// 모터 페이지가 0일 경우.
		{
			P_IL_Coord_Robot = 0;								// 로봇 번호 초기화
			P_IL_Robot_Bit = 0;									// 로봇 인터락 초기화
			P_IL_Outer_Status = 0;								// 외부 상태 초기화
			P_IL_Recipe_Bit = 0;								// Recipe Pos InterLock Init
			P_IL_Home_Chk_Edge = 0;								// 내부, 외부 모터 홈 확인 변수 Edge	// [ 참조 : 26.10.02 인터락 조건 추가 ]
			P_IL_Popup_Motor = 0;								// 팝업모터 초기화            
			P_IL_Home_Chk_Motor_Num(0),20 = 0;
		}
		else													// 모터 페이지가 0이 아닐 경우.
		{
			//if( P_IL_Inside_Home_Chk_Complete == 1 && P_IL_Outside_Home_Chk_Complete == 1 )		// 내부, 외부 모터 홈 확인 변수 ON일 경우.
			if( P_IL_Inside_Home_Chk_Complete == 1 && P_IL_Outside_Home_Chk_Complete == 1 && P_IL_Home_Chk_Edge == 0 )		// 내부, 외부 모터 홈 확인 변수 ON일 경우.	// [ 참조 : 26.10.02 인터락 조건 추가 ]
			{
			   // Motor 번호에 따른 로봇 Setting
			   P_IL_Coord_Robot = 0;							// 로봇 번호 초기화
			   P_IL_Robot_Bit = 0;								// 로봇 인터락 초기화
			   P_IL_Outer_Status = 0;							// 외부 상태 초기화
			   P_IL_Recipe_Bit = 0;								// Recipe Pos InterLock Init
			   P_IL_Popup_Motor = 0;							// 팝업모터 초기화            
			   P_IL_Home_Chk_Edge = 1;							// 내부, 외부 모터 홈 확인 변수 Edge	// [ 참조 : 26.10.02 인터락 조건 추가 ]
			   
			   P_Robot_Unit_Serch_Flag = 1;						// 서치 플래그 온
			}
			//else												// 내부, 외부 모터 홈 확인 변수가 하나라도 꺼져 있을 경우.
			else if ( P_IL_Inside_Home_Chk_Complete != 1 || P_IL_Outside_Home_Chk_Complete != 1 )
			{
				P_IL_Coord_Robot = 0;							// 로봇 번호 초기화
				P_IL_Popup_Motor = N_Home_Miss;                 // 홈 Miss 
				P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;    // 플러스 마이너스 인터락
				P_IL_Outer_Status = IL_Out_Close;				// 외부 상태 초기화
				L_Old_Motor_Page = 0;							// Old Page Num 초기화 하여 계속 팝업 띄우기
				P_IL_Home_Chk_Edge = 0;							// 내부, 외부 모터 홈 확인 변수 Edge	// [ 참조 : 26.10.02 인터락 조건 추가 ]
				P_Interlock_Popup_On_Flag = 1;                  // 팝업 
			}
		}
	}
	//[ 참조 : 260522 : 양음극 릴컷부 도어 오픈 시 1차 PNP 인터락 ]
	if( M_X_PLC_Cathode_ReelCut_Door_Interlock == 0 ||  M_X_PLC_Anode_ReelCut_Door_Interlock == 0 || M_X_PLC_Cathode_Small_Door_Close_Signal == 0 || M_X_PLC_Anode_Small_Door_Close_Signal == 0 )
	{
		P_IL_Popup_Motor = N_Door_Open;
		 //P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;         // 플러스 마이너스 인터락
		 //P_Interlock_Popup_On_Flag = 1;   
	}
	//[참조 : 260601 : 양음극 NG BOX 도어 오픈 시 조그 인터락 ]
	if ( M_X_Cathode_NG_Box_Detect_Sensor == 0 || M_X_Anode_NG_Box_Detect_Sensor == 0) 
	{
		P_IL_Popup_Motor = N_NG_Box_Open;
	}
	if ( Sys_Cathode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence || Sys_Anode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence )
	{//[참조 : 20260716 1차 PNP에 극판 존재 시 피커 T축 인터락 ]
		P_IL_Popup_Motor = N_1st_Cell_Existence;
	}
   // =========================================================================================================================================

   // 2. Motor 자기 자신 로봇에 의한 외부 로봇 Set    ====================================================================================================
   // 외부로봇 홈 체크 필요
   if( P_Robot_Unit_Serch_Flag == 1 )
   {
      P_Robot_Unit_Serch_Flag = 0;
      call IL_Robot_Define.Coord_Robot(P_IL_Motor_Page,&P_IL_Coord_Robot);   // Motor page에 따른 Robot 정의 -> 내부에서 P_IL_Coord_Robot 셀렉함
      //call IL_Robot_Define.Outter(P_IL_Coord_Robot);
   }
   // =========================================================================================================================================
// 3. 내부 로봇 인터락 감시                     
	if ( P_IL_Inside_Home_Chk_Complete == 1 )													// 해당 모터와 연관된 모터의 HomeComplete 확인 [ 0 : 확인 미완료, 1 : 확인 완료 ]
	{
		switch( P_IL_Coord_Robot )																// 내부 로봇.
		{
			case 0:	break;

			case 444:	// 스택 중이여서 움직일수없을때
				P_IL_Popup_Motor = N_JR_Prod_Popup;												// 홈 Miss 
				P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;									// 인터락 비트 ON 
				P_IL_Outer_Status = IL_Out_Close;												// 외부 인터락 닫기
				P_Interlock_Popup_On_Flag = 1;													// 팝업 
			break;  
		   
			case N_IL_Robot_CA_1st_PNP:      // 양극 1차 pnp 로봇 1,17,19 
				If ( M_X_PLC_Cathode_ReelCut_Door_Interlock == 0 || M_X_PLC_Cathode_Small_Door_Close_Signal == 0)		// 릴컷 도어 || 작은 문이 열려 있을 경우. [ 0 : Open, 1 : Close ]
				{
					if( P_IL_Motor_Page == N_1st_PnP_CA_T || P_IL_Motor_Page == N_1st_Picker_CA_T || P_IL_Motor_Page == N_1st_PnP_CA_Z  )      // 1차 T, 피커 T 
					{
						P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
						P_IL_Outer_Status = IL_Out_Close;										// 외부 인터락 닫기
					}
				}
				else if ( (Sys_Cathode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence) && P_IL_Motor_Page == N_1st_Picker_CA_T )			
				{//[참조 : 20260716 1차 PNP에 극판 존재 시 피커 T축 인터락 ]
					P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;								// 플러스, 마이너스 인터락
					P_IL_Outer_Status = IL_Out_Close;											// 외부 인터락 닫기
				}
				//else
				//{
				//	if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Align_Down + 0.01 )		// 얼라인 하강위치보다 하강일 경우.
				//	{
				//	   if( P_IL_Motor_Page == N_1st_PnP_CA_T || P_IL_Motor_Page == N_1st_Picker_CA_T )		// 1차 T, 피커 T  
				//	      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
				//	   else if( P_IL_Motor_Page == N_1st_PnP_CA_Z )								// 1차 Z 
				//	      P_IL_Robot_Bit = Hex_IL_Plus;											// 플러스 인터락
				//
				//	   P_IL_Outer_Status = IL_Out_Close;										// 외부 인터락 닫기
				//	   P_IL_Popup_Motor = N_1st_PnP_CA_Z;										// 인터락 팝업 모터 추가
				//	}  
				//	else if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
				//	{
				//		if( P_IL_Motor_Page == N_1st_PnP_CA_T )									// 1차 T
				//	      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;							// 플러스, 마이너스 인터락
				//	
				//		  P_IL_Outer_Status = IL_Out_Close;										// 외부 인터락 닫기
				//		  P_IL_Popup_Motor = N_1st_PnP_CA_Z;									// 인터락 팝업 모터 추가
				//	}
				//	else if( P_Motor_Current_Pos(N_1st_PnP_CA_T) < P_Axis_Ready_Pos(N_1st_PnP_CA_T) - 10 )   // 1st 벨트쪽
				//	   P_IL_Outer_Status = N_IL_Belt_Pos;										// 벨트 포스 
		   		//
				//	else if( P_Motor_Current_Pos(N_1st_PnP_CA_T) >= P_Recipe_M01_POS(3) - 0.5 && P_Motor_Current_Pos(N_1st_PnP_CA_T) <= P_Recipe_M01_POS(3) + 0.5 )   // 1차 얼라인쪽
				//	   P_IL_Outer_Status = N_IL_Align_Pos;										// 얼라인 포스
		   		//
				//	else																		// 벨트도 아니고 얼라인도 아니면
				//	   P_IL_Outer_Status = N_IL_Normal_Pos;										// 노말 포스          
				//}  
				// [ 참조 : 26.10.02 인터락 조건 추가 ]
				else
				{ 
					if( P_Motor_Current_Pos(N_1st_PnP_CA_T) < P_Axis_Ready_Pos(N_1st_PnP_CA_T) - 10 )   // 1st 벨트쪽
					{ // 1차 PNP 벨트 위치.
						if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Belt_Down - 0.01 )	// 벨트 하강위치보다 하강일 경우.
						{ // 1차 PNP 벨트 하강위치 일 경우.
						   if( P_IL_Motor_Page == N_1st_PnP_CA_T || P_IL_Motor_Page == N_1st_Picker_CA_T )		// 1차 T, 피커 T  
								P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;					// 플러스, 마이너스 인터락
						   else if( P_IL_Motor_Page == N_1st_PnP_CA_Z )							// 1차 Z 
						      P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락
						   
						   P_IL_Outer_Status = N_IL_Belt_Down_Pos;								// 벨트 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
						   P_IL_Popup_Motor = N_1st_PnP_CA_Z;									// 인터락 팝업 모터 추가
						} 	
						else if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{ // 1차 PNP 대기 위치 상승보다 밑에 있을 경우.
							if( P_IL_Motor_Page == N_1st_PnP_CA_T )								// 1차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							  
							  P_IL_Outer_Status = N_IL_Belt_Down_Pos;							// 벨트 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
							  P_IL_Popup_Motor = N_1st_PnP_CA_Z;								// 인터락 팝업 모터 추가
						}									
						else
						{		
							P_IL_Outer_Status = N_IL_Belt_Pos;									// 벨트 포스 
						}
					}
					else if( P_Motor_Current_Pos(N_1st_PnP_CA_T) >= P_Recipe_M01_POS(3) - 0.5 && P_Motor_Current_Pos(N_1st_PnP_CA_T) <= P_Recipe_M01_POS(3) + 0.5 )   // 1차 얼라인쪽
					{ // 1차 PNP 얼라인 위치.
						if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Align_Down - 0.01 )		// 얼라인 하강위치보다 하강일 경우.
						{
						   if( P_IL_Motor_Page == N_1st_PnP_CA_T || P_IL_Motor_Page == N_1st_Picker_CA_T )	// 1차 T, 피커 T  
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
						   else if( P_IL_Motor_Page == N_1st_PnP_CA_Z )							// 1차 Z 
						      P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락

						   P_IL_Outer_Status = N_IL_Align_Down_Pos;								// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
						   P_IL_Popup_Motor = N_1st_PnP_CA_Z;									// 인터락 팝업 모터 추가
						}	
						else if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_1st_PnP_CA_T )								// 1차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							  P_IL_Outer_Status = N_IL_Align_Down_Pos;							// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
							  P_IL_Popup_Motor = N_1st_PnP_CA_Z;								// 인터락 팝업 모터 추가
						}
						else
						{
							 P_IL_Outer_Status = N_IL_Align_Pos;								// 얼라인 포스
						}
					}
					else																		// 벨트도 아니고 얼라인도 아니면
					{	
						if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) >= P_Cathode_1st_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_1st_PnP_CA_T )								// 1차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							  P_IL_Outer_Status = IL_Out_Close;									// 외부 인터락 닫기
							  P_IL_Popup_Motor = N_1st_PnP_CA_Z;								// 인터락 팝업 모터 추가
						}
						else
							P_IL_Outer_Status = N_IL_Normal_Pos;								// 노말 포스 
					}
				}
			break;
		
			case N_IL_Robot_AN_1st_PNP:      // 음극 1차 PnP 로봇 2,18,20
				If ( M_X_PLC_Anode_ReelCut_Door_Interlock == 0 || M_X_PLC_Anode_Small_Door_Close_Signal == 0)
				{
					if( P_IL_Motor_Page == N_1st_PnP_AN_T || P_IL_Motor_Page == N_1st_Picker_AN_T || P_IL_Motor_Page == N_1st_PnP_AN_Z  )      // 1차 T, 피커 T 
