#define F_Anode_1St_FlowChart_Bit		Sys.Udata[20976]	//u.user:$0147C0	음극 1차 P&P 플로우차트 
#define F_Sepa_Unwinder_FlowChart_Bit	Sys.Udata[20977]	//u.user:$0147C4	세파 언와인더 플로우차트 