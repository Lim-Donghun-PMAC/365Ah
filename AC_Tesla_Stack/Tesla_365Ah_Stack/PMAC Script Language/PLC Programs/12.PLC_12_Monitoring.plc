//[참조 : 260729 인터락 팝업 요청 창 구문 위치 변경 ]
// 팝업 요청	
if( P_Y_Interlock_Popup_On_Request == 1 && P_X_Interlock_Popup_On_Request_Ack == 1 )
{
	//send0,"%s",F_IL_Cdata;	// 테스트용
	P_Y_Interlock_Popup_On_Request = 0;
}



P_MNTR_PLC12_Task_Time(1) = (Sys.Time - P_MNTR_PLC12_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC12_Task_Time(1) > P_MNTR_PLC12_Task_Max_Time )
{
	P_MNTR_PLC12_Task_Max_Time = P_MNTR_PLC12_Task_Time(1);
}


close
