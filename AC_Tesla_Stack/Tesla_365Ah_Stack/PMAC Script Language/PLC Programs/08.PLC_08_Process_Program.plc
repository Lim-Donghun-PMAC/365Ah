	P_Command_Abort( F_Status_HOLD )  = F_Status_ABORTING;
	P_Command_Abort( F_Status_UNHOLDING )  = F_Status_ABORTING;
				     
	P_Command_Abort( F_Status_SUSPENDING ) = F_Status_ABORTING;
	P_Command_Abort( F_Status_SUSPENDED ) = F_Status_ABORTING;
	P_Command_Abort( F_Status_UNSUSPENDING ) = F_Status_ABORTING;
	P_Command_Abort( F_Status_STOPPING ) = F_Status_ABORTING;
