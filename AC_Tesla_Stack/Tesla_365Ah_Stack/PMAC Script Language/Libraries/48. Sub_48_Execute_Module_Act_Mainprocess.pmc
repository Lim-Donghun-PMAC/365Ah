			P_Module_Act_Execute_State_Machine_Array(N_Act_Clamp_On) = N_Ready_Step;								// 스텝 머신 실행.
		}	

		L_Subprog_Act_EXECUTE_Anode_Clamp_On = 0;																	// 반환값 초기화.
		call Subprog_Subprocess_Execute_Act_Module.Anode_Clamp_On(&L_Subprog_Act_EXECUTE_Anode_Clamp_On);			// 실행 함수 호출.
		IF ( L_Subprog_Act_EXECUTE_Anode_Clamp_On == N_COMPLETE )													// 실행 함수 호출 완료 되었을 경우.
		{
			P_Module_Act_Execute_Command_Array(N_Act_Clamp_On) = F_ACT_STATUS_DISABLE;								// 시퀀스 완료 시 상태 비활성화.
		}
