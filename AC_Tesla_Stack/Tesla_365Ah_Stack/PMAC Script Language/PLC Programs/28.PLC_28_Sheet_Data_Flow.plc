//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_NG_TR_Align_Pick_Up_Flag == 1)
{
	P_Cathode_NG_TR_Align_Pick_Up_Flag = 0;

	L_Cathode_NG_Pick_Timer = 0;
	P_Cathode_NG_TR_Align_Pick_Up_State_Machine = 1;
	P_Cathode_NG_TR_Align_Pick_Up_Status = F_Status_STARTING;
}

