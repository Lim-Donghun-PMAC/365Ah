// 25.07.11 김준수 선임 
// [ 2025.07.11 Cycle Stop 추가 ]


open subprog Sub_Common_Function_Cycle_Stop(void)

sub:New_Speed(&rtn)

	Motor[N_NG_PnP_CA_T].jogSpeed = 30;			// 사이클 스탑 시 양극 NG PNP T축 스피드 재부여
	Motor[N_NG_PnP_CA_Z].jogSpeed = 30;			// 사이클 스탑 시 양극 NG PNP Z축 스피드 재부여
	Motor[N_NG_PnP_AN_T].jogSpeed = 30;			// 사이클 스탑 시 음극 NG PNP T축 스피드 재부여
	Motor[N_NG_PnP_AN_Z].jogSpeed = 30;			// 사이클 스탑 시 음극 NG PNP Z축 스피드 재부여
	
	Motor[N_2nd_PnP_CA_Z].jogSpeed = 30;			// 사이클 스탑 시 양극 2차 PNP Z축 스피드 재부여
	Motor[N_2nd_PnP_AN_Z].jogSpeed = 30;			// 사이클 스탑 시 음극 2차 PNP Z축 스피드 재부여
	Motor[N_2nd_PnP_CA_T].jogSpeed  = 30;			// 사이클 스탑 시 양극 2차 PNP T축 스피드 재부여
	Motor[N_2nd_PnP_AN_T].jogSpeed  = 30;			// 사이클 스탑 시 음극 2차 PNP T축 스피드 재부여
	
	Motor[N_1st_PnP_CA_T].jogSpeed  = 30;			// 사이클 스탑 시 양극 1차 PNP T축 스피드 재부여
	Motor[N_1st_PnP_AN_T].jogSpeed  = 30;			// 사이클 스탑 시 음극 1차 PNP T축 스피드 재부여
	Motor[N_1st_PnP_CA_Z].jogSpeed  = 30;			// 사이클 스탑 시 양극 1차 PNP Z축 스피드 재부여
	Motor[N_1st_PnP_AN_Z].jogSpeed  = 30;			// 사이클 스탑 시 음극 1차 PNP Z축 스피드 재부여				

	rtn = F_TRUE;								// 실행 완료 반환값
return

// 원래 스피드로 원복
sub:Original_Speed(&rtn)

	Motor[N_NG_PnP_CA_T].jogSpeed = P_UI_Jog_Vel_M(N_NG_PnP_CA_T);		// 양극 NG PNP T축 스피드 재부여 기존 스피드 원복
	Motor[N_NG_PnP_CA_Z].jogSpeed = P_UI_Jog_Vel_M(N_NG_PnP_CA_Z);		// 양극 NG PNP Z축 스피드 재부여 기존 스피드 원복	
	Motor[N_NG_PnP_AN_T].jogSpeed = P_UI_Jog_Vel_M(N_NG_PnP_AN_T);		// 음극 NG PNP T축 스피드 재부여 기존 스피드 원복	
	Motor[N_NG_PnP_AN_Z].jogSpeed = P_UI_Jog_Vel_M(N_NG_PnP_AN_Z);		// 음극 NG PNP Z축 스피드 재부여 기존 스피드 원복	

	Motor[N_2nd_PnP_CA_Z].jogSpeed = P_UI_Jog_Vel_M(N_2nd_PnP_CA_Z);	// 양극 2차 PNP Z축 스피드 재부여 기존 스피드 원복	
	Motor[N_2nd_PnP_AN_Z].jogSpeed = P_UI_Jog_Vel_M(N_2nd_PnP_AN_Z);	// 음극 2차 PNP Z축 스피드 재부여 기존 스피드 원복	
	Motor[N_2nd_PnP_CA_T].jogSpeed  = P_UI_Jog_Vel_M(N_2nd_PnP_CA_T);	// 양극 2차 PNP T축 스피드 재부여 기존 스피드 원복	
	Motor[N_2nd_PnP_AN_T].jogSpeed  = P_UI_Jog_Vel_M(N_2nd_PnP_AN_T);	// 음극 2차 PNP T축 스피드 재부여 기존 스피드 원복

	Motor[N_1st_PnP_CA_T].jogSpeed = P_UI_Jog_Vel_M(N_1st_PnP_CA_T);	// 양극 2차 PNP Z축 스피드 재부여 기존 스피드 원복	
	Motor[N_1st_PnP_AN_T].jogSpeed = P_UI_Jog_Vel_M(N_1st_PnP_AN_T);	// 음극 2차 PNP Z축 스피드 재부여 기존 스피드 원복	
	Motor[N_1st_PnP_CA_Z].jogSpeed = P_UI_Jog_Vel_M(N_1st_PnP_CA_Z);	// 양극 2차 PNP T축 스피드 재부여 기존 스피드 원복	
	Motor[N_1st_PnP_AN_Z].jogSpeed = P_UI_Jog_Vel_M(N_1st_PnP_AN_Z);	// 음극 2차 PNP T축 스피드 재부여 기존 스피드 원복
						
	rtn = F_TRUE;								// 실행 완료 반환값
return
//=============================================================================================================================

// 양,음극 1st PNP Z축 대기위치 이동
sub: Cathode_Anode_1st_Z_Ready_Move(&rtn)
	Motor[N_1st_PnP_CA_Z].ProgJogPos = P_Cathode_1st_Z_Ready_Up*1000;	//대기 상승위치
	Motor[N_1st_PnP_AN_Z].ProgJogPos = P_Anode_1st_Z_Ready_Up*1000;	//대기 상승위치
	cmd"#%d j=*",N_1st_PnP_CA_Z;
	cmd"#%d j=*",N_1st_PnP_AN_Z;
	//jog17=*;
	//jog18=*;
	rtn = N_TRUE;
return;

// 양,음극 1st PNP Z축 대기위치 이동 확인
sub: Cathode_Anode_1st_Z_Ready_Move_Check(&rtn)
	rtn = 0;
	if( Motor[N_1st_PnP_CA_Z].DesVelZero == 1 && Motor[N_1st_PnP_AN_Z].DesVelZero == 1 )
	{
		if( P_Motor_Current_Pos(N_1st_PnP_CA_Z) < P_Cathode_1st_Z_Ready_Up + 0.2 && P_Motor_Current_Pos(N_1st_PnP_CA_Z) > P_Cathode_1st_Z_Ready_Up - 0.2 &&P_Motor_Current_Pos(N_1st_PnP_AN_Z) < P_Anode_1st_Z_Ready_Up + 0.2 && P_Motor_Current_Pos(N_1st_PnP_AN_Z) > P_Anode_1st_Z_Ready_Up - 0.2 )
		{
			rtn = N_TRUE;
		}
	}
return;

