		call Subprog_Subprocess_Execute_Act_Module.FR_Down(&L_Subprog_Act_EXECUTE_FR_Down);							// 실행 함수 호출.
		IF ( L_Subprog_Act_EXECUTE_FR_Down == N_COMPLETE )															// 실행 함수 호출 완료 되었을 경우.
		{
			P_Module_Act_Execute_Command_Array(N_Act_FR_Down) = F_ACT_STATUS_DISABLE;								// 시퀀스 완료 시 상태 비활성화.
		}
		ELSE IF ( L_Subprog_Act_EXECUTE_FR_Down == N_FALSE )														// 실행 함수 호출 실패 되었을 경우.
		{
			//P_Suspend_Anode_1TR_Cell_Supply_State_Machine = N_Error_Step; 										// 스탑포인트 에러 처리 할 것 
			P_Module_Act_Execute_Command_Array(N_Act_FR_Down) = F_ACT_STATUS_ALARM;									// 동작 에러.
		}
