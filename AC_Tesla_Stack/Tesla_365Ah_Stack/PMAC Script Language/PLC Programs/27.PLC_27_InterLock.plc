						// 현재 위치랑 
						P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_MAIN_Z) + P_Minus_IL_Offset;	// 언로더 Z축이 메인 테이블 Z툭 + Offset 밑으로 못 내려감.
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_MAIN_Z;
					}
				}
			break;

			case N_UNLOADER_T:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			//================================ 1번위치 - T축 대기 위치 ================================
