//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.06.04 김형진 책임
// Motion Coordination - [ 참조 : 25.06.04 모션 조정 신규 추가 ]  
// System Module PLC Program
// 25.10.22 AIO Cal Program 추가 

open plc 24

#define	L_System_Timer				Sys.Time				// 시스템 타이머

Local	L_Time_Cycle_Up_Count_Start_Time;					// Plc[24].ldata.L[0]	시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;						// Plc[24].ldata.L[1]	시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;					// Plc[24].ldata.L[2]	시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;					// Plc[24].ldata.L[3]	타이머 초기화 플래그

// 엣지변수
Local	L_Old_Sepa_To_Sensor_Min_Distance_mm;				// Plc[24].ldata.L[4]	Min Distance 이전값
Local	L_Old_Sepa_To_Sensor_Max_Distance_mm;				// Plc[24].ldata.L[5]	Max Distacne 이전값
Local	L_Old_Sensor_Min_Analog_Data;						// Plc[24].ldata.L[6]	Min AI 이전값
Local	L_Old_Sensor_Max_Analog_Data;						// Plc[24].ldata.L[7]	Max AI 이전값
Local	L_Old_AO_Cathode_Clamp_Damper;						// Plc[24].ldata.L[8]	양극 댐퍼 Out 이전값
Local	L_Old_AO_Anode_Clamp_Damper;						// Plc[24].ldata.L[9]	음극 댐퍼 Out 이전값
Local	L_AI_Cathode_Clamp_Damper_Old;						// Plc[24].ldata.L[10]	양극 댐퍼 In 이전값
Local	L_AI_Anode_Clamp_Damper_Old;						// Plc[24].ldata.L[11]	음극 댐퍼 In 이전값
Local	L_Old_Regul_Max_kPa_Value;							// Plc[24].ldata.L[12]	레귤레이터 Max 이전값
Local	L_Old_Regul_Min_kPa_Value;							// Plc[24].ldata.L[13]	레귤레이터 Min 이전값
Local	L_Old_Regul_Max_AD;									// Plc[24].ldata.L[14]	레귤레이터 Analog Max 이전값 
Local	L_Old_Regul_Min_AD;									// Plc[24].ldata.L[15]	레귤레이터 Analog Min 이전값 

// Avg 변수
Local	L_AI_Cathode_Clamp_Damper_AVG;						// Plc[24].ldata.L[16]	양극 댐퍼 Out 이전값
Local	L_AI_Anode_Clamp_Damper_AVG;						// Plc[24].ldata.L[17]	음극 댐퍼 Out 이전값
Local	L_PLC24_CA_Damper_AI_Data;							// Plc[24].ldata.L[18]	순환 평균 데이터 변수 
Local	L_PLC24_AN_Damper_AI_Data;							// Plc[24].ldata.L[19]	순환 평균 데이터 변수 
Local	L_PLC24_CA_Damper_AI_Cnt;							// Plc[24].ldata.L[20]	순환 평균 데이터 변수 
Local	L_PLC24_AN_Damper_AI_Cnt;							// Plc[24].ldata.L[21]	순환 평균 데이터 변수 
// timer
local	L_PLC24_CA_Damper_AI_Timer;							// Plc[24].ldata.L[22]	순환평균에 사용 되는 타이머
local	L_PLC24_AN_Damper_AI_Timer;							// Plc[24].ldata.L[22]	순환평균에 사용 되는 타이머

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if(L_Flag_Cycle_Up_Count_Init_Flag == 0)
{
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 00.2) 시간 체크
if(L_Flag_Cycle_Up_Count_Init_Flag == 1)
{
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * 1000
	if(L_Time_Cycle_Up_Count_Delta_Time < 0)
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}
// 00.3) 시간 업데이트
if(L_Time_Cycle_Up_Count_Delta_Time > 0.1)
{
	L_PLC24_CA_Damper_AI_Timer = L_PLC24_CA_Damper_AI_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC24_AN_Damper_AI_Timer = L_PLC24_AN_Damper_AI_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//================================================================================================================
// 1. Dancer_Cascading Module 명령 ================================================================================================================
if( P_System_Cascading_ON_Cmd == F_Command_Start)
{
	P_System_Cascading_ON_Cmd = 0;
	P_System_Cascading_ON_Status = F_Status_STARTING;
}
// 서보댄서 홈 모듈 
if( P_System_Cascading_ON_Status == F_Status_STARTING || P_System_Cascading_ON_Status == F_Status_EXECUTE )
{
	call System_Module.Servo_Dancer_Cascading_Set();
}
//=====================================================================================================================================================

// 2. Dancer_Cascading Off Module 명령 ================================================================================================================
if( P_System_Cascading_OFF_Cmd == F_Command_Start)
{
	P_System_Cascading_OFF_Cmd = 0;
	P_System_Cascading_OFF_Status = F_Status_STARTING;
}
// 케스케이딩 오프 액팅
if( P_System_Cascading_OFF_Status == F_Status_STARTING || P_System_Cascading_OFF_Status == F_Status_EXECUTE )
{
	call System_Module.Servo_Dancer_Cascading_Off();
}
//====================================================================================================================================================

// 3. 마스터 팔로잉 명령 ===============================================================================================================================
if( P_System_Master_Following_ON_Cmd == F_Command_Start )
{
	P_System_Master_Following_ON_Cmd = 0;
	P_System_Master_Following_ON_Status = F_Status_STARTING;
	//P_Master_Following_state_machine = 1;
}

// 마스터 팔로잉 ON 액팅
if( P_System_Master_Following_ON_Status == F_Status_STARTING || P_System_Master_Following_ON_Status == F_Status_EXECUTE )
{
	call System_Module.Master_Following_Sequence_Module();
}
//====================================================================================================================================================

// 4. 마스터 팔로잉 Off 명령 ===========================================================================================================================
if( P_System_Master_Following_OFF_Cmd == F_Command_Start )
{
	P_System_Master_Following_OFF_Cmd = 0;
	P_System_Master_Following_OFF_Status = F_Status_STARTING;
	//P_Master_Following_Off_state_machine = 1;
}
// 마스터 팔로잉 off 액팅
if( P_System_Master_Following_OFF_Status == F_Status_STARTING || P_System_Master_Following_OFF_Status == F_Status_EXECUTE )
{
	call System_Module.Master_Following_Sequence_Off_Module();
}

//====================================================================================================================================================


// 5.캠테이블 on ==============================================================================================================================
if( P_System_CamTable_ON_Cmd == F_Command_Start )
{
	P_System_CamTable_ON_Cmd = 0;
	P_System_CamTable_ON_Status = F_Status_STARTING;
}
// 캠테이블 on 액팅
if( P_System_CamTable_ON_Status == F_Status_STARTING || P_System_CamTable_ON_Status == F_Status_EXECUTE )
{
	call System_Module.Sepa_Line_Speed_CamTable_On();
}
//=====================================================================================================================================================

// 6.캠테이블 해제 ==============================================================================================================================
if( P_System_CamTable_OFF_Cmd == F_Command_Start )
{
	P_System_CamTable_OFF_Cmd = 0;
	P_System_CamTable_OFF_Status = F_Status_STARTING;
}
// 캠테이블 off 액팅
if( P_System_CamTable_OFF_Status == F_Status_STARTING || P_System_CamTable_OFF_Status == F_Status_EXECUTE )
{
	call System_Module.Sepa_Line_Speed_CamTable_Off();
}

//====================================================================================================================================================

// 7. 댄서 텐션 언와인더 풀어주기 모듈 ==================================================================================================================
if( P_System_Spool_Home_Ready_Pos_Cmd == F_Command_Start )
{
	P_System_Spool_Home_Ready_Pos_Cmd = 0;
	P_System_Spool_Home_Ready_Pos_Status = F_Status_STARTING;
}
// 댄서 첫 홈시 텐션 언와인더 풀어주기 액팅
if( P_System_Spool_Home_Ready_Pos_Status == F_Status_STARTING || P_System_Spool_Home_Ready_Pos_Status == F_Status_EXECUTE )
{
	call System_Module.Frist_Dancer_Home_Ready_Pos();
}
//====================================================================================================================================================


//====================================================================================================================================================
// [ 참조 : 2025.10.22 AIO Cal Prog Add ] 
//====================================================================================================================================================
// ↓ 세파 센싱 거리 및 AI Data 수정 시 자동 기울기 계산 프로그램
if( P_Sepa_To_Sensor_Max_Distance_mm != L_Old_Sepa_To_Sensor_Max_Distance_mm || P_Sepa_To_Sensor_Min_Distance_mm != L_Old_Sepa_To_Sensor_Min_Distance_mm || P_Sensor_Max_Analog_Data != L_Old_Sensor_Max_Analog_Data || P_Sensor_Min_Analog_Data != L_Old_Sensor_Min_Analog_Data )
{
	// ↓ 계수가 양수라면
	if( P_Sepa_To_Sensor_Max_Distance_mm >= P_Sepa_To_Sensor_Min_Distance_mm && P_Sensor_Max_Analog_Data >= P_Sensor_Min_Analog_Data )
		P_Sepa_Cal_Inclination = abs((P_Sepa_To_Sensor_Max_Distance_mm - P_Sepa_To_Sensor_Min_Distance_mm) / (P_Sensor_Max_Analog_Data - P_Sensor_Min_Analog_Data)) * P_Sensor_Max_Analog_Data - P_Sepa_To_Sensor_Max_Distance_mm;
	// ↓ 계수가 음수라면
	else
		P_Sepa_Cal_Inclination = abs((P_Sepa_To_Sensor_Max_Distance_mm - P_Sepa_To_Sensor_Min_Distance_mm) / (P_Sensor_Max_Analog_Data - P_Sensor_Min_Analog_Data)) * P_Sensor_Max_Analog_Data + P_Sepa_To_Sensor_Max_Distance_mm;
	
	L_Old_Sepa_To_Sensor_Min_Distance_mm = P_Sepa_To_Sensor_Min_Distance_mm;	
	L_Old_Sepa_To_Sensor_Max_Distance_mm = P_Sepa_To_Sensor_Max_Distance_mm;	
	L_Old_Sensor_Min_Analog_Data = P_Sensor_Min_Analog_Data;			
	L_Old_Sensor_Max_Analog_Data = P_Sensor_Max_Analog_Data;			
}
// ↓ 레귤레이터 센싱 압력 및 AI Data 수정 시 자동 기울기 계산 프로그램
if( P_Regul_Max_kPa_Value != L_Old_Regul_Max_kPa_Value || P_Regul_Min_kPa_Value != L_Old_Regul_Min_kPa_Value || P_Regul_Max_AD != L_Old_Regul_Max_AD || P_Regul_Min_AD != L_Old_Regul_Min_AD )
{
	// ↓ 계수가 양수라면
	if( P_Regul_Max_kPa_Value >= P_Regul_Min_kPa_Value && P_Regul_Max_AD >= P_Regul_Min_AD )
		P_Regul_Cal_Inclination = abs((P_Regul_Max_kPa_Value - P_Regul_Min_kPa_Value) / (P_Regul_Max_AD - P_Regul_Min_AD)) * P_Regul_Max_AD - P_Regul_Max_kPa_Value;
	// ↓ 계수가 음수라면
	else
		P_Regul_Cal_Inclination = abs((P_Regul_Max_kPa_Value - P_Regul_Min_kPa_Value) / (P_Regul_Max_AD - P_Regul_Min_AD)) * P_Regul_Max_AD + P_Regul_Max_kPa_Value;

	L_Old_Regul_Max_kPa_Value = P_Regul_Max_kPa_Value;
	L_Old_Regul_Min_kPa_Value = P_Regul_Min_kPa_Value;
	L_Old_Regul_Max_AD = P_Regul_Max_AD;
	L_Old_Regul_Min_AD = P_Regul_Min_AD;
}
//====================================================================================================================================================
// AO Cal Program → Clamp Damper
if( P_AO_Cathode_Clamp_Damper != L_Old_AO_Cathode_Clamp_Damper )
{
	//call AIO_Calc.AO_Regulator(P_AO_Cathode_Clamp_Damper, &M_AO_Cathode_Clamp_Damper);
	L_Old_AO_Cathode_Clamp_Damper = P_AO_Cathode_Clamp_Damper;
}
if( P_AO_Anode_Clamp_Damper != L_Old_AO_Anode_Clamp_Damper )
{
	//call AIO_Calc.AO_Regulator(P_AO_Anode_Clamp_Damper, &M_AO_Cathode_Clamp_Damper);
	L_Old_AO_Anode_Clamp_Damper = P_AO_Anode_Clamp_Damper;
}
//========================================================================================================================================================
// AI Cal Program → Clamp Damper
if( L_AI_Cathode_Clamp_Damper_AVG != L_AI_Cathode_Clamp_Damper_Old )
{
	//call AIO_Calc.AI_Regulator(L_AI_Cathode_Clamp_Damper_AVG, &P_AI_Cathode_Clamp_Damper_Mpa);
	L_AI_Cathode_Clamp_Damper_Old = L_AI_Cathode_Clamp_Damper_AVG;
}
if( L_AI_Anode_Clamp_Damper_AVG != L_AI_Anode_Clamp_Damper_Old )
{
	//call AIO_Calc.AI_Regulator(L_AI_Anode_Clamp_Damper_AVG, &P_AI_Anode_Clamp_Damper_Mpa);
	L_AI_Anode_Clamp_Damper_Old = L_AI_Anode_Clamp_Damper_AVG;
}
//========================================================================================================================================================
// AI Cathode Damper Avg
if( L_PLC24_CA_Damper_AI_Timer >= 10 )			// 10ms 마다 업데이트
{
	L_AI_Cathode_Clamp_Damper_AVG = L_PLC24_CA_Damper_AI_Data / L_PLC24_CA_Damper_AI_Cnt;
	L_PLC24_CA_Damper_AI_Timer = 0;				// 초기화
	L_PLC24_CA_Damper_AI_Data = 0;				// 초기화
	L_PLC24_CA_Damper_AI_Cnt = 0;				// 초기화
}
else	// 아날로그 데이터 순환평균 시작
{
	L_PLC24_CA_Damper_AI_Data =  L_PLC24_CA_Damper_AI_Data + M_AI_Cathode_Clamp_Damper;
	L_PLC24_CA_Damper_AI_Cnt++;
}
// AI Anode Damper Avg
if( L_PLC24_AN_Damper_AI_Timer >= 10 )			// 10ms 마다 업데이트
{
	L_AI_Anode_Clamp_Damper_AVG = L_PLC24_AN_Damper_AI_Data / L_PLC24_AN_Damper_AI_Cnt;
	L_PLC24_AN_Damper_AI_Timer = 0;				// 초기화
	L_PLC24_AN_Damper_AI_Data = 0;				// 초기화
	L_PLC24_AN_Damper_AI_Cnt = 0;				// 초기화
}
else	// 아날로그 데이터 순환평균 시작
{
	L_PLC24_AN_Damper_AI_Data =  L_PLC24_AN_Damper_AI_Data + M_AI_Anode_Clamp_Damper;
	L_PLC24_AN_Damper_AI_Cnt++;
}	
//========================================================================================================================================================

close
