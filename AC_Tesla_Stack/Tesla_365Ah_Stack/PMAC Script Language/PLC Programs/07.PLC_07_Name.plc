}

if(M_Write_Sector_Scan_Complete(3) == 1)
{
	P_PV_Cathode_Count = P_Cathode_Count;								// 양극 적재 카운트
	P_PV_Anode_Count = P_Anode_Count;									// 음극 적재 카운트
							
	Sys.Idata[20800] = P_Cathode_Clamp_inside_Machine_Cylinder_Count;	//양극 클램프 상단 실린더 사용 횟수 표시
	Sys.Idata[20801] = P_Anode_Clamp_inside_Machine_Cylinder_Count;		//음극 클램프 상단 실린더 사용 횟수 표시
	Sys.Idata[20802] = P_Cathode_Clamp_Middle_Cylinder_Count;			//양극 클램프 중단 실린더 사용 횟수 표시
	Sys.Idata[20803] = P_Anode_Clamp_Middle_Cylinder_Count;				//음극 클램프 중단 실린더 사용 횟수 표시
	Sys.Idata[20806] = P_Accumulated_Movement_MM_Unit_Cathode_1ST_pnp;	//양극 1차 pnp x축 누적 이동량
	Sys.Idata[20807] = P_Accumulated_Movement_MM_Unit_Anode_1ST_pnp;	//음극 1차 pnp x축 누적 이동량
	Sys.Idata[20808] = P_Accumulated_Movement_MM_Unit_Cathode_2nd_pnp;	//양극 2차 pnp x축 누적 이동량
	Sys.Idata[20809] = P_Accumulated_Movement_MM_Unit_Anode_2nd_pnp;	//음극 2차 pnp x축 누적 이동량
	Sys.Idata[20810] = P_Jelly_Roll_Prod_Count;							//젤리 롤 현재 생산 개수 표시
	Sys.Idata[20811] = P_Anode_Count;									//음극 현재 쌓은 개수 표시     
	Sys.Idata[20812] = P_Cathode_Count;									//양극 현재 쌓은 개수 표시
	//양,음극 클램프 현재 아날로그 값을 Mpa로 변환한 값 송신.
	Sys.Idata[20813] = P_AI_Anode_Clamp_Damper_Mpa;						//음극 클램프 공압 현재 AD값 표시
	Sys.Idata[20814] = P_AI_Cathode_Clamp_Damper_Mpa;					//양극 클램프 공압 현재 AD값 표시
	Sys.Idata[20815] = P_Jelly_Roll_Recipe_Count;						//젤리 롤 현재 생산 개수 표시
	Sys.Idata[20816] = P_Recipe_Speed_Value;							//PMAC 장비 현재 속도 표시
	Sys.Idata[20817] = P_Anode_Thickness*1000;							//음극 두께 표시
	Sys.Idata[20818] = P_Cathode_Thickness*1000;						//양극 두께 표시
	Sys.Idata[20819] = P_Sepa_Thickness*1000;	 	   					//세파 두께 표시
	Sys.Idata[20820] = P_Current_Whole_Stack_Jelly_Roll_Thinckness_mm	//STACK A 배출 J/R 두께 (정상배출) 

	if( P_Current_Jelly_Roll_Thinckness_mm_Send_Enable_Flag == 1 )
	{
		P_Current_Jelly_Roll_Thinckness_mm_Send_Enable_Flag = 0;
		Sys.Idata[20821] = (P_Current_Jelly_Roll_Thinckness_mm*10000);		//현재 젤리롤 두께
	}
	Sys.Idata[20824] = P_Upper_Sepa_Current_Thickness_um;				//상단 언와인더 세파 현재 두께
	Sys.Idata[20825] = P_Lower_Sepa_Current_Thickness_um;				//하단 언와인더 세파 현재 두께
	Sys.Idata[20826] = ((P_Spool_Rotate_Distance/1000)*(2*3.14*Spool_Diameter)/360)*100*1;		//현재 세파 되감기 거리 표시
	Sys.Idata[20827] = P_Current_Selected_Spool_Rev_Counts;										//현재 사용 중인 스풀 교체 후 회전 수 카운트
	Sys.Idata[20828] = P_Current_FR_Moving_Cnt_To_PlC;											//세파 ARC 현재 F/R 이동횟수 카운트

	// 1차 P&P Belt -> Align Table 이동 거리 APC 적용 값 ( 실제 움직이는 거리로 계산 해서 PV에 올림 )
	Sys.Idata[20829] = P_Cathode_X_Sum_Move_mm * 10;
	Sys.Idata[20830] = P_Anode_X_Sum_Move_mm * 10;
	Sys.Idata[20831] = P_Sepa_Cutter_Current;										//세파 커터 전류값 
	Sys.Idata[20832] = P_AI_Cathode_Clamp_Damper;									//양극 클램프 댐퍼값	
	Sys.Idata[20833] = P_AI_Anode_Clamp_Damper;										//음극 클램프 댐퍼값
	// 드라이런 경과 시간 기록 머신
	IF ( P_PLC15_Sub_Function_Dryrun_Active_Flag == 1 )								// 드라이 런 서브 시퀀스 활성화 변수가 ON 될 경우
	{
		u.user:$014588.00.16 = int(P_Execute_DryRun_Stop_Timer);				// 드라이런 경과 시간 기재
	}
	Else																			// 드라이런 활성화 플래그가 꺼져있으면 (드라이런 완료 되었으면 OFf)
	{	
		u.user:$014588.00.16 = 0;													// 드라이런 경과 시간 초기화
	}

	// 고객사 요청으로 모션 슬레이브 다운 알람 시 팝업 창 비트 추가
	u.user:$014588.16.1 = P_Minus_Limit_Detect_Popup_Flag;
