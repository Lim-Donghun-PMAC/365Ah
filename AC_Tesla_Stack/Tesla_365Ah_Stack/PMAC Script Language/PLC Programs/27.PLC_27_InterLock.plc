					else
					   L_Use_FR_High_Pos(0) = P_Motor_Current_Pos(N_Clamp_CA_Z2);
					// 음극 클램프 Z 비교
					if( P_Motor_Current_Pos(N_Clamp_AN_Z1) >= P_Motor_Current_Pos(N_Clamp_AN_Z2))      // 음극 클램프 Z1 , 음극 클램프 Z2 비교
					   L_Use_FR_High_Pos(1) = P_Motor_Current_Pos(N_Clamp_AN_Z1);
					else
					   L_Use_FR_High_Pos(1) = P_Motor_Current_Pos(N_Clamp_AN_Z2);

					if( L_Use_FR_High_Pos(0) >= L_Use_FR_High_Pos(1))		// 양극 클램프가 더 높다면
					   P_IL_Use_FR_Clamp_Pos = L_Use_FR_High_Pos(0);		// 클램프 Z 현재 위치
					else													// 음극 클램프가 더 높다면   
					   P_IL_Use_FR_Clamp_Pos = L_Use_FR_High_Pos(1);		// 클램프 Z 현재 위치
				//================================ 1번위치 - 파이널롤러 대기 위치  ================================
					// ↓ 파이널 롤 X축 대기 위치 || 파이널 롤 Z축 !~ 적층 위치 || 음극 2차 PNP T축 > 대기 위치 + 30º || 파이널 롤 Z축,클램프 Z축 사이 > 3mm
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ P_Recipe_M12_POS(1) || !(P_Motor_Current_Pos(N_FINAL_ROLL_Z) ~ P_Recipe_M13_POS(2)) || P_Motor_Current_Pos(N_2nd_PnP_AN_T) > P_Recipe_M04_POS(1) + 30 || (P_Motor_Current_Pos(N_FINAL_ROLL_Z) + P_IL_Use_FR_Clamp_Pos) > -3 )	
						P_No1_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					else
						P_No1_Recipe_Pos_IL(N_FINAL_ROLL_X) = 0;
				//================================ 2번위치 - 파이널롤러 음극 위치  ================================
					// ↓ 파이널 롤 X축 음극 위치 || 파이널 롤 Z축 !~ 적층 위치 || 음극 2차 PNP T축 > 대기 위치 + 45º || 파이널 롤 Z축, 클램프 Z축 사이 > 3mm
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ P_Recipe_M12_POS(2) || !(P_Motor_Current_Pos(N_FINAL_ROLL_Z) ~ P_Recipe_M13_POS(2)) || P_Motor_Current_Pos(N_2nd_PnP_AN_T) > P_Recipe_M04_POS(1) + 45 || (P_Motor_Current_Pos(N_FINAL_ROLL_Z) + P_IL_Use_FR_Clamp_Pos) > -3 )	
						P_No2_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					else
						P_No2_Recipe_Pos_IL(N_FINAL_ROLL_X) = 0;
				//================================ 3번위치 - 파이널롤러 양극 위치 ================================
					// ↓ 파이널 롤 X축 양극 위치 || 파이널 롤 Z축 !~ 적층 위치 || 양극 2차 PNP T축 > 대기 위치 + 45º || 파이널 롤 Z축, 클램프 Z축 사이 > 3mm
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) ~ P_Recipe_M12_POS(3) || !(P_Motor_Current_Pos(N_FINAL_ROLL_Z) ~ P_Recipe_M13_POS(2)) || P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(1) + 45 || (P_Motor_Current_Pos(N_FINAL_ROLL_Z) + P_IL_Use_FR_Clamp_Pos) > -3 )
						P_No3_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					else
						P_No3_Recipe_Pos_IL(N_FINAL_ROLL_X) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No4_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No5_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No6_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No7_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No2_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No3_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No4_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No5_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No6_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;
					P_No7_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_FINAL_ROLL_X) = 1;			// 인터락
				}
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			// 플러스가 정면에서 왼쪽, 
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);		// FR X [#12] - 엔코더 위치가 곧 절대위치
				if(P_IL_Outer_Status == N_IL_Anode_Pos || P_IL_Outer_Status == N_IL_Cathode_Pos)
				{
					// FR X축이 움직일때 간섭요인이되는 모터들이 설정된 절대위치보다 높다면 인터락.
					
					P_Z_Pos_Data = P_Motor_Current_Pos(N_MAIN_Z) + 0.1;
					P_Collision_Risk_Motor(Hex_IL_Plus) = N_MAIN_Z;
					P_Collision_Risk_Motor(Hex_IL_Minus) = N_MAIN_Z;
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z2))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z2);
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_CA_Z2;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z2;
					}
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z2))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z2);
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_AN_Z2;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z2;
					}
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z1))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z1);
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_CA_Z1;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z1;
					}
					
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z1))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z1);
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_Clamp_AN_Z1;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z1;
					}
				// ================================ 플러스/마이너스 전체 간섭 요인 : <<Main z, Clamp>> ==================================//

					// 위에 상황이 아니라면
					if(P_Z_Pos_Data > P_Recipe_M11_POS(1) + 0.5 )	
					{
						P_Plus_IL_Offset = 0;
						P_Minus_IL_Offset = 0;
						P_Limit_PosData(Hex_IL_Plus) = P_Abs_Trans_Cur_Pos;
						P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;
					}
					else
					{
				// ================================ 플러스 간섭 요인 : <<Ca 2nd PNP, Unloader>> ==================================//
						//if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 45)	
						if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(1) + 45)			// 양극 2차 PNP가 대기위치 + 45도 넘을 경우.
						{
							P_Plus_IL_Offset = P_FR_X_Plus_IL_Offset(0);							// Offset value : -200
							P_Limit_PosData(Hex_IL_Plus) = P_2nd_PNP_Arm_Radius * cosd(P_Motor_Current_Pos(N_2nd_PnP_CA_T)) + P_Plus_IL_Offset;
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;
						}
						else
						{// 언로더 X축 스텍전진위치 - 언로더 X 현재 위치 - FR 음 이동방향 		
							P_Plus_IL_Offset = P_FR_X_Plus_IL_Offset(1);				// Offset value : -20
							// 언로더 스텍 진입티칭 - 현재 언로더 위치 + 파이널롤 음극대기(음수임) + 플러스 오프셋 계산 -> Stack Center 기준 몇 mm 떨어져있는지 확인가능.
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(3) - P_Motor_Current_Pos(N_UNLOADER_X) + P_Recipe_M12_POS(2) + P_Plus_IL_Offset;	
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_UNLOADER_X;
						}
					// ================================ 마이너스 간섭 요인 : <<An 2nd PNP, >> ==================================//
						if(P_Motor_Current_Pos(N_2nd_PnP_AN_T) > 45)
						{
							P_Minus_IL_Offset = P_FR_X_Minus_IL_Offset(0);							// Offset value : -200
							P_Limit_PosData(Hex_IL_Minus) = P_2nd_PNP_Arm_Radius * cosd(P_Motor_Current_Pos(N_2nd_PnP_AN_T))*-1 + P_Minus_IL_Offset;
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_2nd_PnP_AN_T;
						}
					}
				}

			break;

			case N_FINAL_ROLL_Z:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			//================================ 1번위치 - 파이널롤러 대기,커팅 위치  ================================
				// ↓ 파이널 롤 대기, 커팅 위치 || 파이널 롤 X축 양,음극 위치 사이 || 양,음극 클램프 Z축 > 대기 위치 || 스택 테이블 Z축 > 대기 위치
				if(P_Motor_Current_Pos(N_FINAL_ROLL_Z) ~ P_Recipe_M13_POS(1))	
					P_No1_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
				else 
				{
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(3) && P_Motor_Current_Pos(N_FINAL_ROLL_X) > P_Recipe_M12_POS(2))
					{// 파이널롤러 X축이 양,음극 위치 이내에 있다면, 
						if(P_Motor_Current_Pos(N_Clamp_CA_Z1) > P_Recipe_M27_POS(1) || P_Motor_Current_Pos(N_Clamp_CA_Z2) > P_Recipe_M25_POS(1) || P_Motor_Current_Pos(N_Clamp_AN_Z1) > P_Recipe_M28_POS(1) || P_Motor_Current_Pos(N_Clamp_AN_Z2) > P_Recipe_M26_POS(1) || P_Motor_Current_Pos(N_MAIN_Z) > P_Recipe_M11_POS(1))
							P_No1_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
						else
							P_No1_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 0;
					}
					else
						P_No1_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 0;
				}
			//================================ 2번위치 - 파이널롤러 적층 위치  ================================
				// ↓ 파이널 롤 Z축 적층 위치
				if(P_Motor_Current_Pos(N_FINAL_ROLL_Z) ~ P_Recipe_M13_POS(2))	
					P_No2_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
				else
					P_No2_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
					P_No4_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
					P_No5_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
					P_No6_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;
					P_No7_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_FINAL_ROLL_Z) = 1;			// 인터락
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page) * -1;		// FR Z [#13] - 엔코더 위치가 곧 절대위치이지만 반전해야함.
				if(P_IL_Outer_Status == N_IL_Anode_Pos || P_IL_Outer_Status == N_IL_Cathode_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<없음>> ==================================//
				// ================================ 마이너스 간섭 요인 : <<Main z, Clamp>> ==================================//
					//P_Plus_IL_Offset = 0;
					P_Minus_IL_Offset = P_FR_Z_Minus_IL_Offset;
					P_Z_Pos_Data = P_Motor_Current_Pos(N_MAIN_Z) + 0.1;
					P_Collision_Risk_Motor(Hex_IL_Minus) = N_MAIN_Z;
					// 현재 모터들이 Z축 리밋이 설정값보다 높다면 갱신하기.
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z2))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z2);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z2;
					}
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z2))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z2);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z2;
					}
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_CA_Z1))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_CA_Z1);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_CA_Z1;
					}
					
					if(P_Z_Pos_Data < P_Motor_Current_Pos(N_Clamp_AN_Z1))
					{
						P_Z_Pos_Data = P_Motor_Current_Pos(N_Clamp_AN_Z1);
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_Clamp_AN_Z1;
					}

					P_Limit_PosData(Hex_IL_Minus) = P_Z_Pos_Data + P_Minus_IL_Offset;
				}

			break;

			case N_NG_PnP_CA_T:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				if(P_IL_Outer_Status != IL_Out_Close)
				{
				//================================ 1번위치 - NG 대기 위치  ================================
					// ↓ 양극 NG PNP T축 대기 위치 || 언로더 Z축 < 대기 위치 + 80mm
					if(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1) || P_Motor_Current_Pos(N_UNLOADER_Z) < P_Recipe_M47_POS(2) + 80)	
						P_No1_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					else
						P_No1_Recipe_Pos_IL(N_NG_PnP_CA_T) = 0;
				//================================ 2번위치 - NG Align 위치 ================================
					// ↓ 양극 NG PNP T축 얼라인 위치 || 언로더 Z축 < 대기 위치 + 80mm || 양극 2차 PNP T축 < 대기 위치 + 45º || 양극 1차 PNP T축 > 대기 위치 + 0.2
					if(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(2) || P_Motor_Current_Pos(N_UNLOADER_Z) < P_Recipe_M47_POS(2) + 80 || P_Motor_Current_Pos(N_2nd_PnP_CA_T) < P_Recipe_M03_POS(1) + 45 || P_Motor_Current_Pos(N_1st_PnP_CA_T) > P_Recipe_M01_POS(1)+ 0.2)	
						P_No2_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					else
						P_No2_Recipe_Pos_IL(N_NG_PnP_CA_T) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No4_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No5_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No6_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No7_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;		// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No2_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No3_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No4_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No5_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No6_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;
					P_No7_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_CA_T) = 1;		// 인터락
				}
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);		// NG PNP는 절대위치 반환이 안됨...
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<Unloader>> ==================================//
					if(P_Motor_Current_Pos(N_UNLOADER_X) < 50 && P_Motor_Current_Pos(N_UNLOADER_Z) < 10)		// 취출위치 Z축 상승이라면,
					{
						P_Limit_PosData(Hex_IL_Plus) = 10;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_UNLOADER_Z;
					}
				}
				else if(P_IL_Outer_Status == N_IL_Align_Pos )
				{// << N_IL_Align_Pos >> 20도 초과 일 경우
					
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(1) + 40)
					{// 2nd T 40도 초과 시
					// ================================ 플러스 간섭 요인 : <<Ca 1st PNP, 2nd pnp>> ==================================//
						if(P_Motor_Current_Pos(N_1st_PnP_CA_T) > P_Recipe_M01_POS(3) - 10)	// 1nd pnp가 80도 초과 부근이라면
						{
							P_Plus_IL_Offset = P_Ca_NG_PNP_Plus_IL_Offset(0);						// Offset value : -40
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M42_POS(2) + P_Plus_IL_Offset;	// NG PNP T축 플러스 이동 시 얼라인 위치 + Offset을 넘길 수 없음.
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_1st_PnP_CA_T;
						}
					// ================================ 마이너스 간섭 요인 : <<Unloader>> ==================================//
						if(P_Motor_Current_Pos(N_UNLOADER_X) < P_Recipe_M46_POS(1) + 30 && P_Motor_Current_Pos(N_UNLOADER_Z) < P_Recipe_M47_POS(2) + 45)		// 취출위치 Z축 상승이라면,
						{
							P_Minus_IL_Offset = P_Ca_NG_PNP_Minus_IL_Offset(0);						// Offset value : 0
							//P_Limit_PosData(Hex_IL_Minus) = 70 + P_Minus_IL_Offset;
							P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M42_POS(2) - 20 + P_Minus_IL_Offset;	// NG PNP T축 마이너스 이동 시 얼라인 위치 - 20 + Offset을 넘길 수 없음.
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_UNLOADER_Z;
						}
					}
					else
					{
						if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(1) + 20 && P_Motor_Current_Pos(P_IL_Motor_Page) > 45 )
						{// 2nd T 20 ~ 40도 및 NG가 45도 초과라면 [NG가 얼라인에 있는것으로 간주]
						// ================================ 플러스 간섭 요인 : <<Ca 1st PNP>> ==================================//	
							if(P_Motor_Current_Pos(N_1st_PnP_CA_T) > P_Recipe_M01_POS(3) - 10)	// 1nd pnp가 80도 초과 부근이라면
							{
								P_Plus_IL_Offset = P_Ca_NG_PNP_Plus_IL_Offset(1);						// Offset value : -30
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M42_POS(2) + P_Plus_IL_Offset;	// NG PNP T축 플러스 이동 시 얼라인 위치 + Offset을 넘길 수 없음.
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_1st_PnP_CA_T;
							}
							else
//							{
//								P_Plus_IL_Offset = P_Ca_NG_PNP_Plus_IL_Offset(2);
//								P_Limit_PosData(Hex_IL_Plus) = 90 - P_Motor_Current_Pos(N_2nd_PnP_CA_T) + P_Plus_IL_Offset;
//								P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;

//							}
						// ================================ 마이너스 간섭 요인 : <<Unloader, Ca 2nd PNP>> ==================================//
							if(P_Motor_Current_Pos(N_UNLOADER_X) < P_Recipe_M46_POS(1) + 30 && P_Motor_Current_Pos(N_UNLOADER_Z) < P_Recipe_M47_POS(2) + 45)		// 취출위치 Z축 상승이라면,
							{
								P_Minus_IL_Offset = P_Ca_NG_PNP_Minus_IL_Offset(1);						// Offset value : 0
								//P_Limit_PosData(Hex_IL_Minus) = 70 + P_Minus_IL_Offset;
								P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M42_POS(2) - 20 + P_Minus_IL_Offset;	// NG PNP T축 마이너스 이동 시 얼라인 위치 - 20 + Offset을 넘길 수 없음.
								P_Collision_Risk_Motor(Hex_IL_Minus) = N_UNLOADER_Z;
							}
							else
							{
								P_Minus_IL_Offset = P_Ca_NG_PNP_Minus_IL_Offset(2);						// Offset value : 30
								//P_Limit_PosData(Hex_IL_Minus) = 45 + P_Minus_IL_Offset;					
								P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M42_POS(2) - 45 + P_Minus_IL_Offset;	// NG PNP T축 마이너스 이동 시 얼라인 위치 - 45 + Offset을 넘길 수 없음.
								P_Collision_Risk_Motor(Hex_IL_Minus) = N_2nd_PnP_CA_T;
							}
						}
						else
						{// 0 ~ 20 이면
						// ================================ 플러스 간섭 요인 : <<Ca 2nd PNP>> ==================================//	
							P_Plus_IL_Offset = P_Ca_NG_PNP_Plus_IL_Offset(3);							// Offset value : -10
							//P_Limit_PosData(Hex_IL_Plus) = 60 + P_Plus_IL_Offset;						
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M42_POS(1) + 60 + P_Plus_IL_Offset;	// NG PNP T축 플러스 이동 시 대기 위치 + 60 + Offset을 넘길 수 없음.						
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;
						// ================================ 마이너스 간섭 요인 : <<Unloader>> ==================================//	
							P_Minus_IL_Offset = P_Ca_NG_PNP_Minus_IL_Offset(3);							// Offset value : 0
							if(P_Motor_Current_Pos(N_UNLOADER_X) < P_Recipe_M46_POS(1) + 30 && P_Motor_Current_Pos(N_UNLOADER_Z) < P_Recipe_M47_POS(2) + 45)		// 취출위치 Z축 상승이라면,
							{
								//P_Limit_PosData(Hex_IL_Minus) = 70 + P_Minus_IL_Offset;
								P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M42_POS(2) - 20 + P_Minus_IL_Offset;	// NG PNP T축 마이너스 이동 시 얼라인 위치 - 20 + Offset을 넘길 수 없음.
								P_Collision_Risk_Motor(Hex_IL_Minus) = N_UNLOADER_Z;
							}
						}
					}
				}

			break;

			case N_NG_PnP_AN_T:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				if(P_IL_Outer_Status != IL_Out_Close)
				{
				//================================ 1번위치 - NG 대기 위치  ================================
					// ↓ 음극 NG PNP T축 대기 위치
					if(P_Motor_Current_Pos(N_NG_PnP_AN_T) ~ P_Recipe_M43_POS(1))	
						P_No1_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					else
						P_No1_Recipe_Pos_IL(N_NG_PnP_AN_T) = 0;
				//================================ 2번위치 - NG Align 위치 ================================
					// ↓ 음극 NG PNP T축 얼라인 위치 || 음극 2차 PNP T축 < 대기 위치 + 45º || 음극 1차 PNP T축 > 대기 위치
					if(P_Motor_Current_Pos(N_NG_PnP_AN_T) ~ P_Recipe_M43_POS(2) || P_Motor_Current_Pos(N_2nd_PnP_AN_T) < P_Recipe_M04_POS(1) + 45 || P_Motor_Current_Pos(N_1st_PnP_AN_T) > P_Recipe_M02_POS(1) + 0.2)	
						P_No2_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					else
						P_No2_Recipe_Pos_IL(N_NG_PnP_AN_T) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No3_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No4_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No5_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No6_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No7_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;		// 인터락
				}
				else
				{
					P_No1_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No2_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No3_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No4_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No5_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No6_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;
					P_No7_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_AN_T) = 1;		// 인터락
				}
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);		// NG PNP는 절대위치 반환이 안됨...
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
				{}
				else if(P_IL_Outer_Status == N_IL_Align_Pos )
				{// << N_IL_Align_Pos >> 20도 초과 일 경우
					if(P_Motor_Current_Pos(N_2nd_PnP_AN_T) > P_Recipe_M04_POS(1) + 40)
					{//2nd T 40도 초과 시
				// ================================ 플러스 간섭 요인 : <<An 1st PNP>> ==================================//
						if(P_Motor_Current_Pos(N_1st_PnP_AN_T) > P_Recipe_M02_POS(3) - 10)	// 1nd pnp가 70도 초과 부근이라면
						{
							P_Plus_IL_Offset = P_An_NG_PNP_Plus_IL_Offset(0);						// Offset value : -30
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M43_POS(2) + P_Plus_IL_Offset;	// NG PNP T축 플러스 이동 시 얼라인 위치 + Offset을 넘길 수 없음.
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_1st_PnP_AN_T;
						}
				// ================================ 마이너스 간섭 요인 : <<없음>> ==================================//
					}
					else
					{
						if(P_Motor_Current_Pos(N_2nd_PnP_AN_T) > P_Recipe_M04_POS(1) + 20 && P_Motor_Current_Pos(P_IL_Motor_Page) > 45)
						{// 2nd T 20 ~ 40도라면
				// ================================ 플러스 간섭 요인 : <<An 1st PNP>> ==================================//	
							if(P_Motor_Current_Pos(N_1st_PnP_AN_T) > P_Recipe_M02_POS(3) - 10)	// 1nd pnp가 70도 초과 부근이라면
							{
								P_Plus_IL_Offset = P_An_NG_PNP_Plus_IL_Offset(1);							// Offset value : -30
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M43_POS(2) + P_Plus_IL_Offset;		// NG PNP T축 플러스 이동 시 얼라인 위치 + Offset을 넘길 수 없음.
								P_Collision_Risk_Motor(Hex_IL_Plus) = N_1st_PnP_AN_T;
							}
				// ================================ 마이너스 간섭 요인 : <<An 2nd PNP>> ==================================//
							P_Minus_IL_Offset = P_An_NG_PNP_Minus_IL_Offset(0);							// Offset value : 30
							//P_Limit_PosData(Hex_IL_Minus) = 45 + P_Minus_IL_Offset;
							P_Limit_PosData(Hex_IL_Minus) = P_Recipe_M43_POS(2) - 45 + P_Minus_IL_Offset;	// NG PNP T축 마이너스 이동 시 얼라인 위치 - 45 + Offset을 넘길 수 없음.
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_2nd_PnP_AN_T;
						}
						else
						{// 0 ~ 20 이면
						// ================================ 플러스 간섭 요인 : <<An 2nd PNP>> ==================================//	
							P_Plus_IL_Offset = P_An_NG_PNP_Plus_IL_Offset(2);							// Offset value : -10
							//P_Limit_PosData(Hex_IL_Plus) = 60 + P_Plus_IL_Offset;
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M43_POS(1) + 60 + P_Plus_IL_Offset;	// NG PNP T축 플러스 이동 시 대기 위치 + 60 + Offset을 넘길 수 없음.
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_AN_T;
						// ================================ 마이너스 간섭 요인 : <<없음>> ==================================//	
						}
					}
				}
			break;

			case N_NG_PnP_CA_Z:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
		       if(P_IL_Outer_Status != IL_Out_Close) //[참조 : 260702 릴컷 또는 NG box 도어 열릴 시 Z축 레시피 이동 불가하도록 수정]
			   { 
				//================================ 1번위치 - NG 박스 상승 ================================
					// ↓ 양극 NG PNP T축 !~ 대기 위치 || 양극 NG PNP Z축 박스 상승
					if(!(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1)) || P_Motor_Current_Pos(N_NG_PnP_CA_Z) ~ P_Recipe_M44_POS(1))		
						P_No1_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;
					else
						P_No1_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 0;
				//================================ 2번위치 - NG 박스 하강 ================================
					// ↓ 양극 NG PNP T축 !~ 대기 위치 || 양극 NG PNP Z축 박스 하강
					if(!(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1)) || P_Motor_Current_Pos(N_NG_PnP_CA_Z) ~ P_Recipe_M44_POS(2))		
						P_No2_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;
					else
						P_No2_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 0;
				//================================ 3번위치 - 얼라인 상승 ================================
					// ↓ 양극 NG PNP T축 !~ 얼라인 위치 || 양극 NG PNP Z축 얼라인 상승
					if(!(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(2)) || P_Motor_Current_Pos(N_NG_PnP_CA_Z) ~ P_Recipe_M44_POS(3))		
						P_No3_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;
					else
						P_No3_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 0;
				//================================ 4번위치 - 얼라인 하강 ================================
					// ↓ 양극 NG PNP T축 !~ 얼라인 위치 || 양극 NG PNP Z축 얼라인 하강
					if(!(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(2)) || P_Motor_Current_Pos(N_NG_PnP_CA_Z) ~ P_Recipe_M44_POS(4))		
						P_No4_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;
					else
						P_No4_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No5_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;
					P_No6_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;
					P_No7_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;		// 인터락
				 }
				 else 
				 {
					P_No1_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;         // 인터락
					P_No2_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;         // 인터락
					P_No3_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_CA_Z) = 1;		// 인터락
				 }
			break;

			case N_NG_PnP_AN_Z:
				// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			     if(P_IL_Outer_Status != IL_Out_Close) //[참조 : 260702 릴컷 또는 NG box 도어 열릴 시 Z축 레시피 이동 불가하도록 수정]
			     {
				//================================ 1번위치 - NG 박스 상승 ================================
					// ↓ 음극 NG PNP T축 !~ 대기 위치	음극 NG PNP Z축 박스 상승
					if(!(P_Motor_Current_Pos(N_NG_PnP_AN_T) ~ P_Recipe_M43_POS(1)) || P_Motor_Current_Pos(N_NG_PnP_AN_Z) ~ P_Recipe_M45_POS(1))		
