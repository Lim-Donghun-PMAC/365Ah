// [ 참조: 1차,2차 언로더 회피 시퀀스 ]================================================================================================================================================
// 안전위치를 0도에서 45도로 보고
// 홈체크가 꺼져 있고 값이 쓰레기값이라면 
// 일단 정상적인 상황에 한해서만 적용
//if( P_PMAC_Homing_CHK(N_UNLOADER_T) == 1 && P_Motor_Current_Pos( N_UNLOADER_T ) > P_1st_ULD_T_Avoid_Angle )	// 위험위치에 언로더가 존재한다면
if( Motor[N_UNLOADER_T].HomeComplete == 0 )		// Home 한번도 안잡았다면
	M_Y_PLC_ULD_Home_Interlock_Signal = 0;		// 인터락
else if( Motor[N_UNLOADER_T].HomeComplete == 1 && P_Motor_Current_Pos( N_UNLOADER_T ) > P_1st_ULD_T_Avoid_Angle )	// 위험위치에 언로더가 존재한다면
	M_Y_PLC_ULD_Home_Interlock_Signal = 0;		// 인터락
else											// 이더캣 홈을 했고, 안전위치라면
	M_Y_PLC_ULD_Home_Interlock_Signal = 1;		// 인터락 해제

// 1차 언로더 그립상태 언그립 상태 PLC에게 송부
if( M_X_1st_Unloader_UnGrip_Detect_Sensor == 0 )		// 그립 상태
{
	M_Y_1st_UnGrip_State = 0;
	M_Y_1st_Grip_State = 1;
}
else if( M_X_1st_Unloader_UnGrip_Detect_Sensor == 1 )	// 언그립 상태
{
	M_Y_1st_UnGrip_State = 1;
	M_Y_1st_Grip_State = 0;
}

// 1차 2차 언로더 끼리 맞물려있을때 회피를 위한 언그립 신호 
if( P_PMAC_Current_Mode == F_Current_Manual && P_PMAC_Status == F_Status_STOPPED )	// 매뉴얼이면서, 스탑일때 
{
	if( M_X_PLC_ULD_Home_UnGrip_Signal == 1 )		// 2차언로더 1차언로더 간섭이 있어서, PLC에서 언그립 요청이 온다면
	{ 
		M_Y_1st_Unloader_Grip_Sol  = 0;				// 언그립
		M_Y_1st_Unloader_UnGrip_Sol = 1;			// 언그립
	}
} 

// ECAT Status Bit 버그가 있음 2026.06.17 발견	[ 참조: 2026.06.17 Ecat State Bit Check Prog ]
// AmpEna == 1 여도, State 0번 Bit가 0 << disable switch 상태로 있었음.
// 위의 상황에선 PMAC은 AmpEna 알고있고, Jog 명령을 내보낼때 서보 온 명령을 따로 하지 않게됨 
// Ecat 모터가 하필 대기위치여서,  홈 시퀀스가 그냥 넘어가게 되버림
// 위의 상황에서 State Output 명령을 shut down Switch on  명령을 해보았지만 먹히질 않음 따라서 Kill 하고 다시 해야 함

if( P_PMAC_Current_Mode == F_Current_Manual )		// 매뉴얼 모드일때
{
	if( L_Ecat_M >= 48 || L_Ecat_M < 33 )
		L_Ecat_M = 33;
	else
		L_Ecat_M++;

	if( Motor[L_Ecat_M].AmpEna == 1 )				// Servo Enable 상태이면서
	{
		if( !(M_Ecat_Motor_State(L_Ecat_M) & 1) )	// 0번째 비트가 죽어있다면
			Cmd"#%d kill",L_Ecat_M;
	}
}
//========================================================================================================================================================================
P_MNTR_PLC19_Task_Time(1) = (Sys.Time - P_MNTR_PLC19_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC19_Task_Time(1) > P_MNTR_PLC19_Task_Max_Time )
{
	P_MNTR_PLC19_Task_Max_Time = P_MNTR_PLC19_Task_Time(1);
}





