	// 일반 출력 모드 저장된 M변수 불러오기.
	sub:Normal_Mode_Retrieve_M_Variable(void)

		// GPIO #0
		M(P_Force_BTN_0th_Gpio_M_Variable_Num + P_Force_BTN_M_Variable_Save_Count) = P_Force_BTN_M_Variable_Save((P_Force_BTN_0th_Gpio_M_Variable_Num - P_Force_BTN_M_Variable_Start_Num) + P_Force_BTN_M_Variable_Save_Count)
