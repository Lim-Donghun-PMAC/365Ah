#define N_Heap_Arr_Length 100

//========================//
// 알람 프로그램 변수 선언 //
//========================//
global P_Alarm_Heap_Arr(N_Heap_Arr_Length);				// 힙정렬 버퍼
P_Alarm_Heap_Arr(0), N_Heap_Arr_Length = 0;

global P_Alarm_Send_To_PLC(4);							// 우선순위 알람 발생시 M변수를 순차적으로 발생시키기 위한 버퍼
P_Alarm_Send_To_PLC(0), 4 = 0;

global P_Alarm_Remain_Check = 0;						// 나머지 알람 유무 여부 플래그
global P_Alarm_First_Request_Flag = 0;					// 첫번째 알람 플래그
global P_Alarm_Command_Active = 0;						// 알람 발생시 P_PMAC_Command 발생 플래그

global P_Alarm_Number_RTN = 0;							// delete 데이터의 M변수 번호 값
global P_Alarm_Priority_RTN = 0;						// delete 데이터의 우선순위 값
global P_Alarm_Occur_Flag = 0;							// 알람 타입 확인 플래그

global P_Alarm_Priority_Cnt = 0;						// 우선순위 발생 카운트
global P_Old_Alarm_Priority_Cnt = 0;					// 우선순위 발생 카운트 이전값

global P_Alarm_Priority_Report = 0;						// 우선순위 알람 발생으로 인한 버퍼 사용 플래그
global P_Alarm_Priority_Request_Flag = 0;				// 우선순위 알람 플래그

#define N_Alarm_Wait 2000								// PLC 터치 패널의 시스템 상 순서를 위해 2초 딜레이 후 전송
global P_Alarm_Wait_Timer = 0;							// 알람 발생 타이머

#define N_Init_Prev_Priority 4							// 알람 타입 비교를 위해 기본값을 4로 지정 ( 경알람 : 3, 중알람 : 2, 즉시 정지 : 1 )
global P_Compare_Priority = N_Init_Prev_Priority;		// 우선순위 비교 변수
global P_Alarm_Priority_Occur_Cnt = 0;					// 우선 순위 알람 발생 카운트

global P_Alarm_Report = 0;								// 나머지 알람 시작 변수

#define N_Alarm_Log_Length 30							// 알람 로그 버퍼 사이즈
global P_Alarm_Log(N_Alarm_Log_Length);					// 알람 로그
P_Alarm_Log(0), N_Alarm_Log_Length = 0;					// 초기화
global P_Alarm_Data = 0;								// 알람 데이터

