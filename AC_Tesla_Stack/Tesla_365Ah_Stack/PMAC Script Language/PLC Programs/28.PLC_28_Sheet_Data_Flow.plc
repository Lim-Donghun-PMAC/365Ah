//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.11.17 
// 데이터 시프트 미비사항 보완 - [ 참조 : 25.11.17 데이터 시프트 미비사항 보완 ]
// (데이터 시프트 동작별 상태 추가, 데이터 파싱 I/O 매칭) 

open plc 28
P_MNTR_PLC28_Task_Time(0) = Sys.Time;
#define L_System_Timer		Sys.Time						// 시스템 타이머

local L_Time_Cycle_Up_Count_Start_Time;						// Plc[28].Ldata.L[0] 시작 체크 시작 시간
local L_Time_Cycle_Up_Count_End_Time;						// Plc[28].Ldata.L[1] 시작 체크 종료 시간
local L_Time_Cycle_Up_Count_Delta_Time;						// Plc[28].Ldata.L[2] 시작과 종료 시간 사이의 시간
local L_Flag_Cycle_Up_Count_Init_Flag;						// Plc[28].Ldata.L[3] 타이머 초기화 플래그

local L_Anode_Belt_Down_Timer;								// Plc[28].Ldata.L[4] 음극 데이터 플로우 타이머
local L_Anode_1st_Belt_Pick_Timer;							// Plc[28].Ldata.L[5] 음극 데이터 플로우 타이머
local L_Anode_1st_Align_Down_Timer;							// Plc[28].Ldata.L[6] 음극 데이터 플로우 타이머
local L_Anode_2nd_Align_Pick_Timer;							// Plc[28].Ldata.L[7] 음극 데이터 플로우 타이머
local L_Anode_2nd_Stack_Down_Timer;							// Plc[28].Ldata.L[8] 음극 데이터 플로우 타이머
local L_Anode_NG_Pick_Timer;								// Plc[28].Ldata.L[9] 음극 데이터 플로우 타이머
local L_Anode_NG_Place_Timer;								// Plc[28].Ldata.L[10] 음극 데이터 플로우 타이머
local L_Anode_2nd_Align_Down_Timer;							// PLC[28].Ldata.L[11] 음극 데이터 플로우 타이머
local L_Anode_1st_Align_Pick_Timer;							// PLC[28].Ldata.L[12] 음극 데이터 플로우 타이머

local L_Cathode_Belt_Down_Timer;							// Plc[28].Ldata.L[13] 양극 데이터 플로우 타이머
local L_Cathode_1st_Belt_Pick_Timer;						// Plc[28].Ldata.L[14] 양극 데이터 플로우 타이머
local L_Cathode_1st_Align_Down_Timer;						// Plc[28].Ldata.L[15] 양극 데이터 플로우 타이머
local L_Cathode_2nd_Align_Pick_Timer;						// Plc[28].Ldata.L[16] 양극 데이터 플로우 타이머
local L_Cathode_2nd_Stack_Down_Timer;						// Plc[28].Ldata.L[17] 양극 데이터 플로우 타이머
local L_Cathode_NG_Pick_Timer;								// Plc[28].Ldata.L[18] 양극 데이터 플로우 타이머
local L_Cathode_NG_Place_Timer;								// Plc[28].Ldata.L[19] 양극 데이터 플로우 타이머
local L_Cathode_2nd_Align_Down_Timer;						// Plc[28].Ldata.L[20] 양극 데이터 플로우 타이머
local L_Cathode_1st_Align_Pick_Timer;						// Plc[28].Ldata.L[21] 양극 데이터 플로우 타이머

local L_Anode_PMAC_to_VISION_Align_Passing_Reset_Timer;		// Plc[28].Ldata.L[22] 비전 데이터 수집 I/O Off 타이머
local L_Cathode_PMAC_to_VISION_Align_Passing_Reset_Timer;	// Plc[28].Ldata.L[23] 비전 데이터 수집 I/O Off 타이머

local L_Anode_Func_Return(8);								// Plc[28].Ldata.L[24 + 8] 함수 콜 리턴 -> 24 ~ 31
local L_Cathode_Func_Return(8);								// Plc[28].Ldata.L[32 + 8] 함수 콜 리턴 -> 32 ~ 39

local L_Anode_NG_Code_Delay_Timer;							// Plc[28].Ldata.L[40] 음극 NG 처리 타이머
local L_Cathode_NG_Code_Delay_Timer;						// Plc[28].Ldata.L[41] 양극 NG 처리 타이머

local L_Sheet_Info_Update;									// Plc[28].Ldata.L[42] 시트 데이터 확인 타이머

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if(L_Flag_Cycle_Up_Count_Init_Flag == 0)
{	// 시간 간격 초기화
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 00.2) 시간 체크
if(L_Flag_Cycle_Up_Count_Init_Flag == 1)
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale
	if(L_Time_Cycle_Up_Count_Delta_Time < 0)
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 00.3) 시간 업데이트
if(L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{
	
	L_Anode_Belt_Down_Timer = L_Anode_Belt_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_1st_Belt_Pick_Timer = L_Anode_1st_Belt_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_1st_Align_Down_Timer = L_Anode_1st_Align_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_2nd_Align_Pick_Timer = L_Anode_2nd_Align_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_2nd_Stack_Down_Timer = L_Anode_2nd_Stack_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_NG_Pick_Timer = L_Anode_NG_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_NG_Place_Timer = L_Anode_NG_Place_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_2nd_Align_Down_Timer = L_Anode_2nd_Align_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Anode_1st_Align_Pick_Timer = L_Anode_1st_Align_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Cathode_Belt_Down_Timer = L_Cathode_Belt_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_1st_Belt_Pick_Timer = L_Cathode_1st_Belt_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_1st_Align_Down_Timer = L_Cathode_1st_Align_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_2nd_Align_Pick_Timer = L_Cathode_2nd_Align_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_2nd_Stack_Down_Timer = L_Cathode_2nd_Stack_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_NG_Pick_Timer = L_Cathode_NG_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_NG_Place_Timer = L_Cathode_NG_Place_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_2nd_Align_Down_Timer = L_Cathode_2nd_Align_Down_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_1st_Align_Pick_Timer = L_Cathode_1st_Align_Pick_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Anode_PMAC_to_VISION_Align_Passing_Reset_Timer = L_Anode_PMAC_to_VISION_Align_Passing_Reset_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_PMAC_to_VISION_Align_Passing_Reset_Timer = L_Cathode_PMAC_to_VISION_Align_Passing_Reset_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Anode_NG_Code_Delay_Timer = L_Anode_NG_Code_Delay_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Cathode_NG_Code_Delay_Timer = L_Cathode_NG_Code_Delay_Timer + L_Time_Cycle_Up_Count_Delta_Time;

	L_Sheet_Info_Update = L_Sheet_Info_Update + L_Time_Cycle_Up_Count_Delta_Time;

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//========================================================================================================================
// Anode
//========================================================================================================================
// [1] 음극 1차 P&P 벨트 하강시
// PLC Belt -> PMAC Belt
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_1st_TR_Belt_Down_Flag == 1)
{
	P_Anode_1st_TR_Belt_Down_Flag = 0;				 // 플래그 초기화
	Sys_Anode_Belt_Sheet_Data = 0;					 // Belt Data 초기화
	L_Anode_Belt_Down_Timer = 0;					 // 타이머 초기화
	P_Anode_1st_TR_Belt_Down_State_Machine = 1;      // 스텟 머신 증가
	P_Anode_1st_TR_Belt_Down_Status = F_Status_STARTING;
}

switch(P_Anode_1st_TR_Belt_Down_State_Machine)
{
	case 0 :
		P_Anode_1st_TR_Belt_Down_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1 :
		P_Anode_1st_TR_Belt_Down_Status = F_Status_EXECUTE;

		if(L_Anode_Belt_Down_Timer > 50)
		{
			P_Old_Anode_Belt_ASCII = M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 4) << 8 | M_ASCII_Anode_Sheet_Buffer(N_Sheet_Data_1st_TR + 5);
			Sys_Anode_Belt_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;

			//if(M_X_PLC_Anode_NG)
			//{
			//	Sys_Anode_Belt_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;
			//}
			P_Anode_1st_TR_Belt_Down_Status = F_Status_EXECUTE;
			P_Anode_1st_TR_Belt_Down_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Complete_Step :
		P_Anode_1st_TR_Belt_Down_Status = F_Status_COMPLETE;
	break;

	default: break;
}
//------------------------------------------------------------------------------------------------------------------------
// [2] 음극 1차 P&P 벨트 픽업시
// PMAC Belt -> 1차 P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_1st_TR_Belt_Pick_Up_Flag == 1)
{
	P_Anode_1st_TR_Belt_Pick_Up_Flag = 0;
	L_Anode_1st_Belt_Pick_Timer = 0;

	P_Anode_1st_TR_Belt_Pick_Up_State_Machine = 1;
	P_Anode_1st_TR_Belt_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Anode_1st_TR_Belt_Pick_Up_State_Machine)
{
	case 0 :
		P_Anode_1st_TR_Belt_Pick_Up_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1:
		P_Anode_1st_TR_Belt_Pick_Up_Status = F_Status_EXECUTE;
		
		if(L_Anode_1st_Belt_Pick_Timer < P_Check_Vac_Time)
		{
			P_Anode_Belt_ASCII = Sys.Udata[10004] << 8 | Sys.Udata[10005];			// PLC 벨트 현재 데이터 

			if( (Sys_Anode_Belt_Sheet_LO_Vision_BYTE != 0 && P_Old_Anode_Belt_ASCII != P_Anode_Belt_ASCII) || P_Temp_Run_Mode == 1)	// 데이터 갱신이 됬는지 확인
			{
				// [참조 : 260427 시트아이디 비트 연산 주석 처리]
				//Sys_Anode_Belt_Sheet_LO_ASCII_BYTE = Sys.Cdata[40019] << 8 | Sys.Cdata[40020];
				
				P_Anode_1st_TR_Belt_Pick_Up_State_Machine++;
			}
		}
		else // 타임 아웃
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 80
			P_Sheet_Err(0)++
			P_Anode_1st_TR_Belt_Pick_Up_State_Machine = N_Error_Step;

		}
	break;

	case 2:
		P_Anode_1st_TR_Belt_Pick_Up_Status = F_Status_EXECUTE;

		L_Anode_Func_Return(0) = 0;

		call Sheet_Data_Flow.Anode_Move_Sheet_Data(0, N_Sheet_Data_1st_TR, &L_Anode_Func_Return(0));

		if(L_Anode_Func_Return(0))
		{
			L_Anode_Func_Return(0) = 0;

			Sys_Anode_1st_Sheet_Data = Sys_Anode_Belt_Sheet_Data;
			Sys_Anode_Belt_Sheet_Data = 0;

			P_Anode_1st_TR_Belt_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Anode_1st_TR_Belt_Pick_Up_Status = F_Status_STOPPED;

	break;

	Case N_Complete_Step : 
		P_Anode_1st_TR_Belt_Pick_Up_Status = F_Status_COMPLETE;
	break;

	default : break;
}
//------------------------------------------------------------------------------------------------------------------------
// [3] 음극 1차 P&P 얼라인 테이블 하강 후 파기시
// 1차 P&P -> Align table
// PLC -> Udata, Vision -> P 변수 지정
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_1st_TR_Align_Down_Flag == 1)
{
	P_Anode_1st_TR_Align_Down_Flag = 0;	

	L_Anode_1st_Align_Down_Timer = 0;
	P_Anode_1st_TR_Align_Down_State_Machine = 1;
	P_Anode_1st_TR_Align_Down_Status = F_Status_STARTING;
}

switch(P_Anode_1st_TR_Align_Down_State_Machine)
{
	case 0 :
		P_Anode_1st_TR_Align_Down_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1 :
		P_Anode_1st_TR_Align_Down_Status = F_Status_EXECUTE;

		if(L_Anode_1st_Align_Down_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
			{
				P_Anode_1st_TR_Align_Down_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 81
			P_Sheet_Err(1)++
			P_Anode_1st_TR_Align_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Anode_1st_TR_Align_Down_Status = F_Status_EXECUTE;

		L_Anode_Func_Return(1)= 0;

		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_1st_TR, N_Sheet_Data_Align_Table, &L_Anode_Func_Return(1));

		if(L_Anode_Func_Return(1))
		{
			L_Anode_Func_Return(1) = 0;

			Sys_Anode_Align_Sheet_Data = Sys_Anode_1st_Sheet_Data;
			Sys_Anode_1st_Sheet_Data = 0;

			M_Y_Vision_Anode_Data_Transfer_Trigger = 1;
			L_Anode_PMAC_to_VISION_Align_Passing_Reset_Timer = 0;
			P_Anode_1st_TR_Align_Down_State_Machine = N_Complete_Step;

		}
	break;

	Case N_Error_Step : 
		P_Anode_1st_TR_Align_Down_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_1st_TR_Align_Down_Status = F_Status_COMPLETE;
	break;

	default : break;
}
//------------------------------------------------------------------------------------------------------------------------
// [4] 음극 2차 P&P 얼라인 테이블픽업 시
// Align Table -> 2차 P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_2nd_TR_Align_Pick_Up_Flag == 1)
{
	P_Anode_2nd_TR_Align_Pick_Up_Flag = 0;

	L_Anode_2nd_Align_Pick_Timer = 0;
	P_Anode_2nd_TR_Align_Pick_Up_State_Machine = 1;
	P_Anode_2nd_TR_Align_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Anode_2nd_TR_Align_Pick_Up_State_Machine)
{
	case 0 :
		P_Anode_2nd_TR_Align_Pick_Up_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1 :
		P_Anode_2nd_TR_Align_Pick_Up_Status = F_Status_EXECUTE;			
		
		if(L_Anode_2nd_Align_Pick_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_Align_Sheet_Data != 0)
			{	
				P_Anode_2nd_TR_Align_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 83
			P_Sheet_Err(2)++
			P_Anode_2nd_TR_Align_Pick_Up_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Anode_2nd_TR_Align_Pick_Up_Status = F_Status_EXECUTE;

		L_Anode_Func_Return(2) = 0;
		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_Align_Table, N_Sheet_Data_2nd_TR, &L_Anode_Func_Return(2));

		if(L_Anode_Func_Return(2))
		{
			L_Anode_Func_Return(2) = 0;

			Sys_Anode_2nd_Sheet_Data = Sys_Anode_Align_Sheet_Data;
			Sys_Anode_Align_Sheet_Data = 0;

			P_Anode_2nd_TR_Align_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Anode_2nd_TR_Align_Pick_Up_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_2nd_TR_Align_Pick_Up_Status = F_Status_COMPLETE;
	break;

	default : break;

}
//------------------------------------------------------------------------------------------------------------------------
// [5]. 음극 2차 P&P 스택 테이블 파기시
// 2차 P&P -> Stack Table
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_2nd_TR_Stack_Down_Flag == 1)
{
	P_Anode_2nd_TR_Stack_Down_Flag = 0;

	L_Anode_2nd_Stack_Down_Timer = 0;
	P_Anode_2nd_TR_Stack_Down_State_Machine = 1;
	P_Anode_2nd_TR_Stack_Down_Status = F_Status_STARTING;
}

switch(P_Anode_2nd_TR_Stack_Down_State_Machine)
{
	case 0 :
		P_Anode_2nd_TR_Stack_Down_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1 :
		P_Anode_2nd_TR_Stack_Down_Status = F_Status_EXECUTE;

		if(L_Anode_2nd_Stack_Down_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_2nd_Sheet_Data != 0)
			{
				P_Anode_2nd_TR_Stack_Down_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 84
			P_Sheet_Err(3)++
			P_Anode_2nd_TR_Stack_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Anode_2nd_TR_Stack_Down_Status = F_Status_EXECUTE;

		L_Anode_Func_Return(3) = 0;

		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_2nd_TR, N_Sheet_Data_Stack_Table, &L_Anode_Func_Return(3));

		if(L_Anode_Func_Return(3))
		{
			L_Anode_Func_Return(3) = 0;
			Sys_Stack_Sheet_Data = Sys_Anode_2nd_Sheet_Data;

			Sys_Anode_2nd_Sheet_Data = 0;

			P_Anode_2nd_TR_Stack_Down_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Anode_2nd_TR_Stack_Down_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_2nd_TR_Stack_Down_Status = F_Status_COMPLETE;
	break;

	default :	break;

}

//------------------------------------------------------------------------------------------------------------------------
// [6]. 음극 - NG 처리 (예외처리 Part) 
// Align Table -> Ng P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_NG_TR_Align_Pick_Up_Flag == 1)
{
	P_Anode_NG_TR_Align_Pick_Up_Flag = 0;

	L_Anode_NG_Pick_Timer = 0;
	P_Anode_NG_TR_Align_Pick_Up_State_Machine = 1;
	P_Anode_NG_TR_Align_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Anode_NG_TR_Align_Pick_Up_State_Machine)
{
	case 0 :
		P_Anode_NG_TR_Align_Pick_Up_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1 :
		P_Anode_NG_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		if(L_Anode_NG_Pick_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_Align_Sheet_Data != 0)
			{
				P_Anode_NG_TR_Align_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 85
			P_Sheet_Err(4)++
			P_Anode_NG_TR_Align_Pick_Up_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Anode_NG_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		L_Anode_Func_Return(4) = 0;

		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_Align_Table, N_Sheet_Data_NG_TR, &L_Anode_Func_Return(4))

		if(L_Anode_Func_Return(4))
		{
			L_Anode_Func_Return(4) = 0;

			Sys_Anode_NG_TR_Sheet_Data = Sys_Anode_Align_Sheet_Data;
			Sys_Anode_Align_Sheet_Data = 0;

			P_Anode_NG_TR_Align_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;
	
	Case N_Error_Step : 
		P_Anode_NG_TR_Align_Pick_Up_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_NG_TR_Align_Pick_Up_Status = F_Status_COMPLETE;
	break;

	default :	break;
}
//------------------------------------------------------------------------------------------------------------------------
// 7. NG P&P가 Ng place에 파기시
// NG P&P -> NG Place
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_NG_TR_NG_Place_Down_Flag == 1)
{
	P_Anode_NG_TR_NG_Place_Down_Flag = 0;

	L_Anode_NG_Place_Timer = 0;
	P_Anode_NG_TR_NG_Place_Down_State_Machine = 1;
	P_Anode_NG_TR_NG_Place_Down_Status = F_Status_STARTING;
}

switch(P_Anode_NG_TR_NG_Place_Down_State_Machine)
{
	case 0 :
		P_Anode_NG_TR_NG_Place_Down_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1 :
		P_Anode_NG_TR_NG_Place_Down_Status = F_Status_EXECUTE;
		if(L_Anode_NG_Place_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_NG_TR_Sheet_Data != 0)
			{
				P_Anode_NG_TR_NG_Place_Down_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 86
			P_Sheet_Err(5)++
			P_Anode_NG_TR_NG_Place_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Anode_NG_TR_NG_Place_Down_Status = F_Status_EXECUTE;
		L_Anode_Func_Return(5) = 0;

		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_NG_TR, N_Sheet_Data_NG_Place, &L_Anode_Func_Return(5))

		if(L_Anode_Func_Return(5))
		{
			L_Anode_Func_Return(5) = 0;
			Sys_Anode_NG_Place_Sheet_Data = Sys_Anode_NG_TR_Sheet_Data;
			Sys_Anode_NG_TR_Sheet_Data = 0;
			P_Send_Anode_NG_Code_Flag = 1;
			P_Anode_NG_TR_NG_Place_Down_State_Machine = N_Complete_Step;
		}
	break;
	
	Case N_Error_Step : 
		P_Anode_NG_TR_NG_Place_Down_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_NG_TR_NG_Place_Down_Status = F_Status_COMPLETE;
	break;

	default :	break;
}
//------------------------------------------------------------------------------------------------------------------------
// [8]. 음극 2차 P&P 얼라인테이블 파기시
// 2차 P&P -> Align Table
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_2nd_TR_Align_Down_Flag == 1)
{
	P_Anode_2nd_TR_Align_Down_Flag = 0;
	
	L_Anode_2nd_Align_Down_Timer = 0;
	P_Anode_2nd_TR_Align_Down_State_Machine = 1;
	P_Anode_2nd_TR_Align_Down_Status = F_Status_STARTING;
}

switch(P_Anode_2nd_TR_Align_Down_State_Machine)
{
	case 0 :
		P_Anode_2nd_TR_Align_Down_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1:
		P_Anode_2nd_TR_Align_Down_Status = F_Status_EXECUTE;
		if(L_Anode_2nd_Align_Down_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_2nd_Sheet_Data != 0)
			{
				P_Anode_2nd_TR_Align_Down_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 94
			P_Sheet_Err(6)++
			P_Anode_2nd_TR_Align_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2:
		P_Anode_2nd_TR_Align_Down_Status = F_Status_EXECUTE;
		L_Anode_Func_Return(6) = 0;
		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_2nd_TR, N_Sheet_Data_Align_Table, &L_Anode_Func_Return(6));

		if(L_Anode_Func_Return(6))
		{
			L_Anode_Func_Return(6) = 0;
			Sys_Anode_Align_Sheet_Data = Sys_Anode_2nd_Sheet_Data;
			Sys_Anode_2nd_Sheet_Data = 0;
//			P_Send_Anode_NG_Code_Flag = 1;
			P_Anode_2nd_TR_Align_Down_State_Machine = N_Complete_Step;
		}
	break;
	
	Case N_Error_Step : 
		P_Anode_2nd_TR_Align_Down_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_2nd_TR_Align_Down_Status = F_Status_COMPLETE;
	break;

	default : break;
}
//------------------------------------------------------------------------------------------------------------------------
// [9]. 음극 1차 P&P 얼라인테이블 픽업시
// Align Table -> 1차 P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Anode_1st_TR_Align_Pick_Up_Flag == 1)
{
	P_Anode_1st_TR_Align_Pick_Up_Flag = 0;
	
	L_Anode_1st_Align_Pick_Timer = 0;
	P_Anode_1st_TR_Align_Pick_Up_State_Machine = 1;
	P_Anode_1st_TR_Align_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Anode_1st_TR_Align_Pick_Up_State_Machine)
{
	case 0 :
		P_Anode_1st_TR_Align_Pick_Up_Status = F_Status_IDLE;  // 스텟 머신 상태 IDLE 
	break;

	case 1:
		P_Anode_1st_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		if(L_Anode_1st_Align_Pick_Timer < P_Check_Vac_Time)
		{
			if(Sys_Anode_Align_Sheet_Data != 0)
			{
				P_Anode_1st_TR_Align_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 37
			P_Sheet_Err(7)++
			P_Anode_1st_TR_Align_Pick_Up_State_Machine = N_Error_Step;
		}
	break;

	case 2:
		P_Anode_1st_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		L_Anode_Func_Return(7) = 0;
		call Sheet_Data_Flow.Anode_Move_Sheet_Data(N_Sheet_Data_Align_Table, N_Sheet_Data_1st_TR,&L_Anode_Func_Return(7));

		if(L_Anode_Func_Return(7))
		{
			L_Anode_Func_Return(7) = 0;
			Sys_Anode_1st_Sheet_Data = Sys_Anode_Align_Sheet_Data;
			Sys_Anode_Align_Sheet_Data = 0;
			
			P_Anode_1st_TR_Align_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;
	
	Case N_Error_Step : 
		P_Anode_1st_TR_Align_Pick_Up_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Anode_1st_TR_Align_Pick_Up_Status = F_Status_COMPLETE;
	break;

	default :	break;
}

//========================================================================================================================
// Cathode
//========================================================================================================================
// [1]. 양극 1차 P&P 벨트 하강시
// PLC Belt -> PMAC Belt
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_1st_TR_Belt_Down_Flag == 1)
{
	P_Cathode_1st_TR_Belt_Down_Flag = 0;		// 플래그 초기화
	Sys_Cathode_Belt_Sheet_Data = 0;			// Belt Data 초기화
	L_Cathode_Belt_Down_Timer = 0;				// 타이머 초기화
	P_Cathode_1st_TR_Belt_Down_State_Machine = 1;
	P_Cathode_1st_TR_Belt_Down_Status = F_Status_STARTING;

}

switch(P_Cathode_1st_TR_Belt_Down_State_Machine)
{
	case 0 :
		P_Cathode_1st_TR_Belt_Down_Status = F_Status_IDLE;
	break;

	case 1 :
			P_Cathode_1st_TR_Belt_Down_Status = F_Status_EXECUTE;
		
		if(L_Cathode_Belt_Down_Timer > 50 || P_Temp_Run_Mode == 1)
		{
			P_Old_Cathode_Belt_ASCII = M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 4) << 8 | M_ASCII_Cathode_Sheet_Buffer(N_Sheet_Data_1st_TR + 5);
			Sys_Cathode_Belt_Sheet_LO_Vision_BYTE |= Hex_Cell_Existence;
//			if(M_X_PLC_Cathode_NG)
//			{
//				Sys_Cathode_Belt_Sheet_LO_Vision_BYTE |= Hex_Maint_NG;
//			}
			P_Cathode_1st_TR_Belt_Down_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Complete_Step : 
		P_Cathode_1st_TR_Belt_Down_Status = F_Status_COMPLETE;
	break;

	Default : break;
}
//------------------------------------------------------------------------------------------------------------------------
// [2].양극 1차 P&P 벨트 픽업시
// PMAC Belt -> 1차 P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_1st_TR_Belt_Pick_Up_Flag == 1)
{
	P_Cathode_1st_TR_Belt_Pick_Up_Flag = 0;
	L_Cathode_1st_Belt_Pick_Timer = 0;

	P_Cathode_1st_TR_Belt_Pick_Up_State_Machine = 1;
	P_Cathode_1st_TR_Belt_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Cathode_1st_TR_Belt_Pick_Up_State_Machine)
{
	case 0 :
		P_Cathode_1st_TR_Belt_Pick_Up_Status = F_Status_IDLE;
	break;

	case 1:
		P_Cathode_1st_TR_Belt_Pick_Up_Status = F_Status_EXECUTE;
		if(L_Cathode_1st_Belt_Pick_Timer < P_Check_Vac_Time)
		{
			P_Cathode_Belt_ASCII = Sys.Udata[10012] << 8 | Sys.Udata[10013];			// 현재 데이터 

			if( (Sys_Cathode_Belt_Sheet_LO_Vision_BYTE != 0 && P_Old_Cathode_Belt_ASCII != P_Cathode_Belt_ASCII) || P_Temp_Run_Mode == 1)
			{	
				// [참조 : 260427 시트아이디 비트 연산 주석 처리]
				//Sys_Cathode_Belt_Sheet_LO_ASCII_BYTE = Sys.Cdata[40051] << 8 | Sys.Cdata[40052];

				P_Cathode_1st_TR_Belt_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 87
			P_Sheet_Err(8)++
			P_Cathode_1st_TR_Belt_Pick_Up_State_Machine = N_Error_Step;

		}
	break;

	case 2:
		P_Cathode_1st_TR_Belt_Pick_Up_Status = F_Status_EXECUTE;

		L_Cathode_Func_Return(0) = 0;

		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(0, N_Sheet_Data_1st_TR, &L_Cathode_Func_Return(0));

		if(L_Cathode_Func_Return(0))
		{
			L_Cathode_Func_Return(0) = 0;

			Sys_Cathode_1st_Sheet_Data = Sys_Cathode_Belt_Sheet_Data;
			Sys_Cathode_Belt_Sheet_Data = 0;

			P_Cathode_1st_TR_Belt_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Cathode_1st_TR_Belt_Pick_Up_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Cathode_1st_TR_Belt_Pick_Up_Status = F_Status_COMPLETE;
	break;
	
	default: break;
}
//------------------------------------------------------------------------------------------------------------------------
// [3].양극 1차 P&P 얼라인 테이블 하강 후 파기시
// 1차 P&P -> Align table
// PLC -> Udata, Vision -> P 변수 지정
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_1st_TR_Align_Down_Flag == 1)
{
	P_Cathode_1st_TR_Align_Down_Flag = 0;	

	L_Cathode_1st_Align_Down_Timer = 0;
	P_Cathode_1st_TR_Align_Down_State_Machine = 1;
	P_Cathode_1st_TR_Align_Down_Status = F_Status_STARTING;

}

switch(P_Cathode_1st_TR_Align_Down_State_Machine)
{
	case 0 :
		P_Cathode_1st_TR_Align_Down_Status = F_Status_IDLE;
	break;

	case 1 :
		P_Cathode_1st_TR_Align_Down_Status = F_Status_EXECUTE;
		if(L_Cathode_1st_Align_Down_Timer < P_Check_Vac_Time)
		{
			if(Sys_Cathode_1st_Sheet_LO_Vision_BYTE & Hex_Cell_Existence)
			{
				P_Cathode_1st_TR_Align_Down_State_Machine++;

			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 88
			P_Sheet_Err(9)++
			P_Cathode_1st_TR_Align_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Cathode_1st_TR_Align_Down_Status = F_Status_EXECUTE;
		L_Cathode_Func_Return(1)= 0;

		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_1st_TR, N_Sheet_Data_Align_Table, &L_Cathode_Func_Return(1));

		if(L_Cathode_Func_Return(1))
		{
			L_Cathode_Func_Return(1) = 0;

			Sys_Cathode_Align_Sheet_Data = Sys_Cathode_1st_Sheet_Data;
			Sys_Cathode_1st_Sheet_Data = 0;

			M_Y_Vision_Cathode_Data_Transfer_Trigger = 1;
			L_Cathode_PMAC_to_VISION_Align_Passing_Reset_Timer = 0;
			P_Cathode_1st_TR_Align_Down_State_Machine = 0;
		}
	break;

	Case N_Error_Step : 
		P_Cathode_1st_TR_Align_Down_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Cathode_1st_TR_Align_Down_Status = F_Status_COMPLETE;
	break;
	
	default: break;
}
//------------------------------------------------------------------------------------------------------------------------
// [4]. 양극 2차 P&P 얼라인 테이블픽업 시
// Align Table -> 2차 P&P
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_2nd_TR_Align_Pick_Up_Flag == 1)
{
	P_Cathode_2nd_TR_Align_Pick_Up_Flag = 0;

	L_Cathode_2nd_Align_Pick_Timer = 0;
	P_Cathode_2nd_TR_Align_Pick_Up_State_Machine = 1;
	P_Cathode_2nd_TR_Align_Pick_Up_Status = F_Status_STARTING;
}

switch(P_Cathode_2nd_TR_Align_Pick_Up_State_Machine)
{
	case 0 :
		P_Cathode_1st_TR_Align_Down_Status = F_Status_IDLE;
	break;

	case 1 :
		P_Cathode_2nd_TR_Align_Pick_Up_Status = F_Status_EXECUTE;
		if(L_Cathode_2nd_Align_Pick_Timer < P_Check_Vac_Time)
		{
			if(Sys_Cathode_Align_Sheet_Data != 0)
			{
				P_Cathode_2nd_TR_Align_Pick_Up_State_Machine++;
			}
		}
		else
		{
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 89
			P_Sheet_Err(10)++
			P_Cathode_2nd_TR_Align_Pick_Up_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Cathode_2nd_TR_Align_Pick_Up_Status = F_Status_EXECUTE;

		L_Cathode_Func_Return(2) = 0;
		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_Align_Table, N_Sheet_Data_2nd_TR, &L_Cathode_Func_Return(2));

		if(L_Cathode_Func_Return(2))
		{
			L_Cathode_Func_Return(2) = 0;

			Sys_Cathode_2nd_Sheet_Data = Sys_Cathode_Align_Sheet_Data;
			Sys_Cathode_Align_Sheet_Data = 0;

			P_Cathode_2nd_TR_Align_Pick_Up_State_Machine = N_Complete_Step;
		}
	break;

	Case N_Error_Step : 
		P_Cathode_2nd_TR_Align_Pick_Up_Status = F_Status_STOPPED;
	break;

	Case N_Complete_Step : 
		P_Cathode_2nd_TR_Align_Pick_Up_Status = F_Status_COMPLETE;

	break;
	
	default: break;

}
//------------------------------------------------------------------------------------------------------------------------
// [5].양극 2차 P&P 스택 테이블 파기시
// 2차 P&P -> Stack Table
//------------------------------------------------------------------------------------------------------------------------
if(P_Cathode_2nd_TR_Stack_Down_Flag == 1)
{
	P_Cathode_2nd_TR_Stack_Down_Flag = 0;

	L_Cathode_2nd_Stack_Down_Timer = 0;
	P_Cathode_2nd_TR_Stack_Down_Status = F_Status_STARTING;
	
	P_Cathode_2nd_TR_Stack_Down_State_Machine = 1;
}

switch(P_Cathode_2nd_TR_Stack_Down_State_Machine)
{
	case 0 :
		P_Cathode_2nd_TR_Stack_Down_Status = F_Status_IDLE;
	break;

	case 1 :
		P_Cathode_2nd_TR_Stack_Down_Status = F_Status_STARTING;
		if(L_Cathode_2nd_Stack_Down_Timer < P_Check_Vac_Time)
		{
			P_Cathode_2nd_TR_Stack_Down_Status = F_Status_EXECUTE;
			if(Sys_Cathode_2nd_Sheet_Data != 0)
			{
				P_Cathode_2nd_TR_Stack_Down_State_Machine++;
			}
		}
		else
		{
			P_Cathode_2nd_TR_Stack_Down_Status = F_Status_EXECUTE;
			P_PMAC_Commands = F_Command_Stop;
			P_Stop_Cmd_Origin = 90
			P_Sheet_Err(11)++
			P_Cathode_2nd_TR_Stack_Down_State_Machine = N_Error_Step;
		}
	break;

	case 2 :
		P_Cathode_2nd_TR_Stack_Down_Status = F_Status_EXECUTE;
		L_Cathode_Func_Return(3) = 0;

		call Sheet_Data_Flow.Cathode_Move_Sheet_Data(N_Sheet_Data_2nd_TR, N_Sheet_Data_Stack_Table, &L_Cathode_Func_Return(3));

		if(L_Cathode_Func_Return(3))
		{
			L_Cathode_Func_Return(3) = 0;
			Sys_Stack_Sheet_Data = Sys_Cathode_2nd_Sheet_Data;

			Sys_Cathode_2nd_Sheet_Data = 0;

			P_Cathode_2nd_TR_Stack_Down_State_Machine = N_Complete_Step;

		}
	break;

	Case N_Error_Step : 
		P_Cathode_2nd_TR_Stack_Down_Status = F_Status_STOPPED;

	break;

	Case N_Complete_Step : 
		P_Cathode_2nd_TR_Stack_Down_Status = F_Status_COMPLETE;

	break;
	
	default: break;
}
//------------------------------------------------------------------------------------------------------------------------
// 예외처리
// [6]. 양극 - NG 처리 (예외처리 Part) 
