// Pause Resume 수정		[ 참조 : 26.07.31 Pause_Resume 수정 ] 
// 1. 본인 열이 세파모드 일 때 반대 열이 Pause를 걸어도 본인 열은 Pause에 걸리지 않음
// 1.1 본인 열이 세파모드 일 때 반대 열은 자유롭게 Resume 할 수 있음
// 2. ARC,EPC Sepa 모드의 경우 세파모드 후 일반모드가 될 때 Starting이 아닌 Execute로 진행
// 2.2 Starting이 아닌 Execute로 바로 진행 할 경우 MasterTrigger Sync 타이밍이 맞지 않을 수 있어 Sync를 맞춰줌
global P_Sepa_Mode_Opposite_Resume_Free = 0;			// [1:자유롭게 Resume 가능] 세파 모드 일 경우 반대 열 자유롭게 Resume 할 수 있게 하는 변수. [ 참조 : 26.07.31 Pause_Resume 수정 ] 
global P_Sepa_To_Normal_Mode_Sync_Flag = 0;				// [커터 전진할 때 켜줌 1:isenable에서 싱크 맞춤] 세파 모드 → 일반 모드가 가능한 세파 모드 일 경우 Execute에서 싱크 맞추기 위한 플래그 변수. [ 참조 : 26.07.31 Pause_Resume 수정 ]
global P_Sepa_To_Normal_Mode_Sync_Err_Avoid = 0;		// [isenable에서 싱크 맞추기 전 켰다가 싱크 맞춘 후 끔] Execute에서 Sync 진행 시 Error를 피하는 변수.

// Pause, Resume 시간 확인
