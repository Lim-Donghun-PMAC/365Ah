//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.04
//[ 참조 : 25.07.04 EPC 프로그램 신규 추가 ]

open plc 18
P_MNTR_PLC18_Task_Time(0) = Sys.Time;
#define	L_System_Timer				Sys.Time			// 시스템 타이머

Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[18].ldata.L[0] 	시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[18].ldata.L[1] 	시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[18].ldata.L[2] 	시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[18].ldata.L[3] 	타이머 초기화 플래그

Local	L_PLC18_Main_Timer; 							// Plc[18].ldata.L[4]	PLC 18 메인 타이머
Local	L_PLC18_EPC_Timer;								// Plc[18].ldata.L[5]	EPC 타이머
Local	L_PLC18_EPC_Move_Flag_Reset_Timer;				// Plc[18].ldata.L[6]	보정위치 이동 확인용 타이머 초기화
local	L_PLC18_Vision_Recipe_EPC_um;					// Plc[18].ldata.L[7]	Vision Recipe값 담을 변수

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
If( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 00.2) 시간 체크
If( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	If( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}
// 00.3) 시간 업데이트
If (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{	
	L_PLC18_Main_Timer = L_PLC18_Main_Timer + L_Time_Cycle_Up_Count_Delta_Time;											// 메인 타이머
	L_PLC18_EPC_Timer = L_PLC18_EPC_Timer + L_Time_Cycle_Up_Count_Delta_Time;											// EPC 보정 또는 실시간 보정 타임 결정 타이머														
	L_PLC18_EPC_Move_Flag_Reset_Timer = L_PLC18_EPC_Move_Flag_Reset_Timer + L_Time_Cycle_Up_Count_Delta_Time;			// 비전측 보정값 요청 Trigger 꺼주는 시간체크용 타이머
	P_ARC_EPC_Vision_Value_Apply_Timer = P_ARC_EPC_Vision_Value_Apply_Timer + L_Time_Cycle_Up_Count_Delta_Time;			// ARC 이후 및 세파 소비 모드 진행 후 배출 시 ARC EPC값 적용 타이머.	[ 참조 : 26.05.08 ARC 후 ARC EPC값 적용 인터페이스 추가 ]

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}
//=================================================================================
// [0] 	 EPC 모듈 동작 조건부
// [0.1] 인터락부 [액츄에이터 자동동작, 수동동작 인터락 설정]   
// [1] 	 EPC 동작부
//=================================================================================
// [0] EPC 모듈 동작 조건부   
//=================================================================================

if( P_PMAC_Current_Mode == F_Current_Automatic )								//0. 오토모드라면 
{
	if( P_Vison_Read_EPC_Camera_Move_Request == 1 && P_Vison_Read_EPC_Camera_Move_Request != P_Old_Vison_Read_EPC_Camera_Move_Request )
	{
		if(P302 == 0)	//임시로 해당 부분 막아둠.
		{
			P_PLC18_EPC_Moving_Flag = N_TRUE;										// 0.1.1) EPC 동작 모듈 실행 플레그 ON		
		}
	}
}
else																				// 0.2) 메뉴얼 상태라면
{
	P_PLC18_EPC_Moving_Flag = 0;													// 0.2.1)  EPC 동작 모듈 실행 플레그 OFF
}	
P_Old_Vison_Read_EPC_Camera_Move_Request = P_Vison_Read_EPC_Camera_Move_Request;	// 0.3) 비전 보정값 전달 완료 신호 이전값

//=================================================================================
// [0]-1 인터락부 [액츄에이터 자동동작, 수동동작 인터락 설정]  
//=================================================================================

//EPC 버튼 인터락
//P_Status_BTN_Manual_Interlock_1(117) = 1;										// 1) EPC 수동동작 인터락


if( P_PMAC_Homing_CHK(N_EPC_SENSOR) == 1 && P_Motor_Current_Pos(N_EPC_SENSOR) == P_EPC_Axis_Target_Y )	// 2) EPC 모터가 원점을 잡았고, 보정 위치에 있을때				
{
	//P_Status_BTN_Manual_Interlock_1(116) = 1;									// 2.1) EPC 자동동작 인터락 [엑츄에이터 추종 사용 가능]
}
else																			// 3) EPC 모터가 원점을 잡지 않았거나, 보정 위치에 없을때	
{
	//P_Status_BTN_Manual_Interlock_1(116) = 0;									// 3.1) EPC 자동동작 인터락 [엑츄에이터 추종 사용 불가]
}

//=================================================================================
// [1] EPC 동작부   
//=================================================================================

// 오토모드이고, 적층시에만, 실시간 보정값 확인해서 이동		
if( P_PLC18_EPC_Moving_Flag == N_TRUE )											// 1) 비전 보정값을 받아서 EPC 이동 모듈이 실행된다면,
{
	P_PLC18_EPC_Moving_Flag = 0;												// 1.1) 플레그 초기화
	L_PLC18_EPC_Timer = 0;														// 1.2) 타이머 초기화
	P_PV_EPC_Index++;															// PV_EPC_Index 증가. (보정이 시작된 후 위치값을 저장하기 위함)		[ 참조 : 26.09.14 PV EPC Camera Pos 추가 ]
	if ( P_PV_EPC_Index >= 13 )													// PV_EPC_Index가 13을 넘어갈 경우.	[ 참조 : 26.11.12 PV EPC Camera Pos 수정 ]
		P_PV_EPC_Index = 12;													// PV_EPC_Index를 12로 고정. (배열 중 12가 제일 마지막)
	P_PLC18_EPC_Moving_Status = F_Status_STARTING;								// 1.3) 상태 : EPC Sensor 모터 보정시작
	P_PLC18_EPC_Move_State_Machine = 1;											// 1.4) EPC 모터 구동 스텟머신 시작
}	

// EPC 동작 스텟머신
switch(P_PLC18_EPC_Move_State_Machine)
{
	case 0 : 
		P_PLC18_EPC_Move_Status = F_Status_IDLE;								// 1) EPC 모터 구동 스텟머신 상태 [IDLE]			
	break;
	 
	case 1 :																	// 0. EPC 위치값 판정
		if ( P_PLC18_EPC_Retry_Mode_Time_Use_Flag == F_Command_Start )					// 1) EPC 판정 결과가 NG일 때 진입
		{
			P_PLC18_EPC_inspection_Time = P_EPC_Insp_Time;						// 1.1) EPC 보정시 적용 TIME // 엑츄에이터 ON,OFF식으로 구동한다면, 엑츄에이터가 따라오기 위한 여유시간
		}
		else																	// 2) EPC 판정 결과가 NG가 아닐 때,
		{
			P_PLC18_EPC_inspection_Time = P_EPC_Correction_Time;				// 2.1) 실시간 보정일 경우 적용 TIME
		}
		
		if(	L_PLC18_EPC_Timer > P_PLC18_EPC_inspection_Time )					// 3) 비전 보정값을 받은 이후, (실시간 보정 또는 EPC 보정) TIME 확인  		
		{		
			L_PLC18_EPC_Timer = 0;												// 3.1) 타이머 초기화
			
			if(	-P_TEST_Max_EPC_Sensor_Value_um < P_EPC_VISION_INPUT_Correction && P_EPC_VISION_INPUT_Correction < P_TEST_Max_EPC_Sensor_Value_um) // 4) -3mm < 보정값 < 3mm 일 시 
			{	
				L_PLC18_Vision_Recipe_EPC_um = P_EPC_VISION_INPUT_Correction * 1000;				// 4.1) 비전 보정값 * 단위환산				
				P_EPC_Axis_Target_Y = P_EPC_VISION_INPUT_Correction + P_Motor_Current_Pos(N_EPC_SENSOR);			// 4.2) 현재 위치 + 보정값 -> EPC 모터 보정이동 해야할 타겟위치								
				P_PLC18_EPC_Move_State_Machine = 2;													// 다음 스텟머신 이동	
			}
			else																					// 5) -3mm ~ 3mm 이내의 보정값이 아닐 시 EPC 모터 보정값 만큼 이동 x -> 작업자 개입 셋팅 필요.
			{	
				P_PV_EPC_Camera_Pos(P_PV_EPC_Index) = P_Motor_Current_Pos(33);						// [mm] 미진행 시 Camera 위치 저장.	[ 참조 : 26.09.14 PV EPC Camera Pos 추가 ]
				P_PLC18_EPC_Move_State_Machine = 0; 												// 5.1) 스텟머신 초기화
				//P_PMAC_Commands = F_Command_Stop;			
				// EPC 보정값 초과 알람 발생															
			}
		}
	break;

	case 2 :																						// 2. EPC모터 위치 확인
		if(	P_Motor_Current_Pos(N_EPC_SENSOR) != P_EPC_Axis_Target_Y )								// 1) 현재위치가 보정 위치가 아닐때만 EPC 모터 구동
		{
			P_PLC18_EPC_Move_Status = F_Status_STARTING;											// 1.1) EPC 보정 스텟머신 상태 [STARTING]
			motor[N_EPC_SENSOR].JogSpeed = 3;																	// 1.2) 속도 설정
			P_PLC18_EPC_Move_State_Machine = 3;														// 다음 스텟머신 이동
		}
		else																						// 2) 현재위치가 보정 위치라면,
		{

			P_PV_EPC_Camera_Pos(P_PV_EPC_Index) = P_Motor_Current_Pos(33);							// [mm] 미진행 시 Camera 위치 저장.	[ 참조 : 26.09.14 PV EPC Camera Pos 추가 ]
			P_PLC18_EPC_Move_State_Machine = 0;														// 2.1) 스텟머신 초기화																												
			P_PLC18_EPC_Moving_Status = F_Status_STOPPED;											// 2.2) EPC 보정 스텟머신 상태 [Stopped]
		}
	break;

	case 3 :																						// 3. EPC 모터 이동
		jog N_EPC_Motor_Num : ( L_PLC18_Vision_Recipe_EPC_um * (P_X_PLC_to_PMAC_Correction_Value / 100 ));	// 1) EPC보터 보정위치로 이동 - 터치패널 입력 보정값 적용
		L_PLC18_EPC_Move_Flag_Reset_Timer = 0;														// 2) 보정위치 이동 확인용 타이머 초기화
		P_PLC18_EPC_Move_State_Machine++;															// 다음 스텟머신 이동				
	break;
	
	case 4 :																						// 로그값 기록, 스텝 초기화
		if(	L_PLC18_EPC_Move_Flag_Reset_Timer > P_PLC18_EPC_Moving_Timer ) 							// 1) EPC Sensor 구동 Standard 시간 이후 초기화 기준: 보상 시간 2초
		{																															   
			if( Motor[N_EPC_SENSOR].DesvelZero == 1 && P_PLC18_EPC_Moving_Status == F_Status_STARTING )		// 1.1) 모터가 정지되었고, EPC 실행 Flag가 살아있다면,
			{	
				P_PV_EPC_Camera_Pos(P_PV_EPC_Index) = P_Motor_Current_Pos(33);						// [mm] 보정 진행 후 Camera 위치 저장. [ 참조 : 26.09.14 PV EPC Camera Pos 추가 ]
				P_PLC18_EPC_Moving_Flag = 0;														// 1.1.1) 보정값 요청 플래그 초기화 
				P_PLC18_EPC_Moving_Status = F_Status_STOPPED;										// 1.1.2) EPC 상태 변경 [STOPPED]				
				P_PLC18_EPC_Move_State_Machine = 0;													// 1.1.3) 스텝 초기화
				//P_EPC_VISION_INPUT_Correction = 0;													// 1.1.4) 비전 보정값 초기화
																									   
				P_EPC_MNTR_VAR(9) = P_EPC_MNTR_VAR(8);												// 1.1.5)  EPC 로그 데이터 10
				P_EPC_MNTR_VAR(8) = P_EPC_MNTR_VAR(7);												// 1.1.6)  EPC 로그 데이터 9
				P_EPC_MNTR_VAR(7) = P_EPC_MNTR_VAR(6);												// 1.1.7)  EPC 로그 데이터 8
				P_EPC_MNTR_VAR(6) = P_EPC_MNTR_VAR(5);												// 1.1.8)  EPC 로그 데이터 7
				P_EPC_MNTR_VAR(5) = P_EPC_MNTR_VAR(4);												// 1.1.9)  EPC 로그 데이터 6
				P_EPC_MNTR_VAR(4) = P_EPC_MNTR_VAR(3);												// 1.1.10) EPC 로그 데이터 5
				P_EPC_MNTR_VAR(3) = P_EPC_MNTR_VAR(2);												// 1.1.11) EPC 로그 데이터 4
				P_EPC_MNTR_VAR(2) = P_EPC_MNTR_VAR(1);												// 1.1.12) EPC 로그 데이터 3
				P_EPC_MNTR_VAR(1) = P_EPC_MNTR_VAR(0);												// 1.1.13) EPC 로그 데이터 2
				P_EPC_MNTR_VAR(0) = L_PLC18_Vision_Recipe_EPC_um;									// 1.1.14) EPC 로그 데이터 1
																																	   
				L_PLC18_Vision_Recipe_EPC_um = 0;													// 1.1.15) 보정값 초기화
			} 
		}
	break;
	
	default :
		P_PLC18_EPC_Move_State_Machine = 0;				
	break;		
}

//=================================================================================
// ARC 진행 및 테이프 버리는 세파 적층 후 ARC EPC 값 신호 ON.	[ 참조 : 26.05.08 ARC 후 ARC EPC값 적용 인터페이스 추가 ]
//=================================================================================
if ( P_ARC_EPC_Vision_Value_Apply_Flag == 1 )
{
	P_ARC_EPC_Vision_Value_Apply_Flag = 0;
	P_ARC_EPC_Vision_Value_Apply_State_Machine = 1;
}
switch(P_ARC_EPC_Vision_Value_Apply_State_Machine)
{
	case 1:		// 신호 ON 및 타이머 초기화.
		M_Y_PLC_ARC_EPC_Value_Apply_Signal = 1;			// 신호 ON.
		P_ARC_EPC_Vision_Value_Apply_Timer = 0;			// 타이머 초기화.
		P_ARC_EPC_Vision_Value_Apply_State_Machine = 2;	// 다음 스텟머신으로 이동.
	break;

	case 2:		// 타이머 오버 후 초기화 및 종료.
		if ( P_ARC_EPC_Vision_Value_Apply_Timer >= P_ARC_EPC_Vision_Value_Apply_Time ) // 시간이 넘어갈 경우. [ms]
		{
			M_Y_PLC_ARC_EPC_Value_Apply_Signal = 0;			// 신호 초기화.
			P_ARC_EPC_Vision_Value_Apply_State_Machine = N_Function_Complete;	// 종료.
		}
	break;
}

P_MNTR_PLC18_Task_Time(1) = (Sys.Time - P_MNTR_PLC18_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC18_Task_Time(1) > P_MNTR_PLC18_Task_Max_Time )
{
	P_MNTR_PLC18_Task_Max_Time = P_MNTR_PLC18_Task_Time(1);
}
close