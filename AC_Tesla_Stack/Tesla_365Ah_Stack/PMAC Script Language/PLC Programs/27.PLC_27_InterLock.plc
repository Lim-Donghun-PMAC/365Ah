					if(!(P_Motor_Current_Pos(N_NG_PnP_AN_T) ~ P_Recipe_M43_POS(1)) || P_Motor_Current_Pos(N_NG_PnP_AN_Z) ~ P_Recipe_M45_POS(2))		
						P_No2_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;
