					else if( P_Motor_Current_Pos(N_1st_PnP_AN_T) >= P_Recipe_M02_POS(3) - 0.5 && P_Motor_Current_Pos(N_1st_PnP_AN_T) <= P_Recipe_M02_POS(3) + 0.5 )   // 1차 얼라인쪽
					{ // 1차 PNP 얼라인 위치.
						if( P_Motor_Current_Pos(N_1st_PnP_AN_Z) >= P_Anode_1st_Z_Align_Down - 0.01 )	// 얼라인 하강위치보다 하강일 경우.
						{
						   if( P_IL_Motor_Page == N_1st_PnP_AN_T || P_IL_Motor_Page == N_1st_Picker_AN_T )	// 1차 T, 피커 T  
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
						   else if( P_IL_Motor_Page == N_1st_PnP_AN_Z )							// 1차 Z 
						      P_IL_Robot_Bit = Hex_IL_Plus;										// 플러스 인터락

						   P_IL_Outer_Status = N_IL_Align_Down_Pos;								// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
						   P_IL_Popup_Motor = N_1st_PnP_AN_Z;									// 인터락 팝업 모터 추가
						}	
						else if( P_Motor_Current_Pos(N_1st_PnP_AN_Z) >= P_Anode_1st_Z_Ready_Up + 0.5 )	// 대기 위치 상승보다 하강일 경우.
						{
							if( P_IL_Motor_Page == N_1st_PnP_AN_T )								// 1차 T
						      P_IL_Robot_Bit = Hex_IL_Plus | Hex_IL_Minus;						// 플러스, 마이너스 인터락
							 
							  P_IL_Outer_Status = N_IL_Align_Down_Pos;							// 얼라인 하강 위치 (T축은 움직이지 못하더라도 Z축은 레시피 이동을 하기 위함)
							  P_IL_Popup_Motor = N_1st_PnP_AN_Z;								// 인터락 팝업 모터 추가
						}
						else
						{
							 P_IL_Outer_Status = N_IL_Align_Pos;								// 얼라인 포스
						}
