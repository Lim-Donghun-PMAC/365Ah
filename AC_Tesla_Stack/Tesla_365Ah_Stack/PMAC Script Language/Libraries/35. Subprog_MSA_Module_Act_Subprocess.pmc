//=========================================================
//8.Stack MSA 2차 스텍 촬상
//=========================================================
sub: MSA_Stack_Vision_Trg_ON(Mode,&rtn)																					//Stack MSA 2차 스텍 촬상 Ready Steps
rtn = 0;
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) == N_Ready_Step )
{
	if( Mode == N_MSA_Anode_Stack )					// 음극 Stack MSA 모드일 경우
	{
		//M_Y_Vision_Stack_Trigger = 1;																					// 음극 스텍 비전 촬상 트리거 ON
		P_Vision_Stack_Trigger_Timer = 0;																				// 촬상 타이머 초기화	
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else if( Mode == N_MSA_Cathode_Stack )			// 양극 Stack MSA 모드일 경우
	{
		//M_Y_Vision_Stack_Trigger = 1;																					// 양극 스텍 비전 촬상 트리거 ON
		P_Vision_Stack_Trigger_Timer = 0;																				// 촬상 타이머 초기화																						
		P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) = 1;												// 다음 스텟 머신으로 이동.
	}
	else
	{
		// ERROR 
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) == 1 )
{
	if( Mode == N_MSA_Anode_Stack )						// 음극 Stack MSA 모드일 경우
	{
		if( P_Vision_Stack_Trigger_Timer > P_Vision_Align_Trigger_Time )												// 1000ms 이후
		{
			//M_Y_Vision_Stack_Trigger = 0; 																				// 음극 스텍 비전 촬상 트리거 Off	
			P_Vision_Stack_Trigger_Timer = 0;																			// 타이머 초기화 
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
		}	
	}
	else if( Mode == N_MSA_Cathode_Stack )				// 양극 Stack MSA 모드일 경우
	{																													
		if( P_Vision_Stack_Trigger_Timer > P_Vision_Align_Trigger_Time )												// 1000ms 이후
		{
			//M_Y_Vision_Stack_Trigger = 0; 																				// 양극 스텍 비전 촬상 트리거 O
			P_Vision_Stack_Trigger_Timer = 0;																			// 타이머 초기화 
			P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) = N_Complete_Step;								// 다음 스텟 머신으로 이동.
		}																													
	}
}
if( P_Module_MSA_Act_State_Machine_Array(N_MSA_Stack_Vision_Trg_ON) == N_Complete_Step )
{
	P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Vision_Trg_ON) = 1;												// 동작 완료 Bit On.
	rtn = N_COMPLETE;																									// 반환값 : COMPLETE
}
return;

