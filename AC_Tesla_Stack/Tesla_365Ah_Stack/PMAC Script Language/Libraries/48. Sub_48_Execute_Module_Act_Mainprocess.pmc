// 9) [세파첫장 모듈 - EPC 보정 판단 ]
//=========================================================// 
	if( P_Module_Act_Execute_Command_Array(N_Act_EPC_Judge) == F_ACT_STATUS_ENABLE )
	{
		if( P_OLD_Module_Act_Execute_Command_Array(N_Act_EPC_Judge) != F_ACT_STATUS_ENABLE )						// 이전 Command가 Enable이 아닐 경우.												
		{
