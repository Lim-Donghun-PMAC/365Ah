//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.06.18  [ 2025.06.18 외경프로그램 추가 ]	
// ARC 필요 외경 판단 및 Spool 외경 프로그램   
// 25.10.13 임동훈 선임 [ 참조 : 25.10.13 UI 선택에 따른 언와인더 Number 설정 ]
// UI 상부, 하부 언와인더 선택에 따른 Number 수정 추가.

open plc 6

#define	L_System_Timer				Sys.Time				// 시스템 타이머

Local	L_Time_Cycle_Up_Count_Start_Time;					// Plc[6].ldata.L[0]  시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;						// Plc[6].ldata.L[1]  시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;					// Plc[6].ldata.L[2]  시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;					// Plc[6].ldata.L[3]  타이머 초기화 플래그

// 외경 Local 변수
local	L_PLC06_Upper_Sepa_AI_Timer;						// Plc[6].ldata.L[4]  상단 Sepa 순환평균 타이머
local	L_PLC06_Upper_Sepa_AI_Data;							// Plc[6].ldata.L[5]  상단 순환평균 데이터
local	L_PLC06_Upper_Sepa_AI_Cnt;							// Plc[6].ldata.L[6]  상단 순환평균 카운트
local	L_PLC06_Upper_AVRG_Sensor_Data;						// Plc[6].ldata.L[7] 상단 AI 평균 데이터
local	L_PLC06_Lower_Sepa_AI_Timer;						// Plc[6].ldata.L[8]  하단 Sepa 순환평균 타이머
local	L_PLC06_Lower_Sepa_AI_Data;							// Plc[6].ldata.L[9]  하단 순환평균 데이터
local	L_PLC06_Lower_Sepa_AI_Cnt;							// Plc[6].ldata.L[10]  하단 순환평균 카운트
local	L_PLC06_Lower_AVRG_Sensor_Data;						// Plc[6].ldata.L[11] 하단 AI 평균 데이터
// 세파 두께 Local 변수 
local	L_PLC06_Sepa_Upper_Thickness_Timer;					// Plc[6].ldata.L[12]  상단 Sepa 두께 순환평균 타이머
local	L_PLC06_Sepa_Upper_Thickness_Data;					// Plc[6].ldata.L[13]  상단 두께 순환평균 데이터
local	L_PLC06_Sepa_Upper_Thickness_Cnt;					// Plc[6].ldata.L[14]  상단 두께 순환평균 카운트
local	L_PLC06_Sepa_Lower_Thickness_Timer;					// Plc[6].ldata.L[15]  하단 Sepa 두께 순환평균 타이머
local	L_PLC06_Sepa_Lower_Thickness_Data;					// Plc[6].ldata.L[16]  하단 두께 순환평균 데이터
local	L_PLC06_Sepa_Lower_Thickness_Cnt;					// Plc[6].ldata.L[17]  하단 두께 순환평균 카운트

local	L_Selected_Spool_Number;							// Plc[6].ldata.L[18] 스풀 업데이트 변수
local	L_Sepa_Thickness_Reentry;							// Plc[6].ldata.L[19]	재진입 방지 변수

local	L_Clamp_2nd_Vector_Y;								// Plc[6].ldata.L[20] 이전값 변수
local	L_Clamp_2nd_Vector_Z;								// Plc[6].ldata.L[21] 이전값 변수
local	L_Set_Interval_Time = 5;							// Plc[6].ldata.L[22] 갱신 시간 5ms
local	L_Sepa_Thickness_Chk_Timer;							// Plc[6].ldata.L[23] 세파 두께 체크 타이머
//test 변수
local	L_Anode_Count;
local	L_Cathode_Count;
//========================================================================================================================
// 01. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 01.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}

// 01.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}

// 01.3) 시간 업데이트
if (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{		
	
	L_PLC06_Upper_Sepa_AI_Timer = L_PLC06_Upper_Sepa_AI_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC06_Lower_Sepa_AI_Timer = L_PLC06_Lower_Sepa_AI_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC06_Sepa_Upper_Thickness_Timer = L_PLC06_Sepa_Upper_Thickness_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_PLC06_Sepa_Lower_Thickness_Timer = L_PLC06_Sepa_Lower_Thickness_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Sepa_Thickness_Chk_Timer = L_Sepa_Thickness_Chk_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}



/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// UI 선택에 따른 언와인더 Number 설정	[ 참조 : 25.10.13 UI 선택에 따른 언와인더 Number 설정 ]
if ( P_Suspend_ARC_Module_Status != F_Status_EXECUTE )		// ARC 모듈 진행 상태가 아닐 경우.	[ 참조 : 25.10.17 언와인더 Number 설정 조건 추가 ]
{
	// [PLC → PMAC] Unwinder IO에 따른 Unwinder Number 업데이트.
	if ( M_X_Sepa_Upper_Unwinder_Status == 1 && M_X_Sepa_Lower_Unwinder_Status == 0 )					// 상부 선택일 경우.
	{
		P_Selected_Spool_Number = N_UNWINDER_UPPER;			// 상부 설정.
	}
	else if ( M_X_Sepa_Upper_Unwinder_Status == 0 && M_X_Sepa_Lower_Unwinder_Status == 1 )				// 하부 선택일 경우.
	{
		P_Selected_Spool_Number = N_UNWINDER_LOWER;			// 하부 설정.
	}
	else {}
	// [PMAC → PLC] Unwinder Number에 따른 Unwinder IO 업데이트.
	if ( P_Selected_Spool_Number == N_UNWINDER_UPPER )		// 상부 선택일 경우.
	{
		M_Y_Sepa_Upper_Unwinder_Status = 1;					// 상부 언와인더 상태 IO ON.
		M_Y_Sepa_Lower_Unwinder_Status = 0;					// 상부 언와인더 상태 IO ON.
	}
	else if ( P_Selected_Spool_Number == N_UNWINDER_LOWER )	// 하부 선택일 경우.
	{
		M_Y_Sepa_Upper_Unwinder_Status = 0;					// 하부 언와인더 상태 IO ON.
		M_Y_Sepa_Lower_Unwinder_Status = 1;					// 하부 언와인더 상태 IO ON.
	}
}
//==================================================================================================================================

// test =============================================================================================================================================
// [ 2025.07.11 ARC TEST 추가 ]
#ifdef F_Virtual_Axis_Test
	if( P_PLC06_Reel_Upper_Change_Flag == 1 )
	{
		P_PLC06_Reel_Upper_Change_Flag = 0;
		M_AI_Upper_Sepa_Sensing = N_Reel_MAX;
	}
	else if( P_PLC06_Reel_Lower_Change_Flag == 1 )
	{
		P_PLC06_Reel_Lower_Change_Flag = 0;
		M_AI_Lower_Sepa_Sensing = N_Reel_MAX;
	}
	if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
	{
		if( P_Anode_Count != L_Anode_Count )
		{
			M_AI_Upper_Sepa_Sensing -= P_Sepa_AI;
		}
		if( P_Cathode_Count != L_Cathode_Count )
		{
			M_AI_Upper_Sepa_Sensing -= P_Sepa_AI;
		}
	}
	else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
	{
		if( P_Anode_Count != L_Anode_Count )
		{
			M_AI_Lower_Sepa_Sensing -= P_Sepa_AI;
		}
		if( P_Cathode_Count != L_Cathode_Count )
		{
			M_AI_Lower_Sepa_Sensing -= P_Sepa_AI;
		}
	}
	L_Anode_Count = P_Anode_Count;
	L_Cathode_Count = P_Cathode_Count;
#endif
// 외경감지 센서 Get 부분============================================================================================================================
// 5ms 마다 외경감지 센서 업데이트
//1. 상단 언와인더 ========================================================================
if( L_PLC06_Upper_Sepa_AI_Timer >= L_Set_Interval_Time )			// 5ms 마다 업데이트
{
	L_PLC06_Upper_AVRG_Sensor_Data = L_PLC06_Upper_Sepa_AI_Data / L_PLC06_Upper_Sepa_AI_Cnt;
	P_PLC06_Curr_Upper_Distance_mm = ((P_Sepa_To_Sensor_Max_Distance_mm - P_Sepa_To_Sensor_Min_Distance_mm) / (P_Sensor_Max_Analog_Data - P_Sensor_Min_Analog_Data) ) * L_PLC06_Upper_AVRG_Sensor_Data + P_Sepa_Cal_Inclination;//170.0606;
	L_PLC06_Upper_Sepa_AI_Timer = 0;			// 초기화
	L_PLC06_Upper_Sepa_AI_Data = 0;				// 초기화
	L_PLC06_Upper_Sepa_AI_Cnt = 0;				// 초기화
}
else	// 아날로그 데이터 순환평균 시작
{
	L_PLC06_Upper_Sepa_AI_Data =  L_PLC06_Upper_Sepa_AI_Data + M_AI_Upper_Sepa_Sensing;
	L_PLC06_Upper_Sepa_AI_Cnt++;
}

//2. 하단 언와인더 ========================================================================
if( L_PLC06_Lower_Sepa_AI_Timer >= L_Set_Interval_Time )			// 5ms 마다 업데이트
{
	L_PLC06_Lower_AVRG_Sensor_Data = L_PLC06_Lower_Sepa_AI_Data / L_PLC06_Lower_Sepa_AI_Cnt;
	P_PLC06_Curr_Lower_Distance_mm = ((P_Sepa_To_Sensor_Max_Distance_mm - P_Sepa_To_Sensor_Min_Distance_mm) / (P_Sensor_Max_Analog_Data - P_Sensor_Min_Analog_Data) ) * L_PLC06_Lower_AVRG_Sensor_Data + P_Sepa_Cal_Inclination;//170.0606;
	L_PLC06_Lower_Sepa_AI_Timer = 0;			// 초기화
	L_PLC06_Lower_Sepa_AI_Data = 0;				// 초기화
	L_PLC06_Lower_Sepa_AI_Cnt = 0;				// 초기화
}
else	// 아날로그 데이터 순환평균 시작
{
	L_PLC06_Lower_Sepa_AI_Data =  L_PLC06_Lower_Sepa_AI_Data + M_AI_Lower_Sepa_Sensing;
	L_PLC06_Lower_Sepa_AI_Cnt++;
}

// ==================================================================================================================================================

// 세파 외경값 구하는 수식란===========================================================================================================================
if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
	P_PLC06_Curr_Spool_Radius = P_Sensor_To_Unwinder_Core_Disatance_mm - P_PLC06_Curr_Upper_Distance_mm;	// 반지름 구하기 P_Sensor_To_Unwinder_Core_Disatance_mm = 270
else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
	P_PLC06_Curr_Spool_Radius = P_Sensor_To_Unwinder_Core_Disatance_mm - P_PLC06_Curr_Lower_Distance_mm;	// 반지름 구하기 P_Sensor_To_Unwinder_Core_Disatance_mm = 270

P_PLC06_Spool_Circumference = 2 * P_PI * P_PLC06_Curr_Spool_Radius;											// 세파 외경 구하기

// ===================================================================================================================================================

// 세파 두께 체크 =====================================================================================================================================
if( L_Sepa_Thickness_Chk_Timer >= L_Set_Interval_Time )			// 5ms 마다 업데이트
{
	P_PLC06_Sepa_Min_Distance_mm = ((P_Sepa_To_Sensor_Max_Distance_mm - P_Sepa_To_Sensor_Min_Distance_mm) / (P_Sensor_Max_Analog_Data - P_Sensor_Min_Analog_Data) ) * P_Sensor_Min_Analog_Data + P_Sepa_Cal_Inclination;//170.0606;
	P_PLC06_Upper_Curr_Unwinder_Thickness_mm = P_PLC06_Sepa_Min_Distance_mm - P_PLC06_Curr_Upper_Distance_mm;
	P_PLC06_Lower_Curr_Unwinder_Thickness_mm = P_PLC06_Sepa_Min_Distance_mm - P_PLC06_Curr_Lower_Distance_mm;
	L_Sepa_Thickness_Chk_Timer = 0;				// 타이머 초기화
}
// ===================================================================================================================================================

// 세파 두께 계산 ========================================================================================================================================
// 10ms 마다 세파 두께 평균 데이터

if( L_PLC06_Sepa_Upper_Thickness_Timer >= L_Set_Interval_Time )		// 5ms 마다 업데이트
{
	P_AVRG_Upper_Sepa_Thickness_mm = L_PLC06_Sepa_Upper_Thickness_Data / L_PLC06_Sepa_Upper_Thickness_Cnt;
	L_PLC06_Sepa_Upper_Thickness_Data = 0;			// 초기화
	L_PLC06_Sepa_Upper_Thickness_Cnt = 0;			// 초기화
	L_PLC06_Sepa_Upper_Thickness_Timer = 0;			// 초기화
}
else	// 아날로그 데이터 순환평균 시작
{
	L_PLC06_Sepa_Upper_Thickness_Data =  L_PLC06_Sepa_Upper_Thickness_Data + P_PLC06_Upper_Curr_Unwinder_Thickness_mm;
	L_PLC06_Sepa_Upper_Thickness_Cnt++;
}

if( L_PLC06_Sepa_Lower_Thickness_Timer >= L_Set_Interval_Time )		// 5ms 마다 업데이트
{
	P_AVRG_Lower_Sepa_Thickness_mm = L_PLC06_Sepa_Lower_Thickness_Data / L_PLC06_Sepa_Lower_Thickness_Cnt;
	L_PLC06_Sepa_Lower_Thickness_Data = 0;			// 초기화
	L_PLC06_Sepa_Lower_Thickness_Cnt = 0;			// 초기화
	L_PLC06_Sepa_Lower_Thickness_Timer = 0;			// 초기화
}
else	// 아날로그 데이터 순환평균 시작
{
	L_PLC06_Sepa_Lower_Thickness_Data =  L_PLC06_Sepa_Lower_Thickness_Data + P_PLC06_Lower_Curr_Unwinder_Thickness_mm;
	L_PLC06_Sepa_Lower_Thickness_Cnt++;
}

// [ 참조 : 25.07.02 ARC 요구 플래그 조건 수정 ]


// Auto Reel Change 필요 여부 판단. ========================================================================================================================================================
if( P_PMAC_Status == F_Status_SUSPENDED || P_PMAC_Status == F_Status_IDLE )																// 서스펜드 or 아이들 일때 확인			// [ 2025.06.20 조건 수정 ]
{
	if( P_Selected_Spool_Number == N_UNWINDER_UPPER )																				// 상단 언와인더라면
	{
		if( P_AVRG_Upper_Sepa_Thickness_mm <= P_PLC06_Sepa_Change_Set && L_Sepa_Thickness_Reentry == 0 )								// 세파 두께가 교체 두께보다 적거나 같다면
		{
			L_Sepa_Thickness_Reentry = 1;																								// 재진입 방지
			#ifdef F_Debug_Mode			// 테스트 모드일때
			if( P_AVRG_Lower_Sepa_Thickness_mm <= P_PLC06_Sepa_Change_Set )																// 하단 세파 두께가 교체 두께보다 적거나 같다면
			{
				// 알람 발생
				M_Spool_OtherSide_lack_Alarm = 1;
				P_PMAC_Commands = F_Command_Stop;
			}
			else
				P_Suspend_ARC_Request_Flag = 1;																							// ARC 요구 플래그 on
			#else						// 실제 장비 
			if( P_AVRG_Lower_Sepa_Thickness_mm <= P_PLC06_Sepa_Change_Set )																// 하단 세파 두께가 교체 두께보다 적거나 같다면
			{
				// 알람 발생
				M_Spool_OtherSide_lack_Alarm = 1;
				P_PMAC_Commands = F_Command_Stop;
			}
			else
			{	// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
				if( P_ARC_Ready_Flag(N_Lower) == N_TRUE && M_Y_Lower_Unwinder_Lock_Sol == N_TRUE )										// 하단 ARC Ready Flag On 확인 후 
				{
					P_Suspend_ARC_Request_Flag = 1;																						// ARC 요구 플래그 on
				}
				//else
				//	레디안됨 알람 = 1;
				//	P_PMAC_Commands = F_Command_Stop;
			}
			#endif
		}
		else if( P_AVRG_Upper_Sepa_Thickness_mm > P_PLC06_Sepa_Change_Set )
			P_Suspend_ARC_Request_Flag = 0;
	}
	else if(  P_Selected_Spool_Number == N_UNWINDER_LOWER )																			// 하단 언와인더라면
	{
		if( P_AVRG_Lower_Sepa_Thickness_mm <= P_PLC06_Sepa_Change_Set && L_Sepa_Thickness_Reentry == 0 )								// 하단 세파 두께가 교체 두께보다 적거나 같다면
		{
			L_Sepa_Thickness_Reentry = 1;																								// 재진입 방지
			#ifdef F_Debug_Mode			// 테스트 모드일때
			if( P_AVRG_Upper_Sepa_Thickness_mm <= P_PLC06_Sepa_Change_Set )																// 상단 세파 두께가 교체 두께보다 적거나 같다면
			{
				// 알람 발생
				M_Spool_OtherSide_lack_Alarm = 1;
				P_PMAC_Commands = F_Command_Stop;
			}
			else
				P_Suspend_ARC_Request_Flag = 1;																							// ARC 요구 플래그 on
			#else						// 실제 장비 
			if( P_AVRG_Upper_Sepa_Thickness_mm <= P_PLC06_Sepa_Change_Set )																// 상단 세파 두께가 교체 두께보다 적거나 같다면
			{
				// 알람 발생
				M_Spool_OtherSide_lack_Alarm = 1;
				P_PMAC_Commands = F_Command_Stop;
			}
			else
			{	// [ 참조 : 2025.09.26 PMAC 내부 세파 레디신호 처리 ]
				if( P_ARC_Ready_Flag(N_Upper) == N_TRUE && M_Y_Upper_Unwinder_Lock_Sol == N_TRUE )										// 플래그 on이라면
				{
					P_Suspend_ARC_Request_Flag = 1;																						// ARC 요구 플래그 on
				}
				//else
					//	레디안됨 알람 = 1;
					//	P_PMAC_Commands = F_Command_Stop;
			}
			#endif
		}
		else if( P_AVRG_Lower_Sepa_Thickness_mm > P_PLC06_Sepa_Change_Set )
			P_Suspend_ARC_Request_Flag = 0;
	}
}
// Auto Reel Change 필요 여부 판단. ==========================================================================================================================================================

if( P_Selected_Spool_Number != L_Selected_Spool_Number )																				// 스풀 번호가 변경되었다면
{
	L_Sepa_Thickness_Reentry = 0;																										// 세파두께 재진입 방지 변수 초기화
	L_Selected_Spool_Number = P_Selected_Spool_Number;																					// 스풀 번호 업데이트
}


// 클램프 Vector 모션 속도 수식 //	[ 참조 : 25.10.13 클램프 Vector 모션 속도 수식 추가 ]
// 속도[mm/s] = int(제곱근((도착 거리 - 출발 거리)^2 + (도착 거리 - 출발 거리)^2)[mm] / 시간[ms] * (1000 [ms → s])
// 최적화 시작 Recipe 데이터가 바뀌었을때 계산 [ 참조 : CPU 최적화 진행 ]
if( P_Clamp_2nd_Vector_Y != L_Clamp_2nd_Vector_Y || P_Clamp_2nd_Vector_Z != L_Clamp_2nd_Vector_Z || P_PLC06_Frist_Flag == 0 )
{
	P_PLC06_Frist_Flag = 1; 
	P_Clamp_2nd_Vector_Vel = int(sqrt(pow(P_Clamp_2nd_Vector_Y-P_Clamp_1st_Vector_Y,2) + pow(P_Clamp_2nd_Vector_Z-P_Clamp_1st_Vector_Z,2)) / P_Clamp_2nd_TM_Time * 1000)
	L_Clamp_2nd_Vector_Y = P_Clamp_2nd_Vector_Y;
	L_Clamp_2nd_Vector_Z = P_Clamp_2nd_Vector_Z;
}

// ↓ 최적화 시작 Cam 파라미터에 대입 [ 참조 : CPU 최적화 진행 ]
// 드라이빙 캠테이블 스케일 변경 수식. [ 참조 : 25.10.14 드라이빙 캠테이블 스케일 변경 수식 추가 ]
//if ( P_Driving_CamTable_Scale_Change_Flag == 1 )					// 드라이빙 캠테이블 스케일 변경 사용 유무. [ 0 : 미사용, 1 : 사용 ]
