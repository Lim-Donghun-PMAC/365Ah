			{
				if( P_First_Unloader_Grip_Cell_Status == F_Status_COMPLETE )										// 모션 완료 일 경우.
				{
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Grip_Cell_Pos) = N_Complete_Step;			// 완료 스텟 머신으로 이동.
				}
			}
			else																									// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Grip_Cell_Pos) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Grip_Cell_Pos);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Grip_Cell_Pos) = N_Error_Step;				// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Grip_Cell_Pos) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_Grip_Cell_Pos;									// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_Unloader_Grip_Cell_Pos_Error_Popup_Flag = 1;									// 1차 언로더 셀 부착 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_Grip_Cell_Pos_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Grip_Cell_Pos) == N_Complete_Step )				// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_Grip_Cell_Pos) = 1;												// 동작 완료 Bit On.
			First_Unloader_Grip_Cell_Pos_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}
	return
	
	// 1차 언로더 그립 후 후진을 위한 대기 위치 이동
sub:First_Unloader_BWD_Wait_Pos(&First_Unloader_BWD_Wait_RTN)
      // 0.0) 반환값 초기화.
      First_Unloader_BWD_Wait_RTN = 0;
      local L_Rtn = 0;
      // 222) 동작 실행
      if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) == N_Ready_Step )                     // 진행 준비 완료 일 경우.
      {
         // 언로더 데이터 이동 추가
        call Discharge_Sub_Prog.Stack_to_Unloader_ID(&L_Rtn)
        if( L_Rtn == N_TRUE )
		{
			M_Y_PLC_JR_Data_Produce_Signal = 1;																		// [ 참조 : 26.03.26 메모리 데이터 영역 인터페이스 추가 ] 	
           P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) = 1;									// 다음 스텟 머신으로 이동.
		}
	  }
      // 1) 동작 완료 감시   
      if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) == 1 )
      {
         P_Act_Old_Time(N_Act_First_Unloader_BWD_Wait_Pos) = Sys.Time;												// 타이머 설정.
         P_First_Unloader_Stack_BWD_Wait_Status = F_Status_Nonseatus;												// 상태 초기화.
         P_Slave14_Motion_Command = N_1st_UND_BWD_UP_Motion;														// 후진을 위한 대기 위치. Slave Motion Cmd 50ms + 700ms = 750ms
         P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) = 2;									// 다음 스텟 머신으로 이동.
      }
      if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) == 2 )
      {
         if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_BWD_Wait_Pos) + P_Act_Time_Out(N_Act_First_Unloader_BWD_Wait_Pos) )   // 일정 시간 전에 완료 될 경우.
         {
            if( P_First_Unloader_Stack_BWD_Wait_Status == F_Status_COMPLETE )										// 모션 완료 일 경우.
            {
                P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) = N_Complete_Step;				// 완료 스텟 머신으로 이동.
            }
         }
         //else																										// 일정 시간을 넘길 경우. [타임 아웃]
         //{
         //   P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) = N_Error_Step;					// 애러 스텟 머신으로 이동.
         //}
      }
      // 444) 애러
      if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) == N_Error_Step )					// 애러 상태 일 경우.
      {
		P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_BWD_Wait_Pos;										// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
		P_Suspend_Discharge_1st_Unloader_BWD_Wait_Pos_Error_Popup_Flag = 1;											// 1차 언로더 그립 후 후진을 위한 대기 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
         First_Unloader_BWD_Wait_RTN = N_FALSE;																		// 반환값 : FALSE.
      }
      
      // 999) 완료
      if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD_Wait_Pos) == N_Complete_Step )					// 완료 상태 일 경우.
      {         
         P_Act_Complete_Bit(N_Act_First_Unloader_BWD_Wait_Pos) = 1;													// 동작 완료 Bit On.
         First_Unloader_BWD_Wait_RTN = N_COMPLETE;																	// 반환값 : COMPLETE
      }
   return
	
	// 1차 언로더 그립 후 후진 위치 이동
	sub:First_Unloader_Stack_BWD(&First_Unloader_BWD_RTN)
		// 0.0) 반환값 초기화.
		First_Unloader_BWD_RTN = 0;
		// 222) 동작 실행
		IF ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) == N_Ready_Step )							// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_First_Unloader_BWD) = Sys.Time;													// 타이머 설정.
			P_First_Unloader_Stack_BWD_Status = F_Status_Nonseatus;													// 상태 초기화.
			P_Slave14_Motion_Command = N_1st_UND_BWD_Motion;														// 후진 위치 Slave Motion Cmd. 50ms + 700ms = 750ms
			P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) = 1;											// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		IF ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) == 1 )
		{
			IF ( P_Motor_Current_Pos(46) < P_1st_ULD_X_Stack )
			{
				P_Main_Z_Init_Pos_Status = F_Status_Nonseatus;														// 상태 초기화.
				P_Slave6_Motion_Command = N_Stack_Table_Ready_Pos_Moton;											// Main Z축 대기 위치 Slave Cmd 
				M_Y_ST_Center_Cyl_Up_Sol = 1;																		// 스텍 테이블 상승 IO ON
				M_Y_ST_Center_Cyl_Dn_Sol = 0;	
				
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) = 2;	
			}
		}
		
		IF ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) == 2 )
		{
			IF ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_BWD) + P_Act_Time_Out(N_Act_First_Unloader_BWD) )	// 일정 시간 전에 완료 될 경우.
			{				
				IF ( P_First_Unloader_Stack_BWD_Status == F_Status_COMPLETE )
				{
					// 260501 스텍테이블 실린더 하강센서 4개 다 보도록 수정
					IF( P_Main_Z_Init_Pos_Status == F_Status_COMPLETE && M_X_ST_Center_CYL_Dn_Sensor_1 == 0 && M_X_ST_Center_CYL_Up_Sensor_1 == 1 && M_X_ST_Center_CYL_Dn_Sensor_2 == 0 && M_X_ST_Center_CYL_Up_Sensor_2 == 1 )	// 완료 확인
					{
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) = N_Complete_Step;
					}
				}								
			}
			ELSE
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_BWD) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) = N_Error_Step;
			}
		}		
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) == N_Error_Step )							// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_BWD;											// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_Unloader_BWD_Error_Popup_Flag = 1;												// 1차 언로더 그립 후 후진 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_BWD_RTN = N_FALSE;																		// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_BWD) == N_Complete_Step )						// 완료 상태 일 경우.
		{						
			if ( P_PMAC_Status == F_Status_SUSPENDED )																// 배출 진행 중 SUSPENDED 상태 일 경우.
			{
				// 260402 1차 언로더 후진 완료 시 다음 상태로 넘길 때 양극 얼라인에 ng 존재하면 1차언로더와 2차 pnp 충돌 발생으로 ng 존재 시 다음 상태 넘기는 타이밍 45도 이후로 수정
				if( Sys_Cathode_Align_Sheet_LO_Vision_BYTE & Hex_NG_Masking == 0 )	
					P_Suspend_Discharge_To_Execute_Flag = 1;														// 배출 중 Execute 진행 가능 Flag ON.
				else
					P_Suspend_Discharge_To_Execute_Flag = 0
			}
			else																									// 배출 진행 중 SUSPENDED 상태가 아닐 경우.
			{
				P_Suspend_Discharge_To_Execute_Flag = 0;															// 배출 중 Execute 진행 가능 Flag OFF.
			}
			P_Act_Complete_Bit(N_Act_First_Unloader_BWD) = 1;														// 동작 완료 Bit On.
			First_Unloader_BWD_RTN = N_COMPLETE;																	// 반환값 : COMPLETE
		}
	return
	
	// 1차 언로더 하강 위치 이동
	sub:First_Unloader_Stack_Down(&First_Unloader_Stack_Down_RTN)
		// 0.0) 반환값 초기화.
		First_Unloader_Stack_Down_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_First_Unloader_Stack_Down) = Sys.Time;												// 타이머 설정.
			P_First_Unloader_Stack_Down_Status = F_Status_Nonseatus;												// 상태 초기화.
			P_Slave14_Motion_Command = N_1st_UND_BWD_Down_Motion;													// 하강 위치 Slave Motion Cmd. 50ms + 700ms = 750ms
			P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) = 1;									// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Stack_Down) + P_Act_Time_Out(N_Act_First_Unloader_Stack_Down) )	// 일정 시간 전에 완료 될 경우.
			{
				if( P_First_Unloader_Stack_Down_Status == F_Status_COMPLETE )										// 모션 완료 일 경우.
				{				
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) = N_Complete_Step;			// 완료 스텟 머신으로 이동.
				}
			}
			else																									// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Stack_Down) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) = N_Error_Step;					// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_Stack_Down;										// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_Unloader_Stack_Down_Error_Popup_Flag = 1;										// 1차 언로더 스택 하강 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_Stack_Down_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Stack_Down) == N_Complete_Step )					// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_Stack_Down) = 1;												// 동작 완료 Bit On.
			First_Unloader_Stack_Down_RTN = N_COMPLETE;																// 반환값 : COMPLETE
		}
	return
	
	// 1차 언로더 회전 - [45도 회전] (T축)
	sub:First_Unloader_Turn(&First_Unloader_Turn_RTN)
		// 0.0) 반환값 초기화.
		First_Unloader_Turn_RTN = 0;																				// 반환값 초기화.
		// 222) 2차 언로더 진입 완료 확인 + 2차 언로더 그립 요청
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) == N_Ready_Step )							// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_First_Unloader_Turn) = Sys.Time;													// 타이머 설정.
			P_First_Unloader_Avoid_Status = F_Status_Nonseatus;														// 상태 초기화.
			P_Slave14_Motion_Command = N_1st_UND_Avoid_Motion;														// 1차 언로더 회전 (45도).
			
			// 260402 1차 언로더 후진 완료 시 다음 상태로 넘길 때 양극 얼라인에 ng 존재하면 1차언로더와 2차 pnp 충돌 발생으로 ng 존재 시 다음 상태 넘기는 타이밍 45도 이후로 수정
			P_Suspend_Discharge_To_Execute_Flag = 1;
			P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) = 1;										// 다음 스텟 머신으로 이동.

		}
		// 1) 1차 언로더 45도 위치 (T축)
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Turn) + P_Act_Time_Out(N_Act_First_Unloader_Turn) )			// 일정 시간 전에 완료 될 경우.
			{
				if ( P_First_Unloader_Avoid_Status == F_Status_COMPLETE )										// 모션 완료 일 경우.
				{
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) = N_Complete_Step;				// 완료 스텟 머신으로 이동.
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Turn) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) = N_Error_Step;						// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) == N_Error_Step )						// 애러 상태 일 경우.
		{	
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_Turn;										// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_Unloader_Avoid_Pos_Error_Popup_Flag = 1;									// 1차 언로더 회피 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_Turn_RTN = N_FALSE;																	// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Turn) == N_Complete_Step )					// 완료 상태 일 경
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_Turn) = 1;													// 동작 완료 Bit On.
			First_Unloader_Turn_RTN = N_COMPLETE;																// 반환값 : COMPLETE
		}	
	return

	// 1차 언로더 인계위치 이동 [90도 회전] (T축)
	sub:First_Unloader_Handover_Pos(&First_Unloader_Handover_Pos_RTN)
		// 0.0) 반환값 초기화.
		First_Unloader_Handover_Pos_RTN = 0;																	// 반환값 초기화.
		// 222) 1차 언로더 90도 이동.
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) == N_Ready_Step )				// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_First_Unloader_Handover_Pos) = Sys.Time;										// 타이머 설정.
			P_First_Unloader_Handover_Status = F_Status_Nonseatus;												// 상태 초기화.
			P_Slave14_Motion_Command = N_1st_UND_Handover_Motion;												// 1차 언로더 회전 (90도).
			P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) = 1;							// 다음 스텟 머신으로 이동.
		}
		// 1) 1차 언로더 인계위치 이동(T축)
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Handover_Pos) + P_Act_Time_Out(N_Act_First_Unloader_Handover_Pos) )	// 일정 시간 전에 완료 될 경우.
			{
				if ( P_First_Unloader_Handover_Status == F_Status_COMPLETE )									// 모션 완료 일 경우.
				{
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) = N_Complete_Step;		// 완료 스텟 머신으로 이동.
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Handover_Pos) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) = N_Error_Step;				// 애러 스텟 머신으로 이동.
			}
		}

		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) == N_Error_Step )				// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_Handover_Pos;								// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_Unloader_Handover_Pos_Error_Popup_Flag = 1;									// 1차 언로더 인계 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_Handover_Pos_RTN = N_FALSE;															// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Handover_Pos) == N_Complete_Step )			// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_Handover_Pos) = 1;											// 동작 완료 Bit On.
			First_Unloader_Handover_Pos_RTN = N_COMPLETE;														// 반환값 : COMPLETE
		}
	return

	// 양극 클램프 OFF
	sub:Cathode_Clamp_OFF(&Cathode_Clamp_OFF_RTN)
		// 0.0) 반환값 초기화.
		Cathode_Clamp_OFF_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) == N_Ready_Step )						// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Cathode_Clamp_OFF) = Sys.Time;													// 타이머 설정.
			P_Cathode_Clamp_OFF_Status = F_Status_Nonseatus;													// 상태 초기화.
			P_Slave7_Motion_Command = N_Clamp_Off_Motion;														// 클램프 off Slave Cmd	

			// [ 참조 : 26.06.10 스택테이블 진공 on/off 추가 ]
			M_Y_ST_Center_Sol = 1
			M_Y_ST_Center_Ejector_VAC_On = 0
			M_Y_ST_Center_Ejector_VAC_Off = 1

			P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) = 1;										// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_Cathode_Clamp_OFF) + P_Act_Time_Out(N_Act_Cathode_Clamp_OFF) )		// 일정 시간 전에 완료 될 경우.
			{
				if( P_Cathode_Clamp_OFF_Status == F_Status_COMPLETE )												// 모션 완료 일 경우.
				{
					// [ 참조 : 26.06.10 스택테이블 진공 on/off 추가 ]
					M_Y_ST_Center_Sol = 0
					M_Y_ST_Center_Ejector_VAC_On = 0
					M_Y_ST_Center_Ejector_VAC_Off = 0

					// Trans IN Signal [ 참조 : Trans IN, OUT 시점 추가 ]
					M_Y_PLC_Trans_IN_Signal = 1;																// PLC에게 트랜스 IN 신호 넘겨줌
					P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) = N_Complete_Step;				// 완료 스텟 머신으로 이동.
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Cathode_Clamp_OFF) = P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) = N_Error_Step;						// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) == N_Error_Step )						// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_Cathode_Clamp_OFF;											// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Cathode_Clamp_OFF_Error_Popup_Flag = 1;											// 양극 클램프 OFF 오류 팝업 플래그				
			Cathode_Clamp_OFF_RTN = N_FALSE;																	// 반환값 : FALSE.
		}
		
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_Cathode_Clamp_OFF) == N_Complete_Step )						// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_Cathode_Clamp_OFF) = 1;													// 동작 완료 Bit On.
			Cathode_Clamp_OFF_RTN = N_COMPLETE;																	// 반환값 : COMPLETE
		}
	return

	// 파이널 롤러 세파 커팅 히팅
	sub:Sepa_Cutter_Heating(&Sepa_Cutter_Heating_RTN)
		// 0.0) 반환값 초기화.
		Sepa_Cutter_Heating_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) == N_Ready_Step )						// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Sepa_Cutter_Heating) = Sys.Time;												// 타이머 설정.
			//M_Y_Final_Roll_Heating = 1;																		// 커터 열선 ON.
			// ↓ [ 참고 : 2025.10.15 미비 사항 추가 건 ]
			M_Y_Sepa_Cutter_SSR_On = 1;																			// 커터 열선 ON.
			M_Y_First_Sheet_Paper_Plate_Ejector_Vac_On = 1;														// Sheet Paper 진공 ON.
			M_Y_First_Sheet_Paper_Plate_Ejector_Vac_Off = 0;													// Sheet Paper 진공 ON.
			P_Suspend_Cutter_Heating_Timer = 0;
			P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) = 1;									// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_Sepa_Cutter_Heating) + P_Act_Time_Out(N_Act_Sepa_Cutter_Heating) )			// 일정 시간 전에 완료 될 경우.
			{
				P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Sepa_Cutter_Heating) = P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) = N_Error_Step;						// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) == N_Error_Step )						// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_Sepa_Cutter_Heating;										// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Sepa_Cutter_Heating_Error_Popup_Flag = 1;										// 세파 커터 열선 ON 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Sepa_Cutter_Heating_RTN = N_FALSE;																	// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Heating) == N_Complete_Step )					// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_Sepa_Cutter_Heating) = 1;													// 동작 완료 Bit On.
			Sepa_Cutter_Heating_RTN = N_COMPLETE;																// 반환값 : COMPLETE
		}
	return


	// 커터 전진 실린더 + JR Data ID 전송.
	sub:Sepa_Cutter_Cylinder_FWD(&Sepa_Cutter_Cylinder_FWD_RTN)
		// 0.0) 반환값 초기화.
		Sepa_Cutter_Cylinder_FWD_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Sepa_Cutter_Cylinder_FWD) = Sys.Time;											// 타이머 설정.
			// ↓ 커터 전진으로 인해 적층 중이던 JR을 스텍테이블과 분리하여 초기화하는 부분 ======================//
			IF ( P_ARC_EPC_Vision_Value_Apply_Bit == 1 )														// ARC 이후 및 세파 소비 모드 진행 후 배출 시 ARC EPC값 적용 플래그.	[ 참조 : 26.05.08 ARC 후 ARC EPC값 적용 인터페이스 추가 ]
			{
				P_ARC_EPC_Vision_Value_Apply_Bit = 0;															// 비트 초기화.
				P_ARC_EPC_Vision_Value_Apply_Flag = 1;															// 플래그 실행.
			}
			IF ( P_Middle_Discharge_Ignore_User_Sepa_Mode_Check == 1 )											// 유저 세파 모드 진행 후 중간 배출 무시 확인 신호가 켜져 있을 경우.	[ 참조 : 26.05.13 중간 배출 무시 추가 ]
			{
				P_ARC_Middle_Discharge_Ignore_ON_Flag = 1;														// 중간 배출 무시 신호 ON.
			}
			if ( P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence )								// 현재 세파 모드 일 경우	[ 참조 : 26.07.31 Pause_Resume 수정 ] 
			{
				P_Sepa_To_Normal_Mode_Sync_Flag = 1;															// 세파 모드 후 일반 모드가 가능한 세파 모드 일 경우 Execute에서 싱크 맞추기 위한 플래그 변수 ON.
			}
			P_Com_EPC_Sepa_Consume_Mode_Flag = 0;																// EPC 세파모드 플레그 초기화(JR 커팅 후 초기화)	[ 참조 : 26.05.13 ARC 모듈 수정 ]
			P_Com_ARC_Sepa_Consume_Mode_Flag = 0;																// ARC 세파모드 플레그 초기화(JR 커팅 후 초기화)
			
			// 260708 연속 ng 기준 시트 단위에서 젤리롤 단위로 변경 및 연속 ng 카운트 시점 변경하여 알람 발생 시점 배출 후 발생하게 수정
			if( P_Stack_Table_NG_Flag == 1 )
			{
				P_Stack_Table_NG_Flag = 0;																		// NG Flag 초기화
				if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )
					P_Continuous_Call_Stack_NG_Flag = 1
			}
			else
			{
				if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )									// 일반 모드 배출 시에만 ok 데이터 추가 플래프 on
					P_Continuous_Call_Stack_OK_Flag = 1
			}
			// ↑ 커터 전진으로 인해 적층 중이던 JR을 스텍테이블과 분리하여 초기화하는 부분 ======================//
			P_Buf_Stack_NG_Flag = 0
			P_Stack_Table_NG_Count = 0
			M_Y_PLC_ARC_1st_Sepa_Mode_Signal = 0;																// ARC 진행 후 첫 세파모드 신호. (ARC 후 첫 세파모드 시 Vision에게 신호를 전달하기 위함)	[ 참조 : 26.05.22 ARC 후 첫 세파모드 신호 추가 ]
			// ↑ 커터 전진으로 인해 적층 중이던 JR을 스텍테이블과 분리하여 초기화하는 부분 ======================//
			// 커터 하강(커팅)
			M_Y_FR_Sepa_Cutter_Dn_Sol = 1;																		// 커터 하강.
			M_Y_FR_Sepa_Cutter_Up_Sol = 0;	

			// 260612 세파 열선 로그 추가
			P_Cutter_FWB_Heater_Current(9) = P_Cutter_FWB_Heater_Current(8)
			P_Cutter_FWB_Heater_Current(8) = P_Cutter_FWB_Heater_Current(7)
			P_Cutter_FWB_Heater_Current(7) = P_Cutter_FWB_Heater_Current(6)
			P_Cutter_FWB_Heater_Current(6) = P_Cutter_FWB_Heater_Current(5)
			P_Cutter_FWB_Heater_Current(5) = P_Cutter_FWB_Heater_Current(4)
			P_Cutter_FWB_Heater_Current(4) = P_Cutter_FWB_Heater_Current(3)
			P_Cutter_FWB_Heater_Current(3) = P_Cutter_FWB_Heater_Current(2)
			P_Cutter_FWB_Heater_Current(2) = P_Cutter_FWB_Heater_Current(1)
			P_Cutter_FWB_Heater_Current(1) = P_Cutter_FWB_Heater_Current(0)
			P_Cutter_FWB_Heater_Current(0) = P_Sepa_Cutter_Heat_Meter

			// 260609 시점 변경
			P_Suspend_Discharge_Last_Run_Bit = 0;																// 라스트 런 진행 확인 변수 초기화. (세파를 자르며 JR이 Stack으로 부터 자유로워 짐)	[ 참조 : 25.06.20 배출 프로그램 수정 ]
			P_Suspend_Discharge_1st_Unloader_JR_Grip = 1;														// 1차 언로더 JR 집은 상태 확인. (45도 정지 후 Resetting 시 필요)	[ 참조 : 25.07.08 배출 재가동 진행 추가 ]

			// [ 참조 : 260909 스택 테이블 적층 완료 젤리롤 유무 비트 추가 ]
			P_Stack_Table_JR_Exist_Flag = 0;

			// [참조 : 260427 노말모드 때만 젤리롤 생산 카운트 증가하도록 수정]
			// 260608 젤리롤 카운트 증가 시점 변경
			if( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )
			{
				P_Jelly_Roll_Total_Count++

				// 260615 샘플 Data 삽입 및 카운트 증가는 정상 젤리롤일 때만	
				//if(P_BTN_QC_Sample_Flag == 1 || P_BTN_Loss_Sample_Flag == 1)
				if( M_Stack_Host_ID_Sample_Type != 0 )								// 해당 시점에선 data가 스택에 존재, 1차 언로더로 넘기기 전이므로 스택데이터로 확인
				{
					M_Sample_JR_Prod_Count++;
				}
				if( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )												// 중간 배출 무시 일 경우.		[ 참조 : 26.05.13 중간 배출 무시 추가 ]
				{
					P_Middle_Discharge_Ignore_Stack_Count++														// 중간 배출 무시 적층 수량 증가.
					// 260609 중간 배출 무시 off 조건 수정 (비전에서 신호 주면)
					P_Middle_Skip_Off_Flag = 1;		// 중간 배출 무시 신호 OFF 요청.	[ PMAC → PLC ]
				}
			}

			if(P_MSA_Sample_Flag == 1)
			{
				P_MSA_Sample_Flag = 0;	// MSA 플래그 해제
			}
			//260528 라스트런 버그로 인한 수정	
			Sys_Stack_Sheet_Data = 0;
																												// 커터 상승.
			// [참조 : 260508 1차 언로더 블로우 추가] - 세파 접히지 않게 해주는 용도
			M_Y_1st_Unloader_JR_Grip_Blow_Sol = 1
			P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) = 1;								// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_Sepa_Cutter_Cylinder_FWD) + P_Act_Time_Out(N_Act_Sepa_Cutter_Cylinder_FWD) )	// 일정 시간 전에 완료 될 경우.
			{
				if ( M_X_FR_Sepa_Cutter_Dn_Sensor == 1 && M_X_FR_Sepa_Cutter_Up_Sensor == 0 )
				{
					P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) = 2;						// 다음 스텟 머신으로 이동.
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Sepa_Cutter_Cylinder_FWD) = P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) = N_Error_Step;				// 애러 스텟 머신으로 이동.
			}
		}

		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) == 2 )
		{
			if( Sys.Time > P_Act_Old_Time(N_Act_Sepa_Cutter_Cylinder_FWD) + P_Act_Delay_Time(N_Act_Sepa_Cutter_Cylinder_FWD) )	// 일정 딜레이 시간을 넘길 경우.
			{
				// [ 참조 : 2025.07.25 Retry 알람 발생 시점 변경 ]
				if( P_EPC_Retry_Over_Alarm_Flag == N_TRUE )	// 알람 발생 타이밍 
				{
					P_EPC_Retry_Over_Alarm_Flag = N_FALSE; // 초기화 

					call Alarm.Insert_Alarm(N_Alarm_Y_EPC_Align_Mode_Retry_Continuous_Error, N_High_Alarm_Cycle_Stop)
					P_PMAC_Commands = F_Command_Stop;
					P_Stop_Cmd_Origin = 11
				}
				
				// Trans IN 을 진행.
				// call Discharge_Sub_Prog.Trans_In();
				P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) = N_Complete_Step;				// 완료 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_Sepa_Cutter_Cylinder_FWD;									// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Sepa_Cutter_FWD_Error_Popup_Flag = 1;											// 세파 커터 전진 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Sepa_Cutter_Cylinder_FWD_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_FWD) == N_Complete_Step )				// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_Sepa_Cutter_Cylinder_FWD) = 1;												// 동작 완료 Bit On.
			Sepa_Cutter_Cylinder_FWD_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}
	return
	
	// 커터 후진 실린더 
	sub:Sepa_Cutter_Cylinder_BWD(&Sepa_Cutter_Cylinder_BWD_RTN)
		// 0.0) 반환값 초기화.
		Sepa_Cutter_Cylinder_BWD_RTN = 0;
		// 222) 동작 실행
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Sepa_Cutter_Cylinder_BWD) = Sys.Time;											// 타이머 설정.
			//M_Y_Final_Roll_Heating = 0;																		// 커터 열선 OFF.
			// ↓ [ 참고 : 2025.10.15 미비 사항 추가 건 ]
			M_Y_Sepa_Cutter_SSR_On = 0;																			// 커터 열선 OFF.
			M_Y_EPC_Vertical_Panel_Manual_Signal = 0;															// EPC 수동 → 자동 요청

			M_Y_FR_Sepa_Cutter_Dn_Sol = 0;																		// 커터 후진.
			M_Y_FR_Sepa_Cutter_Up_Sol = 1;																		// 커터 후진.

			P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) = 1;								// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_Sepa_Cutter_Cylinder_BWD) + P_Act_Time_Out(N_Act_Sepa_Cutter_Cylinder_BWD) )	// 일정 시간 전에 완료 될 경우.
			{
				if ( M_X_FR_Sepa_Cutter_Dn_Sensor == 0 && M_X_FR_Sepa_Cutter_Up_Sensor == 1 )					// 완료 확인
				{				
					// Trans OUT 시점 [ 참조 : Trans IN, OUT 시점 추가 ]	→ 트랜스 아웃 신호 필요 없다고 함
					//M_Y_PLC_Trans_OUT_Signal = 1;																// Trans OUT 
					P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) = N_Complete_Step;			// 완료 스텟 머신으로 이동.
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Sepa_Cutter_Cylinder_BWD) = P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) = N_Error_Step;				// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_Sepa_Cutter_Cylinder_BWD;									// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Sepa_Cutter_BWD_Error_Popup_Flag = 1;											// 세파 커터 후진 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Sepa_Cutter_Cylinder_BWD_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_Sepa_Cutter_Cylinder_BWD) == N_Complete_Step )				// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_Sepa_Cutter_Cylinder_BWD) = 1;												// 동작 완료 Bit On.
			Sepa_Cutter_Cylinder_BWD_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}
	return
	
	// 배출 후 액션 함수 초기화.
	sub:After_Action_Init(&After_Action_Init_RTN)
		// 0.0) 반환값 초기화.
		After_Action_Init_RTN = 0;																				// 반환값 초기화.
		// 222) ID 전송 + 배출 후 액션 함수 초기화
		if ( P_Module_Act_State_Machine_Array(N_Act_After_Action_Init) == N_Ready_Step )
		{
			IF ( M_X_PLC_JR_Data_Produce_Signal == 1 )															// [ 참조 : 26.03.26 메모리 데이터 영역 인터페이스 추가 ] 		
			{
				M_Y_PLC_JR_Data_Produce_Signal = 0;		
				P_1st_Discharge_State = F_Status_COMPLETE;														// 완료.
				call Discharge_Sub_Prog.Discharge_After_Action();												// 배출 후 액션 함수 ( 초기화 ).				// 1610ms + 세파 첫장 220ms = 1830ms		6500ms - 1830ms = 4670ms 여유 --> 실린더
				P_Module_Act_State_Machine_Array(N_Act_After_Action_Init) = 1;									// 다음 스텟 머신으로 이동.	
			}
		}
		if ( P_Module_Act_State_Machine_Array(N_Act_After_Action_Init) == 1 )
		{
			P_Module_Act_State_Machine_Array(N_Act_After_Action_Init) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_After_Action_Init) == N_Error_Step )						// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_After_Action_Init;											// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_After_Action_Init_Error_Popup_Flag = 1;											// 배출 후 액션 함수 초기화 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			After_Action_Init_RTN = N_FALSE;																	// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_After_Action_Init) == N_Complete_Step )						// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_After_Action_Init) = 1;													// 동작 완료 Bit On.
			After_Action_Init_RTN = N_COMPLETE;																	// 반환값 : COMPLETE
		}
	return

	// 시트 페이퍼 후진.
	sub:Sheet_Paper_BWD(&Sheet_Paper_BWD_RTN)
		// 0.0) 반환값 초기화.
		Sheet_Paper_BWD_RTN = 0;																				// 반환값 초기화.
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) == N_Ready_Step )
		{
			P_Act_Old_Time(N_Act_Sheet_Paper_BWD) = Sys.Time;													// 타이머 설정.
			P_Sheet_Paper_BWD_Status = 0;																		// 상태 초기화.
			P_Slave11_Motion_Command = N_Sheet_Paper_BWD_Motion;												// 시트 페이퍼 후진 cmd.
			P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) = 1;										// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시.
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_Sheet_Paper_BWD) + P_Act_Time_Out(N_Act_Sheet_Paper_BWD) )		// 일정 시간 전에 완료 될 경우.
			{
				if ( P_Sheet_Paper_BWD_Status == F_Status_COMPLETE )											// 모션 완료 일 경우.
				{
					P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Sheet_Paper_BWD) = P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) = N_Error_Step;							// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) == N_Error_Step )							// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_Sheet_Paper_BWD;											// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Sheet_Paper_BWD_Error_Popup_Flag = 1;											// 시트 페이퍼 후진 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Sheet_Paper_BWD_RTN = N_FALSE;																		// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_BWD) == N_Complete_Step )						// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_Sheet_Paper_BWD) = 1;														// 동작 완료 Bit On.
			Sheet_Paper_BWD_RTN = N_COMPLETE;																	// 반환값 : COMPLETE
		}
	return

	// 시트 페이퍼 진공 ON.
	sub:Sheet_Paper_Vacuum_ON(&Sheet_Paper_Vacuum_ON_RTN)
		// 0.0) 반환값 초기화.
		Sheet_Paper_Vacuum_ON_RTN = 0;																			// 반환값 초기화.
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) == N_Ready_Step )
		{
			P_Act_Old_Time(N_Act_Sheet_Paper_Vacuum_ON) = Sys.Time;												// 타이머 설정.
			M_Y_First_Sheet_Paper_Plate_Ejector_Vac_On = 1;														// 시트 페이퍼 진공 ON.
			M_Y_First_Sheet_Paper_Plate_Ejector_Vac_Off = 0;													// 시트 페이퍼 진공 ON.
			P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) = 1;									// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시.
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_Sheet_Paper_Vacuum_ON) + P_Act_Time_Out(N_Act_Sheet_Paper_Vacuum_ON) )		// 일정 시간 전에 완료 될 경우.
			{
				//if ( M_X_First_Sheet_Paper_Plate_Vac_Sensor == 1 )											// 시트 페이퍼 진공 신호 ON 일 경우.
				//{
					P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) = N_Complete_Step;			// 완료 스텟 머신으로 이동.
				//}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_Sheet_Paper_Vacuum_ON) = P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) = N_Error_Step;					// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_Sheet_Paper_Vacuum_ON;										// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_Sheet_Paper_Vacuum_ON_Error_Popup_Flag = 1;										// 시트 페이퍼 진공 ON 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Sheet_Paper_Vacuum_ON_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_Sheet_Paper_Vacuum_ON) == N_Complete_Step )					// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_Sheet_Paper_Vacuum_ON) = 1;												// 동작 완료 Bit On.
			Sheet_Paper_Vacuum_ON_RTN = N_COMPLETE;																// 반환값 : COMPLETE
		}
	return

	// 1차 언로더 위치 및 2,3차 언로더 인계 가능 확인 [ 1차 언로더 45도 위치 확인 ]
	sub:First_Unloader_Pos_Chk(&First_Unloader_Pos_Chk_RTN)
		// 0.0) 반환값 초기화.
		First_Unloader_Pos_Chk_RTN = 0;																			// 반환값 초기화.
		// 222) 1차 언로더 회피 위치 확인 + 배출 전 위치 완료 DIO 출력
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{
			if ( P_Motor_Current_Pos(N_UNLOADER_T) ~ P_1st_ULD_T_Avoid_Angle )									// 1차 언로더 T축 위치 확인.	[ 참조 : 25.09.09 배출 프로그램 수정 - 1차 언로더 위치 확인 추가 ]
			{	
				P_Act_Old_Time(N_Act_First_Unloader_Pos_Chk) = Sys.Time;										// 타이머 설정.
				P_Discharge_Unloader_Handover_Timer = 0;														// 2차 언로더 인계 대기 확인 시간 초기화.	[ 참조 : 25.08.01 배출 프로그램 수정 - 1차 → 2차 언로더 JR 인계 시간 표시 ]
				M_Y_Discharge_Avoid_Complete = 1;																// 1차 언로더 배출 전 위치 완료, 2차 언로더 대기 위치 요청 신호.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) = 1;								// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 2차 언로더 인계 가능 위치 확인
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) == 1 )
		{
			if ( M_X_Discharge_Avoid_Complete_Ack == 1 && M_X_PLC_2nd_Unloader_Ready_Pos == 1 )					// 2,3차 언로더 J/R 인계 가능 위치 IO
			{
				P_Suspend_Discharge_Cell_Out_Restart = 0;														// 배출 완료 전 JR Cnt 중복 증가 방지 변수 초기화.	[ 참조 : 25.06.05 배출 시 JR Cnt 관리 ]
				M_Y_Discharge_Avoid_Complete = 0;																// 1차 언로더 배출 전 위치 완료, 2차 언로더 대기 위치 요청 신호 초기화.
				M_Y_PLC_Unloader_Ready_Pos_Ack = 1;																// 2,3차 언로더 J/R 인계가능위치 Ack신호
				if( Sys.Time > P_Act_Old_Time(N_Act_First_Unloader_Pos_Chk) + P_Act_Delay_Time(N_Act_First_Unloader_Pos_Chk) )		// 일정 딜레이 시간을 넘길 경우.
				{
					P_Discharge_Unloader_Handover_Time = P_Discharge_Unloader_Handover_Timer;					// 2차 언로더 인계 대기 확인 시간 업데이트.	[ 참조 : 25.08.01 배출 프로그램 수정 - 1차 → 2차 언로더 JR 인계 시간 표시 ] 
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) = N_Complete_Step;			// 완료 스텟 머신으로 이동.
				}
			}
			//	[ 참 조 : 2025.12.12 마지막 공정 스탑 처리 ]
			if ( P_PMAC_Status == F_Status_STOPPING )															// 1차 언로더 45도 회전 후 2차 언로더 대기 중 Stopping으로 바뀔 경우 정지.		[ 참조 : 25.07.08 배출 재가동 진행 추가 ]
			{
				if( P_Jelly_Roll_Total_Count >= P_Jelly_Roll_Recipe_Count )										// 마지막 공정이라면( 마지막 공정때 스탑으로 멈추면 PLC 언로더가 안가져가므로.. )
				{
					if ( M_X_Discharge_Avoid_Complete_Ack == 1 && M_X_PLC_2nd_Unloader_Ready_Pos == 1 )			// 2,3차 언로더 J/R 인계 가능 위치 IO
					{
						P_Suspend_Discharge_Cell_Out_Restart = 0;												// 배출 완료 전 JR Cnt 중복 증가 방지 변수 초기화.	[ 참조 : 25.06.05 배출 시 JR Cnt 관리 ]
						M_Y_Discharge_Avoid_Complete = 0;														// 1차 언로더 배출 전 위치 완료, 2차 언로더 대기 위치 요청 신호 초기화.
						M_Y_PLC_Unloader_Ready_Pos_Ack = 1;														// 2,3차 언로더 J/R 인계가능위치 Ack신호
						if( Sys.Time > P_Act_Old_Time(N_Act_First_Unloader_Pos_Chk) + P_Act_Delay_Time(N_Act_First_Unloader_Pos_Chk) )	// 일정 딜레이 시간을 넘길 경우.
						{
							P_Discharge_Unloader_Handover_Time = P_Discharge_Unloader_Handover_Timer;			// 2차 언로더 인계 대기 확인 시간 업데이트.	[ 참조 : 25.08.01 배출 프로그램 수정 - 1차 → 2차 언로더 JR 인계 시간 표시 ] 
							P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) = N_Complete_Step;	// 완료 스텟 머신으로 이동.
						}
					}
				}
				else
				{
					call Discharge_Sub_Prog.Interface_Init();													// PMAC ↔ PLC Interface 초기화.
					P_Discharge_Unloader_Handover_Time = P_Discharge_Unloader_Handover_Timer;					// 2차 언로더 인계 대기 확인 시간 업데이트.	[ 참조 : 25.08.01 배출 프로그램 수정 - 1차 → 2차 언로더 JR 인계 시간 표시 ] 
					P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Pos_Chk) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) = N_Error_Step;				// 애러 스텟 머신으로 이동.
				}
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_Pos_Chk;									// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_2nd_Unloader_Handover_Chk_Error_Popup_Flag = 1;								// 1,2차 언로더 인계 위치 확인 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_Pos_Chk_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Pos_Chk) == N_Complete_Step )				// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_Pos_Chk) = 1;												// 동작 완료 Bit On.
			First_Unloader_Pos_Chk_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}
	return
	
	// 2,3차 언로더 그립 (언로더 진입 확인) (A열 : 2차 언로더, B열 : 3차 언로더)
   sub:Unloader_Grip_ON_to_Grip_Off(&Unloader_Grip_ON_to_Grip_Off_RTN)
      // 0.0) 반환값 초기화.
      Unloader_Grip_ON_to_Grip_Off_RTN = 0;                                                                     // 반환값 초기화.
      // 222) 2차 언로더 진입 완료 확인 + 2차 언로더 그립 요청
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == N_Ready_Step )				// 진행 준비 완료 일 경우.
      {
         if ( P_Motor_Current_Pos(N_UNLOADER_T) ~ P_1st_ULD_T_90_Angle )										// 1차 언로더 T축 위치 확인. (90도)   [ 참조 : 25.09.09 배출 프로그램 수정 - 1차 언로더 위치 확인 추가 ]
         {
            P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) = Sys.Time;										// 타이머 설정.
            M_Y_PLC_Unloader_Grip_Request = 1;																	// 2,3차 언로더 그립 요청 DIO
            P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = 1;							// 다음 스텟 머신으로 이동.
         }
         else																									// 1차 언로더 T축 위치가 맞지 않을 경우.
		 {
			P_Module_Act_State_Machine_Error_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off);	// Error 버퍼 저장.
            P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = N_Error_Step;                // 애러 스텟 머신으로 이동.
		}
      }
      // 1) 2차 언로더 그립 확인
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == 1 )
      {
         if ( Sys.Time < P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) + P_Act_Time_Out(N_Act_Unloader_Grip_ON_to_Grip_Off) )            // 일정 시간 전에 완료 될 경우.*정확하게* 라인별  업데이트 할 것 
         {
            if ( M_X_PLC_2nd_Unloader_Grip == 1 && M_X_PLC_2nd_Unloader_Grip_Request_Ack == 1 )					// 2,3차 언로더 그립 확인. [ Write : 2차 언로더 그립 요청 DIO ]
            {
               M_Y_PLC_Unloader_Grip_Request = 0;																// 2,3차 언로더 그립 요청 DIO 초기화.
               M_Y_PLC_Unloader_Grip_Ack = 1;
               //if( Sys.Time > P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) + P_Act_Delay_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) )      // 일정 딜레이 시간을 넘길 경우.(이거는 필수)
               //{
                  P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = 2;						// 다음 스텟머신으로 
              // }
            }
         }
         else																									// 일정 시간을 넘길 경우. [타임 아웃]
         {
			P_Module_Act_State_Machine_Error_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off);	// Error 버퍼 저장.
            P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = N_Error_Step;				// 애러 스텟 머신으로 이동.
         }
      }
      
      // 2) 2차 언로더 그립 확인
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == 2 )
      {
         if ( M_X_PLC_2nd_Unloader_Grip == 1 && M_Y_PLC_Unloader_Grip_Ack == 1 )                                // 2,3차 언로더 그립 확인. [ Write : 3차 언로더 그립 요청 DIO ]
         {
            M_Y_PLC_Unloader_Grip_Ack = 0;																		// 2,3차 언로더 그립 아크신호.
            M_Y_1st_Unloader_Grip_Sol = 0;																		// 1차 언로더 언그립.
            M_Y_1st_Unloader_UnGrip_Sol = 1;    		
			// 260605 1차 언로더 블로우 off 프로그램 위치 변경                                                     
            M_Y_1st_Unloader_JR_Grip_Blow_Sol = 0																// 1차 언로더 블로우 추가
            P_Suspend_Discharge_1st_Unloader_JR_Grip = 0;														// 1차 언로더 젤리롤 존재 제거
			
			M_Y_PLC_to_Memory_Data_Parsing_Request = 1;															// 메모리 데이터 파싱 PMAC -> PLC전송  - [ 참조 : 26.03.26 메모리 데이터 영역 인터페이스 추가 ]    
            P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) = Sys.Time;                                      // 타이머 설정.
            P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = 3;
         }

      }   
      // 3) 1차 언로더 언그립 확인
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == 3 )
      {
         if ( Sys.Time < P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) + P_Act_Time_Out(N_Act_Unloader_Grip_ON_to_Grip_Off) )            // 일정 시간 전에 완료 될 경우.   *정확하게* 라인별  업데이트 할 것 
         {
            if ( M_X_1st_Unloader_UnGrip_Detect_Sensor == 1  )													// 1차 언로더 언그립 확인.
            {
               P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) = Sys.Time;									// 타이머 설정.
               M_Y_1st_Unloader_UnGrip_Complete = 1;															// 1차 언로더 언그립 완료 신호.   
               
               P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = 4;
            }
         }
      }
      // 4) 1차 언로더 언그립 확인완료 ack신호 체크
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == 4 )
      {
         if ( Sys.Time < P_Act_Old_Time(N_Act_Unloader_Grip_ON_to_Grip_Off) + P_Act_Time_Out(N_Act_Unloader_Grip_ON_to_Grip_Off) )            // 일정 시간 전에 완료 될 경우. *정확하게* 라인별  업데이트 할 것 
         {
            if ( M_X_1st_Unloader_UnGrip_Ack == 1 && M_X_Memory_Data_Parsing_Complete == 1 )					// 메모리 데이터 파싱 PLC입력 신호 수신 완료 되었따면  - [ 참조 : 26.03.26 메모리 데이터 영역 인터페이스 추가 ]       
            {
               M_Y_1st_Unloader_UnGrip_Complete = 0;
               M_Y_PLC_to_Memory_Data_Parsing_Request = 0;   
			    
			   // 참조 260605 1차 언로더 데이터 삭제 추가  - 2차 언로더 인계 후 plc에서 데이터 읽어 갔다는 신호 주면 초기화
			   call First_ULD_Data_Clear();			// 1차 언로더 젤리롤 data 삭제
               P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = 5;
            }
         }
      }
      
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == 5 )
      {
         P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) = N_Complete_Step;
      }

      // 444) 애러
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == N_Error_Step )				// 애러 상태 일 경우.
      {
         P_Suspend_Discharge_Module_Error = N_Act_Unloader_Grip_ON_to_Grip_Off;									// Suspend 모듈 정지.      [ 참조 : 26.01.08 Suspend 모듈 수정 ]
		 P_Suspend_Discharge_2nd_3rd_Unloader_Grip_Request_Error_Popup_Flag = 1;								// 2,3차 언로더 그립 요청 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
         Unloader_Grip_ON_to_Grip_Off_RTN = N_FALSE;															// 반환값 : FALSE.
      }
      // 999) 완료
      if ( P_Module_Act_State_Machine_Array(N_Act_Unloader_Grip_ON_to_Grip_Off) == N_Complete_Step )			// 완료 상태 일 경우.
      {         
         P_Act_Complete_Bit(N_Act_Unloader_Grip_ON_to_Grip_Off) = 1;											// 동작 완료 Bit On.
         Unloader_Grip_ON_to_Grip_Off_RTN = N_COMPLETE;															// 반환값 : COMPLETE
      }
   return

	// 1차 언로더 대기 위치 이동 [후진 후 회전] (T축) (1차 언로더 언그립 확인)
	sub:First_Unloader_Wait_Pos(&First_Unloader_Wait_Pos_RTN)
		// 0.0) 반환값 초기화.
		First_Unloader_Wait_Pos_RTN = 0;																		// 반환값 초기화.
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == N_Ready_Step )					// 진행 준비 완료 일 경우.
		{
			if ( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) != N_Dryrun_Status_Sequence )			// 드라이런 모드가 아닐 경우. (일반 모드, 세파 모드)	// [ 참조 : 25.10.14 모드에 따른 배출 진행 수정 ]
			{
				P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) = Sys.Time;										// 타이머 설정.
				if ( M_X_PLC_to_1st_Avoid_Request == 1 )														// 1차 언로더 회피 요청.
				{
					P_First_Unloader_Avoid_Status = F_Status_Nonseatus;											// 상태 초기화.
					P_Slave14_Motion_Command = N_1st_UND_Avoid_Motion;											// 1차 언로더 45도 이동.
					P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = 1;						// 다음 스텟 머신으로 이동.
				}
			}
			else																								// 드라이런 모드 일 경우.		// [ 참조 : 25.10.14 모드에 따른 배출 진행 수정 ]
			{
				P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) = Sys.Time;										// 타이머 설정.
				P_First_Unloader_Avoid_Status = F_Status_COMPLETE;												// 상태 완료. [ 45도 위치에서 모션을 날리지 않기 위함 ]
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = 1;							// 완료 스텟 머신으로 이동.			
			}
		}
		// 1) 1차 언로더 회피위치 복귀(T축) 확인 + 1차 언로더 그립 명령
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == 1 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) + P_Act_Time_Out(N_Act_First_Unloader_Wait_Pos) )	// 일정 시간 전에 완료 될 경우.
			{
				if ( P_First_Unloader_Avoid_Status == F_Status_COMPLETE && P_Motor_Current_Pos(N_UNLOADER_T) ~ P_1st_ULD_T_Avoid_Angle )	// 1차 언로더 회피 위치 확인.
				{
					M_Y_PLC_to_1st_Avoid_Request_Ack = 1;														// 1차 언로더 45도 이동 완료 Ack 신호.
					P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) = Sys.Time;									// 타이머 설정.
					M_Y_1st_Unloader_Grip_Sol = 1;																// 1차 언로더 그립 DIO 출력
					M_Y_1st_Unloader_UnGrip_Sol = 0;															// 1차 언로더 언그립 DIO OFF
					P_1st_UND_Grip_Time = Sys.Time;
					if ( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) != N_Dryrun_Status_Sequence )	// 드라이런 모드가 아닐 경우. (일반 모드, 세파 모드)	// [ 참조 : 25.10.14 모드에 따른 배출 진행 수정 ]
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = 2;					// 다음 스텟 머신으로 이동.
					else																						// 드라이런 모드 일 경우.		// [ 참조 : 25.10.14 모드에 따른 배출 진행 수정 ]
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = 3;					// 다다음 스텟 머신으로 이동. [ 1차 언로더 인계 후 회피위치 이동 완료 IO를 하지 않기 위함 ]
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Wait_Pos) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = N_Error_Step;					// 애러 스텟 머신으로 이동.
			}
		}
		// 2) 1차 언로더 그립 확인 + 회피위치 이동 완료 IO 출력
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == 2 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) + P_Act_Time_Out(N_Act_First_Unloader_Wait_Pos) )	// 일정 시간 전에 완료 될 경우.
			{
				if( Sys.Time  > P_1st_UND_Grip_Time + P_1st_UND_Grip_Time_offset2 )
				{
					//if ( M_X_1st_Unloader_Grip_Detect_Sensor == 1 && M_X_1st_Unloader_UnGrip_Detect_Sensor == 0 )				// 1차 언로더 그립 센서 확인.
					if( M_X_1st_Unloader_JR_Grip_Pressure_Sensor == 1 && M_X_1st_Unloader_UnGrip_Detect_Sensor == 0 )
					{
						P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) = Sys.Time;								// 타이머 설정.
						M_Y_1st_Avoid_Pos_Discharge_Complete = 1;												// 1차 언로더 인계 후 회피위치 이동 완료 IO
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = 3;					// 다음 스텟 머신으로 이동.
					}
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Wait_Pos) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = N_Error_Step;					// 애러 스텟 머신으로 이동.
			}
		}
		// 3) T축 대기 위치 복귀
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == 3 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) + P_Act_Time_Out(N_Act_First_Unloader_Wait_Pos) )	// 일정 시간 전에 완료 될 경우.
			{
				P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) = Sys.Time;										// 타이머 설정.
				P_First_Unloader_Turn_Status = F_Status_Nonseatus;												// 상태 초기화.
				P_Slave14_Motion_Command = N_1st_UND_Turn_Motion;												// 언로더 T축 복귀
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = 4;							// 다음 스텟 머신으로 이동.
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Error_Array(N_Act_First_Unloader_Wait_Pos) = P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = N_Error_Step;					// 애러 스텟 머신으로 이동.
			}
		}
		// 4) 1차 언로더 대기 위치 복귀 확인(T축)
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == 4 )
		{
			if ( Sys.Time < P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) + P_Act_Time_Out(N_Act_First_Unloader_Wait_Pos) )	// 일정 시간 전에 완료 될 경우.
			{
				if ( P_First_Unloader_Turn_Status == F_Status_COMPLETE && P_Motor_Current_Pos(N_UNLOADER_T) ~ P_1st_ULD_T_Wait )		// 1차 언로더 T축 대기 위치 확인.												
				{
					if( Sys.Time > P_Act_Old_Time(N_Act_First_Unloader_Wait_Pos) + P_Act_Delay_Time(N_Act_First_Unloader_Wait_Pos) )		// 일정 딜레이 시간을 넘길 경우.
					{
						call Discharge_Sub_Prog.Interface_Init();												// PMAC ↔ PLC Interface 초기화.
						P_Suspend_Discharge_Complete_Flag = 1;													// 배출 완료 Flag ON. [메모리 타워 확인용]
						P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = N_Complete_Step;		// 완료 스텟 머신으로 이동.
					}
				}
			}
			else																								// 일정 시간을 넘길 경우. [타임 아웃]
			{
				P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) = N_Error_Step;					// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == N_Error_Step )					// 애러 상태 일 경우.
		{
			P_Suspend_Discharge_Module_Error = N_Act_First_Unloader_Wait_Pos;									// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_Discharge_1st_Unloader_Wait_Pos_Error_Popup_Flag = 1;										// 1차 언로더 대기 위치 이동 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			First_Unloader_Wait_Pos_RTN = N_FALSE;																// 반환값 : FALSE.
		}
		// 999) 완료
		if ( P_Module_Act_State_Machine_Array(N_Act_First_Unloader_Wait_Pos) == N_Complete_Step )				// 완료 상태 일 경우.
		{			
			P_Act_Complete_Bit(N_Act_First_Unloader_Wait_Pos) = 1;												// 동작 완료 Bit On.
			First_Unloader_Wait_Pos_RTN = N_COMPLETE;															// 반환값 : COMPLETE
		}	
	return



	/*------------- ARC_Fine -------------//
	- ARC_Pre_Act						[x]			[ARC 진행 전 사전 작업]
	- Dancer_Closed						[실린더]		[닙롤 전진]	
	- Dancer_Open						[실린더]		[닙롤 후진]
	- Use_Plate_FWD						[실린더]		[사용 플레이트 전진]
	- Use_Plate_BWD						[실린더]		[사용 플레이트 후진]
	- Use_Plate_Clamp_ON				[실린더]		[사용 플레이트 클램프 ON]
	- Use_Plate_Clamp_OFF				[실린더]		[사용 플레이트 클램프 OFF]
	- Use_Plate_Cutter_FWD				[실린더]		[사용 플레이트 커터 전진]
	- Use_Plate_Cutter_BWD				[실린더]		[사용 플레이트 커터 후진]
	- Replace_Plate_Blow_ON				[실린더]		[교체 플레이트 블로우 ON]
	- Replace_Plate_Blow_OFF			[실린더]		[교체 플레이트 블로우 OFF]
	- Spool_Change						[x]			[ARC 완료 후 스풀 교체]
	- Previous_Spool_Remain_Winding		[모터]		[이전 스풀 잔량 감기]
	- ARC_Post_Act						[x]			[ARC 진행 후 사후 작업]
	//------------------------------------*/
	// ARC 진행 전 사전 작업.		
	sub:ARC_Pre_Act(&ARC_Pre_Act_RTN)
		// 0.0) 반환값 초기화.
		ARC_Pre_Act_RTN = 0;
		// 222) 케스케이드 링크 해제.
		if ( P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) == N_Ready_Step )										// 진행 준비 완료 일 경우.
		{
			// 2025.06.01 추가
			// ↓ ARC 시작 후 켜주는 값 모음 ===================//
			P_Com_ARC_Sepa_Consume_Mode_Flag = 1;																		// ARC 이후 세파 소비 모드
			P_ARC_Middle_Discharge_Ignore_Vision_Check = 1;																// ARC 진행 후 Vision 신호 또는 극판 적층 수 확인 변수.	[ 참조 : 26.05.13 중간 배출 무시 추가 ]
			P_ARC_Middle_Discharge_Ignore_ON_Flag = 1;																	// ARC 진행 시 중간 배출 무시 신호 ON 플래그.	[ 참조 : 26.05.13 중간 배출 무시 추가 ]
			M_Y_PLC_ARC_1st_Sepa_Mode_Signal = 1;																		// ARC 진행 후 첫 세파모드 신호. (ARC 후 첫 세파모드 시 Vision에게 신호를 전달하기 위함)	[ 참조 : 26.05.22 ARC 후 첫 세파모드 신호 추가 ]
			// ↑ ARC 시작 후 켜주는 값 모음 ===================//
			P_System_Cascading_OFF_Cmd = F_Command_Start;																// Cascading 해제
			P_Prev_Sepa_Stack_Completed_Flag = 0;																		// 세파 모드 변경 필요해서 우선 넣어놓음.[?]
			P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) = 1														// 다음 스텟 머신으로 이동.
		}
		// 1) 서보 댄서 가상축 및 실축 설정.
		if ( P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) == 1 )
		{
			if( P_System_Cascading_OFF_Complete_Flag )																	// 완료 후	[ 참조 : 26.04.24 ARC 모듈 수정 ]
			{
				P_System_Cascading_OFF_Complete_Flag = 0;																// Cascading 해제 완료 변수 초기화.
				P_Act_Old_Time(N_Act_ARC_Pre_Act) = Sys.Time;															// 시간 업데이트.
				P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) = 2;												// 다음 스텟 머신으로 이동.
			}
		}
		// 2) 기존 플레이트 진공 Blow ON. ( 공압을 OFF 하기 위해서 Blow ON → Blow OFF 진행 )
		if ( P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) == 2 )
		{
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{																											
				M_Y_Sepa_Upper_ARC_Ejector_Vac_On = 0;																	// 상부 플레이트 Blow ON.
				M_Y_Sepa_Upper_ARC_Ejector_Vac_Off = 1;																	// 상부 플레이트 Blow ON.
				if( Sys.Time > P_Act_Old_Time(N_Act_ARC_Pre_Act) + P_Act_Delay_Time(N_Act_ARC_Pre_Act) )				// 일정 딜레이 시간을 넘길 경우. [블로우 후 잔압 빠지는 시간 필요]
				{
					P_Act_Old_Time(N_Act_ARC_Pre_Act) = Sys.Time;														// 타이머 설정.
					P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) = 3;											// 다음 스텟 머신으로 이동.
				}
			}																											
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{																											
				M_Y_Sepa_Lower_ARC_Ejector_Vac_On = 0;																	// 하부 플레이트 Blow ON.
				M_Y_Sepa_Lower_ARC_Ejector_Vac_Off = 1;																	// 하부 플레이트 Blow ON.
				if( Sys.Time > P_Act_Old_Time(N_Act_ARC_Pre_Act) + P_Act_Delay_Time(N_Act_ARC_Pre_Act) )				// 일정 딜레이 시간을 넘길 경우. [블로우 후 잔압 빠지는 시간 필요]
				{
					P_Act_Old_Time(N_Act_ARC_Pre_Act) = Sys.Time;														// 타이머 설정.
					P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) = 3;											// 다음 스텟 머신으로 이동.
				}
			}																											   
		}																												
		// 3) 기존 플레이트 진공 Blow OFF. ( 공압을 OFF 하기 위해서 Blow ON → Blow OFF 진행 )								   
		if ( P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) == 3 )											
		{														
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.																		   
			{																											
				M_Y_Sepa_Upper_ARC_Ejector_Vac_On = 0;																	// 상부 플레이트 Blow OFF.
				M_Y_Sepa_Upper_ARC_Ejector_Vac_Off = 0;																	// 상부 플레이트 Blow OFF.
				if( Sys.Time > P_Act_Old_Time(N_Act_ARC_Pre_Act) + P_Act_Delay_Time(N_Act_ARC_Pre_Act) )				// 일정 딜레이 시간을 넘길 경우.
				{	
					P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) = N_Complete_Step;								// 완료 스텟 머신으로 이동.
				}
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				M_Y_Sepa_Lower_ARC_Ejector_Vac_On = 0;																	// 하부 플레이트 Blow OFF.
				M_Y_Sepa_Lower_ARC_Ejector_Vac_Off = 0;																	// 하부 플레이트 Blow OFF.				
				if( Sys.Time > P_Act_Old_Time(N_Act_ARC_Pre_Act) + P_Act_Delay_Time(N_Act_ARC_Pre_Act) )				// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) = N_Complete_Step;								// 완료 스텟 머신으로 이동.				
				}
			}			
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) == N_Error_Step )										// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_ARC_Pre_Act;																// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Pre_Act_Popup_Flag = 1;																		// ARC 진행 전 사전 작업 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			ARC_Pre_Act_RTN = N_FALSE;																					// 반환값 : FALSE.
		}
		
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_ARC_Pre_Act) == N_Complete_Step )									// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_ARC_Pre_Act) = 1;																	// 동작 완료 Bit On.
			ARC_Pre_Act_RTN = N_COMPLETE;																				// 반환값 : COMPLETE
		}
	return

	// 닙롤 전진. --> 닙롤 삭제로 인하여 Dancer CloseLoop 변경 [ 참조 : 26.02.25 ClosedLoop 변경 ]
	sub:Dancer_Closed(&Dancer_Colsde_RTN)		// skip
		// 0.0) 반환값 초기화.
		Dancer_Colsde_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Closed) == N_Ready_Step )										// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Dancer_Closed) = Sys.Time;																	// 타이머 설정.

			P_Module_Act_State_Machine_Array(N_Dancer_Closed) = 1;														// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Closed) == 1 )
		{
			if( Sys.Time < P_Act_Old_Time(N_Dancer_Closed) + P_Act_Time_Out(N_Dancer_Closed) )							// 일정 딜레이 시간을 넘기지 않을 경우.
			{
				P_Module_Act_State_Machine_Array(N_Dancer_Closed) = N_Complete_Step;									// 완료 스텟 머신으로 이동.
			}
			else																										// 일정 딜레이 시간을 넘길 경우.
			{
				P_Module_Act_State_Machine_Error_Array(N_Dancer_Closed) = P_Module_Act_State_Machine_Array(N_Dancer_Closed);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Dancer_Closed) = N_Error_Step;										// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Closed) == N_Error_Step )										// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Dancer_Closed;																// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Driving_Roll_FWD_BWD_Error, N_High_Alarm_Cycle_Stop);
//			M_SEPA_ARC_Driving_Roll_FWD_BWD_Error_Alarm = 1;															// 드라이빙 롤 알람 발생.
			P_Suspend_ARC_Dancer_Close_Popup_Flag = 1;																	// 서보 댄서 CloseLoop 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Dancer_Colsde_RTN = N_FALSE;																				// 반환값 : FALSE.
		}
		
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Closed) == N_Complete_Step )										// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Dancer_Closed) = 1;																	// 동작 완료 Bit On.
			Dancer_Colsde_RTN = N_COMPLETE;																				// 반환값 : COMPLETE
		}
	return

	// 닙롤 후진. --> 닙롤 삭제로 인하여 OpenLoop로 변경 [ 참조 : 26.02.25 ClosedLoop 변경 ]
	sub:Dancer_Open(&Dancer_Open_RTN)
		// 0.0) 반환값 초기화.
		Dancer_Open_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Open) == N_Ready_Step )											// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Dancer_Open) = Sys.Time;																	// 타이머 설정.
			P_Dancer_Out_Slew_Seq = 1;																					// Servo Out 
			P_Module_Act_State_Machine_Array(N_Dancer_Open) = 1;														// 다음 스텟 머신으로 이동.
		}
		// 1) 동작 완료 감시	.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Open) == 1 )
		{
			if( Sys.Time < P_Act_Old_Time(N_Dancer_Open) + P_Act_Time_Out(N_Dancer_Open) )								// 일정 딜레이 시간을 넘기지 않을 경우.
			{
				if( Motor[N_SERVO_DANCER].ClosedLoop == 0 && P_Dancer_Out_Slew_Seq == 0 )
				{
					P_Module_Act_State_Machine_Array(N_Dancer_Open) = N_Complete_Step;									// 완료 스텟 머신으로 이동.
				}
			}
			else																										// 일정 딜레이 시간을 넘길 경우.
			{
				P_Module_Act_State_Machine_Error_Array(N_Dancer_Open) = P_Module_Act_State_Machine_Array(N_Dancer_Open);	// Error 버퍼 저장.
				P_Module_Act_State_Machine_Array(N_Dancer_Open) = N_Error_Step;											// 애러 스텟 머신으로 이동.
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Open) == N_Error_Step )											// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Dancer_Open;																	// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Driving_Roll_FWD_BWD_Error, N_High_Alarm_Cycle_Stop);
			P_Suspend_ARC_Dancer_Open_Popup_Flag = 1;																	// 서보 댄서 OpenLoop 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			Dancer_Open_RTN = N_FALSE;																					// 반환값 : FALSE.
		}
		
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Dancer_Open) == N_Complete_Step )										// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Dancer_Open) = 1;																		// 동작 완료 Bit On.
			Dancer_Open_RTN = N_COMPLETE;																				// 반환값 : COMPLETE
		}
	return

	// 사용 플레이트 전진. [ 상부 선택 → 상부 : 하강, 하부 선택 → 하부 : 상승 ]
	sub:Use_Plate_FWD(&Use_Plate_FWD_RTN)
		// 0.0) 반환값 초기화.
		Use_Plate_FWD_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) == N_Ready_Step )									// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Use_Plate_FWD) = Sys.Time;																// 타이머 설정.
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Upper_Up_Sol = 0;																			// 교체 플레이트 전진. [상부 플레이트 하강]
				M_Y_Sepa_ARC_Upper_Dn_Sol = 1;																			// 교체 플레이트 전진. [상부 플레이트 하강]

				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = 1;												// 다음 스텟 머신으로 이동.
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Lower_Up_Sol = 1;																			// 교체 플레이트 전진. [하부 플레이트 상승]
				M_Y_Sepa_ARC_Lower_Dn_Sol = 0;																			// 교체 플레이트 전진. [하부 플레이트 상승]

				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = 1;												// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 동작 딜레이 설정.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) == 1 )												
		{
			if ( Sys.Time > P_Act_Old_Time(N_Act_Use_Plate_FWD) + P_Act_Delay_Time(N_Act_Use_Plate_FWD) )				// 동작 딜레이 설정.
			{
				P_Act_Old_Time(N_Act_Use_Plate_FWD) = Sys.Time;															// 타이머 설정.
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = 2;												// 다음 스텟 머신으로 이동.
			}
		}
		// 2) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) == 2 )
		{
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_FWD) + P_Act_Time_Out(N_Act_Use_Plate_FWD) )				// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if( M_X_Sepa_Upper_ARC_Up_Sensor == 0 && M_X_Sepa_Upper_ARC_Dn_Sensor == 1 )						// 완료 상태 확인 후.					
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_FWD) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = N_Error_Step;								// 애러 스텟 머신으로 이동.
				}
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_FWD) + P_Act_Time_Out(N_Act_Use_Plate_FWD) )				// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if( M_X_Sepa_Lower_ARC_Up_Sensor == 1 && M_X_Sepa_Lower_ARC_Dn_Sensor == 0 )						// 완료 상태 확인 후.	
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_FWD) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) = N_Error_Step;								// 애러 스텟 머신으로 이동.
				}
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) == N_Error_Step )									// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_Use_Plate_FWD;															// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Use_Plate_FWD_Popup_Flag = 1;																	// 사용 플레이트 전진 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Lower_Plate_Up_Down_Error, N_High_Alarm_Cycle_Stop);
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Upper_Plate_UP_Down_Error, N_High_Alarm_Cycle_Stop);
			Use_Plate_FWD_RTN = N_FALSE;																				// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_FWD) == N_Complete_Step )									// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Use_Plate_FWD) = 1;																// 동작 완료 Bit On.
			Use_Plate_FWD_RTN = N_COMPLETE;																				// 반환값 : COMPLETE
		}
	return

	// 사용 플레이트 후진. [ 상부 선택 → 상부 : 상승, 하부 선택 → 하부 : 하강 ]
	sub:Use_Plate_BWD(&Use_Plate_BWD_RTN)
		// 0.0) 반환값 초기화.
		Use_Plate_BWD_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) == N_Ready_Step )									// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Use_Plate_BWD) = Sys.Time;																// 타이머 설정.
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Upper_Up_Sol = 1;																			// 교체 플레이트 후진. [상부 플레이트 상승]
				M_Y_Sepa_ARC_Upper_Dn_Sol = 0;																			// 교체 플레이트 후진. [상부 플레이트 상승]

				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = 1;												// 다음 스텟 머신으로 이동.
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Lower_Up_Sol = 0;																			// 교체 플레이트 후진. [하부 플레이트 하강]
				M_Y_Sepa_ARC_Lower_Dn_Sol = 1;																			// 교체 플레이트 후진. [하부 플레이트 하강]

				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = 1;												// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 동작 딜레이 설정.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) == 1 )
		{
			if ( Sys.Time > P_Act_Old_Time(N_Act_Use_Plate_BWD) + P_Act_Delay_Time(N_Act_Use_Plate_BWD) )				// 동작 딜레이 설정.
			{
				P_Act_Old_Time(N_Act_Use_Plate_BWD) = Sys.Time;															// 타이머 설정.
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = 2;												// 다음 스텟 머신으로 이동.
			}
		}
		// 2) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) == 2 )
		{
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_BWD) + P_Act_Time_Out(N_Act_Use_Plate_BWD) )				// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if( M_X_Sepa_Upper_ARC_Up_Sensor == 1 && M_X_Sepa_Upper_ARC_Dn_Sensor == 0 )						// 완료 상태 확인 후.		
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_BWD) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = N_Error_Step;								// 애러 스텟 머신으로 이동.
				}
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_BWD) + P_Act_Time_Out(N_Act_Use_Plate_BWD) )				// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if( M_X_Sepa_Lower_ARC_Up_Sensor == 0 && M_X_Sepa_Lower_ARC_Dn_Sensor == 1 )						// 완료 상태 확인 후.	
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = N_Complete_Step;						// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_BWD) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) = N_Error_Step;								// 애러 스텟 머신으로 이동.
				}
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) == N_Error_Step )									// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_Use_Plate_BWD;															// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Use_Plate_BWD_Popup_Flag = 1;																	// 사용 플레이트 후진 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Lower_Plate_Up_Down_Error, N_High_Alarm_Cycle_Stop);
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Upper_Plate_UP_Down_Error, N_High_Alarm_Cycle_Stop);
			Use_Plate_BWD_RTN = N_FALSE;																				// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_BWD) == N_Complete_Step )									// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Use_Plate_BWD) = 1;																// 동작 완료 Bit On.
			Use_Plate_BWD_RTN = N_COMPLETE;																				// 반환값 : COMPLETE
		}
	return

	// 사용 플레이트 클램프 ON. 
	sub:Use_Plate_Clamp_ON(&Use_Plate_Clamp_ON_RTN)
		// 0.0) 반환값 초기화.
		Use_Plate_Clamp_ON_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) == N_Ready_Step )								// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Use_Plate_Clamp_ON) = Sys.Time;														// 타이머 설정.
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Upper_Stopper_FWD_Sol = 0;																	// 상부 스토퍼 클램프 (실린더 기준 후진)
				M_Y_Sepa_ARC_Upper_Stopper_BWD_Sol = 1;																	// 상부 스토퍼 클램프 (실린더 기준 후진)
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = 1;											// 다음 스텟 머신으로 이동.
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Lower_Stopper_FWD_Sol = 0;																	// 하부 스토퍼 클램프 (실린더 기준 후진)
				M_Y_Sepa_ARC_Lower_Stopper_BWD_Sol = 1;																	// 하부 스토퍼 클램프 (실린더 기준 후진)
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = 1;											// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 동작 딜레이 설정.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) == 1 )
		{
			if ( Sys.Time > P_Act_Old_Time(N_Act_Use_Plate_Clamp_ON) + P_Act_Delay_Time(N_Act_Use_Plate_Clamp_ON) )		// 동작 딜레이 설정.
			{
				P_Act_Old_Time(N_Act_Use_Plate_Clamp_ON) = Sys.Time;													// 타이머 설정.
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = 2;											// 다음 스텟 머신으로 이동.
			}
		}
		// 2) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) == 2 )
		{
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_Clamp_ON) + P_Act_Time_Out(N_Act_Use_Plate_Clamp_ON) )	// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if ( M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor == 0 && M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor == 0 && M_X_Sepa_Upper_ARC_Stopper_Front_Sensor == 1 && M_X_Sepa_Upper_ARC_Stopper_Rear_Sensor == 1 )	// 완료 상태 확인 후.		
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_Clamp_ON) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = N_Error_Step;							// 애러 스텟 머신으로 이동.
				}
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_Clamp_ON) + P_Act_Time_Out(N_Act_Use_Plate_Clamp_ON) )	// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if ( M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor == 0 && M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor == 0 && M_X_Sepa_Lower_ARC_Stopper_Front_Sensor == 1 && M_X_Sepa_Lower_ARC_Stopper_Rear_Sensor == 1 )	// 완료 상태 확인 후.	
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_Clamp_ON) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) = N_Error_Step;							// 애러 스텟 머신으로 이동.
				}
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) == N_Error_Step )								// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_Use_Plate_Clamp_ON;														// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Use_Plate_Clamp_Popup_Flag = 1;																// 사용 플레이트 클램프 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Upper_Clamp_On_Off_Error, N_High_Alarm_Cycle_Stop);
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Lower_Clamp_On_Off_Error, N_High_Alarm_Cycle_Stop);
			Use_Plate_Clamp_ON_RTN = N_FALSE;																			// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_ON) == N_Complete_Step )							// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Use_Plate_Clamp_ON) = 1;															// 동작 완료 Bit On.
			Use_Plate_Clamp_ON_RTN = N_COMPLETE;																		// 반환값 : COMPLETE
		}
	return

	// 사용 플레이트 클램프 OFF.
	sub:Use_Plate_Clamp_OFF(&Use_Plate_Clamp_OFF_RTN)
		// 0.0) 반환값 초기화.
		Use_Plate_Clamp_OFF_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) == N_Ready_Step )								// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Use_Plate_Clamp_OFF) = Sys.Time;														// 타이머 설정.
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Upper_Stopper_FWD_Sol = 1;																	// 상부 스토퍼 언클램프 (실린더 기준 전진)
				M_Y_Sepa_ARC_Upper_Stopper_BWD_Sol = 0;																	// 상부 스토퍼 언클램프 (실린더 기준 전진)
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = 1;										// 다음 스텟 머신으로 이동.
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Lower_Stopper_FWD_Sol = 1;																	// 하부 스토퍼 언클램프 (실린더 기준 전진)
				M_Y_Sepa_ARC_Lower_Stopper_BWD_Sol = 0;																	// 하부 스토퍼 언클램프 (실린더 기준 전진)
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = 1;										// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 동작 딜레이 설정.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) == 1 )
		{
			if ( Sys.Time > P_Act_Old_Time(N_Act_Use_Plate_Clamp_OFF) + P_Act_Delay_Time(N_Act_Use_Plate_Clamp_OFF) )	// 동작 딜레이 설정.
			{
				P_Act_Old_Time(N_Act_Use_Plate_Clamp_OFF) = Sys.Time;													// 타이머 설정.
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = 2;										// 다음 스텟 머신으로 이동.
			}
		}
		// 2) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) == 2 )
		{
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_Clamp_OFF) + P_Act_Time_Out(N_Act_Use_Plate_Clamp_OFF) )	// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if ( M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor == 1 && M_X_Sepa_Upper_ARC_Stopper_Front_Sensor == 0 && M_X_Sepa_Upper_ARC_Stopper_Rear_Sensor == 0 )	// 완료 상태 확인 후.		
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_Clamp_OFF) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = N_Error_Step;							// 애러 스텟 머신으로 이동.
				}
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_Clamp_OFF) + P_Act_Time_Out(N_Act_Use_Plate_Clamp_OFF) )	// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if ( M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor == 1 && M_X_Sepa_Lower_ARC_Stopper_Front_Sensor == 0 && M_X_Sepa_Lower_ARC_Stopper_Rear_Sensor == 0 )	// 완료 상태 확인 후.	
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_Clamp_OFF) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) = N_Error_Step;							// 애러 스텟 머신으로 이동.
				}
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) == N_Error_Step )								// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_Use_Plate_Clamp_OFF;														// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Use_Plate_Unclamp_Popup_Flag = 1;																// 사용 플레이트 언클램프 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Upper_Clamp_On_Off_Error, N_High_Alarm_Cycle_Stop);
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Lower_Clamp_On_Off_Error, N_High_Alarm_Cycle_Stop);
			Use_Plate_Clamp_OFF_RTN = N_FALSE;																			// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Clamp_OFF) == N_Complete_Step )							// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Use_Plate_Clamp_OFF) = 1;															// 동작 완료 Bit On.
			Use_Plate_Clamp_OFF_RTN = N_COMPLETE;																		// 반환값 : COMPLETE
		}
	return

	// 사용 플레이트 커터 전진. 
	sub:Use_Plate_Cutter_FWD(&Use_Plate_Cutter_FWD_RTN)
		// 0.0) 반환값 초기화.
		Use_Plate_Cutter_FWD_RTN = 0;
		// 222) 동작 실행.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) == N_Ready_Step )								// 진행 준비 완료 일 경우.
		{
			P_Act_Old_Time(N_Act_Use_Plate_Cutter_FWD) = Sys.Time;														// 타이머 설정.
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Upper_Cutting_FWD_Sol = 1;																	// 상부 플레이트 커터 전진. [상부 플레이트 커터 전진]
				M_Y_Sepa_ARC_Upper_Cutting_BWD_Sol = 0;																	// 상부 플레이트 커터 전진. [상부 플레이트 커터 전진]
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = 1;										// 다음 스텟 머신으로 이동.
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				M_Y_Sepa_ARC_Lower_Cutting_FWD_Sol = 1;																	// 하부 플레이트 커터 전진. [하부 플레이트 커터 전진]
				M_Y_Sepa_ARC_Lower_Cutting_BWD_Sol = 0;																	// 하부 플레이트 커터 전진. [하부 플레이트 커터 전진]
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = 1;										// 다음 스텟 머신으로 이동.
			}
		}
		// 1) 동작 딜레이 설정.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) == 1 )
		{
			if ( Sys.Time > P_Act_Old_Time(N_Act_Use_Plate_Cutter_FWD) + P_Act_Delay_Time(N_Act_Use_Plate_Cutter_FWD) )	// 동작 딜레이 설정.
			{
				P_Act_Old_Time(N_Act_Use_Plate_Cutter_FWD) = Sys.Time;													// 타이머 설정.
				P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = 2;										// 다음 스텟 머신으로 이동.
			}
		}
		// 2) 동작 완료 감시. 	
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) == 2 )
		{
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_Cutter_FWD) + P_Act_Time_Out(N_Act_Use_Plate_Cutter_FWD) )// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if ( M_X_Sepa_Upper_ARC_Cutting_FWD_Sensor == 1 && M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor == 0 )		// 완료 상태 확인 후.		
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_Cutter_FWD) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = N_Error_Step;						// 애러 스텟 머신으로 이동.
				}
			}
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
			{
				if( Sys.Time < P_Act_Old_Time(N_Act_Use_Plate_Cutter_FWD) + P_Act_Time_Out(N_Act_Use_Plate_Cutter_FWD) )// 일정 딜레이 시간을 넘기지 않을 경우.
				{
					if ( M_X_Sepa_Lower_ARC_Cutting_FWD_Sensor == 1 && M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor == 0 )		// 완료 상태 확인 후.	
					{
						P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = N_Complete_Step;					// 완료 스텟 머신으로 이동.
					}
				}
				else																									// 일정 딜레이 시간을 넘길 경우.
				{
					P_Module_Act_State_Machine_Error_Array(N_Act_Use_Plate_Cutter_FWD) = P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD);	// Error 버퍼 저장.
					P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) = N_Error_Step;						// 애러 스텟 머신으로 이동.
				}
			}
		}
		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) == N_Error_Step )								// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_Use_Plate_Cutter_FWD;													// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Use_Plate_Cutter_FWD_Popup_Flag = 1;															// 사용 플레이트 커터 전진 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Upper_Cutter_Fwd_Bwd_Error, N_High_Alarm_Cycle_Stop);
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Lower_Cutter_Fwd_Bwd_Error, N_High_Alarm_Cycle_Stop);
			Use_Plate_Cutter_FWD_RTN = N_FALSE;																			// 반환값 : FALSE.
		}
		// 999) 완료.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_FWD) == N_Complete_Step )							// 완료 상태 일 경우.
		{
			P_Act_Complete_Bit(N_Act_Use_Plate_Cutter_FWD) = 1;															// 동작 완료 Bit On.
			Use_Plate_Cutter_FWD_RTN = N_COMPLETE;																		// 반환값 : COMPLETE
		}
	return	

