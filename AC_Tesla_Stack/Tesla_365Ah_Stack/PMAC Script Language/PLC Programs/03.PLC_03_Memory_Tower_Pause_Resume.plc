	if( P_Coord_Down_Check_Bit & CA_2nd_PNP_Z_Coord )														// 양극 2차 PNP Z축 slave 좌표계
	{
		//슬레이브 알람
		P_PMAC_Coord_Error_Status = Coord[39].Status[0];
		P_PMAC_Coord_Down_Num = 39;
		call Alarm.Insert_Alarm(N_Alarm_Cathode_2nd_PNP_Z_Slave_Motion_Prog_Down, N_High_Alarm_Emergency_Stop);
//		M_Cathode_2nd_PNP_Z_Slave_Motion_Prog_Down_Alarm = 1;
		P_PMAC_Commands = F_Command_Abort
	}

	if( P_Coord_Down_Check_Bit & CA_1st_PNP_Z_Coord )														// 양극 1차 PNP Z축 slave 좌표계
	{
		//슬레이브 알람
		P_PMAC_Coord_Error_Status = Coord[40].Status[0];
		P_PMAC_Coord_Down_Num = 40;
		call Alarm.Insert_Alarm(N_Alarm_Cathode_1st_PNP_Z_Slave_Motion_Prog_Down, N_High_Alarm_Emergency_Stop);
//		M_Cathode_1st_PNP_Z_Slave_Motion_Prog_Down_Alarm = 1;
		P_PMAC_Commands = F_Command_Abort
	}
	P_PMAC_Coord_Down_Inspection_Flag = 0;																// 감시 플래그 off 
	P_Coord_Motion_Prog_Down_Entering_Bit = 0;															// 재진입 방지 변수 off
}

//==================================================================================================================
// P&P Abort 적용 프로그램 [25.07.04 추가]		[ 참조 : 25.07.04 모션 중 P&P AbortTa,Ts 적용 ]
//==================================================================================================================
if ( P_PNP_Abort_Use_Bit == 1 )					// PNP Abort Flag ON 일 경우.
	call PNP_Abort_Time.Abort_Apply();			// PNP Abort 적용.


// [참조: 260114 Pause 에러 관련 보완 프로그램 추가]
if( P_Pause_Err_Use2 == 1 )
{
	if( P_PMAC_Status != F_Status_STARTING )	// Starting에서 거는 pause는 Sync가 망가진 마스터 트리거를 맞추는 작업이라 err로 빼지 않고 상대방이 pause가 걸릴 때 까지 대기
	{
		// 극판 미공급으로 퍼즈 완료 상태
		if( ( M_Y_Pause_Cathode_Signal == 1 || M_Y_Pause_Anode_Signal == 1 ) && M_Y_Pause_Status_Complete_Signal == 1 )
		{
			if ( P_PMAC_Status == F_Status_EXECUTE && P_Sepa_To_Normal_Mode_Sync_Err_Avoid == 1 )		// Execute상태에 Err 코드 피하는 변수가 1일 경우.	[ 참조 : 26.07.31 Pause_Resume 수정 ]
			{}
			else
			{
				// 마스터 트리거 44 또는 89 일 땐 pause가 걸려야 하는 상황에서 이미 M_X_Pause_Ack_Signal가 0이여야함
				// 극판 미공급이 되었고 M_X_Pause_Ack_Signal가 1이면 반대열이 Pause 신호를 못 받았거나 못처리한 경우로 스탑
				// pause가 걸린 상태에서 반대편 열 pause가 걸려있지 않으면 pause process 실행
				if( P_Master_Motion_Trigger == 44 || P_Master_Motion_Trigger == 89)
				{
					// 반대열 마스터
					if( M_X_Opposite_Resume_Not_Free == 1 && P_Opposite_Lane_P_PMAC_Status != F_Status_STARTING )
					{
						if( M_X_Pause_Status_Complete_Signal == 0 && P_Pause_Err_Process == 0 )
						{
							P_Pause_Err_Timer = 0
							P_Pause_Err_Process = 1
						}
					}
				}
			}
		}
	}


	if( P_Pause_Err_Process == 1 )
	{
		P_Pause_Err_Timer = 0
		P_Pause_Err_Process++
	}

	if( P_Pause_Err_Process == 2 )
	{
		// 50ms 뒤에도 상대편 퍼즈가 안걸린다면 예외 처리
		if( P_Pause_Err_Timer > 50  )
		{
			if( M_X_Pause_Status_Complete_Signal == 0 )
			{
				P_Pause_Err_Process++
			}		
			else
			{
				P_Pause_Err_Process = 0
			}
		}
	}

	if( P_Pause_Err_Process == 3 )
	{		
		P_Current_Mode = 0
		P_Execute_Manage_Mode = 0;
		P_Cathode_Cur_Mode = 0
		
		// 런모드 배열 모드 초기화
		P_Slave1_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave2_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
		P_Slave3_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave4_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave5_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave6_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave7_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave8_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave9_Cathode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
		P_Slave10_Cathode_Run_Motion_Array(0),100,1 = 0;
		P_Slave16_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
		P_Slave17_Cathode_Run_Motion_Array(0),100,1 = 0;	//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
		P_Slave18_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
		P_Slave19_Cathode_Run_Motion_Array(0),100,1 = 0;	//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]

		// 런모드 배열 모두 초기화
		P_Slave1_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave2_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
		P_Slave3_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave4_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave5_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave6_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave7_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave8_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave9_Anode_Run_Motion_Array(0),100,1 = 0;		//	[ 참조 : 25.09.15 Picker T축 모션 배열 추가 ]
		P_Slave10_Anode_Run_Motion_Array(0),100,1 = 0;
		P_Slave16_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 1차 Z 		// [ 참 조 : 2025.11.24 Z축 분리 ]
		P_Slave17_Anode_Run_Motion_Array(0),100,1 = 0;		//	음극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
		P_Slave18_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 2차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]
		P_Slave19_Anode_Run_Motion_Array(0),100,1 = 0;		//	양극 1차 Z		// [ 참 조 : 2025.11.24 Z축 분리 ]

		// 1차 PNP 대기위치 이동
		P_Slave10_Motion_Command = N_1st_PNP_Ready_Pos_Motion
		P_Slave1_Motion_Command = N_1st_PNP_Ready_Pos_Motion
	
		P_Pause_Err_Timer = 0

		P_Pause_Err_Process++
	}
	
	if( P_Pause_Err_Process == 2 )
	{
		if( P_Pause_Err_Timer > 30 )
		{
			call Alarm.Insert_Alarm(N_Alarm_Opposite_Lane_Pause_IO_Err, N_High_Alarm_Cycle_Stop);
			// 알람 비활성화로 임시로 커맨드 실행, 알람 활성화 후 삭제 필요
			P_PMAC_Commands = F_Command_Stop;								
			P_Stop_Cmd_Origin = 42
			
			P_Pause_Err_Count++
			P_Pause_Err_Process = 0
		}
	}
}



P_MNTR_PLC3_Task_Time(1) = (Sys.Time - P_MNTR_PLC3_Task_Time(0))*N_Task_Scale;
if ( P_MNTR_PLC3_Task_Time(1) > P_MNTR_PLC3_Task_Max_Time )
{
	P_MNTR_PLC3_Task_Max_Time = P_MNTR_PLC3_Task_Time(1);
}
close