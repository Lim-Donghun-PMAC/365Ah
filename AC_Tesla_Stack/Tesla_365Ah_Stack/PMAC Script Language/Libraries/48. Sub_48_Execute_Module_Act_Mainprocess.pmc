			P_Module_Act_Execute_State_Machine_Array(N_Act_EPC_Judge) = N_Ready_Step;								// 스텝 머신 실행.
		}	

		L_Subprog_Act_EXECUTE_EPC_Judge = 0;																		// 반환값 초기화.
		call Subprog_Subprocess_Execute_Act_Module.EPC_Judge(&L_Subprog_Act_EXECUTE_EPC_Judge);						// 실행 함수 호출.
		IF ( L_Subprog_Act_EXECUTE_EPC_Judge == N_COMPLETE )														// 실행 함수 호출 완료 되었을 경우.
