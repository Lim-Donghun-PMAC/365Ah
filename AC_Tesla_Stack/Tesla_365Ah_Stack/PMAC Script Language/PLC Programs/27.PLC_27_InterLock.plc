				//================================ 4번위치 - 얼라인 상승 ================================
					// ↓ 음극 NG PNP T축 !~ 얼라인 위치	음극 NG PNP Z축 얼라인 상승
					if(!(P_Motor_Current_Pos(N_NG_PnP_AN_T) ~ P_Recipe_M43_POS(2)) || P_Motor_Current_Pos(N_NG_PnP_AN_Z) ~ P_Recipe_M45_POS(3))		
						P_No3_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;
					else
						P_No3_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 0;
				//================================ 5번위치 - 얼라인 하강 ================================
					// ↓ 음극 NG PNP T축 !~ 얼라인 위치	음극 NG PNP Z축 얼라인 하강
					if(!(P_Motor_Current_Pos(N_NG_PnP_AN_T) ~ P_Recipe_M43_POS(2)) || P_Motor_Current_Pos(N_NG_PnP_AN_Z) ~ P_Recipe_M45_POS(4))		
						P_No4_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;
					else
						P_No4_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No5_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;
					P_No6_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;
					P_No7_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;		// 인터락
				}
				else 
				{
					P_No1_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;		    // 인터락
					P_No2_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;		    // 인터락
					P_No3_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;		    // 인터락
					P_No7_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_NG_PnP_AN_Z) = 1;		// 인터락
				}
			break;

			case N_UNLOADER_X:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			//================================ 1번위치 - 대기 위치 ================================
				// ↓ 언로더 X축 대기 위치 || 양극 2차 PNP T축 > 대기 위치 + 30º || 양극 NG PNP T축 ~ 대기 위치
				if(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(1) || (P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(1) + 20) || !(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1)) )		
					P_No1_Recipe_Pos_IL(N_UNLOADER_X) = 1;
				else
					P_No1_Recipe_Pos_IL(N_UNLOADER_X) = 0;
			//================================ 2번위치 - 스텍 진입 1차 위치 ================================
				// ↓ 언로더 X축 스택 진입 1차 위치 || 양극 2차 PNP T축 !~ 대기 위치 || 파이널 롤 X축 > 음극 위치 || 얼로더 T축 !~ 대기 위치 || 언로더 Z축 !~ 상승 위치
				if(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(2) || !(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || !(P_Motor_Current_Pos(N_FINAL_ROLL_X) <= P_Recipe_M12_POS(2)))		
					P_No2_Recipe_Pos_IL(N_UNLOADER_X) = 1;
				else
					P_No2_Recipe_Pos_IL(N_UNLOADER_X) = 0;
			//================================ 3번위치 - 스텍 진입 2차 위치 ================================
				// ↓ 언로더 X축 스택 진입 2차 위치 || 양극 2차 PNP T축 !~ 대기 위치 || 파이널 롤 X축 > 음극 위치
				if(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(3) || !(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || !(P_Motor_Current_Pos(N_FINAL_ROLL_X) <= P_Recipe_M12_POS(2)) || !(P_Motor_Current_Pos(N_UNLOADER_T) ~ P_Recipe_M48_POS(2)) || !(P_Motor_Current_Pos(N_UNLOADER_Z) ~ P_Recipe_M47_POS(2)))		
					P_No3_Recipe_Pos_IL(N_UNLOADER_X) = 1;
				else
					P_No3_Recipe_Pos_IL(N_UNLOADER_X) = 0;
			//================================ 4번위치 - 후진 위치 ================================
				// ↓ 언로더 X축 후진 위치 || 양극 2차 PNP T축 !~ 대기 위치 || 파이널 롤 X축 > 음극 위치 || 얼로더 T축 !~ 대기 위치 || 언로더 Z축 !~ 상승 위치 || 양극 NG PNP T축 !~ 대기 위치
//				if(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(4) || !(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || !(P_Motor_Current_Pos(N_UNLOADER_T) ~ P_Recipe_M48_POS(2)) || !(P_Motor_Current_Pos(N_UNLOADER_Z) ~ P_Recipe_M47_POS(2)) || !(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1)))		
//					P_No4_Recipe_Pos_IL(N_UNLOADER_X) = 1;
//				else
//					P_No4_Recipe_Pos_IL(N_UNLOADER_X) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No5_Recipe_Pos_IL(N_UNLOADER_X) = 1;
					P_No6_Recipe_Pos_IL(N_UNLOADER_X) = 1;
					P_No7_Recipe_Pos_IL(N_UNLOADER_X) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_UNLOADER_X) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_UNLOADER_X) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_UNLOADER_X) = 1;			// 인터락
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page); // FR Z축이랑 확인. 
				// << 중요!!! 절대 위치를 Stack Table로 맞추어서 마이너스 기준을 >>
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
				{
					// 
					P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(2);
		
				}
				else if(P_IL_Outer_Status == N_IL_Upper_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<Ca 2nd PNP>> ==================================//	
					P_Plus_IL_Offset = P_Unloader_X_Plus_IL_Offset(0);
					//if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 45 )
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(0) + 45 )				// 양극 2차 PNP가 대기 위치 + 45도 이상에 있을 경우.
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(3) - P_Motor_Current_Pos(N_UNLOADER_X) + P_Recipe_M12_POS(2) - (P_2nd_PNP_Arm_Radius * cosd(P_Motor_Current_Pos(N_2nd_PnP_CA_T))) + P_Plus_IL_Offset;
						//P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(2) + P_Plus_IL_Offset;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;
					}
				// ================================ 마이너스 간섭 요인 : <<없음>> ==================================//	
				}
				else if(P_IL_Outer_Status == N_IL_Stack_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<Main Z, Final Roller, Ca 2nd PNP>> ==================================//	
					//if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 70 )
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(0) + 70 )				// 양극 2차 PNP가 대기 위치 + 70도 이상에 있을 경우.
					{// 2차가 70도 초과위치에 있으면 플러스 간섭요인에 2차 추가.
						P_Plus_IL_Offset = P_Unloader_X_Plus_IL_Offset(0);							// Offset value : -50
						P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(3) - P_Motor_Current_Pos(N_UNLOADER_X) + P_Recipe_M12_POS(2) - (P_2nd_PNP_Arm_Radius * cosd(P_Motor_Current_Pos(N_2nd_PnP_CA_T))) + P_Plus_IL_Offset;
						//P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(3) + P_Plus_IL_Offset;			// 스텍 진입 티칭 위치가지 진입 가능.
					}
					else
					{
						if(P_Motor_Current_Pos(N_MAIN_Z) <= 0.5)
						{// Main Z가 애초에 높으면 못들어오게해야함. 스텍 실린더 io추가해야할수도
							if(P_Motor_Current_Pos(N_FINAL_ROLL_X) <= P_Recipe_M12_POS(2) )
							{// 파이널롤 음극 적층 위치
								P_Plus_IL_Offset = P_Unloader_X_Plus_IL_Offset(1);					// Offset value : -5
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(3) + P_Plus_IL_Offset;	// 스텍 진입 티칭 위치가지 진입 가능.
							}
							else if(P_Motor_Current_Pos(N_FINAL_ROLL_X) > 0)
							{
								P_Plus_IL_Offset = P_Unloader_X_Plus_IL_Offset(2);					// Offset value : -200
								P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(3) + P_Recipe_M12_POS(2) + P_Plus_IL_Offset;
							}
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_X;
						}
						else
						{
							P_Plus_IL_Offset = P_Unloader_X_Plus_IL_Offset(3);						// Offset value : 0
							P_Limit_PosData(Hex_IL_Plus) = P_Recipe_M46_POS(2) + P_Plus_IL_Offset;
							P_Collision_Risk_Motor(Hex_IL_Plus) = N_MAIN_Z;
						}
					}
				// ================================ 마이너스 간섭 요인 : <<Ca 2nd PNP, NG PNP>> ==================================//	
					// 2차가 15도 미만 상태면, 마이너스 간섭요인으로 판단 
					//if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 13 || P_Motor_Current_Pos(N_NG_PnP_CA_T) > 30 )		//2차, NG PNP가 30도 초과되어있으면
					//if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 20 && P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 13 || P_Motor_Current_Pos(N_NG_PnP_CA_T) > 20 )		//2차, NG PNP가 30도 초과되어있으면
					if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) < P_Recipe_M03_POS(0) + 20 && P_Motor_Current_Pos(N_2nd_PnP_CA_T) > P_Recipe_M03_POS(0) + 13 || P_Motor_Current_Pos(N_NG_PnP_CA_T) >  P_Recipe_M42_POS(0) + 20 )		// 2차 PNP가 대기 위치 + 13 ~ 20이거나 NG PNP T축이 대기위치 + 20 일 경우.
					{
						P_Minus_IL_Offset = P_Unloader_X_Minus_IL_Offset(0);						// Offset value : 330
						// 수정포인트 언로더 X축떄문에 마이너스 증가함.
						//P_Limit_PosData(Hex_IL_Minus) = P_Motor_Current_Pos(N_UNLOADER_X) + P_Minus_IL_Offset;		// 아예 못나오게 우선 함.
						P_Limit_PosData(Hex_IL_Minus) = P_Minus_IL_Offset;		// 아예 못나오게 우선 함.
						
						if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 13)
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_2nd_PnP_CA_T;
						else
							P_Collision_Risk_Motor(Hex_IL_Minus) = N_NG_PnP_CA_T;
					}
				}

			break;

			case N_UNLOADER_Z:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
			//================================ 1번위치 - Z축 대기/하강 위치 ================================
				// ↓ 언로더 Z축 대기/하강 위치 || 언로더 X축 !~ 대기 위치
				if(P_Motor_Current_Pos(N_UNLOADER_Z) ~ P_Recipe_M47_POS(1) || !(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(1)))		
					P_No1_Recipe_Pos_IL(N_UNLOADER_Z) = 1;
				else
					P_No1_Recipe_Pos_IL(N_UNLOADER_Z) = 0;
			//================================ 2번위치 - Z축 스텍 진입 상승 위치 ================================
				// ↓ 언로더 Z축 스택 진입 상승 위치 || 언로더 X축 !~ 대기 위치 || 양극 2차 PNP T축 ~! 대기 위치 || 양극 NG PNP T축 !~ 대기 위치
				if(P_Motor_Current_Pos(N_UNLOADER_Z) ~ P_Recipe_M47_POS(2) || !(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || !(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1)) || !(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(1)))		
					P_No2_Recipe_Pos_IL(N_UNLOADER_Z) = 1;
				else
					P_No2_Recipe_Pos_IL(N_UNLOADER_Z) = 0;
			//================================ 3번위치 - Spare ================================
			//================================ 4번위치 - Z축 그립 전 상승 위치 ================================
				// ↓ 언로더 Z축 그립 전 상승 위치 || 언로더 X축 !~ 스택 위치
				if(P_Motor_Current_Pos(N_UNLOADER_Z) ~ P_Recipe_M47_POS(4) || !(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(3)))		
					P_No4_Recipe_Pos_IL(N_UNLOADER_Z) = 1;
				else
					P_No4_Recipe_Pos_IL(N_UNLOADER_Z) = 0;
			//================================ 5번위치 - Z축 그립 후 상승 위치 ================================
				// ↓ 언로더 Z축 그립 후 상승 위치 || 언로더 X축 !~ 스택 위치 || 양극 2차 PNP T축 ~! 대기 위치 || 양극 NG PNP T축 !~ 대기 위치
				if(P_Motor_Current_Pos(N_UNLOADER_Z) ~ P_Recipe_M47_POS(5) || !(P_Motor_Current_Pos(N_2nd_PnP_CA_T) ~ P_Recipe_M03_POS(1)) || !(P_Motor_Current_Pos(N_NG_PnP_CA_T) ~ P_Recipe_M42_POS(1)) || !(P_Motor_Current_Pos(N_UNLOADER_X) ~ P_Recipe_M46_POS(3)))		
					P_No5_Recipe_Pos_IL(N_UNLOADER_Z) = 1;
				else
					P_No5_Recipe_Pos_IL(N_UNLOADER_Z) = 0;
				//================================ 미사용 위치 인터락 ===========================================
					P_No6_Recipe_Pos_IL(N_UNLOADER_Z) = 1;
					P_No7_Recipe_Pos_IL(N_UNLOADER_Z) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_UNLOADER_Z) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_UNLOADER_Z) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_UNLOADER_Z) = 1;			// 인터락
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Jog, ABS, INC Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page) * -1;		// unloader 절대위치 변환.
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<Ca 2nd pnp, Ca NG PNP>> ==================================//	
					//if(P_Motor_Current_Pos(N_2nd_PnP_CA_T) > 30 && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < 70 )
					// [ 참조 : 26.10.02 인터락 조건 추가 ]
					if( P_Recipe_M03_POS(1) + 20 < P_Motor_Current_Pos(N_2nd_PnP_CA_T) && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < P_Recipe_M03_POS(2) - 10 )
					{ // 양극 2차 PNP가 언로더 위에 있을 경우 → 언로더 Z축 구동 불가.
						P_Plus_IL_Offset = P_Unloader_Z_Plus_IL_Offset(0);						// Offset value : -70
						P_Limit_PosData(Hex_IL_Plus) = 0 + P_Plus_IL_Offset;					// 언로더 Z축이 Offset 이상으로 올라가지 못함 (절대 위치 변환을 위한 부호 반대)
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;
					}
					else if( P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 30 &&P_Motor_Current_Pos(N_NG_PnP_CA_T) < P_Recipe_M42_POS(1) + 70 )
					{
						P_Plus_IL_Offset = P_Unloader_Z_Plus_IL_Offset(1);						// Offset value : -55
						P_Limit_PosData(Hex_IL_Plus) = 0 + P_Plus_IL_Offset;					// 언로더 Z축이 Offset 이상으로 올라가지 못함 (절대 위치 변환을 위한 부호 반대)
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_NG_PnP_CA_T;
					}
				// ================================ 마이너스 간섭 요인 : <<없음>> ==================================//	
				}
				else if(P_IL_Outer_Status == N_IL_Upper_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<Ca 2nd pnp, Ca NG PNP>> ==================================//	
					// [ 참조 : 26.10.02 인터락 조건 추가 ]
					if( P_Recipe_M03_POS(1) + 20 < P_Motor_Current_Pos(N_2nd_PnP_CA_T) && P_Motor_Current_Pos(N_2nd_PnP_CA_T) < P_Recipe_M03_POS(2) - 10 )
					{ // 양극 2차 PNP가 언로더 위에 있을 경우 → 언로더 Z축 구동 불가.
						P_Plus_IL_Offset = P_Unloader_Z_Plus_IL_Offset(0);						// Offset value : -70
						P_Limit_PosData(Hex_IL_Plus) = 0 + P_Plus_IL_Offset;					// 언로더 Z축이 Offset 이상으로 올라가지 못함 (절대 위치 변환을 위한 부호 반대)
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_CA_T;
					}
					else if( P_Motor_Current_Pos(N_NG_PnP_CA_T) > P_Recipe_M42_POS(1) + 15 &&P_Motor_Current_Pos(N_NG_PnP_CA_T) < P_Recipe_M42_POS(1) + 70 )
					{
						P_Plus_IL_Offset = P_Unloader_Z_Plus_IL_Offset(1);						// Offset value : -55
						P_Limit_PosData(Hex_IL_Plus) = 0 + P_Plus_IL_Offset;					// 언로더 Z축이 Offset 이상으로 올라가지 못함 (절대 위치 변환을 위한 부호 반대)
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_NG_PnP_CA_T;
					}
				// ================================ 마이너스 간섭 요인 : <<없음>> ==================================//	
				}
				else if(P_IL_Outer_Status == N_IL_Stack_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<없음>> ==================================//	
				// ================================ 마이너스 간섭 요인 : <<Main Z>> ==================================//	
					if(P_Motor_Current_Pos(P_IL_Motor_Page) > 250 )								// ← 조건 확인 필요.
