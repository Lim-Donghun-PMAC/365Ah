global P_Unwinder_Jog_Total_Time = ceil((230/233)*(233-70));	// 조그 이동 시간 = (CamTable 진행 시간 / CamTable 수) * (CamTable 수 - CamTable 활성화 시점))
global P_Unwinder_Ta = 31;							// 거리, 총 시간으로 TM을 구함 → 전체 시간 - TM = TA + TS → TA, TS를 반으로 나눈 후 서로 차이가 5정도 나도록 구함.
global P_Unwinder_Ts = 26;							// 거리, 총 시간으로 TM을 구함 → 전체 시간 - TM = TA + TS → TA, TS를 반으로 나눈 후 서로 차이가 5정도 나도록 구함.
global P_Unwinder_Tm = P_Unwinder_Jog_Total_Time - (P_Unwinder_Ta + P_Unwinder_Ts);	// 조그 이동 TM 시간.
