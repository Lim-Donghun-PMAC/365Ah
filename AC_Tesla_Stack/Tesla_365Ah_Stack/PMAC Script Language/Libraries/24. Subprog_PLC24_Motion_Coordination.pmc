// 프로그램 개정이력
//======================================================================================================
// 25.06.04 김형진 책임
// Motion Coordination - [ 참조 : 25.06.04 모션 조정 신규 추가 ]  
// [ 참조 : 25.07.02 ARC 요구 플래그 조건 수정 ] ->Spool Motor 넘버 교체 

open subprog System_Module(void)

sub: Master_Following_Sequence_Module(void)
local L_Spool_Num = P_Selected_Spool_Number;
	// 마스터 팔로잉 ON, OFF 모듈
if( P_System_Master_Following_ON_Status == F_Status_STARTING )									// 스타팅 상태라면
{
	P_System_Master_Following_ON_Status = F_Status_EXECUTE;										// 생산 상태로 변경
	P_System_Master_Follwing_ON_State_Machine = 1;												// 스텟머신 시작.
}

if( P_Driving_Motor_Use_Flag == 1 )																// 드라이빙 모터를 사용 하게 된다면
{
	if( P_System_Master_Following_ON_Status == F_Status_EXECUTE )
	{
		switch( P_System_Master_Follwing_ON_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:
				if( P_Motor_Current_Pos(N_DRIVING_ROLL) ~ 0 || P_Module_Act_State_Machine_Array(N_Act_ARC_Post_Act) == 1 )	// 드라이빙 모터가 홈이 잡혀있어야 모듈 가능하게 걸어두자 or ARC 중 넘어왔다면
				{
					if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
					{
						Motor[L_Spool_Num].pMasterEnc = EncTable[N_DRIVING_ROLL].a;							// 드라이빙 엔코더 대입
						Motor[L_Spool_Num].SlewMasterPosSf = 0.1								// 마스터 스케일펙터 슬루 변수
						Motor[L_Spool_Num].MasterPosSf = P_Driving_Circumference / P_PLC06_Spool_Circumference;				// 거리값 / Spool 외경
						Motor[L_Spool_Num].MasterCtrl = 1;										// 추종 시작 
						P_System_Master_Follwing_ON_State_Machine++;
					}
					else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
					{
						Motor[L_Spool_Num].pMasterEnc = EncTable[N_DRIVING_ROLL].a;							// 드라이빙 엔코더 대입
						Motor[L_Spool_Num].SlewMasterPosSf = 0.1									// 마스터 스케일펙터 슬루 변수
						Motor[L_Spool_Num].MasterPosSf = P_Driving_Circumference / P_PLC06_Spool_Circumference;				// 거리값 / Spool 외경
						Motor[L_Spool_Num].MasterCtrl = 1;										// 추종 시작 
						P_System_Master_Follwing_ON_State_Machine++;
					}
				}
			break;

			case 2:
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
				{
					if( Motor[L_Spool_Num].MasterCtrl == 1 )
					{
						P_System_Master_Following_ON_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_ON_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_ON_Complete_Flag = 1;								// 컴플리트 신호 On
					}
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
				{
					if( Motor[L_Spool_Num].MasterCtrl == 1 )
					{
						P_System_Master_Following_ON_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_ON_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_ON_Complete_Flag = 1;							// 컴플리트 신호 On
					}
				}
			break;
		}
	}
}
else				// 드라이빙 모터를 사용 안하고, 가상축 CamTable Motor 의한 마스터 팔로잉을 해야 한다면
{
	if( P_System_Master_Following_ON_Status == F_Status_EXECUTE )
	{
		switch( P_System_Master_Follwing_ON_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:
				if( P_Motor_Current_Pos(N_DRIVING_ROLL) ~ 0 || P_Module_Act_State_Machine_Array(N_Act_ARC_Post_Act) == 1 )	// 드라이빙 모터가 홈이 잡혀있어야 모듈 가능하게 걸어두자 or ARC 중 넘어왔다면
				{
					if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
					{
						Motor[L_Spool_Num].pMasterEnc = EncTable[N_DRIVING_ROLL].a;							// 드라이빙 엔코더 대입
						Motor[L_Spool_Num].SlewMasterPosSf = 0.1								// 마스터 스케일펙터 슬루 변수
						Motor[L_Spool_Num].MasterPosSf = 1 / P_PLC06_Spool_Circumference;				// 거리값 / Spool 외경
						Motor[L_Spool_Num].MasterCtrl = 1;										// 추종 시작 
						P_System_Master_Follwing_ON_State_Machine++;
					}
					else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
					{
						Motor[L_Spool_Num].pMasterEnc = EncTable[N_DRIVING_ROLL].a;							// 드라이빙 엔코더 대입
						Motor[L_Spool_Num].SlewMasterPosSf = 0.1								// 마스터 스케일펙터 슬루 변수
						Motor[L_Spool_Num].MasterPosSf = 1 / P_PLC06_Spool_Circumference;				// 거리값 / Spool 외경
						Motor[L_Spool_Num].MasterCtrl = 1;										// 추종 시작 
						P_System_Master_Follwing_ON_State_Machine++;
					}
				}
			break;

			case 2:
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
				{
					if( Motor[L_Spool_Num].MasterCtrl == 1 )
					{
						P_System_Master_Following_ON_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_ON_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_ON_Complete_Flag = 1;							// 컴플리트 신호 On
					}
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
				{
					if( Motor[L_Spool_Num].MasterCtrl == 1 )
					{
						P_System_Master_Following_ON_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_ON_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_ON_Complete_Flag = 1;							// 컴플리트 신호 On
					}
				}
			break;
		}
	}
}

return;

sub: Master_Following_Sequence_Off_Module(void)
local L_Spool_Num = P_Selected_Spool_Number;
if( P_System_Master_Following_OFF_Status == F_Status_STARTING )									// 스타팅 상태라면
{
	P_System_Master_Following_OFF_Status = F_Status_EXECUTE;									// 생산 상태로 변경
	P_System_Master_Follwing_OFF_State_Machine = 1;												// 스텟머신 시작.
}

if( P_Driving_Motor_Use_Flag == 1 )																// 드라이빙 모터를 사용 하게 된다면
{
	if( P_System_Master_Following_OFF_Status == F_Status_EXECUTE )
	{
		switch( P_System_Master_Follwing_OFF_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:		// 모터 확인
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
				{
					Motor[L_Spool_Num].MasterCtrl = 0;	
					P_System_Master_Follwing_OFF_State_Machine++;
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )						// 하부 모터인지
				{
					Motor[L_Spool_Num].MasterCtrl = 0;	
					P_System_Master_Follwing_OFF_State_Machine++;
				}
			break;
	

			case 2:
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
				{
					if( Motor[L_Spool_Num].MasterCtrl == 0 )
					{
						P_System_Master_Following_OFF_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_OFF_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_OFF_Complete_Flag = 1;						// 컴플리트 신호 On
					}
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )						// 하부 모터인지
				{
					if( Motor[L_Spool_Num].MasterCtrl == 0 )
					{
						P_System_Master_Following_OFF_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_OFF_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_OFF_Complete_Flag = 1;						// 컴플리트 신호 On
					}
				}
			break;
		}
	}
}
else				// 드라이빙 모터를 사용 안하고, 가상축 CamTable Motor 의한 마스터 팔로잉을 해야 한다면
{
	if( P_System_Master_Following_OFF_Status == F_Status_EXECUTE )
	{
		switch( P_System_Master_Follwing_OFF_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:		// 모터 확인
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
				{
					Motor[L_Spool_Num].MasterCtrl = 0;	
					P_System_Master_Follwing_OFF_State_Machine++;
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )						// 하부 모터인지
				{
					Motor[L_Spool_Num].MasterCtrl = 0;	
					P_System_Master_Follwing_OFF_State_Machine++;
				}
			break;
	

			case 2:
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							// 상부 모터인지
				{
					if( Motor[L_Spool_Num].MasterCtrl == 0 )
					{
						P_System_Master_Following_OFF_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_OFF_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_OFF_Complete_Flag = 1;						// 컴플리트 신호 On
					}
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )						// 하부 모터인지
				{
					if( Motor[L_Spool_Num].MasterCtrl == 0 )
					{
						P_System_Master_Following_OFF_Status = F_Status_Nonseatus;				// 상태 초기화
						P_System_Master_Follwing_OFF_State_Machine = 0;							// 스텟머신 초기화
						P_System_Master_Following_OFF_Complete_Flag = 1;						// 컴플리트 신호 On
					}
				}
			break;
		}
	}
}

return;

sub: Sepa_Line_Speed_CamTable_On(void)

if( P_System_CamTable_ON_Status == F_Status_STARTING )
{
	P_System_CamTable_ON_Status = F_Status_EXECUTE;
	P_System_CamTable_ON_State_Machine = 1;
}

if( P_Driving_Motor_Use_Flag == 1 )													// 드라이빙 모터를 사용 하게 된다면
{
	if( P_System_CamTable_ON_Status == F_Status_EXECUTE )
	{
		switch( P_System_CamTable_ON_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:	// 소스 모터 타겟 모터 Servo On
				CMD"#%d j/",N_DRIVING_ROLL;
				CMD"#%d j/",N_SUB_FEEDING_ROLL;
				CMD"#%d j/",61;
				P_System_CamTable_ON_State_Machine++;
			break;
	
			case 2:
				CamTable[N_Feed_Cam_Num].enable = N_TRUE;							// 드라이빙 모터 캠테이블 on
				CamTable[N_Driving_Cam_Num].enable = N_TRUE;						// 피딩롤 모터 캠테이블 on
				P_System_CamTable_ON_State_Machine++;
			break;

			case 3:
				if( CamTable[N_Feed_Cam_Num].enable == N_TRUE && CamTable[N_Driving_Cam_Num].enable == N_TRUE )
				{
					P_System_CamTable_ON_Status = F_Status_Nonseatus;				// 상태 초기화
					P_System_CamTable_ON_State_Machine = 0;							// 스텟머신 초기화
					P_System_CamTable_ON_Complete_Flag = 1;							// 컴플리트 
				}
			break;
		}
	}
}
else				// 드라이빙 모터를 사용 안하고, 가상축 CamTable Motor 의한 마스터 팔로잉을 해야 한다면
{
	if( P_System_CamTable_ON_Status == F_Status_EXECUTE )
	{
		switch( P_System_CamTable_ON_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:	// 소스 모터 타겟 모터 Servo On
				CMD"#%d j/",60;
				CMD"#%d j/",61;
				P_System_CamTable_ON_State_Machine++;
			break;
	
			case 2:
				CamTable[N_LineVel_Cam_Num].enable = 1;												// 가상축 모터 캠테이블 on
				P_System_CamTable_ON_State_Machine++;
			break;

			case 3:
				if( CamTable[N_LineVel_Cam_Num].enable == 1 )
				{
					P_System_CamTable_ON_Status = F_Status_Nonseatus;				// 상태 초기화
					P_System_CamTable_ON_State_Machine = 0;							// 스텟머신 초기화
					P_System_CamTable_ON_Complete_Flag = 1;							// 컴플리트 
				}
			break;
		}
	}
}
return;

sub: Sepa_Line_Speed_CamTable_Off(void)

if( P_System_CamTable_OFF_Status == F_Status_STARTING )
{
	P_System_CamTable_OFF_Status = F_Status_EXECUTE;
	P_System_CamTable_OFF_State_Machine = 1;
}

if( P_Driving_Motor_Use_Flag == 1 )													// 드라이빙 모터를 사용 하게 된다면
{
	if( P_System_CamTable_OFF_Status == F_Status_EXECUTE )
	{
		switch( P_System_CamTable_OFF_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:	// 캠테이블 off
				CamTable[N_Feed_Cam_Num].enable = 0;								// 드라이빙 모터 캠테이블 off
				CamTable[N_Driving_Cam_Num].enable = 0;								// 피딩롤 모터 캠테이블 off
				P_System_CamTable_OFF_State_Machine++;
			break;
	
			case 2:	// 소스모터 kill
				if( CamTable[N_Feed_Cam_Num].enable == 0 && CamTable[N_Driving_Cam_Num].enable == 0 )
				{
					kill 60;
					P_System_CamTable_OFF_Status = F_Status_Nonseatus;				// 상태 초기화
					P_System_CamTable_OFF_State_Machine = 0;						// 스텟머신 초기화
					P_System_CamTable_OFF_Complete_Flag = 1;						// 컴플리트 
				}
				
			break;

		}
	}
}
else				// 드라이빙 모터를 사용 안하고, 가상축 CamTable Motor 의한 마스터 팔로잉을 해야 한다면
{
	if( P_System_CamTable_OFF_Status == F_Status_EXECUTE )
	{
		switch( P_System_CamTable_OFF_State_Machine )
		{
			case 0:	//idle
			break;
	
			case 1:	// 캠테이블 off
				CamTable[N_LineVel_Cam_Num].enable = 0;								//  가상축 모터 캠테이블 off		
				P_System_CamTable_OFF_State_Machine++;
			break;
	
			case 2:	// 소스모터 kill 가상축 모터 kill
				if( CamTable[N_LineVel_Cam_Num].enable == 0 )
				{
					kill 60,61;
					P_System_CamTable_OFF_Status = F_Status_Nonseatus;				// 상태 초기화
					P_System_CamTable_OFF_State_Machine = 0;						// 스텟머신 초기화
					P_System_CamTable_OFF_Complete_Flag = 1;						// 컴플리트 
				}	
			break;
		}
	}
}
return;


sub: Servo_Dancer_Cascading_Set(void)

if( P_System_Cascading_ON_Status == F_Status_STARTING )
{
	P_System_Cascading_ON_Status = F_Status_EXECUTE;
	P_System_Cascading_ON_State_Machine = 1;	
}

if( P_System_Cascading_ON_Status == F_Status_EXECUTE )
{
	switch( P_System_Cascading_ON_State_Machine )
	{
		case 0:	// IDLE
		break;

		case 1:	//토크모드 변경
			if( Motor[N_SERVO_DANCER].AmpEna == 1 && Motor[N_SERVO_DANCER].ClosedLoop != 1)					// Open Loop라면
			{
				P_System_Cascading_ON_State_Machine++;
			}
			else
			{
				// [ 참조 : 26.04.24 케스케이딩 진행 시 댄서 Closed Loop 시 OUT 지정 ]
				P_Cascading_First_Out = P_Rot_OutValue / 2;
				CMD"#%dout %d",N_SERVO_DANCER,P_Cascading_First_Out;															// 토크모드 변경
				sendallcmds // 모든 커맨드문 버퍼를 비워냄
				while (Ldata.CmdStatus == 1) {} // 모든 커맨드문 버퍼가 비워질 때 까지 대기
				P_System_Cascading_ON_State_Machine++;
			}
		break;

		case 2:	// 케스케이딩 해제
			if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
			{
				cmd"#%d kill",0;
				cmd"#%d kill",N_UNWINDER_UPPER;
			}
			else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
			{
				cmd"#%d kill",0;
				cmd"#%d kill",N_UNWINDER_LOWER;
			}
			Sys.CompEnable = 0;															// 케스케이딩 해제
			P_System_Cascading_ON_State_Machine++;
		break;

		case 3:	// Spool 활성화
			if( Sys.CompEnable == 0 )
			{
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
					cmd"#%d j/",N_UNWINDER_UPPER;
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
					cmd"#%d j/",N_UNWINDER_LOWER;

				P_System_Cascading_ON_State_Machine++;
			}
		break;

		case 4:	// 초기 위치 탐색
			#ifdef F_Virtual_Axis_Test
				P_System_Cascading_ON_State_Machine = 9;
			#else
			
				if( P_Motor_Current_Pos(N_SERVO_DANCER) > P_Servo_Dancer_Ready_Pos + P_Servo_Dancer_Ready_Offset )											// 스텍방향 기준 아래로 쳐져있다면
				{
					if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							
					{	// [ 참조 : 26.04.24 언와인더 좌표계 속도 상관없이 지정한 조그 속도 나오도록 수정 ]
						motor[N_UNWINDER_UPPER].jogspeed = P_Unwinder_Jogspeed * (100/(Coord[36].DesTimeBase*400));		// 언와인더 회전 속도 지정 [ 참조 : 26.04.24 케스케이딩 진행 시 속도 수정 ]
						cmd"#%d j+",N_UNWINDER_UPPER;																	// +방향은 Spool기준 역회전 ( 당김 )
					}
					else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
					{	// [ 참조 : 26.04.24 언와인더 좌표계 속도 상관없이 지정한 조그 속도 나오도록 수정 ]
						motor[N_UNWINDER_LOWER].jogspeed = P_Unwinder_Jogspeed * (100/(Coord[36].DesTimeBase*400));		// 언와인더 회전 속도 지정 [ 참조 : 26.04.24 케스케이딩 진행 시 속도 수정 ]
						cmd"#%d j+",N_UNWINDER_LOWER;																	// +방향은 Spool기준 역회전 ( 당김 )
					}
				}
				else if( P_Motor_Current_Pos(N_SERVO_DANCER) < P_Servo_Dancer_Ready_Pos - P_Servo_Dancer_Ready_Offset )
				{
					if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							
					{	// [ 참조 : 26.04.24 언와인더 좌표계 속도 상관없이 지정한 조그 속도 나오도록 수정 ]
						motor[N_UNWINDER_UPPER].jogspeed = P_Unwinder_Jogspeed * (100/(Coord[36].DesTimeBase*400));		// 언와인더 회전 속도 지정 [ 참조 : 26.04.24 케스케이딩 진행 시 속도 수정 ]
						cmd"#%d j-",N_UNWINDER_UPPER;																	// +방향은 Spool기준 역회전 ( 당김 )
					}
					else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
					{	// [ 참조 : 26.04.24 언와인더 좌표계 속도 상관없이 지정한 조그 속도 나오도록 수정 ]
						motor[N_UNWINDER_LOWER].jogspeed = P_Unwinder_Jogspeed * (100/(Coord[36].DesTimeBase*400));		// 언와인더 회전 속도 지정 [ 참조 : 26.04.24 케스케이딩 진행 시 속도 수정 ]
						cmd"#%d j-",N_UNWINDER_LOWER;																	// +방향은 Spool기준 역회전 ( 당김 )
					}
				}
				P_System_Cascading_ON_State_Machine++;
				P_Servo_Dancer_Cascading_Set_Timer = 0;									// 타이머 초기화
			
			#endif
		break;

		case 5:	// 댄서 0위치 근접 ( 댄서의 토크는 0 )
			if( P_Servo_Dancer_Cascading_Set_Timer > 10 )								// 10ms 이후 
			{ 
				if( P_Motor_Current_Pos(N_SERVO_DANCER) < P_Servo_Dancer_Ready_Pos + P_Servo_Dancer_Ready_Offset && P_Motor_Current_Pos(N_SERVO_DANCER) > P_Servo_Dancer_Ready_Pos - P_Servo_Dancer_Ready_Offset  )										// 스텍방향 기준 0근접 
				{
					if( P_Selected_Spool_Number == N_UNWINDER_UPPER )		
					{				
						cmd"#%d j/",N_UNWINDER_UPPER;														// 정지
						Motor[N_UNWINDER_UPPER].jogspeed = P_Unwinder_Jogspeed;
					}
					else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
					{
						cmd"#%d j/",N_UNWINDER_LOWER;														// 정지
						Motor[N_UNWINDER_LOWER].jogspeed = P_Unwinder_Jogspeed;
					}

					P_System_Cascading_ON_State_Machine++;
				}
			}
		break;

		case 6:	// 댄서 베이스 토크 삽입
			if( Motor[N_SERVO_DANCER].ServoOut ~ P_OutValue )									// Servoout 값이있다면, Dancer Home 즉 텐션레디로 인해서 한번 실행이 되었던거임 중복 방지
			{
				P_System_Cascading_ON_State_Machine = 8
				P_Servo_Dancer_Cascading_Set_Timer = 0;
			}
			else																				// 값이 없다면, 텐션레디로 인한 Out 값이 없는거임 
			{	
				P_Dancer_Out_Slew_Seq = 1
				P_System_Cascading_ON_State_Machine++;
				P_Servo_Dancer_Cascading_Set_Timer = 0;
			}
		break;

		case 7 :
			if( P_Dancer_Out_Slew_Seq == 0 )
			{
				P_System_Cascading_ON_State_Machine++;
				P_Servo_Dancer_Cascading_Set_Timer = 0;
			}
		break;

		case 8:	// 토크 증가 후 텐션 변화 생김 -> Spool로 텐션 잡아주는 란.
			if( P_Servo_Dancer_Cascading_Set_Timer > 100 )									// 100ms
			{
				if( P_Motor_Current_Pos(N_SERVO_DANCER) < 0.5 &&  P_Motor_Current_Pos(N_SERVO_DANCER) > - 0.5 )		// 오차범위 0.5 
				{
					if( P_Selected_Spool_Number == N_UNWINDER_UPPER )							
						cmd"#%d j/",N_UNWINDER_UPPER;										// 정지
					else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
						cmd"#%d j/",N_UNWINDER_LOWER;										// 정지

					P_System_Cascading_ON_State_Machine++;
				}
				else																		// 오차범위에서 벗어나면
				{
					if( P_Motor_Current_Pos(N_SERVO_DANCER) < 0.5 )										// 댄서의 위치가 위로 쏠림 ( 언와인더 당김이 쌤 )
					{
						if( P_Selected_Spool_Number == N_UNWINDER_UPPER )													
							cmd"#%d j-",N_UNWINDER_UPPER;									// -방향이 풀어주는방향
						else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
							cmd"#%d j-",N_UNWINDER_LOWER;									// -방향이 풀어주는 방향
					}
					else if( P_Motor_Current_Pos(N_SERVO_DANCER) > 0.5 )								// 댄서의 위치가 아래로 쏠림 ( 스텍쪽 당김이 쌤 )
					{
						if ( P_Selected_Spool_Number == N_UNWINDER_UPPER )													
							cmd"#%d j+",N_UNWINDER_UPPER;									// +방향이 감는방향
						else if ( P_Selected_Spool_Number == N_UNWINDER_LOWER )
							cmd"#%d j+",N_UNWINDER_LOWER;									// +방향이 감는방향
					}
				}
			}
		break;

		case 9:	// 텐션이 잡혔으므로 Homez 
			if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
			{	
				//P_Home_Command(N_UNWINDER_UPPER) = F_Command_Start;	
				CompTable[0].Target[0] = Motor[N_UNWINDER_UPPER].CompDesPos.a;				// target addr 추가
			}
			else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
			{	
				//P_Home_Command(N_UNWINDER_LOWER) = F_Command_Start;	
				CompTable[0].Target[0] = Motor[N_UNWINDER_LOWER].CompDesPos.a;				// target addr 추가
			}
			P_System_Cascading_ON_State_Machine++;
		break;

		case 10:	// Cascading On												
			cmd"#%d j/",0;
			cmd"#%d homez",0;
			Sys.CompEnable = 1;															// cascading on
			P_System_Cascading_ON_State_Machine++;
		break;

		case 11:	// 완료
			if( Sys.CompEnable )
			{
				P_System_Cascading_ON_Status = F_Status_Nonseatus;						// 상태 초기화
				P_System_Cascading_ON_State_Machine = 0;								// 스텟머신 초기화
				P_System_Cascading_ON_Complete_Flag = 1;								// 서보댄서 준비 완료
			}
			else
				Sys.CompEnable = 1;	
		break;
	}
}
return;


sub: Servo_Dancer_Cascading_Off(void)

if( P_System_Cascading_OFF_Status == F_Status_STARTING )
{
	P_System_Cascading_OFF_Status = F_Status_EXECUTE;
	P_System_Cascading_OFF_State_Machine = 1;
}

if( P_System_Cascading_OFF_Status == F_Status_EXECUTE )
{
	switch( P_System_Cascading_OFF_State_Machine )
	{
		case 0:
		break;

		case 1:	// 케스케이딩 확인
				P_System_Cascading_ON_State_Machine = 0;								// 케스케이딩 진행중에 Stop 들어가면
				cmd"#%d j/",P_Selected_Spool_Number;									// Spool J/
				P_System_Cascading_OFF_State_Machine++;								// 스텟머신 초기화
		break;

		case 2:	// 댄서 모터 출력 저하		( Stop 되어도 어느정도 밀어주는 힘은 있어야 하므로 )
			if( P_PMAC_Status == F_Status_ABORTING || P_PMAC_Status == F_Status_ABORTED )	// Abort일때 댄서 Kill
			{
				cmd"#%d kill",N_SERVO_DANCER;												// 댄서 Kill.
				P_System_Cascading_OFF_State_Machine++;
				P_Servo_Dancer_Cascading_Off_Timer = 0;										// 타이머 초기화
			}
			else if(P_PMAC_Status == F_Status_SUSPENDED)
			{
				// [ 참조 : 26.09.11 적층 후 사이클 스탑 시 텐션이 풀려버려서 ServoOut을 Suspend 일때만 0으로 수정 ]
				Motor[N_SERVO_DANCER].ServoOut = 0;//P_OutValue *100;						// 베이스 토크
				P_System_Cascading_OFF_State_Machine++;
				P_Servo_Dancer_Cascading_Off_Timer = 0;										// 타이머 초기화
			}
			else
			{
				Motor[N_SERVO_DANCER].ServoOut = P_OutValue * 100;						// 베이스 토크
				P_System_Cascading_OFF_State_Machine++;
				P_Servo_Dancer_Cascading_Off_Timer = 0;										// 타이머 초기화
			}
		break;
		
		case 3:	// 케스케이딩 해제 및 잔류 토크보정 값 초기화
			if( P_Servo_Dancer_Cascading_Off_Timer > 50 )								// 50ms 
			{
				Sys.CompEnable = 0;														// 케스케이딩 종료
				motor[N_SERVO_DANCER].CompDac = 0;										// 잔류 토크보정 값 초기화
			//	cmd"#%d j/",N_SERVO_DANCER;												// Close Loop 변환 → ARC로 인해 OUT0으로 유지
				P_System_Cascading_OFF_State_Machine++;
			}
		break;

		case 4:
			// 텐션레디를 잡기 위하여, ServoDancer HomeCheck = 0 
			P_PMAC_Homing_CHK(N_SERVO_DANCER) = 0;
			Motor[N_SERVO_DANCER].pLimits =  Gate3[4].Chan[3].Status.a;
			P_System_Cascading_OFF_State_Machine++;
		break;

		case 5:	// 완료
			P_System_Cascading_OFF_Status = F_Status_Nonseatus;							// 상태 초기화
			P_System_Cascading_OFF_State_Machine = 0;									// 스텟머신 초기화
			P_System_Cascading_OFF_Complete_Flag = 1;									// 케스케이딩 종료 완료
		break;
	}
}

return;

sub: Frist_Dancer_Home_Ready_Pos(void) // ( 댄서 모터 위치가 어디있는지 모르므로, 홈잡다가 기재가 찢길수 있으므로 기재를 풀어주고 잡는다 )

local L_Spool_Num = P_Selected_Spool_Number;
if( P_System_Spool_Home_Ready_Pos_Status == F_Status_STARTING )
{
	P_System_Spool_Home_Ready_Pos_Status = F_Status_EXECUTE;
	P_System_Spool_Home_Ready_Pos_State_Machine = 1;
}

if( P_System_Spool_Home_Ready_Pos_Status == F_Status_EXECUTE )
{
	switch( P_System_Spool_Home_Ready_Pos_State_Machine )
	{
		case 0:
		break;
		
		case 1:	// 200mm 풀어주고 홈 Cmd 
				// 20deg 145mm
			local L_Spool_Ready_Pos = 200;
			if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
			{
				P_Home_Spool_Unwinding = ((L_Spool_Ready_Pos * 360) / P_PLC06_Spool_Circumference) * 1000;		// 댄서 모터 홈 잡기 전 세파 200mm 풀기
				Motor[L_Spool_Num].JogSpeed = P_Home_Spool_Unwinding / 1000;
			}
			else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
			{
				P_Home_Spool_Unwinding = ((L_Spool_Ready_Pos * 360) / P_PLC06_Spool_Circumference) * 1000;		// 댄서 모터 홈 잡기 전 세파 200mm 풀기
				Motor[L_Spool_Num].JogSpeed = P_Home_Spool_Unwinding / 1000;
			}

			P_System_Spool_Home_Ready_Pos_State_Machine++;
			P_Dancer_Frist_Home_Ready_Pos_Timer = 0;
		break;

		case 2:	// 조그 커맨드
			if( P_Dancer_Frist_Home_Ready_Pos_Timer > 100 )
			{
				if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
				{
					cmd"#%d j:-%f",N_UNWINDER_UPPER,P_Home_Spool_Unwinding;
				}
				else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
				{
					cmd"#%d j:-%f",N_UNWINDER_LOWER,P_Home_Spool_Unwinding;
				}
				P_System_Spool_Home_Ready_Pos_State_Machine++;
			}
		break;

		case 3:	// 모터 정지 대기
			if( P_Selected_Spool_Number == N_UNWINDER_UPPER )
			{
				if( motor[L_Spool_Num].DesVelZero )
					P_System_Spool_Home_Ready_Pos_State_Machine++;
			}
			else if( P_Selected_Spool_Number == N_UNWINDER_LOWER )
			{
				if( motor[L_Spool_Num].DesVelZero )
					P_System_Spool_Home_Ready_Pos_State_Machine++;
			}
			
		break;

		case 4:	// 완료
			P_System_Spool_Home_Ready_Pos_Status = F_Status_Nonseatus;								// 상태 초기화
			P_System_Spool_Home_Ready_Pos_State_Machine = 0;										// 스텟머신 초기화
			P_System_Spool_Home_Ready_Pos_Complete_Flag = 1;										// 컴플리트 
		break;
	}
}
return;


// [ 참 조 : 2025.12.12 좌표계 ON Subprog 처리 ]
sub: Coord_ON(Cur_Trg,Old_Trg,&rtn)

// 결과값 Flase
rtn = N_FALSE;

#ifdef F_Def_Stack_A	// A열은 상승엣지보고 좌표계 on
	if( Cur_Trg != Old_Trg && Cur_Trg == 1 )
	{
		P_Sync_Test++
		if( M_X_Pause_Status_Complete_Signal == 1 && P_Buffer_Mode_Status_Sequence != N_Sepa_Consume_Status_Sequence  ) {}	// 진입 타이밍을 맞추기위해 반댓열 퍼즈일시 starting에서 모션 잡아둠 	 [ 참조 : 26.07.31 Pause_Resume 수정 ]
		else
		{
			START N_Coord_Master_Motion				: N_Prog_Master_Motion_Sub_Program;

			if( P_PMAC_Current_Mode == F_Current_Automatic )
			{
				//Sub
				START N_Coord_Servo_Dancer_Sub			: N_Prog_Servo_Dancer_Sub_Program;
				START N_Coord_Anode_TR1_Sub				: N_Prog_Anode_TR1_Sub_Program;
				//START N_Coord_Anode_TR1_Picker_Sub		: N_Prog_Anode_TR1_Picker_Sub_Program;		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Anode_TR2_Sub				: N_Prog_Anode_TR2_Sub_Program;
				START N_Coord_Anode_Clamp_Sub			: N_Prog_Anode_Clamp_Sub_Program;
				START N_Coord_Final_Roll_Sub			: N_Prog_Final_Roll_Sub_Program;
				START N_Coord_Stack_Table_Sub			: N_Prog_Stack_Table_Sub_Program;
				START N_Coord_Cathode_Clamp_Sub			: N_Prog_Cathode_Clamp_Sub_Program;
				START N_Coord_Cathode_TR2_Sub			: N_Prog_Cathode_TR2_Sub_Program;
				//START N_Coord_Cathode_TR1_Picker_Sub	: N_Prog_Cathode_TR1_Picker_Sub_Program;		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Cathode_TR1_Sub			: N_Prog_Cathode_TR1_Sub_Program;
				//Slave
				START N_Coord_Anode_TR1_Slave			: N_Prog_Anode_TR1_Slave_Program;
				//START N_Coord_Anode_TR1_Picker_Slave	: N_Prog_Anode_TR1_Picker_Slave_Program;		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Anode_TR2_Slave			: N_Prog_Anode_TR2_Slave_Program;
				START N_Coord_Anode_Clamp_Slave			: N_Prog_Anode_Clamp_Slave_Program;
				START N_Coord_Final_Roll_Slave			: N_Prog_Final_Roll_Slave_Program;
				START N_Coord_Stack_Table_Slave			: N_Prog_Stack_Table_Slave_Program;
				START N_Coord_Cathode_Clamp_Slave		: N_Prog_Cathode_Clamp_Slave_Program;
				START N_Coord_Cathode_TR2_Slave			: N_Prog_Cathode_TR2_Slave_Program;
				//START N_Coord_Cathode_TR1_Picker_Slave	: N_Prog_Cathode_TR1_Picker_Slave_Program;	//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Cathode_TR1_Slave			: N_Prog_Cathode_TR1_Slave_Program;
				START N_Coord_Sheet_Paper_TR1_Slave		: N_Prog_Sheet_Paper_TR1_Slave_Program;
				START N_Coord_Cathode_NG_TR_Slave		: N_Prog_Cathode_NG_TR_Slave_Program;
				START N_Coord_Anode_NG_TR_Slave			: N_Prog_Anode_NG_TR_Slave_Program;
				START N_Coord_Unload_TR1_Slave			: N_Prog_Unload_TR1_Slave_Program;

				if( P_First_Sepa_Driving_Use == 1 )	// 드라이빙 사용 안하면, 좌표계 off
					START N_Coord_Camtable_Slave			: N_Prog_Camtable_Slave_Program;	// [ 참조 : 25.10.13 시스템 셋업 추가 ]
				// [ 참 조 : 2025.11.24 Z축 분리 ]
				start N_Coord_Anode_TR1_Z_Slave			: N_Prog_Anode_TR1_Z_Slave_Program;
				start N_Coord_Anode_TR2_Z_Slave			: N_Prog_Anode_TR2_Z_Slave_Program;
				start N_Coord_Cathode_TR2_Z_Slave		: N_Prog_Cathode_TR2_Z_Slave_Program;
				start N_Coord_Cathode_TR1_Z_Slave		: N_Prog_Cathode_TR1_Z_Slave_Program;

				rtn = N_TRUE;	// 결과값 True
			}
		}
	}
	#else			// B열은 하강엣지보고 좌표계 on
	if( Cur_Trg != Old_Trg && Cur_Trg == 0 )
	{
		P_Sync_Test++
		if( M_X_Pause_Status_Complete_Signal == 1 && P_Buffer_Mode_Status_Sequence != N_Sepa_Consume_Status_Sequence  ) {}	// 진입 타이밍을 맞추기위해 반댓열 퍼즈일시 starting에서 모션 잡아둠	  [ 참조 : 26.07.31 Pause_Resume 수정 ]
		else
		{
			START N_Coord_Master_Motion				: N_Prog_Master_Motion_Sub_Program;

			if( P_PMAC_Current_Mode == F_Current_Automatic )
			{
				//Sub
				START N_Coord_Servo_Dancer_Sub			: N_Prog_Servo_Dancer_Sub_Program;
				START N_Coord_Anode_TR1_Sub				: N_Prog_Anode_TR1_Sub_Program;
				//START N_Coord_Anode_TR1_Picker_Sub		: N_Prog_Anode_TR1_Picker_Sub_Program;			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Anode_TR2_Sub				: N_Prog_Anode_TR2_Sub_Program;
				START N_Coord_Anode_Clamp_Sub			: N_Prog_Anode_Clamp_Sub_Program;
				START N_Coord_Final_Roll_Sub			: N_Prog_Final_Roll_Sub_Program;
				START N_Coord_Stack_Table_Sub			: N_Prog_Stack_Table_Sub_Program;
				START N_Coord_Cathode_Clamp_Sub			: N_Prog_Cathode_Clamp_Sub_Program;
				START N_Coord_Cathode_TR2_Sub			: N_Prog_Cathode_TR2_Sub_Program;
				//START N_Coord_Cathode_TR1_Picker_Sub	: N_Prog_Cathode_TR1_Picker_Sub_Program;			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Cathode_TR1_Sub			: N_Prog_Cathode_TR1_Sub_Program;
				//Slave
				START N_Coord_Anode_TR1_Slave			: N_Prog_Anode_TR1_Slave_Program;
				//START N_Coord_Anode_TR1_Picker_Slave	: N_Prog_Anode_TR1_Picker_Slave_Program;			//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Anode_TR2_Slave			: N_Prog_Anode_TR2_Slave_Program;
				START N_Coord_Anode_Clamp_Slave			: N_Prog_Anode_Clamp_Slave_Program;
				START N_Coord_Final_Roll_Slave			: N_Prog_Final_Roll_Slave_Program;
				START N_Coord_Stack_Table_Slave			: N_Prog_Stack_Table_Slave_Program;
				START N_Coord_Cathode_Clamp_Slave		: N_Prog_Cathode_Clamp_Slave_Program;
				START N_Coord_Cathode_TR2_Slave			: N_Prog_Cathode_TR2_Slave_Program;
				//START N_Coord_Cathode_TR1_Picker_Slave	: N_Prog_Cathode_TR1_Picker_Slave_Program;		//PickerT좌표계 PNP에 묶음으로 인하여 주석 처리 [ 참조 : 26.08.14 PickerT 모션 변경 ]
				START N_Coord_Cathode_TR1_Slave			: N_Prog_Cathode_TR1_Slave_Program;
				START N_Coord_Sheet_Paper_TR1_Slave		: N_Prog_Sheet_Paper_TR1_Slave_Program;
				START N_Coord_Cathode_NG_TR_Slave		: N_Prog_Cathode_NG_TR_Slave_Program;
				START N_Coord_Anode_NG_TR_Slave			: N_Prog_Anode_NG_TR_Slave_Program;
				START N_Coord_Unload_TR1_Slave			: N_Prog_Unload_TR1_Slave_Program;
				
				if( P_First_Sepa_Driving_Use == 1 )	// 드라이빙 사용 안하면, 좌표계 off
					START N_Coord_Camtable_Slave			: N_Prog_Camtable_Slave_Program;	// [ 참조 : 25.10.13 시스템 셋업 추가 ]
				
				// [ 참 조 : 2025.11.24 Z축 분리 ]
				start N_Coord_Anode_TR1_Z_Slave			: N_Prog_Anode_TR1_Z_Slave_Program;
				start N_Coord_Anode_TR2_Z_Slave			: N_Prog_Anode_TR2_Z_Slave_Program;
				start N_Coord_Cathode_TR2_Z_Slave		: N_Prog_Cathode_TR2_Z_Slave_Program;
				start N_Coord_Cathode_TR1_Z_Slave		: N_Prog_Cathode_TR1_Z_Slave_Program;

				rtn = N_TRUE;	// 결과값 True
			}
		}
	}
	#endif
return;



sub: tension_ready(void)
// [ 참조 : 2026.02.12 텐션레디 추가 ]
local L_Selected_Spool_Number = P_Selected_Spool_Number;

switch( P_Tension_Ready_State_Machine )
{
	case 0:	
		P_Current_Homming_Status(P_Selected_Spool_Number) = F_Status_STOPPED;
	break;

	case 1:		// 1 STEP : Dancer Plimit = 0, Open Loop
		Motor[N_SERVO_DANCER].pLimits = 0;						// P Limit 해제
		CMD"#%d out 0 ",N_SERVO_DANCER;							// Open Loop
		P_Current_Homming_Status(P_Selected_Spool_Number) = F_Status_STARTING;
		P_Tension_Ready_State_Machine++;
	break;

	case 2:		// 2 STEP : Spool Move
		Motor[L_Selected_Spool_Number].JogSpeed = P_Unwinder_Jogspeed * (100/(Coord[36].DesTimeBase*400));	// Jog Speed 선언	[ 참조 : 26.04.24 언와인더 좌표계 속도 상관없이 지정한 조그 속도 나오도록 수정 ]
		CMD"#%d jog+",L_Selected_Spool_Number;												// Winder 감기	( - 풀기, + 감기 )
		P_Tension_Ready_State_Machine++;
	break;
	
	case 3:		// 3 STEP :	Minus Limit 감지  
		#ifdef F_Real_Axis_Test
		if( CK3WAX[4].Chan[3].MinusLimit == 1 )
		{
			CMD"#%d homez",N_SERVO_DANCER;						// Dancer Homez
			CMD"#%d jog/",P_Selected_Spool_Number;				// Winder 정지	( - 풀기, + 감기 )
			P_Tension_Ready_State_Machine++;
		}
		#else
			P_Tension_Ready_State_Machine++;
		#endif
	break;

	case 4:		// 4 STEP : Dancer Out Value  → 찬호 프로그램 추가 	
		if( Motor[L_Selected_Spool_Number].DesVelZero == 1 )
		{
			P_Dancer_Out_Slew_Seq = 1		
			P_Tension_Ready_State_Machine++;
		}
	break;

	case 5 :
		if( P_Dancer_Out_Slew_Seq == 0 )
			P_Tension_Ready_State_Machine++;
	break;

	case 6:
			CMD"#%d jog-",L_Selected_Spool_Number;				// Winder 감기	( - 풀기, + 감기 )
			P_Tension_Ready_State_Machine++;
	break;

	case 7:		// 5 STEP : Dancer 중앙 위치
		// P_Dancer_Center_Pos → 설계치 또는 실제 장비에서 위치값을 도출해야함 일단은 30도로 설정해둠
		#ifdef F_Real_Axis_Test
		if( P_Motor_Current_Pos(N_SERVO_DANCER) ~ P_Dancer_Center_Pos )				// Center Pos 확인
		{
			CMD"#%d homez",N_SERVO_DANCER;						// Servo Dancer 0위치 변경
			CMD"#%d jog/",L_Selected_Spool_Number;				// Winder 정지	( - 감기, + 풀기 )
			P_Tension_Ready_State_Machine++;
		}
		#else
			P_Tension_Ready_State_Machine++;
		#endif
	break;

	case 8:		// 6 STEP : Dancer Home Command ( 센터값을 0으로 만들기 위함 )
		// CMD"#%d j/",N_SERVO_DANCER;	
		// call Timer.msec(5);
		//P_Home_Command(N_SERVO_DANCER) = F_Command_Start;
		P_PMAC_Homing_CHK(N_SERVO_DANCER) = 1;
		P_Tension_Ready_State_Machine++;
	break;

	case 9:		// 7 STEP : Home 확인 
		if( P_PMAC_Homing_CHK(N_SERVO_DANCER) == N_TRUE )		// Home 확인
		{
			P_Tension_Ready_State_Machine++;
		}
	break;

	case 10:		// 8 STEP : 조그 스피드 원복
		Motor[L_Selected_Spool_Number].jogspeed = P_Unwinder_Jogspeed;
		P_Tension_Ready_State_Machine++;
	break;

	case 11:		// 9 STEP : Complete 
		P_Current_Homming_Status(P_Selected_Spool_Number) = F_Status_COMPLETE;
		P_Tension_Ready_Pos_Status = F_Status_COMPLETE;
		P_Tension_Ready_State_Machine = 0;
	break;

	default: break;
}

return;

close



