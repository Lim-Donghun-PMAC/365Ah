P_Discharge_Possibility_Bit(5)	= N_Disable_Cycle_Stop;				// [사이클 정지 불가능]	언로더 진입 전 정지 가능.
P_Discharge_Possibility_Bit(6)	= N_Disable_Cycle_Stop;				// [사이클 정지 불가능]	언로더 진입 전 정지 가능.
P_Discharge_Possibility_Bit(7)	= N_Disable_Cycle_Stop;				// [사이클 정지 불가능]	언로더 진입 전 정지 가능.
