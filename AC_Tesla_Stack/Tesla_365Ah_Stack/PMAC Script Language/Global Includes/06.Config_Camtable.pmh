//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.xx.xx 
// 캠테이블  - [ 참조 : 25.10.13 시스템 셋업 추가 ]

// 드라이빙 캠 테이블 설정
// 드라이빙 롤러 모터 번호 15
// 서브 피딩 모터 번호 14

#define N_Feed_Cam_Num		0
#define N_Driving_Cam_Num	1
#define N_LineVel_Cam_Num	3

global P_CamTable_MAX_EA = 233;
global P_Cam_Move_Distanse = P_CamTable_MAX_EA;
global P_Sepa_Driving_Diameter = 60;				// 세파 드라이빙 롤러 지름 [mm] (세파 드라이빙 = 위쪽 롤러)
global	P_PI = acos(-1);


// cam 값은 FF 이전에 드라이빙 모션부터 찾고 넣어야함!!!!!!!!!


Sys.CamEnable = 2;								// 캠 테이블 CamTable[0] ~ CamTable[4]
// 캠테이블 모터 링크
CamTable[0].Source = 61;						// 전자캠 => 가상축 번호
CamTable[0].Target = 62;						// 선속 => 가상축 번호
//CamTable[1].Source = 61;						// 전자캠 => 가상축 번호
//CamTable[1].Target = N_DRIVING_ROLL;			// 실제 축 번호 => 드라이빙 모터
// 캠테이블 Data 갯수 및 mu 선정													232 + 1 << 
CamTable[0].Nx = P_CamTable_MAX_EA;				// 233 posdata -> Final Roller 230 ms 시간을 사용하므로, 230개 사용 ( 2칸은 파이널롤러의 모션에서 밀리는 값을 넣어 줌 )
CamTable[0].Dx = P_Cam_Move_Distanse;			// 전자캠의 이동 mu 단위
//CamTable[1].Nx = P_CamTable_MAX_EA;			// 233 posdata -> 2ms 여유
//CamTable[1].Dx = P_Cam_Move_Distanse;			// 전자캠의 이동 mu 단위

// CamTable Out Data Sys.Udata[500,501] 버퍼값에 생김
//CamTable[0].OutData[70]=F_Status_STARTING;	// 실제 Sepa 요구량이 필요한 시점
//CamTable[0].OutData[232]=F_Status_COMPLETE;	// Camtable이 한바퀴 회전 완료한 시점
//CamTable[0].OutData[233]=F_Status_COMPLETE;	// Camtable이 한바퀴 회전 완료한 시점
//CamTable[1].OutData[70]=F_Status_STARTING;	// 실제 Sepa 요구량이 필요한 시점
//CamTable[1].OutData[232]=F_Status_COMPLETE;	// Camtable이 한바퀴 회전 완료한 시점
//CamTable[1].OutData[233]=F_Status_COMPLETE;	// Camtable이 한바퀴 회전 완료한 시점

// Camtable Parameter
CamTable[0].X0=0							// 시작
//CamTable[0].PosSf= 1						// 스케일 팩터
CamTable[0].PosSf = 360 / ( P_PI * P_Sepa_Driving_Diameter );	// 세파 드라이빙 캠테이블 스케일 = 360º / ( PI * 지름 )	[ 참조 : CPU 최적화 진행 ]
CamTable[0].PosOffset=0		
CamTable[0].SlewPosOffset=10
CamTable[0].DacSf=1
CamTable[0].pOut=Sys.udata[500].a			// 아웃 데이터 주소 선정 ( unsign int 500 )
CamTable[0].pOutBuf=0
CamTable[0].SlewX0=0
CamTable[0].OutBits=32
CamTable[0].OutLeftShift=0
CamTable[0].DacEnable=0

//CamTable[1].X0=0							// 시작
