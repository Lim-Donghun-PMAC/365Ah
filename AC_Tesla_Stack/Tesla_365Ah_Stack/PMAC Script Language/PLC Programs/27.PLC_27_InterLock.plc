					P_No5_Recipe_Pos_IL(N_Clamp_CA_Z1) = 1;
					P_No6_Recipe_Pos_IL(N_Clamp_CA_Z1) = 1;
					P_No7_Recipe_Pos_IL(N_Clamp_CA_Z1) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_CA_Z1) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_CA_Z1) = 1;			// 인터락
