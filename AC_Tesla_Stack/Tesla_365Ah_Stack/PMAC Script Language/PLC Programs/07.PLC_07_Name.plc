// 25.xx.xx 
// 내용 - [ 참조 : 25.xx.xx 내용 ]


global	P_Discharge_Total_Tact = 0;


global	P_Read_Sector_TactTime(6);
P_Read_Sector_TactTime(1) = 50;
P_Read_Sector_TactTime(2) = 500;
P_Read_Sector_TactTime(3) = 230;
P_Read_Sector_TactTime(4) = 500;
P_Read_Sector_TactTime(5) = 10000;

global	P_Write_Sector_TactTime(6);
P_Write_Sector_TactTime(1) = 50;
P_Write_Sector_TactTime(2) = 50;
P_Write_Sector_TactTime(3) = 200;
P_Write_Sector_TactTime(4) = 200;
P_Write_Sector_TactTime(5) = 20000;


OPEN PLC 7
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//01. 다이나믹 로컬 타이머 변수 선언
	#define	L_System_Timer				Sys.Time
	#define N_Time_Scale				1000
	#define N_Range_Update_Interval_Interface		0.1
	Local       L_Time_Cycle_Up_Count_Start_Time;                       // 시작 체크 시작 시간 
	Local       L_Time_Cycle_Up_Count_End_Time;                         // 시작 체크 종료 시간
	Local       L_Time_Cycle_Up_Count_Delta_Time;                       // 시작과 종료 시간 사이의 시간
	Local       L_Flag_Cycle_Up_Count_Init_Flag;                        // 타이머 초기화 플래그
	local		L_SizeQueue_Select_Clear;
	//02. 다이나믹 로컬 타이머 함수  
	// 시간 간격 초기화
	If (L_Flag_Cycle_Up_Count_Init_Flag == 0)
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 1;
		L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
		L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	}

	// 시간 체크
	If (L_Flag_Cycle_Up_Count_Init_Flag == 1)
	{
		L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
		L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;

		If( L_Time_Cycle_Up_Count_Delta_Time < 0 )
		{
      		L_Flag_Cycle_Up_Count_Init_Flag = 0;
		}
	}

	// 시간 업데이트
	If (L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval_Interface)
	{
        // 여기에 타이머 추가	
        P_Read_Timer_S(1) = P_Read_Timer_S(1) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(2) = P_Read_Timer_S(2) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(3) = P_Read_Timer_S(3) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(4) = P_Read_Timer_S(4) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(5) = P_Read_Timer_S(5) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(6) = P_Read_Timer_S(6) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(7) = P_Read_Timer_S(7) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Read_Timer_S(8) = P_Read_Timer_S(8) + L_Time_Cycle_Up_Count_Delta_Time;

		P_Write_Timer_S(1) = P_Write_Timer_S(1) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(2) = P_Write_Timer_S(2) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(3) = P_Write_Timer_S(3) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(4) = P_Write_Timer_S(4) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(5) = P_Write_Timer_S(5) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(6) = P_Write_Timer_S(6) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(7) = P_Write_Timer_S(7) + L_Time_Cycle_Up_Count_Delta_Time;
		P_Write_Timer_S(8) = P_Write_Timer_S(8) + L_Time_Cycle_Up_Count_Delta_Time;

		L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
		L_Time_Cycle_Up_Count_Delta_Time = 0;
	}

if(P_PMAC_Current_Mode == F_Current_Automatic)
{
	P_Interval_Read_S(1) = P_Read_Sector_TactTime(1);
	P_Interval_Read_S(2) = P_Read_Sector_TactTime(2);			
	P_Interval_Read_S(3) = P_Read_Sector_TactTime(3);			
	P_Interval_Read_S(4) = P_Read_Sector_TactTime(4);			
	P_Interval_Read_S(5) = P_Read_Sector_TactTime(5);			

	P_Interval_Write_S(1) = P_Write_Sector_TactTime(1);
	P_Interval_Write_S(2) = P_Write_Sector_TactTime(2);
	P_Interval_Write_S(3) = P_Write_Sector_TactTime(3);
	P_Interval_Write_S(4) = P_Write_Sector_TactTime(4);
	P_Interval_Write_S(5) = P_Write_Sector_TactTime(5);
}
else if(P_PMAC_Current_Mode == F_Current_Manual)
{
	P_Interval_Read_S(1) = 1000;
	P_Interval_Read_S(2) = 50;			
	P_Interval_Read_S(3) = 50;			
	P_Interval_Read_S(4) = 50;			
	P_Interval_Read_S(5) = 100;			

	P_Interval_Write_S(1) = 1000;
	P_Interval_Write_S(2) = 1000;
	P_Interval_Write_S(3) = 50;
	P_Interval_Write_S(4) = 50;
	P_Interval_Write_S(5) = 1000;
}

//=========================================================================
// <Sector 1> Receive Data (Receive From PLC)
//=========================================================================
// Sector 별 가중치
if( P_Read_Timer_S(1) > P_Interval_Read_S(1))
{
	//M_Read_Sector_Scan_Complete(1) = 0;
	//M_Read_Sector_Scan_Cmd(1) = 1;			// Read Sector No.1 Scan Command!
	P_Read_Timer_S(1) = 0;
}

if( P_SV_Read_Enable_Flag == 0 && M_Read_Sector_Scan_Complete(1) == 1 ) // sv 읽기 허가 신호 on
{	// Recipe에 있는 값을 Auto, Starting 시 1번 값을 읽어온다.
	M_Read_Sector_Scan_Complete(1) = 0;
	//삭제 해도 될 듯?
	// [ 참조 : MES APC 기반 MES -> PLC-> PMAC 보정값 영역 추가 ]
	//P_Cathode_MES_X_Average_mm = Sys.Idata[41675] / 10000;
	//P_Anode_MES_X_Average_mm = Sys.Idata[41676] / 10000;
	// [ 참조 : MES APC 사용 미사용 버튼 추가 사용 : 1 미사용 : 0 ]
	//P_MES_APC_Select_Btn = u.user:$028B34.00.1;

}

if( P_Read_Timer_S(2) > P_Interval_Read_S(2))
{
	M_Read_Sector_Scan_Cmd(2) = 1;			// Read Sector No.1 Scan Command!
	P_Read_Timer_S(2) = 0;
}

if( M_Read_Sector_Scan_Complete(2) == 1)
{
	M_Read_Sector_Scan_Complete(2) = 0;

	if( Sys.Idata[10400] >= 0 )
	{	
		P_Jelly_Roll_Recipe_Count						= Sys.Idata[10400];				// 젤리 롤 목표 생산 개수 설정
	}
	P_ARC_End_Sepa_Recipe_Count	                        = Sys.Idata[10403];				// 세파 ARC 종료 후 적층 개수

	P_Sepa_Mode_Sepa_Recipe_Count	                    = Sys.Idata[10404];				// 세파 모드 적층 개수
	#ifdef F_Debug_Mode
		
	#else
		if( Sys.Idata[10405] >= 0 && Sys.Idata[10405] <= 100 )								
		{																					// 장비 속도
			P_Recipe_Speed_Value				  = Sys.Idata[10405]; 
		}
	#endif


	P_Unloader_1st_Cutter_Heating_Limit_Value = Sys.Idata[10406];						// 1차 언로더 열선 커터 온 리미트 값 
	P_Unloader_1st_Separate_Cutting_Current   = Sys.Idata[10407];						// Separate_Cutting 전류 확인 값
	P_X_Move_Recipe_Percent					  = Sys.Idata[10408];						// APC 보정값 
	P_Discharged_After_End_Trigger			  = u.user:$00A8E4.00.16					// 중간 배출 후 설비 정지 신호 (APC 관련 - 배출 후 PLC에서 생산을 멈추기 위해 주는 신호)
	P_Unloader_1st_Grip_Delay				  = Sys.Idata[10410];						// 1차 언로더 그립 딜레이 값 

	P_Cathode_Clamp_inside_Machine_Cylinder_Count = Sys.Idata[10416];					// 양극 클램프 상단 실린더 사용 횟수 저장 영역
	P_Anode_Clamp_inside_Machine_Cylinder_Count	  = Sys.Idata[10417];					// 음극 클램프 상단 실린더 사용 횟수 저장 영역
	P_Cathode_Clamp_Middle_Cylinder_Count		  = Sys.Idata[10418];					// 양극 클램프 중단 실런더 사용 횟수 저장 영역
	P_Anode_Clamp_Middle_Cylinder_Count			  = Sys.Idata[10418];					// 음극 클램프 중단 실런더 사용 횟수 저장 영역

	/*
	// 양/음극 탭 재검사 연속ng 발생시 plc <-> ppmac 인터페이스 신호
	P_X_Cathode_Sheet_Tab_Retry_inspection_Continuos_Ng_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A8EC.00.1;
	P_X_Anode_Sheet_Tab_Retry_inspection_Continuos_Ng_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A8EC.01.1;

	// 양/음극 캘틀어짐 사이클정지 사용/미사용 정의
	#ifdef F_Align_Calibration_twisted_Enable 
	// 양/음극 캘틀어짐 사이클정지
	P_X_Cathode_Align_Calibration_twisted_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A8EC.02.1;
	P_X_Anode_Align_Calibration_twisted_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A8EC.03.1;

	// 스텍 얼라인 캘리브레이션 틀어짐 vision -> ppmac 인터페이스 신호 
	P_X_Stack_Align_Calibration_twisted_Cycle_Stop_Receive_Complete_Trigger = u.user:$00A8EC.04.1;
	#endif
	*/
	P_Interlock_Messege_Confirmed = u.user:$00A8EC.05.1;								// 인터락 팝업 완료 신호
	P_X_MC_Communication_HeartBit = u.user:$00A8EC.06.1;								// 이더넷 통신 하트 비트 신호 (D영역 하트비트 신호 입력)

	// 양극 Stack 수 
	if( Sys.Idata[10421] < 150 && Sys.Idata[10421] >= 0 )
	{
	  P_SV_Cathode_Count	= Sys.Idata[10421];
	}
	// 음극 Stack 수
	if( Sys.Idata[10422] < 150 && Sys.Idata[10422] >= 0 )
	{
	  P_SV_Anode_Count	= Sys.Idata[10422];
	}

	// Clamp 압력_양극뱡항_기준값
	if( Sys.Idata[10423] < 1000 && Sys.Idata[10423] >= 0 )
	{
	  P_SV_AO_Reference_Value_Chanel(1)	= Sys.Idata[10423]/50;
	}
	// Clamp 압력_음극뱡항_기준값
	if( Sys.Idata[10426] < 1000 && Sys.Idata[10426] >= 0 )
	{  
	  P_SV_AO_Reference_Value_Chanel(2)	= Sys.Idata[10426]/50;
	}

	// 양극 두께_기준값
	if( Sys.Idata[10432] < 1000 && Sys.Idata[10432] >= 0 )
	{
	  P_SV_Cathode_Reference_Thickness	= Sys.Idata[10432]/1000;
	}

	// 음극 두께_기준값
	if( Sys.Idata[10435] < 1000 && Sys.Idata[10435] >= 0 )
	{
	  P_SV_Anode_Reference_Thickness	= Sys.Idata[10435]/1000;
	}

	// 분리막 두께_기준값
	if( Sys.Idata[10438] < 1000 && Sys.Idata[10438] >= 0 )
	{
	  P_SV_Sepa_Reference_Thickness	= Sys.Idata[10438]/1000;
	}

	// J/R 폭
	if( Sys.Idata[10441] < 30000 && Sys.Idata[10441] >= 0 )
	{
	  P_SV_Jelly_Roll_Width	= Sys.Idata[10441]/100;
	}

	//양극 vision 연속 불량 알람 발생 횟수
	if( Sys.Idata[10444] > P_Cathode_Align_Continuous_NG_Check_Range )
	{
		P_Cathode_Align_Continuous_NG_Recipe = P_Cathode_Align_Continuous_NG_Check_Range;	
	}
	else
	{
		P_Cathode_Align_Continuous_NG_Recipe = Sys.Idata[10444];
	}

	//음극 vision 연속 불량 알람 발생 횟수
	if( Sys.Idata[10445] > P_Anode_Align_Continuous_NG_Check_Range )
	{
		P_Anode_Align_Continuous_NG_Recipe = P_Anode_Align_Continuous_NG_Check_Range;	
	}
	else
	{
		P_Anode_Align_Continuous_NG_Recipe = Sys.Idata[10445];
	}

	//스텍 vision 연속 불량 알람 발생 횟수
	if( Sys.Idata[10450] > P_Stack_Continuous_NG_Check_Range )
	{
		P_Stack_Vision_Continuous_NG_Recipe = P_Stack_Continuous_NG_Check_Range;	
	}
	else
	{
		P_Stack_Vision_Continuous_NG_Recipe = Sys.Idata[10450];
	}

	P_PLC_Recipe_EPC_Sepa_Count  =	u.user:$00A990.00.16;					// EPC 보정 모드 2차 세파 모드 개수
	P_PLC_Recipe_Revise_Sepa	 =	u.user:$00A990.16.16;					// EPC 보정 모드 Retry 횟수 설정
	P_X_PLC_to_PMAC_Correction_Value = u.user:$00A994.00.16;				// EPC 보정률
	//음극 Align Vision 연속 불량 알람 발생 탐색 범위 설정
	if( u.user:$00A994.16.16 > N_Queue_Max_Size )
	{
		P_Anode_Align_Continuous_NG_Check_Range = N_Queue_Max_Size;
	}
	else if( u.user:$00A994.16.16 > 0 )
	{
		P_Anode_Align_Continuous_NG_Check_Range	= u.user:$00A994.16.16;
	}

	//양극 Align Vision 연속 불량 알람 발생 탐색 범위 설정
	if( u.user:$00A998.00.16 > N_Queue_Max_Size )
	{
		P_Cathode_Align_Continuous_NG_Check_Range = N_Queue_Max_Size;
	}
	else if( u.user:$00A998.00.16 > 0 )
	{
		P_Cathode_Align_Continuous_NG_Check_Range	= u.user:$00A998.00.16;
	}

	//스텍 Align Vision 연속 불량 알람 발생 탐색 범위 설정
	if( u.user:$00A99C.16.16 > N_Queue_Max_Size )
	{
		P_Stack_Continuous_NG_Check_Range = N_Queue_Max_Size;
	}
	else if( u.user:$00A99C.16.16 > 0 )
	{
		P_Stack_Continuous_NG_Check_Range	= u.user:$00A99C.16.16;
	}	

	P_Servo_Dancer_Alarm_Maximum_Angle_Value = Sys.Idata[10456];				//서보 댄서 알람 발생 각도 상한 값
	P_Servo_Dancer_Alarm_Maximum_Angle_Value = Sys.Idata[10457];				//서보 댄서 알람 발생 각도 하한 값
	// 프로그램 다운로드후plc로부터 저장된 스풀 회전수 읽어오기
	P_Current_Selected_Spool_Rev_Counts_Init_Read = Sys.Idata[10458];
	P_ARC_End_Sepa_Recipe_Count = Sys.Idata[10460];								// 세파 ARC 종료 후 적층 개수 
	P_Spool_ARC_Distance_mm = Sys.Idata[10461];									// 세파 ARC 이동량 설정
	P_ARC_Upper_Request_Sepa_Thickness_mm = Sys.Idata[10462]/1000				// 상단 세파 ARC교체 두께
	P_ARC_Lower_Request_Sepa_Thickness_mm = Sys.Idata[10463]/1000				// 하단 세파 ARC교체 두께
	P_Selected_Spool_Arc_Set_Rev_Counts_Value = Sys.Idata[10465];				// 현재 사용 중인 스풀 ARC 교체 회전수 설정 
	P_Set_Cnt_FR_Moving_Sepa_ARC = Sys.Idata[10466];							// 세파 arc 교체 F/R 이동 횟수 설정

	//고객사 요청으로 도어 오픈 시 / PLC에서 M_X_PLC_Cathode_NG, M_X_PLC_Anode_NG 신호 온 시 얼라인 극판 배출 실행시 및 ng코드 수신,보고 추가 ]
	P_Receive_Cathode_NG_Code_From_PLC = Sys.Idata[10467];				
	P_Receive_Anode_NG_Code_From_PLC = Sys.Idata[10468];	 



	P_Sepa_Rotation_Sequence_Run_Trigger_Cnt = P_Current_Selected_Spool_Rev_Counts_Init_Read*10;
	P_Cathode_Recipe_Count = P_SV_Cathode_Count;								// 양극 Stack 수
	P_Anode_Recipe_Count = P_SV_Anode_Count;									// 음극 Stack 수
	P_AO_Cathode_Clamp_Damper = P_SV_AO_Reference_Value_Chanel(1);				// Clamp 압력_양극 방향_기준 값
	P_AO_Anode_Clamp_Damper = P_SV_AO_Reference_Value_Chanel(2);				// Clamp 압력_음극 방향_기준 값
	P_Cathode_Thickness_PLC = P_SV_Cathode_Reference_Thickness;					// 양극 두께_기준 값
	P_Anode_Thickness_PLC = P_SV_Anode_Reference_Thickness;						// 음극 두께_기준 값
	P_Sepa_Thickness_PLC = P_SV_Sepa_Reference_Thickness;						// 분리막 두께_기준 값

	// 세파길이 계산. ( SV값을 스풀 속도계산에 필요한 변수에 대입. ) 
	if( P_Select_Setting_Mode == F_Produce_Mode )
	{ // 생산모드라면 (SV값을 받아오는경우 ) 
		P_Sepa_Length = P_SV_Jelly_Roll_Width;
	}
	 P_SV_Read_Enable_Flag = 1;

}
if( P_Read_Timer_S(3) > P_Interval_Read_S(3))
{
	M_Read_Sector_Scan_Cmd(3) = 1;			// Read Sector No.1 Scan Command!
	P_Read_Timer_S(3) = 0;
}

if( M_Read_Sector_Scan_Complete(3) == 1)
{
	M_Read_Sector_Scan_Complete(3) = 0;

	P_BTN_Jog_FWD_M(1),49 = M_X_BTN_Press_Jog_Left_From_PLC;	// Jog Plus Button
	P_BTN_Jog_BWD_M(1),49 = M_X_BTN_Press_Jog_Right_From_PLC;	// Jog Minus Button

	//로그 데이터
	P_Log_Data_Y = u.user:$00AE54.00.16;
	P_Log_Data_M = u.user:$00AE54.16.16;
	P_Log_Data_D = u.user:$00AE58.00.16;
	P_Log_Data_H = u.user:$00AE58.16.16;
	P_Log_Data_m = u.user:$00AE5C.00.16;
	P_Log_Data_s = u.user:$00AE5C.16.16;

	P_MSA_Run_Repeat_Num(F_Cathode_Stack_MSA)	= u.user:$00AE64.00.16			// 양극 스텍 msa 반복 횟수( gui로부터 입력 )
	P_MSA_Run_Repeat_Num(F_Anode_Stack_MSA)		= u.user:$00AE64.16.16			// 음극 스텍 msa 반복 횟수( gui로부터 입력 )
	P_MSA_Run_Repeat_Num(F_Cathode_Align_MSA)	= u.user:$00AE68.00.16			// 양극 얼라인 msa 반복 횟수( gui로부터 입력 )
	P_MSA_Run_Repeat_Num(F_Anode_Align_MSA)		= u.user:$00AE68.16.16			// 음극 얼라인 msa 반복 횟수( gui로부터 입력 )

	// 레시피 자동 적용 
	IF ( u.user:$00AE6C.00.16 != 0 )
	{
		P_Select_Sheet_Value = u.user:$00AE6C.00.16;
	}

	P_Dryrun_Operating_Time		= u.user:$00AE6C.16.16;							// 드라이런 가동 시간 설정

