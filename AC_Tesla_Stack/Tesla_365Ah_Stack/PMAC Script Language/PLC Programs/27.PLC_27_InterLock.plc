				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);		// An 2nd Z [#22] 하강 위치 - 현재 위치 시 절대위치 변환 가능
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
