//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 26.03.30 
// JR ID업데이트 및 증가조건, Trans IN 시점 조건부 변경 - [ 참조 : 26.03.30 젤리롤 ID 업데이트 조건 구조 변경]	

open subprog Discharge_Sub_Prog(void)




sub: Discharge_Cal_Prog(&rtn) // JR ID업데이트 및 증가조건, Trans IN 시점 조건부 변경 - [ 참조 : 26.03.30 젤리롤 ID 업데이트 조건 구조 변경]		
	rtn = 0
	
	// 극판 및 세파 두께 계산 프로그램
	
	// 젤리롤 두께 계산
	IF ( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) != N_Dryrun_Status_Sequence )
	{
		IF ( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) == N_Normal_Status_Sequence )				// 일반  모드 라면 ↓ PLC 07번 라이트 영역에 올려주는 두께 수식
		{ 
			P_Current_JR_Thickness_mm = ((P_Anode_Thickness + P_Sepa_Thickness ) * P_Anode_Count) + ((P_Cathode_Thickness + P_Sepa_Thickness ) * P_Cathode_Count);
		}
		Else IF( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) == N_Sepa_Consume_Status_Sequence )		// 세파 모드 라면 ↓ PLC 07번 라이트 영역에 올려주는 두께 수식
		{ // 세파쌓기모드라면 세파두께
			P_Current_JR_Thickness_mm = ( P_Sepa_Thickness * P_Anode_Count ) + ( P_Sepa_Thickness * P_Cathode_Count );	
		}
		P_Current_Jelly_Roll_Thinckness_mm_Send_Enable_Flag = 1;						// PLC 07번 - Write영역에 올려주는 Flag 				
		
		rtn = F_TRUE;
	}
	
return;

// 젤리롤 결과 상태 
// 1) 노말런
// -1. 정상배출
// -2. 불량배출
// 2) 세파런
sub: JR_Result_Data(&rtn)
	// 1) 노말런
	if( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) == N_Normal_Status_Sequence )		
	{
		// 1-1.정상 상태 배출 ↓ 음,양 카운트 일치 및 Stack NG없을때
		if( P_Anode_Count == P_Anode_Recipe_Count && P_Cathode_Count == P_Cathode_Recipe_Count && P_Stack_Table_NG_Flag == 0)  
		{
			if( P_Stack_Vision_To_NG_Code != 0 )	// 양품 판정인데 비전 NG코드가 남겨져 있다면, 불량배출로 
			{
				M_Y_PLC_Stacking_OK_JR = 0; 					// 정상 배출 신호 OFF
				M_Y_PLC_Stacking_NG_JR = 1; 					// 불량 배출 ↓불량일때			
				M_Y_PLC_Full_Stacking_NG_JR_Unload = 1;			// 1)불량-NG배출 정상 스텍 셀 배출
				M_Y_PLC_NonFull_Stacking_NG_JR_Unload = 0;		// 2)블량-NG배출 폐기 배출
				M_Y_PLC_Sepa_Stacking_Unload = 0;				// 3)세파 배출 신호 알림
			}
			else
			{
				M_Y_PLC_Stacking_OK_JR = 1; 					// 정상 배출				
				M_Y_PLC_Stacking_NG_JR = 0; 					// 불량 배출 ↓불량일때				
				M_Y_PLC_Full_Stacking_NG_JR_Unload = 0;			// 1)불량-NG배출 정상 스텍 셀 배출
				M_Y_PLC_NonFull_Stacking_NG_JR_Unload = 0;		// 2)블량-NG배출 폐기 배출
				M_Y_PLC_Sepa_Stacking_Unload = 0;				// 3)세파 배출 신호 알림
			}
			//P_Program_Monitoring_Lamp_Jelly_Roll_OK = 1;		// 양품 판정 시 JR - OK Lamp Bit ON	
			if( P_Suspend_Discharge_Cell_Out_Restart != 1 )		// 배출 중, 멈췄다가 재시작했을때 
			{	
				P_Jelly_Roll_OK_Count++;
			}			
		}
		// 1-2.불량 상태 배출 ↓ 음,양 카운트 불일치 및 Stack NG있을때
		else 
		{
			// 음,양 카운트는 일치하지만 Stack NG 있을때 [ 레시피 개수 맞게 스텍 ]
			if( P_Anode_Count == P_Anode_Recipe_Count && P_Cathode_Count == P_Cathode_Recipe_Count && P_Stack_Table_NG_Flag != 0 )
			{			
				M_Y_PLC_Stacking_OK_JR = 0; 					// 정상 배출			
				M_Y_PLC_Stacking_NG_JR = 1; 					// 불량 배출 ↓불량일때					
				M_Y_PLC_Full_Stacking_NG_JR_Unload = 1;			// 1)불량-NG배출 정상 스텍 셀 배출
				M_Y_PLC_NonFull_Stacking_NG_JR_Unload = 0;		// 2)블량-NG배출 폐기 배출
				M_Y_PLC_Sepa_Stacking_Unload = 0;				// 3)세파 배출 신호 알림
			}
			// 음, 양 카운트가 일치하지 않을떄 [ 쌓던 도중 배출 ]
			else
			{
				M_Y_PLC_Stacking_OK_JR = 0; 					// 정상 배출				
				M_Y_PLC_Stacking_NG_JR = 1; 					// 불량 배출 ↓불량일때					
				M_Y_PLC_Full_Stacking_NG_JR_Unload = 0;			// 1)불량-NG배출 정상 스텍 셀 배출
				M_Y_PLC_NonFull_Stacking_NG_JR_Unload = 1;		// 2)블량-NG배출 폐기 배출
				M_Y_PLC_Sepa_Stacking_Unload = 0;
			}
			//P_Program_Monitoring_Lamp_Jelly_Roll_NG = 1;		// 불량 판정 시 JR - NG Lamp Bit ON		
			if( P_Suspend_Discharge_Cell_Out_Restart != 1 )		// 배출 중, 멈췄다가 재시작했을때 
			{	
				P_Jelly_Roll_NG_Count++;
			}			
		}
	}
	// 2) 세파런	
	else if( P_Buffer_Mode_Module_Status_Sequence(N_Discharge_Module) == N_Sepa_Consume_Status_Sequence )
	{
			//P_Program_Monitoring_Lamp_Jelly_Roll_NG = 1;		// 불량 판정 시 JR - NG Lamp Bit ON
			//P_Program_Monitoring_Lamp_Jelly_Roll_Sepa = 1;	// 불량 판정 시 Sepa - NG Lamp Bit ON
	
			M_Y_PLC_Stacking_OK_JR = 0; 						// 정상 배출			
			M_Y_PLC_Stacking_NG_JR = 1; 						// 불량 배출 ↓불량일때	
			M_Y_PLC_Full_Stacking_NG_JR_Unload = 0;				// 1)불량-NG배출 정상 스텍 셀 배출
			M_Y_PLC_NonFull_Stacking_NG_JR_Unload = 0;			// 2)블량-NG배출 폐기 배출
			M_Y_PLC_Sepa_Stacking_Unload = 1;					// 3)세파 배출 신호 알림
	}

	rtn = F_TRUE;
return;

sub: Discharge_After_Action(void)		// 추가 계속 하면 됌
	// 카운트 초기화
	P_Cathode_Count = 0;											// 양극 극판 카운트 초기화.
	P_Anode_Count = 0;												// 음극 극판 카운트 초기화.

	P_EXECUTE_IsEnable_Firt_Stacking_Flag = 0

	// IO 및 변수 초기화 란
	P_Current_Cell_Memory_Jelly_Roll = 0;							// 젤리롤 메모리 초기화
										
	//250718
	P_Stack_Judgement_Memory = 0;									// 젤리롤 메모리 유무_(일반 젤리롤 o, 세파모드 적층 진행중 확인 ) 시퀀스 완료 → 세파 첫장 홈 미진행 변수 초기화.
	M_Y_PLC_Stacking_OK_JR = 0;										// 3.1) 정상 Cell
	M_Y_PLC_Stacking_NG_JR	= 0;									// 3.2) 불량 Cell	
	M_Y_PLC_Full_Stacking_NG_JR_Unload = 0;							// 3.3) NG 배출 정상 Cell 배출
	M_Y_PLC_NonFull_Stacking_NG_JR_Unload = 0;						// 3.4) NG 배출 폐기 배출
	M_Y_PLC_Sepa_Stacking_Unload = 0;								// 3.5) 세파 Cell
	
	// 2025.04.22 추가
	P_Stack_NG_Code = 0;											//  PLC 측에 전달하는 NG Code 초기화
	P_Stack_PMAC_NG_Code = 0;										//  PMAC 내부 NG Code 초기화
	P_Stack_Table_NG_Count = 0;										//	NG cnt 초기화
	// 첫장 깔때 초기화 필요부분 추가
return;

sub: End_of_Process(void)

return;

sub:Stack_to_Unloader_ID(&Stack_to_Unloader_ID_RTN)         // 2025.12.02 Stack -> 1st 언로더 데이터 이동
	Stack_to_Unloader_ID_RTN = 0;
	
	// 스택 데이터 -> 1차 언로더로 Shift
	M_ASCII_Uloader_1st_Host_ID_Buffer(0) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(0);
	M_ASCII_Uloader_1st_Host_ID_Buffer(1) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(1);
	M_ASCII_Uloader_1st_Host_ID_Buffer(2) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(2);
	M_ASCII_Uloader_1st_Host_ID_Buffer(3) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(3);
	M_ASCII_Uloader_1st_Host_ID_Buffer(4) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(4);
	M_ASCII_Uloader_1st_Host_ID_Buffer(5) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(5);
	M_ASCII_Uloader_1st_Host_ID_Buffer(6) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(6);
	M_ASCII_Uloader_1st_Host_ID_Buffer(7) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(7);
	M_ASCII_Uloader_1st_Host_ID_Buffer(8) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(8);
	M_ASCII_Uloader_1st_Host_ID_Buffer(9) = M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(9);


	// 1차 언로더 램프 상태 업데이트
	if( M_Stack_Host_ID_JR_Result == 1 )				// 젤리롤 OK
	{
		P_1st_ULD_OK_Lamp = 1							// 젤리롤 OK 램프
		P_1st_ULD_NG_Lamp = 0							// 젤리롤 NG 램프
	}
	else if ( M_Stack_Host_ID_JR_Result == 2 )			// 젤리롤 NG
	{
		P_1st_ULD_OK_Lamp = 0							// 젤리롤 OK 램프
		P_1st_ULD_NG_Lamp = 1							// 젤리롤 NG 램프
	}
	else
	{
		P_1st_ULD_OK_Lamp = 0							// 젤리롤 OK 램프
		P_1st_ULD_NG_Lamp = 0							// 젤리롤 NG 램프
	}

	if( M_Stack_Host_ID_Sample_Type != 0 )				//qc 또는 Sample 젤리롤
		P_1st_ULD_Sample_QC_Lamp = 1					//qc, sample 램프
	else
		P_1st_ULD_Sample_QC_Lamp = 0					//qc, sample 램프



	// 스택 데이터 초기화
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(0) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(1) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(2) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(3) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(4) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(5) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(6) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(7) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(8) = 0
	M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(9) = 0


	Stack_to_Unloader_ID_RTN = N_TRUE;
return;


sub: Discharge_Host_ID_Result( &rtn )

	// Host ID 젤리롤 결과 입력
	if(P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence)
	{
		M_Stack_Host_ID_Buffer_Mode = 3;
	}
	else if(P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence)
	{
		M_Stack_Host_ID_Buffer_Mode = 2;
	}
	else if(P_Buffer_Mode_Status_Sequence == N_Dryrun_Status_Sequence)
	{
		M_Stack_Host_ID_Buffer_Mode = 1;
	}
	else
		M_Stack_Host_ID_Buffer_Mode = 0;


	
	if( M_Y_PLC_Stacking_OK_JR == 1 )	
	{
		M_Stack_Host_ID_JR_Result = 1;	// 젤리롤 결과 Ok
		M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(8) = P_Current_JR_Thickness_mm * 100; // 젤리롤 두께

		// 260615 샘플 Data 삽입 및 카운트 증가는 정상 젤리롤일 때만
		// 샘플 여부
		if(P_BTN_Loss_Sample_Flag == 1 && P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence)
		{
			M_Stack_Host_ID_Sample_Type = 1;	// Loss 샘플
		}
		else if(P_BTN_QC_Sample_Flag == 1 && P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence)
		{
			M_Stack_Host_ID_Sample_Type = 2;	// QC 샘플
		}
		else if(P_MSA_Sample_Flag == 1 && P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence)
		{
			M_Stack_Host_ID_Sample_Type = 3;	// [참조 : 26.09.15 MSA 진행후 젤리롤 배출 시 NG 3으로 배출]
		}
		else
		{
			M_Stack_Host_ID_Sample_Type = 0;
		}	
	}
	else if( M_Y_PLC_Stacking_NG_JR == 1 )
	{
		M_Stack_Host_ID_Sample_Type = 0;

		// 260615 샘플 Data 삽입 및 카운트 증가는 정상 젤리롤일 때만
		M_Stack_Host_ID_JR_Result = 2;						// 젤리롤 결과 NG

		if(M_Y_PLC_Full_Stacking_NG_JR_Unload == 1)			// 완적층 젤리롤
		{
			M_Stack_Host_ID_NG_Type = 1; 
			M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(8) = P_Current_JR_Thickness_mm * 100; // 젤리롤 두께
		}
		else if(M_Y_PLC_NonFull_Stacking_NG_JR_Unload == 1) // 중간 배출 젤리롤
		{
			M_Stack_Host_ID_NG_Type = 2;
			M_ASCII_Stack_Work_Host_Sepa_ID_Buffer(9) = P_Current_JR_Thickness_mm * 100; // 젤리롤 두께
		}
		else if(M_Y_PLC_Sepa_Stacking_Unload == 1)	// 세파 
		{
			M_Stack_Host_ID_NG_Type = 3;
		}
		else
			M_Stack_Host_ID_NG_Type = 0;
	}


	rtn = N_TRUE;
return;

sub: Discharge_Vision_DIO(&Discharge_Vision_DIO_RTN)
	//[ 참조 : 260126 비전 마지막장, 첫장 시점 변경 ]
	//M_Y_Vision_Stack_End_Sheet = 1;											// 스텍 마지막장을 쌓는다는것을 알리는 신호 ON
	//M_Y_Vision_Stack_Start_Sheet = 0;										// 스텍 첫장을 쌓는다는것을 알리는 신호 OFF ( 한번더 확인 위한 )
	//M_Y_Vision_Anode_Align_Start = 1;										//	음극 얼라인 비전 첫장 신호 ON ( PMAC -> Align Vision )
	//// 비전한테 알려주는 스타트 신호	
	//M_Y_Vision_Cathode_Align_Start = 1;										//	양극 얼라인 비전 첫장 신호 ON ( PMAC -> Align Vision )
	P_VISION_PLC10_Anode_Align_Start = 1;									//	음극 얼라인 비전 첫장 신호 나갔다는 플래그 
	P_VISION_PLC10_Cathode_Align_Start = 1;									//	양극 얼라인 비전 첫장 신호 나갔다는 플래그 

	Discharge_Vision_DIO_RTN = F_TRUE;
return;

sub: NG_Code_Report(&NG_Code_Report_RTN)
	NG_Code_Report_RTN = 0;
	if( P_Stack_Table_NG_Count != 0 )		
	{
		// 1. pmac 내부 ng code 존재 vision ng code 비존재
		if( P_Stack_PMAC_NG_Code != 0 && P_Stack_Vision_To_NG_Code == 0 )		// 1 && 0
		{
			P_Stack_NG_Code = P_Stack_PMAC_NG_Code;
			NG_Code_Report_RTN = F_TRUE;
		}
		// 2. vision ng code 존재, pmac 내부 ng code 비존재
		else if( P_Stack_PMAC_NG_Code == 0 && P_Stack_Vision_To_NG_Code != 0 )	// 0 && 1
		{
			P_Stack_NG_Code = P_Stack_Vision_To_NG_Code;	
			NG_Code_Report_RTN = F_TRUE;
		}
		// 3. 둘다 ng code 존재
		else if( P_Stack_PMAC_NG_Code != 0 && P_Stack_Vision_To_NG_Code != 0 )	// 1 && 1
		{
			P_Stack_NG_Code = P_Stack_PMAC_NG_Code;	
			NG_Code_Report_RTN = F_TRUE;
		}
		// 4. ng code 늦을경우 ( code Time out )
		else																	// 0 && 0
		{
			if( P_Stack_Vision_NG_Code_IN_Timer > P_Stack_Vision_NG_Code_Time_Over )	// 3초가 지났다면
			{
				P_Stack_NG_Code = 256;
				NG_Code_Report_RTN = F_TRUE;
			}
		}
	}
	else 
	{
		P_Stack_NG_Code = P_Stack_Vision_To_NG_Code;
		NG_Code_Report_RTN = F_TRUE;
	}
return

sub:Interface_Init(void)
	M_Y_Discharge_Avoid_Complete = 0;				// [case 13] 2,3차 언로더 대기 위치 요청 신호.
	M_Y_PLC_Unloader_Grip_Request = 0;				// [case 14] 2,3차 언로더 그립 요청 신호.
	M_Y_1st_Unloader_UnGrip_Complete = 0;			// [case 15] 1차 언로더 언그립 완료 신호.
	M_Y_1st_Avoid_Pos_Discharge_Complete = 0;		// [case 16] 1차 언로더 회피 완료 신호.
	
	M_Y_PLC_Unloader_Ready_Pos_Ack = 0;				// [case 13] 2,3차 언로더 준비 위치 Ack 신호.
	M_Y_PLC_Unloader_Grip_Ack = 0;					// [case 14] 2,3차 언로더 그립 완료 Ack 신호.
	M_Y_PLC_to_1st_Avoid_Request_Ack = 0;			// [case 16] 1차 언로더 회피 요청 Ack 신호.
return

sub:Module_Init(void)
	// 1.0. 모듈 인덱스 초기화.
	P_Suspend_Discharge_Seq_Index = 0;
	// 1.1. 모듈 커맨드 초기화.
	P_Module_Act_Command_Array(0),N_Act_Define_Limit,1 = 0;
	// 1.2. 모듈 커맨드 엣지 초기화.
	P_OLD_Module_Act_Command_Array(0),N_Act_Define_Limit,1 = 0;
	// 1.3. 모듈 동작 시퀀스 스텟머신 초기화.
	P_Module_Act_State_Machine_Array(0),N_Act_Define_Limit,1 = 0;
	// 1.4. 모듈 동작 완료 초기화.
	P_Act_Complete_Bit(0),N_Act_Define_Limit,1 = 0;
return

sub:Trans_In(void)
	// IO 추가.
return

sub: Module_Reset(&rtn)
// 모듈 초기화 구문 추가 [ 추후 정리 필요 ] 25.06.05
M_Y_PLC_JR_Data_Produce_Signal = 0
M_Y_PLC_to_Memory_Data_Parsing_Request = 0
M_Y_Discharge_Avoid_Complete = 0;				// [case 13] 2,3차 언로더 대기 위치 요청 신호.
M_Y_PLC_Unloader_Grip_Request = 0;				// [case 14] 2,3차 언로더 그립 요청 신호.
M_Y_1st_Unloader_UnGrip_Complete = 0;			// [case 15] 1차 언로더 언그립 완료 신호.
M_Y_1st_Avoid_Pos_Discharge_Complete = 0;		// [case 16] 1차 언로더 회피 완료 신호.
M_Y_PLC_Unloader_Ready_Pos_Ack = 0;				// [case 13] 2,3차 언로더 준비 위치 Ack 신호.
M_Y_PLC_Unloader_Grip_Ack = 0;					// [case 14] 2,3차 언로더 그립 완료 Ack 신호.
M_Y_PLC_to_1st_Avoid_Request_Ack = 0;			// [case 16] 1차 언로더 회피 요청 Ack 신호.
M_Y_PLC_to_Memory_Data_Parsing_Request = 0;
// 1.1. 모듈 커맨드 초기화.
P_Module_Act_Command_Array(0),N_Act_Define_Limit,1 = 0;
// 1.2. 모듈 커맨드 엣지 초기화.
P_OLD_Module_Act_Command_Array(0),N_Act_Define_Limit,1 = 0;
// 1.3. 모듈 동작 시퀀스 스텟머신 초기화.
P_Module_Act_State_Machine_Array(0),N_Act_Define_Limit,1 = 0;
// 1.4. 모듈 동작 완료 초기화.
P_Act_Complete_Bit(0),N_Act_Define_Limit,1 = 0;
// 1.5  EPC 자동 → 수동 요청						// [ 참고 : 2025.10.15 미비 사항 추가 건 ]
M_Y_EPC_Vertical_Panel_Manual_Signal = 1;		// 배출 시 EPC 보정 X
rtn = F_TRUE;
return;

// ========================================================================================================================
// PackML 초기화 DIO  [ 2025.06.24 추가 ]
// ========================================================================================================================

sub: Discharge_PackML_Reset(&rtn)

M_Y_PLC_Stacking_OK_JR					= 0;
M_Y_PLC_Stacking_NG_JR					= 0;
M_Y_PLC_Full_Stacking_NG_JR_Unload		= 0;
M_Y_PLC_NonFull_Stacking_NG_JR_Unload	= 0;
M_Y_PLC_Sepa_Stacking_Unload			= 0;
P_Stack_NG_Code	= 0;	
P_Stack_PMAC_NG_Code = 0;

rtn = N_TRUE;
return;

close

