					else if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 20 && P_Recipe_M22_POS(3) - 5 < P_Anode_2nd_PNP_Z_Real_Move_Pos)
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Abs_Trans_Cur_Pos;
						P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_2nd_PnP_AN_Z;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_AN_Z;

					}
					else if(P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(2) - 20 && P_Recipe_M45_POS(4) - 5 < P_Motor_Current_Pos(N_NG_PnP_AN_Z))
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Abs_Trans_Cur_Pos;
						P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_NG_PnP_AN_Z;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_NG_PnP_AN_Z;
					}
					//================================ 미사용 위치 인터락 ===========================================
					//P_No1_Recipe_Pos_IL(N_Align_AN_Y) = 0;			// 인터락
					P_No2_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
				}
				else if( P_IL_Outer_Status == IL_Out_Close )
				{
					P_No1_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Align_AN_Y) = 1;			// 인터락
				}
			break;			
			case N_Align_AN_T:
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);		// NG PNP는 절대위치 반환이 안됨...
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
				{
					if(P_Motor_Current_Pos(N_1st_PnP_AN_T) > 70 && P_Recipe_M18_POS(6) - 5 < P_Anode_1st_PNP_Z_Real_Move_Pos /*하강위치-5*/)
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Abs_Trans_Cur_Pos;
						P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_1st_PnP_AN_Z;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_1st_PnP_AN_Z;
					}
					else if( P_Motor_Current_Pos(N_2nd_PnP_AN_T) < 20 && P_Recipe_M22_POS(3) - 5 < P_Anode_2nd_PNP_Z_Real_Move_Pos)
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Abs_Trans_Cur_Pos;
						P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_2nd_PnP_AN_Z;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_2nd_PnP_AN_Z;

					}
					else if(P_Motor_Current_Pos(N_NG_PnP_AN_T) > P_Recipe_M43_POS(2) - 20 && P_Recipe_M45_POS(4) - 5 < P_Motor_Current_Pos(N_NG_PnP_AN_Z))
					{
						P_Limit_PosData(Hex_IL_Plus) = P_Abs_Trans_Cur_Pos;
						P_Limit_PosData(Hex_IL_Minus) = P_Abs_Trans_Cur_Pos;
						P_Collision_Risk_Motor(Hex_IL_Minus) = N_NG_PnP_AN_Z;
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_NG_PnP_AN_Z;
					}
					//================================ 미사용 위치 인터락 ===========================================
					//P_No1_Recipe_Pos_IL(N_Align_AN_T) = 0;			// 인터락
					P_No2_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
				}
				else if( P_IL_Outer_Status == IL_Out_Close )
				{
					P_No1_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No2_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Align_AN_T) = 1;			// 인터락
				}
			break;

			case N_SHEET_PAPER_X:
			// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<Recipe Pos Run 인터락 부분>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
				P_Abs_Trans_Cur_Pos = P_Motor_Current_Pos(P_IL_Motor_Page);		// Sheet Paper X [#35] - 엔코더 위치가 곧 절대위치
			//================================ 1번위치 -대기 위치 ================================
				//if(P_Motor_Current_Pos(N_SHEET_PAPER_X) ~ P_Recipe_M35_POS(1) && P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(1) + 1 )	
				if(P_Motor_Current_Pos(N_SHEET_PAPER_X) ~ P_Recipe_M35_POS(1) && P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(1) + 0.5 )	// [ 참조 : 26.10.02 인터락 조건 추가 ]		
					P_No1_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;
				else
					P_No1_Recipe_Pos_IL(N_SHEET_PAPER_X) = 0;
			//================================ 2번위치 -전진 위치 ================================
				
				//if(P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(1) + 1 )		
				if(P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(1) + 0.5 )		// [ 참조 : 26.10.02 인터락 조건 추가 ]
					P_No2_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;
				else
					P_No2_Recipe_Pos_IL(N_SHEET_PAPER_X) = 0;
			//================================ 미사용 위치 인터락 ===========================================
					//P_No1_Recipe_Pos_IL(N_SHEET_PAPER_X) = 0;			// 인터락
					//P_No2_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No3_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No4_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No5_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No6_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No7_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_SHEET_PAPER_X) = 1;			// 인터락
				// [ 참조 : 26.10.02 인터락 조건 추가 ]
				if(P_IL_Outer_Status == N_IL_Normal_Pos)
				{
				// ================================ 플러스 간섭 요인 : <<Final Roll>> ==================================//	
					if(P_Motor_Current_Pos(N_FINAL_ROLL_X) < P_Recipe_M12_POS(2) + 0.5 && P_Motor_Current_Pos(N_FINAL_ROLL_Z) > P_Recipe_M13_POS(1) + 0.5)
					{ // 파이널 롤러 Z축이 대기 위치보다 낮게 있을 경우 → 구동 불가.
						P_Limit_PosData(Hex_IL_Plus) = -150;			// 파이널 롤러 X축 -리밋 일 때 시트 페이퍼 X축 Enc
						P_Collision_Risk_Motor(Hex_IL_Plus) = N_FINAL_ROLL_Z;					
					}
				}
			break;
		}
	}
	else		// 외부 인터락 모터 중 HomeComplete가 꺼졌을 때.
	{	
		P_No1_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No2_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No3_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No4_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No5_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No6_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No7_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No8_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No9_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
		P_No10_Recipe_Pos_IL(P_IL_Motor_Page) = 1;			// 인터락
	}

	if(P_IL_Outer_Status != IL_Out_Close)
	{
		if(P_IL_Motor_Page == N_FINAL_ROLL_Z || P_IL_Motor_Page == N_1st_PnP_CA_Z || P_IL_Motor_Page == N_1st_PnP_AN_Z || P_IL_Motor_Page == N_2nd_PnP_CA_Z || P_IL_Motor_Page == N_2nd_PnP_AN_Z || P_IL_Motor_Page == N_UNLOADER_Z)
		{
			if(P_IL_Outer_Status != N_IL_Belt_Down_Pos && P_IL_Outer_Status != N_IL_Align_Down_Pos &&  P_IL_Outer_Status != N_IL_Stack_Down_Pos)	// 양,음극 1,2차 PNP Z축에서 P_IL_Robot_Bit 비트 연산이 계속 되어 조건 추가. [ 참조 : 26.10.02 인터락 조건 추가 ]
			{
				// 절대위치 기준은 위쪽방향이 플러스인데, 위쪽이 마이너스 아래쪽이 플러스로 보는 구조임.
				if(P_Limit_PosData(Hex_IL_Plus) != N_Nan)
				{
					if(P_Limit_PosData(Hex_IL_Plus) < P_Abs_Trans_Cur_Pos)
					{
						P_IL_Popup_Motor = P_Collision_Risk_Motor(Hex_IL_Plus);
						P_IL_Robot_Bit |= Hex_IL_Minus;
					}
					else
					{
						P_IL_Robot_Bit &= Hex_IL_Plus;			// 플러스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며  Minus Bit 0만들기 위함
					}
				}
				else
				{
					P_IL_Robot_Bit &= Hex_IL_Plus;				// 플러스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며  Minus Bit 0만들기 위함
				}

				if(P_Limit_PosData(Hex_IL_Minus) != N_Nan)
				{
					if(P_Limit_PosData(Hex_IL_Minus) > P_Abs_Trans_Cur_Pos)
					{
						P_IL_Popup_Motor = P_Collision_Risk_Motor(Hex_IL_Minus);
						P_IL_Robot_Bit |= Hex_IL_Plus;
					}
					else
					{
						P_IL_Robot_Bit &= Hex_IL_Minus;			// 마이너스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며 Plus Bit 0만들기 위함
					}
				}
				else
				{
					P_IL_Robot_Bit &= Hex_IL_Minus;				// 마이너스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며 Plus Bit 0만들기 위함
				}
			}
		}
		else
		{
			if(P_IL_Outer_Status != N_IL_Belt_Down_Pos && P_IL_Outer_Status != N_IL_Align_Down_Pos && P_IL_Outer_Status != N_IL_Stack_Down_Pos )	// 양,음극 1,2차 PNP Z축에서 P_IL_Robot_Bit 비트 연산이 계속 되어 조건 추가. [ 참조 : 26.10.02 인터락 조건 추가 ]
			{
				// 현재 위치보다 설정된 플러스 방향 인터락 위치가 커지면
				if(P_Limit_PosData(Hex_IL_Plus) != N_Nan)
				{
					if(P_Limit_PosData(Hex_IL_Plus) <= P_Abs_Trans_Cur_Pos)
					{
						P_IL_Popup_Motor = P_Collision_Risk_Motor(Hex_IL_Plus);
						P_IL_Robot_Bit |= Hex_IL_Plus;
					}
					else
					{
						P_IL_Robot_Bit &= Hex_IL_Minus;			// 마이너스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며 Plus Bit 0만들기 위함
					}
				}
				else
				{
					P_IL_Robot_Bit &= Hex_IL_Minus;				// 마이너스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며 Plus Bit 0만들기 위함
				}

				if(P_Limit_PosData(Hex_IL_Minus) != N_Nan)
				{
					if(P_Limit_PosData(Hex_IL_Minus) >= P_Abs_Trans_Cur_Pos)
					{
						P_IL_Popup_Motor = P_Collision_Risk_Motor(Hex_IL_Minus);
						P_IL_Robot_Bit |= Hex_IL_Minus;
					}
					else
					{
						P_IL_Robot_Bit &= Hex_IL_Plus;			// 플러스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며  Minus Bit 0만들기 위함
					}
				}
				else
				{
					P_IL_Robot_Bit &= Hex_IL_Plus;				// 플러스를 &처리 하는 이유는 Bit에 Plus 값이 있을 수 있으며  Minus Bit 0만들기 위함
				}
			}
		}
	}

	if(P_IL_Motor_Page != 0)
	{
		// -- 1번째 레시피 위치 인터락 ----------------------- //
		if( P_No1_Recipe_Pos_IL(P_IL_Motor_Page) == 1 )
		{	// 조그동작 불가능한 상태
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $FE
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $1
		}
		// -- 2번째 레시피 위치 인터락 ----------------------- //
		if( P_No2_Recipe_Pos_IL(P_IL_Motor_Page) == 1 )
		{	// 조그동작 불가능한 상태
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $FD
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $2
		}	
		// -- 3번째 레시피 위치 인터락 ----------------------- //
		if( P_No3_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $FB
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $4
		}
		// -- 4번째 레시피 위치 인터락 ----------------------- //
		if( P_No4_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $F7
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $8
		}
		// -- 5번째 레시피 위치 인터락 ----------------------- //
		if( P_No5_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $EF
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $10
		}
		// -- 6번째 레시피 위치 인터락 ----------------------- //
		if( P_No6_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $DF
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $20
		}
		// -- 7번째 레시피 위치 인터락 ----------------------- //
		if( P_No7_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $BF
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $40
		}
		// -- 8번째 레시피 위치 인터락 ----------------------- //
		if( P_No8_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $37F
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $80
		}
		// -- 9번째 레시피 위치 인터락 ----------------------- //
		if( P_No9_Recipe_Pos_IL(P_IL_Motor_Page) == 1  )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $2FF
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $100
		}
		// -- 10번째 레시피 위치 인터락 ----------------------- //
		if( P_No10_Recipe_Pos_IL(P_IL_Motor_Page) == 1 )
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) &= $1FF
		}	
		else  
		{
			P_Recipe_POS_Interock_M(P_IL_Motor_Page) |= $200
		}
	}

	// 인터락 램프 추가.
	// -> 램프는 1이면 이동가능(인터락해제상태), P_Recipe_POS_Interock_M(Motor)변수는 1이면 이동가능(인터락상태)이기때문.
	// -> 램프 0 이면 이동 불가능 P_Recipe_POS_Interock_M(Motor) = 자릿수 비트 0 이동 불가
	M_Motor_Recipe_Pos_Interlock(P_IL_Motor_Page) = ( P_Recipe_POS_Interock_M(P_IL_Motor_Page) & N_Hex_Pos_All_InterLock_On );

	// 7. 인터락 팝업 처리 ======================================================================================================================
	if( P_Interlock_Popup_On_Flag == N_TRUE )
	{
		P_Interlock_Popup_On_Flag = 0;								// Flag 초기화
		P_IL_Sprint = memset(F_IL_Cdata,0,N_IL_memset_size);		// Data 초기화
		P_IL_length = strlen(F_IL_Cdata);							// 문자열 길이 초기화
		
		if( P_IL_Popup_Motor == N_Home_Miss )						// 홈 미스로 들어왔다면
		{
			nop(sprintf(F_IL_Cdata," Must Do Ready "));				// 홈 필요 문구 출력
			nop (sprintf(F_IL_Cdata2," Please PUSH Ready BTN  "));	// 홈 필요 문구 출력
		}
		else if( P_IL_Popup_Motor == N_JR_Prod_Popup )
		{
			nop (sprintf(F_IL_Cdata," Stack Unit "));				// 적층중이라 움직일수없다.
			nop(sprintf(F_IL_Cdata2," Cant Move While Stacking "));	// 적층중이라 움직일수없다.
		}
		else if(P_IL_Popup_Motor == N_Door_Open )					//[ 참조 : 260522 : 양음극 릴컷부 도어 오픈 시 1차 PNP 인터락 ]
		{
			nop (sprintf(F_IL_Cdata," Door Close "));				// 적층중이라 움직일수없다.
			nop(sprintf(F_IL_Cdata2," Please Close The Door "));	// 적층중이라 움직일수없다.
		}
		else if(P_IL_Popup_Motor == N_NG_Box_Open )					//[참조 : 260601 : 양음극 NG BOX 도어 오픈 시 조그 인터락 ]
		{
			nop(sprintf(F_IL_Cdata," Ng Box Open "));				// NG Box 감지 확인 알람
		}
		else if(P_IL_Popup_Motor == N_1st_Cell_Existence )			//[참조 : 20260716 1차 PNP에 극판 존재 시 피커 T축 인터락 ]
		{
			nop(sprintf(F_IL_Cdata," 1st Sheet Cell Check "));		// 1차 PNP 시트 확인 알람 
		}
		else														// 홈 미스로 들어오지 않았다면
		{
			call Popup.UI(M_Motor_BTN_Info(P_IL_Motor_Page));		// 문자열 대입 시작
			P_IL_Popup_Motor = 0;									// 팝업 모터 초기화
		
			P_IL_Recipe_Bit = 0;										// 레시피포스 초기화
			P_Limit_PosData(Hex_IL_Plus) = N_Nan;
			P_Limit_PosData(Hex_IL_Minus) = N_Nan;
			P_Collision_Risk_Motor(Hex_IL_Plus) = 0;
			P_Collision_Risk_Motor(Hex_IL_Minus) = 0;
			P_Plus_IL_Offset = 0;
			P_Minus_IL_Offset = 0;
			P_IL_Robot_Bit = 0;
		}	
		if ( P_X_Interlock_Popup_On_Request_Ack == 0 )			// 26.09.29 팝업이 꺼져있을 때 팝업을 띄울 수 있도록 수정.
		{
			P_Y_Interlock_Popup_On_Request = 1;							// PLC 팝업 요청 
		}
	}
	// 인터락 PLC 전송 프로그램 ======================================================================================================================

}
else	// 인터락 프로그램 미실행일때 변수 초기화
{
	P_IL_Popup_Motor = 0;
	P_IL_Recipe_Bit = 0;											
	P_Limit_PosData(Hex_IL_Plus) = N_Nan;
	P_Limit_PosData(Hex_IL_Minus) = N_Nan;
	P_Collision_Risk_Motor(Hex_IL_Plus) = 0;
	P_Collision_Risk_Motor(Hex_IL_Minus) = 0;
	P_Plus_IL_Offset = 0;
	P_Minus_IL_Offset = 0;
	P_IL_Robot_Bit = 0;
	P_IL_Coord_Robot = 0;
	P_IL_Outer_Status = 0;
	P_IL_Inside_Home_Chk_Complete = 0;
	P_IL_Outside_Home_Chk_Complete = 0;
	P_IL_Home_Chk_Motor_Update = 0;
	P_Recipe_POS_Interock_M(1),48 = $3F
	M_Motor_Recipe_Pos_Interlock(1),48=$3F
}

// 팝업 요청	
//if( P_Y_Interlock_Popup_On_Request == 1 && P_X_Interlock_Popup_On_Request_Ack == 1 )
//{
//	//send0,"%s",F_IL_Cdata;	// 테스트용
//	P_Y_Interlock_Popup_On_Request = 0;
//}

// Motor Page Num 대입

if(P_Jog_Page_Flag == 0)
{
	if(L_Motor_Num > 0 && L_Motor_Num < 48)
	{
		if(P_InterLock_Motor_Num == P_Recipe_Move_IL_Loop)
		{
			L_Motor_Num++;
			P_InterLock_Motor_Num = 0;
		}
	}
	else
	{
		L_Motor_Num = 1;
	}
	P_IL_Motor_Page = L_Motor_Num;
	P_InterLock_Motor_Num++;
	
	if( Sys.Idata[11199] == 0)
	{
		P_IL_Motor_Page = 0;
	}
}
else if(P_Jog_Page_Flag == 1)
{
	if( Sys.Idata[11199] >= 0 && Sys.Idata[11199] <= 48 )
		P_IL_Motor_Page = Sys.Idata[11199];
	else
		P_IL_Motor_Page = 0;
}
close

