		// 444) 애러.
		if ( P_Module_Act_State_Machine_Array(N_Act_Use_Plate_Cutter_BWD) == N_Error_Step )								// 애러 상태 일 경우.
		{
			P_Suspend_ARC_Module_Error = N_Act_Use_Plate_Cutter_BWD;													// Suspend 모듈 정지.		[ 참조 : 26.01.08 Suspend 모듈 수정 ]
			P_Suspend_ARC_Use_Plate_Cutter_BWD_Popup_Flag = 1;															// 사용 플레이트 커터 후진 오류 팝업 플래그.	[ 참조 : 26.04.24 Suspend 모듈 팝업 추가 ]
			if ( P_Selected_Spool_Number == N_ARC_Upper_Spool )															// 상부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Upper_Cutter_Fwd_Bwd_Error, N_High_Alarm_Cycle_Stop);
			else if ( P_Selected_Spool_Number == N_ARC_Lower_Spool )													// 하부 스풀 선택 일 경우.
				call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Lower_Cutter_Fwd_Bwd_Error, N_High_Alarm_Cycle_Stop);
