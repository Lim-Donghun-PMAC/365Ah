// 서보댄서 모터 번호 16
EncTable[0].type = 1;											// 단일 레지스터의 읽기 
EncTable[0].pEnc = Gate3[4].Chan[3].ServoCapt.a;//Sys.Idata[N_SERVO_DANCER].a//EncTable[16].a;								// 소스 데이터 주소 
//EncTable[0].pEnc = Gate3[4].Chan[1].ServoCapt.a	// 소스 데이터 주소
