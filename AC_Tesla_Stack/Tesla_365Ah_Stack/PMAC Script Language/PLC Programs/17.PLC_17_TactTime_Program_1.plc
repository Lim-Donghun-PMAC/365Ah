	if ( M_Y_FR_Sepa_Clamp_FWD_Sol == 1 && M_Y_FR_Sepa_Clamp_BWD_Sol == 0 )			// 클램프 ON.
	{
		P_Tact_Time_Final_Roller_Unclamp = 0;
