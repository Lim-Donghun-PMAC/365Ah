//======================================================================================================
// 프로그램 개정이력
//======================================================================================================
// 25.07.29 
// 알람 프로그램 표준화 작업 - [ 참조 : 25.07.29 알람 프로그램 표준화 작업 진행 ]

open plc 26
// 04. 타이머를 쉽게 사용하기 위한 로컬 모듈 
#define	L_System_Timer				Sys.Time				// 시스템 타이머

Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[26].Ldata.L[0] 시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[26].Ldata.L[1] 시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[26].Ldata.L[2] 시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[26].Ldata.L[3] 타이머 초기화 플래그
local	L_Local_Axis;									// Plc[26].Ldata.L[4] Local Motor 번호 순환 변수
local	L_Ecat_Axis;									// Plc[26].Ldata.L[5] Ecat Motor 번호 순환 변수
local	L_Home_Alarm_Timer_Init_Flag(50);				// Plc[26].Ldata.L[6 ~ 55]
local	L_Home_Alarm_Timer(50);							// Plc[26].Ldata.L[56 ~ 105]
local	L_Alarm_Occur_Cycle_Stop_Flag_Old;				// Plc[26].Ldata.L[106] 사이클스탑 알람 이전 상태
local	L_Alarm_Occur_Emergency_Stop_Flag_Old;			// Plc[26].Ldata.L[107] 즉시정지 알람 이전 상태

//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if( L_Flag_Cycle_Up_Count_Init_Flag == 0 )
{	// 시간 간격 초기화
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 00.2) 시간 체크
if( L_Flag_Cycle_Up_Count_Init_Flag == 1 )
{	
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * N_Time_Scale;
	if( L_Time_Cycle_Up_Count_Delta_Time < 0 )
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}
// 00.3) 시간 업데이트
if(L_Time_Cycle_Up_Count_Delta_Time > N_Range_Update_Interval)
{	
	P_Alarm_Delay_Timer = P_Alarm_Delay_Timer + L_Time_Cycle_Up_Count_Delta_Time;
	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}

//==========================================================================================================================================================================================================================================
// Alarm Program
//===========================================================//
//
if( P_NEW_Alarm_USE_Flag == 0 )	// [ 참조 : 26.10.26 알람 리팩토링 추가 ]
{
	if(P_Alarm_Arr(0) > 0)
	{
		// 알람 갯수에서 알람갯수 -1
	
		if(P_First_Alarm_Flag == 0 || (P_Alarm_Delay_Timer > P_Alarm_Wait_Time))
		{
			P_Alarm_Index++;									
			P_Alarm_Num = P_Alarm_Arr(P_Alarm_Index);			// 다음 순서 알람 
			P_Alarm_Arr(P_Alarm_Index) = 0;						// 알람 제거
	
			P_Alarm_Log(99) = P_Alarm_Log(98);
			P_Alarm_Log(98) = P_Alarm_Log(97);
			P_Alarm_Log(97) = P_Alarm_Log(96);
			P_Alarm_Log(96) = P_Alarm_Log(95);
			P_Alarm_Log(95) = P_Alarm_Log(94);
			P_Alarm_Log(94) = P_Alarm_Log(93);
			P_Alarm_Log(93) = P_Alarm_Log(92);
			P_Alarm_Log(92) = P_Alarm_Log(91);
			P_Alarm_Log(91) = P_Alarm_Log(90);
			P_Alarm_Log(90) = P_Alarm_Log(89);
			P_Alarm_Log(89) = P_Alarm_Log(88);
			P_Alarm_Log(88) = P_Alarm_Log(87);
			P_Alarm_Log(87) = P_Alarm_Log(86);
			P_Alarm_Log(86) = P_Alarm_Log(85);
			P_Alarm_Log(85) = P_Alarm_Log(84);
			P_Alarm_Log(84) = P_Alarm_Log(83);
			P_Alarm_Log(83) = P_Alarm_Log(82);
			P_Alarm_Log(82) = P_Alarm_Log(81);
			P_Alarm_Log(81) = P_Alarm_Log(80);
			P_Alarm_Log(80) = P_Alarm_Log(79);
			P_Alarm_Log(79) = P_Alarm_Log(78);
			P_Alarm_Log(78) = P_Alarm_Log(77);
			P_Alarm_Log(77) = P_Alarm_Log(76);
			P_Alarm_Log(76) = P_Alarm_Log(75);
			P_Alarm_Log(75) = P_Alarm_Log(74);
			P_Alarm_Log(74) = P_Alarm_Log(73);
			P_Alarm_Log(73) = P_Alarm_Log(72);
			P_Alarm_Log(72) = P_Alarm_Log(71);
			P_Alarm_Log(71) = P_Alarm_Log(70);
			P_Alarm_Log(70) = P_Alarm_Log(69);
			P_Alarm_Log(69) = P_Alarm_Log(68);
			P_Alarm_Log(68) = P_Alarm_Log(67);
			P_Alarm_Log(67) = P_Alarm_Log(66);
			P_Alarm_Log(66) = P_Alarm_Log(65);
			P_Alarm_Log(65) = P_Alarm_Log(64);
			P_Alarm_Log(64) = P_Alarm_Log(63);
			P_Alarm_Log(63) = P_Alarm_Log(62);
			P_Alarm_Log(62) = P_Alarm_Log(61);
			P_Alarm_Log(61) = P_Alarm_Log(60);
			P_Alarm_Log(60) = P_Alarm_Log(59);
			P_Alarm_Log(59) = P_Alarm_Log(58);
			P_Alarm_Log(58) = P_Alarm_Log(57);
			P_Alarm_Log(57) = P_Alarm_Log(56);
			P_Alarm_Log(56) = P_Alarm_Log(55);
			P_Alarm_Log(55) = P_Alarm_Log(54);
			P_Alarm_Log(54) = P_Alarm_Log(53);
			P_Alarm_Log(53) = P_Alarm_Log(52);
			P_Alarm_Log(52) = P_Alarm_Log(51);
			P_Alarm_Log(51) = P_Alarm_Log(50);
			P_Alarm_Log(50) = P_Alarm_Log(49);
			P_Alarm_Log(49) = P_Alarm_Log(48);
			P_Alarm_Log(48) = P_Alarm_Log(47);
			P_Alarm_Log(47) = P_Alarm_Log(46);
			P_Alarm_Log(46) = P_Alarm_Log(45);
			P_Alarm_Log(45) = P_Alarm_Log(44);
			P_Alarm_Log(44) = P_Alarm_Log(43);
			P_Alarm_Log(43) = P_Alarm_Log(42);
			P_Alarm_Log(42) = P_Alarm_Log(41);
			P_Alarm_Log(41) = P_Alarm_Log(40);
			P_Alarm_Log(40) = P_Alarm_Log(39);
			P_Alarm_Log(39) = P_Alarm_Log(38);
			P_Alarm_Log(38) = P_Alarm_Log(37);
			P_Alarm_Log(37) = P_Alarm_Log(36);
			P_Alarm_Log(36) = P_Alarm_Log(35);
			P_Alarm_Log(35) = P_Alarm_Log(34);
			P_Alarm_Log(34) = P_Alarm_Log(33);
			P_Alarm_Log(33) = P_Alarm_Log(32);
			P_Alarm_Log(32) = P_Alarm_Log(31);
			P_Alarm_Log(31) = P_Alarm_Log(30);
			P_Alarm_Log(30) = P_Alarm_Log(29);
			P_Alarm_Log(29) = P_Alarm_Log(28);
			P_Alarm_Log(28) = P_Alarm_Log(27);
			P_Alarm_Log(27) = P_Alarm_Log(26);
			P_Alarm_Log(26) = P_Alarm_Log(25);
			P_Alarm_Log(25) = P_Alarm_Log(24);
			P_Alarm_Log(24) = P_Alarm_Log(23);
			P_Alarm_Log(23) = P_Alarm_Log(22);
			P_Alarm_Log(22) = P_Alarm_Log(21);
			P_Alarm_Log(21) = P_Alarm_Log(20);
			P_Alarm_Log(20) = P_Alarm_Log(19);
			P_Alarm_Log(19) = P_Alarm_Log(18);
			P_Alarm_Log(18) = P_Alarm_Log(17);
			P_Alarm_Log(17) = P_Alarm_Log(16);
			P_Alarm_Log(16) = P_Alarm_Log(15);
			P_Alarm_Log(15) = P_Alarm_Log(14);
			P_Alarm_Log(14) = P_Alarm_Log(13);
			P_Alarm_Log(13) = P_Alarm_Log(12);
			P_Alarm_Log(12) = P_Alarm_Log(11);
			P_Alarm_Log(11) = P_Alarm_Log(10);
			P_Alarm_Log(10) = P_Alarm_Log(9);
			P_Alarm_Log(9) = P_Alarm_Log(8);
			P_Alarm_Log(8) = P_Alarm_Log(7);
			P_Alarm_Log(7) = P_Alarm_Log(6);
			P_Alarm_Log(6) = P_Alarm_Log(5);
			P_Alarm_Log(5) = P_Alarm_Log(4);
			P_Alarm_Log(4) = P_Alarm_Log(3);
			P_Alarm_Log(3) = P_Alarm_Log(2);
			P_Alarm_Log(2) = P_Alarm_Log(1);
			P_Alarm_Log(1) = P_Alarm_Log(0);
			P_Alarm_Log(0) = P_Alarm_Num;
	
		}
	
		if(P_Alarm_Index == P_Alarm_Arr(0))						// 알람처리 완료 후 초기화
		{
			P_Alarm_Index = 0;
			P_Alarm_Arr(0) = 0;
		}
	
		// 첫번째 알람이후 2초 뒤 나머지 발생시켜야함
		// 첫번째 알람 플래그 상승
		if(P_First_Alarm_Flag == 0)
		{
			P_First_Alarm_Flag = 1;
			P_Alarm_Delay_Timer = 0;						// 첫번째 알람 발생 이후 다음 알람 처리를 위한 타이머 초기화
			M(P_Alarm_Num) = 1;								// PLC에 알람 송신
	
			// 260715 첫번째 발생한 알람 로그 추가
			P_First_Alarm_Log(29) = P_First_Alarm_Log(28);
			P_First_Alarm_Log(28) = P_First_Alarm_Log(27);
			P_First_Alarm_Log(27) = P_First_Alarm_Log(26);
			P_First_Alarm_Log(26) = P_First_Alarm_Log(25);
			P_First_Alarm_Log(25) = P_First_Alarm_Log(24);
			P_First_Alarm_Log(24) = P_First_Alarm_Log(23);
			P_First_Alarm_Log(23) = P_First_Alarm_Log(22);
			P_First_Alarm_Log(22) = P_First_Alarm_Log(21);
			P_First_Alarm_Log(21) = P_First_Alarm_Log(20);
			P_First_Alarm_Log(20) = P_First_Alarm_Log(19);
			P_First_Alarm_Log(19) = P_First_Alarm_Log(18);
			P_First_Alarm_Log(18) = P_First_Alarm_Log(17);
			P_First_Alarm_Log(17) = P_First_Alarm_Log(16);
			P_First_Alarm_Log(16) = P_First_Alarm_Log(15);
			P_First_Alarm_Log(15) = P_First_Alarm_Log(14);
			P_First_Alarm_Log(14) = P_First_Alarm_Log(13);
			P_First_Alarm_Log(13) = P_First_Alarm_Log(12);
			P_First_Alarm_Log(12) = P_First_Alarm_Log(11);
			P_First_Alarm_Log(11) = P_First_Alarm_Log(10);
			P_First_Alarm_Log(10) = P_First_Alarm_Log(9);
			P_First_Alarm_Log(9) = P_First_Alarm_Log(8);
			P_First_Alarm_Log(8) = P_First_Alarm_Log(7);
			P_First_Alarm_Log(7) = P_First_Alarm_Log(6);
			P_First_Alarm_Log(6) = P_First_Alarm_Log(5);
			P_First_Alarm_Log(5) = P_First_Alarm_Log(4);
			P_First_Alarm_Log(4) = P_First_Alarm_Log(3);
			P_First_Alarm_Log(3) = P_First_Alarm_Log(2);
			P_First_Alarm_Log(2) = P_First_Alarm_Log(1);
			P_First_Alarm_Log(1) = P_First_Alarm_Log(0);
			P_First_Alarm_Log(0) = P_Alarm_Num;
	
		}
		else
		{
			if(P_Alarm_Delay_Timer > P_Alarm_Wait_Time)
			{
				M(P_Alarm_Num) = 1;							// PLC에 알람 송신
			}
		}
	
		P_Alarm_Num = 0;
		P_Alarm_Occur_Index_Flag(P_Compare_Priority) = 1;	// 발생한 알람중 가장 높은 순위의 커멘드 발생
	}
}
else if( P_NEW_Alarm_USE_Flag == 1 )		// [ 참조 : 26.10.26 알람 리팩토링 추가 ]
{
	//===========================================================//
	local L_Alarm_Index;			//Plc[26].Ldata.L[108]
	local L_Alarm_Logging_Index;	//Plc[26].Ldata.L[109]
	
	if( P_Alarm_Get_Flag == 1 )
	{
		if( P_Alarm_Frist_Flag == 0 ||  P_Alarm_Delay_time + 2 < Sys.RunTime )		// delay 2sec
		{
			if( P_Alarm_Frist_Flag == 0 )
			{
				P_Alarm_Frist_Flag = 1;
				P_Alarm_Delay_time = Sys.RunTime;
				L_Alarm_Index = 2500;
				L_Alarm_Logging_Index = 0;
				P_Alarm_Log(0),N_Alarm_Max_Cnt = 0;
				P_Alarm_Time_Log(0),N_Alarm_Max_Cnt = 0;
			}
	
			if( L_Alarm_Logging_Index < N_Alarm_Max_Cnt && Sys.Udata[L_Alarm_Index] )
			{
				M(Sys.Udata[L_Alarm_Index]) = 1;
	
				P_Alarm_Log(L_Alarm_Logging_Index) = Sys.Udata[L_Alarm_Index];
				L_Alarm_Index++;
				P_Alarm_Time_Log(L_Alarm_Logging_Index) = Sys.Udata[L_Alarm_Index];
				L_Alarm_Logging_Index++;
				L_Alarm_Index++;
			}	
		}
	}
	if( P_Compare_Priority >= N_High_Alarm_Emergency_Stop && P_Compare_Priority <= N_Low_Alarm )
	{
		P_Alarm_Occur_Index_Flag(P_Compare_Priority) = 1;	// 발생한 알람중 가장 높은 순위의 커멘드 발생
	}
}
//----------------------------------------------------------------------------------------------------------------------------------------------------------//
// 알람 우선 순위에 따른 알람 발생 Flag 구분 [ [1] N_High_Alarm_Emergency_Stop : 즉시 정지, [2] N_High_Alarm_Cycle_Stop : 사이클 정지, [3] N_Low_Alarm : 경고 ]
//----------------------------------------------------------------------------------------------------------------------------------------------------------//

if(P_Alarm_Occur_Index_Flag(N_High_Alarm_Emergency_Stop) == 1 && L_Alarm_Occur_Emergency_Stop_Flag_Old == 0)
{
	if(P_PMAC_Current_Mode == F_Current_Automatic)			// Auto 모드 일 경우.
	{
		P_Alarm_Occur_Flag = N_High_Alarm_Emergency_Stop;	// 즉시정지 플래그 발생.
	}
	else if(P_PMAC_Current_Mode == F_Current_Manual)		// Manual 모드 일 경우.
	{
		P_Alarm_Occur_Flag = N_High_Alarm_Cycle_Stop;		// 사이클 정지 플래그 발생.
	}
}
else if(P_Alarm_Occur_Index_Flag(N_High_Alarm_Cycle_Stop) == 1 && L_Alarm_Occur_Cycle_Stop_Flag_Old == 0)
{
	P_Alarm_Occur_Flag = N_High_Alarm_Cycle_Stop;			// 사이클 정지 플래그 발생.
}

L_Alarm_Occur_Emergency_Stop_Flag_Old = P_Alarm_Occur_Index_Flag(N_High_Alarm_Emergency_Stop);
L_Alarm_Occur_Cycle_Stop_Flag_Old = P_Alarm_Occur_Index_Flag(N_High_Alarm_Cycle_Stop);

//---------------------------//
// Flag에 따른 Commands 실행 //
//---------------------------//
if(P_Alarm_Occur_Flag == N_High_Alarm_Emergency_Stop)		// 즉시 정지 플래그 일 경우.
{
	P_Alarm_Occur_Flag = 0;
	P_PMAC_Commands = F_Command_Abort;						// Command : Abort
}
else if(P_Alarm_Occur_Flag == N_High_Alarm_Cycle_Stop)		// 사이클 정지 플래그 일 경우.
{
	P_Alarm_Occur_Flag = 0;
	P_PMAC_Commands = F_Command_Stop;						// Command : Stop
	P_Stop_Cmd_Origin = 40
}

// 2025.08.25 Servo Alarm 및 +,- Limit, Home time out  [ 참조 : 2025.08.25 알람코드 추가 ]
// 서보 알람
// 리밋 알람 ( +, - )
// 드라이블 알람
// 이동 오류 (Move_Error)
// 시작 위치 오류
// 홈 알람

//==================================================================
// 00. 모터 번호 업데이트
//==================================================================
	if( L_Local_Axis >= 28 || L_Local_Axis == 0 )				// 1 ~ 28 Local Axes
	   L_Local_Axis = 1;										
	else
		L_Local_Axis++;

	if(L_Local_Axis == 9)
	{
		L_Local_Axis = 11;
	}

	if( L_Ecat_Axis >= 48 || L_Ecat_Axis == 0 )					// 33 ~ 48 Ecat Axes
		L_Ecat_Axis = 33;
	else
		L_Ecat_Axis++;
//==================================================================

//==================================================================
// 01. Servo Alarm Update
//==================================================================
if( Motor[L_Local_Axis].ServoCtrl == N_TRUE )							// 사용하는 서보인지 체크
{
	if( Motor[L_Local_Axis].AmpEna == 0 )								// 서보 off라면
	{
		if(P_Servo_Alarm_Check == 0)
		{
			P_Servo_Alarm_Check = 1;
			P338 = Motor[L_Local_Axis].AmpEna;
		}

		// 260602 케스케이딩 중 언와인더 kill 시 서보 알람 무시
		if(L_Local_Axis == N_UNWINDER_UPPER || L_Local_Axis == N_UNWINDER_LOWER)
		{
			if(P_System_Cascading_ON_Status == F_Status_Nonseatus)
			{
				call Alarm.Insert_Alarm(L_Local_Axis - 1, N_High_Alarm_Emergency_Stop); 
			}
		}
		else
		{
			call Alarm.Insert_Alarm(L_Local_Axis - 1, N_High_Alarm_Emergency_Stop); 
		}				
	}							
}
if( Motor[L_Ecat_Axis].ServoCtrl == N_TRUE )							// 사용하는 서보인지 체크
{
	if( Motor[L_Ecat_Axis].AmpEna == 0 )								// 서보 off라면
	{
		if(P_Ecat_Servo_Alarm_Check == 0)
		{
			P_Ecat_Servo_Alarm_Check = 1;
			P339 = Motor[L_Ecat_Axis].AmpEna;
		}
		call Alarm.Insert_Alarm(L_Ecat_Axis - 1, N_High_Alarm_Emergency_Stop); 
	}							
}

//==================================================================
// 02. Servo Limit		
//==================================================================
if( P_PMAC_Current_Mode == F_Current_Automatic )
{
	if(Motor[L_Local_Axis].ServoCtrl == 1)
	{
		if( Motor[L_Local_Axis].PlusLimit == N_TRUE  )							// 플러스 리밋이 감지 된다면
		{
			call Alarm.Insert_Alarm(L_Local_Axis + 105, N_High_Alarm_Emergency_Stop); 
			//M(L_Local_Axis + 120) = 1;
			P_PMAC_Homing_CHK(L_Local_Axis) = 0;								// 해당 모터 홈잉 체크 초기화
		}

		if( Motor[L_Local_Axis].MinusLimit == N_TRUE )							// 마이너스 리밋이 감지 된다면
		{
			call Alarm.Insert_Alarm(L_Local_Axis + 52, N_High_Alarm_Emergency_Stop); 
//			M(L_Local_Axis + 60) = 1;
			P_PMAC_Homing_CHK(L_Local_Axis) = 0;								// 해당 모터 홈잉 체크 초기화
		}
	}
	if(Motor[L_Ecat_Axis].ServoCtrl == 1)
	{
		if( Motor[L_Ecat_Axis].PlusLimit == N_TRUE )							// 플러스 리밋이 감지 된다면
		{
			call Alarm.Insert_Alarm(L_Ecat_Axis + 105, N_High_Alarm_Emergency_Stop); 
//			M(L_Ecat_Axis + 118) = 1;
			P_PMAC_Homing_CHK(L_Ecat_Axis) = 0;									// 해당 모터 홈잉 체크 초기화
		}

		if( Motor[L_Ecat_Axis].MinusLimit == N_TRUE )							// 마이너스 리밋이 감지 된다면
		{
			call Alarm.Insert_Alarm(L_Ecat_Axis + 52, N_High_Alarm_Emergency_Stop); 
			//M(L_Ecat_Axis + 58) = 1;
			P_PMAC_Homing_CHK(L_Ecat_Axis) = 0;									// 해당 모터 홈잉 체크 초기화
		}
	}
}
//==================================================================
// 03. Home Time out		→ Home PLC에서 개별 Home Command 출력 후 Time Check 
//==================================================================
if( P_Current_Homming_Status(L_Local_Axis) == F_Status_STARTING )			// Home Status == Starting라면
{
	if( L_Home_Alarm_Timer_Init_Flag(L_Local_Axis) == 0 )
	{
		L_Home_Alarm_Timer(L_Local_Axis) =  Sys.Time;						// 현재 시간 저장
		L_Home_Alarm_Timer_Init_Flag(L_Local_Axis) = 1;
	}
	if( (Sys.Time - L_Home_Alarm_Timer(L_Local_Axis)) > P_Homing_Alarm_Time )// P_Homing_Alarm_Time = 10sec
	{
		P335 = Sys.Time - L_Home_Alarm_Timer(L_Local_Axis);
		call Alarm.Insert_Alarm(L_Local_Axis + 317, N_High_Alarm_Cycle_Stop); 
		//M(L_Local_Axis + 430) = 1;
		L_Home_Alarm_Timer_Init_Flag(L_Local_Axis) = 0;
	}
}
else
	L_Home_Alarm_Timer_Init_Flag(L_Local_Axis) = 0;

if( P_Current_Homming_Status(L_Ecat_Axis) == F_Status_STARTING )			// Home Status == Starting라면
{
	if( L_Home_Alarm_Timer_Init_Flag(L_Ecat_Axis) == 0 )
	{
		L_Home_Alarm_Timer(L_Ecat_Axis) =  Sys.Time;						// 현재 시간 저장
		L_Home_Alarm_Timer_Init_Flag(L_Ecat_Axis) = 1;
	}
	if( (Sys.Time - L_Home_Alarm_Timer(L_Ecat_Axis)) > P_Homing_Alarm_Time )// P_Homing_Alarm_Time = 10sec
	{
		call Alarm.Insert_Alarm(L_Ecat_Axis + 317, N_High_Alarm_Cycle_Stop); 
		//M(L_Ecat_Axis + 428) = 1;
		L_Home_Alarm_Timer_Init_Flag(L_Ecat_Axis) = 0;
	}
}
else
	L_Home_Alarm_Timer_Init_Flag(L_Ecat_Axis) = 0;

