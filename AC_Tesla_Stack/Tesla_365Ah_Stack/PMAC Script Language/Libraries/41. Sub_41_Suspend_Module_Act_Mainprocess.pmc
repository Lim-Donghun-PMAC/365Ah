		{
			P_Suspend_Anode_1TR_Cell_Supply_State_Machine = N_Error_Step; 			
			P_Module_Act_Command_Array(N_Act_An_Align_Retry_Cal) = F_ACT_STATUS_ALARM;							// 동작 에러.
		}
	}
	else
	{
		if( P_OLD_Module_Act_Command_Array(N_Act_An_Align_Retry_Cal) == F_ACT_STATUS_ENABLE )					// 이전 Command가 Enable 일 경우.
		{
			P_OLD_Module_Act_Command_Array(N_Act_An_Align_Retry_Cal) = F_ACT_STATUS_INITIAL;						// 엣지 변수 초기화
		}
	}
//===========================================================================================		
// 리턴값 
//===========================================================================================	
	rtn = N_TRUE;
//===========================================================================================
	return


Close