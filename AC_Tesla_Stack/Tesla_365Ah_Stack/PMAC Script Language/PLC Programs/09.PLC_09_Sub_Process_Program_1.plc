P_MNTR_PLC9_Task_Time(1) = (Sys.Time - P_MNTR_PLC9_Task_Time(0))*N_Task_Scale;	
	

IF ( P_MNTR_PLC9_Task_Time(1) > P_MNTR_PLC9_Task_Max_Time )
{
	P_MNTR_PLC9_Task_Max_Time = P_MNTR_PLC9_Task_Time(1);
}

close





