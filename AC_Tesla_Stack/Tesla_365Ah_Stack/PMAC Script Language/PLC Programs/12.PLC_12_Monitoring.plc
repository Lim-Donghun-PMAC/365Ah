// [ 참조 : 극판 데이터에 따른 흡착 I/O 상태 확인 ]
if( P_Flag_Vac_Status_Initialize == 1 )																				// 흡착 초기화 신호를 받을 경우
{
	P_Flag_Vac_Status_Initialize = 0;																				// 재진입 방지 [ 초기화 ]
	if( P_Buffer_Mode_Status_Sequence != N_Dryrun_Status_Sequence )													// 드라이 런이 아닐 경우 [ 드라이 런 가동 시에는 흡착 알람을 보지 않음 ]
	{
		P_SM_Vac_Initialize = 1;																					// 흡착 초기화 실행
	}
}
//------------------------------------------------------------------------------------------------------------------------------------------------------
// 흡착 초기화 실행문
//------------------------------------------------------------------------------------------------------------------------------------------------------
// 1. 극판이 있을 경우 + 흡착 입력 신호가 ON이 되어있지 않을 경우 -> 알람 발생 및 극판 삭제
// 2. 극판이 없을 경우 -> 블로우 -> OFF 시퀀스 실행
if( P_PMAC_Current_Mode == F_Current_Manual )
{
	if( P_SM_Vac_Initialize == 1 )
	{
		// 음극 1차 PNP
		if( Sys_Anode_1st_Sheet_Data != 0 )
		{
			if( M_X_Anode_1st_PNP_Vac_Sensor == 0 )
			{
				P_Flag_Anode_1st_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Anode_1st_Vac_OFF = 1;
		}
		// 음극 얼라인 테이블
		if( Sys_Anode_Align_Sheet_Data != 0 )
		{
			if( M_X_Anode_AT_Vac_Sensor == 0 )
			{
				P_Flag_Anode_AT_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Anode_AT_Vac_OFF = 1;
		}
		// 음극 2차 PNP
		if( Sys_Anode_2nd_Sheet_Data != 0 )
		{
			if( M_X_Anode_2nd_PNP_Vac_Sensor == 0 )
			{
				P_Flag_Anode_2nd_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Anode_2nd_Vac_OFF = 1;
		}
		// 음극 NG PNP
		if( Sys_Anode_NG_TR_Sheet_Data != 0 )
		{
			if( M_X_Anode_NG_PNP_Vac_Sensor == 0 )
			{
				P_Flag_Anode_NG_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Anode_NG_Vac_OFF = 1;
		}
		// 양극 1차 PNP
		if( Sys_Cathode_1st_Sheet_Data != 0 )
		{
			if( M_X_Cathode_1st_PNP_Vac_Sensor == 0 )
			{
				P_Flag_Cathode_1st_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Cathode_1st_Vac_OFF = 1;
		}
		// 양극 얼라인 테이블
		if( Sys_Cathode_Align_Sheet_Data != 0 )
		{
			if( M_X_Cathode_AT_Vac_Sensor == 0 )
			{
				P_Flag_Cathode_AT_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Cathode_AT_Vac_OFF = 1;
		}
		// 양극 2차 PNP
		if( Sys_Cathode_2nd_Sheet_Data != 0 )
		{
			 if( M_X_Cathode_2nd_PNP_Vac_Sensor == 0 )
			{
				P_Flag_Cathode_2nd_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Cathode_2nd_Vac_OFF = 1;
		}
		if( Sys_Cathode_NG_TR_Sheet_Data != 0 )
		{
			if( M_X_Cathode_NG_PNP_Vac_Sensor == 0 )
			{
				P_Flag_Cathode_NG_Vac_Initial_Alarm = 1;
			}
		}
		else
		{
			P_Flag_Cathode_NG_Vac_OFF = 1;
		}
		L_Vac_Initialize_Timer = 0;
		P_SM_Vac_Initialize = 2;
	}

//------------------------------------------------------------------------------------------------------------------------------------------------------
	// 진공 해제를 위한 선 Blow
	if( P_SM_Vac_Initialize == 2 )
	{
		if( L_Vac_Initialize_Timer > 50 )
		{
			if( P_Flag_Anode_1st_Vac_OFF == 1 )
			{
				M_Y_Anode_1st_Vac_Sol_On = 0;
				M_Y_Anode_1st_Vac_Sol_Off = 1;
			}
			if( P_Flag_Anode_AT_Vac_OFF == 1 )
			{
				M_Y_Anode_AT_Vac_Ejector_Vac_On = 0;
				M_Y_Anode_AT_Vac_Ejector_Vac_Off = 1;
			}
			if( P_Flag_Anode_2nd_Vac_OFF == 1 )
			{
				M_Y_Anode_2nd_Vac_Sol_On = 0;
				M_Y_Anode_2nd_Vac_Sol_Off = 1;
			}
			if( P_Flag_Anode_NG_Vac_OFF == 1 )
			{
				M_Y_Anode_NG_PNP_Ejector_Vac_On = 0;
				M_Y_Anode_NG_PNP_Ejector_Vac_Off = 1;
			}
			if( P_Flag_Cathode_1st_Vac_OFF == 1 )
			{
				M_Y_Cathode_1st_Vac_Sol_On = 0;
				M_Y_Cathode_1st_Vac_Sol_Off = 1;
			}
			if( P_Flag_Cathode_AT_Vac_OFF == 1 )
			{
				M_Y_Cathode_AT_Vac_Ejector_Vac_On = 0;
				M_Y_Cathode_AT_Vac_Ejector_Vac_Off	= 1;
			}
			if( P_Flag_Cathode_2nd_Vac_OFF == 1 )
			{
				M_Y_Cathode_2nd_Vac_Sol_On = 0;
				M_Y_Cathode_2nd_Vac_Sol_Off = 1;
			}
			if( P_Flag_Cathode_NG_Vac_OFF == 1 )
			{
				M_Y_Cathode_NG_PNP_Ejector_Vac_On = 0;
				M_Y_Cathode_NG_PNP_Ejector_Vac_Off = 1;
			}
			L_Vac_Initialize_Timer = 0;
			P_SM_Vac_Initialize = 3;
		}
	}
//------------------------------------------------------------------------------------------------------------------------------------------------------
	// 블로우 진행 후 해제 
	if( P_SM_Vac_Initialize == 3 )
	{
		if( L_Vac_Initialize_Timer > 50 )
		{
			if( P_Flag_Anode_1st_Vac_OFF == 1 )
			{
				M_Y_Anode_1st_Vac_Sol_On = 0;
				M_Y_Anode_1st_Vac_Sol_Off = 0;
			}
			if( P_Flag_Anode_AT_Vac_OFF == 1 )
			{
				M_Y_Anode_AT_Vac_Ejector_Vac_On = 0;
				M_Y_Anode_AT_Vac_Ejector_Vac_Off = 0;
			}
			if( P_Flag_Anode_2nd_Vac_OFF == 1 )
			{
				M_Y_Anode_2nd_Vac_Sol_On = 0;
				M_Y_Anode_2nd_Vac_Sol_Off = 0;
			}
			if( P_Flag_Anode_NG_Vac_OFF == 1 )
			{
				M_Y_Anode_NG_PNP_Ejector_Vac_On = 0;
				M_Y_Anode_NG_PNP_Ejector_Vac_Off = 0;
			}
			if( P_Flag_Cathode_1st_Vac_OFF == 1 )
			{
				M_Y_Cathode_1st_Vac_Sol_On = 0;
				M_Y_Cathode_1st_Vac_Sol_Off = 0;
			}
			if( P_Flag_Cathode_AT_Vac_OFF == 1 )
			{
				M_Y_Cathode_AT_Vac_Ejector_Vac_On = 0;
				M_Y_Cathode_AT_Vac_Ejector_Vac_Off	= 0;
			}
			if( P_Flag_Cathode_2nd_Vac_OFF == 1 )
			{
				M_Y_Cathode_2nd_Vac_Sol_On = 0;
				M_Y_Cathode_2nd_Vac_Sol_Off = 0;
			}
			if( P_Flag_Cathode_NG_Vac_OFF == 1 )
			{
				M_Y_Cathode_NG_PNP_Ejector_Vac_On = 0;
				M_Y_Cathode_NG_PNP_Ejector_Vac_Off = 0;
			}
			L_Vac_Initialize_Timer = 0;
			P_SM_Vac_Initialize = 4;
		}
	}
//------------------------------------------------------------------------------------------------------------------------------------------------------
	// 흡착 에러로 인해 알람 발생
	if( P_SM_Vac_Initialize == 4 )
	{
		if( L_Vac_Initialize_Timer > 50 )
		{		
			if( P_Flag_Anode_1st_Vac_Initial_Alarm == 1 )
			{
				P_Flag_Anode_1st_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Anode_1ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			if( P_Flag_Anode_AT_Vac_Initial_Alarm == 1 )
			{
				P_Flag_Anode_AT_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Anode_AT_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			if( P_Flag_Anode_2nd_Vac_Initial_Alarm == 1 )
			{
				P_Flag_Anode_2nd_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Anode_2ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			if ( P_Flag_Anode_NG_Vac_Initial_Alarm == 1)
			{
				P_Flag_Anode_NG_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Anode_NG_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			if( P_Flag_Cathode_1st_Vac_Initial_Alarm == 1 )
			{
				P_Flag_Cathode_1st_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Cathode_1ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}		
			if( P_Flag_Cathode_AT_Vac_Initial_Alarm == 1 )
			{
				P_Flag_Cathode_AT_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Cathode_AT_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			if( P_Flag_Cathode_2nd_Vac_Initial_Alarm == 1 )
			{
				P_Flag_Cathode_2nd_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Cathode_2ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			if ( P_Flag_Cathode_NG_Vac_Initial_Alarm == 1)
			{
				P_Flag_Cathode_NG_Vac_Initial_Alarm = 0;
				call Alarm.Insert_Alarm(N_Alarm_Cathode_NG_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
			}
			P_SM_Vac_Initialize = 5;
		}
	}
//------------------------------------------------------------------------------------------------------------------------------------------------------
	if( P_SM_Vac_Initialize == 5 )					// 6. 완료
	{
		P_Flag_Anode_1st_Vac_OFF	= 0;
		P_Flag_Anode_AT_Vac_OFF	= 0;
		P_Flag_Anode_2nd_Vac_OFF	= 0;
		P_Flag_Anode_NG_Vac_OFF	= 0;
		P_Flag_Cathode_1st_Vac_OFF = 0;
		P_Flag_Cathode_AT_Vac_OFF = 0;
		P_Flag_Cathode_2nd_Vac_OFF = 0;
		P_Flag_Cathode_NG_Vac_OFF = 0;
		P_SM_Vac_Initialize = 0;					// 완료
	}
}

//------------------------------------------------------------------------------------------------------------------------------------------------------
// 중간 배출 무시 모니터링 및 실행		[ 참조 : 26.05.13 중간 배출 무시 추가 ]	Find : 중간배출무시
//------------------------------------------------------------------------------------------------------------------------------------------------------
// 1. ARC 진행 후 Vision Stack OK 신호 또는 70장 이상 적층 후 중간 배출 무시 신호 OFF
// 2. 중간 배출 무시 총 수량과 중간 배출 무시 적층 수량이 같을 때 중간 배출 무시 신호 OFF

if ( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )			// 중간 배출 무시 신호가 켜져 있을 경우.
{
	//if ( P_ARC_Middle_Discharge_Ignore_Vision_Check == 1 )	// ARC 진행 후 Vision 신호 또는 극판 적층 수 확인.
	//{
		//if ( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence )	
		//{
			// ↓ ARC 진행 후 Vision Stack OK 신호 (1s후 초기화) 또는 70장 이상 적층 후 중간 배출 무시 신호 OFF
			// 260609 중간 배출 무시 off 조건 수정 (비전에서 신호 주면)
			if ( P_Vision_Sepa_ARC_Judge == N_TRUE || P_Vision_Send_Middle_Skip_Off_Flag == 1 )	// Stack Vision OK 신호 및 적층 수 확인.
			{
				P_Middle_Discharge_Ignore_OFF_Signal = 1;		// 중간 배출 무시 신호 OFF 요청.	[ PMAC → PLC ]
				P_ARC_Middle_Discharge_Ignore_Vision_Check = 0;	// ARC 진행 후 Vision 신호 또는 극판 적층 수 확인 초기화.
			}
		//}
	//}
	
	if( P_Middle_Skip_Off_Flag == 1 )
	{
		P_Middle_Skip_Off_Flag = 0
		if ( P_Middle_Discharge_Ignore_Total_Count != 0 && P_Middle_Discharge_Ignore_Total_Count <= P_Middle_Discharge_Ignore_Stack_Count )	// 중간 배출 무시 목표 수량보다 적층 수량이 더 많을 경우.
		{
			P_Middle_Discharge_Ignore_OFF_Signal = 1;			// 중간 배출 무시 신호 OFF 요청.	[ PMAC → PLC ]
		}
	}
}
else if ( M_Function_BTN_2.Stack_Vision_NG_Enable == 0 )	// 중간 배출 무시가 꺼져 있을 경우.
{
	P_Middle_Discharge_Ignore_OFF_Signal = 0;				// 중간 배출 무시 신호 OFF 초기화.	[ PMAC → PLC ]
	P_Middle_Discharge_Ignore_Stack_Count = 0;				// 중간 배출 무시 적층 수량 초기화. (배출 시 증가)
}

if ( P_ARC_Middle_Discharge_Ignore_ON_Flag == 1 )			// ARC 진행 시 중간 배출 무시 신호 ON일 경우.
{
	P_Middle_Discharge_Ignore_ON_Signal = 1;				// 중간 배출 무시 ON 요청.	[ PMAC → PLC ]
	if ( M_Function_BTN_2.Stack_Vision_NG_Enable == 1 )		// 중간 배출 무시 ON일 경우.
	{
		P_Middle_Discharge_Ignore_ON_Signal = 0;			// 중간 배출 무시 요청 초기화.
		P_ARC_Middle_Discharge_Ignore_ON_Flag = 0;			// ARC 진행 시 중간 배출 무시 신호 초기화.
	}
}
//=========================================================================================================================================================//
//[ 참조 : 260513 : 양음극 릴컷부 도어 오픈 시 1차 PNP 인터락 ]
//[참조 : 260730 환경안전검수용 인터락 활성화 버튼 추가]
if ( P_X_PLC_Setup_Mode_Check == 0 )
{
	if( P_PMAC_Current_Mode == F_Current_Automatic )
	{	//노멀, 세파, 드라이런 시 
		if ( P_Buffer_Mode_Status_Sequence == N_Normal_Status_Sequence || P_Buffer_Mode_Status_Sequence == N_Sepa_Consume_Status_Sequence || P_Buffer_Mode_Status_Sequence == N_Dryrun_Status_Sequence  )  
		{	 // 양극 또는 음극 릴컷 도어 오픈 시 (엣지)
			if( ( M_X_PLC_Cathode_ReelCut_Door_Interlock == 0 && M_X_PLC_Cathode_ReelCut_Door_Interlock != L_Old_M_X_PLC_Cathode_ReelCut_Door_Interlock ) || ( M_X_PLC_Anode_ReelCut_Door_Interlock == 0 && M_X_PLC_Anode_ReelCut_Door_Interlock != L_Old_M_X_PLC_Anode_ReelCut_Door_Interlock ) || ( M_X_PLC_Cathode_Small_Door_Close_Signal == 0 && M_X_PLC_Cathode_Small_Door_Close_Signal != L_Old_M_X_PLC_Cathode_Small_Door_Close_Signal )  || ( M_X_PLC_Anode_Small_Door_Close_Signal == 0 && M_X_PLC_Anode_Small_Door_Close_Signal != L_Old_M_X_PLC_Anode_Small_Door_Close_Signal )  )		// [ 참조 : 26.05.22 스택부 작은 문 인터락 추가 ]
			{
				call Alarm.Insert_Alarm(N_Alarm_Cathode_Anode_Reel_Door_Open_Chk, N_High_Alarm_Cycle_Stop);	// 도어 오픈 알람 발생 
			    P_PMAC_Commands = F_Command_Stop;      // Commands Stop 발생
				P_Stop_Cmd_Origin = 100;
			}
		}
	}
	else if ( P_PMAC_Current_Mode == F_Current_Manual )	//메뉴얼 상태
	{
		if ( P_PMAC_Status == F_Status_RESETTING || P_PMAC_Status == F_Status_IDLE  )		//홈 동작 진행 중 또는 홈 동작 완료 
		{	
			if( ( M_X_PLC_Cathode_ReelCut_Door_Interlock == 0 && M_X_PLC_Cathode_ReelCut_Door_Interlock != L_Old_M_X_PLC_Cathode_ReelCut_Door_Interlock ) || ( M_X_PLC_Anode_ReelCut_Door_Interlock == 0 && M_X_PLC_Anode_ReelCut_Door_Interlock != L_Old_M_X_PLC_Anode_ReelCut_Door_Interlock ) || ( M_X_PLC_Cathode_Small_Door_Close_Signal == 0 && M_X_PLC_Cathode_Small_Door_Close_Signal != L_Old_M_X_PLC_Cathode_Small_Door_Close_Signal )  || ( M_X_PLC_Anode_Small_Door_Close_Signal == 0 && M_X_PLC_Anode_Small_Door_Close_Signal != L_Old_M_X_PLC_Anode_Small_Door_Close_Signal )  )		// [ 참조 : 26.05.22 스택부 작은 문 인터락 추가 ]
			{  // 양극 또는 음극 릴컷 도어 오픈 시 (엣지)
				call Alarm.Insert_Alarm(N_Alarm_Cathode_Anode_Reel_Door_Open_Chk, N_High_Alarm_Cycle_Stop); // 도어 오픈 알람 발생 
			    P_PMAC_Commands = F_Command_Stop;      // Commands Stop 발생
				P_Stop_Cmd_Origin = 101;			   // 메뉴얼 홈 동작 중 릴컷 도어 오픈 시 Stop
			}
		}
	}
	L_Old_M_X_PLC_Cathode_ReelCut_Door_Interlock = M_X_PLC_Cathode_ReelCut_Door_Interlock;					// Old Data
	L_Old_M_X_PLC_Anode_ReelCut_Door_Interlock = M_X_PLC_Anode_ReelCut_Door_Interlock;						// Old Data
	L_Old_M_X_PLC_Cathode_Small_Door_Close_Signal = M_X_PLC_Cathode_Small_Door_Close_Signal;				// Old Data
	L_Old_M_X_PLC_Anode_Small_Door_Close_Signal = M_X_PLC_Anode_Small_Door_Close_Signal;					// Old Data
}
//=========================================================================================================================================================//
// 샘플 버튼 모니터링
if(P_BTN_QC_Sample_Flag == 1 || P_BTN_Loss_Sample_Flag == 1)
{
	if(P_Sample_JR_Recipe_Count <= M_Sample_JR_Prod_Count)
	{
		M_Sample_Btn_Flag = 2;			// 1번 bit ON, 샘플 버튼 off 요청
	}
}
else
{
	M_Sample_Btn_Flag = 0;
	M_Sample_JR_Prod_Count = 0;
}
//=========================================================================================================================================================//
// [ 참조 : 26.09.22 진공 알람 도어 오픈 하여 클리어 ]
if( P_Vacuum_Door_Clear_Use ){
	if( P_PMAC_Current_Mode == F_Current_Manual && M_X_Other_Door_Open_Signal == 1 )
		P_Vac_Door_Open_Clear(0),13 = 0;
	
	// 진공 알람은 00번 or 12번 PLC에서 주기때문에  M변수 자체를 보고 Flag 삽입을 하도록 하겠음
	// Sys.Udata[20854] M변수가 가르키고 있는 주소
	// 매크로 함수로 마스킹 걸고 Vac M변수 감지가 된다면 비트조합을 검출하여 Clear 배열 값 on
	if( L_Vac_Door_Clear_Bit ){	//PLC[12].ldata.L[82]
	
		if( L_Vac_Bit_idx <= 12 ){
			call Bit_Masking_Function.Check(L_Vac_Door_Clear_Bit,L_Vac_Bit_idx,&L_Vac_Door_Rtn)
			if( L_Vac_Door_Rtn == N_TRUE ) {		// PLC[12].ldata.L[84]
				P_Vac_Door_Open_Clear(0)++;			// 0번배열엔 카운팅 하자
				P_Vac_Door_Open_Clear(L_Vac_Bit_idx) = 1;
			}
			L_Vac_Bit_idx++;						//PLC[12].ldata.L[83]
		}
	}
	else
		L_Vac_Bit_idx = 1;
	
	if( P_Vac_Door_Open_Clear(0) ){
		if( P_Vac_Door_Open_Clear(1) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Cathode_1ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(2) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Anode_1ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(3) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Cathode_2ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(4) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Anode_2ST_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(5) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Cathode_NG_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(6) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Anode_NG_PNP_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(7) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Cathode_AT_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(8) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Anode_AT_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(9) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Main_Stack_Table_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(10) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Main_Stack_T_Plate_Down_POS_Vaccume, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(11) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Cathode_2ST_PNP_Blow_NG, N_High_Alarm_Cycle_Stop);
		}
		if( P_Vac_Door_Open_Clear(12) == 1 ){
			call Alarm.Insert_Alarm(N_Alarm_Anode_2ST_PNP_Blow_NG, N_High_Alarm_Cycle_Stop);
		}
	
		// 팝업은 개별 팝업으로 수정 예정!
		// 팝업을 띄워서 문열고 클리어 하게 하자
		//nop(memset(F_IL_Cdata, 0 ,N_IL_memset_size));
		//nop(sprintf(F_IL_Cdata," Vacuum Error Door Open "));
		//nop(sprintf(F_IL_Cdata2," Error Clear Door Open "));
		
		//if( L_Resetting_Vac_Delay_Timer > 1000 ){
		//	L_Resetting_Vac_Delay_Timer = 0;
		//	P_Y_Interlock_Popup_On_Request = 1;
		//}
	}
}
