			break;

			case N_SEQ_Normal_MSA_No_29:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_2nd_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_2nd_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_30:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_FinalRoll_Init_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_FinalRoll_Init_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_31:
		
				rtn = N_TRUE;
			break;
			#else 
			case N_SEQ_Normal_MSA_No_23:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_2nd_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_2nd_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_24:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_FinalRoll_Init_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Align_Discharge_FinalRoll_Init_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_25:
		
				rtn = N_TRUE;
			break;
			#endif 
		}
	break;




	// Stack MSA 
	case N_MSA_Anode_Stack:
		switch( Index )
		{
			case N_SEQ_Normal_MSA_No_1:		
				rtn = N_TRUE;
			break;
			
			case N_SEQ_Normal_MSA_No_2:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Set) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Set) = 0 ;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_3:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Motor_Pos_Check) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Motor_Pos_Check) = 0 ;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_4:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Down_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Down_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_5:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_PNP_Vacume_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_PNP_Vacume_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_6:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_7:		
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Move) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Move) = 0 ;
					rtn = N_TRUE;
				}
			break;
			
			case N_SEQ_Normal_MSA_No_8:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Down_Move) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Down_Move) = 0 ;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_9:		
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Vision_Trg_ON) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Vision_Trg_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_10:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_11:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_12:		
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) == 1)
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) = 0;
					rtn = N_TRUE;
				}
				else if ( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) == 2 )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) = 0;
					P_VISION_MSA_Stack_Count_Chk_Flag = 1;
					rtn = N_TRUE;
				}
			break;

			#ifdef F_MSA_Discharge_Use
			//↓ MSA배출 모드 사용 시
			case N_SEQ_Normal_MSA_No_13:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Down_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = 0;
					rtn = N_TRUE;
				}
			break;
			
			case N_SEQ_Normal_MSA_No_14:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_15:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;


			case N_SEQ_Normal_MSA_No_16:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Stack_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Stack_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_17:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;
			
			case N_SEQ_Normal_MSA_No_18:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Down_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Down_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_19:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Vacume_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Vacume_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_20:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_21:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Move) = 0;
					rtn = N_TRUE;
				}
			break;


			case N_SEQ_Normal_MSA_No_22:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_23:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_24:
		
				rtn = N_TRUE;
			break;
			#else
			case N_SEQ_Normal_MSA_No_13:
		
				rtn = N_TRUE;
			break;
			#endif 
		}
	break;

	case N_MSA_Cathode_Stack:
		switch( Index )
		{
			case N_SEQ_Normal_MSA_No_1:		
				rtn = N_TRUE;
			break;
			
			case N_SEQ_Normal_MSA_No_2:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Set) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Set) = 0 ;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_3:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Motor_Pos_Check) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Motor_Pos_Check) = 0 ;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_4:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Down_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Down_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_5:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_PNP_Vacume_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_PNP_Vacume_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_6:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_7:		
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Move) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Move) = 0 ;
					rtn = N_TRUE;
				}
			break;
			
			case N_SEQ_Normal_MSA_No_8:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Down_Move) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Down_Move) = 0 ;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_9:		
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Vision_Trg_ON) )
				{	
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Vision_Trg_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_10:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Stack_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_11:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_2nd_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_12:		
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) == 1)
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) = 0;
					rtn = N_TRUE;
				}
				else if ( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) == 2 )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_MSA_Move_Cnt) = 0;
					P_VISION_MSA_Stack_Count_Chk_Flag = 1;
					rtn = N_TRUE;
				}
			break;

			#ifdef F_MSA_Discharge_Use
			//↓ MSA배출 모드 사용 시
			case N_SEQ_Normal_MSA_No_13:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Down_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Down_Move) = 0;
					rtn = N_TRUE;
				}
			break;
			
			case N_SEQ_Normal_MSA_No_14:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Blow_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_15:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;


			case N_SEQ_Normal_MSA_No_16:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Stack_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Stack_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_17:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;
			
			case N_SEQ_Normal_MSA_No_18:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Down_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Down_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_19:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Vacume_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Vacume_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_20:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Up_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_Align_Up_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_21:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Move) = 0;
					rtn = N_TRUE;
				}
			break;


			case N_SEQ_Normal_MSA_No_22:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_NG_PNP_NGBox_Blow_ON) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_23:
				if( P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Move) )
				{
					P_VISION_MSA_Align_Module_Complete_Bit(N_MSA_Stack_Discharge_2nd_Align_Move) = 0;
					rtn = N_TRUE;
				}
			break;

			case N_SEQ_Normal_MSA_No_24:
		
				rtn = N_TRUE;
			break;
			#else
			case N_SEQ_Normal_MSA_No_13:
		
				rtn = N_TRUE;
			break;
			#endif 
		}
	break;
}
return;

sub: Execute_MSA(Mode,data,&rtn)

rtn = 0;

switch( Mode )
{
	case N_MSA_Anode_Align:
		switch(data)
		{
			case N_SEQ_Normal_MSA_No_1:		// 카운트 초기화 및 모터 서보 체크
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_SET) = F_ACT_STATUS_ENABLE;										
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_2:		// 모터 위치 확인
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_Motor_Pos_Check) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_3:		// 얼라인 1차 Belt 이동
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Init_to_Belt_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_4:		// 1차 벨트 하강 2차 얼라인 하강
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Down_Move) = F_ACT_STATUS_ENABLE;
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Align_Down_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_5:		// 1,2차 흡착
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Vacume_ON) = F_ACT_STATUS_ENABLE;
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Vacume_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_6:		// 1,2차 상승
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Belt_Up_Move) = F_ACT_STATUS_ENABLE;
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Align_Up_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_7:		// 파이널롤러 양음극 이동
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_FinalRoll_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_8:		// 2차 스텍 이동
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_2nd_Stack_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_9:		// 1차 얼라인 이동
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Align_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_10:		// 1차 얼라인 하강
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Align_Down_Move) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_11:		// 1차 블로우 
				P_Module_Manual_MSA_Act_Command_Array(N_MSA_Align_1st_Align_Blow_ON) = F_ACT_STATUS_ENABLE;
				rtn = N_TRUE;
			break;

			case N_SEQ_Normal_MSA_No_12:	// 비전 트리거 on
