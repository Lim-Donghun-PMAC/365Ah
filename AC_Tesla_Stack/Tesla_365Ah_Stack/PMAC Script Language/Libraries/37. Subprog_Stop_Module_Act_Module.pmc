sub: Last_JellyRoll_Init(void)
	// [ 참고 : 2025.10.15 미비 사항 추가 건 ]
	local L_Return = 0;

	// Vision 출력 초기화 구간
	M_Y_Vision_Stack_End_Sheet = 0;									// 스텍 엔드 신호 off
	M_Y_Vision_Stack_Start_Sheet = 0;								// 스텍 첫장 쌓는 신호 off
	M_Y_Vision_Stack_EPC_Correction_Trigger = 0;					// EPC 보정 기능_ 스텍 촬상 신호 초기화

	// 파이널롤러 클램프 ON 
	M_Y_FR_Sepa_Clamp = 1;									// 파이널롤러 클램프 on 
	M_Y_FR_Sepa_UnClamp = 0;									// 파이널롤러 클램프 on

	//M_Y_Sheet_Enable_Flag = 0;									// 극판 준비 신호 off	 

	// 내부 트리거 및 스텟머신 OFF
	call Discharge_Sub_Prog.Discharge_PackML_Reset(&L_Return);		// 배출 IO 초기화
	P_Stack_Table_NG_Flag = 0;										// 스텍 테이블 NG Flag 초기화
	P_Buf_Stack_NG_Flag = 0

	// 카운트 갯수 초기화 전 총 생산 갯수에 업데이트
	P_Jelly_Roll_Total_Count = 0;									// 젤리롤 총 생산량 초기화   
	P_Cathode_Count = 0;											// 양극 카운트 초기화
	P_Anode_Count = 0;												// 음극 카운트 초기화
	P_Jelly_Roll_Prod_Count = 0;									// 극판 카운트 초기화
	P_Jelly_Roll_OK_Count = 0;
	P_Jelly_Roll_NG_Count = 0;										// 불량 카운트 초기화

	
	P_EXECUTE_IsEnable_Firt_Stacking_Flag = 0;						// 처음 쌓는 조건 감시
	P_PLC12_Continuous_Buffer_Reset_Flag = 1;						// 마지막 공정 시 연속NG버퍼 초기화 플래그 on 
	// [참조 : 260108 maint ng flag로 인덱스 불량 발생하는 부분 수정]
	//P_Status_Clear_Sheet_Maint_Check = 1;							// sheet maint NG 
return;

close
