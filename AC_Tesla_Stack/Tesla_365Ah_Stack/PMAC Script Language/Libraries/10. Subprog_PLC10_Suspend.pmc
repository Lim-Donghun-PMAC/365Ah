	sub:ARC_Home_Check(&ARC_Home_Check_RTN)	
		// 닙롤 후진, 상부 플레이트 상승, 상부 플레이트 틸팅 0도, 상부 플레이트 언클램프, 상부 플레이트 커터 후진, 하부 플레이트 하강, 하부 플레이트 틸팅 0도, 하부 플레이트 언클램프, 하부 플레이트 커터 후진 확인 (ARC 기구물 정위치)
		//if ( M_X_Sepa_Driving_Roll_UnClamp_Sensor == 1 && M_X_Sepa_Upper_ARC_Up_Sensor == 1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front == 1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear == 1 && M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor == 1 && M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor == 1 && M_X_Sepa_Lower_ARC_Dn_Sensor == 1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front == 1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear == 1 && M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor == 1 && M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor == 1 )
		if ( M_X_Sepa_Upper_ARC_Up_Sensor == 1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Front == 1 && M_X_Sepa_Upper_ARC_UnTilting_Sensor_Rear == 1 && M_X_Sepa_Upper_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Upper_ARC_UnStopper_Rear_Sensor == 1 && M_X_Sepa_Upper_ARC_Cutting_BWD_Sensor == 1 && M_X_Sepa_Lower_ARC_Dn_Sensor == 1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Front == 1 && M_X_Sepa_Lower_ARC_UnTilting_Sensor_Rear == 1 && M_X_Sepa_Lower_ARC_UnStopper_Front_Sensor == 1 && M_X_Sepa_Lower_ARC_UnStopper_Rear_Sensor == 1 && M_X_Sepa_Lower_ARC_Cutting_BWD_Sensor == 1 )
		{
			ARC_Home_Check_RTN = F_TRUE;
		}
		else
		{
			call Alarm.Insert_Alarm(N_Alarm_SEPA_ARC_Home_Error, N_High_Alarm_Cycle_Stop);
//			M_SEPA_ARC_Home_Error_Alarm = 1;
			ARC_Home_Check_RTN = N_FALSE;	
		}					
	return
