//======================================//
// ARC Ready 램프 점멸 상태로 일정 시간 지난 후 팝업 띄움 //	[ 참조 : 26.09.25 ARC 네임플레이트 Ready 신호에 따른 신호 추가 ]
//======================================//
global P_ARC_NP_Upper_Ready_Check_Bit = 0;			// ARC Ready 램프 점멸 중 일정 시간이 지난 후 팝업 및 부저 발생 (일정 시간, 팝업, 부저는 PLC에서 제어)
global P_ARC_NP_Lower_Ready_Check_Bit = 0;			// ARC Ready 램프 점멸 중 일정 시간이 지난 후 팝업 및 부저 발생 (일정 시간, 팝업, 부저는 PLC에서 제어)
