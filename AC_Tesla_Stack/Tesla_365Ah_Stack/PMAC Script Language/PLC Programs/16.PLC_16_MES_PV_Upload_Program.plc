// 2025.08.26 MES PV 영역 보고 추가 [ 참조 : 2025.08.26 MES PV 영역 보고 추가 ] - 김성중 선임

open plc 16
P_MNTR_PLC20_Task_Time(0) = Sys.Time;
#define	L_System_Timer				Sys.Time			// 시스템 타이머

Local	L_Time_Cycle_Up_Count_Start_Time;				// Plc[20].ldata.L[0]	시간 체크 시작 시간
Local	L_Time_Cycle_Up_Count_End_Time;					// Plc[20].ldata.L[1]	시간 체크 종료 시간
Local	L_Time_Cycle_Up_Count_Delta_Time;				// Plc[20].ldata.L[2]	시작과 종료 시간 사이의 시간
Local	L_Flag_Cycle_Up_Count_Init_Flag;				// Plc[20].ldata.L[3]	타이머 초기화 플래그

Local	L_MES_Comunication_Timer;						// Plc[20].ldata.L[4]	MES 1,2차 실시간 영역 타이머
local	L_CA_Cmd_Z_Deg;									// Plc[20].ldata.L[5]	PnP Z축 Command Deg 값 저장 변수
local	L_AN_Cmd_Z_Deg;									// Plc[20].ldata.L[6]	PnP Z축 Command Deg 값 저장 변수
//========================================================================================================================
// 00. 다이나믹 로컬 타이머 함수	
//========================================================================================================================
// 00.1) 시간 간격 초기화
if(L_Flag_Cycle_Up_Count_Init_Flag == 0)
{
	L_Flag_Cycle_Up_Count_Init_Flag = 1;
	L_Time_Cycle_Up_Count_Start_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
}
// 00.2) 시간 체크
if(L_Flag_Cycle_Up_Count_Init_Flag == 1)
{
	L_Time_Cycle_Up_Count_End_Time = L_System_Timer;
	L_Time_Cycle_Up_Count_Delta_Time = (L_Time_Cycle_Up_Count_End_Time - L_Time_Cycle_Up_Count_Start_Time) * 1000

	if(L_Time_Cycle_Up_Count_Delta_Time < 0)
	{
		L_Flag_Cycle_Up_Count_Init_Flag = 0;
	}
}
// 00.3) 시간 업데이트
if(L_Time_Cycle_Up_Count_Delta_Time > 0.1)
{
	
	L_MES_Comunication_Timer = L_MES_Comunication_Timer + L_Time_Cycle_Up_Count_Delta_Time; 

	L_Time_Cycle_Up_Count_Start_Time = L_Time_Cycle_Up_Count_End_Time;
	L_Time_Cycle_Up_Count_Delta_Time = 0;
}

// --------------------User Code Goes Here------------------------

// 명령부
// 세미 런 모드 진입 시 캡쳐 플래그 ON
