
open subprog Popup(void)


sub: UI( BTN )		
	
local L_rtn = 0;
local L_BP = 1;

switch( BTN )
{
	case BTN_Recipe_Pos_Run_Pushed:		// P to P 위치 모드 인터락일 경우
		// ↓ 어떤 위치 인터락 버튼이 눌렸는지 찾는 부분											
		while(L_BP <= 10 )	// 1번레시피포스 ~ 10번 레시피포스
		{								//   위치인터락버튼값, 비트위치, 결과값
			call Bit_Masking_Function.Check(M_Motor_RecipePos(P_IL_Motor_Page),L_BP,&L_rtn);
			if( L_rtn == N_TRUE )
			{
				P_IL_Sprint = sprintf(F_IL_Cdata," %d Recipe Pos InterLock ",L_BP);	// 플러스 인터락 문구 표시
				//P_IL_length = strlen(F_IL_Cdata);									// 문자열 길이 저장
				break;
			}
			L_BP++;
		}									
	break;

	default:	// P to P 위치 모드 인터락이 아닐경우
		// ↓ 간섭 모터 검색 부분 	
		if( P_IL_Motor_Page != P_IL_Popup_Motor )
		{
			call Popup.Pop_letter(P_IL_Popup_Motor);			// 모터마다 문자열 써주는건데 너무 길어서 함수처리로 함
		}
		else
		{
			switch( P_IL_Robot_Bit )
			{
				case Hex_IL_Plus:
					P_IL_Sprint = sprintf(F_IL_Cdata," Plus InterLock ");	// 플러스 인터락 문구 표시
					//P_IL_length = strlen(F_IL_Cdata);						// 문자열 길이 저장
				break;
		
				case Hex_IL_Minus:
					P_IL_Sprint = sprintf(F_IL_Cdata," Minus InterLock ");	// 마이너스 인터락 문구 표시
					//P_IL_length = strlen(F_IL_Cdata);						// 문자열 길이 저장
				break;

				default:					
					P_IL_Sprint = sprintf(F_IL_Cdata," InterLock ");		// 그럴땐 인터락 문구 표시
					//P_IL_length = strlen(F_IL_Cdata);						// 문자열 길이 저장
				break;
			}
		}
	break;
	
}
return;

