Sub:Common_Command(void)
//------------------------------------------------------------
// 1) 서브프로세스 프로그램 [명령부]
//------------------------------------------------------------	
IF ( P_array_CF_Function_Start_Flag == 0 && P_array_CF_Function_Run_Flag == 0 && P_array_CF_Function_Return_Flag == 0 )
{	// 프로그램 허용 플래그 ( 스타트,런,리턴 함수 플래그 모두 초기화 되었는지 확인.)
	// 프로그램이 실행되었음을 표시
	P_array_CF_Function_Start_Flag = 1;			// 서브 프로그램 진입 플래그IF

	P_array_CF_Function_State_Number = 0;		// 서브 프로그램 스텟머신 활성화
	P_PLC09_Common_Command_Complete_Bit = 1;
}
Return

//[9]. PACK ML - 서브 프로세스 - 실행부 (MANUAL)
Sub:Common_Excute(void)
//------------------------------------------------------------
// 2) 서브프로세스 프로그램 [실행부]
//-----------------------------------------------------------			
IF ( P_array_CF_Function_Start_Flag == 1 && P_array_CF_Function_Run_Flag < 2 )
{
	IF( P_array_CF_Function_State_Number == 0 )
	{
		P_array_CF_Function_Run_Flag = 1;			// 서브프로그램이 시작됨을 알림
		P_array_CF_Function_State_Number++;		
	}
	IF( P_array_CF_Function_State_Number == 1 )
	{
		P_array_CF_Function_State_Number++;
	}
	IF( P_array_CF_Function_State_Number == 2 )
	{
		Switch ( P_PLC09_Status )
		{
			Case 0 : // 기본값
			
			break;
			
			Case 1 : // F_Status_IDLE	
				P_PLC09_Status = 0;
				P_Check_IDLE_CF++;		
			break;
			
			Case 2 : // -
				P_PLC09_Status = 0;
			break;
			
			Case 3 : // F_Status_EXECUTE
				P_PLC09_Status = 0;
				P_Check_EXECUTE_CF++;
			break;
			
			Case 4 : // F_Status_COMPLETING
				P_PLC09_Status = 0;
				P_Check_COMPLETING_CF++;
			break;

			Case 5 : // F_Status_COMPLETE
				P_PLC09_Status = 0;
				P_Check_COMPLETE_CF++;
			break;
			
			Case 6 : // -
				P_PLC09_Status = 0;
			break;	
			
			Case 7 : // F_Status_HOLDING
				P_PLC09_Status = 0;	
				P_Check_HOLDING_CF++;
			break;
			
			Case 8 : // F_Status_HOLD
				P_PLC09_Status = 0;	
				P_Check_HOLD_CF++;
			break;
			
			Case 9 : // -
				P_PLC09_Status = 0;
			break;
			
			Case 10 : // -
				P_PLC09_Status = 0;
			break;
			
			Case 11 : // F_Status_SUSPENDED
				P_PLC09_Status = 0;	
				P_Check_SUSPENDED_CF++;
			break;
			
			// [ 참조 : 공통 PackML 임시 상태 변경 및 스텟 추가_240221]
			Case 12 : // -				
				P_PLC09_Status = 0;
			break;		

			
			Case 13 : // -
				P_PLC09_Status = 0;	
			break;
			
			Case 14 : // F_Status_STOPPED	
				P_PLC09_Status = 0;	
				
				P_Check_STOPPED_CF++;
				
				//P_Flag_Stop_Mode_Normal = 0;				// 기존 사용된 코드
				//P_Flag_Stop_Mode_Sepa_Consume = 0;				
				//P_Flag_Stop_Mode_Dry_Run = 0;			
			break;
			
			Case 15 :	// -
				P_PLC09_Status = 0;	
			break;
			
			Case 16 :	// F_Status_ABORTED
				P_PLC09_Status = 0;	
				P_Check_ABORTED_CF++;		
			break;
			
			Case 17 :	// F_Status_CLEARING
				P_PLC09_Status = 0;	
				P_Check_CLEARING_CF++;
			break;
			
			default : 
			
			break;
		}

		P_array_CF_Function_State_Number++;
	}
	IF( P_array_CF_Function_State_Number == 3 )
	{
		P_array_CF_Function_State_Number++;
	}
	IF( P_array_CF_Function_State_Number == 4 )
	{
		P_array_CF_Function_State_Number++;
	}
	IF( P_array_CF_Function_State_Number == 5 )
	{	
		P_array_CF_Function_Run_Flag = 2;				// 서브프로그램이 완료를 알림
		P_array_CF_Function_State_Number = 0;

		P_PLC09_Common_Execute_Complete_Bit = 1;
	}
}
Return

sub: PackML_Resetting_SheetID_Check(&rtn)
	IF ( Sys_Cathode_Align_Sheet_LO_Vision_BYTE == 0 && Sys_Anode_Align_Sheet_LO_Vision_BYTE == 0 )					// 경우의 수 1번 - 음,양극 극판 둘다 삭제될 경우 
	{									
		P_Set_Cathode_Align_Zero_Pos = 1;
		P_Set_Anode_Align_Zero_Pos = 1;
	}
	Else IF (  Sys_Cathode_Align_Sheet_LO_Vision_BYTE > 0 && Sys_Anode_Align_Sheet_LO_Vision_BYTE == 0 )			// 경우의 수 2번 - 음극만 시트 삭제 한 후
	{
		P_Set_Anode_Align_Zero_Pos = 1;																				// 음극 보정 스텟머신 ON
	}																										
																											
	Else IF (  Sys_Cathode_Align_Sheet_LO_Vision_BYTE == 0 && Sys_Anode_Align_Sheet_LO_Vision_BYTE > 0 )			// 경우의 수 3번- 양극만 시트 삭제한 경우
	{	
		P_Set_Cathode_Align_Zero_Pos = 1;																	
	}

	rtn = N_TRUE;

return;

sub: Virtual_Servo_On(void)

CMD" #0j/ #49..63j/ "		// 커맨드문 실행
sendallcmds // 모든 커맨드문 버퍼를 비워냄
while (Ldata.CmdStatus == 1) {} // 모든 커맨드문 버퍼가 비워질 때 까지 대기		

return;

sub: Virtual_Servo_On_Chk(&rtn)
rtn = 0;
local L_Virtual_Motor_Num = 49;
// 케스케이딩 가상축 모터 
if( Motor[0].AmpEna != 1 )
{
	Ldata.Motor = 0;						// 모터 설정 ← 모터 번호.
	jog/;									// 모터 Servo ON.
	homez;
}
else
{
	Ldata.Motor = 0;						// 모터 설정 ← 모터 번호.
	homez;
}
// 가상축 모터 
while( L_Virtual_Motor_Num <= Max_Motor_EA )
{
	if( Motor[L_Virtual_Motor_Num].AmpEna != 1)
	{
		Ldata.Motor = L_Virtual_Motor_Num;	// 모터 설정 ← 모터 번호.
		jog/;								// 모터 Servo ON.
		homez;
		L_Virtual_Motor_Num++;
	}
	else
	{
		Ldata.Motor = L_Virtual_Motor_Num;	// 모터 설정 ← 모터 번호.
		homez;
		L_Virtual_Motor_Num++;
	}
}	
	
rtn = N_TRUE;
return;


