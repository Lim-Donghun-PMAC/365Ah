// =====================================================================================
// 프로그램 개정이력
// -------------------------------------------------------------------------------------
// 24.01.26	Wait,Anode_Run,Cathode_Run 을 제외한 모드 삭제.
/*
서브마스터 모션프로그램에서 호출하는 서브프로그램
각 모드(런,스타트,ng등등)의 배열값을 로컬변수(L_Mode_Command)에 저장하고 있다가 트리거 상승시에 모드에 맞는 커멘드값을 슬레이브에 넘겨준다.
*/



	
											// P_Current_Mode, P_Master_Motion_Trigger
open subprog Sub_ModeArray_Final_Roll_Slave_5( Mode,TriggerCount )

// local	L_Old_Command;							// 이전 명령어
// local	L_Old_Mode;								// 이전 모드	
// local	L_Old_Trigger; 							// 트리거 이전값
// local	L_Mode_Command
		
// 모드가 바뀌면 내부 사용 변수 초기화		
if( P_SubMaster_Sub_Old_Mode(5) != Mode )			//초기화 구문
{	// 현재 모드와 이전모드가 다르면
	P_SubMaster_Sub_Old_Command(5) = 0;				// 슬레이브에 전달한 이전 명령
	P_Slave5_Motion_Command = 0;					// 슬레이브에 전달할 명령
	P_SubMaster_Sub_Old_Trigger(5) = 0;				// 이전 마스터 트리거 값
	P_SubMaster_Sub_Old_Mode(5) = Mode;				// 이전 모드 저장소 갱신
}

// 모드에 따른 명령어 추출
// 모드에 따라 트리거 카운트에 맞춰 배열값을 로컬변수에 저장한다.
switch( Mode )
{
//==========================================================================================
	// 0 . Wait_Mode ( 사이클 스탑도 여기 해당)
	//------------------------------------------------------------------------------------------
	case F_Wait_Mode :
			P_SubMaster_Sub_Mode_Command(5) = 0;//P_Wait_Motion_Array( TriggerCount );
	break;
	//==========================================================================================
	// 4. F_Half_Anode_Run_Mode
	//------------------------------------------------------------------------------------------	
	case F_Half_Anode_Run_Mode :
		P_SubMaster_Sub_Mode_Command(5) = P_Slave5_Anode_Run_Motion_Array(TriggerCount);
	break;	
	//==========================================================================================
	// 5. F_Half_Cathode_Run_Mode
	//------------------------------------------------------------------------------------------	
	case F_Half_Cathode_Run_Mode :
		P_SubMaster_Sub_Mode_Command(5) = P_Slave5_Cathode_Run_Motion_Array(TriggerCount);
	break;	
	//==========================================================================================
	//  Default
	//------------------------------------------------------------------------------------------
	default : // 예외처리
		P_SubMaster_Sub_Mode_Command(5)= 0;
	break;
}	
	

// 트리거가 바뀌면 명령어 전달
// 트리거 상승시에만 로컬변수에 저장된 커멘드값을 실제 슬레이브에 전달.
if( P_SubMaster_Sub_Old_Trigger(5) != P_Master_Motion_Trigger )				// 트리거가 지금 바뀌었는지 확인
{
	P_SubMaster_Sub_Old_Trigger(5) = P_Master_Motion_Trigger;				// 트리거 값 갱신
	if( P_SubMaster_Sub_Mode_Command(5) != 0 )								// 출력된 명령어가 무효한 명령이 아니라면
	{
		if( P_Slave5_Motion_Command > 0 )
		{
			P_InterLock_No3_Array(5)++;
		}
		else
		{
			P_Slave5_Motion_Command = P_SubMaster_Sub_Mode_Command(5);		// 명령어를 슬레이브에 전달
			P_Slave15_Motion_Command = P_SubMaster_Sub_Mode_Command(5);		// CAMTABLE 

			//P_Slave20_Motion_Command = P_SubMaster_Sub_Mode_Command(5);
			//P_Slave31_Motion_Command = P_SubMaster_Sub_Mode_Command(5);

			// 파이널롤 1차 이동 모션 커맨드 발생시 스풀 풀어주기 허가 플래그 온.
			//if( P_Slave5_Motion_Command == 1 || P_Slave5_Motion_Command == 3 )
			//{
			//	P_Spool_Enable = 1; 
			//}
			//
			//if ( P_Sepa_Jog_FF_Enable == 1 )
			//{
			//	P_Spool_Enable = P_SubMaster_Sub_Mode_Command(5);
			//}
			P_SubMaster_Sub_Old_Command(5) = P_Slave5_Motion_Command;		// 이전 명령어 갱신
		}	
	}
}


close