	else if ( M_Y_FR_Sepa_Clamp_FWD_Sol == 0 && M_Y_FR_Sepa_Clamp_BWD_Sol == 1 )		// 클램프 OFF.
	{
		P_Tact_Time_Final_Roller_Clamp = 0;
