// 알람 프로그램 표준화 작업 - [ 참조 : 25.07.29 알람 프로그램 표준화 작업 진행 ]


open subprog Alarm_Heap_Sort(void)

Sub: Initalize(void)

	P_Alarm_Heap_Arr(0),N_Heap_Arr_Length = 0;

return;

Sub: Node_Insert(data, Priority)						// 노드 삽입. (알람 번호, 우선 순위)

	//-----------------------------------//
	// Local 변수 선언 //
	//-----------------------------------//
	local L_Current_Index = 0;							// 현재 인덱스.
	local L_Parents_Index = 0;							// 부모 노드 인덱스.
	local L_Parents_Prior = 0;							// 부모 노드 우선 순위.
	local L_Alarm_Duplicate_Result = 0;					// 알람 중복 검사 결과.
	//-----------------------------------//

	L_Current_Index = P_Alarm_Heap_Arr(0) + 1;			// 현재 인덱스 업데이트.

	//call Alarm_Heap_Sort.Check_For_Duplicates(data, &L_Alarm_Duplicate_Result);	// 알람 중복 확인 함수 호출. (알람 번호, 반환값)

	// user_data 정보 입력.
	P_Alarm_Data = data << 4;							// 알람 번호. [udata에 넣어줌]
	P_Alarm_Data = P_Alarm_Data | Priority;				// 우선 순위. [udata에 넣어줌]
	// 부모, 자식 노드 비교 및 업데이트.
	while(L_Current_Index != 1)							// 현재 인덱스가 1이 아닐 경우.
	{
		L_Parents_Index = int(L_Current_Index / 2);		// 부모 인덱스 업데이트.
		call Alarm_Heap_Sort.Get_Priority(P_Alarm_Heap_Arr(L_Parents_Index), &L_Parents_Prior);		// 노드의 우선 순위 추출.
		if(Priority < L_Parents_Prior)					// 자식 노드 우선 순위 < 부모 노드 우선 순위.
		{	
			P_Alarm_Heap_Arr(L_Current_Index) = P_Alarm_Heap_Arr(L_Parents_Index);	// 부모 노드 정보를 자식 노드 정보로 이동.
			L_Current_Index = int(L_Current_Index / 2);								// 현재 인덱스를 부모 인덱스로 
		}
		else
			break;
	}

	P_Alarm_Heap_Arr(0) = P_Alarm_Heap_Arr(0) + 1;		// 요소 갯수 증가.
	P_Alarm_Heap_Arr(L_Current_Index) = P_Alarm_Data	// 새로운 요소를 해당 인덱스에 삽입.	[비트 : 우선 순위 + 알람 번호]
	// 알람의 우선순위를 확인하여 커멘드 발생 여부 체크. //
	/* 경우의 수 [ 최대 발생 횟수 : 2회 ]
	   (3) 경알람 → (2) 사이클 정지
	   (2) 사이클 정지 → (1) 즉시 정지
	   (3) 경알람 → (1) 즉시 정지
	*/
	// P_Compare_Priority의 기본값은 4 
	if(P_Compare_Priority > Priority)					// 이전 우선 순위 > 현재 우선 순위.
	{	
		if(P_Compare_Priority == N_Init_Prev_Priority)	// 가장 처음 알람에 들어 올 경우.
		{
			P_Alarm_First_Request_Flag = 1;				// 첫번째 알람 플래그 ON.
		}
		else if ( P_Compare_Priority != N_Init_Prev_Priority )										// 처음이 아닌 알람이 들어 올 경우.
		{
			P_Alarm_Priority_Request_Flag = 1;			// 우선 순위 알람 플래그 ON.
			P_Alarm_Priority_Cnt++;						// 우선 순위는 최대 2번 발생할 수 있음 ( 경알람 3 -> 사이클 스탑 2 -> 즉시 정지 1 )
		}
		P_Compare_Priority = Priority;					// 현재 우선 순위 저장.
	}

return;

Sub: Node_Delete(&rtn_Variable, &rtn_Priority)			// 알람 번호, 우선 순위 추출 후 정보 삭제. (알람 번호, 우선 순위)

	//-----------------------------------//
	// Local 변수 선언 //
	//-----------------------------------//
	local L_Root_Node_Info = 0;							// 루트 노드 정보.
	local L_Last_Node_Info = 0;							// 마지막 노드 정보.
	local L_Last_Node_Priority = 0;						// 마지막 노드 우선 순위.
	local L_Current_Child_Index = 2;					// 현재 자식 노드 인덱스.
	local L_Current_Parents_Index = 1;					// 현재 부모 노드 인덱스.
	local L_Child_Priority = 0;							// 첫 번째 자식 노드 우선 순위.
	local L_Compare_Child_Priority = 0;					// 두 번째 자식 노드 우선 순위.
	//-----------------------------------//
	
	L_Root_Node_Info =  P_Alarm_Heap_Arr(1);					// 루트 노드 업데이트.
	L_Last_Node_Info = P_Alarm_Heap_Arr(P_Alarm_Heap_Arr(0))	// 마지막 노드 업데이트.
	L_Current_Child_Index = 2;									// 비교 시작 자식 노드.
	L_Current_Parents_Index = 1;								// 비교 시작 부모 노드.

	// 자식 노드와 비교하기 위해선 우선순위 비트를 받아와서 비교 진행
	// 한 데이터의 10진수 값 만으로는 우선순위 여부 파악이 힘듬
	while(P_Alarm_Heap_Arr(0) >= L_Current_Child_Index)
	{
		call Alarm_Heap_Sort.Get_Priority(P_Alarm_Heap_Arr(L_Current_Child_Index), &L_Child_Priority);				// 첫 번째 자식 우선 순위 추출.
		call Alarm_Heap_Sort.Get_Priority(P_Alarm_Heap_Arr(L_Current_Child_Index + 1), &L_Compare_Child_Priority);	// 두 번째 자식 우선 순위 추출.
		
		if(L_Current_Child_Index < P_Alarm_Heap_Arr(0) && L_Child_Priority > L_Compare_Child_Priority)				// 현재 자식 노드 < 요소 개수 && 첫 번째 자식 우선 순위 > 두 번째 자식 우선 순위 
		{
			L_Current_Child_Index++;					// 우선순위에서 밀리면 다음 자식 노드 검색.
		}

		call Alarm_Heap_Sort.Get_Priority(P_Alarm_Heap_Arr(L_Current_Child_Index), &L_Child_Priority);				// 다음 자식 노드 우선 순위 추출.
		call Alarm_Heap_Sort.Get_Priority(L_Last_Node_Info, &L_Last_Node_Priority);									// 마지막 노드 우선 순위 추출.

		if(L_Last_Node_Priority <= L_Child_Priority)																// 마지막 노드 우선 순위 < 다음 노드 우선 순위.
		{
			// 마지막 노드와 현재 자식 노드 와 비교
			// 마지막 노드보다 우선순위가 앞이면 종료
			break;
		}
		// 비교한 자식 노드보다 마지막 노드가 우선순위가 밀리면, 부모 노드와 자식 노드를 교환
		P_Alarm_Heap_Arr(L_Current_Parents_Index) = P_Alarm_Heap_Arr(L_Current_Child_Index);						// 부모 노드 정보 업데이트.
		// 다음 비교할 노드로 인덱스 변경
		L_Current_Parents_Index = L_Current_Child_Index;															// 부모 노드 인덱스 업데이트.
		L_Current_Child_Index *= 2;																					// 자식 노드 인덱스 업데이트.
	}
	P_Alarm_Heap_Arr(L_Current_Parents_Index) = L_Last_Node_Info;			// 비교 후 마지막 노드 정보 업데이트.
	P_Alarm_Heap_Arr(P_Alarm_Heap_Arr(0)) = 0;								// 마지막 노드 삭제.
	P_Alarm_Heap_Arr(0) = P_Alarm_Heap_Arr(0) - 1;							// 요소 개수 수정.
	call Alarm_Heap_Sort.Get_M_Variable(L_Root_Node_Info, &rtn_Variable);	// 루트 노드 알람 번호 추출.
	call Alarm_Heap_Sort.Get_Priority(L_Root_Node_Info, &rtn_Priority);		// 루트 노드 우선 순위 추출.

return;

// 우선 순위 추출.
sub: Get_Priority(Struct, &Prior)					// 우선 순위 추출. (노드 정보, 우선 순위)

	Prior = Struct & $000F							// 우선 순위 추출.

return;

// 알람 번호 추출.
sub: Get_M_Variable(Struct, &Variable)				// 알람 번호 추출. (노드 정보, 알람 번호)

	local L_Save_Variable = (Struct & $FFF0) >> 4;	// 알람 번호 저장.

	if ( M(L_Save_Variable) == 1 )					// 알람이 켜져 있을 경우.
		Variable = 0;								// 알람 번호 0으로 반환. (알람 재발생 방지)
	else											// 알람이 꺼져 있을 경우.
		Variable = L_Save_Variable;					// 알람 번호 반환.

return;

// 알람 번호 로그 저장.
Sub: Alarm_Log(Struct)								// 알람 번호 로그 저장. (알람 번호)

	local L_Log_Count = N_Alarm_Log_Length;			// 알람 Log 길이(30)
	while(L_Log_Count >= 0)							// 알림 Log 길이 >= 0 
	{
		if(L_Log_Count == 0)						// 알람 Log 길이 == 0 
		{
			P_Alarm_Log(L_Log_Count) = Struct;		// 알람 Log 업데이트.
		}
		else										// 알람 Log 길이 != 0 
		{
			P_Alarm_Log(L_Log_Count) = P_Alarm_Log(L_Log_Count - 1);	// 알람 Log Shift.
		}

		L_Log_Count--;								// 알람 Log 길이 감소.
	}

return;

// PLC에게 보내는 알람 번호 업데이트.
Sub: Send_PLC_Alarm_Enqueue(data)					// [PMAC To PLC] 알람 번호 업데이트. (루트 노드 알람 번호)

	P_Alarm_Send_To_PLC(0)++;						// 순차적으로 보내기 위한 버퍼 업데이트.
	P_Alarm_Send_To_PLC(P_Alarm_Send_To_PLC(0)) = data;	// 알람 번호 업데이트.

return;

// 우선순위로 인해 PLC에 알람이 발생해야할 순서대로 M변수 활성화.
Sub: Alarm_Send_To_PLC(void)
	
	local L_Alarm_Dequeue_Index = 1;				// 출력 인덱스 초기화.

	M(P_Alarm_Send_To_PLC(1)) = 1;					// [PMAC To PLC] 알람 출력.

	while(L_Alarm_Dequeue_Index <= P_Alarm_Send_To_PLC(0))	// 출력 인덱스 <= 순차적으로 보내기 위한 버퍼
	{
		P_Alarm_Send_To_PLC(L_Alarm_Dequeue_Index) = P_Alarm_Send_To_PLC(L_Alarm_Dequeue_Index + 1);	// [PMAC To PLC] 알람 번호 배열 업데이트. (작은 배열 ← 큰 배열)
		L_Alarm_Dequeue_Index++;					// 출력 인덱스 증가
	}

	P_Alarm_Send_To_PLC(0)--;						// 출력 인덱스 감소.
	
return;

// 알람 중복 확인.
Sub: Check_For_Duplicates(data, &rtn)				// 알람 중복 확인. (알람 번호, rtn)
						
	local L_Heap_Arr_Count = 1;						// Heap 배열 Cnt.
	local L_Variable = 0;							// 함수 반환값. (알람 번호)

	while(P_Alarm_Heap_Arr(0) >= L_Heap_Arr_Count)	// Heap 배열 노드 정보가 1개 이상 일 경우.
	{
		call Alarm_Heap_Sort.Get_M_Variable(P_Alarm_Heap_Arr(L_Heap_Arr_Count), &L_Variable);	// 알람 번호 추출. (루트 노드 정보, 알람 번호)
																				
		if(L_Variable == data)						// 루트 노드 알람 번호와 현재 알람 번호가 같을 경우.
		{
			rtn = 1;								// 반환값 업데이트.
			break;									// While문 종료.
		}
		
		L_Heap_Arr_Count++;							// Heap 배열 Cnt 증가.
	}
return;

close
