Motor[0].MaxSpeed = 0;
Motor[0].InvAmax = 0
Motor[0].InvDmax = 0
Motor[0].InvJmax = 0
// 언와인더 모터번호  23 , 24
CompTable[0].Source[0] = 0;										// 소스 모터 0 데이터를 사용
CompTable[0].Ctrl = 3;											// 소스 모터의 서보 명령을 사용 
CompTable[0].Nx[0]=0;											// 1 차원에 데이터 존 없음
CompTable[0].Nx[1]=0;											// 2 차원에 데이터 존 없음 
CompTable[0].Nx[2]=0;											// 3 차원에 데이터 존 없음
CompTable[0].Data[0]=0;											// 단일 데이터 포인트의 초기화 
CompTable[0].OutCtrl = 1;										// 결과의 적분 없음 
CompTable[0].Target[0] = Motor[N_UNWINDER_LOWER].CompDesPos.a;	// #23 명령된 위치
