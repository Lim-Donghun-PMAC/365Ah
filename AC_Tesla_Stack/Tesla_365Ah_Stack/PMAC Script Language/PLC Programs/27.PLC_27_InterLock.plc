					P_No7_Recipe_Pos_IL(N_Clamp_AN_Y2) = 1;			// 인터락
					P_No8_Recipe_Pos_IL(N_Clamp_AN_Y2) = 1;			// 인터락
					P_No9_Recipe_Pos_IL(N_Clamp_AN_Y2) = 1;			// 인터락
					P_No10_Recipe_Pos_IL(N_Clamp_AN_Y2) = 1;		// 인터락
